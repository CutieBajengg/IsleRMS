<header class="admin-topbar">

  <div
    style="
      display: flex;
      align-items: center;
      gap: 12px;
    "
  >

    <!-- MOBILE TOGGLE -->

    <button
      type="button"
      class="admin-menu-toggle"
      id="adminMenuToggle"
      aria-label="Open administrator navigation"
      aria-expanded="false"
      aria-controls="adminSidebar"
    >

      <i
        class="fas fa-bars"
        aria-hidden="true"
      ></i>

    </button>

    <!-- BRAND -->

    <a
      href="/admin/dashboard"
      class="admin-brand"
      aria-label="Puffer Isle IsleRMS Command Center"
    >

      <span class="admin-brand-logo">

        <img
          src="/images/islelogo.png"
          alt="Puffer Isle Resort"
          width="32"
          height="32"
        >

      </span>

      <span class="admin-brand-copy">

        <span class="admin-brand-name">

          Puffer Isle

          <span>IsleRMS</span>

        </span>

        <span class="admin-brand-subtitle">

          Resort Management System

        </span>

      </span>

    </a>

  </div>

  <!-- ==========================================================
       TOP RIGHT
  =========================================================== -->

  <div class="admin-topbar-right">

    <a
      href="/"
      class="admin-view-site"
      title="Open public resort website"
    >

      <i
        class="fas fa-arrow-up-right-from-square"
        aria-hidden="true"
      ></i>

      View Site

    </a>

    <div
      class="admin-account"
      id="adminAccount"
    >

      <button
        type="button"
        class="admin-account-button"
        id="adminAccountButton"
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="adminAccountMenu"
      >

        <span
          class="admin-avatar"
          aria-hidden="true"
        >
          <%= adminInitial %>
        </span>

        <span class="admin-account-copy">

          <span class="admin-account-name">
            <%= adminUsername %>
          </span>

          <span class="admin-account-role">
            <%= adminRole %>
          </span>

        </span>

        <i
          class="fas fa-chevron-down admin-account-chevron"
          aria-hidden="true"
        ></i>

      </button>

      <!-- ACCOUNT MENU -->

      <div
        class="admin-account-menu"
        id="adminAccountMenu"
        role="menu"
      >

        <div class="admin-account-summary">

          <strong>
            <%= adminUsername %>
          </strong>

          <span>
            Administrator account
          </span>

        </div>

        <div class="admin-account-divider"></div>

        <a
          href="/admin/dashboard"
          role="menuitem"
        >

          <i
            class="fas fa-gauge-high"
            aria-hidden="true"
          ></i>

          Command Center

        </a>

        <a
          href="/"
          role="menuitem"
        >

          <i
            class="fas fa-globe"
            aria-hidden="true"
          ></i>

          Public Website

        </a>

        <!-- ======================================================
             CANONICAL ADMIN LOGOUT
        ======================================================= -->

        <form
          method="POST"
          action="/admin/logout"
          class="logout-form"
        >

          <input
            type="hidden"
            name="_csrf"
            id="adminCsrfToken"
            value="<%= adminCsrfToken %>"
            autocomplete="off"
          >

          <button
            type="submit"
            class="logout-button"
            role="menuitem"
          >

            <i
              class="fas fa-right-from-bracket"
              aria-hidden="true"
            ></i>

            Sign Out

          </button>

        </form>

      </div>

    </div>

  </div>

</header>

