<script>
  (() => {
    "use strict";

    const body =
      document.body;

    const menuToggle =
      document.getElementById(
        "adminMenuToggle"
      );

    const sidebar =
      document.getElementById(
        "adminSidebar"
      );

    const overlay =
      document.getElementById(
        "adminSidebarOverlay"
      );

    const account =
      document.getElementById(
        "adminAccount"
      );

    const accountButton =
      document.getElementById(
        "adminAccountButton"
      );

    function setSidebar(open) {

      if (!body) {
        return;
      }

      body.classList.toggle(
        "admin-sidebar-open",
        open
      );

      if (menuToggle) {

        menuToggle.setAttribute(
          "aria-expanded",
          String(open)
        );

        const icon =
          menuToggle.querySelector("i");

        if (icon) {
          icon.className =
            open
              ? "fas fa-xmark"
              : "fas fa-bars";
        }
      }
    }

    function setAccount(open) {

      if (!account) {
        return;
      }

      account.classList.toggle(
        "open",
        open
      );

      if (accountButton) {

        accountButton.setAttribute(
          "aria-expanded",
          String(open)
        );
      }
    }

    menuToggle?.addEventListener(
      "click",
      () => {
        const isOpen =
          body.classList.contains(
            "admin-sidebar-open"
          );

        setSidebar(!isOpen);
      }
    );

    overlay?.addEventListener(
      "click",
      () => {
        setSidebar(false);
      }
    );

    accountButton?.addEventListener(
      "click",
      (event) => {

        event.stopPropagation();

        const isOpen =
          account?.classList.contains(
            "open"
          );

        setAccount(!isOpen);
      }
    );

    document.addEventListener(
      "click",
      (event) => {

        if (
          account &&
          !account.contains(event.target)
        ) {
          setAccount(false);
        }

        if (
          window.innerWidth <= 900 &&
          sidebar &&
          !sidebar.contains(event.target) &&
          menuToggle &&
          !menuToggle.contains(event.target)
        ) {
          setSidebar(false);
        }
      }
    );

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape"
        ) {
          setAccount(false);
          setSidebar(false);
        }
      }
    );

    sidebar?.querySelectorAll(
      "a"
    ).forEach(
      (link) => {

        link.addEventListener(
          "click",
          () => {

            if (
              window.innerWidth <= 900
            ) {
              setSidebar(false);
            }

          }
        );

      }
    );

    window.addEventListener(
      "resize",
      () => {

        if (
          window.innerWidth > 900
        ) {
          setSidebar(false);
        }

      }
    );

  })();
</script>