    </ul>

  </nav>

  <div class="admin-sidebar-divider"></div>

  <!-- ==========================================================
       RESORT CATALOG
  =========================================================== -->

  <div class="admin-sidebar-label">
    Resort Catalog
  </div>

  <nav aria-label="Resort Catalog">

    <ul class="admin-nav-list">

      <!-- ROOMS -->

      <li
        class="admin-nav-item <%= isActive('/admin/rooms') ? 'active' : '' %>"
      >

        <a href="/admin/rooms">

          <span class="admin-nav-icon">

            <i
              class="fas fa-bed"
              aria-hidden="true"
            ></i>

          </span>

          <span class="admin-nav-label">
            Rooms
          </span>

        </a>

      </li>

      <!-- ADD-ONS -->

      <li
        class="admin-nav-item <%= isActive('/admin/add-ons') ? 'active' : '' %>"
      >

        <a href="/admin/add-ons">

          <span class="admin-nav-icon">

            <i
              class="fas fa-puzzle-piece"
              aria-hidden="true"
            ></i>

          </span>

          <span class="admin-nav-label">
            Add-ons
          </span>

        </a>

      </li>

      <!-- USERS -->

      <li
        class="admin-nav-item <%= isActive('/admin/users') ? 'active' : '' %>"
      >

        <a href="/admin/users">

          <span class="admin-nav-icon">

            <i
              class="fas fa-users"
              aria-hidden="true"
            ></i>

          </span>

          <span class="admin-nav-label">
            Guests
          </span>

        </a>

      </li>

    </ul>

  </nav>

  <div class="admin-sidebar-divider"></div>

  <!-- ==========================================================
       INSIGHTS
  =========================================================== -->

  <div class="admin-sidebar-label">
    Insights
  </div>

  <nav aria-label="Insights">

    <ul class="admin-nav-list">

      <!-- ANALYTICS -->

      <li
        class="admin-nav-item <%= isActive('/admin/analytics') ? 'active' : '' %>"
      >

        <a href="/admin/analytics">

          <span class="admin-nav-icon">

            <i
              class="fas fa-chart-line"
              aria-hidden="true"
            ></i>

          </span>

          <span class="admin-nav-label">
            Analytics
          </span>

        </a>

      </li>

    </ul>

  </nav>

  <!-- ==========================================================
       SECURITY CARD
  =========================================================== -->

  <div class="admin-security-card">

    <div class="admin-security-title">

      <i
        class="fas fa-shield-halved"
        aria-hidden="true"
      ></i>

      Secure Console

    </div>

    <div class="admin-security-text">

      Administrator access is protected by authenticated
      sessions and server-side route authorization.

    </div>

  </div>

</aside>

<!-- ============================================================
     ADMIN NAVIGATION CLIENT LOGIC
============================================================ -->

<script>
  (() => {
    "use strict";

    /* ==========================================================
       ELEMENTS
    =========================================================== */

    const body =
      document.body;

    const menuToggle =
      document.getElementById(
        "adminMenuToggle"
      );

    const sidebar =
      document.getElementById(
        "adminSidebar"
      );

    const overlay =
      document.getElementById(
        "adminSidebarOverlay"
      );

    const account =
      document.getElementById(
        "adminAccount"
      );

    const accountButton =
      document.getElementById(
        "adminAccountButton"
      );

    const accountMenu =
      document.getElementById(
        "adminAccountMenu"
      );

    const csrfTokenElement =
      document.getElementById(
        "adminCsrfToken"
      );

    /* ==========================================================
       CSRF TOKEN

       IMPORTANT:
       Do NOT place EJS directly inside this <script>.

       The token is rendered into the HTML form above,
       then safely read from the DOM.

       Future admin pages can use:

       window.IsleRMS.csrfToken

       for fetch() requests.
    =========================================================== */

    window.IsleRMS =
      window.IsleRMS || {};

    window.IsleRMS.csrfToken =
      csrfTokenElement
        ? csrfTokenElement.value
        : "";

    window.IsleRMS.getCsrfToken =
      function getCsrfToken() {
        const element =
          document.getElementById(
            "adminCsrfToken"
          );

        return element
          ? element.value
          : "";
      };

    /* ==========================================================
       SIDEBAR
    =========================================================== */

    function setSidebar(open) {
      if (!body) {
        return;
      }

      body.classList.toggle(
        "admin-sidebar-open",
        Boolean(open)
      );

      if (menuToggle) {
        menuToggle.setAttribute(
          "aria-expanded",
          String(Boolean(open))
        );

        menuToggle.setAttribute(
          "aria-label",
          open
            ? "Close administrator navigation"
            : "Open administrator navigation"
        );

        const icon =
          menuToggle.querySelector(
            "i"
          );

        if (icon) {
          icon.className =
            open
              ? "fas fa-xmark"
              : "fas fa-bars";
        }
      }
    }

    /* ==========================================================
       ACCOUNT MENU
    =========================================================== */

    function setAccount(open) {
      if (!account) {
        return;
      }

      account.classList.toggle(
        "open",
        Boolean(open)
      );

      if (accountButton) {
        accountButton.setAttribute(
          "aria-expanded",
          String(Boolean(open))
        );
      }
    }

    /* ==========================================================
       MOBILE MENU
    =========================================================== */

    if (menuToggle) {
      menuToggle.addEventListener(
        "click",
        () => {

          const isOpen =
            body &&
            body.classList.contains(
              "admin-sidebar-open"
            );

          setSidebar(
            !isOpen
          );
        }
      );
    }

    if (overlay) {
      overlay.addEventListener(
        "click",
        () => {
          setSidebar(false);
        }
      );
    }

    /* ==========================================================
       ACCOUNT MENU BUTTON
    =========================================================== */

    if (accountButton) {
      accountButton.addEventListener(
        "click",
        (event) => {

          event.stopPropagation();

          const isOpen =
            account &&
            account.classList.contains(
              "open"
            );

          setAccount(
            !isOpen
          );
        }
      );
    }

    /* ==========================================================
       OUTSIDE CLICK
    =========================================================== */

    document.addEventListener(
      "click",
      (event) => {

        const target =
          event.target;

        if (
          account &&
          target instanceof Node &&
          !account.contains(
            target
          )
        ) {
          setAccount(false);
        }

        if (
          window.innerWidth <= 900 &&
          sidebar &&
          target instanceof Node &&
          !sidebar.contains(
            target
          ) &&
          menuToggle &&
          !menuToggle.contains(
            target
          )
        ) {
          setSidebar(false);
        }

      }
    );

    /* ==========================================================
       ESCAPE KEY
    =========================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key ===
          "Escape"
        ) {

          setAccount(false);

          setSidebar(false);

        }

      }
    );

    /* ==========================================================
       CLOSE MOBILE MENU AFTER NAVIGATION
    =========================================================== */

    if (sidebar) {

      const sidebarLinks =
        sidebar.querySelectorAll(
          "a"
        );

      sidebarLinks.forEach(
        (link) => {

          link.addEventListener(
            "click",
            () => {

              if (
                window.innerWidth <= 900
              ) {
                setSidebar(false);
              }

            }
          );

        }
      );

    }

    /* ==========================================================
       CLOSE ACCOUNT MENU AFTER ACTION
    =========================================================== */

    if (accountMenu) {

      const accountItems =
        accountMenu.querySelectorAll(
          "a, button"
        );

      accountItems.forEach(
        (item) => {

          item.addEventListener(
            "click",
            () => {
              setAccount(false);
            }
          );

        }
      );

    }

    /* ==========================================================
       RESPONSIVE RESET
    =========================================================== */

    window.addEventListener(
      "resize",
      () => {

        if (
          window.innerWidth > 900
        ) {
          setSidebar(false);
        }

      }
    );

    /* ==========================================================
       ADMIN LOGOUT

       The logout form remains a normal HTML POST.

       This is intentional:
       - works without JavaScript
       - submits CSRF token normally
       - server remains authoritative
       - avoids unnecessary AJAX authentication logic
    =========================================================== */

    const logoutForm =
      document.querySelector(
        ".admin-account-menu .logout-form"
      );

    if (logoutForm) {

      logoutForm.addEventListener(
        "submit",
        () => {

          setAccount(false);

        }
      );

    }

  })();
</script>