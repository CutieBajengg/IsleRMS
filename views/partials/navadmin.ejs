<!-- ============================================================
     PUFFER ISLE RESORT | IsleRMS
     ADMIN NAVIGATION PARTIAL

     IMPORTANT:
     This file is intentionally ONLY the navigation.
     Do not place <html>, <head>, <body>, dashboard content,
     statistics, booking tables, or page-specific JS here.
============================================================ -->

<%
  const adminUser =
    typeof admin !== "undefined" && admin
      ? admin
      : (
          typeof currentAdmin !== "undefined" && currentAdmin
            ? currentAdmin
            : null
        );

  const current =
    typeof currentPath !== "undefined"
      ? String(currentPath)
      : "";

  function isActive(path) {
    if (!current) {
      return false;
    }

    if (path === "/admin/dashboard") {
      return current === path;
    }

    return current === path || current.startsWith(path + "/");
  }

  const adminUsername =
    adminUser?.username ||
    "Administrator";

  const adminRole =
    adminUser?.role ||
    "admin";

  const adminInitial =
    String(adminUsername)
      .charAt(0)
      .toUpperCase() || "A";
%>

<style>
