    background: var(--success-soft);
    color: #78e8a9;
    border-color: rgba(69,216,138,0.20);
  }

  .auth-message.warning {
    background: rgba(232,164,59,0.10);
    color: #ffd285;
    border-color: rgba(232,164,59,0.22);
  }

  .input-group,
  .otp-input-group { margin-bottom: 18px; }

  .input-group label,
  .otp-input-group label {
