  }

  .dropdown { position: relative; }

  .dropdown-content {
    position: absolute;
    top: calc(100% + 13px);
    right: 0;
    width: 280px;
    padding: 8px;
    background: white;
    border: 1px solid rgba(0,0,0,0.08);
