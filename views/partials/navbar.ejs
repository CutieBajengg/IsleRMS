<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
  "DOMContentLoaded",
  () => {


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const authModal =
      document.getElementById("authModal");

    const logoutModal =
      document.getElementById("logoutModal");

    const loginBtn =
      document.getElementById("loginBtn");

    const bookingBtn =
      document.getElementById("bookingBtn");

    const logoutTrigger =
      document.getElementById("logoutTrigger");

    const closeBtn =
      document.querySelector(".close");

    const cancelLogout =
      document.getElementById("cancelLogout");

    const showSignup =
      document.getElementById("showSignup");

    const showLogin =
      document.getElementById("showLogin");

    const loginForm =
      document.getElementById("loginForm");

    const signupForm =
      document.getElementById("signupForm");

    const signupFormElem =
      document.getElementById("signupFormElem");

    const mobileMenuBtn =
      document.getElementById("mobileMenuBtn");

    const mainNavigation =
      document.getElementById("mainNavigation");

    const phoneInput =
      document.getElementById("phoneInput");

    const phoneError =
      document.getElementById("phoneError");

    const signupPassword =
      document.getElementById("signupPassword");

    const confirmPassword =
      document.getElementById("confirmPassword");

    const passwordMatchError =
      document.getElementById(
        "passwordMatchError"
      );

    const passwordMatchSuccess =
      document.getElementById(
        "passwordMatchSuccess"
      );


    /* =====================================================
       OPEN AUTH MODAL
    ====================================================== */

    function openAuth() {

      if (!authModal) return;

      authModal.style.display =
        "flex";

      authModal.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow =
        "hidden";

    }


    /* =====================================================
       CLOSE AUTH MODAL
    ====================================================== */

    function closeAuth() {

      if (!authModal) return;

      authModal.style.display =
        "none";

      authModal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow =
        "";

    }


    /* =====================================================
       LOGIN BUTTON
    ====================================================== */

    loginBtn?.addEventListener(
      "click",
      () => {

        loginForm?.classList.remove(
          "hidden"
        );

        signupForm?.classList.add(
          "hidden"
        );

        openAuth();

      }
    );


    /* =====================================================
       BOOKING BUTTON
    ====================================================== */

    bookingBtn?.addEventListener(
      "click",
      (event) => {

        if (
          bookingBtn.getAttribute("href") === "#"
        ) {

          event.preventDefault();

          loginForm?.classList.remove(
            "hidden"
          );

          signupForm?.classList.add(
            "hidden"
          );

          openAuth();

        }

      }
    );


    /* =====================================================
       CLOSE BUTTON
    ====================================================== */

    closeBtn?.addEventListener(
      "click",
      closeAuth
    );


    /* =====================================================
       BACKDROP CLICK
    ====================================================== */

    window.addEventListener(
      "click",
      (event) => {

        if (
          event.target === authModal
        ) {

          closeAuth();

        }


        if (
          event.target === logoutModal
        ) {

          logoutModal.style.display =
            "none";

          logoutModal.setAttribute(
            "aria-hidden",
            "true"
          );

          document.body.style.overflow =
            "";

        }

      }
    );


    /* =====================================================
       ESCAPE KEY
    ====================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key !== "Escape"
        ) {
          return;
        }


        if (
          authModal &&
          authModal.style.display === "flex"
        ) {

          closeAuth();

        }


        if (
          logoutModal &&
          logoutModal.style.display === "flex"
        ) {

          logoutModal.style.display =
            "none";

          logoutModal.setAttribute(
            "aria-hidden",
            "true"
          );

          document.body.style.overflow =
            "";

        }

      }
    );


    /* =====================================================
       SHOW SIGNUP
    ====================================================== */

    showSignup?.addEventListener(
      "click",
      (event) => {

        event.preventDefault();

        loginForm?.classList.add(
          "hidden"
        );

        signupForm?.classList.remove(
          "hidden"
        );

      }
    );


    /* =====================================================
       SHOW LOGIN
    ====================================================== */

    showLogin?.addEventListener(
      "click",
      (event) => {

        event.preventDefault();

        signupForm?.classList.add(
          "hidden"
        );

        loginForm?.classList.remove(
          "hidden"
        );

      }
    );


    /* =====================================================
       PASSWORD VISIBILITY TOGGLE
    ====================================================== */

    document
      .querySelectorAll(
        ".password-toggle"
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const targetId =
                button.getAttribute(
                  "data-target"
                );

              const passwordInput =
                document.getElementById(
                  targetId
                );


              if (!passwordInput) {
                return;
              }


              if (
                passwordInput.type ===
                "password"
              ) {

                passwordInput.type =
                  "text";

                button.textContent =
                  "🙈";

                button.setAttribute(
                  "aria-label",
                  "Hide password"
                );

                button.setAttribute(
                  "title",
                  "Hide password"
                );

              } else {

                passwordInput.type =
                  "password";

                button.textContent =
                  "👁";

                button.setAttribute(
                  "aria-label",
                  "Show password"
                );

                button.setAttribute(
                  "title",
                  "Show password"
                );

              }

            }
          );

        }
      );


    /* =====================================================
       PASSWORD MATCH CHECK
    ====================================================== */

    function checkPasswordMatch() {

      if (
        !signupPassword ||
        !confirmPassword
      ) {

        return true;

      }


      /*
       * Don't display anything
       * until the confirmation field
       * has been used.
       */

      if (
        confirmPassword.value.length === 0
      ) {

        passwordMatchError.style.display =
          "none";

        passwordMatchSuccess.style.display =
          "none";

        confirmPassword.style.borderColor =
          "";

        return false;

      }


      if (
        signupPassword.value ===
        confirmPassword.value
      ) {

        passwordMatchError.style.display =
          "none";

        passwordMatchSuccess.style.display =
          "block";

        confirmPassword.style.borderColor =
          "#45d88a";

        return true;

      }


      passwordMatchError.style.display =
        "block";

      passwordMatchSuccess.style.display =
        "none";

      confirmPassword.style.borderColor =
        "#ff5b5b";

      return false;

    }


    /* =====================================================
       PASSWORD LIVE VALIDATION
    ====================================================== */

    signupPassword?.addEventListener(
      "input",
      checkPasswordMatch
    );


    confirmPassword?.addEventListener(
      "input",
      checkPasswordMatch
    );


    /* =====================================================
       PHONE NUMBER VALIDATION
    ====================================================== */

    phoneInput?.addEventListener(
      "input",
      () => {

        /*
         * Allow numbers only.
         */

        phoneInput.value =
          phoneInput.value.replace(
            /[^0-9]/g,
            ""
          );


        /*
         * Limit to 11 digits.
         */

        if (
          phoneInput.value.length > 11
        ) {

          phoneInput.value =
            phoneInput.value.slice(
              0,
              11
            );

        }


        if (
          phoneInput.value.length === 0
        ) {

          phoneError.style.display =
            "none";

          phoneInput.style.borderColor =
            "";

          return;

        }


        if (
          phoneInput.value.length === 11
        ) {

          phoneError.style.display =
            "none";

          phoneInput.style.borderColor =
            "#45d88a";

        } else {

          phoneError.style.display =
            "block";

          phoneInput.style.borderColor =
            "#ff5b5b";

        }

      }
    );


    /* =====================================================
       SIGNUP SUBMIT VALIDATION
    ====================================================== */

    signupFormElem?.addEventListener(
      "submit",
      (event) => {

        let valid = true;


        /*
         * Password confirmation
         */

        if (
          !checkPasswordMatch()
        ) {

          event.preventDefault();

          valid = false;

          confirmPassword?.focus();

        }


        /*
         * Phone number
         */

        if (
          phoneInput &&
          phoneInput.value.length !== 11
        ) {

          event.preventDefault();

          valid = false;

          phoneError.style.display =
            "block";

          phoneInput.style.borderColor =
            "#ff5b5b";

          if (
            !confirmPassword ||
            confirmPassword.value.length ===
              signupPassword?.value.length
          ) {

            phoneInput.focus();

          }

        }


        return valid;

      }
    );


    /* =====================================================
       LOGOUT
    ====================================================== */

    logoutTrigger?.addEventListener(
      "click",
      (event) => {

        event.preventDefault();

        if (!logoutModal) {
          return;
        }


        logoutModal.style.display =
          "flex";

        logoutModal.setAttribute(
          "aria-hidden",
          "false"
        );

        document.body.style.overflow =
          "hidden";

      }
    );


    /* =====================================================
       CANCEL LOGOUT
    ====================================================== */

    cancelLogout?.addEventListener(
      "click",
      () => {

        if (!logoutModal) {
          return;
        }


        logoutModal.style.display =
          "none";

        logoutModal.setAttribute(
          "aria-hidden",
          "true"
        );

        document.body.style.overflow =
          "";

      }
    );


    /* =====================================================
       MOBILE MENU
    ====================================================== */

    mobileMenuBtn?.addEventListener(
      "click",
      () => {

        if (!mainNavigation) {
          return;
        }


        const isOpen =
          mainNavigation.classList.toggle(
            "mobile-open"
          );


        mobileMenuBtn.setAttribute(
          "aria-expanded",
          String(isOpen)
        );


        const spans =
          mobileMenuBtn.querySelectorAll(
            "span"
          );


        if (isOpen) {

          spans[0].style.transform =
            "translateY(7px) rotate(45deg)";

          spans[1].style.opacity =
            "0";

          spans[2].style.transform =
            "translateY(-7px) rotate(-45deg)";

        } else {

          spans[0].style.transform =
            "";

          spans[1].style.opacity =
            "";

          spans[2].style.transform =
            "";

        }

      }
    );


    /* =====================================================
       CLOSE MOBILE MENU AFTER NAVIGATION
    ====================================================== */

    document
      .querySelectorAll(
        ".main-navigation .nav-link"
      )
      .forEach(
        (link) => {

          link.addEventListener(
            "click",
            () => {

              mainNavigation?.classList.remove(
                "mobile-open"
              );

              mobileMenuBtn?.setAttribute(
                "aria-expanded",
                "false"
              );

            }
          );

        }
      );


    /* =====================================================
       PREVENT MODAL SCROLL ISSUES
    ====================================================== */

    if (authModal) {

      authModal.addEventListener(
        "wheel",
        (event) => {

          /*
           * Allow the modal itself to scroll
           * when its content becomes taller
           * than the screen.
           */

          if (
            event.target.closest(
              ".auth-modal"
            )
          ) {

            return;

          }

        }
      );

    }


  }
);

</script>