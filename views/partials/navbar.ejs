<!-- =========================================================
     PUFFER ISLE RESORT | IsleRMS
     File: views/partials/navbar.ejs

     AUTHENTICATION / UI UPGRADE

     Current capabilities:
     - Secure POST logout
     - CSRF token fields prepared
     - Unified login/signup modal
     - Strong client-side validation
     - Server error/success feedback
     - Password strength feedback
     - Password visibility controls
     - Accessible dialogs
     - Focus management
     - Keyboard navigation
     - Escape-key support
     - Mobile navigation
     - Accessible dropdowns
     - Double-submit prevention
     - bfcache/page restoration handling
     - Responsive production styling

     Backend CSRF verification is intentionally NOT enabled yet.
========================================================= -->

<%
  const displayUser =
    user ||
    currentUser ||
    null;

  const fullName =
    String(
      displayUser?.fullname ||
      "Island Guest"
    ).trim();

  const firstName =
    fullName.split(/\s+/)[0] ||
    "Guest";

  const avatarLetter =
    firstName.charAt(0).toUpperCase() ||
    "G";

  const activePath =
    String(
      currentPath || ""
    ).trim();

  const safeCsrfToken =
    typeof csrfToken !== "undefined"
      ? String(csrfToken || "")
      : "";
%>

<header class="site-header">
  <div class="navbar-container">

    <!-- =====================================================
         BRAND
    ====================================================== -->

    <a
      href="/"
      class="brand"
      aria-label="Puffer Isle Resort home"
    >
      <div class="logo-container">
        <img
          src="/images/islelogo.png"
          alt="Puffer Isle Resort"
          class="logo"
          width="46"
          height="46"
          decoding="async"
        >
      </div>

      <div class="brand-text">
        <span class="brand-name">
          Puffer Isle
        </span>

        <span class="brand-subtitle">
          Resort
        </span>
      </div>
    </a>

    <!-- =====================================================
         MOBILE MENU BUTTON
    ====================================================== -->

    <button
      class="mobile-menu-btn"
      id="mobileMenuBtn"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="mainNavigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <nav
      id="mainNavigation"
      class="main-navigation"
      aria-label="Main navigation"
    >

      <!-- HOME -->

      <a
        href="/"
        class="nav-link <%= activePath === '/' ? 'active' : '' %>"
        <%= activePath === '/' ? 'aria-current="page"' : '' %>
      >
        Home
      </a>

      <!-- EXPLORE -->

      <a
        href="/gallery"
        class="nav-link <%= activePath === '/gallery' ? 'active' : '' %>"
        <%= activePath === '/gallery' ? 'aria-current="page"' : '' %>
      >
        Explore

        <span
          class="nav-badge"
          aria-label="360 degree experience"
        >
          360°
        </span>
      </a>

      <!-- ===================================================
           DISCOVER DROPDOWN
      ==================================================== -->

      <div class="dropdown nav-dropdown">

        <button
          type="button"
          class="dropbtn dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="discoverMenu"
        >
          <span>
            Discover
          </span>

          <span
            class="dropdown-arrow"
            aria-hidden="true"
          >
            ▾
          </span>
        </button>

        <div
          id="discoverMenu"
          class="dropdown-content"
          role="menu"
        >

          <div
            class="dropdown-heading"
            role="presentation"
          >
            Discover Puffer Isle
          </div>

          <a
            href="/#about"
            role="menuitem"
          >
            <span
              class="menu-icon"
              aria-hidden="true"
            >
              ◈
            </span>

            <span>
              <strong>
                Our Story
              </strong>

              <small>
                Learn about the resort
              </small>
            </span>
          </a>

          <a
            href="/#contact"
            role="menuitem"
          >
            <span
              class="menu-icon"
              aria-hidden="true"
            >
              ✦
            </span>

            <span>
              <strong>
                Contact Us
              </strong>

              <small>
                We're here to help
              </small>
            </span>
          </a>

          <a
            href="/rules"
            role="menuitem"
          >
            <span
              class="menu-icon"
              aria-hidden="true"
            >
              ✓
            </span>

            <span>
              <strong>
                About the Space
              </strong>

              <small>
                Resort information
              </small>
            </span>
          </a>

        </div>
      </div>

      <!-- ===================================================
           BOOK NOW
      ==================================================== -->

      <% if (displayUser) { %>

        <a
          href="/booking"
          class="booking-nav-btn"
        >
          <span>
            Book Now
          </span>

          <span
            class="booking-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>

      <% } else { %>

        <button
          type="button"
          id="bookingBtn"
          class="booking-nav-btn booking-auth-trigger"
          data-auth-mode="login"
          aria-label="Sign in to book your stay"
        >
          <span>
            Book Now
          </span>

          <span
            class="booking-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </button>

      <% } %>

      <!-- ===================================================
           USER ACCOUNT
      ==================================================== -->

      <% if (displayUser) { %>

        <div class="dropdown profile-wrapper">

          <button
            type="button"
            class="profile-pill dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="profileMenu"
          >
            <span
              class="avatar-icon"
              aria-hidden="true"
            >
              <%= avatarLetter %>
            </span>

            <span class="user-name">
              <%= firstName %>
            </span>

            <span
              class="profile-arrow"
              aria-hidden="true"
            >
              ▾
            </span>
          </button>

          <div
            id="profileMenu"
            class="dropdown-content profile-dropdown"
            role="menu"
          >

            <div
              class="profile-header"
              role="presentation"
            >
              <div
                class="profile-avatar"
                aria-hidden="true"
              >
                <%= avatarLetter %>
              </div>

              <div class="profile-identity">
                <strong>
                  <%= fullName %>
                </strong>

                <small>
                  Guest Account
                </small>
              </div>
            </div>

            <div
              class="profile-divider"
              role="separator"
            ></div>

            <a
              href="/profile"
              role="menuitem"
            >
              <span
                class="menu-icon"
                aria-hidden="true"
              >
                ◎
              </span>

              <span>
                <strong>
                  My Dashboard
                </strong>

                <small>
                  Manage your stay
                </small>
              </span>
            </a>

            <button
              type="button"
              id="logoutTrigger"
              class="dropdown-action logout-link"
              role="menuitem"
            >
              <span
                class="menu-icon"
                aria-hidden="true"
              >
                ↪
              </span>

              <span>
                <strong>
                  Logout
                </strong>

                <small>
                  Sign out of your account
                </small>
              </span>
            </button>

          </div>
        </div>

      <% } else { %>

        <!-- SIGN IN -->

        <button
          id="loginBtn"
          class="login-btn"
          type="button"
          data-auth-mode="login"
        >
          Sign In
        </button>

      <% } %>

    </nav>
  </div>
</header>

<!-- =========================================================
     CUSTOMER AUTHENTICATION MODAL
========================================================= -->

<% if (!displayUser) { %>

  <div
    id="authModal"
    class="modal"
    aria-hidden="true"
    role="presentation"
  >

    <div
      class="modal-content auth-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="authTitle"
      aria-describedby="authDescription"
      tabindex="-1"
    >

      <!-- CLOSE -->

      <button
        class="close"
        id="authCloseBtn"
        type="button"
        aria-label="Close authentication window"
      >
        <span aria-hidden="true">
          &times;
        </span>
      </button>

      <!-- BRAND LOGO -->

      <div class="auth-logo">
        <img
          src="/images/islelogo.png"
          alt="Puffer Isle Resort"
          width="78"
          height="78"
          decoding="async"
        >
      </div>

      <!-- ===================================================
           AUTH MESSAGE
      ==================================================== -->

      <div
        id="authMessage"
        class="auth-message"
        aria-live="assertive"
        aria-atomic="true"
        role="alert"
      ></div>

      <!-- ===================================================
           LOGIN
      ==================================================== -->

      <section
        id="loginForm"
        class="auth-box"
        aria-labelledby="authTitle"
      >

        <div class="auth-header">

          <span class="auth-eyebrow">
            Welcome Back
          </span>

          <h2 id="authTitle">
            Sign in to your account
          </h2>

          <p id="authDescription">
            Continue planning your island escape.
          </p>

        </div>

        <form
          method="POST"
          action="/login"
          id="loginFormElem"
          autocomplete="on"
        >

          <!-- CSRF -->

          <input
            type="hidden"
            name="_csrf"
            value="<%= safeCsrfToken %>"
          >

          <!-- EMAIL -->

          <div class="input-group">

            <label for="loginEmail">
              Email Address
            </label>

            <input
              id="loginEmail"
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              spellcheck="false"
              autocapitalize="none"
              required
              aria-required="true"
            >

            <small
              id="loginEmailHelp"
              class="input-help"
            >
              Use the email associated with your IsleRMS account.
            </small>

          </div>

          <!-- PASSWORD -->

          <div class="input-group">

            <label for="loginPassword">
              Password
            </label>

            <div class="password-wrapper">

              <input
                id="loginPassword"
                type="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                maxlength="128"
                required
                aria-required="true"
              >

              <button
                type="button"
                class="password-toggle"
                data-target="loginPassword"
                aria-label="Show password"
                aria-pressed="false"
                title="Show password"
              >
                👁
              </button>

            </div>

          </div>

          <!-- SUBMIT -->

          <button
            type="submit"
            class="auth-submit"
            id="loginSubmit"
          >
            <span class="submit-label">
              Sign In
            </span>

            <span
              class="submit-spinner"
              aria-hidden="true"
            ></span>

            <span
              class="submit-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </button>

        </form>

        <p class="auth-footer">
          New to Puffer Isle?

          <a
            href="#"
            id="showSignup"
          >
            Create an account
          </a>
        </p>

      </section>

      <!-- ===================================================
           SIGN UP
      ==================================================== -->

      <section
        id="signupForm"
        class="auth-box hidden"
        aria-labelledby="signupTitle"
      >

        <div class="auth-header">

          <span class="auth-eyebrow">
            Begin Your Journey
          </span>

          <h2 id="signupTitle">
            Join Puffer Isle
          </h2>

          <p>
            Create your account and start planning
            your perfect escape.
          </p>

        </div>

        <form
          id="signupFormElem"
          method="POST"
          action="/signup"
          autocomplete="on"
          novalidate
        >

          <!-- CSRF -->

          <input
            type="hidden"
            name="_csrf"
            value="<%= safeCsrfToken %>"
          >

          <!-- FULL NAME -->

          <div class="input-group">

            <label for="fullname">
              Full Name
            </label>

            <input
              id="fullname"
              type="text"
              name="fullname"
              placeholder="Your full name"
              autocomplete="name"
              maxlength="50"
              required
              aria-required="true"
              aria-describedby="fullnameHelp"
            >

            <small
              id="fullnameHelp"
              class="input-help"
            >
              Enter your name as it should appear on your booking.
            </small>

          </div>

          <!-- EMAIL -->

          <div class="input-group">

            <label for="signupEmail">
              Email Address
            </label>

            <input
              id="signupEmail"
              type="email"
              name="email"
              placeholder="you@example.com"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              spellcheck="false"
              autocapitalize="none"
              required
              aria-required="true"
              aria-describedby="signupEmailHelp"
            >

            <small
              id="signupEmailHelp"
              class="input-help"
            >
              Use an email address you actively check.
            </small>

          </div>

          <!-- OPTIONAL USERNAME -->

          <div class="input-group">

            <label for="signupUsername">
              Username

              <span class="optional-label">
                Optional
              </span>
            </label>

            <input
              id="signupUsername"
              type="text"
              name="username"
              placeholder="e.g. islandguest"
              autocomplete="username"
              maxlength="50"
              spellcheck="false"
              autocapitalize="none"
              pattern="[A-Za-z0-9._-]+"
              aria-describedby="usernameHelp"
            >

            <small
              id="usernameHelp"
              class="input-help"
            >
              Letters, numbers, dots, underscores, and hyphens only.
            </small>

          </div>

          <!-- PASSWORD -->

          <div class="input-group">

            <div class="field-label-row">

              <label for="signupPassword">
                Password
              </label>

              <span
                id="passwordStrengthLabel"
                class="password-strength-label"
                aria-live="polite"
              ></span>

            </div>

            <div class="password-wrapper">

              <input
                id="signupPassword"
                type="password"
                name="password"
                placeholder="Create a password"
                autocomplete="new-password"
                minlength="10"
                maxlength="128"
                required
                aria-required="true"
                aria-describedby="passwordRequirement passwordStrengthLabel"
              >

              <button
                type="button"
                class="password-toggle"
                data-target="signupPassword"
                aria-label="Show password"
                aria-pressed="false"
                title="Show password"
              >
                👁
              </button>

            </div>

            <div
              class="password-strength"
              aria-hidden="true"
            >
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <small
              id="passwordRequirement"
              class="input-help"
            >
              Use at least 10 characters. Avoid common or easily guessed passwords.
            </small>

          </div>

          <!-- CONFIRM PASSWORD -->

          <div class="input-group">

            <label for="confirmPassword">
              Confirm Password
            </label>

            <div class="password-wrapper">

              <input
                id="confirmPassword"
                type="password"
                name="confirmPassword"
                placeholder="Re-enter your password"
                autocomplete="new-password"
                minlength="10"
                maxlength="128"
                required
                aria-required="true"
                aria-describedby="passwordMatchError passwordMatchSuccess"
              >

              <button
                type="button"
                class="password-toggle"
                data-target="confirmPassword"
                aria-label="Show password"
                aria-pressed="false"
                title="Show password"
              >
                👁
              </button>

            </div>

            <small
              id="passwordMatchError"
              class="error-msg"
              aria-live="polite"
            >
              Passwords do not match.
            </small>

            <small
              id="passwordMatchSuccess"
              class="success-msg"
              aria-live="polite"
            >
              Passwords match.
            </small>

          </div>

          <!-- PHONE -->

          <div class="input-group">

            <label for="phoneInput">
              Contact Number
            </label>

            <input
              type="tel"
              name="phone"
              id="phoneInput"
              placeholder="09xxxxxxxxx"
              maxlength="11"
              minlength="11"
              inputmode="numeric"
              autocomplete="tel"
              pattern="09[0-9]{9}"
              required
              aria-required="true"
              aria-describedby="phoneHelp phoneError"
            >

            <small
              id="phoneHelp"
              class="input-help"
            >
              Enter your 11-digit Philippine mobile number.
            </small>

            <small
              id="phoneError"
              class="error-msg"
              aria-live="polite"
            >
              Please enter a valid Philippine mobile number.
            </small>

          </div>

          <!-- SUBMIT -->

          <button
            type="submit"
            class="auth-submit"
            id="signupSubmit"
          >
            <span class="submit-label">
              Create Account
            </span>

            <span
              class="submit-spinner"
              aria-hidden="true"
            ></span>

            <span
              class="submit-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </button>

        </form>

        <p class="auth-footer">
          Already have an account?

          <a
            href="#"
            id="showLogin"
          >
            Sign in
          </a>
        </p>

      </section>

    </div>
  </div>

<% } %>

<!-- =========================================================
     LOGOUT CONFIRMATION MODAL
========================================================= -->

<% if (displayUser) { %>

  <div
    id="logoutModal"
    class="modal"
    aria-hidden="true"
    role="presentation"
  >

    <div
      class="modal-content logout-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="logoutTitle"
      aria-describedby="logoutDescription"
      tabindex="-1"
    >

      <div
        class="logout-icon"
        aria-hidden="true"
      >
        🏝️
      </div>

      <span class="auth-eyebrow">
        Before You Go
      </span>

      <h2 id="logoutTitle">
        Leaving the Isle?
      </h2>

      <p id="logoutDescription">
        Are you sure you want to sign out?
        Any unsaved booking progress may be lost.
      </p>

      <div class="logout-actions">

        <button
          id="cancelLogout"
          type="button"
          class="stay-btn"
        >
          Stay
        </button>

        <form
          method="POST"
          action="/logout"
          id="logoutForm"
        >

          <!-- CSRF -->

          <input
            type="hidden"
            name="_csrf"
            value="<%= safeCsrfToken %>"
          >

          <button
            type="submit"
            class="logout-confirm-btn"
            id="logoutSubmit"
          >
            <span class="submit-label">
              Logout
            </span>

            <span
              class="submit-spinner"
              aria-hidden="true"
            ></span>
          </button>

        </form>

      </div>

    </div>
  </div>

<% } %>

<!-- =========================================================
     EMBEDDED CSS
========================================================= -->

<style>
  :root {
    --brand-yellow: #FFD700;
    --brand-yellow-dark: #e6c200;

    --dark: #151515;
    --dark-soft: #202020;

    --text-light: #ffffff;
    --text-muted: #9d9d9d;

    --teal: #008080;

    --danger: #e04444;
    --danger-soft: rgba(224, 68, 68, 0.10);

    --success: #45d88a;
    --success-soft: rgba(69, 216, 138, 0.10);

    --border-light: rgba(255,255,255,0.10);

    --shadow-heavy:
      0 35px 100px rgba(0,0,0,0.65);

    --radius-lg: 28px;
    --radius-md: 16px;
    --radius-sm: 11px;

    --transition:
      0.22s ease;
  }

  .site-header,
  .site-header *,
  .modal,
  .modal * {
    box-sizing: border-box;
  }

  /* ========================================================
     HEADER
  ======================================================== */

  .site-header {
    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 76px;

    background:
      rgba(18, 18, 18, 0.97);

    border-bottom:
      1px solid rgba(255,255,255,0.07);

    box-shadow:
      0 8px 35px rgba(0,0,0,0.25);

    z-index: 1000;

    -webkit-backdrop-filter:
      blur(14px);

    backdrop-filter:
      blur(14px);
  }

  .navbar-container {
    height: 100%;

    max-width: 1500px;

    margin: 0 auto;

    padding:
      0 45px;

    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 30px;
  }

  /* ========================================================
     BRAND
  ======================================================== */

  .brand {
    display: flex;

    align-items: center;

    gap: 12px;

    min-width: max-content;

    color: white;

    text-decoration:
      none;
  }

  .logo-container {
    width: 46px;
    height: 46px;

    display: flex;

    align-items: center;
    justify-content: center;
  }

  .logo {
    width: 46px;
    height: 46px;

    object-fit: contain;

    filter:
      drop-shadow(
        0 0 8px rgba(255,215,0,0.3)
      );
  }

  .brand-text {
    display: flex;

    align-items: baseline;

    gap: 5px;
  }

  .brand-name {
    color: white;

    font-size: 19px;

    font-weight: 700;
  }

  .brand-subtitle {
    color:
      var(--brand-yellow);

    font-size: 19px;

    font-weight: 700;
  }

  /* ========================================================
     NAVIGATION
  ======================================================== */

  .main-navigation {
    display: flex;

    align-items: center;

    justify-content:
      flex-end;

    gap: 8px;
  }

  .nav-link,
  .dropbtn {
    position: relative;

    padding:
      11px 13px;

    border: none;

    background:
      transparent;

    color:
      rgba(255,255,255,0.78);

    font-family:
      inherit;

    font-size: 18px;

    font-weight: 500;

    letter-spacing:
      0.2px;

    cursor: pointer;

    text-decoration:
      none;

    transition:
      color var(--transition);
  }

  .nav-link::after {
    content: "";

    position: absolute;

    left: 13px;
    right: 13px;

    bottom: 3px;

    height: 2px;

    background:
      var(--brand-yellow);

    transform:
      scaleX(0);

    transform-origin:
      center;

    transition:
      transform var(--transition);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .dropbtn:hover,
  .dropbtn:focus-visible {
    color: white;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform:
      scaleX(1);
  }

  .nav-link:focus-visible,
  .dropbtn:focus-visible,
  .booking-nav-btn:focus-visible,
  .login-btn:focus-visible,
  .profile-pill:focus-visible,
  .mobile-menu-btn:focus-visible {
    outline:
      2px solid var(--brand-yellow);

    outline-offset:
      3px;
  }

  .nav-badge {
    font-size: 9px;

    color:
      var(--brand-yellow);

    margin-left: 2px;
  }

  /* ========================================================
     DROPDOWNS
  ======================================================== */

  .dropdown {
    position: relative;
  }

  .dropdown-content {
    position: absolute;

    top:
      calc(100% + 13px);

    right: 0;

    width: 280px;

    padding: 8px;

    background:
      white;

    border:
      1px solid rgba(0,0,0,0.08);

    border-radius:
      var(--radius-md);

    box-shadow:
      0 25px 60px
      rgba(0,0,0,0.25);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform:
      translateY(8px);

    transition:
      opacity var(--transition),
      visibility var(--transition),
      transform var(--transition);

    z-index: 20;
  }

  .dropdown.is-open
  .dropdown-content {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
      translateY(0);
  }

  .dropdown-content::before {
    content: "";

    position: absolute;

    top: -6px;

    right: 25px;

    width: 12px;
    height: 12px;

    background: white;

    transform:
      rotate(45deg);
  }

  .dropdown-heading {
    padding:
      12px 14px 8px;

    color:
      #999;

    font-size: 10px;

    font-weight: 700;

    text-transform:
      uppercase;

    letter-spacing:
      1.4px;
  }

  .dropdown-content a,
  .dropdown-action {
    display: flex;

    align-items: center;

    gap: 12px;

    width: 100%;

    padding: 12px;

    border: 0;

    border-radius:
      10px;

    color:
      var(--dark);

    background:
      transparent;

    text-decoration:
      none;

    font-family:
      inherit;

    text-align:
      left;

    cursor: pointer;

    transition:
      background var(--transition);
  }

  .dropdown-content a:hover,
  .dropdown-content a:focus-visible,
  .dropdown-action:hover,
  .dropdown-action:focus-visible {
    background:
      #f7f7f7;
  }

  .dropdown-content a:focus-visible,
  .dropdown-action:focus-visible {
    outline:
      2px solid
      var(--brand-yellow);

    outline-offset:
      -2px;
  }

  .dropdown-content a strong,
  .dropdown-action strong {
    display: block;

    font-size: 13px;

    font-weight: 600;
  }

  .dropdown-content a small,
  .dropdown-action small {
    display: block;

    margin-top: 2px;

    color:
      #999;

    font-size: 10px;
  }

  .menu-icon {
    width: 36px;
    height: 36px;

    flex:
      0 0 36px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius:
      10px;

    background:
      #f3f3f3;

    color:
      var(--dark);

    font-size: 15px;

    transition:
      all var(--transition);
  }

  .dropdown-content a:hover .menu-icon,
  .dropdown-content a:focus-visible .menu-icon,
  .dropdown-action:hover .menu-icon,
  .dropdown-action:focus-visible .menu-icon {
    background:
      var(--brand-yellow);
  }

  .dropdown-arrow,
  .profile-arrow {
    margin-left: 4px;

    font-size: 11px;

    color:
      rgba(255,255,255,0.5);

    transition:
      transform var(--transition);
  }

  .dropdown.is-open .dropdown-arrow,
  .dropdown.is-open .profile-arrow {
    transform:
      rotate(180deg);
  }

  /* ========================================================
     BOOK NOW
  ======================================================== */

  .booking-nav-btn {
    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    margin-left: 8px;

    padding:
      11px 18px;

    border: 0;

    border-radius:
      50px;

    background:
      var(--brand-yellow);

    color:
      var(--dark) !important;

    font-family:
      inherit;

    font-size: 12px;

    font-weight: 800;

    letter-spacing:
      0.4px;

    text-transform:
      uppercase;

    text-decoration:
      none;

    box-shadow:
      0 5px 20px
      rgba(255,215,0,0.15);

    transition:
      all var(--transition);

    cursor: pointer;
  }

  .booking-nav-btn:hover {
    background:
      white;

    transform:
      translateY(-2px);

    box-shadow:
      0 10px 30px
      rgba(255,255,255,0.08);
  }

  .booking-arrow {
    font-size: 15px;

    transition:
      transform var(--transition);
  }

  .booking-nav-btn:hover
  .booking-arrow {
    transform:
      translateX(3px);
  }

  /* ========================================================
     SIGN IN
  ======================================================== */

  .login-btn {
    margin-left: 4px;

    padding:
      11px 18px;

    background:
      transparent;

    color:
      rgba(255,255,255,0.85);

    border:
      1px solid
      rgba(255,255,255,0.18);

    border-radius:
      50px;

    font-family:
      inherit;

    font-size: 12px;

    font-weight: 600;

    cursor: pointer;

    transition:
      all var(--transition);
  }

  .login-btn:hover {
    color:
      var(--dark);

    background:
      white;

    border-color:
      white;
  }

  /* ========================================================
     PROFILE
  ======================================================== */

  .profile-pill {
    display: flex;

    align-items: center;

    gap: 8px;

    padding:
      6px 11px 6px 6px;

    background:
      rgba(255,255,255,0.07);

    border:
      1px solid
      rgba(255,255,255,0.10);

    border-radius:
      50px;

    color: white;

    font-family:
      inherit;

    cursor: pointer;

    transition:
      all var(--transition);
  }

  .profile-pill:hover {
    background:
      rgba(255,255,255,0.12);
  }

  .avatar-icon {
    width: 31px;
    height: 31px;

    border-radius:
      50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
      var(--brand-yellow);

    color:
      var(--dark);

    font-size: 13px;

    font-weight: 800;
  }

  .user-name {
    font-size: 12px;

    font-weight: 600;

    max-width: 120px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
  }

  .profile-dropdown {
    width: 280px;
  }

  .profile-header {
    display: flex;

    align-items: center;

    gap: 12px;

    padding: 12px;
  }

  .profile-avatar {
    width: 43px;
    height: 43px;

    flex: 0 0 43px;

    border-radius:
      50%;

    display: flex;

    align-items: center;

    justify-content: center;

    background:
      var(--brand-yellow);

    color:
      var(--dark);

    font-weight: 800;
  }

  .profile-identity {
    min-width: 0;
  }

  .profile-header strong {
    display: block;

    color:
      var(--dark);

    font-size: 13px;

    overflow:
      hidden;

    text-overflow:
      ellipsis;

    white-space:
      nowrap;
  }

  .profile-header small {
    display: block;

    margin-top: 2px;

    color:
      #999;

    font-size: 10px;
  }

  .profile-divider {
    height: 1px;

    background:
      #eee;

    margin:
      3px 8px 8px;
  }

  .logout-link:hover,
  .logout-link:focus-visible {
    background:
      #fff3f3 !important;
  }

  .logout-link:hover strong,
  .logout-link:focus-visible strong {
    color:
      #d93030;
  }

  /* ========================================================
     MOBILE MENU BUTTON
  ======================================================== */

  .mobile-menu-btn {
    display: none;

    width: 42px;
    height: 42px;

    padding: 8px;

    background:
      transparent;

    border:
      1px solid
      rgba(255,255,255,0.15);

    border-radius:
      10px;

    cursor: pointer;
  }

  .mobile-menu-btn span {
    display: block;

    height: 2px;

    margin: 5px 0;

    background:
      white;

    border-radius:
      10px;

    transition:
      all var(--transition);
  }

  /* ========================================================
     MODALS
  ======================================================== */

  .modal {
    display: none;

    position: fixed;

    inset: 0;

    padding: 20px;

    background:
      rgba(0,0,0,0.76);

    backdrop-filter:
      blur(10px);

    -webkit-backdrop-filter:
      blur(10px);

    justify-content:
      center;

    align-items:
      center;

    overflow-y:
      auto;

    z-index: 2000;
  }

  .modal.is-open {
    display: flex;
  }

  .modal-content {
    position: relative;

    width: 100%;

    max-height:
      calc(100vh - 40px);

    overflow-y:
      auto;

    color:
      white;

    box-shadow:
      var(--shadow-heavy);

    overscroll-behavior:
      contain;
  }

  .modal-content:focus {
    outline:
      none;
  }

  @keyframes modalFade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes modalSlide {
    from {
      opacity: 0;

      transform:
        translateY(25px)
        scale(0.97);
    }

    to {
      opacity: 1;

      transform:
        translateY(0)
        scale(1);
    }
  }

  .modal.is-open {
    animation:
      modalFade 0.25s ease;
  }

  /* ========================================================
     AUTH MODAL
  ======================================================== */

  .auth-modal {
    max-width: 560px;

    padding:
      48px 50px;

    border-radius:
      var(--radius-lg);

    background:
      linear-gradient(
        145deg,
        #292929,
        #151515
      );

    border:
      1px solid
      rgba(255,255,255,0.12);

    animation:
      modalSlide 0.3s ease;
  }

  .close {
    position: absolute;

    top: 17px;
    right: 20px;

    width: 36px;
    height: 36px;

    border: none;

    background:
      rgba(255,255,255,0.06);

    border-radius:
      50%;

    color:
      rgba(255,255,255,0.55);

    font-size: 24px;

    line-height: 1;

    cursor: pointer;

    transition:
      all var(--transition);
  }

  .close:hover,
  .close:focus-visible {
    background:
      rgba(255,255,255,0.12);

    color:
      white;

    transform:
      rotate(90deg);
  }

  .close:focus-visible {
    outline:
      2px solid
      var(--brand-yellow);

    outline-offset:
      2px;
  }

  .auth-logo {
    text-align:
      center;

    margin-bottom:
      20px;
  }

  .auth-logo img {
    width: 78px;
    height: 78px;

    object-fit:
      contain;

    filter:
      drop-shadow(
        0 0 12px
        rgba(255,215,0,0.30)
      );
  }

  .auth-header {
    text-align:
      center;
  }

  .auth-eyebrow {
    display:
      block;

    margin-bottom:
      8px;

    color:
      var(--brand-yellow);

    font-size:
      10px;

    font-weight:
      700;

    letter-spacing:
      2px;

    text-transform:
      uppercase;
  }

  .auth-header h2,
  .logout-modal h2 {
    margin:
      0 0 10px;

    color:
      white;

    font-size:
      2rem;

    line-height:
      1.2;

    font-weight:
      700;
  }

  .auth-header p,
  .logout-modal > p {
    margin:
      0 0 28px;

    color:
      rgba(255,255,255,0.55);

    font-size:
      0.88rem;

    line-height:
      1.6;
  }

  /* ========================================================
     AUTH MESSAGE
  ======================================================== */

  .auth-message {
    display:
      none;

    margin:
      0 0 20px;

    padding:
      13px 14px;

    border-radius:
      10px;

    font-size:
      0.80rem;

    line-height:
      1.5;

    border:
      1px solid
      transparent;
  }

  .auth-message.is-visible {
    display:
      block;
  }

  .auth-message.error {
    background:
      var(--danger-soft);

    color:
      #ff9b9b;

    border-color:
      rgba(224,68,68,0.22);
  }

  .auth-message.success {
    background:
      var(--success-soft);

    color:
      #78e8a9;

    border-color:
      rgba(69,216,138,0.20);
  }

  /* ========================================================
     INPUT GROUP
  ======================================================== */

  .input-group {
    margin-bottom:
      18px;
  }

  .input-group label {
    display:
      block;

    margin-bottom:
      8px;

    color:
      rgba(255,255,255,0.78);

    font-size:
      12px;

    font-weight:
      600;
  }

  .field-label-row {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      12px;

    margin-bottom:
      8px;
  }

  .field-label-row label {
    margin-bottom:
      0;
  }

  .optional-label {
    color:
      rgba(255,255,255,0.35);

    font-size:
      10px;

    font-weight:
      500;

    margin-left:
      5px;
  }

  .input-help {
    display:
      block;

    margin-top:
      6px;

    color:
      rgba(255,255,255,0.40);

    font-size:
      10px;

    line-height:
      1.5;
  }

  /* ========================================================
     INPUTS
  ======================================================== */

  .modal input {
    width:
      100%;

    height:
      50px;

    padding:
      14px 15px;

    border:
      1px solid
      rgba(255,255,255,0.10);

    border-radius:
      var(--radius-sm);

    outline:
      none;

    background:
      rgba(255,255,255,0.96);

    color:
      #222;

    font-family:
      inherit;

    font-size:
      0.90rem;

    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      background var(--transition);
  }

  .modal input::placeholder {
    color:
      #aaa;
  }

  .modal input:hover {
    background:
      white;
  }

  .modal input:focus {
    border-color:
      var(--brand-yellow);

    box-shadow:
      0 0 0 3px
      rgba(255,215,0,0.12);

    background:
      white;
  }

  .modal input.is-invalid {
    border-color:
      #ff5b5b;

    box-shadow:
      0 0 0 3px
      rgba(255,91,91,0.08);
  }

  .modal input.is-valid {
    border-color:
      var(--success);

    box-shadow:
      0 0 0 3px
      rgba(69,216,138,0.08);
  }

  .modal input:disabled {
    opacity:
      0.65;

    cursor:
      not-allowed;
  }

  /* ========================================================
     PASSWORD
  ======================================================== */

  .password-wrapper {
    position:
      relative;

    width:
      100%;
  }

  .password-wrapper input {
    padding-right:
      55px;
  }

  .password-toggle {
    position:
      absolute;

    top:
      50%;

    right:
      7px;

    transform:
      translateY(-50%);

    width:
      38px;

    height:
      38px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      none;

    border-radius:
      8px;

    background:
      transparent;

    color:
      #777;

    font-size:
      16px;

    cursor:
      pointer;

    transition:
      all var(--transition);
  }

  .password-toggle:hover {
    background:
      #eeeeee;

    color:
      #222;
  }

  .password-toggle:focus-visible {
    outline:
      2px solid
      var(--brand-yellow);

    outline-offset:
      1px;
  }

  .password-strength {
    display:
      grid;

    grid-template-columns:
      repeat(4, 1fr);

    gap:
      4px;

    margin-top:
      7px;

    height:
      3px;
  }

  .password-strength span {
    display:
      block;

    height:
      3px;

    border-radius:
      999px;

    background:
      rgba(255,255,255,0.10);

    transition:
      background var(--transition);
  }

  .password-strength.weak
  span:nth-child(-n+1) {
    background:
      #e04444;
  }

  .password-strength.fair
  span:nth-child(-n+2) {
    background:
      #e8a43b;
  }

  .password-strength.good
  span:nth-child(-n+3) {
    background:
      #68bb70;
  }

  .password-strength.strong
  span {
    background:
      var(--success);
  }

  .password-strength-label {
    color:
      rgba(255,255,255,0.40);

    font-size:
      10px;

    font-weight:
      600;

    min-height:
      14px;
  }

  /* ========================================================
     ERROR / SUCCESS
  ======================================================== */

  .error-msg,
  .success-msg {
    display:
      none;

    margin-top:
      6px;

    font-size:
      10px;

    line-height:
      1.5;
  }

  .error-msg {
    color:
      #ff7272;
  }

  .success-msg {
    color:
      var(--success);
  }

  .error-msg.is-visible,
  .success-msg.is-visible {
    display:
      block;
  }

  /* ========================================================
     SUBMIT
  ======================================================== */

  .auth-submit {
    width:
      100%;

    min-height:
      52px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      10px;

    margin-top:
      8px;

    padding:
      15px;

    border:
      none;

    border-radius:
      var(--radius-sm);

    background:
      var(--brand-yellow);

    color:
      var(--dark);

    font-family:
      inherit;

    font-size:
      0.82rem;

    font-weight:
      800;

    letter-spacing:
      0.7px;

    text-transform:
      uppercase;

    cursor:
      pointer;

    transition:
      all var(--transition);
  }

  .auth-submit:hover {
    background:
      white;

    transform:
      translateY(-2px);

    box-shadow:
      0 8px 25px
      rgba(255,215,0,0.15);
  }

  .auth-submit:disabled {
    opacity:
      0.68;

    cursor:
      wait;

    transform:
      none;

    box-shadow:
      none;
  }

  .submit-arrow {
    font-size:
      17px;

    transition:
      transform var(--transition);
  }

  .auth-submit:hover
  .submit-arrow {
    transform:
      translateX(4px);
  }

  .submit-spinner {
    display:
      none;

    width:
      14px;

    height:
      14px;

    border:
      2px solid
      currentColor;

    border-right-color:
      transparent;

    border-radius:
      50%;

    animation:
      submitSpin 0.70s linear infinite;
  }

  .is-loading
  .submit-spinner {
    display:
      inline-block;
  }

  .is-loading
  .submit-arrow {
    display:
      none;
  }

  @keyframes submitSpin {
    to {
      transform:
        rotate(360deg);
    }
  }

  /* ========================================================
     AUTH FOOTER
  ======================================================== */

  .auth-footer {
    margin:
      22px 0 0;

    text-align:
      center;

    color:
      rgba(255,255,255,0.45);

    font-size:
      0.80rem;
  }

  .auth-footer a {
    color:
      var(--brand-yellow);

    font-weight:
      600;

    text-decoration:
      none;
  }

  .auth-footer a:hover,
  .auth-footer a:focus-visible {
    text-decoration:
      underline;
  }

  .auth-footer a:focus-visible {
    outline:
      2px solid
      var(--brand-yellow);

    outline-offset:
      3px;
  }

  .hidden {
    display:
      none !important;
  }

  /* ========================================================
     LOGOUT
  ======================================================== */

  .logout-modal {
    max-width:
      430px;

    padding:
      45px 40px;

    border-radius:
      24px;

    background:
      linear-gradient(
        145deg,
        #242424,
        #151515
      );

    border:
      1px solid
      rgba(255,255,255,0.10);

    text-align:
      center;

    animation:
      modalSlide 0.3s ease;
  }

  .logout-icon {
    width:
      70px;

    height:
      70px;

    margin:
      0 auto 20px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border-radius:
      50%;

    background:
      rgba(255,215,0,0.09);

    border:
      1px solid
      rgba(255,215,0,0.15);

    font-size:
      30px;
  }

  .logout-actions {
    display:
      grid;

    grid-template-columns:
      1fr 1fr;

    gap:
      12px;

    margin-top:
      25px;
  }

  .logout-actions form {
    margin:
      0;
  }

  .stay-btn,
  .logout-confirm-btn {
    width:
      100%;

    min-height:
      46px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      8px;

    padding:
      13px;

    border-radius:
      10px;

    font-family:
      inherit;

    font-size:
      0.80rem;

    font-weight:
      700;

    cursor:
      pointer;

    text-align:
      center;

    transition:
      all var(--transition);
  }

  .stay-btn {
    background:
      rgba(255,255,255,0.07);

    color:
      white;

    border:
      1px solid
      rgba(255,255,255,0.12);
  }

  .stay-btn:hover {
    background:
      rgba(255,255,255,0.12);
  }

  .logout-confirm-btn {
    border:
      none;

    background:
      var(--danger);

    color:
      white;
  }

  .logout-confirm-btn:hover {
    background:
      #f05252;
  }

  .logout-confirm-btn:disabled,
  .stay-btn:disabled {
    opacity:
      0.60;

    cursor:
      not-allowed;
  }

  .stay-btn:focus-visible,
  .logout-confirm-btn:focus-visible {
    outline:
      2px solid
      var(--brand-yellow);

    outline-offset:
      3px;
  }

  /* ========================================================
     RESPONSIVE - TABLET
  ======================================================== */

  @media (max-width: 1100px) {
    .navbar-container {
      padding:
        0 25px;
    }

    .nav-link,
    .dropbtn {
      padding:
        10px 8px;

      font-size:
        16px;
    }

    .booking-nav-btn {
      padding:
        10px 14px;
    }

    .user-name {
      max-width:
        90px;
    }
  }

  /* ========================================================
     RESPONSIVE - MOBILE
  ======================================================== */

  @media (max-width: 850px) {
    .site-header {
      height:
        68px;
    }

    .navbar-container {
      padding:
        0 18px;
    }

    .brand-subtitle {
      display:
