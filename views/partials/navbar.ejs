  /* ========================================================
     MODALS
  ======================================================== */

  .modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 20px;
    background: rgba(0,0,0,0.76);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
