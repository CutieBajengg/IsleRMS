    left: 13px;
    right: 13px;
    bottom: 3px;
    height: 2px;
    background: var(--brand-yellow);
    transform: scaleX(0);
    transition: transform var(--transition);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .dropbtn:hover,
  .dropbtn:focus-visible { color: white; }

  .nav-link:hover::after,
