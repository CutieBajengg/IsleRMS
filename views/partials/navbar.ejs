<!-- =========================================================
     PUFFER ISLE RESORT | IsleRMS
     File: views/partials/navbar.ejs

     CUSTOMER AUTHENTICATION / UI

     Compatible endpoints:
       POST /login
       POST /signup/request-otp
       POST /signup/verify-otp
       POST /signup/resend-otp
       POST /auth/google/start
       GET  /auth/google                 (legacy compatibility)
       POST /auth/forgot-password
       POST /auth/reset-password
       POST /auth/google/complete-profile
       POST /logout

     Optional EJS variable:
       captchaSiteKey

     Notes:
       - Navbar styling/structure remains intentionally preserved.
       - Auth is rebuilt as one cohesive guest account journey.
       - Login remains a native POST for compatibility.
       - OTP/recovery/profile completion use JSON/AJAX flows.
       - Cloudflare Turnstile is explicit + interaction-only when configured.
       - Bot signals complement server-side controls; they are never the security boundary.
========================================================= -->

<%
  const displayUser =
    user ||
    currentUser ||
    null;

  const fullName =
    String(
      displayUser?.fullname ||
      "Island Guest"
    ).trim();

  const firstName =
    fullName.split(/\s+/)[0] ||
    "Guest";

  const avatarLetter =
    firstName.charAt(0).toUpperCase() ||
    "G";

  const userEmail =
    String(
      displayUser?.email ||
      ""
    ).trim();

  const activePath =
    String(
      currentPath || ""
    ).trim();

  const safeCsrfToken =
    typeof csrfToken !== "undefined"
      ? String(csrfToken || "")
      : "";

  const authCaptchaSiteKey =
    typeof captchaSiteKey !== "undefined"
      ? String(captchaSiteKey || "").trim()
      : "";
%>


<!-- =========================================================
     HEADER
========================================================= -->

<header class="site-header">

  <div class="navbar-container">

    <a
      href="/"
      class="brand"
      aria-label="Puffer Isle Resort home"
    >
      <div class="logo-container">
        <img
          src="/images/islelogo.png"
          alt="Puffer Isle Resort"
          class="logo"
          width="46"
          height="46"
          decoding="async"
        >
      </div>

      <div class="brand-text">
        <span class="brand-name">Puffer Isle</span>
        <span class="brand-subtitle">Resort</span>
      </div>
    </a>


    <button
      class="mobile-menu-btn"
      id="mobileMenuBtn"
      type="button"
      aria-label="Open navigation menu"
      aria-controls="mainNavigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>


    <nav
      id="mainNavigation"
      class="main-navigation"
      aria-label="Main navigation"
    >

      <a
        href="/"
        class="nav-link <%= activePath === '/' ? 'active' : '' %>"
        <%= activePath === '/' ? 'aria-current="page"' : '' %>
      >
        Home
      </a>

      <a
        href="/gallery"
        class="nav-link <%= activePath === '/gallery' ? 'active' : '' %>"
        <%= activePath === '/gallery' ? 'aria-current="page"' : '' %>
      >
        Explore
        <span
          class="nav-badge"
          aria-label="360 degree experience"
        >360°</span>
      </a>


      <div class="dropdown nav-dropdown">
        <button
          type="button"
          class="dropbtn dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="discoverMenu"
        >
          <span>Discover</span>
          <span class="dropdown-arrow" aria-hidden="true">▾</span>
        </button>

        <div
          id="discoverMenu"
          class="dropdown-content"
          role="menu"
        >
          <div class="dropdown-heading" role="presentation">
            Discover Puffer Isle
          </div>

          <a href="/#about" role="menuitem">
            <span class="menu-icon" aria-hidden="true">◈</span>
            <span>
              <strong>Our Story</strong>
              <small>Learn about the resort</small>
            </span>
          </a>

          <a href="/#contact" role="menuitem">
            <span class="menu-icon" aria-hidden="true">✦</span>
            <span>
              <strong>Contact Us</strong>
              <small>We're here to help</small>
            </span>
          </a>

          <a href="/rules" role="menuitem">
            <span class="menu-icon" aria-hidden="true">✓</span>
            <span>
              <strong>About the Space</strong>
              <small>Resort information</small>
            </span>
          </a>
        </div>
      </div>


      <% if (displayUser) { %>
        <a
          href="/booking"
          class="booking-nav-btn"
        >
          <span>Book Now</span>
          <span class="booking-arrow" aria-hidden="true">→</span>
        </a>
      <% } else { %>
        <button
          type="button"
          id="bookingBtn"
          class="booking-nav-btn booking-auth-trigger"
          data-auth-mode="login"
          aria-label="Sign in to book your stay"
        >
          <span>Book Now</span>
          <span class="booking-arrow" aria-hidden="true">→</span>
        </button>
      <% } %>


      <% if (displayUser) { %>

        <div class="dropdown profile-wrapper">
          <button
            type="button"
            class="profile-pill dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="profileMenu"
          >
            <span class="avatar-icon" aria-hidden="true">
              <%= avatarLetter %>
            </span>
            <span class="user-name"><%= firstName %></span>
            <span class="profile-arrow" aria-hidden="true">▾</span>
          </button>

          <div
            id="profileMenu"
            class="dropdown-content profile-dropdown"
            role="menu"
          >
            <div class="profile-header" role="presentation">
              <div class="profile-avatar" aria-hidden="true">
                <%= avatarLetter %>
              </div>
              <div class="profile-identity">
                <strong><%= fullName %></strong>
                <small><%= userEmail || "Guest Account" %></small>
              </div>
            </div>

            <div class="profile-divider" role="separator"></div>

            <a href="/profile" role="menuitem">
              <span class="menu-icon" aria-hidden="true">◎</span>
              <span>
                <strong>My Dashboard</strong>
                <small>Manage your stay</small>
              </span>
            </a>

            <button
              type="button"
              id="logoutTrigger"
              class="dropdown-action logout-link"
              role="menuitem"
            >
              <span class="menu-icon" aria-hidden="true">↪</span>
              <span>
                <strong>Logout</strong>
                <small>Sign out of your account</small>
              </span>
            </button>
          </div>
        </div>

      <% } else { %>

        <button
          id="loginBtn"
          class="login-btn"
          type="button"
          data-auth-mode="login"
        >
          Sign In
        </button>

      <% } %>

    </nav>
  </div>
</header>


<!-- =========================================================
     CUSTOMER AUTHENTICATION MODAL
========================================================= -->

<% if (!displayUser) { %>

  <div
    id="authModal"
    class="modal"
    aria-hidden="true"
    role="presentation"
    data-csrf-token="<%= safeCsrfToken %>"
    data-captcha-enabled="<%= authCaptchaSiteKey ? 'true' : 'false' %>"
  >

    <div
      class="modal-content auth-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="authTitle"
      aria-describedby="authDescription"
      tabindex="-1"
    >

      <button
        class="close"
        id="authCloseBtn"
        type="button"
        aria-label="Close authentication window"
      >
        <span aria-hidden="true">&times;</span>
      </button>

      <div class="auth-trust-strip" id="authTrustStrip" aria-label="Authentication journey">
        <span class="auth-trust-item is-active" data-auth-trust-step="account">
          <span class="auth-trust-icon" aria-hidden="true">✦</span>
          <span>Account</span>
        </span>
        <span class="auth-trust-line" aria-hidden="true"></span>
        <span class="auth-trust-item" data-auth-trust-step="verify">
          <span class="auth-trust-icon" aria-hidden="true">✓</span>
          <span>Verify</span>
        </span>
        <span class="auth-trust-line" aria-hidden="true"></span>
        <span class="auth-trust-item" data-auth-trust-step="finish">
          <span class="auth-trust-icon" aria-hidden="true">⌂</span>
          <span>Finish</span>
        </span>
      </div>

      <div class="auth-security-note" id="authSecurityNote" role="status" aria-live="polite">
        <span class="auth-security-dot" aria-hidden="true"></span>
        <span id="authSecurityText">Protected session · Secure account access</span>
      </div>

      <div class="auth-logo">
        <img
          src="/images/islelogo.png"
          alt="Puffer Isle Resort"
          width="78"
          height="78"
          decoding="async"
        >
      </div>

      <div id="authMessage" class="auth-message" aria-live="assertive" aria-atomic="true" role="alert"></div>

      <!-- ===================================================
           LOGIN
      ==================================================== -->
      <section id="loginForm" class="auth-box" aria-labelledby="authTitle">
        <div class="auth-header">
          <span class="auth-eyebrow">Welcome Back</span>
          <h2 id="authTitle">Sign in to your account</h2>
          <p id="authDescription">Continue planning your island escape.</p>
        </div>

        <button type="button" class="google-auth-btn" id="googleLoginBtn">
          <span class="google-icon" aria-hidden="true">G</span>
          <span>Continue with Google</span>
        </button>

        <div class="auth-divider"><span>or continue with email</span></div>

        <form method="POST" action="/login" id="loginFormElem" autocomplete="on">
          <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
          <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="auth_started_at" id="loginAuthStartedAt" value="">
          <input type="hidden" name="captchaToken" id="loginCaptchaToken" value="">

          <div class="input-group">
            <label for="loginEmail">Email or Username</label>
            <input
              id="loginEmail"
              type="text"
              name="email"
              placeholder="you@example.com or username"
              autocomplete="username"
              maxlength="254"
              spellcheck="false"
              autocapitalize="none"
              required
              aria-required="true"
              aria-describedby="loginEmailHelp loginEmailError"
            >
            <small class="input-help" id="loginEmailHelp">Use the email or username associated with your IsleRMS account.</small>
            <small class="inline-field-error" id="loginEmailError" aria-live="polite"></small>
          </div>

          <div class="input-group">
            <div class="field-label-row">
              <label for="loginPassword">Password</label>
              <button type="button" class="auth-inline-link" id="forgotPasswordBtn">Forgot password?</button>
            </div>

            <div class="password-wrapper">
              <input
                id="loginPassword"
                type="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                maxlength="128"
                required
                aria-required="true"
                aria-describedby="loginPasswordError"
              >
              <button type="button" class="password-toggle" data-target="loginPassword" aria-label="Show password" aria-pressed="false" title="Show password">👁</button>
            </div>
            <small class="inline-field-error" id="loginPasswordError" aria-live="polite"></small>
          </div>

          <% if (authCaptchaSiteKey) { %>
            <div class="auth-bot-protection" id="loginBotProtection" aria-hidden="false">
              <div class="captcha-label">Security check</div>
              <div id="loginTurnstile" class="captcha-slot"></div>
              <small class="input-help">Most guests won't see an interactive challenge. Extra verification appears only when needed.</small>
            </div>
          <% } %>

          <button type="submit" class="auth-submit" id="loginSubmit">
            <span class="submit-label">Sign In</span>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span class="submit-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <p class="auth-footer">New to Puffer Isle? <a href="#" id="showSignup">Create an account</a></p>
      </section>

      <!-- ===================================================
           SIGNUP
      ==================================================== -->
      <section id="signupForm" class="auth-box hidden" aria-labelledby="signupTitle">
        <div class="auth-header">
          <span class="auth-eyebrow">Begin Your Journey</span>
          <h2 id="signupTitle">Join Puffer Isle</h2>
          <p id="signupDescription">Create your account and start planning your perfect escape.</p>
        </div>

        <button type="button" class="google-auth-btn" id="googleSignupBtn">
          <span class="google-icon" aria-hidden="true">G</span>
          <span>Continue with Google</span>
        </button>

        <div class="auth-divider"><span>or create an account with email</span></div>

        <form id="signupFormElem" method="POST" action="/signup/request-otp" autocomplete="on" novalidate>
          <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
          <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="auth_started_at" id="signupAuthStartedAt" value="">
          <input type="hidden" name="captchaToken" id="signupCaptchaToken" value="">

          <div class="input-group">
            <label for="fullname">Full Name</label>
            <input id="fullname" type="text" name="fullname" placeholder="Your full name" autocomplete="name" maxlength="100" required aria-required="true" aria-describedby="fullnameHelp">
            <small id="fullnameHelp" class="input-help">Enter your name as it should appear on your booking.</small>
          </div>

          <div class="input-group">
            <label for="signupEmail">Email Address</label>
            <input id="signupEmail" type="email" name="email" placeholder="you@example.com" autocomplete="email" inputmode="email" maxlength="254" spellcheck="false" autocapitalize="none" required aria-required="true" aria-describedby="signupEmailHelp">
            <small id="signupEmailHelp" class="input-help">A 6-digit verification code will be sent to this email.</small>
          </div>

          <div class="input-group">
            <label for="signupUsername">Username <span class="optional-label">Optional</span></label>
            <input id="signupUsername" type="text" name="username" placeholder="e.g. islandguest" autocomplete="username" maxlength="50" spellcheck="false" autocapitalize="none" pattern="[A-Za-z0-9._-]+" aria-describedby="usernameHelp">
            <small id="usernameHelp" class="input-help">Letters, numbers, dots, underscores, and hyphens only.</small>
          </div>

          <div class="input-group">
            <div class="field-label-row">
              <label for="signupPassword">Password</label>
              <span id="passwordStrengthLabel" class="password-strength-label" aria-live="polite"></span>
            </div>
            <div class="password-wrapper">
              <input id="signupPassword" type="password" name="password" placeholder="Create a password" autocomplete="new-password" minlength="10" maxlength="128" required aria-required="true" aria-describedby="passwordRequirement passwordStrengthLabel">
              <button type="button" class="password-toggle" data-target="signupPassword" aria-label="Show password" aria-pressed="false" title="Show password">👁</button>
            </div>
            <div class="password-strength" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <small id="passwordRequirement" class="input-help">Use at least 10 characters. Longer, unique passwords are stronger.</small>
          </div>

          <div class="input-group">
            <label for="confirmPassword">Confirm Password</label>
            <div class="password-wrapper">
              <input id="confirmPassword" type="password" name="confirmPassword" placeholder="Re-enter your password" autocomplete="new-password" minlength="10" maxlength="128" required aria-required="true">
              <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password" aria-pressed="false" title="Show password">👁</button>
            </div>
            <small id="passwordMatchError" class="error-msg" aria-live="polite">Passwords do not match.</small>
            <small id="passwordMatchSuccess" class="success-msg" aria-live="polite">Passwords match.</small>
          </div>

          <div class="input-group">
            <label for="phoneInput">Contact Number</label>
            <input type="tel" id="phoneInput" name="phone" placeholder="09xxxxxxxxx" maxlength="11" minlength="11" inputmode="numeric" autocomplete="tel" pattern="09[0-9]{9}" required aria-required="true">
            <small class="input-help">Your contact number helps us assist with reservations and important stay updates.</small>
            <small id="phoneError" class="error-msg" aria-live="polite">Please enter a valid Philippine mobile number.</small>
          </div>

          <% if (authCaptchaSiteKey) { %>
            <div class="auth-bot-protection" id="signupBotProtection" aria-hidden="false">
              <div class="captcha-label">Security check</div>
              <div id="signupTurnstile" class="captcha-slot"></div>
              <small class="input-help">Protected registration helps keep guest accounts authentic.</small>
            </div>
          <% } %>

          <button type="submit" class="auth-submit" id="signupSubmit">
            <span class="submit-label">Send Verification Code</span>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span class="submit-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <p class="auth-footer">Already have an account? <a href="#" id="showLogin">Sign in</a></p>
      </section>

      <!-- ===================================================
           OTP VERIFICATION
      ==================================================== -->
      <section id="otpForm" class="auth-box hidden" aria-labelledby="otpTitle">
        <div class="otp-icon" aria-hidden="true">✉</div>
        <div class="auth-header">
          <span class="auth-eyebrow">Verify Your Email</span>
          <h2 id="otpTitle">Check your inbox</h2>
          <p id="otpDescription">We sent a 6-digit verification code to <strong id="otpEmailDisplay" class="otp-email">your email</strong></p>
        </div>

        <div class="otp-status-card">
          <span class="otp-status-dot" aria-hidden="true"></span>
          <span>Code expires in <strong id="otpExpiry">10:00</strong></span>
        </div>

        <form id="otpFormElem" autocomplete="off" novalidate>
          <input type="hidden" id="otpEmail" name="email">
          <div class="otp-input-group">
            <label for="otpCode">Verification Code</label>
            <input id="otpCode" name="otp" class="otp-input" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" minlength="6" autocomplete="one-time-code" placeholder="000000" required aria-required="true" aria-describedby="otpHelp" spellcheck="false">
            <small id="otpHelp" class="input-help">Enter the 6-digit code from the email we sent you.</small>
          </div>
          <button type="submit" class="auth-submit" id="verifyOtpSubmit">
            <span class="submit-label">Verify &amp; Create Account</span>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span class="submit-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <div class="otp-actions">
          <button type="button" id="resendOtpBtn" class="otp-link-btn" disabled>Resend code</button>
          <button type="button" id="changeEmailBtn" class="otp-link-btn secondary">Change email</button>
        </div>
        <p id="resendCountdown" class="otp-countdown" aria-live="polite">You can request another code soon.</p>
      </section>

      <!-- ===================================================
           FORGOT PASSWORD
      ==================================================== -->
      <section id="forgotForm" class="auth-box hidden" aria-labelledby="forgotTitle">
        <div class="auth-hero-icon" aria-hidden="true">⌁</div>
        <div class="auth-header">
          <span class="auth-eyebrow">Account Recovery</span>
          <h2 id="forgotTitle">Reset your password</h2>
          <p id="forgotDescription">Enter the email connected to your Puffer Isle account. We'll send a secure reset link if an account is found.</p>
        </div>

        <div class="auth-info-card">
          <span class="auth-info-icon" aria-hidden="true">i</span>
          <span>For your privacy, this page never reveals whether an email address is registered.</span>
        </div>

        <form id="forgotFormElem" autocomplete="on" novalidate>
          <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
          <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="auth_started_at" id="forgotAuthStartedAt" value="">
          <input type="hidden" name="captchaToken" id="forgotCaptchaToken" value="">

          <div class="input-group">
            <label for="forgotEmail">Email Address</label>
            <input id="forgotEmail" type="email" name="email" placeholder="you@example.com" autocomplete="email" inputmode="email" maxlength="254" spellcheck="false" autocapitalize="none" required aria-required="true" aria-describedby="forgotEmailHelp forgotEmailError">
            <small class="input-help" id="forgotEmailHelp">We'll send instructions to this address if it belongs to an IsleRMS account.</small>
            <small class="inline-field-error" id="forgotEmailError" aria-live="polite"></small>
          </div>

          <% if (authCaptchaSiteKey) { %>
            <div class="auth-bot-protection" id="forgotBotProtection" aria-hidden="false">
              <div class="captcha-label">Security check</div>
              <div id="forgotTurnstile" class="captcha-slot"></div>
              <small class="input-help">A quick adaptive check helps protect account recovery from automation.</small>
            </div>
          <% } %>

          <button type="submit" class="auth-submit" id="forgotSubmit">
            <span class="submit-label">Send Reset Link</span>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span class="submit-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <button type="button" class="auth-back-link" id="backToLoginFromForgot">← Back to sign in</button>
      </section>

      <!-- ===================================================
           RESET PASSWORD
      ==================================================== -->
      <section id="resetForm" class="auth-box hidden" aria-labelledby="resetTitle">
        <div class="auth-hero-icon success" aria-hidden="true">✓</div>
        <div class="auth-header">
          <span class="auth-eyebrow">Secure Password Reset</span>
          <h2 id="resetTitle">Create a new password</h2>
          <p id="resetDescription">Choose a strong password you haven't used before. Your reset link is time-limited and one-time use.</p>
        </div>

        <form id="resetFormElem" autocomplete="on" novalidate>
          <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
          <input type="hidden" name="token" id="resetToken" value="">
          <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="auth_started_at" id="resetAuthStartedAt" value="">
          <input type="hidden" name="captchaToken" id="resetCaptchaToken" value="">

          <div class="input-group">
            <div class="field-label-row">
              <label for="resetPassword">New Password</label>
              <span id="resetPasswordStrengthLabel" class="password-strength-label" aria-live="polite"></span>
            </div>
            <div class="password-wrapper">
              <input id="resetPassword" type="password" name="password" placeholder="Create a new password" autocomplete="new-password" minlength="10" maxlength="128" required aria-required="true" aria-describedby="resetPasswordHelp resetPasswordStrengthLabel">
              <button type="button" class="password-toggle" data-target="resetPassword" aria-label="Show password" aria-pressed="false" title="Show password">👁</button>
            </div>
            <div class="password-strength reset-strength" id="resetPasswordStrength" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <small class="input-help" id="resetPasswordHelp">At least 10 characters. Use a unique password with a mix of character types.</small>
          </div>

          <div class="input-group">
            <label for="resetConfirmPassword">Confirm New Password</label>
            <div class="password-wrapper">
              <input id="resetConfirmPassword" type="password" name="confirmPassword" placeholder="Re-enter your new password" autocomplete="new-password" minlength="10" maxlength="128" required aria-required="true">
              <button type="button" class="password-toggle" data-target="resetConfirmPassword" aria-label="Show password" aria-pressed="false" title="Show password">👁</button>
            </div>
            <small id="resetMatchError" class="error-msg" aria-live="polite">Passwords do not match.</small>
            <small id="resetMatchSuccess" class="success-msg" aria-live="polite">Passwords match.</small>
          </div>

          <% if (authCaptchaSiteKey) { %>
            <div class="auth-bot-protection" id="resetBotProtection" aria-hidden="false">
              <div class="captcha-label">Security check</div>
              <div id="resetTurnstile" class="captcha-slot"></div>
              <small class="input-help">Your reset request is protected by an adaptive bot check.</small>
            </div>
          <% } %>

          <button type="submit" class="auth-submit" id="resetSubmit">
            <span class="submit-label">Update Password</span>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span class="submit-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <button type="button" class="auth-back-link" id="resetExpiredBackBtn">← Return to sign in</button>
      </section>

      <!-- ===================================================
           GOOGLE PHONE COMPLETION
      ==================================================== -->
      <section id="completePhoneForm" class="auth-box hidden" aria-labelledby="completePhoneTitle">
        <div class="auth-hero-icon success" aria-hidden="true">✦</div>
        <div class="auth-header">
          <span class="auth-eyebrow">One Last Detail</span>
          <h2 id="completePhoneTitle">Complete your guest profile</h2>
          <p id="completePhoneDescription">Your Google account is connected. Add a contact number so our resort team can reach you about reservations, arrivals, and important stay updates.</p>
        </div>

        <div class="auth-profile-card">
          <div class="auth-profile-card-icon" aria-hidden="true">G</div>
          <div>
            <strong>Google account connected</strong>
            <span>Your email and name are already saved securely.</span>
          </div>
        </div>

        <form id="completePhoneFormElem" autocomplete="on" novalidate>
          <input type="hidden" name="_csrf" value="<%= safeCsrfToken %>">
          <input type="text" name="website" class="honeypot-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="auth_started_at" id="phoneAuthStartedAt" value="">
          <input type="hidden" name="captchaToken" id="phoneCaptchaToken" value="">

          <div class="input-group">
            <label for="googlePhoneInput">Contact Number</label>
            <input id="googlePhoneInput" type="tel" name="phone" placeholder="09xxxxxxxxx" maxlength="11" minlength="11" inputmode="numeric" autocomplete="tel" pattern="09[0-9]{9}" required aria-required="true" aria-describedby="googlePhoneHelp googlePhoneError">
            <small class="input-help" id="googlePhoneHelp">11-digit Philippine mobile number.</small>
            <small class="inline-field-error" id="googlePhoneError" aria-live="polite"></small>
          </div>

          <% if (authCaptchaSiteKey) { %>
            <div class="auth-bot-protection" id="phoneBotProtection" aria-hidden="false">
              <div class="captcha-label">Security check</div>
              <div id="phoneTurnstile" class="captcha-slot"></div>
              <small class="input-help">A quick adaptive check keeps automated profile creation away.</small>
            </div>
          <% } %>

          <button type="submit" class="auth-submit" id="phoneSubmit">
            <span class="submit-label">Save &amp; Continue</span>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span class="submit-arrow" aria-hidden="true">→</span>
          </button>
        </form>

        <button type="button" class="auth-back-link" id="cancelPhoneCompletion">Not now — return to sign in</button>
      </section>

    </div>
  </div>
<% } %>


<!-- =========================================================
     LOGOUT MODAL
========================================================= -->

<% if (displayUser) { %>

  <div
    id="logoutModal"
    class="modal"
    aria-hidden="true"
    role="presentation"
  >
    <div
      class="modal-content logout-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="logoutTitle"
      aria-describedby="logoutDescription"
      tabindex="-1"
    >
      <div class="logout-icon" aria-hidden="true">🏝️</div>
      <span class="auth-eyebrow">Before You Go</span>
      <h2 id="logoutTitle">Leaving the Isle?</h2>
      <p id="logoutDescription">
        Are you sure you want to sign out?
        Any unsaved booking progress may be lost.
      </p>

      <div class="logout-actions">
        <button
          id="cancelLogout"
          type="button"
          class="stay-btn"
        >Stay</button>

        <form
          method="POST"
          action="/logout"
          id="logoutForm"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= safeCsrfToken %>"
          >
          <button
            type="submit"
            class="logout-confirm-btn"
            id="logoutSubmit"
          >
            <span class="submit-label">Logout</span>
            <span class="submit-spinner" aria-hidden="true"></span>
          </button>
        </form>
      </div>
    </div>
  </div>
<% } %>


<style>
  :root {
