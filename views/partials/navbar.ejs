  .optional-label {
    color: rgba(255,255,255,0.35);
    font-size: 10px;
    font-weight: 500;
    margin-left: 5px;
  }

  .input-help {
    display: block;
    margin-top: 6px;
    color: rgba(255,255,255,0.40);
    font-size: 10px;
    line-height: 1.5;
  }

  .modal input {
    width: 100%;
    height: 50px;
    padding: 14px 15px;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: var(--radius-sm);
    outline: none;
    background: rgba(255,255,255,0.96);
    color: #222;
    font-family: inherit;
    font-size: 0.90rem;
    transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
  }

  .modal input::placeholder { color: #aaa; }
  .modal input:hover { background: white; }

  .modal input:focus {
    border-color: var(--brand-yellow);
    box-shadow: 0 0 0 3px rgba(255,215,0,0.12);
    background: white;
  }

  .modal input.is-invalid {
    border-color: #ff5b5b;
    box-shadow: 0 0 0 3px rgba(255,91,91,0.08);
  }

  .modal input.is-valid {
    border-color: var(--success);
    box-shadow: 0 0 0 3px rgba(69,216,138,0.08);
