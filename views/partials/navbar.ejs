    function setBodyLocked(locked) {
      document.body.style.overflow = locked ? "hidden" : "";
    }

    function resetAuthModalScroll() {
      if (authModalContent) authModalContent.scrollTop = 0;
    }

    function setAuthMessage(message, type = "error") {
      if (!authMessage) return;
      const text = String(message || "").trim();
      authMessage.textContent = text;
      authMessage.className = text ? `auth-message is-visible ${type}` : "auth-message";
    }

    function clearAuthMessage() {
      setAuthMessage("");
    }

    function updateAuthSecurityNote(message, type = "success") {
      if (!authSecurityText || !authSecurityNote) return;
      authSecurityText.textContent = String(message || "Protected session · Secure account access");
      authSecurityNote.classList.remove("is-warning", "is-error");
      if (type === "warning") authSecurityNote.classList.add("is-warning");
      if (type === "error") authSecurityNote.classList.add("is-error");
    }

    function shakeAuthOnError() {
      if (!authModalContent) return;
      const now = Date.now();
      if (now - lastAuthErrorShakeAt < 400) return;
      lastAuthErrorShakeAt = now;
      authModalContent.classList.remove("auth-network-error");
      void authModalContent.offsetWidth;
      authModalContent.classList.add("auth-network-error");
      window.setTimeout(() => authModalContent.classList.remove("auth-network-error"), 420);
    }

    function markAuthJourney(step) {
      authTrustItems.forEach((item) => {
        const itemStep = item.getAttribute("data-auth-trust-step");
        item.classList.toggle("is-active", itemStep === step);
        item.classList.toggle(
          "is-complete",
          (step === "verify" && itemStep === "account") ||
          (step === "finish" && (itemStep === "account" || itemStep === "verify"))
        );
      });
    }

