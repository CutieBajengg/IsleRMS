    align-items: flex-start;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 2000;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .modal.is-open {
    display: flex;
    animation: modalFade 0.25s ease;
  }

  .modal-content {
    position: relative;
    width: 100%;
    color: white;
    outline: none;
  }

  @keyframes modalFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes modalSlide {
    from {
      opacity: 0;
      transform: translateY(25px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .auth-modal {
    max-width: 560px;
    height: calc(100dvh - 40px);
