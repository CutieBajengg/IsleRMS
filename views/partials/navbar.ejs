<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>
  document.addEventListener(
    "DOMContentLoaded",
    () => {
      "use strict";

      /* ======================================================
         ELEMENTS
      ====================================================== */

      const authModal =
        document.getElementById(
          "authModal"
        );

      const logoutModal =
        document.getElementById(
          "logoutModal"
        );

      const authModalContent =
        authModal?.querySelector(
          ".auth-modal"
        );

      const logoutModalContent =
        logoutModal?.querySelector(
          ".logout-modal"
        );

      const authCloseBtn =
        document.getElementById(
          "authCloseBtn"
        );

      const loginBtn =
        document.getElementById(
          "loginBtn"
        );

      const bookingBtn =
        document.getElementById(
          "bookingBtn"
        );

      const logoutTrigger =
        document.getElementById(
          "logoutTrigger"
        );

      const cancelLogout =
        document.getElementById(
          "cancelLogout"
        );

      const showSignup =
        document.getElementById(
          "showSignup"
        );

      const showLogin =
        document.getElementById(
          "showLogin"
        );

      const loginForm =
        document.getElementById(
          "loginForm"
        );

      const signupForm =
        document.getElementById(
          "signupForm"
        );

      const loginFormElem =
        document.getElementById(
          "loginFormElem"
        );

      const signupFormElem =
        document.getElementById(
          "signupFormElem"
        );

      const logoutForm =
        document.getElementById(
          "logoutForm"
        );

      const loginSubmit =
        document.getElementById(
          "loginSubmit"
        );

      const signupSubmit =
        document.getElementById(
          "signupSubmit"
        );

      const logoutSubmit =
        document.getElementById(
          "logoutSubmit"
        );

      const mobileMenuBtn =
        document.getElementById(
          "mobileMenuBtn"
        );

      const mainNavigation =
        document.getElementById(
          "mainNavigation"
        );

      const authMessage =
        document.getElementById(
          "authMessage"
        );

      const phoneInput =
        document.getElementById(
          "phoneInput"
        );

      const phoneError =
        document.getElementById(
          "phoneError"
        );

      const signupPassword =
        document.getElementById(
          "signupPassword"
        );

      const confirmPassword =
        document.getElementById(
          "confirmPassword"
        );

      const passwordMatchError =
        document.getElementById(
          "passwordMatchError"
        );

      const passwordMatchSuccess =
        document.getElementById(
          "passwordMatchSuccess"
        );

      const passwordStrength =
        document.querySelector(
          ".password-strength"
        );

      const passwordStrengthLabel =
        document.getElementById(
          "passwordStrengthLabel"
        );

      const signupUsername =
        document.getElementById(
          "signupUsername"
        );

      const fullnameInput =
        document.getElementById(
          "fullname"
        );

      const signupEmail =
        document.getElementById(
          "signupEmail"
        );

      /* ======================================================
         STATE
      ====================================================== */

      let activeModal = null;

      let lastFocusedElement =
        null;

      /* ======================================================
         BODY SCROLL
      ====================================================== */

      function setBodyLocked(
        locked
      ) {
        document.body.style.overflow =
          locked
            ? "hidden"
            : "";
      }

      /* ======================================================
         MOBILE MENU
      ====================================================== */

      function setMobileButtonState(
        isOpen
      ) {
        if (!mobileMenuBtn) {
          return;
        }

        mobileMenuBtn.setAttribute(
          "aria-expanded",
          String(isOpen)
        );

        mobileMenuBtn.setAttribute(
          "aria-label",
          isOpen
            ? "Close navigation menu"
            : "Open navigation menu"
        );

        const spans =
          mobileMenuBtn.querySelectorAll(
            "span"
          );

        if (
          spans.length < 3
        ) {
          return;
        }

        if (isOpen) {
          spans[0].style.transform =
            "translateY(7px) rotate(45deg)";

          spans[1].style.opacity =
            "0";

          spans[2].style.transform =
            "translateY(-7px) rotate(-45deg)";
        } else {
          spans.forEach(
            (span) => {
              span.style.transform =
                "";

              span.style.opacity =
                "";
            }
          );
        }
      }

      function closeMobileMenu() {
        if (!mainNavigation) {
          return;
        }

        mainNavigation.classList.remove(
          "mobile-open"
        );

        setMobileButtonState(
          false
        );
      }

      function toggleMobileMenu() {
        if (!mainNavigation) {
          return;
        }

        const isOpen =
          mainNavigation.classList.toggle(
            "mobile-open"
          );

        if (isOpen) {
          closeAllDropdowns();
        }

        setMobileButtonState(
          isOpen
        );
      }

      /* ======================================================
         AUTH MESSAGE
      ====================================================== */

      function setAuthMessage(
        message,
        type = "error"
      ) {
        if (!authMessage) {
          return;
        }

        const text =
          String(
            message || ""
          ).trim();

        if (!text) {
          authMessage.textContent =
            "";

          authMessage.className =
            "auth-message";

          return;
        }

        authMessage.textContent =
          text;

        authMessage.className =
          `auth-message is-visible ${type}`;

        window.setTimeout(
          () => {
            authMessage.scrollIntoView({
              behavior:
                "smooth",

              block:
                "nearest",
            });
          },
          0
        );
      }

      function clearAuthMessage() {
        setAuthMessage(
          "",
          "error"
        );
      }

      /* ======================================================
         FIELD STATE
      ====================================================== */

      function setFieldState(
        field,
        state
      ) {
        if (!field) {
          return;
        }

        field.classList.remove(
          "is-invalid",
          "is-valid"
        );

        if (state === "invalid") {
          field.classList.add(
            "is-invalid"
          );

          field.setAttribute(
            "aria-invalid",
            "true"
          );

          return;
        }

        if (state === "valid") {
          field.classList.add(
            "is-valid"
          );

          field.setAttribute(
            "aria-invalid",
            "false"
          );

          return;
        }

        field.removeAttribute(
          "aria-invalid"
        );
      }

      function clearAuthFieldStates() {
        document
          .querySelectorAll(
            ".modal input"
          )
          .forEach(
            (input) => {
              input.classList.remove(
                "is-invalid",
                "is-valid"
              );

              input.removeAttribute(
                "aria-invalid"
              );
            }
          );

        phoneError?.classList.remove(
          "is-visible"
        );

        passwordMatchError?.classList.remove(
          "is-visible"
        );

        passwordMatchSuccess?.classList.remove(
          "is-visible"
        );

        if (passwordStrength) {
          passwordStrength.className =
            "password-strength";
        }

        if (
          passwordStrengthLabel
        ) {
          passwordStrengthLabel.textContent =
            "";
        }
      }

      /* ======================================================
         FORM BUTTON STATES
      ====================================================== */

      function setLoading(
        button,
        label
      ) {
        if (!button) {
          return;
        }

        button.disabled =
          true;

        button.classList.add(
          "is-loading"
        );

        const labelElement =
          button.querySelector(
            ".submit-label"
          );

        if (labelElement) {
          labelElement.textContent =
            label;
        }
      }

      function resetSubmitButtons() {
        [
          loginSubmit,
          signupSubmit,
          logoutSubmit,
        ].forEach(
          (button) => {
            if (!button) {
              return;
            }

            button.disabled =
              false;

            button.classList.remove(
              "is-loading"
            );
          }
        );

        if (loginSubmit) {
          const label =
            loginSubmit.querySelector(
              ".submit-label"
            );

          if (label) {
            label.textContent =
              "Sign In";
          }
        }

        if (signupSubmit) {
          const label =
            signupSubmit.querySelector(
              ".submit-label"
            );

          if (label) {
            label.textContent =
              "Create Account";
          }
        }

        if (logoutSubmit) {
          const label =
            logoutSubmit.querySelector(
              ".submit-label"
            );

          if (label) {
            label.textContent =
              "Logout";
          }
        }
      }

      /* ======================================================
         AUTH FORM SWITCHING
      ====================================================== */

      function showLoginForm() {
        loginForm?.classList.remove(
          "hidden"
        );

        signupForm?.classList.add(
          "hidden"
        );

        clearAuthFieldStates();

        document
          .querySelectorAll(
            "#loginFormElem input"
          )
          .forEach(
            (input) => {
              input.disabled =
                false;
            }
          );

        resetSubmitButtons();
      }

      function showSignupForm() {
        loginForm?.classList.add(
          "hidden"
        );

        signupForm?.classList.remove(
          "hidden"
        );

        clearAuthFieldStates();

        resetSubmitButtons();
      }

      /* ======================================================
         FOCUSABLE ELEMENTS
      ====================================================== */

      function getFocusableElements(
        container
      ) {
        if (!container) {
          return [];
        }

        return Array.from(
          container.querySelectorAll(
            [
              "a[href]",
              "button:not([disabled])",
              "input:not([disabled])",
              "select:not([disabled])",
              "textarea:not([disabled])",
              "[tabindex]:not([tabindex='-1'])",
            ].join(",")
          )
        ).filter(
          (element) => {
            return (
              element.offsetParent !==
              null
            );
          }
        );
      }

      /* ======================================================
         OPEN MODAL
      ====================================================== */

      function openModal(
        modal,
        initialFocus,
        opener = null
      ) {
        if (!modal) {
          return;
        }

        lastFocusedElement =
          opener ||
          document.activeElement;

        activeModal =
          modal;

        modal.classList.add(
          "is-open"
        );

        modal.setAttribute(
          "aria-hidden",
          "false"
        );

        setBodyLocked(
          true
        );

        window.setTimeout(
          () => {
            const target =
              initialFocus ||
              modal.querySelector(
                "input, button"
              );

            target?.focus();
          },
          50
        );
      }

      /* ======================================================
         CLOSE MODAL
      ====================================================== */

      function clearSensitiveFields() {
        [
          document.getElementById(
            "loginPassword"
          ),
          signupPassword,
          confirmPassword,
        ].forEach(
          (input) => {
            if (input) {
              input.value =
                "";
            }
          }
        );

        clearAuthFieldStates();

        resetSubmitButtons();
      }

      function closeModal(
        modal,
        restoreFocus = true
      ) {
        if (!modal) {
          return;
        }

        modal.classList.remove(
          "is-open"
        );

        modal.setAttribute(
          "aria-hidden",
          "true"
        );

        if (
          activeModal ===
          modal
        ) {
          activeModal =
            null;
        }

        setBodyLocked(
          false
        );

        clearSensitiveFields();

        if (
          restoreFocus &&
          lastFocusedElement &&
          typeof
            lastFocusedElement.focus ===
              "function"
        ) {
          window.setTimeout(
            () => {
              try {
                lastFocusedElement.focus();
              } catch (_) {
                /* Ignore focus restoration errors. */
              }

              lastFocusedElement =
                null;
            },
            0
          );
        }
      }

      /* ======================================================
         AUTH OPENING
      ====================================================== */

      function openAuth(
        mode = "login",
        opener = null
      ) {
        if (!authModal) {
          return;
        }

        closeMobileMenu();

        clearAuthMessage();

        if (
          mode === "signup"
        ) {
          showSignupForm();
        } else {
          showLoginForm();
        }

        const initialFocus =
          mode === "signup"
            ? fullnameInput
            : document.getElementById(
                "loginEmail"
              );

        openModal(
          authModal,
          initialFocus,
          opener
        );
      }

      /* ======================================================
         GLOBAL AUTH API
      ====================================================== */

      window.IsleRMSAuth = {
        open: (
          mode = "login",
          opener = null
        ) => {
          openAuth(
            mode,
            opener
          );
        },

        close: () => {
          closeModal(
            authModal
          );
        },

        showLogin: () => {
          showLoginForm();
        },

        showSignup: () => {
          showSignupForm();
        },
      };

      /* ======================================================
         URL AUTH STATE
      ====================================================== */

      const params =
        new URLSearchParams(
          window.location.search
        );

      const requestedAuth =
        params.get("auth");

      const urlError =
        params.get("error");

      const urlSuccess =
        params.get("success");

      if (
        urlError &&
        authModal
      ) {
        setAuthMessage(
          urlError,
          "error"
        );
      }

      if (
        urlSuccess &&
        authModal
      ) {
        setAuthMessage(
          urlSuccess,
          "success"
        );
      }

      if (
        requestedAuth ===
        "signup"
      ) {
        openAuth(
          "signup"
        );
      } else if (
        requestedAuth ===
          "login" ||
        urlError ||
        urlSuccess
      ) {
        openAuth(
          "login"
        );
      }

      /* ======================================================
         LOGIN BUTTON
      ====================================================== */

      loginBtn?.addEventListener(
        "click",
        () => {
          openAuth(
            "login",
            loginBtn
          );
        }
      );

      /* ======================================================
         BOOKING BUTTON
      ====================================================== */

      bookingBtn?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();

          openAuth(
            "login",
            bookingBtn
          );
        }
      );

      /* ======================================================
         CLOSE AUTH
      ====================================================== */

      authCloseBtn?.addEventListener(
        "click",
        () => {
          closeModal(
            authModal
          );
        }
      );

      /* ======================================================
         AUTH SWITCHING
      ====================================================== */

      showSignup?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();

          showSignupForm();

          fullnameInput?.focus();
        }
      );

      showLogin?.addEventListener(
        "click",
        (event) => {
          event.preventDefault();

          showLoginForm();

          document
            .getElementById(
              "loginEmail"
            )
            ?.focus();
        }
      );

      /* ======================================================
         PASSWORD VISIBILITY
      ====================================================== */

      document
        .querySelectorAll(
          ".password-toggle"
        )
        .forEach(
          (button) => {
            button.addEventListener(
              "click",
              () => {
                const targetId =
                  button.getAttribute(
                    "data-target"
                  );

                const passwordInput =
                  document.getElementById(
                    targetId
                  );

                if (
                  !passwordInput
                ) {
                  return;
                }

                const isPassword =
                  passwordInput.type ===
                  "password";

                passwordInput.type =
                  isPassword
                    ? "text"
                    : "password";

                button.textContent =
                  isPassword
                    ? "🙈"
                    : "👁";

                button.setAttribute(
                  "aria-label",
                  isPassword
                    ? "Hide password"
                    : "Show password"
                );

                button.setAttribute(
                  "aria-pressed",
                  String(
                    isPassword
                  )
                );

                button.setAttribute(
                  "title",
                  isPassword
                    ? "Hide password"
                    : "Show password"
                );
              }
            );
          }
        );

      /* ======================================================
         PASSWORD STRENGTH
      ====================================================== */

      function calculatePasswordStrength(
        password
      ) {
        if (!password) {
          return {
            level: "",
            label: "",
          };
        }

        let score = 0;

        if (
          password.length >= 10
        ) {
          score++;
        }

        if (
          password.length >= 14
        ) {
          score++;
        }

        if (
          /[A-Z]/.test(password)
        ) {
          score++;
        }

        if (
          /[a-z]/.test(password) &&
          /\d/.test(password)
        ) {
          score++;
        }

        if (
          /[^A-Za-z0-9]/.test(
            password
          )
        ) {
          score++;
        }

        if (
          password.length >= 16 &&
          /[A-Z]/.test(password) &&
          /[a-z]/.test(password) &&
          /\d/.test(password) &&
          /[^A-Za-z0-9]/.test(password)
        ) {
          return {
            level: "strong",
            label: "Strong",
          };
        }

        if (
          score >= 4
        ) {
          return {
            level: "good",
            label: "Good",
          };
        }

        if (
          score >= 2
        ) {
          return {
            level: "fair",
            label: "Fair",
          };
        }

        return {
          level: "weak",
          label: "Weak",
        };
      }

      function updatePasswordStrength() {
        if (
          !signupPassword ||
          !passwordStrength
        ) {
          return;
        }

        const result =
          calculatePasswordStrength(
            signupPassword.value
          );

        passwordStrength.className =
          "password-strength";

        if (
          result.level
        ) {
          passwordStrength.classList.add(
            result.level
          );
        }

        if (
          passwordStrengthLabel
        ) {
          passwordStrengthLabel.textContent =
            result.label;
        }
      }

      /* ======================================================
         PASSWORD MATCH
      ====================================================== */

      function checkPasswordMatch() {
        if (
          !signupPassword ||
          !confirmPassword
        ) {
          return false;
        }

        const password =
          signupPassword.value;

        const confirmation =
          confirmPassword.value;

        if (
          confirmation.length ===
          0
        ) {
          passwordMatchError?.classList.remove(
            "is-visible"
          );

          passwordMatchSuccess?.classList.remove(
            "is-visible"
          );

          setFieldState(
            confirmPassword,
            null
          );

          return false;
        }

        if (
          password ===
            confirmation
        ) {
          passwordMatchError?.classList.remove(
            "is-visible"
          );

          passwordMatchSuccess?.classList.add(
            "is-visible"
          );

          setFieldState(
            confirmPassword,
            "valid"
          );

          return true;
        }

        passwordMatchError?.classList.add(
          "is-visible"
        );

        passwordMatchSuccess?.classList.remove(
          "is-visible"
        );

        setFieldState(
          confirmPassword,
          "invalid"
        );

        return false;
      }

      signupPassword?.addEventListener(
        "input",
        () => {
          updatePasswordStrength();

          if (
            signupPassword.value.length >=
            10
          ) {
            setFieldState(
              signupPassword,
              "valid"
            );
          } else if (
            signupPassword.value.length > 0
          ) {
            setFieldState(
              signupPassword,
              "invalid"
            );
          } else {
            setFieldState(
              signupPassword,
              null
            );
          }

          checkPasswordMatch();
        }
      );

      confirmPassword?.addEventListener(
        "input",
        checkPasswordMatch
      );

      /* ======================================================
         EMAIL VALIDATION
      ====================================================== */

      function isValidEmail(
        email
      ) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
          email
        );
      }

      signupEmail?.addEventListener(
        "blur",
        () => {
          const value =
            signupEmail.value.trim();

          if (!value) {
            setFieldState(
              signupEmail,
              null
            );

            return;
          }

          setFieldState(
            signupEmail,
            isValidEmail(value)
              ? "valid"
              : "invalid"
          );
        }
      );

      /* ======================================================
         FULL NAME VALIDATION
      ====================================================== */

      fullnameInput?.addEventListener(
        "blur",
        () => {
          const value =
            fullnameInput.value.trim();

          if (
            value.length >= 2 &&
            value.length <= 50
          ) {
            setFieldState(
              fullnameInput,
              "valid"
            );
          } else if (value) {
            setFieldState(
              fullnameInput,
              "invalid"
            );
          } else {
            setFieldState(
              fullnameInput,
              null
            );
          }
        }
      );

      /* ======================================================
         PHONE VALIDATION
      ====================================================== */

      function validatePhone() {
        if (!phoneInput) {
          return true;
        }

        const value =
          phoneInput.value.trim();

        if (
          /^09\d{9}$/.test(
            value
          )
        ) {
          setFieldState(
            phoneInput,
            "valid"
          );

          phoneError?.classList.remove(
            "is-visible"
          );

          return true;
        }

        setFieldState(
          phoneInput,
          "invalid"
        );

        phoneError?.classList.add(
          "is-visible"
        );

        return false;
      }

      phoneInput?.addEventListener(
        "input",
        () => {
          phoneInput.value =
            phoneInput.value
              .replace(
                /[^0-9]/g,
                ""
              )
              .slice(
                0,
                11
              );

          phoneError?.classList.remove(
            "is-visible"
          );

          if (
            phoneInput.value.length ===
            11
          ) {
            validatePhone();
          } else {
            setFieldState(
              phoneInput,
              null
            );
          }
        }
      );

      phoneInput?.addEventListener(
        "blur",
        () => {
          if (
            phoneInput.value.length > 0
          ) {
            validatePhone();
          }
        }
      );

      /* ======================================================
         USERNAME VALIDATION
      ====================================================== */

      signupUsername?.addEventListener(
        "input",
        () => {
          signupUsername.value =
            signupUsername.value
              .replace(
                /[^A-Za-z0-9._-]/g,
                ""
              )
              .slice(
                0,
                50
              );

          if (
            signupUsername.value.length ===
            0
          ) {
            setFieldState(
              signupUsername,
              null
            );

            return;
          }

          if (
            signupUsername.value.length >= 3 &&
            signupUsername.value.length <= 50 &&
            /^[A-Za-z0-9._-]+$/.test(
              signupUsername.value
            )
          ) {
            setFieldState(
              signupUsername,
              "valid"
            );

            return;
          }

          setFieldState(
            signupUsername,
            "invalid"
          );
        }
      );

      /* ======================================================
         SIGNUP VALIDATION
      ====================================================== */

      signupFormElem?.addEventListener(
        "submit",
        (event) => {
          let valid = true;

          clearAuthMessage();

          const fullname =
            fullnameInput?.value.trim() ||
            "";

          const email =
            signupEmail?.value.trim() ||
            "";

          const password =
            signupPassword?.value ||
            "";

          const confirmation =
            confirmPassword?.value ||
            "";

          const username =
            signupUsername?.value.trim() ||
            "";

          /* -----------------------------------------------
             FULL NAME
          ----------------------------------------------- */

          if (
            fullname.length < 2 ||
            fullname.length > 50
          ) {
            valid = false;

            setFieldState(
              fullnameInput,
              "invalid"
            );
          } else {
            setFieldState(
              fullnameInput,
              "valid"
            );
          }

          /* -----------------------------------------------
             EMAIL
          ----------------------------------------------- */

          if (
            !isValidEmail(email)
          ) {
            valid = false;

            setFieldState(
              signupEmail,
              "invalid"
            );
          } else {
            setFieldState(
              signupEmail,
              "valid"
            );
          }

          /* -----------------------------------------------
             PASSWORD
          ----------------------------------------------- */

          if (
            password.length < 10
          ) {
            valid = false;

            setFieldState(
              signupPassword,
              "invalid"
            );
          } else {
            setFieldState(
              signupPassword,
              "valid"
            );
          }

          /* -----------------------------------------------
             CONFIRM PASSWORD
          ----------------------------------------------- */

          if (
            !checkPasswordMatch()
          ) {
            valid = false;
          }

          /* -----------------------------------------------
             USERNAME
          ----------------------------------------------- */

          if (
            username &&
            (
              username.length < 3 ||
              username.length > 50 ||
              !/^[A-Za-z0-9._-]+$/.test(
                username
              )
            )
          ) {
            valid = false;

            setFieldState(
              signupUsername,
              "invalid"
            );
          }

          /* -----------------------------------------------
             PHONE
          ----------------------------------------------- */

          if (
            !validatePhone()
          ) {
            valid = false;
          }

          /* -----------------------------------------------
             RESULT
          ----------------------------------------------- */

          if (!valid) {
            event.preventDefault();

            setAuthMessage(
              "Please review the highlighted fields and correct any errors.",
              "error"
            );

            const firstInvalid =
              signupFormElem.querySelector(
                ".is-invalid"
              );

            firstInvalid?.focus();

            return;
          }

          setLoading(
            signupSubmit,
            "Creating Account..."
          );
        }
      );

      /* ======================================================
         LOGIN SUBMIT
      ====================================================== */

      loginFormElem?.addEventListener(
        "submit",
        (event) => {
          const emailInput =
            document.getElementById(
              "loginEmail"
            );

          const passwordInput =
            document.getElementById(
              "loginPassword"
            );

          if (
            !emailInput?.value.trim() ||
            !passwordInput?.value
          ) {
            event.preventDefault();

            setAuthMessage(
              "Please enter your email address and password.",
              "error"
            );

            if (
              !emailInput?.value.trim()
            ) {
              emailInput?.focus();
            } else {
              passwordInput?.focus();
            }

            return;
          }

          clearAuthMessage();

          setLoading(
            loginSubmit,
            "Signing In..."
          );
        }
      );

      /* ======================================================
         LOGOUT SUBMIT
      ====================================================== */

      logoutForm?.addEventListener(
        "submit",
        () => {
          setLoading(
            logoutSubmit,
            "Signing Out..."
          );

          if (cancelLogout) {
            cancelLogout.disabled =
              true;
          }
        }
      );

      /* ======================================================
         MODAL BACKDROP
      ====================================================== */

      authModal?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            authModal
          ) {
            closeModal(
              authModal
            );
          }
        }
      );

      logoutModal?.addEventListener(
        "click",
        (event) => {
          if (
            event.target ===
            logoutModal
          ) {
            closeModal(
              logoutModal
            );
          }
        }
      );

      /* ======================================================
         LOGOUT
      ====================================================== */

      logoutTrigger?.addEventListener(
        "click",
        () => {
          closeAllDropdowns();

          openModal(
            logoutModal,
            cancelLogout,
            logoutTrigger
          );
        }
      );

      cancelLogout?.addEventListener(
        "click",
        () => {
          closeModal(
            logoutModal
          );
        }
      );

      /* ======================================================
         DROPDOWNS
      ====================================================== */

      const dropdownTriggers =
        document.querySelectorAll(
          ".dropdown-trigger"
        );

      function closeAllDropdowns(
        except = null
      ) {
        document
          .querySelectorAll(
            ".dropdown.is-open"
          )
          .forEach(
            (dropdown) => {
              if (
                dropdown ===
                except
              ) {
                return;
              }

              dropdown.classList.remove(
                "is-open"
              );

              dropdown
                .querySelector(
                  ".dropdown-trigger"
                )
                ?.setAttribute(
                  "aria-expanded",
                  "false"
                );
            }
          );
      }

      dropdownTriggers.forEach(
        (trigger) => {
          trigger.addEventListener(
            "click",
            (event) => {
              event.preventDefault();
              event.stopPropagation();

              const dropdown =
                trigger.closest(
                  ".dropdown"
                );

              if (
                !dropdown
              ) {
                return;
              }

              const shouldOpen =
                !dropdown.classList.contains(
                  "is-open"
                );

              closeAllDropdowns(
                shouldOpen
                  ? dropdown
                  : null
              );

              dropdown.classList.toggle(
                "is-open",
                shouldOpen
              );

              trigger.setAttribute(
                "aria-expanded",
                String(
                  shouldOpen
                )
              );
            }
          );

          trigger.addEventListener(
            "keydown",
            (event) => {
              if (
                event.key ===
                  "Escape"
              ) {
                const dropdown =
                  trigger.closest(
                    ".dropdown"
                  );

                dropdown?.classList.remove(
                  "is-open"
                );

                trigger.setAttribute(
                  "aria-expanded",
                  "false"
                );

                trigger.focus();
              }
            }
          );
        }
      );

      /* ======================================================
         OUTSIDE CLICK
      ====================================================== */

      document.addEventListener(
        "click",
        (event) => {
          const target =
            event.target;

          if (
            !target.closest(
              ".dropdown"
            )
          ) {
            closeAllDropdowns();
          }
        }
      );

      /* ======================================================
         MOBILE MENU
      ====================================================== */

      mobileMenuBtn?.addEventListener(
        "click",
        (event) => {
          event.stopPropagation();

          toggleMobileMenu();
        }
      );

      /* ======================================================
         CLOSE MOBILE MENU AFTER NAVIGATION
      ====================================================== */

      mainNavigation
        ?.querySelectorAll(
          "a"
        )
        .forEach(
          (link) => {
            link.addEventListener(
              "click",
              () => {
                closeMobileMenu();
              }
            );
          }
        );

      /* ======================================================
         MODAL KEYBOARD ACCESSIBILITY
      ====================================================== */

      document.addEventListener(
        "keydown",
        (event) => {
          if (!activeModal) {
            return;
          }

          /* -----------------------------------------------
             ESCAPE
          ----------------------------------------------- */

          if (
            event.key ===
            "Escape"
          ) {
            event.preventDefault();

            closeModal(
              activeModal
            );

            return;
          }

          /* -----------------------------------------------
             TAB FOCUS TRAP
          ----------------------------------------------- */

          if (
            event.key !==
            "Tab"
          ) {
            return;
          }

          const focusable =
            getFocusableElements(
              activeModal
            );

          if (
            focusable.length ===
            0
          ) {
            return;
          }

          const first =
            focusable[0];

          const last =
            focusable[
              focusable.length - 1
            ];

          if (
            event.shiftKey
          ) {
            if (
              document.activeElement ===
              first
            ) {
              event.preventDefault();

              last.focus();
            }

            return;
          }

          if (
            document.activeElement ===
            last
          ) {
            event.preventDefault();

            first.focus();
          }
        }
      );

      /* ======================================================
         CLICKING MODAL CONTENT DOES NOT CLOSE IT
      ====================================================== */

      authModalContent?.addEventListener(
        "click",
        (event) => {
          event.stopPropagation();
        }
      );

      logoutModalContent?.addEventListener(
        "click",
        (event) => {
          event.stopPropagation();
        }
      );

      /* ======================================================
         FORM RESTORATION
      ====================================================== */

      window.addEventListener(
        "pageshow",
        () => {
          resetSubmitButtons();

          if (cancelLogout) {
            cancelLogout.disabled =
              false;
          }
        }
      );

      /* ======================================================
         CLEAN BODY STATE ON PAGE EXIT
      ====================================================== */

      window.addEventListener(
        "beforeunload",
        () => {
          setBodyLocked(
            false
          );
        }
      );
    }
  );
</script>