      field.classList.remove("is-invalid", "is-valid");
      field.removeAttribute("aria-invalid");
      if (state === "invalid") {
        field.classList.add("is-invalid");
        field.setAttribute("aria-invalid", "true");
      } else if (state === "valid") {
        field.classList.add("is-valid");
        field.setAttribute("aria-invalid", "false");
      }
    }

    function setLoading(button, label) {
      if (!button) return;
      button.disabled = true;
      button.classList.add("is-loading");
      const labelEl = $(".submit-label", button);
      if (labelEl) labelEl.textContent = label;
    }

    function resetButton(button, label) {
      if (!button) return;
      button.disabled = false;
      button.classList.remove("is-loading");
      const labelEl = $(".submit-label", button);
      if (labelEl) labelEl.textContent = label;
    }

    function resetSubmitButtons() {
      resetButton(loginSubmit, "Sign In");
      resetButton(signupSubmit, "Send Verification Code");
      resetButton(verifyOtpSubmit, "Verify & Create Account");
      resetButton(forgotSubmit, "Send Reset Link");
      resetButton(resetSubmit, "Update Password");
      resetButton(phoneSubmit, "Save & Continue");
      resetButton($("#logoutSubmit"), "Logout");
      if (cancelLogout) cancelLogout.disabled = false;
    }

    function clearSensitiveFields() {
      [loginPassword, signupPassword, confirmPassword, otpCode, resetPassword, resetConfirmPassword].forEach((field) => {
        if (field) field.value = "";
      });
      clearOtpTimers();
      resetCaptcha("login");
      resetCaptcha("signup");
      resetCaptcha("forgot");
      resetCaptcha("reset");
      resetCaptcha("phone");
      resetSubmitButtons();
    }

    function openModal(modal, initialFocus, opener = null) {
      if (!modal) return;
      lastFocusedElement = opener || document.activeElement;
      activeModal = modal;
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      setBodyLocked(true);
      window.setTimeout(() => (initialFocus || modal.querySelector("input, button"))?.focus(), 50);
    }

    function closeModal(modal, restoreFocus = true) {
      if (!modal) return;
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      if (activeModal === modal) activeModal = null;
      setBodyLocked(false);
      clearSensitiveFields();
      if (restoreFocus && lastFocusedElement && typeof lastFocusedElement.focus === "function") {
        window.setTimeout(() => {
          try { lastFocusedElement.focus(); } catch (_) {}
          lastFocusedElement = null;
        }, 0);
      }
    }

    /* =====================================================
       VALIDATION
    ====================================================== */

    function isValidEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value || "").trim());
    }

    function validatePhoneValue(value) {
      return /^09\d{9}$/.test(String(value || "").trim());
    }

    function passwordStrengthResult(password) {
      if (!password) return { level: "", label: "" };
      let score = 0;
      if (password.length >= 10) score++;
      if (password.length >= 14) score++;
      if (/[A-Z]/.test(password)) score++;
      if (/[a-z]/.test(password) && /\d/.test(password)) score++;
      if (/[^A-Za-z0-9]/.test(password)) score++;
      if (password.length >= 16 && /[A-Z]/.test(password) && /[a-z]/.test(password) && /\d/.test(password) && /[^A-Za-z0-9]/.test(password)) {
        return { level: "strong", label: "Strong" };
      }
      if (score >= 4) return { level: "good", label: "Good" };
      if (score >= 2) return { level: "fair", label: "Fair" };
      return { level: "weak", label: "Weak" };
    }

    function updatePasswordStrength(input, meter, label) {
      if (!input || !meter) return;
      const result = passwordStrengthResult(input.value);
      meter.className = meter.id === "resetPasswordStrength" ? "password-strength reset-strength" : "password-strength";
      if (result.level) meter.classList.add(result.level);
      if (label) label.textContent = result.label;
    }

    function checkPasswordMatch(passwordField, confirmField, errorEl, successEl) {
      if (!passwordField || !confirmField) return false;
      const a = passwordField.value;
      const b = confirmField.value;
      if (!b) {
        errorEl?.classList.remove("is-visible");
        successEl?.classList.remove("is-visible");
        setFieldState(confirmField, null);
        return false;
      }
      if (a === b) {
        errorEl?.classList.remove("is-visible");
        successEl?.classList.add("is-visible");
        setFieldState(confirmField, "valid");
        return true;
      }
      errorEl?.classList.add("is-visible");
      successEl?.classList.remove("is-visible");
      setFieldState(confirmField, "invalid");
      return false;
    }

    function validateSignupForm() {
      let valid = true;
      const fullname = fullnameInput?.value.trim() || "";
      const email = signupEmail?.value.trim().toLowerCase() || "";
      const password = signupPassword?.value || "";
      const username = signupUsername?.value.trim() || "";

      if (fullname.length < 2 || fullname.length > 100) { valid = false; setFieldState(fullnameInput, "invalid"); } else setFieldState(fullnameInput, "valid");
      if (!isValidEmail(email)) { valid = false; setFieldState(signupEmail, "invalid"); } else setFieldState(signupEmail, "valid");
      if (password.length < 10 || password.length > 128) { valid = false; setFieldState(signupPassword, "invalid"); } else setFieldState(signupPassword, "valid");
      if (!checkPasswordMatch(signupPassword, confirmPassword, passwordMatchError, passwordMatchSuccess)) valid = false;
      if (username && (username.length < 3 || username.length > 50 || !/^[A-Za-z0-9._-]+$/.test(username))) { valid = false; setFieldState(signupUsername, "invalid"); } else if (username) setFieldState(signupUsername, "valid");
      if (!validatePhoneValue(phoneInput?.value)) { valid = false; setFieldState(phoneInput, "invalid"); phoneError?.classList.add("is-visible"); } else { setFieldState(phoneInput, "valid"); phoneError?.classList.remove("is-visible"); }
      return valid;
    }

    function validateResetForm() {
      let valid = true;
      const password = resetPassword?.value || "";
      if (password.length < 10 || password.length > 128) { valid = false; setFieldState(resetPassword, "invalid"); } else setFieldState(resetPassword, "valid");
      if (!checkPasswordMatch(resetPassword, resetConfirmPassword, resetMatchError, resetMatchSuccess)) valid = false;
      if (!resetTokenValue) valid = false;
      return valid;
    }

    function validateGooglePhoneForm() {
      const valid = validatePhoneValue(googlePhoneInput?.value);
      setFieldState(googlePhoneInput, valid ? "valid" : "invalid");
      if (googlePhoneError) googlePhoneError.textContent = valid ? "" : "Please enter a valid Philippine mobile number.";
      return valid;
    }

    /* =====================================================
       CAPTCHA / TURNSTILE
    ====================================================== */

    async function ensureTurnstileLoaded() {
      if (!captchaEnabled || !captchaSiteKey) return false;
      if (window.turnstile) return true;
      if (turnstileLoadPromise) return turnstileLoadPromise;

      turnstileLoadPromise = new Promise((resolve, reject) => {
        const existing = document.querySelector("script[data-islerms-turnstile]");
        if (existing) {
          existing.addEventListener("load", () => resolve(Boolean(window.turnstile)), { once: true });
          existing.addEventListener("error", () => reject(new Error("CAPTCHA script failed to load.")), { once: true });
          return;
        }

        const script = document.createElement("script");
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.defer = true;
        script.dataset.islermsTurnstile = "true";
        script.onload = () => resolve(Boolean(window.turnstile));
        script.onerror = () => reject(new Error("CAPTCHA script failed to load."));
        document.head.appendChild(script);
      });

      return turnstileLoadPromise;
    }

    function captchaConfig(kind) {
      const configs = {
        login: { slot: "loginTurnstile", input: loginCaptchaToken, box: loginBotProtection },
        signup: { slot: "signupTurnstile", input: signupCaptchaToken, box: signupBotProtection },
        forgot: { slot: "forgotTurnstile", input: forgotCaptchaToken, box: forgotBotProtection },
        reset: { slot: "resetTurnstile", input: resetCaptchaToken, box: resetBotProtection },
        phone: { slot: "phoneTurnstile", input: phoneCaptchaToken, box: phoneBotProtection }
      };
      return configs[kind];
    }

    async function ensureCaptchaWidget(kind) {
      if (!captchaEnabled || !captchaSiteKey) return null;
      const config = captchaConfig(kind);
      if (!config?.slot) return null;

      if (config.box) {
        config.box.classList.remove("hidden");
        config.box.setAttribute("aria-hidden", "false");
      }

      if (turnstileWidgets.has(kind)) return turnstileWidgets.get(kind);
      const ready = await ensureTurnstileLoaded();
      if (!ready || !window.turnstile) return null;

      const slot = document.getElementById(config.slot);
      if (!slot) return null;

      try {
        const widgetId = window.turnstile.render(slot, {
          sitekey: captchaSiteKey,
          theme: "dark",
          size: "flexible",
          appearance: "interaction-only",
          callback: (token) => {
            if (config.input) config.input.value = token || "";
            updateAuthSecurityNote("Security check complete · Ready to continue", "success");
          },
          "expired-callback": () => {
            if (config.input) config.input.value = "";
            updateAuthSecurityNote("Security check expired · Please retry", "warning");
          },
          "timeout-callback": () => {
            if (config.input) config.input.value = "";
            updateAuthSecurityNote("Security check timed out · Please retry", "warning");
          },
          "error-callback": () => {
            if (config.input) config.input.value = "";
            updateAuthSecurityNote("Security check unavailable · Please retry", "warning");
          }
        });
        turnstileWidgets.set(kind, widgetId);
        return widgetId;
      } catch (error) {
        console.warn("Turnstile render skipped:", error);
        return null;
      }
    }

    function getCaptchaToken(kind) {
      if (!captchaEnabled) return "";
      const config = captchaConfig(kind);
      const widgetId = turnstileWidgets.get(kind);
      if (widgetId !== undefined && window.turnstile?.getResponse) {
        try {
          const response = window.turnstile.getResponse(widgetId);
          if (response) return response;
        } catch (_) {}
      }
      return config?.input?.value || "";
    }

    function resetCaptcha(kind) {
      const config = captchaConfig(kind);
      const widgetId = turnstileWidgets.get(kind);
      if (widgetId !== undefined && window.turnstile?.reset) {
        try { window.turnstile.reset(widgetId); } catch (_) {}
      }
      if (config?.input) config.input.value = "";
    }

    async function requireCaptcha(kind) {
      if (!captchaEnabled) return true;
      await ensureCaptchaWidget(kind);
      const token = getCaptchaToken(kind);
      if (token) return true;
      setAuthMessage("Please complete the security check before continuing.", "error");
      updateAuthSecurityNote("Security check required · Please retry", "warning");
      shakeAuthOnError();
      return false;
    }

    /* =====================================================
       REQUEST HELPERS
    ====================================================== */

    async function parseResponse(response) {
      const contentType = response.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        try {
          const data = await response.json();
          return {
            ok: response.ok && data?.success !== false,
            data: data || {},
            message: data?.message || data?.error || "",
            status: response.status,
            retryAfter: response.headers.get("Retry-After") || ""
          };
        } catch (_) {
          return { ok: response.ok, data: {}, message: "", status: response.status, retryAfter: response.headers.get("Retry-After") || "" };
        }
      }
      const text = await response.text();
      return { ok: response.ok, data: {}, message: text || "", status: response.status, retryAfter: response.headers.get("Retry-After") || "" };
    }

    async function postForm(url, payload, options = {}) {
      if (navigator.onLine === false) {
        throw new Error("You appear to be offline. Please reconnect and try again.");
      }

      const body = new URLSearchParams();
      Object.entries(payload || {}).forEach(([key, value]) => body.append(key, String(value ?? "")));

      const controller = new AbortController();
      const timeoutMs = Number(options.timeoutMs) || AUTH_REQUEST_TIMEOUT_MS;
      const timeout = window.setTimeout(() => controller.abort(), timeoutMs);

      const headers = {
        "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8",
        "Accept": "application/json, text/plain, */*",
        "X-Requested-With": "XMLHttpRequest"
      };
      if (clientCsrfToken) headers["X-CSRF-Token"] = clientCsrfToken;

      try {
        const response = await fetch(url, {
          method: "POST",
          headers,
          credentials: "same-origin",
          cache: "no-store",
          body,
          signal: controller.signal
        });
        const parsed = await parseResponse(response);
        if (response.status === 429 && !parsed.message) parsed.message = "Too many attempts. Please slow down and try again shortly.";
        if (response.status === 403 && !parsed.message) parsed.message = "Your security check could not be completed. Please refresh and try again.";
        return { ...parsed, redirected: response.redirected, url: response.url };
      } catch (error) {
        if (error?.name === "AbortError") throw new Error("The request took too long. Please check your connection and try again.");
        throw error;
      } finally {
        window.clearTimeout(timeout);
      }
    }

    /* =====================================================
       BOT SIGNALS / START TIME
    ====================================================== */

    function rememberAuthStartTime() {
      authOpenedAt = Date.now();
      [loginAuthStartedAt, signupAuthStartedAt, forgotAuthStartedAt, resetAuthStartedAt, phoneAuthStartedAt].forEach((field) => {
        if (field) field.value = String(authOpenedAt);
      });
    }

    function getHoneypotValue(form) {
      return String(form?.querySelector('[name="website"]')?.value || "").trim();
    }

    function rejectBotLikeSubmission(form) {
      if (getHoneypotValue(form)) {
        setAuthMessage("We couldn't complete that request. Please try again.", "error");
        shakeAuthOnError();
        return true;
      }
      if (!authOpenedAt || Date.now() - authOpenedAt < AUTH_MIN_INTERACTION_MS) {
        setAuthMessage("Please take a moment to complete the form before submitting.", "error");
        shakeAuthOnError();
        return true;
      }
      return false;
    }

    /* =====================================================
       VIEW SWITCHING
    ====================================================== */

    function hideAllSections() {
      Object.values(sections).forEach((section) => section?.classList.add("hidden"));
    }

    function setAuthAria(titleId, descriptionId) {
      authModalContent?.setAttribute("aria-labelledby", titleId);
      authModalContent?.setAttribute("aria-describedby", descriptionId);
    }

    function showLoginForm({ clear = true } = {}) {
      hideAllSections();
      sections.login?.classList.remove("hidden");
      currentMode = "login";
      if (clear) clearAuthMessage();
      resetAuthModalScroll();
      resetSubmitButtons();
      markAuthJourney("account");
      setAuthAria("authTitle", "authDescription");
      updateAuthSecurityNote("Protected session · Secure sign-in · Your data stays private", "success");
      ensureCaptchaWidget("login");
    }

    function showSignupForm({ clear = true } = {}) {
      hideAllSections();
      sections.signup?.classList.remove("hidden");
      currentMode = "signup";
      if (clear) clearAuthMessage();
      resetAuthModalScroll();
      resetSubmitButtons();
      markAuthJourney("account");
      setAuthAria("signupTitle", "signupDescription");
      updateAuthSecurityNote("Protected registration · Email verification · Secure account creation", "success");
      ensureCaptchaWidget("signup");
    }

    function showOtpForm(email, expiresIn = OTP_EXPIRY_SECONDS) {
      hideAllSections();
      sections.otp?.classList.remove("hidden");
      currentMode = "otp";
      otpEmailValue = String(email || "").trim().toLowerCase();
      if (otpEmail) otpEmail.value = otpEmailValue;
      if (otpEmailDisplay) otpEmailDisplay.textContent = otpEmailValue;
      if (otpCode) { otpCode.value = ""; setFieldState(otpCode, null); }
      clearAuthMessage();
      resetSubmitButtons();
      resetAuthModalScroll();
      markAuthJourney("verify");
      setAuthAria("otpTitle", "otpDescription");
      updateAuthSecurityNote("Verification step · Code is time-limited and single-use", "success");
      startOtpExpiryTimer(expiresIn);
      window.setTimeout(() => otpCode?.focus(), 70);
    }

    function showForgotForm({ clear = true } = {}) {
      hideAllSections();
      sections.forgot?.classList.remove("hidden");
      currentMode = "forgot";
      if (clear) clearAuthMessage();
      resetAuthModalScroll();
      resetSubmitButtons();
      markAuthJourney("account");
      setAuthAria("forgotTitle", "forgotDescription");
      updateAuthSecurityNote("Private recovery flow · Account existence is never disclosed", "success");
      ensureCaptchaWidget("forgot");
    }

    function showResetForm(token) {
      resetTokenValue = String(token || "").trim();
      if (resetToken) resetToken.value = resetTokenValue;
      hideAllSections();
      sections.reset?.classList.remove("hidden");
      currentMode = "reset";
      resetAuthModalScroll();
      resetSubmitButtons();
      markAuthJourney("verify");
      setAuthAria("resetTitle", "resetDescription");
      updateAuthSecurityNote("Secure reset link · One-time token · Password protection enabled", "success");
      resetExpiresAt = Date.now() + PASSWORD_RESET_CLIENT_SECONDS * 1000;
      ensureCaptchaWidget("reset");
      window.setTimeout(() => resetPassword?.focus(), 70);
    }

    function showPhoneCompletion() {
      hideAllSections();
      sections.phone?.classList.remove("hidden");
      currentMode = "phone";
      clearAuthMessage();
      resetAuthModalScroll();
      resetSubmitButtons();
      markAuthJourney("finish");
      setAuthAria("completePhoneTitle", "completePhoneDescription");
      updateAuthSecurityNote("Google account connected · One final profile detail is required", "success");
      rememberAuthStartTime();
      ensureCaptchaWidget("phone");
      window.setTimeout(() => googlePhoneInput?.focus(), 70);
    }

    function openAuth(mode = "login", opener = null, token = "") {
      if (!authModal) return;
      closeMobileMenu();
      rememberAuthStartTime();
      clearAuthMessage();
      resetAuthModalScroll();

      if (mode === "signup") showSignupForm({ clear: false });
      else if (mode === "otp") showOtpForm(otpEmailValue || "", OTP_EXPIRY_SECONDS);
      else if (mode === "forgot") showForgotForm({ clear: false });
      else if (mode === "reset") showResetForm(token);
      else if (mode === "complete-phone") showPhoneCompletion();
      else showLoginForm({ clear: false });

      const initialFocus = mode === "signup" ? fullnameInput : mode === "forgot" ? forgotEmail : mode === "reset" ? resetPassword : mode === "complete-phone" ? googlePhoneInput : loginEmail;
      openModal(authModal, initialFocus, opener);
    }

    /* =====================================================
       PASSWORD VISIBILITY / INPUT EVENTS
    ====================================================== */

    $$(".password-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        const target = document.getElementById(button.getAttribute("data-target"));
        if (!target) return;
        const showing = target.type === "password";
        target.type = showing ? "text" : "password";
        button.textContent = showing ? "🙈" : "👁";
        button.setAttribute("aria-label", showing ? "Hide password" : "Show password");
        button.setAttribute("aria-pressed", String(showing));
      });
    });

    signupPassword?.addEventListener("input", () => {
      updatePasswordStrength(signupPassword, passwordStrength, passwordStrengthLabel);
      if (signupPassword.value.length >= 10) setFieldState(signupPassword, "valid");
      else if (signupPassword.value) setFieldState(signupPassword, "invalid");
      else setFieldState(signupPassword, null);
      checkPasswordMatch(signupPassword, confirmPassword, passwordMatchError, passwordMatchSuccess);
    });
    confirmPassword?.addEventListener("input", () => checkPasswordMatch(signupPassword, confirmPassword, passwordMatchError, passwordMatchSuccess));
    resetPassword?.addEventListener("input", () => {
      updatePasswordStrength(resetPassword, resetPasswordStrength, resetPasswordStrengthLabel);
      if (resetPassword.value.length >= 10) setFieldState(resetPassword, "valid");
      else if (resetPassword.value) setFieldState(resetPassword, "invalid");
      else setFieldState(resetPassword, null);
      checkPasswordMatch(resetPassword, resetConfirmPassword, resetMatchError, resetMatchSuccess);
    });
    resetConfirmPassword?.addEventListener("input", () => checkPasswordMatch(resetPassword, resetConfirmPassword, resetMatchError, resetMatchSuccess));

    [phoneInput, googlePhoneInput].forEach((field) => {
      field?.addEventListener("input", () => {
        field.value = field.value.replace(/[^0-9]/g, "").slice(0, 11);
        if (field === googlePhoneInput) {
          if (field.value.length === 11) validateGooglePhoneForm();
          else setFieldState(field, null);
        } else {
          if (field.value.length === 11) {
            const valid = validatePhoneValue(field.value);
            setFieldState(field, valid ? "valid" : "invalid");
            phoneError?.classList.toggle("is-visible", !valid);
          } else {
            setFieldState(field, null);
            phoneError?.classList.remove("is-visible");
          }
        }
      });
    });

    signupUsername?.addEventListener("input", () => {
      signupUsername.value = signupUsername.value.replace(/[^A-Za-z0-9._-]/g, "").slice(0, 50);
      if (!signupUsername.value) return setFieldState(signupUsername, null);
      const valid = signupUsername.value.length >= 3 && signupUsername.value.length <= 50;
      setFieldState(signupUsername, valid ? "valid" : "invalid");
    });

    loginEmail?.addEventListener("input", () => {
      loginEmailError.textContent = "";
      setFieldState(loginEmail, null);
    });
    loginPassword?.addEventListener("input", () => {
      loginPasswordError.textContent = "";
      setFieldState(loginPassword, null);
    });
    forgotEmail?.addEventListener("input", () => {
      forgotEmailError.textContent = "";
      setFieldState(forgotEmail, null);
    });

    otpCode?.addEventListener("input", () => {
      otpCode.value = otpCode.value.replace(/[^0-9]/g, "").slice(0, 6);
      setFieldState(otpCode, otpCode.value.length === 6 ? "valid" : null);
    });

    /* =====================================================
       GOOGLE AUTH START
    ====================================================== */

    async function continueWithGoogle(button) {
      clearAuthMessage();
      const captchaKind = currentMode === "signup" ? "signup" : "login";
      if (!(await requireCaptcha(captchaKind))) return;
      if (button) {
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        const label = button.querySelector("span:last-child");
        if (label) label.textContent = "Connecting securely…";
      }

      const returnTo = window.location.pathname + window.location.search.replace(/([?&])auth=[^&]+(&?)/, "$1").replace(/[?&]$/, "");
      const form = document.createElement("form");
      form.method = "POST";
      form.action = "/auth/google/start";
      form.style.display = "none";

      const fields = {
        _csrf: clientCsrfToken,
        captchaToken: getCaptchaToken(captchaKind),
        auth_started_at: String(authOpenedAt || Date.now()),
        returnTo
      };
      Object.entries(fields).forEach(([name, value]) => {
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = name;
        input.value = value || "";
        form.appendChild(input);
      });

      document.body.appendChild(form);
      form.submit();
    }

    googleLoginBtn?.addEventListener("click", () => continueWithGoogle(googleLoginBtn));
    googleSignupBtn?.addEventListener("click", () => continueWithGoogle(googleSignupBtn));

    /* =====================================================
       SIGNUP → OTP
    ====================================================== */

    signupFormElem?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearAuthMessage();
      if (rejectBotLikeSubmission(signupFormElem)) return;
      if (!(await requireCaptcha("signup"))) return;

      if (!validateSignupForm()) {
        setAuthMessage("Please review the highlighted fields and correct the errors.", "error");
        signupFormElem.querySelector(".is-invalid")?.focus();
        shakeAuthOnError();
        return;
      }

      const payload = {
        fullname: fullnameInput.value.trim(),
        email: signupEmail.value.trim().toLowerCase(),
        username: signupUsername.value.trim(),
        password: signupPassword.value,
        confirmPassword: confirmPassword.value,
        phone: phoneInput.value.trim(),
        website: getHoneypotValue(signupFormElem),
        auth_started_at: signupAuthStartedAt.value || String(authOpenedAt || Date.now()),
        captchaToken: getCaptchaToken("signup"),
        _csrf: clientCsrfToken
      };

      setLoading(signupSubmit, "Sending Code…");
      updateAuthSecurityNote("Securely preparing email verification…", "success");

      try {
        const result = await postForm("/signup/request-otp", payload);
        if (!result.ok) {
          setAuthMessage(result.message || "We couldn't send the verification code. Please try again.", "error");
          resetButton(signupSubmit, "Send Verification Code");
          resetCaptcha("signup");
          updateAuthSecurityNote("Registration request failed · Please retry", "warning");
          shakeAuthOnError();
          return;
        }

        const resendAfter = Number(result.data?.resendAfter) || OTP_RESEND_SECONDS;
        const expiresIn = Number(result.data?.expiresIn) || OTP_EXPIRY_SECONDS;
        showOtpForm(payload.email, expiresIn);
        setAuthMessage(result.message || "Verification code sent. Check your email.", "success");
        startOtpResendTimer(resendAfter);
        resetCaptcha("signup");
      } catch (error) {
        console.error("OTP request error:", error);
        setAuthMessage(error?.message || "Something went wrong while sending the verification code.", "error");
        resetButton(signupSubmit, "Send Verification Code");
        resetCaptcha("signup");
        updateAuthSecurityNote("Connection problem · Please retry", "warning");
        shakeAuthOnError();
      }
    });

    /* =====================================================
       OTP VERIFY / RESEND
    ====================================================== */

    otpFormElem?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearAuthMessage();
      const email = otpEmailValue || otpEmail?.value.trim().toLowerCase() || "";
      const code = otpCode?.value.trim() || "";
      if (!email || !/^\d{6}$/.test(code)) {
        setFieldState(otpCode, "invalid");
        setAuthMessage("Please enter the 6-digit verification code.", "error");
        otpCode?.focus();
        shakeAuthOnError();
        return;
      }
      if (otpExpiresAt && Date.now() >= otpExpiresAt) {
        setFieldState(otpCode, "invalid");
        setAuthMessage("Your verification code has expired. Request a new code to continue.", "error");
        shakeAuthOnError();
        return;
      }

      setLoading(verifyOtpSubmit, "Verifying…");
      updateAuthSecurityNote("Verifying your account securely…", "success");
      try {
        const result = await postForm("/signup/verify-otp", { email, otp: code, _csrf: clientCsrfToken });
        if (!result.ok) {
          setFieldState(otpCode, "invalid");
          setAuthMessage(result.message || "The verification code is invalid or expired.", "error");
          resetButton(verifyOtpSubmit, "Verify & Create Account");
          updateAuthSecurityNote("Verification failed · Request a new code if needed", "warning");
          shakeAuthOnError();
          otpCode?.focus();
          return;
        }

        clearOtpTimers();
        markAuthJourney("finish");
        updateAuthSecurityNote("Account verified · Welcome to Puffer Isle", "success");
        setAuthMessage(result.message || "Your account was created successfully.", "success");
        const redirectTo = result.data?.redirect || "/profile";
        window.setTimeout(() => window.location.assign(redirectTo), 350);
      } catch (error) {
        console.error("OTP verification error:", error);
        setAuthMessage(error?.message || "Something went wrong while verifying the code.", "error");
        resetButton(verifyOtpSubmit, "Verify & Create Account");
        updateAuthSecurityNote("Connection problem · Please retry", "warning");
        shakeAuthOnError();
      }
    });

    async function resendOtp() {
      if (!resendOtpBtn || resendOtpBtn.disabled) return;
      const email = otpEmailValue || otpEmail?.value.trim().toLowerCase() || "";
      if (!email) return;
      resendOtpBtn.disabled = true;
      resendOtpBtn.textContent = "Sending…";
      try {
        const result = await postForm("/signup/resend-otp", { email, _csrf: clientCsrfToken });
        if (!result.ok) {
          setAuthMessage(result.message || "We couldn't resend the verification code.", "error");
          startOtpResendTimer(Number(result.data?.resendAfter) || OTP_RESEND_SECONDS);
          updateAuthSecurityNote("Resend unavailable · Please try again shortly", "warning");
          shakeAuthOnError();
          return;
        }
        setAuthMessage(result.message || "A new verification code has been sent.", "success");
        startOtpResendTimer(Number(result.data?.resendAfter) || OTP_RESEND_SECONDS);
        startOtpExpiryTimer(Number(result.data?.expiresIn) || OTP_EXPIRY_SECONDS);
        otpCode.value = "";
        setFieldState(otpCode, null);
        otpCode.focus();
        updateAuthSecurityNote("New verification code sent · Timer restarted", "success");
      } catch (error) {
        setAuthMessage(error?.message || "Something went wrong while resending the code.", "error");
        startOtpResendTimer(OTP_RESEND_SECONDS);
        updateAuthSecurityNote("Connection problem · Please retry", "warning");
        shakeAuthOnError();
      }
    }

    resendOtpBtn?.addEventListener("click", resendOtp);

    function clearOtpTimers() {
      if (otpResendTimer) window.clearInterval(otpResendTimer);
      if (otpExpiryTimer) window.clearInterval(otpExpiryTimer);
      otpResendTimer = null;
      otpExpiryTimer = null;
      otpResendAt = 0;
      otpExpiresAt = 0;
      if (resendOtpBtn) { resendOtpBtn.disabled = false; resendOtpBtn.textContent = "Resend code"; }
      if (resendCountdown) resendCountdown.textContent = "";
      if (otpExpiry) otpExpiry.textContent = "10:00";
      otpStatusCard?.classList.remove("is-expired");
    }

    function formatTime(totalSeconds) {
      const seconds = Math.max(0, Number(totalSeconds) || 0);
      return `${String(Math.floor(seconds / 60)).padStart(2, "0")}:${String(seconds % 60).padStart(2, "0")}`;
    }

    function startOtpResendTimer(seconds) {
      if (otpResendTimer) window.clearInterval(otpResendTimer);
      otpResendAt = Date.now() + Math.max(0, Number(seconds) || OTP_RESEND_SECONDS) * 1000;
      const update = () => {
        const remaining = Math.max(0, Math.ceil((otpResendAt - Date.now()) / 1000));
        if (resendOtpBtn) {
          resendOtpBtn.disabled = remaining > 0;
          resendOtpBtn.textContent = remaining > 0 ? `Resend in ${remaining}s` : "Resend code";
        }
        if (resendCountdown) resendCountdown.textContent = remaining > 0 ? `You can request another code in ${remaining}s.` : "You can request another code now.";
        if (remaining <= 0 && otpResendTimer) {
          window.clearInterval(otpResendTimer);
          otpResendTimer = null;
        }
      };
      update();
      otpResendTimer = window.setInterval(update, 250);
    }

    function startOtpExpiryTimer(seconds) {
      if (otpExpiryTimer) window.clearInterval(otpExpiryTimer);
      otpExpiresAt = Date.now() + Math.max(0, Number(seconds) || OTP_EXPIRY_SECONDS) * 1000;
      const update = () => {
        const remaining = Math.max(0, Math.ceil((otpExpiresAt - Date.now()) / 1000));
        if (otpExpiry) otpExpiry.textContent = remaining > 0 ? formatTime(remaining) : "Expired";
        otpStatusCard?.classList.toggle("is-expired", remaining <= 0);
        if (verifyOtpSubmit) verifyOtpSubmit.disabled = remaining <= 0;
        if (remaining <= 0 && otpExpiryTimer) {
          window.clearInterval(otpExpiryTimer);
          otpExpiryTimer = null;
          setAuthMessage("Your verification code has expired. Request a new code to continue.", "error");
          updateAuthSecurityNote("Verification code expired · Request a new code", "warning");
          setFieldState(otpCode, "invalid");
        }
      };
      update();
      otpExpiryTimer = window.setInterval(update, 250);
    }

    /* =====================================================
       FORGOT PASSWORD
    ====================================================== */

    forgotFormElem?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearAuthMessage();
      if (rejectBotLikeSubmission(forgotFormElem)) return;
      if (!(await requireCaptcha("forgot"))) return;

      const email = forgotEmail?.value.trim().toLowerCase() || "";
      if (!isValidEmail(email)) {
        setFieldState(forgotEmail, "invalid");
        if (forgotEmailError) forgotEmailError.textContent = "Enter a valid email address.";
        setAuthMessage("Please enter a valid email address.", "error");
        forgotEmail?.focus();
        shakeAuthOnError();
        return;
      }

      setLoading(forgotSubmit, "Sending…");
      updateAuthSecurityNote("Preparing a secure recovery message…", "success");
      try {
        const result = await postForm("/auth/forgot-password", {
          email,
          website: getHoneypotValue(forgotFormElem),
          auth_started_at: forgotAuthStartedAt.value || String(authOpenedAt || Date.now()),
          captchaToken: getCaptchaToken("forgot"),
          _csrf: clientCsrfToken
        });

        if (!result.ok) {
          setAuthMessage(result.message || "We couldn't complete the recovery request. Please try again.", "error");
          resetButton(forgotSubmit, "Send Reset Link");
          resetCaptcha("forgot");
          updateAuthSecurityNote("Recovery request failed · Please retry", "warning");
          shakeAuthOnError();
          return;
        }

        setAuthMessage(result.message || "If an account exists for that email, a reset link is on its way.", "success");
        updateAuthSecurityNote("Recovery request processed · Check your inbox", "success");
        resetButton(forgotSubmit, "Send Reset Link");
        resetCaptcha("forgot");
      } catch (error) {
        setAuthMessage(error?.message || "Something went wrong. Please try again.", "error");
        resetButton(forgotSubmit, "Send Reset Link");
        resetCaptcha("forgot");
        updateAuthSecurityNote("Connection problem · Please retry", "warning");
        shakeAuthOnError();
      }
    });

    /* =====================================================
       RESET PASSWORD
    ====================================================== */

    resetFormElem?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearAuthMessage();
      if (rejectBotLikeSubmission(resetFormElem)) return;
      if (!(await requireCaptcha("reset"))) return;

      if (resetExpiresAt && Date.now() >= resetExpiresAt) {
        setAuthMessage("This password reset session has expired. Please request a new reset link.", "error");
        resetExpiredBackBtn?.focus();
        shakeAuthOnError();
        return;
      }

      if (!validateResetForm()) {
        setAuthMessage("Please choose a valid password and make sure both password fields match.", "error");
        resetFormElem.querySelector(".is-invalid")?.focus();
        shakeAuthOnError();
        return;
      }

      setLoading(resetSubmit, "Updating…");
      updateAuthSecurityNote("Updating your password securely…", "success");
      try {
        const result = await postForm("/auth/reset-password", {
          token: resetTokenValue,
          password: resetPassword.value,
          confirmPassword: resetConfirmPassword.value,
          website: getHoneypotValue(resetFormElem),
          auth_started_at: resetAuthStartedAt.value || String(authOpenedAt || Date.now()),
          captchaToken: getCaptchaToken("reset"),
          _csrf: clientCsrfToken
        });

        if (!result.ok) {
          setAuthMessage(result.message || "This reset link is no longer valid. Please request a new one.", "error");
          resetButton(resetSubmit, "Update Password");
          resetCaptcha("reset");
          updateAuthSecurityNote("Password reset unavailable · Request a new link", "warning");
          shakeAuthOnError();
          return;
        }

        resetButton(resetSubmit, "Update Password");
        resetCaptcha("reset");
        resetTokenValue = "";
        try { window.sessionStorage.removeItem("islerms.reset.token"); } catch (_) {}
        updateAuthSecurityNote("Password updated · Sign in with your new password", "success");
        showLoginForm({ clear: false });
        if (loginEmail && result.data?.email) {
          loginEmail.value = result.data.email;
          setFieldState(loginEmail, "valid");
        }
        setAuthMessage(result.message || "Your password has been updated successfully. Please sign in again.", "success");
        window.setTimeout(() => loginPassword?.focus(), 70);
      } catch (error) {
        setAuthMessage(error?.message || "Something went wrong while updating your password.", "error");
        resetButton(resetSubmit, "Update Password");
        resetCaptcha("reset");
        updateAuthSecurityNote("Connection problem · Please retry", "warning");
        shakeAuthOnError();
      }
    });

    /* =====================================================
       GOOGLE PHONE COMPLETION
    ====================================================== */

    phoneFormElem?.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearAuthMessage();
      if (rejectBotLikeSubmission(phoneFormElem)) return;
      if (!(await requireCaptcha("phone"))) return;
      if (!validateGooglePhoneForm()) {
        setAuthMessage("Please enter a valid Philippine mobile number.", "error");
        googlePhoneInput?.focus();
        shakeAuthOnError();
        return;
      }

      setLoading(phoneSubmit, "Saving…");
      updateAuthSecurityNote("Finishing your guest profile securely…", "success");
      try {
        const result = await postForm("/auth/google/complete-profile", {
          phone: googlePhoneInput.value.trim(),
          website: getHoneypotValue(phoneFormElem),
          auth_started_at: phoneAuthStartedAt.value || String(authOpenedAt || Date.now()),
          captchaToken: getCaptchaToken("phone"),
          _csrf: clientCsrfToken
        });

        if (!result.ok) {
          setAuthMessage(result.message || "We couldn't finish your profile. Please try again.", "error");
          resetButton(phoneSubmit, "Save & Continue");
          resetCaptcha("phone");
          updateAuthSecurityNote("Profile completion failed · Please retry", "warning");
          shakeAuthOnError();
          return;
        }

        markAuthJourney("finish");
        updateAuthSecurityNote("Profile complete · Welcome to Puffer Isle", "success");
        setAuthMessage(result.message || "Your contact number has been saved. Welcome to Puffer Isle.", "success");
        resetCaptcha("phone");
        window.setTimeout(() => window.location.assign(result.data?.redirect || "/profile"), 300);
      } catch (error) {
        setAuthMessage(error?.message || "Something went wrong while finishing your profile.", "error");
        resetButton(phoneSubmit, "Save & Continue");
        resetCaptcha("phone");
        updateAuthSecurityNote("Connection problem · Please retry", "warning");
        shakeAuthOnError();
      }
    });

    /* =====================================================
       LOGIN
    ====================================================== */

    loginFormElem?.addEventListener("submit", (event) => {
      const identifier = loginEmail?.value.trim() || "";
      const password = loginPassword?.value || "";
      clearAuthMessage();
      loginEmailError.textContent = "";
      loginPasswordError.textContent = "";

      if (rejectBotLikeSubmission(loginFormElem)) {
        event.preventDefault();
        return;
      }

      if (captchaEnabled && !getCaptchaToken("login")) {
        event.preventDefault();
        setAuthMessage("Please complete the security check before signing in.", "error");
        updateAuthSecurityNote("Security check required · Please retry", "warning");
        shakeAuthOnError();
        return;
      }

      if (!identifier) {
        event.preventDefault();
        setFieldState(loginEmail, "invalid");
        loginEmailError.textContent = "Email or username is required.";
        setAuthMessage("Please enter your email or username.", "error");
        loginEmail?.focus();
        shakeAuthOnError();
        return;
      }

      if (!password) {
        event.preventDefault();
        setFieldState(loginPassword, "invalid");
        loginPasswordError.textContent = "Password is required.";
        setAuthMessage("Please enter your password.", "error");
        loginPassword?.focus();
        shakeAuthOnError();
        return;
      }

      updateAuthSecurityNote("Signing you in securely…", "success");
      setLoading(loginSubmit, "Signing In…");
    });

    /* =====================================================
       AUTH NAVIGATION
    ====================================================== */

    loginBtn?.addEventListener("click", () => openAuth("login", loginBtn));
    bookingBtn?.addEventListener("click", (event) => {
      event.preventDefault();
      openAuth("login", bookingBtn);
    });
    showSignup?.addEventListener("click", (event) => {
      event.preventDefault();
      rememberAuthStartTime();
      showSignupForm();
      fullnameInput?.focus();
    });
    showLogin?.addEventListener("click", (event) => {
      event.preventDefault();
      rememberAuthStartTime();
      showLoginForm();
      loginEmail?.focus();
    });
    forgotPasswordBtn?.addEventListener("click", () => {
      rememberAuthStartTime();
      showForgotForm();
      forgotEmail.value = isValidEmail(loginEmail.value) ? loginEmail.value.trim().toLowerCase() : "";
      if (forgotEmail.value) setFieldState(forgotEmail, "valid");
      forgotEmail?.focus();
    });
    backToLoginFromForgot?.addEventListener("click", () => {
      showLoginForm();
      loginEmail?.focus();
    });
    resetExpiredBackBtn?.addEventListener("click", () => {
      resetTokenValue = "";
      try { window.sessionStorage.removeItem("islerms.reset.token"); } catch (_) {}
      showLoginForm();
      loginEmail?.focus();
    });
    changeEmailBtn?.addEventListener("click", () => {
      clearOtpTimers();
      clearAuthMessage();
      showSignupForm();
      signupEmail.value = otpEmailValue;
      setFieldState(signupEmail, "valid");
      signupEmail?.focus();
    });
    cancelPhoneCompletion?.addEventListener("click", () => {
      window.location.assign("/?auth=login");
    });

    /* =====================================================
       MODAL CLOSE
    ====================================================== */

    authCloseBtn?.addEventListener("click", () => closeModal(authModal));
    authModal?.addEventListener("click", (event) => {
      if (event.target === authModal) closeModal(authModal);
    });
    authModalContent?.addEventListener("click", (event) => event.stopPropagation());

    logoutTrigger?.addEventListener("click", () => {
      closeAllDropdowns();
      openModal(logoutModal, cancelLogout, logoutTrigger);
    });
    cancelLogout?.addEventListener("click", () => closeModal(logoutModal));
    logoutForm?.addEventListener("submit", () => {
      setLoading($("#logoutSubmit"), "Signing Out…");
      if (cancelLogout) cancelLogout.disabled = true;
    });
    logoutModal?.addEventListener("click", (event) => {
      if (event.target === logoutModal) closeModal(logoutModal);
    });
    logoutModalContent?.addEventListener("click", (event) => event.stopPropagation());

    /* =====================================================
       NAVIGATION / DROPDOWNS
    ====================================================== */

    function closeAllDropdowns(except = null) {
      $$(".dropdown.is-open").forEach((dropdown) => {
        if (dropdown === except) return;
        dropdown.classList.remove("is-open");
        dropdown.querySelector(".dropdown-trigger")?.setAttribute("aria-expanded", "false");
      });
    }

    function setMobileButtonState(isOpen) {
      if (!mobileMenuBtn) return;
      mobileMenuBtn.setAttribute("aria-expanded", String(isOpen));
      mobileMenuBtn.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
      const spans = $$("span", mobileMenuBtn);
      if (spans.length < 3) return;
      if (isOpen) {
        spans[0].style.transform = "translateY(7px) rotate(45deg)";
        spans[1].style.opacity = "0";
        spans[2].style.transform = "translateY(-7px) rotate(-45deg)";
      } else {
        spans.forEach((span) => { span.style.transform = ""; span.style.opacity = ""; });
      }
    }

    function closeMobileMenu() {
      mainNavigation?.classList.remove("mobile-open");
      setMobileButtonState(false);
    }

    mobileMenuBtn?.addEventListener("click", (event) => {
      event.stopPropagation();
      if (!mainNavigation) return;
      const isOpen = mainNavigation.classList.toggle("mobile-open");
      if (isOpen) closeAllDropdowns();
      setMobileButtonState(isOpen);
    });

    $$(".dropdown-trigger").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        const dropdown = trigger.closest(".dropdown");
        if (!dropdown) return;
        const shouldOpen = !dropdown.classList.contains("is-open");
        closeAllDropdowns(shouldOpen ? dropdown : null);
        dropdown.classList.toggle("is-open", shouldOpen);
        trigger.setAttribute("aria-expanded", String(shouldOpen));
      });
      trigger.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const dropdown = trigger.closest(".dropdown");
        dropdown?.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      });
    });

    document.addEventListener("click", (event) => {
      if (!event.target.closest(".dropdown")) closeAllDropdowns();
    });
    mainNavigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileMenu));

    /* =====================================================
       KEYBOARD ACCESSIBILITY
    ====================================================== */

    function getFocusableElements(container) {
      if (!container) return [];
      return $$([
        "a[href]",
        "button:not([disabled])",
        "input:not([disabled])",
        "select:not([disabled])",
        "textarea:not([disabled])",
        "[tabindex]:not([tabindex='-1'])"
      ].join(","), container).filter((element) => element.offsetParent !== null);
    }

    document.addEventListener("keydown", (event) => {
      if (!activeModal) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeModal(activeModal);
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = getFocusableElements(activeModal);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    /* =====================================================
       NETWORK UX
    ====================================================== */

    window.addEventListener("offline", () => {
      if (!activeModal) return;
      updateAuthSecurityNote("You're offline · Reconnect before submitting", "warning");
      setAuthMessage("Your connection appears to be offline. Please reconnect before continuing.", "error");
    });

    window.addEventListener("online", () => {
      if (!activeModal) return;
      updateAuthSecurityNote("Connection restored · Ready to continue", "success");
      clearAuthMessage();
    });

    /* =====================================================
       URL STATE / DEEP LINKS
    ====================================================== */

    const url = new URL(window.location.href);
    const requestedAuth = url.searchParams.get("auth");
    const urlError = url.searchParams.get("error");
    const urlSuccess = url.searchParams.get("success");
    const urlResetToken = url.searchParams.get("token");
    const storedResetToken = (() => {
      try { return window.sessionStorage.getItem("islerms.reset.token") || ""; } catch (_) { return ""; }
    })();

    if (urlResetToken) {
      resetTokenValue = urlResetToken;
      try { window.sessionStorage.setItem("islerms.reset.token", urlResetToken); } catch (_) {}
    }

    if (requestedAuth === "complete-phone") {
      openAuth("complete-phone");
    } else if (requestedAuth === "reset" || urlResetToken || storedResetToken) {
      if (!resetTokenValue) resetTokenValue = storedResetToken;
      openAuth("reset", null, resetTokenValue);
    } else if (requestedAuth === "signup") {
      openAuth("signup");
    } else if (requestedAuth === "forgot") {
      openAuth("forgot");
    } else if (requestedAuth === "login" || urlError || urlSuccess) {
      openAuth("login");
    }

    if (urlError && authModal) {
      setAuthMessage(urlError, "error");
      shakeAuthOnError();
    }
    if (urlSuccess && authModal) setAuthMessage(urlSuccess, "success");

    try {
      url.searchParams.delete("token");
      url.searchParams.delete("auth");
      url.searchParams.delete("error");
      url.searchParams.delete("success");
      const cleaned = url.pathname + (url.searchParams.toString() ? `?${url.searchParams.toString()}` : "") + url.hash;
      window.history.replaceState({}, document.title, cleaned);
    } catch (_) {}

    /* =====================================================
       PAGE LIFECYCLE
    ====================================================== */

    window.addEventListener("pageshow", (event) => {
      resetSubmitButtons();
      resetAuthModalScroll();
      if (event.persisted) clearOtpTimers();
    });

    window.addEventListener("beforeunload", () => {
      setBodyLocked(false);
      clearOtpTimers();
    });

    /* =====================================================
       GLOBAL API
    ====================================================== */

    window.IsleRMSAuth = {
      open: (mode = "login", opener = null) => openAuth(mode, opener),
      close: () => closeModal(authModal),
      showLogin: () => showLoginForm(),
      showSignup: () => showSignupForm(),
      showOtp: (email, expiresIn) => showOtpForm(email, expiresIn),
      showForgot: () => showForgotForm(),
      showReset: (token) => openAuth("reset", null, token),
      showPhoneCompletion: () => showPhoneCompletion()
    };

    /* =====================================================
       INIT
    ====================================================== */

    updatePasswordStrength(signupPassword, passwordStrength, passwordStrengthLabel);
    updatePasswordStrength(resetPassword, resetPasswordStrength, resetPasswordStrengthLabel);
    checkPasswordMatch(signupPassword, confirmPassword, passwordMatchError, passwordMatchSuccess);
    checkPasswordMatch(resetPassword, resetConfirmPassword, resetMatchError, resetMatchSuccess);
    resetSubmitButtons();
    markAuthJourney("account");

    if (captchaEnabled) {
      ensureTurnstileLoaded().catch(() => {
        updateAuthSecurityNote("Security check could not load · Please refresh and retry", "warning");
      });
    }
  });
</script>

