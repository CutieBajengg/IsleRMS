<script>

  document.addEventListener(
    "DOMContentLoaded",
    () => {

      "use strict";


      /* =====================================================
         HELPERS
      ====================================================== */

      const $ = (
        selector,
        root = document
      ) => {

        return root.querySelector(
          selector
        );
      };


      const $$ = (
        selector,
        root = document
      ) => {

        return Array.from(
          root.querySelectorAll(
            selector
          )
        );
      };


      /* =====================================================
         AUTH MODAL
      ====================================================== */

      const authModal =
        $("#authModal");


      const authModalContent =
        $("#authModal .auth-modal");


      const authCloseBtn =
        $("#authCloseBtn");


      const authMessage =
        $("#authMessage");


      const clientCsrfToken =
        authModal?.dataset.csrfToken ||
        "";


      /* =====================================================
         AUTH VIEWS
      ====================================================== */

      const loginForm =
        $("#loginForm");


      const signupForm =
        $("#signupForm");


      const otpForm =
        $("#otpForm");


      const loginFormElem =
        $("#loginFormElem");


      const signupFormElem =
        $("#signupFormElem");


      const otpFormElem =
        $("#otpFormElem");


      /* =====================================================
         NAVIGATION
      ====================================================== */

      const loginBtn =
        $("#loginBtn");


      const bookingBtn =
        $("#bookingBtn");


      const googleLoginBtn =
        $("#googleLoginBtn");


      const googleSignupBtn =
        $("#googleSignupBtn");


      const showSignup =
        $("#showSignup");


      const showLogin =
        $("#showLogin");


      const changeEmailBtn =
        $("#changeEmailBtn");


      /* =====================================================
         SIGNUP FIELDS
      ====================================================== */

      const fullnameInput =
        $("#fullname");


      const signupEmail =
        $("#signupEmail");


      const signupUsername =
        $("#signupUsername");


      const signupPassword =
        $("#signupPassword");


      const confirmPassword =
        $("#confirmPassword");


      const phoneInput =
        $("#phoneInput");


      const phoneError =
        $("#phoneError");


      const passwordMatchError =
        $("#passwordMatchError");


      const passwordMatchSuccess =
        $("#passwordMatchSuccess");


      const passwordStrength =
        $(".password-strength");


      const passwordStrengthLabel =
        $("#passwordStrengthLabel");


      /* =====================================================
         OTP FIELDS
      ====================================================== */

      const otpCode =
        $("#otpCode");


      const otpEmail =
        $("#otpEmail");


      const otpEmailDisplay =
        $("#otpEmailDisplay");


      const otpExpiry =
        $("#otpExpiry");


      const resendOtpBtn =
        $("#resendOtpBtn");


      const resendCountdown =
        $("#resendCountdown");


      const verifyOtpSubmit =
        $("#verifyOtpSubmit");


      /* =====================================================
         LOGOUT
      ====================================================== */

      const logoutModal =
        $("#logoutModal");


      const logoutModalContent =
        $("#logoutModal .logout-modal");


      const logoutTrigger =
        $("#logoutTrigger");


      const cancelLogout =
        $("#cancelLogout");


      const logoutForm =
        $("#logoutForm");


      /* =====================================================
         MOBILE
      ====================================================== */

      const mobileMenuBtn =
        $("#mobileMenuBtn");


      const mainNavigation =
        $("#mainNavigation");


      /* =====================================================
         STATE
      ====================================================== */

      let activeModal = null;

      let lastFocusedElement = null;

      let otpEmailValue = "";

      let otpResendTimer = null;

      let otpExpiryTimer = null;


      const OTP_RESEND_SECONDS = 60;

      const OTP_EXPIRY_SECONDS = 600;


      /* =====================================================
         BODY LOCK
      ====================================================== */

      function setBodyLocked(
        locked
      ) {

        document.body.style.overflow =
          locked
            ? "hidden"
            : "";
      }


      /* =====================================================
         AUTH SCROLL
      ====================================================== */

      function resetAuthModalScroll() {

        if (!authModalContent) {
          return;
        }

        authModalContent.scrollTop = 0;
      }


      /* =====================================================
         AUTH MESSAGE
      ====================================================== */

      function setAuthMessage(
        message,
        type = "error"
      ) {

        if (!authMessage) {
          return;
        }

        const text =
          String(
            message || ""
          ).trim();


        if (!text) {

          authMessage.textContent =
            "";

          authMessage.className =
            "auth-message";

          return;
        }


        authMessage.textContent =
          text;

        authMessage.className =
          `auth-message is-visible ${type}`;
      }


      function clearAuthMessage() {

        setAuthMessage(
          "",
          "error"
        );
      }


      /* =====================================================
         FIELD STATE
      ====================================================== */

      function setFieldState(
        field,
        state
      ) {

        if (!field) {
          return;
        }


        field.classList.remove(
          "is-invalid",
          "is-valid"
        );

        field.removeAttribute(
          "aria-invalid"
        );


        if (
          state ===
          "invalid"
        ) {

          field.classList.add(
            "is-invalid"
          );

          field.setAttribute(
            "aria-invalid",
            "true"
          );

          return;
        }


        if (
          state ===
          "valid"
        ) {

          field.classList.add(
            "is-valid"
          );

          field.setAttribute(
            "aria-invalid",
            "false"
          );
        }
      }


      function clearAuthFieldStates() {

        $$("#authModal input").forEach(
          (input) => {

            input.classList.remove(
              "is-invalid",
              "is-valid"
            );

            input.removeAttribute(
              "aria-invalid"
            );
          }
        );


        phoneError?.classList.remove(
          "is-visible"
        );


        passwordMatchError?.classList.remove(
          "is-visible"
        );


        passwordMatchSuccess?.classList.remove(
          "is-visible"
        );


        if (passwordStrength) {

          passwordStrength.className =
            "password-strength";
        }


        if (passwordStrengthLabel) {

          passwordStrengthLabel.textContent =
            "";
        }
      }


      /* =====================================================
         BUTTON LOADING
      ====================================================== */

      function setLoading(
        button,
        label
      ) {

        if (!button) {
          return;
        }


        button.disabled = true;

        button.classList.add(
          "is-loading"
        );


        const labelElement =
          $(".submit-label", button);


        if (labelElement) {

          labelElement.textContent =
            label;
        }
      }


      function resetButton(
        button,
        label
      ) {

        if (!button) {
          return;
        }


        button.disabled = false;

        button.classList.remove(
          "is-loading"
        );


        const labelElement =
          $(".submit-label", button);


        if (labelElement) {

          labelElement.textContent =
            label;
        }
      }


      function resetSubmitButtons() {

        resetButton(
          $("#loginSubmit"),
          "Sign In"
        );


        resetButton(
          $("#signupSubmit"),
          "Send Verification Code"
        );


        resetButton(
          verifyOtpSubmit,
          "Verify & Create Account"
        );


        resetButton(
          $("#logoutSubmit"),
          "Logout"
        );


        if (cancelLogout) {

          cancelLogout.disabled =
            false;
        }
      }


      /* =====================================================
         PASSWORD VISIBILITY
      ====================================================== */

      $$(".password-toggle").forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const targetId =
                button.getAttribute(
                  "data-target"
                );


              const input =
                document.getElementById(
                  targetId
                );


              if (!input) {
                return;
              }


              const showing =
                input.type === "password";


              input.type =
                showing
                  ? "text"
                  : "password";


              button.textContent =
                showing
                  ? "🙈"
                  : "👁";


              button.setAttribute(
                "aria-label",
                showing
                  ? "Hide password"
                  : "Show password"
              );


              button.setAttribute(
                "aria-pressed",
                String(showing)
              );

            }
          );

        }
      );


      /* =====================================================
         PASSWORD STRENGTH
      ====================================================== */

      function calculatePasswordStrength(
        password
      ) {

        if (!password) {

          return {
            level: "",
            label: ""
          };
        }


        let score = 0;


        if (
          password.length >= 10
        ) {

          score++;
        }


        if (
          password.length >= 14
        ) {

          score++;
        }


        if (
          /[A-Z]/.test(password)
        ) {

          score++;
        }


        if (
          /[a-z]/.test(password) &&
          /\d/.test(password)
        ) {

          score++;
        }


        if (
          /[^A-Za-z0-9]/.test(
            password
          )
        ) {

          score++;
        }


        if (
          password.length >= 16 &&
          /[A-Z]/.test(password) &&
          /[a-z]/.test(password) &&
          /\d/.test(password) &&
          /[^A-Za-z0-9]/.test(password)
        ) {

          return {
            level: "strong",
            label: "Strong"
          };
        }


        if (score >= 4) {

          return {
            level: "good",
            label: "Good"
          };
        }


        if (score >= 2) {

          return {
            level: "fair",
            label: "Fair"
          };
        }


        return {
          level: "weak",
          label: "Weak"
        };
      }


      function updatePasswordStrength() {

        if (
          !signupPassword ||
          !passwordStrength
        ) {

          return;
        }


        const result =
          calculatePasswordStrength(
            signupPassword.value
          );


        passwordStrength.className =
          "password-strength";


        if (result.level) {

          passwordStrength.classList.add(
            result.level
          );
        }


        if (passwordStrengthLabel) {

          passwordStrengthLabel.textContent =
            result.label;
        }
      }


      signupPassword?.addEventListener(
        "input",
        () => {

          updatePasswordStrength();

          if (
            signupPassword.value.length >= 10
          ) {

            setFieldState(
              signupPassword,
              "valid"
            );

          } else if (
            signupPassword.value.length > 0
          ) {

            setFieldState(
              signupPassword,
              "invalid"
            );

          } else {

            setFieldState(
              signupPassword,
              null
            );
          }


          checkPasswordMatch();
        }
      );


      /* =====================================================
         PASSWORD MATCH
      ====================================================== */

      function checkPasswordMatch() {

        if (
          !signupPassword ||
          !confirmPassword
        ) {

          return false;
        }


        const password =
          signupPassword.value;


        const confirmation =
          confirmPassword.value;


        if (!confirmation) {

          passwordMatchError?.classList.remove(
            "is-visible"
          );

          passwordMatchSuccess?.classList.remove(
            "is-visible"
          );

          setFieldState(
            confirmPassword,
            null
          );

          return false;
        }


        if (
          password ===
          confirmation
        ) {

          passwordMatchError?.classList.remove(
            "is-visible"
          );

          passwordMatchSuccess?.classList.add(
            "is-visible"
          );

          setFieldState(
            confirmPassword,
            "valid"
          );

          return true;
        }


        passwordMatchError?.classList.add(
          "is-visible"
        );

        passwordMatchSuccess?.classList.remove(
          "is-visible"
        );

        setFieldState(
          confirmPassword,
          "invalid"
        );

        return false;
      }


      confirmPassword?.addEventListener(
        "input",
        checkPasswordMatch
      );


      /* =====================================================
         EMAIL VALIDATION
      ====================================================== */

      function isValidEmail(
        email
      ) {

        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
          email
        );
      }


      signupEmail?.addEventListener(
        "blur",
        () => {

          const value =
            signupEmail.value.trim();


          if (!value) {

            setFieldState(
              signupEmail,
              null
            );

            return;
          }


          setFieldState(
            signupEmail,
            isValidEmail(value)
              ? "valid"
              : "invalid"
          );
        }
      );


      /* =====================================================
         FULL NAME
      ====================================================== */

      fullnameInput?.addEventListener(
        "blur",
        () => {

          const value =
            fullnameInput.value.trim();


          if (
            value.length >= 2 &&
            value.length <= 50
          ) {

            setFieldState(
              fullnameInput,
              "valid"
            );

          } else if (value) {

            setFieldState(
              fullnameInput,
              "invalid"
            );

          } else {

            setFieldState(
              fullnameInput,
              null
            );
          }
        }
      );


      /* =====================================================
         PHONE
      ====================================================== */

      function validatePhone() {

        if (!phoneInput) {
          return true;
        }


        const value =
          phoneInput.value.trim();


        if (
          /^09\d{9}$/.test(value)
        ) {

          setFieldState(
            phoneInput,
            "valid"
          );

          phoneError?.classList.remove(
            "is-visible"
          );

          return true;
        }


        setFieldState(
          phoneInput,
          "invalid"
        );

        phoneError?.classList.add(
          "is-visible"
        );

        return false;
      }


      phoneInput?.addEventListener(
        "input",
        () => {

          phoneInput.value =
            phoneInput.value
              .replace(
                /[^0-9]/g,
                ""
              )
              .slice(
                0,
                11
              );


          if (
            phoneInput.value.length === 11
          ) {

            validatePhone();

          } else {

            phoneError?.classList.remove(
              "is-visible"
            );

            setFieldState(
              phoneInput,
              null
            );
          }
        }
      );


      /* =====================================================
         USERNAME
      ====================================================== */

      signupUsername?.addEventListener(
        "input",
        () => {

          signupUsername.value =
            signupUsername.value
              .replace(
                /[^A-Za-z0-9._-]/g,
                ""
              )
              .slice(
                0,
                50
              );


          if (
            signupUsername.value.length === 0
          ) {

            setFieldState(
              signupUsername,
              null
            );

            return;
          }


          const valid =
            signupUsername.value.length >= 3 &&
            signupUsername.value.length <= 50 &&
            /^[A-Za-z0-9._-]+$/.test(
              signupUsername.value
            );


          setFieldState(
            signupUsername,
            valid
              ? "valid"
              : "invalid"
          );
        }
      );


      /* =====================================================
         MOBILE
      ====================================================== */

      function closeAllDropdowns(
        except = null
      ) {

        $$(".dropdown.is-open").forEach(
          (dropdown) => {

            if (
              dropdown ===
              except
            ) {

              return;
            }


            dropdown.classList.remove(
              "is-open"
            );


            dropdown
              .querySelector(
                ".dropdown-trigger"
              )
              ?.setAttribute(
                "aria-expanded",
                "false"
              );
          }
        );
      }


      function setMobileButtonState(
        isOpen
      ) {

        if (!mobileMenuBtn) {
          return;
        }


        mobileMenuBtn.setAttribute(
          "aria-expanded",
          String(isOpen)
        );


        mobileMenuBtn.setAttribute(
          "aria-label",
          isOpen
            ? "Close navigation menu"
            : "Open navigation menu"
        );


        const spans =
          $$(
            "span",
            mobileMenuBtn
          );


        if (
          spans.length < 3
        ) {

          return;
        }


        if (isOpen) {

          spans[0].style.transform =
            "translateY(7px) rotate(45deg)";

          spans[1].style.opacity =
            "0";

          spans[2].style.transform =
            "translateY(-7px) rotate(-45deg)";

        } else {

          spans.forEach(
            (span) => {

              span.style.transform =
                "";

              span.style.opacity =
                "";
            }
          );
        }
      }


      function closeMobileMenu() {

        mainNavigation?.classList.remove(
          "mobile-open"
        );

        setMobileButtonState(
          false
        );
      }


      mobileMenuBtn?.addEventListener(
        "click",
        (event) => {

          event.stopPropagation();


          if (!mainNavigation) {
            return;
          }


          const isOpen =
            mainNavigation.classList.toggle(
              "mobile-open"
            );


          if (isOpen) {

            closeAllDropdowns();
          }


          setMobileButtonState(
            isOpen
          );
        }
      );


      /* =====================================================
         DROPDOWNS
      ====================================================== */

      $$(".dropdown-trigger").forEach(
        (trigger) => {

          trigger.addEventListener(
            "click",
            (event) => {

              event.preventDefault();

              event.stopPropagation();


              const dropdown =
                trigger.closest(
                  ".dropdown"
                );


              if (!dropdown) {
                return;
              }


              const shouldOpen =
                !dropdown.classList.contains(
                  "is-open"
                );


              closeAllDropdowns(
                shouldOpen
                  ? dropdown
                  : null
              );


              dropdown.classList.toggle(
                "is-open",
                shouldOpen
              );


              trigger.setAttribute(
                "aria-expanded",
                String(shouldOpen)
              );
            }
          );


          trigger.addEventListener(
            "keydown",
            (event) => {

              if (
                event.key ===
                "Escape"
              ) {

                const dropdown =
                  trigger.closest(
                    ".dropdown"
                  );


                dropdown?.classList.remove(
                  "is-open"
                );


                trigger.setAttribute(
                  "aria-expanded",
                  "false"
                );


                trigger.focus();
              }
            }
          );
        }
      );


      document.addEventListener(
        "click",
        (event) => {

          if (
            !event.target.closest(
              ".dropdown"
            )
          ) {

            closeAllDropdowns();
          }
        }
      );


      mainNavigation
        ?.querySelectorAll("a")
        .forEach(
          (link) => {

            link.addEventListener(
              "click",
              () => {

                closeMobileMenu();
              }
            );
          }
        );


      /* =====================================================
         SIGNUP VALIDATION
      ====================================================== */

      function validateSignupForm() {

        let valid = true;


        const fullname =
          fullnameInput?.value.trim() ||
          "";


        const email =
          signupEmail?.value.trim() ||
          "";


        const password =
          signupPassword?.value ||
          "";


        const username =
          signupUsername?.value.trim() ||
          "";


        /* FULL NAME */

        if (
          fullname.length < 2 ||
          fullname.length > 50
        ) {

          valid = false;

          setFieldState(
            fullnameInput,
            "invalid"
          );

        } else {

          setFieldState(
            fullnameInput,
            "valid"
          );
        }


        /* EMAIL */

        if (
          !isValidEmail(email)
        ) {

          valid = false;

          setFieldState(
            signupEmail,
            "invalid"
          );

        } else {

          setFieldState(
            signupEmail,
            "valid"
          );
        }


        /* PASSWORD */

        if (
          password.length < 10
        ) {

          valid = false;

          setFieldState(
            signupPassword,
            "invalid"
          );

        } else {

          setFieldState(
            signupPassword,
            "valid"
          );
        }


        /* CONFIRM PASSWORD */

        if (
          !checkPasswordMatch()
        ) {

          valid = false;
        }


        /* USERNAME */

        if (
          username &&
          (
            username.length < 3 ||
            username.length > 50 ||
            !/^[A-Za-z0-9._-]+$/.test(
              username
            )
          )
        ) {

          valid = false;

          setFieldState(
            signupUsername,
            "invalid"
          );
        }


        /* PHONE */

        if (
          !validatePhone()
        ) {

          valid = false;
        }


        return valid;
      }


      /* =====================================================
         SIGNUP PAYLOAD
      ====================================================== */

      function getSignupPayload() {

        return {

          fullname:
            fullnameInput?.value.trim() ||
            "",

          email:
            signupEmail?.value.trim() ||
            "",

          username:
            signupUsername?.value.trim() ||
            "",

          password:
            signupPassword?.value ||
            "",

          confirmPassword:
            confirmPassword?.value ||
            "",

          phone:
            phoneInput?.value.trim() ||
            "",

          _csrf:
            clientCsrfToken
        };
      }


      /* =====================================================
         RESPONSE PARSER
      ====================================================== */

      async function parseResponse(
        response
      ) {

        const contentType =
          response.headers.get(
            "content-type"
          ) || "";


        if (
          contentType.includes(
            "application/json"
          )
        ) {

          try {

            const data =
              await response.json();


            return {

              ok:
                response.ok &&
                data?.success !== false,

              data:
                data || {},

              message:
                data?.message ||
                data?.error ||
                ""
            };

          } catch (_) {

            return {

              ok:
                response.ok,

              data: {},

              message: ""
            };
          }
        }


        const text =
          await response.text();


        return {

          ok:
            response.ok,

          data: {},

          message:
            text || ""
        };
      }


      /* =====================================================
         POST FORM
      ====================================================== */

      async function postForm(
        url,
        payload
      ) {

        const body =
          new URLSearchParams();


        Object.entries(
          payload
        ).forEach(
          ([key, value]) => {

            body.append(
              key,
              String(value ?? "")
            );
          }
        );


        const headers = {

          "Content-Type":
            "application/x-www-form-urlencoded;charset=UTF-8",

          "Accept":
            "application/json, text/plain, */*",

          "X-Requested-With":
            "XMLHttpRequest"
        };


        if (clientCsrfToken) {

          headers["X-CSRF-Token"] =
            clientCsrfToken;
        }


        const response =
          await fetch(
            url,
            {
              method: "POST",

              headers,

              credentials:
                "same-origin",

              body
            }
          );


        const parsed =
          await parseResponse(
            response
          );


        return {

          ...parsed,

          redirected:
            response.redirected,

          url:
            response.url
        };
      }


      /* =====================================================
         AUTH VIEW SWITCHING
      ====================================================== */

      function showLoginForm() {

        loginForm?.classList.remove(
          "hidden"
        );


        signupForm?.classList.add(
          "hidden"
        );


        otpForm?.classList.add(
          "hidden"
        );


        clearAuthFieldStates();

        clearAuthMessage();

        clearOtpTimers();

        resetSubmitButtons();

        resetAuthModalScroll();
      }


      function showSignupForm() {

        loginForm?.classList.add(
          "hidden"
        );


        signupForm?.classList.remove(
          "hidden"
        );


        otpForm?.classList.add(
          "hidden"
        );


        clearAuthFieldStates();

        clearAuthMessage();

        clearOtpTimers();

        resetSubmitButtons();

        resetAuthModalScroll();
      }


      function showOtpForm(
        email,
        expiresIn =
          OTP_EXPIRY_SECONDS
      ) {

        loginForm?.classList.add(
          "hidden"
        );


        signupForm?.classList.add(
          "hidden"
        );


        otpForm?.classList.remove(
          "hidden"
        );


        otpEmailValue =
          String(
            email || ""
          ).trim();


        if (otpEmail) {

          otpEmail.value =
            otpEmailValue;
        }


        if (otpEmailDisplay) {

          otpEmailDisplay.textContent =
            otpEmailValue;
        }


        if (otpCode) {

          otpCode.value =
            "";

          setFieldState(
            otpCode,
            null
          );
        }


        clearAuthMessage();

        startOtpExpiryTimer(
          expiresIn
        );


        resetSubmitButtons();

        resetAuthModalScroll();


        window.setTimeout(
          () => {

            otpCode?.focus();

          },
          60
        );
      }


      /* =====================================================
         MODAL OPEN
      ====================================================== */

      function openModal(
        modal,
        initialFocus,
        opener = null
      ) {

        if (!modal) {
          return;
        }


        lastFocusedElement =
          opener ||
          document.activeElement;


        activeModal =
          modal;


        modal.classList.add(
          "is-open"
        );


        modal.setAttribute(
          "aria-hidden",
          "false"
        );


        setBodyLocked(
          true
        );


        window.setTimeout(
          () => {

            (
              initialFocus ||
              modal.querySelector(
                "input, button"
              )
            )?.focus();

          },
          50
        );
      }


      /* =====================================================
         MODAL CLOSE
      ====================================================== */

      function clearSensitiveFields() {

        const loginPassword =
          $("#loginPassword");


        [
          loginPassword,
          signupPassword,
          confirmPassword,
          otpCode
        ].forEach(
          (input) => {

            if (input) {

              input.value =
                "";
            }
          }
        );


        clearOtpTimers();

        clearAuthFieldStates();

        resetSubmitButtons();
      }


      function closeModal(
        modal,
        restoreFocus = true
      ) {

        if (!modal) {
          return;
        }


        modal.classList.remove(
          "is-open"
        );


        modal.setAttribute(
          "aria-hidden",
          "true"
        );


        if (
          activeModal ===
          modal
        ) {

          activeModal =
            null;
        }


        setBodyLocked(
          false
        );


        clearSensitiveFields();


        if (
          restoreFocus &&
          lastFocusedElement &&
          typeof
            lastFocusedElement.focus ===
              "function"
        ) {

          window.setTimeout(
            () => {

              try {

                lastFocusedElement.focus();

              } catch (_) {

                // Ignore focus restoration failures.
              }


              lastFocusedElement =
                null;

            },
            0
          );
        }
      }


      /* =====================================================
         AUTH OPENING
      ====================================================== */

      function openAuth(
        mode = "login",
        opener = null
      ) {

        if (!authModal) {
          return;
        }


        closeMobileMenu();

        clearAuthMessage();

        resetAuthModalScroll();


        if (
          mode === "signup"
        ) {

          showSignupForm();

        } else {

          showLoginForm();
        }


        const initialFocus =
          mode === "signup"
            ? fullnameInput
            : $("#loginEmail");


        openModal(
          authModal,
          initialFocus,
          opener
        );
      }


      /* =====================================================
         GOOGLE AUTH
      ====================================================== */

      function continueWithGoogle(
        button
      ) {

        clearAuthMessage();


        if (button) {

          button.disabled =
            true;

          button.setAttribute(
            "aria-busy",
            "true"
          );
        }


        const currentPath =
          window.location.pathname;


        const currentQuery =
          window.location.search;


        const returnTo =
          currentPath +
          currentQuery;


        const separator =
          returnTo.includes("?")
            ? "&"
            : "?";


        const googleUrl =
          "/auth/google" +
          separator +
          "returnTo=" +
          encodeURIComponent(
            returnTo
          );


        window.location.assign(
          googleUrl
        );
      }


      googleLoginBtn?.addEventListener(
        "click",
        () => {

          continueWithGoogle(
            googleLoginBtn
          );
        }
      );


      googleSignupBtn?.addEventListener(
        "click",
        () => {

          continueWithGoogle(
            googleSignupBtn
          );
        }
      );


      /* =====================================================
         SIGNUP -> REQUEST OTP
      ====================================================== */

      signupFormElem?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          clearAuthMessage();


          if (
            !validateSignupForm()
          ) {

            setAuthMessage(
              "Please review the highlighted fields and correct the errors.",
              "error"
            );


            const firstInvalid =
              signupFormElem.querySelector(
                ".is-invalid"
              );


            firstInvalid?.focus();

            return;
          }


          const payload =
            getSignupPayload();


          setLoading(
            $("#signupSubmit"),
            "Sending Code..."
          );


          try {

            const result =
              await postForm(
                "/signup/request-otp",
                payload
              );


            if (!result.ok) {

              setAuthMessage(
                result.message ||
                  "We couldn't send the verification code. Please try again.",
                "error"
              );


              resetButton(
                $("#signupSubmit"),
                "Send Verification Code"
              );


              return;
            }


            const resendAfter =
              Number(
                result.data?.resendAfter
              ) ||
              OTP_RESEND_SECONDS;


            const expiresIn =
              Number(
                result.data?.expiresIn
              ) ||
              OTP_EXPIRY_SECONDS;


            showOtpForm(
              payload.email,
              expiresIn
            );


            setAuthMessage(
              result.message ||
                "Verification code sent. Check your email.",
              "success"
            );


            startOtpResendTimer(
              resendAfter
            );

          } catch (error) {

            console.error(
              "OTP request error:",
              error
            );


            setAuthMessage(
              "Something went wrong while sending the verification code.",
              "error"
            );


            resetButton(
              $("#signupSubmit"),
              "Send Verification Code"
            );
          }
        }
      );


      /* =====================================================
         OTP INPUT
      ====================================================== */

      otpCode?.addEventListener(
        "input",
        () => {

          otpCode.value =
            otpCode.value
              .replace(
                /[^0-9]/g,
                ""
              )
              .slice(
                0,
                6
              );


          if (
            otpCode.value.length === 6
          ) {

            setFieldState(
              otpCode,
              "valid"
            );

          } else {

            setFieldState(
              otpCode,
              null
            );
          }
        }
      );


      /* =====================================================
         OTP VERIFY
      ====================================================== */

      otpFormElem?.addEventListener(
        "submit",
        async (event) => {

          event.preventDefault();

          clearAuthMessage();


          const email =
            otpEmailValue ||
            otpEmail?.value.trim() ||
            "";


          const code =
            otpCode?.value.trim() ||
            "";


          if (
            !email ||
            !/^\d{6}$/.test(code)
          ) {

            setFieldState(
              otpCode,
              "invalid"
            );


            setAuthMessage(
              "Please enter the 6-digit verification code.",
              "error"
            );


            otpCode?.focus();

            return;
          }


          setLoading(
            verifyOtpSubmit,
            "Verifying..."
          );


          try {

            const result =
              await postForm(
                "/signup/verify-otp",
                {
                  email,
                  otp: code,
                  _csrf:
                    clientCsrfToken
                }
              );


            if (!result.ok) {

              setFieldState(
                otpCode,
                "invalid"
              );


              setAuthMessage(
                result.message ||
                  "The verification code is invalid or expired.",
                "error"
              );


              resetButton(
                verifyOtpSubmit,
                "Verify & Create Account"
              );


              otpCode?.focus();

              return;
            }


            clearOtpTimers();


            setAuthMessage(
              result.message ||
                "Your account was created successfully.",
              "success"
            );


            const redirectTo =
              result.data?.redirect ||
              "";


            if (redirectTo) {

              window.location.assign(
                redirectTo
              );

              return;
            }


            /*
             * If backend doesn't redirect,
             * switch back to login.
             */

            showLoginForm();


            const loginEmail =
              $("#loginEmail");


            if (loginEmail) {

              loginEmail.value =
                email;

              setFieldState(
                loginEmail,
                "valid"
              );
            }


            setAuthMessage(
              "Your account has been created. You can now sign in.",
              "success"
            );


            window.setTimeout(
              () => {

                $("#loginPassword")
                  ?.focus();

              },
              50
            );

          } catch (error) {

            console.error(
              "OTP verification error:",
              error
            );


            setAuthMessage(
              "Something went wrong while verifying the code.",
              "error"
            );


            resetButton(
              verifyOtpSubmit,
              "Verify & Create Account"
            );
          }
        }
      );


      /* =====================================================
         RESEND OTP
      ====================================================== */

      async function resendOtp() {

        if (
          !resendOtpBtn ||
          resendOtpBtn.disabled
        ) {

          return;
        }


        const email =
          otpEmailValue ||
          otpEmail?.value.trim() ||
          "";


        if (!email) {
          return;
        }


        resendOtpBtn.disabled =
          true;


        resendOtpBtn.textContent =
          "Sending...";


        clearAuthMessage();


        try {

          const result =
            await postForm(
              "/signup/resend-otp",
              {
                email,
                _csrf:
                  clientCsrfToken
              }
            );


          if (!result.ok) {

            setAuthMessage(
              result.message ||
                "We couldn't resend the verification code.",
              "error"
            );


            startOtpResendTimer(
              OTP_RESEND_SECONDS
            );


            return;
          }


          const resendAfter =
            Number(
              result.data?.resendAfter
            ) ||
            OTP_RESEND_SECONDS;


          const expiresIn =
            Number(
              result.data?.expiresIn
            ) ||
            OTP_EXPIRY_SECONDS;


          setAuthMessage(
            result.message ||
              "A new verification code has been sent.",
            "success"
          );


          startOtpResendTimer(
            resendAfter
          );


          startOtpExpiryTimer(
            expiresIn
          );


          if (otpCode) {

            otpCode.value =
              "";

            setFieldState(
              otpCode,
              null
            );

            otpCode.focus();
          }

        } catch (error) {

          console.error(
            "OTP resend error:",
            error
          );


          setAuthMessage(
            "Something went wrong while resending the code.",
            "error"
          );


          startOtpResendTimer(
            OTP_RESEND_SECONDS
          );

        }

      }


      resendOtpBtn?.addEventListener(
        "click",
        resendOtp
      );


      /* =====================================================
         OTP TIMERS
      ====================================================== */

      function clearOtpTimers() {

        if (
          otpResendTimer
        ) {

          window.clearInterval(
            otpResendTimer
          );

          otpResendTimer =
            null;
        }


        if (
          otpExpiryTimer
        ) {

          window.clearInterval(
            otpExpiryTimer
          );

          otpExpiryTimer =
            null;
        }


        if (resendOtpBtn) {

          resendOtpBtn.disabled =
            false;

          resendOtpBtn.textContent =
            "Resend code";
        }


        if (resendCountdown) {

          resendCountdown.textContent =
            "";
        }
      }


      function formatTime(
        totalSeconds
      ) {

        const seconds =
          Math.max(
            0,
            Number(totalSeconds) || 0
          );


        const minutes =
          Math.floor(
            seconds / 60
          );


        const remainder =
          seconds % 60;


        return (
          String(minutes).padStart(2, "0") +
          ":" +
          String(remainder).padStart(2, "0")
        );
      }


      function startOtpResendTimer(
        seconds
      ) {

        if (
          otpResendTimer
        ) {

          window.clearInterval(
            otpResendTimer
          );
        }


        let remaining =
          Math.max(
            0,
            Number(seconds) ||
              OTP_RESEND_SECONDS
          );


        if (resendOtpBtn) {

          resendOtpBtn.disabled =
            remaining > 0;

          resendOtpBtn.textContent =
            "Resend code";
        }


        function update() {

          if (!resendCountdown) {
            return;
          }


          if (remaining > 0) {

            resendCountdown.textContent =
              `You can request another code in ${remaining}s.`;

          } else {

            resendCountdown.textContent =
              "You can request another code now.";
          }
        }


        update();


        otpResendTimer =
          window.setInterval(
            () => {

              remaining--;

              update();


              if (
                remaining <= 0
              ) {

                window.clearInterval(
                  otpResendTimer
                );

                otpResendTimer =
                  null;


                if (resendOtpBtn) {

                  resendOtpBtn.disabled =
                    false;

                  resendOtpBtn.textContent =
                    "Resend code";
                }
              }

            },
            1000
          );
      }


      function startOtpExpiryTimer(
        seconds
      ) {

        if (
          otpExpiryTimer
        ) {

          window.clearInterval(
            otpExpiryTimer
          );
        }


        let remaining =
          Math.max(
            0,
            Number(seconds) ||
              OTP_EXPIRY_SECONDS
          );


        function update() {

          if (otpExpiry) {

            otpExpiry.textContent =
              remaining > 0
                ? formatTime(remaining)
                : "Expired";
          }
        }


        update();


        otpExpiryTimer =
          window.setInterval(
            () => {

              remaining--;

              update();


              if (
                remaining <= 0
              ) {

                window.clearInterval(
                  otpExpiryTimer
                );

                otpExpiryTimer =
                  null;


                setAuthMessage(
                  "Your verification code has expired. Please request a new code.",
                  "error"
                );


                setFieldState(
                  otpCode,
                  "invalid"
                );
              }

            },
            1000
          );
      }


      /* =====================================================
         CHANGE EMAIL
      ====================================================== */

      changeEmailBtn?.addEventListener(
        "click",
        () => {

          clearOtpTimers();

          clearAuthMessage();

          showSignupForm();

          window.setTimeout(
            () => {

              signupEmail?.focus();

            },
            50
          );
        }
      );


      /* =====================================================
         LOGIN
      ====================================================== */

      loginFormElem?.addEventListener(
        "submit",
        (event) => {

          const emailInput =
            $("#loginEmail");


          const passwordInput =
            $("#loginPassword");


          const email =
            emailInput?.value.trim() ||
            "";


          const password =
            passwordInput?.value ||
            "";


          if (
            !email ||
            !password
          ) {

            event.preventDefault();


            setAuthMessage(
              "Please enter your email address and password.",
              "error"
            );


            if (!email) {

              emailInput?.focus();

            } else {

              passwordInput?.focus();
            }


            return;
          }


          if (
            !isValidEmail(email)
          ) {

            event.preventDefault();


            setFieldState(
              emailInput,
              "invalid"
            );


            setAuthMessage(
              "Please enter a valid email address.",
              "error"
            );


            emailInput?.focus();

            return;
          }


          setFieldState(
            emailInput,
            "valid"
          );


          clearAuthMessage();


          setLoading(
            $("#loginSubmit"),
            "Signing In..."
          );
        }
      );


      /* =====================================================
         OPEN AUTH
      ====================================================== */

      loginBtn?.addEventListener(
        "click",
        () => {

          openAuth(
            "login",
            loginBtn
          );
        }
      );


      bookingBtn?.addEventListener(
        "click",
        (event) => {

          event.preventDefault();


          openAuth(
            "login",
            bookingBtn
          );
        }
      );


      /* =====================================================
         AUTH SWITCH
      ====================================================== */

      showSignup?.addEventListener(
        "click",
        (event) => {

          event.preventDefault();


          showSignupForm();


          fullnameInput?.focus();
        }
      );


      showLogin?.addEventListener(
        "click",
        (event) => {

          event.preventDefault();


          showLoginForm();


          $("#loginEmail")?.focus();
        }
      );


      /* =====================================================
         AUTH CLOSE
      ====================================================== */

      authCloseBtn?.addEventListener(
        "click",
        () => {

          closeModal(
            authModal
          );
        }
      );


      authModal?.addEventListener(
        "click",
        (event) => {

          if (
            event.target ===
            authModal
          ) {

            closeModal(
              authModal
            );
          }
        }
      );


      /* =====================================================
         LOGOUT
      ====================================================== */

      logoutTrigger?.addEventListener(
        "click",
        () => {

          closeAllDropdowns();


          openModal(
            logoutModal,
            cancelLogout,
            logoutTrigger
          );
        }
      );


      cancelLogout?.addEventListener(
        "click",
        () => {

          closeModal(
            logoutModal
          );
        }
      );


      logoutForm?.addEventListener(
        "submit",
        () => {

          setLoading(
            $("#logoutSubmit"),
            "Signing Out..."
          );


          if (cancelLogout) {

            cancelLogout.disabled =
              true;
          }
        }
      );


      logoutModal?.addEventListener(
        "click",
        (event) => {

          if (
            event.target ===
            logoutModal
          ) {

            closeModal(
              logoutModal
            );
          }
        }
      );


      /* =====================================================
         MODAL CONTENT CLICK
      ====================================================== */

      authModalContent?.addEventListener(
        "click",
        (event) => {

          event.stopPropagation();
        }
      );


      logoutModalContent?.addEventListener(
        "click",
        (event) => {

          event.stopPropagation();
        }
      );


      /* =====================================================
         FOCUSABLE ELEMENTS
      ====================================================== */

      function getFocusableElements(
        container
      ) {

        if (!container) {
          return [];
        }


        return $$(
          [
            "a[href]",
            "button:not([disabled])",
            "input:not([disabled])",
            "select:not([disabled])",
            "textarea:not([disabled])",
            "[tabindex]:not([tabindex='-1'])"
          ].join(","),
          container
        ).filter(
          (element) => {

            return (
              element.offsetParent !==
              null
            );
          }
        );
      }


      /* =====================================================
         KEYBOARD ACCESSIBILITY
      ====================================================== */

      document.addEventListener(
        "keydown",
        (event) => {

          if (!activeModal) {
            return;
          }


          if (
            event.key ===
            "Escape"
          ) {

            event.preventDefault();


            closeModal(
              activeModal
            );


            return;
          }


          if (
            event.key !==
            "Tab"
          ) {

            return;
          }


          const focusable =
            getFocusableElements(
              activeModal
            );


          if (!focusable.length) {
            return;
          }


          const first =
            focusable[0];


          const last =
            focusable[
              focusable.length - 1
            ];


          if (
            event.shiftKey &&
            document.activeElement ===
            first
          ) {

            event.preventDefault();

            last.focus();

            return;
          }


          if (
            !event.shiftKey &&
            document.activeElement ===
            last
          ) {

            event.preventDefault();

            first.focus();
          }
        }
      );


      /* =====================================================
         URL AUTH STATE
      ====================================================== */

      const urlParams =
        new URLSearchParams(
          window.location.search
        );


      const requestedAuth =
        urlParams.get(
          "auth"
        );


      const urlError =
        urlParams.get(
          "error"
        );


      const urlSuccess =
        urlParams.get(
          "success"
        );


      if (
        requestedAuth ===
        "signup"
      ) {

        openAuth(
          "signup"
        );

      } else if (
        requestedAuth ===
          "login" ||
        urlError ||
        urlSuccess
      ) {

        openAuth(
          "login"
        );
      }


      if (
        urlError &&
        authModal
      ) {

        setAuthMessage(
          urlError,
          "error"
        );
      }


      if (
        urlSuccess &&
        authModal
      ) {

        setAuthMessage(
          urlSuccess,
          "success"
        );
      }


      /* =====================================================
         CLEAN URL
      ====================================================== */

      if (
        requestedAuth ||
        urlError ||
        urlSuccess
      ) {

        try {

          window.history.replaceState(
            {},
            document.title,
            window.location.pathname
          );

        } catch (_) {

          // Ignore history cleanup errors.
        }
      }


      /* =====================================================
         PAGE RESTORATION
      ====================================================== */

      window.addEventListener(
        "pageshow",
        () => {

          resetSubmitButtons();

          clearOtpTimers();

          resetAuthModalScroll();
        }
      );


      /* =====================================================
         BEFORE UNLOAD
      ====================================================== */

      window.addEventListener(
        "beforeunload",
        () => {

          setBodyLocked(
            false
          );


          clearOtpTimers();
        }
      );


      /* =====================================================
         GLOBAL AUTH API
      ====================================================== */

      window.IsleRMSAuth = {

        open: (
          mode = "login",
          opener = null
        ) => {

          openAuth(
            mode,
            opener
          );
        },


        close: () => {

          closeModal(
            authModal
          );
        },


        showLogin: () => {

          showLoginForm();
        },


        showSignup: () => {

          showSignupForm();
        },


        showOtp: (
          email,
          expiresIn
        ) => {

          showOtpForm(
            email,
            expiresIn
          );
        }

      };

    }
  );

</script>