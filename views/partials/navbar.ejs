<!-- =========================================================
     PUFFER ISLE RESORT - NAVBAR
     File: views/partials/navbar.ejs
========================================================= -->

<header class="site-header">

  <div class="navbar-container">

    <!-- =====================================================
         BRAND
    ====================================================== -->

    <a href="/" class="brand">

      <div class="logo-container">

        <img
          src="/images/islelogo.png"
          alt="Puffer Isle Resort"
          class="logo"
        >

      </div>

      <div class="brand-text">

        <span class="brand-name">
          Puffer Isle
        </span>

        <span class="brand-subtitle">
          Resort
        </span>

      </div>

    </a>


    <!-- =====================================================
         MOBILE MENU BUTTON
    ====================================================== -->

    <button
      class="mobile-menu-btn"
      id="mobileMenuBtn"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >

      <span></span>
      <span></span>
      <span></span>

    </button>


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <nav
      id="mainNavigation"
      class="main-navigation"
    >

      <!-- HOME -->

      <a
        href="/"
        class="nav-link"
      >
        Home
      </a>


      <!-- EXPLORE -->

      <a
        href="/gallery"
        class="nav-link"
      >
        Explore

        <span class="nav-badge">
          360°
        </span>

      </a>


      <!-- =================================================
           DISCOVER DROPDOWN
      ================================================== -->

      <div class="dropdown nav-dropdown">

        <button
          type="button"
          class="dropbtn"
        >

          Discover

          <span class="dropdown-arrow">
            ▾
          </span>

        </button>


        <div class="dropdown-content">

          <div class="dropdown-heading">
            Discover Puffer Isle
          </div>


          <a href="/#about">

            <span class="menu-icon">
              ◈
            </span>

            <span>
              <strong>
                Our Story
              </strong>

              <small>
                Learn about the resort
              </small>
            </span>

          </a>


          <a href="/#contact">

            <span class="menu-icon">
              ✦
            </span>

            <span>
              <strong>
                Contact Us
              </strong>

              <small>
                We're here to help
              </small>
            </span>

          </a>


          <a href="/rules">

            <span class="menu-icon">
              ✓
            </span>

            <span>
              <strong>
                About the Space
              </strong>

              <small>
                Resort information
              </small>
            </span>

          </a>

        </div>

      </div>


      <!-- =================================================
           BOOK NOW
      ================================================== -->

      <% if (user) { %>

        <a
          href="/booking"
          class="booking-nav-btn"
        >

          <span>
            Book Now
          </span>

          <span class="booking-arrow">
            →
          </span>

        </a>

      <% } else { %>

        <a
          href="#"
          id="bookingBtn"
          class="booking-nav-btn"
        >

          <span>
            Book Now
          </span>

          <span class="booking-arrow">
            →
          </span>

        </a>

      <% } %>


      <!-- =================================================
           USER ACCOUNT
      ================================================== -->

      <% if (user) { %>

        <div class="dropdown profile-wrapper">

          <button
            type="button"
            class="profile-pill"
          >

            <span class="avatar-icon">
              <%= user.fullname.charAt(0).toUpperCase() %>
            </span>


            <span class="user-name">
              <%= user.fullname.split(' ')[0] %>
            </span>


            <span class="profile-arrow">
              ▾
            </span>

          </button>


          <div class="dropdown-content profile-dropdown">

            <div class="profile-header">

              <div class="profile-avatar">

                <%= user.fullname.charAt(0).toUpperCase() %>

              </div>


              <div>

                <strong>
                  <%= user.fullname %>
                </strong>

                <small>
                  Guest Account
                </small>

              </div>

            </div>


            <div class="profile-divider"></div>


            <a href="/profile">

              <span class="menu-icon">
                ◎
              </span>

              <span>

                <strong>
                  My Dashboard
                </strong>

                <small>
                  Manage your stay
                </small>

              </span>

            </a>


            <a
              href="/logout"
              id="logoutTrigger"
              class="logout-link"
            >

              <span class="menu-icon">
                ↪
              </span>

              <span>

                <strong>
                  Logout
                </strong>

                <small>
                  Sign out of your account
                </small>

              </span>

            </a>

          </div>

        </div>


      <% } else { %>


        <!-- SIGN IN -->

        <button
          id="loginBtn"
          class="login-btn"
          type="button"
        >
          Sign In
        </button>


      <% } %>

    </nav>

  </div>

</header>


<!-- =========================================================
     AUTHENTICATION MODAL
========================================================= -->

<% if (!user) { %>

<div
  id="authModal"
  class="modal"
  aria-hidden="true"
>

  <div
    class="modal-content auth-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="authTitle"
  >


    <!-- CLOSE BUTTON -->

    <button
      class="close"
      type="button"
      aria-label="Close authentication window"
    >
      &times;
    </button>


    <!-- =====================================================
         AUTH LOGO
    ====================================================== -->

    <div class="auth-logo">

      <img
        src="/images/islelogo.png"
        alt="Puffer Isle Resort"
      >

    </div>


    <!-- =====================================================
         LOGIN FORM
    ====================================================== -->

    <div
      id="loginForm"
      class="auth-box"
    >

      <div class="auth-header">

        <span class="auth-eyebrow">
          Welcome Back
        </span>


        <h2 id="authTitle">
          Sign in to your account
        </h2>


        <p>
          Continue planning your island escape.
        </p>

      </div>


      <form
        method="POST"
        action="/login"
      >


        <!-- EMAIL -->

        <div class="input-group">

          <label for="loginEmail">
            Email Address
          </label>

          <input
            id="loginEmail"
            type="email"
            name="username"
            placeholder="you@example.com"
            autocomplete="email"
            required
          >

        </div>


        <!-- PASSWORD -->

        <div class="input-group">

          <label for="loginPassword">
            Password
          </label>


          <div class="password-wrapper">

            <input
              id="loginPassword"
              type="password"
              name="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            >


            <button
              type="button"
              class="password-toggle"
              data-target="loginPassword"
              aria-label="Show password"
              title="Show password"
            >
              👁
            </button>

          </div>

        </div>


        <!-- LOGIN -->

        <button
          type="submit"
          class="auth-submit"
        >

          <span>
            Sign In
          </span>

          <span class="submit-arrow">
            →
          </span>

        </button>

      </form>


      <p class="auth-footer">

        New to Puffer Isle?

        <a
          href="#"
          id="showSignup"
        >
          Create an account
        </a>

      </p>

    </div>


    <!-- =====================================================
         SIGN UP FORM
    ====================================================== -->

    <div
      id="signupForm"
      class="auth-box hidden"
    >

      <div class="auth-header">

        <span class="auth-eyebrow">
          Begin Your Journey
        </span>


        <h2>
          Join Puffer Isle
        </h2>


        <p>
          Create your account and start planning
          your perfect escape.
        </p>

      </div>


      <form
        id="signupFormElem"
        method="POST"
        action="/signup"
      >


        <!-- FULL NAME -->

        <div class="input-group">

          <label for="fullname">
            Full Name
          </label>

          <input
            id="fullname"
            type="text"
            name="fullname"
            placeholder="Your full name"
            autocomplete="name"
            required
          >

        </div>


        <!-- EMAIL -->

        <div class="input-group">

          <label for="signupEmail">
            Email Address
          </label>

          <input
            id="signupEmail"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          >

        </div>


        <!-- PASSWORD -->

        <div class="input-group">

          <label for="signupPassword">
            Password
          </label>


          <div class="password-wrapper">

            <input
              id="signupPassword"
              type="password"
              name="password"
              placeholder="Create a password"
              autocomplete="new-password"
              required
            >


            <button
              type="button"
              class="password-toggle"
              data-target="signupPassword"
              aria-label="Show password"
              title="Show password"
            >
              👁
            </button>

          </div>

        </div>


        <!-- CONFIRM PASSWORD -->

        <div class="input-group">

          <label for="confirmPassword">
            Confirm Password
          </label>


          <div class="password-wrapper">

            <input
              id="confirmPassword"
              type="password"
              name="confirmPassword"
              placeholder="Re-enter your password"
              autocomplete="new-password"
              required
            >


            <button
              type="button"
              class="password-toggle"
              data-target="confirmPassword"
              aria-label="Show password"
              title="Show password"
            >
              👁
            </button>

          </div>


          <small
            id="passwordMatchError"
            class="error-msg"
          >
            Passwords do not match.
          </small>


          <small
            id="passwordMatchSuccess"
            class="success-msg"
          >
            Passwords match.
          </small>

        </div>


        <!-- PHONE -->

        <div class="input-group">

          <label for="phoneInput">
            Contact Number
          </label>


          <input
            type="text"
            name="phone"
            id="phoneInput"
            placeholder="09xxxxxxxxx"
            maxlength="11"
            inputmode="numeric"
            autocomplete="tel"
            required
          >


          <small
            id="phoneError"
            class="error-msg"
          >
            Please enter exactly 11 digits.
          </small>

        </div>


        <!-- SIGN UP -->

        <button
          type="submit"
          class="auth-submit"
        >

          <span>
            Create Account
          </span>

          <span class="submit-arrow">
            →
          </span>

        </button>

      </form>


      <p class="auth-footer">

        Already have an account?

        <a
          href="#"
          id="showLogin"
        >
          Sign in
        </a>

      </p>

    </div>

  </div>

</div>

<% } %>


<!-- =========================================================
     LOGOUT CONFIRMATION MODAL
========================================================= -->

<div
  id="logoutModal"
  class="modal"
  aria-hidden="true"
>

  <div
    class="modal-content logout-modal"
    role="dialog"
    aria-modal="true"
  >

    <div class="logout-icon">
      🏝️
    </div>


    <span class="auth-eyebrow">
      Before You Go
    </span>


    <h2>
      Leaving the Isle?
    </h2>


    <p>
      Are you sure you want to sign out?
      Any unsaved booking progress may be lost.
    </p>


    <div class="logout-actions">

      <button
        id="cancelLogout"
        type="button"
        class="stay-btn"
      >
        Stay
      </button>


      <a
        href="/logout"
        class="logout-confirm-btn"
      >
        Logout
      </a>

    </div>

  </div>

</div>


<!-- =========================================================
     EMBEDDED CSS
========================================================= -->

<style>

/* =========================================================
   VARIABLES
========================================================= */

:root {

  --brand-yellow:
    #FFD700;

  --brand-yellow-dark:
    #e6c200;

  --dark:
    #151515;

  --dark-soft:
    #202020;

  --text-light:
    #ffffff;

  --text-muted:
    #9d9d9d;

  --teal:
    #008080;

}


/* =========================================================
   GLOBAL
========================================================= */

.site-header,
.site-header *,
.modal,
.modal * {

  box-sizing:
    border-box;

}


/* =========================================================
   HEADER
========================================================= */

.site-header {

  position:
    fixed;

  top:
    0;

  left:
    0;

  width:
    100%;

  height:
    76px;

  background:
    rgba(18,18,18,0.97);

  border-bottom:
    1px solid
    rgba(255,255,255,0.07);

  box-shadow:
    0 8px 35px
    rgba(0,0,0,0.25);

  z-index:
    1000;

}


.navbar-container {

  height:
    100%;

  max-width:
    1500px;

  margin:
    0 auto;

  padding:
    0 45px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  gap:
    30px;

}


/* =========================================================
   BRAND
========================================================= */

.brand {

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  min-width:
    max-content;

  color:
    white;

  text-decoration:
    none;

}


.logo-container {

  width:
    46px;

  height:
    46px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

}


.logo {

  width:
    46px;

  height:
    46px;

  object-fit:
    contain;

  filter:
    drop-shadow(
      0 0 8px
      rgba(255,215,0,0.3)
    );

}


.brand-text {

  display:
    flex;

  align-items:
    baseline;

  gap:
    5px;

}


.brand-name {

  color:
    white;

  font-size:
    19px;

  font-weight:
    700;

}


.brand-subtitle {

  color:
    var(--brand-yellow);

  font-size:
    19px;

  font-weight:
    700;

}


/* =========================================================
   NAVIGATION
========================================================= */

.main-navigation {

  display:
    flex;

  align-items:
    center;

  justify-content:
    flex-end;

  gap:
    8px;

}


/*
   HOME / EXPLORE / DISCOVER
   Increased from 13px to 18px.
*/

.nav-link,
.dropbtn {

  position:
    relative;

  padding:
    11px 13px;

  border:
    none;

  background:
    transparent;

  color:
    rgba(255,255,255,0.78);

  font-family:
    inherit;

  font-size:
    18px;

  font-weight:
    500;

  letter-spacing:
    0.2px;

  cursor:
    pointer;

  text-decoration:
    none;

  transition:
    color 0.25s ease;

}


.nav-link::after {

  content:
    "";

  position:
    absolute;

  left:
    13px;

  right:
    13px;

  bottom:
    3px;

  height:
    2px;

  background:
    var(--brand-yellow);

  transform:
    scaleX(0);

  transform-origin:
    center;

  transition:
    transform 0.25s ease;

}


.nav-link:hover,
.dropbtn:hover {

  color:
    white;

}


.nav-link:hover::after {

  transform:
    scaleX(1);

}


.nav-badge {

  font-size:
    9px;

  color:
    var(--brand-yellow);

  margin-left:
    2px;

}


/* =========================================================
   DROPDOWNS
========================================================= */

.dropdown {

  position:
    relative;

}


.dropdown-content {

  position:
    absolute;

  top:
    calc(100% + 13px);

  right:
    0;

  width:
    280px;

  padding:
    8px;

  background:
    white;

  border:
    1px solid
    rgba(0,0,0,0.08);

  border-radius:
    16px;

  box-shadow:
    0 25px 60px
    rgba(0,0,0,0.25);

  opacity:
    0;

  visibility:
    hidden;

  transform:
    translateY(8px);

  transition:
    all 0.25s ease;

  z-index:
    20;

}


.dropdown-content::before {

  content:
    "";

  position:
    absolute;

  top:
    -6px;

  right:
    25px;

  width:
    12px;

  height:
    12px;

  background:
    white;

  transform:
    rotate(45deg);

}


.dropdown:hover .dropdown-content {

  opacity:
    1;

  visibility:
    visible;

  transform:
    translateY(0);

}


.dropdown-heading {

  padding:
    12px 14px 8px;

  color:
    #999;

  font-size:
    10px;

  font-weight:
    700;

  text-transform:
    uppercase;

  letter-spacing:
    1.4px;

}


.dropdown-content a {

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  padding:
    12px;

  border-radius:
    10px;

  color:
    var(--dark);

  text-decoration:
    none;

  transition:
    background 0.2s ease;

}


.dropdown-content a:hover {

  background:
    #f7f7f7;

}


.dropdown-content a strong {

  display:
    block;

  font-size:
    13px;

  font-weight:
    600;

}


.dropdown-content a small {

  display:
    block;

  margin-top:
    2px;

  color:
    #999;

  font-size:
    10px;

}


.menu-icon {

  width:
    36px;

  height:
    36px;

  flex:
    0 0 36px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  border-radius:
    10px;

  background:
    #f3f3f3;

  color:
    var(--dark);

  font-size:
    15px;

  transition:
    all 0.2s ease;

}


.dropdown-content a:hover .menu-icon {

  background:
    var(--brand-yellow);

}


.dropdown-arrow,
.profile-arrow {

  margin-left:
    4px;

  font-size:
    11px;

  color:
    rgba(255,255,255,0.5);

}


/* =========================================================
   BOOK NOW
========================================================= */

.booking-nav-btn {

  display:
    flex;

  align-items:
    center;

  gap:
    9px;

  margin-left:
    8px;

  padding:
    11px 18px;

  border-radius:
    50px;

  background:
    var(--brand-yellow);

  color:
    var(--dark) !important;

  font-size:
    12px;

  font-weight:
    800;

  letter-spacing:
    0.4px;

  text-transform:
    uppercase;

  text-decoration:
    none;

  box-shadow:
    0 5px 20px
    rgba(255,215,0,0.15);

  transition:
    all 0.25s ease;

}


.booking-nav-btn:hover {

  background:
    white;

  transform:
    translateY(-2px);

}


.booking-arrow {

  font-size:
    15px;

  transition:
    transform 0.25s ease;

}


.booking-nav-btn:hover .booking-arrow {

  transform:
    translateX(3px);

}


/* =========================================================
   SIGN IN BUTTON
========================================================= */

.login-btn {

  margin-left:
    4px;

  padding:
    11px 18px;

  background:
    transparent;

  color:
    rgba(255,255,255,0.85);

  border:
    1px solid
    rgba(255,255,255,0.18);

  border-radius:
    50px;

  font-family:
    inherit;

  font-size:
    12px;

  font-weight:
    600;

  cursor:
    pointer;

  transition:
    all 0.25s ease;

}


.login-btn:hover {

  color:
    var(--dark);

  background:
    white;

  border-color:
    white;

}


/* =========================================================
   PROFILE
========================================================= */

.profile-pill {

  display:
    flex;

  align-items:
    center;

  gap:
    8px;

  padding:
    6px 11px 6px 6px;

  background:
    rgba(255,255,255,0.07);

  border:
    1px solid
    rgba(255,255,255,0.1);

  border-radius:
    50px;

  color:
    white;

  font-family:
    inherit;

  cursor:
    pointer;

  transition:
    all 0.25s ease;

}


.profile-pill:hover {

  background:
    rgba(255,255,255,0.12);

}


.avatar-icon {

  width:
    31px;

  height:
    31px;

  border-radius:
    50%;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--brand-yellow);

  color:
    var(--dark);

  font-size:
    13px;

  font-weight:
    800;

}


.user-name {

  font-size:
    12px;

  font-weight:
    600;

}


.profile-dropdown {

  width:
    280px;

}


.profile-header {

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  padding:
    12px;

}


.profile-avatar {

  width:
    43px;

  height:
    43px;

  border-radius:
    50%;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  background:
    var(--brand-yellow);

  color:
    var(--dark);

  font-weight:
    800;

}


.profile-header strong {

  display:
    block;

  color:
    var(--dark);

  font-size:
    13px;

}


.profile-header small {

  display:
    block;

  margin-top:
    2px;

  color:
    #999;

  font-size:
    10px;

}


.profile-divider {

  height:
    1px;

  background:
    #eee;

  margin:
    3px 8px 8px;

}


.logout-link:hover {

  background:
    #fff3f3 !important;

}


.logout-link:hover strong {

  color:
    #d93030;

}


/* =========================================================
   MOBILE MENU BUTTON
========================================================= */

.mobile-menu-btn {

  display:
    none;

  width:
    42px;

  height:
    42px;

  padding:
    8px;

  background:
    transparent;

  border:
    1px solid
    rgba(255,255,255,0.15);

  border-radius:
    10px;

  cursor:
    pointer;

}


.mobile-menu-btn span {

  display:
    block;

  height:
    2px;

  margin:
    5px 0;

  background:
    white;

  border-radius:
    10px;

  transition:
    all 0.25s ease;

}


/* =========================================================
   MODAL BACKGROUND
========================================================= */

.modal {

  display:
    none;

  position:
    fixed;

  inset:
    0;

  padding:
    20px;

  background:
    rgba(0,0,0,0.76);

  backdrop-filter:
    blur(10px);

  -webkit-backdrop-filter:
    blur(10px);

  justify-content:
    center;

  align-items:
    center;

  z-index:
    2000;

}


/* =========================================================
   MODAL CONTENT
========================================================= */

.modal-content {

  position:
    relative;

  width:
    100%;

  max-height:
    calc(100vh - 40px);

  overflow-y:
    auto;

  color:
    white;

