                        ></i>
                      </div>

                      <strong>
                        No reservations yet
                      </strong>

                      <p>
                        New booking activity will appear here.
                      </p>

                    </div>

                  </td>

                </tr>

              <% } %>

            </tbody>

          </table>

        </div>

