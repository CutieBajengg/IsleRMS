<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Puffer Isle Resort administrative command center"
  >

  <title>Command Center | Puffer Isle Resort</title>

  <link
    rel="icon"
    type="image/png"
    href="/images/islelogo.png"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --teal: #008080;
      --teal-dark: #005c5c;
      --teal-deep: #003f3f;
      --teal-light: #12a9a9;

      --gold: #ffd700;
      --gold-dark: #d4b400;

      --background: #070a0c;
      --background-soft: #0c1113;

      --surface: rgba(255, 255, 255, 0.035);
      --surface-strong: rgba(255, 255, 255, 0.055);
      --surface-hover: rgba(255, 255, 255, 0.075);

      --border: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.14);

      --text: #ffffff;
      --text-soft: #dce2e4;
      --muted: #929ca1;

      --success: #2ecc71;
      --danger: #e74c3c;
      --warning: #f1c40f;
      --info: #3498db;

      --shadow-sm: 0 10px 30px rgba(0, 0, 0, 0.18);
      --shadow-md: 0 18px 50px rgba(0, 0, 0, 0.25);
      --shadow-lg: 0 28px 80px rgba(0, 0, 0, 0.35);

      --radius-xl: 28px;
      --radius-lg: 21px;
      --radius-md: 16px;
      --radius-sm: 11px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;

      font-family: "Poppins", sans-serif;
      color: var(--text);

      background:
        radial-gradient(
          circle at 8% 8%,
          rgba(0, 128, 128, 0.13),
          transparent 27%
        ),
        radial-gradient(
          circle at 92% 85%,
          rgba(255, 215, 0, 0.045),
          transparent 25%
        ),
        linear-gradient(
          145deg,
          #070a0c 0%,
          #0a0e10 55%,
          #080b0d 100%
        );
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;

      pointer-events: none;

      background:
        linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.012) 1px,
          transparent 1px
        ),
        linear-gradient(
          rgba(255, 255, 255, 0.012) 1px,
          transparent 1px
        );

      background-size: 48px 48px;

      mask-image: linear-gradient(
        to bottom,
        black,
        transparent 75%
      );

      opacity: 0.25;
    }

    button,
    input,
    select,
    textarea,
    a {
      font: inherit;
    }

    button {
      border: 0;
    }

    a {
      color: inherit;
    }

    ::selection {
      color: #071011;
      background: var(--gold);
    }

    ::-webkit-scrollbar {
      width: 8px;
    }

    ::-webkit-scrollbar-track {
      background: var(--background);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--teal);
      border-radius: 999px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--teal-light);
    }

    /* =========================================================
       PAGE
    ========================================================= */

    .dashboard-container {
      position: relative;
      z-index: 1;

      width: min(1600px, calc(100% - 48px));
      margin: 0 auto;

      padding: 40px 0 78px;
    }

    .dashboard-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;

      gap: 28px;
      margin-bottom: 24px;
    }

    .header-copy {
      min-width: 0;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 9px;

      color: var(--teal-light);

      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 2.2px;
      line-height: 1;
      text-transform: uppercase;

      margin-bottom: 11px;
    }

    .eyebrow::before {
      content: "";
      width: 24px;
      height: 1px;
      background: var(--teal-light);
      opacity: 0.8;
    }

    .dashboard-title {
      font-family: "Playfair Display", serif;

      font-size: clamp(2.3rem, 4vw, 3.55rem);
      line-height: 1.04;
      letter-spacing: -1.5px;
    }

    .dashboard-title span {
      color: var(--gold);
    }

    .dashboard-subtitle {
      max-width: 720px;

      margin-top: 10px;

      color: var(--muted);

      font-size: 0.88rem;
      line-height: 1.72;
    }

    .header-actions {
      display: flex;
      align-items: stretch;
      gap: 10px;
      flex-shrink: 0;
    }

    .refresh-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;

      min-height: 68px;
      padding: 0 18px;

      color: var(--text-soft);
      text-decoration: none;

      background: var(--surface);
      border: 1px solid var(--border);

      border-radius: var(--radius-md);

      cursor: pointer;

      transition:
        transform 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .refresh-button:hover {
      transform: translateY(-2px);

      color: white;

      background: var(--surface-hover);
      border-color: rgba(0, 128, 128, 0.5);
    }

    .refresh-button:disabled {
      cursor: wait;
      opacity: 0.7;
    }

    .admin-status {
      display: flex;
      align-items: center;
      gap: 13px;

      min-width: 255px;
      min-height: 68px;

      padding: 12px 16px;

      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.055),
          rgba(255, 255, 255, 0.02)
        );

      border: 1px solid var(--border);
      border-radius: var(--radius-md);

      box-shadow: var(--shadow-sm);

      backdrop-filter: blur(18px);
    }

    .status-indicator {
      position: relative;

      width: 10px;
      height: 10px;

      flex: 0 0 10px;

      border-radius: 50%;

      background: var(--success);

      box-shadow:
        0 0 0 5px rgba(46, 204, 113, 0.09),
        0 0 20px rgba(46, 204, 113, 0.55);
    }

    .status-indicator::after {
      content: "";

      position: absolute;
      inset: -5px;

      border: 1px solid rgba(46, 204, 113, 0.28);
      border-radius: 50%;

      animation: pulseStatus 2.2s ease-out infinite;
    }

    @keyframes pulseStatus {
      0% {
        opacity: 0.8;
        transform: scale(0.8);
      }

      70%,
      100% {
        opacity: 0;
        transform: scale(1.45);
      }
    }

    .admin-status-content {
      min-width: 0;
    }

    .admin-status small {
      display: block;

      color: var(--muted);

      font-size: 0.61rem;
      font-weight: 600;

      letter-spacing: 1.1px;
      text-transform: uppercase;
    }

    .admin-status strong {
      display: block;

      margin-top: 3px;

      font-size: 0.82rem;
      font-weight: 600;
    }

    .local-time {
      margin-top: 2px;

      color: var(--teal-light);

      font-size: 0.64rem;
      font-weight: 500;

      white-space: nowrap;
    }

    .admin-greeting {
      display: inline-flex;
      align-items: center;
      gap: 6px;

      margin-top: 8px;

      color: var(--text-soft);

      font-size: 0.72rem;
    }

    .admin-greeting i {
      color: var(--gold);
    }

    /* =========================================================
       STATISTICS
    ========================================================= */

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;

      margin-bottom: 22px;
    }

    .stat-card,
    .stat-card-link {
      position: relative;

      min-height: 160px;
      padding: 22px;

      overflow: hidden;

      color: inherit;
      text-decoration: none;

      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.055),
          rgba(255, 255, 255, 0.018)
        );

      border: 1px solid var(--border);
      border-radius: var(--radius-lg);

      box-shadow: var(--shadow-sm);

      transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
    }

    .stat-card-link {
      display: block;
      cursor: pointer;
    }

    .stat-card:hover,
    .stat-card-link:hover {
      transform: translateY(-4px);

      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.075),
          rgba(255, 255, 255, 0.025)
        );

      border-color: rgba(0, 128, 128, 0.52);
      box-shadow: var(--shadow-md);
    }

    .stat-card.gold:hover,
    .stat-card-link.gold:hover {
      border-color: rgba(255, 215, 0, 0.35);
    }

    .stat-card.green:hover,
    .stat-card-link.green:hover {
      border-color: rgba(46, 204, 113, 0.38);
    }

    .stat-card.blue:hover,
    .stat-card-link.blue:hover {
      border-color: rgba(52, 152, 219, 0.38);
    }

    .stat-card::before,
    .stat-card-link::before {
      content: "";

      position: absolute;
      left: 22px;
      right: 22px;
      top: 0;

      height: 1px;

      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.13),
        transparent
      );
    }

    .stat-icon {
      width: 44px;
      height: 44px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 16px;

      border-radius: 12px;

      color: var(--teal-light);
      background: rgba(0, 128, 128, 0.11);

      font-size: 0.9rem;
    }

    .stat-card.gold .stat-icon,
    .stat-card-link.gold .stat-icon {
      color: var(--gold);
      background: rgba(255, 215, 0, 0.09);
    }

    .stat-card.green .stat-icon,
    .stat-card-link.green .stat-icon {
      color: var(--success);
      background: rgba(46, 204, 113, 0.09);
    }

    .stat-card.blue .stat-icon,
    .stat-card-link.blue .stat-icon {
      color: var(--info);
      background: rgba(52, 152, 219, 0.09);
    }

    .stat-label {
      display: block;

      color: var(--muted);

      font-size: 0.64rem;
      font-weight: 600;

      letter-spacing: 1.1px;
      text-transform: uppercase;
    }

    .stat-value {
      display: block;

      margin-top: 3px;

      font-size: 1.8rem;
      line-height: 1.2;
      font-weight: 700;

      letter-spacing: -0.5px;
    }

    .stat-description {
      margin-top: 5px;

      color: var(--muted);

      font-size: 0.66rem;
      line-height: 1.48;
    }

    .stat-background-icon {
      position: absolute;

      right: -12px;
      bottom: -25px;

      color: rgba(255, 255, 255, 0.025);

      font-size: 6rem;

      pointer-events: none;
    }

    .stat-card-arrow {
      position: absolute;

      top: 24px;
      right: 24px;

      color: var(--muted);

      font-size: 0.67rem;

      opacity: 0;
      transform: translateX(-5px);

      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    .stat-card-link:hover .stat-card-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    .stat-action-label {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      margin-top: 8px;

      color: var(--text-soft);
      font-size: 0.68rem;
      font-weight: 600;
    }

    .stat-action-label i {
      color: var(--gold);
    }

    /* =========================================================
       MAIN LAYOUT
    ========================================================= */

    .dashboard-grid {
      display: grid;

      grid-template-columns:
        minmax(0, 1.95fr)
        minmax(320px, 0.78fr);

      gap: 20px;

      align-items: start;
    }

    .panel {
      min-width: 0;

      padding: 25px;

      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.04),
          rgba(255, 255, 255, 0.018)
        );

      border: 1px solid var(--border);
      border-radius: var(--radius-xl);

      box-shadow: var(--shadow-lg);

      backdrop-filter: blur(18px);
    }

    .panel + .panel {
      margin-top: 18px;
    }

    .panel-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 18px;
      margin-bottom: 20px;
    }

    .panel-heading {
      min-width: 0;
    }

    .panel-title {
      font-family: "Playfair Display", serif;

      font-size: 1.38rem;
      line-height: 1.2;
    }

    .panel-description {
      margin-top: 5px;

      color: var(--muted);

      font-size: 0.71rem;
      line-height: 1.55;
    }

    .panel-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 7px 0;

      color: var(--gold);

      font-size: 0.71rem;
      font-weight: 600;

      text-decoration: none;
      white-space: nowrap;

      transition:
        color 0.2s ease,
        gap 0.2s ease;
    }

    .panel-link:hover {
      color: white;
      gap: 10px;
    }

    .table-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;

      margin-bottom: 4px;

      color: var(--muted);

      font-size: 0.62rem;
    }

    .live-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .live-label::before {
      content: "";

      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: var(--success);
      box-shadow: 0 0 8px rgba(46, 204, 113, 0.5);
    }

    /* =========================================================
       TABLE
    ========================================================= */

    .table-wrapper {
      width: 100%;
      overflow-x: auto;

      scrollbar-width: thin;
    }

    .booking-table {
      width: 100%;
      min-width: 980px;

      border-collapse: separate;
      border-spacing: 0 8px;
    }

    .booking-table th {
      padding: 0 11px 7px;

      color: var(--muted);

      font-size: 0.59rem;
      font-weight: 600;

      letter-spacing: 1px;
      text-align: left;
      text-transform: uppercase;

      white-space: nowrap;
    }

    .booking-table th:last-child {
      text-align: right;
    }

    .booking-table td {
      padding: 13px 11px;

      background: rgba(255, 255, 255, 0.023);

      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);

      font-size: 0.71rem;
      vertical-align: middle;
    }

    .booking-table td:first-child {
      border-left: 1px solid var(--border);
      border-radius: 13px 0 0 13px;
    }

    .booking-table td:last-child {
      border-right: 1px solid var(--border);
      border-radius: 0 13px 13px 0;
    }

    .booking-table tbody tr {
      transition:
        transform 0.2s ease,
        background 0.25s ease;
    }

    .booking-table tbody tr:hover {
      transform: translateX(3px);
    }

    .guest-cell {
      display: flex;
      align-items: center;
      gap: 10px;

      min-width: 195px;
    }

    .guest-avatar {
      width: 36px;
      height: 36px;

      flex: 0 0 36px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 10px;

      background:
        linear-gradient(
          135deg,
          var(--teal),
          var(--teal-dark)
        );

      color: white;

      font-size: 0.72rem;
      font-weight: 700;

      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.13),
        0 5px 15px rgba(0, 128, 128, 0.16);
    }

    .guest-details {
      min-width: 0;
    }

    .guest-name {
      max-width: 185px;

      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;

      font-size: 0.74rem;
      font-weight: 600;
    }

    .guest-email {
      max-width: 185px;

      margin-top: 2px;

      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;

      color: var(--muted);

      font-size: 0.6rem;
    }

    .room-name {
      display: flex;
      align-items: center;
      gap: 7px;

      min-width: 145px;

      font-weight: 500;
    }

    .room-name i {
      color: var(--gold);
      font-size: 0.72rem;
    }

    .room-title {
      display: block;
      white-space: nowrap;
    }

    .room-addon {
      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 0.59rem;
    }

    .date-range {
      display: flex;
      align-items: center;

      gap: 5px;

      min-width: 190px;

      color: var(--text-soft);

      white-space: nowrap;

      font-size: 0.66rem;
    }

    .date-range .arrow {
      color: var(--teal-light);
    }

    .invalid-date {
      color: var(--danger);
      font-size: 0.64rem;
    }

    .guest-count {
      white-space: nowrap;
    }

    .guest-count-number {
      font-weight: 700;
    }

    .guest-count-label {
      color: var(--muted);
      font-size: 0.59rem;
    }

    .booking-price {
      color: var(--gold);
      font-weight: 700;
      white-space: nowrap;
    }

    .status {
      display: inline-flex;
      align-items: center;

      gap: 6px;

      padding: 6px 9px;

      border-radius: 999px;

      border: 1px solid transparent;

      font-size: 0.57rem;
      font-weight: 700;

      letter-spacing: 0.5px;
      text-transform: uppercase;

      white-space: nowrap;
    }

    .status-dot {
      width: 6px;
      height: 6px;

      flex: 0 0 6px;

      border-radius: 50%;
    }

    .status-pending {
      color: var(--warning);

      background: rgba(241, 196, 15, 0.08);
      border-color: rgba(241, 196, 15, 0.16);
    }

    .status-pending .status-dot {
      background: var(--warning);
      box-shadow: 0 0 7px rgba(241, 196, 15, 0.4);
    }

    .status-accepted {
      color: var(--success);

      background: rgba(46, 204, 113, 0.08);
      border-color: rgba(46, 204, 113, 0.16);
    }

    .status-accepted .status-dot {
      background: var(--success);
      box-shadow: 0 0 7px rgba(46, 204, 113, 0.4);
    }

    .status-confirmed {
      color: var(--success);

      background: rgba(46, 204, 113, 0.08);
      border-color: rgba(46, 204, 113, 0.16);
    }

    .status-confirmed .status-dot {
      background: var(--success);
    }

    .status-declined,
    .status-rejected {
      color: var(--danger);

      background: rgba(231, 76, 60, 0.08);
      border-color: rgba(231, 76, 60, 0.16);
    }

    .status-declined .status-dot,
    .status-rejected .status-dot {
      background: var(--danger);
    }

    .status-cancelled {
      color: #b8c0c4;

      background: rgba(189, 195, 199, 0.07);
      border-color: rgba(189, 195, 199, 0.14);
    }

    .status-cancelled .status-dot {
      background: #bdc3c7;
    }

    .status-checked-in {
      color: var(--info);

      background: rgba(52, 152, 219, 0.08);
      border-color: rgba(52, 152, 219, 0.16);
    }

    .status-checked-in .status-dot {
      background: var(--info);
      box-shadow: 0 0 7px rgba(52, 152, 219, 0.4);
    }

    .status-checked-out,
    .status-completed {
      color: #aeb7bb;

      background: rgba(174, 183, 187, 0.07);
      border-color: rgba(174, 183, 187, 0.14);
    }

    .status-checked-out .status-dot,
    .status-completed .status-dot {
      background: #9da8ad;
    }

    .status-unknown {
      color: var(--muted);

      background: rgba(255, 255, 255, 0.04);
      border-color: var(--border);
    }

    .status-unknown .status-dot {
      background: var(--muted);
    }

    /* =========================================================
       ACTIONS
    ========================================================= */

    .booking-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;

      gap: 6px;

      min-width: 92px;
    }

    .action-button {
      width: 34px;
      height: 34px;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      color: white;
      text-decoration: none;

      background: rgba(255, 255, 255, 0.045);

      border: 1px solid var(--border);
      border-radius: 9px;

      cursor: pointer;

      transition:
        transform 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
    }

    .action-button:hover:not(:disabled) {
      transform: translateY(-2px);
    }

    .action-button.accept:hover:not(:disabled) {
      background: var(--success);
      border-color: var(--success);
      box-shadow: 0 6px 18px rgba(46, 204, 113, 0.18);
    }

    .action-button.decline:hover:not(:disabled) {
      background: var(--danger);
      border-color: var(--danger);
      box-shadow: 0 6px 18px rgba(231, 76, 60, 0.18);
    }

    .action-button.frontdesk:hover:not(:disabled) {
      background: var(--teal);
      border-color: var(--teal);
      box-shadow: 0 6px 18px rgba(0, 128, 128, 0.2);
    }

    .action-button:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    .action-button.loading {
      pointer-events: none;
      opacity: 0.65;
    }

    .action-button.loading i {
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .no-action {
      color: var(--muted);

      font-size: 0.6rem;
      white-space: nowrap;
    }

    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .empty-state {
      padding: 58px 20px;
      text-align: center;
      color: var(--muted);
    }

    .empty-state-icon {
      width: 58px;
      height: 58px;

      margin: 0 auto 16px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 16px;

      background: rgba(0, 128, 128, 0.08);
      color: var(--teal-light);

      font-size: 1.15rem;
    }

    .empty-state strong {
      display: block;

      margin-bottom: 5px;

      color: white;

      font-size: 0.88rem;
    }

    .empty-state p {
      font-size: 0.68rem;
    }

    /* =========================================================
       QUICK ACTIONS / OPERATIONAL PULSE
    ========================================================= */

    .quick-actions {
      display: grid;
      gap: 9px;
    }

    .quick-action {
      width: 100%;

      display: flex;
      align-items: center;

      gap: 12px;

      padding: 12px 13px;

      color: white;
      text-decoration: none;

      text-align: left;

      background: rgba(255, 255, 255, 0.025);

      border: 1px solid var(--border);
      border-radius: 14px;

      cursor: pointer;

      transition:
        transform 0.22s ease,
        background 0.22s ease,
        border-color 0.22s ease;
    }

    .quick-action:hover {
      transform: translateX(4px);

      background: rgba(0, 128, 128, 0.075);
      border-color: rgba(0, 128, 128, 0.5);
    }

    .quick-action.gold:hover {
      background: rgba(255, 215, 0, 0.055);
      border-color: rgba(255, 215, 0, 0.25);
    }

    .quick-action-icon {
      width: 40px;
      height: 40px;

      flex: 0 0 40px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 11px;

      color: var(--teal-light);
      background: rgba(0, 128, 128, 0.1);

      font-size: 0.82rem;
    }

    .quick-action.gold .quick-action-icon {
      color: var(--gold);
      background: rgba(255, 215, 0, 0.08);
    }

    .quick-action.green .quick-action-icon {
      color: var(--success);
      background: rgba(46, 204, 113, 0.08);
    }

    .quick-action.blue .quick-action-icon {
      color: var(--info);
      background: rgba(52, 152, 219, 0.08);
    }

    .quick-action-content {
      flex: 1;
      min-width: 0;
    }

    .quick-action-title {
      display: block;

      font-size: 0.75rem;
      font-weight: 600;
    }

    .quick-action-description {
      display: block;

      margin-top: 2px;

      color: var(--muted);

      font-size: 0.6rem;
      line-height: 1.45;
    }

    .quick-action-arrow {
      color: var(--muted);
      font-size: 0.62rem;

      transition:
        transform 0.2s ease,
        color 0.2s ease;
    }

    .quick-action:hover .quick-action-arrow {
      color: var(--text-soft);
      transform: translateX(2px);
    }

    .quick-action.is-placeholder {
      cursor: default;
    }

    .quick-action.is-placeholder:hover {
      transform: none;

      background: rgba(255, 255, 255, 0.035);
      border-color: var(--border);
    }

    .quick-action.is-placeholder .quick-action-arrow {
      opacity: 0.5;
    }

    .pulse-card {
      margin-top: 18px;
      padding: 18px;

      border-radius: 17px;

      background:
        linear-gradient(
          135deg,
          rgba(0, 128, 128, 0.1),
          rgba(0, 128, 128, 0.024)
        );

      border: 1px solid rgba(0, 128, 128, 0.18);
    }

    .pulse-header {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;
      margin-bottom: 12px;
    }

    .pulse-title {
      display: flex;
      align-items: center;
      gap: 8px;

      color: var(--teal-light);

      font-size: 0.67rem;
      font-weight: 700;

      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .pulse-badge {
      padding: 4px 7px;

      color: var(--teal-light);
      background: rgba(0, 128, 128, 0.1);

      border: 1px solid rgba(0, 128, 128, 0.18);
      border-radius: 999px;

      font-size: 0.52rem;
      font-weight: 600;
      letter-spacing: 0.6px;
      text-transform: uppercase;
    }

    .pulse-list {
      list-style: none;
    }

    .pulse-list li {
      display: flex;
      align-items: flex-start;
      gap: 8px;

      margin-top: 8px;

      color: var(--muted);

      font-size: 0.62rem;
      line-height: 1.45;
    }

    .pulse-list li:first-child {
      margin-top: 0;
    }

    .pulse-list i {
      color: var(--success);
      font-size: 0.56rem;
      flex: 0 0 auto;
      margin-top: 3px;
    }

    .data-note {
      margin-top: 9px;

      color: rgba(220, 226, 228, 0.48);

      font-size: 0.57rem;
      line-height: 1.45;
    }

    /* =========================================================
       TOAST
    ========================================================= */

    .toast-container {
      position: fixed;

      right: 24px;
      bottom: 24px;

      z-index: 9999;

      width: min(420px, calc(100vw - 28px));

      display: flex;
      flex-direction: column;

      gap: 9px;

      pointer-events: none;
    }

    .toast {
      display: flex;
      align-items: flex-start;

      gap: 12px;

      width: 100%;

      padding: 14px 15px;

      background: #111719;

      border: 1px solid var(--border-strong);

      border-radius: 15px;

      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.5);

      pointer-events: auto;

      animation: toastIn 0.25s ease;
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .toast-icon {
      width: 31px;
      height: 31px;

      flex: 0 0 31px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 9px;

      font-size: 0.75rem;
    }

    .toast.success .toast-icon {
      color: var(--success);
      background: rgba(46, 204, 113, 0.1);
    }

    .toast.error .toast-icon {
      color: var(--danger);
      background: rgba(231, 76, 60, 0.1);
    }

    .toast.warning .toast-icon {
      color: var(--warning);
      background: rgba(241, 196, 15, 0.1);
    }

    .toast-content {
      min-width: 0;
    }

    .toast-content strong {
      display: block;

      margin-bottom: 2px;

      font-size: 0.74rem;
      font-weight: 600;
    }

    .toast-content p {
      color: var(--muted);

      font-size: 0.64rem;
      line-height: 1.5;
    }

    /* =========================================================
       ACCESSIBILITY / RESPONSIVE
    ========================================================= */

    .refresh-button:focus-visible,
    .quick-action:focus-visible,
    .panel-link:focus-visible,
    .action-button:focus-visible,
    .stat-card-link:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 3px;
    }

    @media (max-width: 1280px) {
      .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 850px) {
      .dashboard-container {
        width: min(100% - 30px, 1600px);
        padding-top: 28px;
      }

      .dashboard-header {
        align-items: stretch;
        flex-direction: column;
      }

      .header-actions {
        width: 100%;
      }

      .refresh-button {
        flex: 0 0 auto;
      }

      .admin-status {
        flex: 1;
        width: 100%;
      }

      .panel {
        padding: 21px;
        border-radius: 21px;
      }
    }

    @media (max-width: 640px) {
      .dashboard-container {
        width: min(100% - 22px, 1600px);
        padding-bottom: 50px;
      }

      .dashboard-title {
        font-size: 2.15rem;
      }

      .dashboard-subtitle {
        font-size: 0.77rem;
      }

      .stats-grid {
        grid-template-columns: 1fr;
        gap: 11px;
      }

      .stat-card,
      .stat-card-link {
        min-height: 145px;
      }

      .header-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .refresh-button {
        width: 100%;
      }

      .panel-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }

      .panel-link {
        padding-top: 0;
      }

      .table-meta {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
      }

      .toast-container {
        right: 11px;
        bottom: 11px;
        left: 11px;
        width: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- =======================================================
       ADMIN NAVIGATION
  ======================================================== -->

  <%- include('../partials/navadmin') %>

  <%
    const dashboardBookings =
      Array.isArray(recentBookings)
        ? recentBookings
        : [];

    const safeTotalBookings =
      typeof totalBookings !== "undefined"
        ? Number(totalBookings || 0)
        : 0;

    const safeTotalUsers =
      typeof totalUsers !== "undefined"
        ? Number(totalUsers || 0)
        : 0;

    const safeInHouseCount =
      typeof inHouseCount !== "undefined"
        ? Number(inHouseCount || 0)
        : 0;

    const safeAdmin =
      typeof currentAdmin !== "undefined"
        ? currentAdmin
        : (
            typeof admin !== "undefined"
              ? admin
              : null
          );

    const safeAdminName =
      safeAdmin &&
      (
        safeAdmin.username ||
        safeAdmin.name ||
        safeAdmin.fullname
      )
        ? (
            safeAdmin.username ||
            safeAdmin.name ||
            safeAdmin.fullname
          )
        : "Administrator";
  %>

  <!-- =======================================================
       MAIN DASHBOARD
  ======================================================== -->

  <main class="dashboard-container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="dashboard-header">

      <div class="header-copy">

        <div class="eyebrow">
          Resort Management System
        </div>

        <h1 class="dashboard-title">
          Isle <span>Command</span>
        </h1>

        <p class="dashboard-subtitle">
          Your central operational view for reservations,
          guest activity and front-desk operations at
          Puffer Isle Resort.
        </p>

        <div class="admin-greeting">
          <i class="fas fa-user-shield" aria-hidden="true"></i>
          <span>
            <strong><%= safeAdminName %></strong>
            &nbsp;•&nbsp; Administrative session
          </span>
        </div>

      </div>

      <div class="header-actions">

        <button
          type="button"
          class="refresh-button"
          id="refreshDashboard"
          title="Refresh dashboard"
          aria-label="Refresh dashboard"
        >
          <i
            class="fas fa-arrows-rotate"
            aria-hidden="true"
          ></i>

          <span>Refresh</span>
        </button>

        <div
          class="admin-status"
          aria-label="System status"
        >

          <span
            class="status-indicator"
            aria-hidden="true"
          ></span>

          <div class="admin-status-content">

            <small>
              System Status
            </small>

            <strong>
              Operational
            </strong>

            <div
              class="local-time"
              id="currentTime"
              aria-live="polite"
            >
              Loading local time...
            </div>

          </div>

        </div>

      </div>

    </header>

    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <section
      class="stats-grid"
      aria-label="Dashboard statistics"
    >

      <!-- TOTAL BOOKINGS -->

      <a
        href="/admin/history"
        class="stat-card-link gold"
        aria-label="Open reservation history"
      >

        <div class="stat-icon">
          <i
            class="fas fa-calendar-check"
            aria-hidden="true"
          ></i>
        </div>

        <span class="stat-label">
          Total Bookings
        </span>

        <span class="stat-value">
          <%= safeTotalBookings.toLocaleString("en-PH") %>
        </span>

        <p class="stat-description">
          All reservations recorded in the system.
        </p>

        <i
          class="fas fa-calendar-alt stat-background-icon"
          aria-hidden="true"
        ></i>

        <i
          class="fas fa-arrow-up-right-from-square stat-card-arrow"
          aria-hidden="true"
        ></i>

      </a>

      <!-- REGISTERED GUESTS -->

      <a
        href="/admin/users"
        class="stat-card-link"
        aria-label="Open guest management"
      >

        <div class="stat-icon">
          <i
            class="fas fa-users"
            aria-hidden="true"
          ></i>
        </div>

        <span class="stat-label">
          Registered Guests
        </span>

        <span class="stat-value">
          <%= safeTotalUsers.toLocaleString("en-PH") %>
        </span>

        <p class="stat-description">
          Guest accounts registered with the resort.
        </p>

        <i
          class="fas fa-users stat-background-icon"
          aria-hidden="true"
        ></i>

        <i
          class="fas fa-arrow-up-right-from-square stat-card-arrow"
          aria-hidden="true"
        ></i>

      </a>

      <!-- CURRENTLY IN HOUSE -->

      <a
        href="/admin/checkin-manager"
        class="stat-card-link green"
        aria-label="Open front desk and view in-house guests"
      >

        <div class="stat-icon">
          <i
            class="fas fa-bed"
            aria-hidden="true"
          ></i>
        </div>

        <span class="stat-label">
          Currently In-House
        </span>

        <span class="stat-value">
          <%= safeInHouseCount.toLocaleString("en-PH") %>
        </span>

        <p class="stat-description">
          Guests currently checked in.
        </p>

        <i
          class="fas fa-bed stat-background-icon"
          aria-hidden="true"
        ></i>

        <i
          class="fas fa-arrow-up-right-from-square stat-card-arrow"
          aria-hidden="true"
        ></i>

      </a>

      <!-- FRONT DESK -->

      <a
        href="/admin/checkin-manager"
        class="stat-card-link blue"
        aria-label="Open front desk management"
      >

        <div class="stat-icon">
          <i
            class="fas fa-concierge-bell"
            aria-hidden="true"
          ></i>
        </div>

        <span class="stat-label">
          Front Desk
        </span>

        <span class="stat-value">
          <span class="stat-action-label">
            Open operations
            <i
              class="fas fa-arrow-right"
              aria-hidden="true"
            ></i>
          </span>
        </span>

        <p class="stat-description">
          Manage arrivals, in-house guests and departures.
        </p>

        <i
          class="fas fa-concierge-bell stat-background-icon"
          aria-hidden="true"
        ></i>

        <i
          class="fas fa-arrow-up-right-from-square stat-card-arrow"
          aria-hidden="true"
        ></i>

      </a>

    </section>

    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <section class="dashboard-grid">

      <!-- ===================================================
           RECENT RESERVATIONS
      ==================================================== -->

      <div class="panel">

        <div class="panel-header">

          <div class="panel-heading">

            <h2 class="panel-title">
              Recent Reservations
            </h2>

            <p class="panel-description">
              Latest booking activity requiring
              administrative attention.
            </p>

          </div>

          <a
            href="/admin/history"
            class="panel-link"
          >
            View Archive

            <i
              class="fas fa-arrow-right"
              aria-hidden="true"
            ></i>
          </a>

        </div>

        <div class="table-meta">

          <span>
            Showing the latest
            <%= dashboardBookings.length %>
            reservation<%= dashboardBookings.length === 1 ? "" : "s" %>
          </span>

          <span class="live-label">
            Live dashboard data
          </span>

        </div>

        <div class="table-wrapper">

          <table class="booking-table">

            <thead>

              <tr>

                <th>Guest</th>
                <th>Accommodation</th>
                <th>Stay</th>
                <th>Guests</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Actions</th>

              </tr>

            </thead>

            <tbody>

              <% if (dashboardBookings.length > 0) { %>

                <% dashboardBookings.forEach(booking => {

                  const guestName =
                    booking.userId &&
                    booking.userId.fullname
                      ? booking.userId.fullname
                      : "Guest User";

                  const guestEmail =
                    booking.userId &&
                    booking.userId.email
                      ? booking.userId.email
                      : "";

                  const initials =
                    guestName
                      .trim()
                      .split(/\s+/)
                      .slice(0, 2)
                      .map(part =>
                        part.charAt(0).toUpperCase()
                      )
                      .join("") || "G";

                  const roomNames = {
                    "Aircon Room": "Aircon Suite",
                    "Fan Room": "Cozy Fan Room",
                    "Seaside Cottage": "Seaside Cottage"
                  };

                  const roomObject =
                    booking.room &&
                    typeof booking.room === "object"
                      ? booking.room
                      : null;

                  const dynamicRoomName =
                    roomObject &&
                    (
                      roomObject.name ||
                      roomObject.title ||
                      roomObject.roomName
                    )
                      ? (
                          roomObject.name ||
                          roomObject.title ||
                          roomObject.roomName
                        )
                      : null;

                  const rawRoomName =
                    booking.roomName ||
                    booking.roomType ||
                    dynamicRoomName ||
                    (
                      typeof booking.room === "string"
                        ? booking.room
                        : "Accommodation"
                    );

                  const roomName =
                    roomNames[rawRoomName] ||
                    rawRoomName ||
                    "Accommodation";

                  const rawStatus =
                    String(
                      booking.status || "pending"
                    )
                      .toLowerCase()
                      .trim();

                  const allowedStatuses = [
                    "pending",
                    "accepted",
                    "confirmed",
                    "declined",
                    "rejected",
                    "cancelled",
                    "checked-in",
                    "checked-out",
                    "completed"
                  ];

                  const bookingStatus =
                    allowedStatuses.includes(rawStatus)
                      ? rawStatus
                      : "unknown";

                  const statusLabels = {
                    pending: "Pending",
                    accepted: "Accepted",
                    confirmed: "Confirmed",
                    declined: "Declined",
                    rejected: "Rejected",
                    cancelled: "Cancelled",
                    "checked-in": "Checked In",
                    "checked-out": "Checked Out",
                    completed: "Completed",
                    unknown: "Unknown"
                  };

                  const statusLabel =
                    statusLabels[bookingStatus] ||
                    "Unknown";

                  const checkinDate =
                    booking.checkin
                      ? new Date(booking.checkin)
                      : null;

                  const checkoutDate =
                    booking.checkout
                      ? new Date(booking.checkout)
                      : null;

                  const validCheckin =
                    checkinDate &&
                    !Number.isNaN(
                      checkinDate.getTime()
                    );

                  const validCheckout =
                    checkoutDate &&
                    !Number.isNaN(
                      checkoutDate.getTime()
                    );

                  const bookingId =
                    booking._id
                      ? String(booking._id)
                      : "";

                  const guestCount =
                    Math.max(
                      0,
                      Number(booking.guests || 0)
                    );

                  const parsedTotalPrice =
                    Number(booking.totalPrice);

                  const hasTotalPrice =
                    booking.totalPrice !== undefined &&
                    booking.totalPrice !== null &&
                    booking.totalPrice !== "" &&
                    Number.isFinite(parsedTotalPrice);

                  const totalPrice =
                    hasTotalPrice
                      ? parsedTotalPrice
                      : null;

                  const hasCottageAddon =
                    booking.cottageAddon === true ||
                    booking.cottageAddon === "true";

                  const isCottage =
                    rawRoomName === "Seaside Cottage" ||
                    roomName === "Seaside Cottage";

                %>

                  <tr
                    id="booking-row-<%= bookingId %>"
                    data-status="<%= bookingStatus %>"
                  >

                    <!-- GUEST -->

                    <td>

                      <div class="guest-cell">

                        <div
                          class="guest-avatar"
                          aria-hidden="true"
                        >
                          <%= initials %>
                        </div>

                        <div class="guest-details">

                          <div class="guest-name">
                            <%= guestName %>
                          </div>

                          <% if (guestEmail) { %>

                            <div class="guest-email">
                              <%= guestEmail %>
                            </div>

                          <% } %>

                        </div>

                      </div>

                    </td>

                    <!-- ACCOMMODATION -->

                    <td>

                      <div class="room-name">

                        <i
                          class="fas fa-umbrella-beach"
                          aria-hidden="true"
                        ></i>

                        <span>

                          <span class="room-title">
                            <%= roomName %>
                          </span>

                          <% if (
                            hasCottageAddon &&
                            !isCottage
                          ) { %>

                            <span class="room-addon">
                              + Cottage add-on
                            </span>

                          <% } %>

                        </span>

                      </div>

                    </td>

                    <!-- STAY -->

                    <td>

                      <% if (
                        validCheckin &&
                        validCheckout
                      ) { %>

                        <div class="date-range">

                          <span>
                            <%= checkinDate.toLocaleDateString(
                              "en-PH",
                              {
                                month: "short",
                                day: "numeric",
                                year: "numeric"
                              }
                            ) %>
                          </span>

                          <span
                            class="arrow"
                            aria-hidden="true"
                          >
                            →
                          </span>

                          <span>
                            <%= checkoutDate.toLocaleDateString(
                              "en-PH",
                              {
                                month: "short",
                                day: "numeric",
                                year: "numeric"
                              }
                            ) %>
                          </span>

                        </div>

                      <% } else { %>

                        <span class="invalid-date">
                          Invalid dates
                        </span>

                      <% } %>

                    </td>

                    <!-- GUEST COUNT -->

                    <td>

                      <div class="guest-count">

                        <span class="guest-count-number">
                          <%= guestCount %>
                        </span>

                        <span class="guest-count-label">
                          <%= guestCount === 1
                            ? "guest"
                            : "guests"
                          %>
                        </span>

                      </div>

                    </td>

                    <!-- AMOUNT -->

                    <td>

                      <% if (totalPrice !== null) { %>

                        <span class="booking-price">
                          ₱<%= totalPrice.toLocaleString(
                            "en-PH",
                            {
                              minimumFractionDigits: 0,
                              maximumFractionDigits: 2
                            }
                          ) %>
                        </span>

                      <% } else { %>

                        <span class="booking-price">
                          —
                        </span>

                      <% } %>

                    </td>

                    <!-- STATUS -->

                    <td>

                      <span
                        id="status-<%= bookingId %>"
                        class="status status-<%= bookingStatus %>"
                      >

                        <span
                          class="status-dot"
                          aria-hidden="true"
                        ></span>

                        <span class="status-text">
                          <%= statusLabel %>
                        </span>

                      </span>

                    </td>

                    <!-- ACTIONS -->

                    <td>

                      <div class="booking-actions">

                        <% if (
                          bookingStatus === "pending" &&
                          bookingId
                        ) { %>

                          <button
                            type="button"
                            class="action-button accept js-status-update"
                            title="Accept booking"
                            aria-label="Accept booking"
                            data-booking-id="<%= bookingId %>"
                            data-status="accepted"
                          >
                            <i
                              class="fas fa-check"
                              aria-hidden="true"
                            ></i>
                          </button>

                          <button
                            type="button"
                            class="action-button decline js-status-update"
                            title="Decline booking"
                            aria-label="Decline booking"
                            data-booking-id="<%= bookingId %>"
                            data-status="declined"
                          >
                            <i
                              class="fas fa-xmark"
                              aria-hidden="true"
                            ></i>
                          </button>

                        <% } else if (
                          bookingStatus === "accepted" ||
                          bookingStatus === "confirmed"
                        ) { %>

                          <a
                            href="/admin/checkin-manager"
                            class="action-button frontdesk"
                            title="Open front desk"
                            aria-label="Open front desk"
                          >
                            <i
                              class="fas fa-concierge-bell"
                              aria-hidden="true"
                            ></i>
                          </a>

                        <% } else { %>

                          <span class="no-action">
                            No action
                          </span>

                        <% } %>

                      </div>

                    </td>

                  </tr>

                <% }) %>

              <% } else { %>

                <tr>

                  <td
                    colspan="7"
                    style="
                      border: 0;
                      background: transparent;
                    "
                  >

                    <div class="empty-state">

                      <div class="empty-state-icon">
