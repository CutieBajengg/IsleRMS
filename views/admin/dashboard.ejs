  <!-- =======================================================
       TOAST CONTAINER
  ======================================================== -->

  <div
    id="toastContainer"
    class="toast-container"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <!-- =======================================================
       DASHBOARD JAVASCRIPT
  ======================================================== -->

  <script>
    "use strict";

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function showToast(
      title,
      message,
      type = "success"
    ) {
      const container =
        document.getElementById("toastContainer");

      if (!container) {
        return;
      }

      const toast =
        document.createElement("div");

      toast.className =
        `toast ${type}`;

      let icon =
        "fa-circle-check";

      if (type === "error") {
        icon =
          "fa-circle-exclamation";
      }

      if (type === "warning") {
        icon =
          "fa-triangle-exclamation";
      }

      toast.innerHTML = `
        <div class="toast-icon">
          <i class="fas ${icon}" aria-hidden="true"></i>
        </div>

        <div class="toast-content">
          <strong>${escapeHtml(title)}</strong>
          <p>${escapeHtml(message)}</p>
        </div>
      `;

      container.appendChild(toast);

      window.setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform =
          "translateY(10px) scale(.98)";
        toast.style.transition =
          "opacity .25s ease, transform .25s ease";

        window.setTimeout(() => {
          toast.remove();
        }, 250);

      }, 4500);
    }

    function getStatusLabel(status) {
      const labels = {
        pending: "Pending",
        accepted: "Accepted",
        confirmed: "Confirmed",
        declined: "Declined",
        rejected: "Rejected",
        cancelled: "Cancelled",
        "checked-in": "Checked In",
        "checked-out": "Checked Out",
        completed: "Completed",
        unknown: "Unknown"
      };

      return labels[status] || "Unknown";
    }

    async function handleStatusUpdate(button) {

      if (!button) {
        return;
      }

      const bookingId =
        button.dataset.bookingId;

      const newStatus =
        button.dataset.status;

      const allowedStatuses = [
        "accepted",
        "declined"
      ];

      if (
        !bookingId ||
        !allowedStatuses.includes(newStatus)
      ) {
        showToast(
          "Invalid Request",
          "Booking information is missing or invalid.",
          "error"
        );

        return;
      }

      const actionName =
        newStatus === "accepted"
          ? "accept"
          : "decline";

      const confirmation =
        window.confirm(
          `Are you sure you want to ${actionName} this booking?`
        );

      if (!confirmation) {
        return;
      }

      const row =
        document.getElementById(
          `booking-row-${bookingId}`
        );

      if (!row) {
        showToast(
          "Booking Not Found",
          "The reservation could not be found on this page.",
          "error"
        );

        return;
      }

      const actionButtons =
        row.querySelectorAll(
          ".action-button"
        );

      actionButtons.forEach(
        actionButton => {
          actionButton.disabled = true;
        }
      );

      button.classList.add("loading");

      const originalIcon =
        button.querySelector("i");

      if (originalIcon) {
        originalIcon.className =
          "fas fa-spinner";
      }

      try {

        const response =
          await fetch(
            "/admin/booking/update-status",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",

                "Accept":
                  "application/json"
              },

              credentials: "same-origin",

              body: JSON.stringify({
                bookingId,
                status: newStatus
              })
            }
          );

        if (
          response.status === 401 ||
          response.status === 403
        ) {

          showToast(
            "Session Required",
            "Your administrator session may have expired. Please log in again.",
            "error"
          );

          actionButtons.forEach(
            actionButton => {
              actionButton.disabled = false;
            }
          );

          button.classList.remove(
            "loading"
          );

          if (originalIcon) {
            originalIcon.className =
              newStatus === "accepted"
                ? "fas fa-check"
                : "fas fa-xmark";
          }

          return;
        }

        const contentType =
          response.headers.get(
            "content-type"
          ) || "";

        let data = null;

        if (
          contentType.includes(
            "application/json"
          )
        ) {
          data =
            await response.json();
        }

        if (
          !response.ok ||
          !data ||
          !data.success
        ) {

          const message =
            data?.message ||
            "The booking status could not be updated.";

          if (
            data?.code ===
            "ROOM_ALREADY_BOOKED"
          ) {

            showToast(
              "Room Already Booked",
              "This reservation overlaps another active booking and cannot be accepted.",
              "error"
            );

          } else {

            showToast(
              "Update Failed",
              message,
              "error"
            );

          }

          actionButtons.forEach(
            actionButton => {
              actionButton.disabled = false;
            }
          );

          button.classList.remove(
            "loading"
          );

          if (originalIcon) {
            originalIcon.className =
              newStatus === "accepted"
                ? "fas fa-check"
                : "fas fa-xmark";
          }

          return;
        }

        updateBookingRow(
          bookingId,
          newStatus
        );

        showToast(
          "Booking Updated",
          data.message ||
            `Booking has been ${newStatus}.`,
          "success"
        );

      } catch (error) {

        console.error(
          "Admin booking update error:",
          error
        );

        showToast(
          "Connection Error",
          "Unable to contact the local server. Please try again.",
          "error"
        );

        actionButtons.forEach(
          actionButton => {
            actionButton.disabled = false;
          }
        );

        button.classList.remove(
          "loading"
        );

        if (originalIcon) {
          originalIcon.className =
            newStatus === "accepted"
              ? "fas fa-check"
              : "fas fa-xmark";
        }

      }
    }

    function updateBookingRow(
      bookingId,
      newStatus
    ) {

      const row =
        document.getElementById(
          `booking-row-${bookingId}`
        );

      const statusElement =
        document.getElementById(
          `status-${bookingId}`
        );

      if (
        !row ||
        !statusElement
      ) {
        return;
      }

      row.dataset.status =
        newStatus;

      statusElement.className =
        `status status-${newStatus}`;

      const statusText =
        statusElement.querySelector(
          ".status-text"
        );

      if (statusText) {
        statusText.textContent =
          getStatusLabel(
            newStatus
          );
      }

      const actions =
        row.querySelector(
          ".booking-actions"
        );

      if (actions) {

        if (
          newStatus === "accepted"
        ) {

          actions.innerHTML = `
            <a
              href="/admin/checkin-manager"
              class="action-button frontdesk"
              title="Open front desk"
              aria-label="Open front desk"
            >
              <i
                class="fas fa-concierge-bell"
                aria-hidden="true"
              ></i>
            </a>
          `;

        } else {

          actions.innerHTML = `
            <span class="no-action">
              No action
            </span>
          `;

        }
      }

      row.style.transition =
        "background .25s ease";

      row.style.background =
        newStatus === "accepted"
          ? "rgba(46, 204, 113, 0.08)"
          : "rgba(231, 76, 60, 0.06)";

      window.setTimeout(() => {
        row.style.background =
          "";
      }, 2200);
    }

    function updateClock() {
      const clock =
        document.getElementById(
          "currentTime"
        );

      if (!clock) {
        return;
      }

      const now =
        new Date();

      clock.textContent =
        now.toLocaleString(
          "en-PH",
          {
            weekday: "short",
            month: "short",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hour12: true
          }
        );
    }

    document.addEventListener(
      "DOMContentLoaded",
      () => {

        document
          .querySelectorAll(
            ".js-status-update"
          )
          .forEach(button => {

            button.addEventListener(
              "click",
              () => {
                handleStatusUpdate(
                  button
                );
              }
            );

          });

        document
          .querySelectorAll(
            ".quick-action.is-placeholder"
          )
          .forEach(button => {

            button.addEventListener(
              "click",
              () => {

                showToast(
                  button.dataset.toastTitle ||
                    "Coming Soon",

                  button.dataset.toastMessage ||
                    "This module is not connected yet.",

                  button.dataset.toastType ||
                    "warning"
                );

              }
            );

          });

        const refreshButton =
          document.getElementById(
            "refreshDashboard"
          );

        if (refreshButton) {

          refreshButton.addEventListener(
            "click",
            () => {

              const icon =
                refreshButton.querySelector(
                  "i"
                );

              if (icon) {
                icon.classList.add(
                  "fa-spin"
                );
              }

              refreshButton.disabled =
                true;

              window.setTimeout(
                () => {
                  window.location.reload();
                },
                250
              );

            }
          );

        }

      }
    );

    updateClock();

    window.setInterval(
      updateClock,
      1000
    );
  </script>

</body>
