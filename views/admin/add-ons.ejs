  <div class="modal-header">
    <h2 id="modalTitle">
      Add Add-on
    </h2>

    <button
      type="button"
      class="close"
      id="closeModalButton"
    >
      &times;
    </button>
  </div>


  <form id="addOnForm">

    <input
      type="hidden"
      id="addOnId"
    >


    <!-- ADD-ON NAME -->
    <div class="form-group">
      <label for="name">
        Add-on Name
      </label>

      <input
        type="text"
        id="name"
        required
        maxlength="100"
        placeholder="e.g. Seaside Cottage"
      >
    </div>


    <!-- PRICE / PRICING TYPE -->
    <div class="form-row">

      <div class="form-group">
        <label for="price">
          Price
        </label>

        <input
          type="number"
          id="price"
          min="0"
          step="0.01"
          required
          placeholder="1200"
        >
      </div>


      <div class="form-group">
        <label for="pricingType">
          Pricing Type
        </label>

        <select
          id="pricingType"
          required
        >
          <option value="once">
            Once per Stay
          </option>

          <option value="perNight">
            Per Night
          </option>
        </select>
      </div>

    </div>


    <!-- SORT ORDER -->
    <div class="form-group">
      <label for="sortOrder">
        Sort Order
      </label>

      <input
        type="number"
        id="sortOrder"
        min="0"
        step="1"
        value="0"
      >
    </div>


    <!-- IMAGE -->
    <div class="form-group">
      <label for="image">
        Image Path / URL
      </label>

      <input
        type="text"
        id="image"
        maxlength="500"
        placeholder="/images/addon1.jpg"
      >
    </div>


    <!-- DESCRIPTION -->
    <div class="form-group">
      <label for="description">
        Description
      </label>

      <textarea
        id="description"
        maxlength="2000"
        placeholder="Describe this add-on..."
      ></textarea>
    </div>


    <!-- ACTIVE -->
    <div class="form-group checkbox-group">

      <input
        type="checkbox"
        id="active"
        checked
      >

      <label for="active">
        Add-on is active and available for booking
