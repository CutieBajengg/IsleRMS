  </div>

  <script>
    // ==========================================
    // DOM ELEMENTS
    // ==========================================

    const modal = document.getElementById("addOnModal");
    const form = document.getElementById("addOnForm");
    const message = document.getElementById("message");

    const addAddOnButton =
      document.getElementById("addAddOnButton");

    const closeModalButton =
      document.getElementById("closeModalButton");

    const cancelModalButton =
      document.getElementById("cancelModalButton");


    // ==========================================
    // MESSAGE
    // ==========================================

    function showMessage(text, type = "success") {
      message.textContent = text;
      message.className = `message show ${type}`;

      setTimeout(() => {
        message.className = "message";
      }, 4000);
    }


    // ==========================================
    // MODAL
    // ==========================================

    function openAddModal() {
      document.getElementById("modalTitle").textContent =
        "Add Add-on";

      form.reset();

      document.getElementById("addOnId").value = "";
      document.getElementById("pricingType").value = "once";
      document.getElementById("sortOrder").value = "0";
      document.getElementById("active").checked = true;

      modal.classList.add("show");
    }


    function openEditModal(button) {
      const addOnId =
        button.dataset.id || "";

      const addOnName =
        button.dataset.name || "";

      const addOnPrice =
        button.dataset.price || "";

      const pricingType =
        button.dataset.pricingType || "once";

      const sortOrder =
        button.dataset.sortOrder || "0";

      const image =
        button.dataset.image || "";

      const description =
        button.dataset.description || "";

      const active =
        button.dataset.active === "true";


      document.getElementById("modalTitle").textContent =
        "Edit Add-on";

      document.getElementById("addOnId").value =
        addOnId;

      document.getElementById("name").value =
        addOnName;

      document.getElementById("price").value =
        addOnPrice;

      document.getElementById("pricingType").value =
        pricingType;

      document.getElementById("sortOrder").value =
        sortOrder;

      document.getElementById("image").value =
        image;

      document.getElementById("description").value =
        description;

      document.getElementById("active").checked =
        active;

      modal.classList.add("show");
    }


    function closeModal() {
      modal.classList.remove("show");
    }


    // ==========================================
    // ADD / UPDATE ADD-ON
    // ==========================================

    async function saveAddOn(event) {
      event.preventDefault();

      const id =
        document.getElementById("addOnId")
          .value
          .trim();


      const data = {
        name:
          document.getElementById("name")
            .value
            .trim(),

        price:
          Number(
            document.getElementById("price")
              .value
          ),

        pricingType:
          document.getElementById("pricingType")
            .value,

        sortOrder:
          Number(
            document.getElementById("sortOrder")
              .value || 0
          ),

        image:
          document.getElementById("image")
            .value
            .trim(),

        description:
          document.getElementById("description")
            .value
            .trim(),

        active:
          document.getElementById("active")
            .checked
      };


      try {

        const response = await fetch(
          id
            ? `/admin/api/add-ons/${id}`
            : "/admin/api/add-ons",
          {
            method: id ? "PUT" : "POST",

            headers: {
              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify(data)
          }
        );


        let result = {};

        try {
          result = await response.json();
        } catch {
          result = {};
        }


        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            "Unable to save add-on."
          );
        }


        showMessage(
          id
            ? "Add-on updated successfully."
            : "Add-on added successfully."
        );


        closeModal();


        setTimeout(() => {
          window.location.reload();
        }, 700);

      } catch (error) {

        showMessage(
          error.message ||
          "Unable to save add-on.",
          "error"
        );

      }
    }


    // ==========================================
    // ACTIVATE / DEACTIVATE ADD-ON
    // ==========================================

    async function toggleAddOn(
      id,
      currentlyActive
    ) {
      const action =
        currentlyActive
          ? "deactivate"
          : "activate";


      if (
        !confirm(
          `Are you sure you want to ${action} this add-on?`
        )
      ) {
        return;
      }


      try {

        const response = await fetch(
          `/admin/api/add-ons/${id}/status`,
          {
            method: "PATCH",

            headers: {
              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify({
                active: !currentlyActive
              })
          }
        );


        let result = {};

        try {
          result = await response.json();
        } catch {
          result = {};
        }


        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            "Unable to change add-on status."
          );
        }


        window.location.reload();

      } catch (error) {

        showMessage(
          error.message ||
          "Unable to change add-on status.",
          "error"
        );

      }
    }


    // ==========================================
    // DELETE ADD-ON
    // ==========================================

    async function deleteAddOn(
      id,
      name
    ) {

      const confirmed = confirm(
        `Delete "${name}"?\n\n` +
        `If this add-on has been used in booking history, ` +
        `the system may require you to deactivate it instead.`
      );


      if (!confirmed) {
        return;
      }


      try {

        const response = await fetch(
          `/admin/api/add-ons/${id}`,
          {
            method: "DELETE"
          }
        );


        let result = {};

        try {
          result = await response.json();
        } catch {
          result = {};
        }


        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            "Unable to delete add-on."
          );
        }


        showMessage(
          "Add-on deleted successfully."
        );


        setTimeout(() => {
          window.location.reload();
        }, 700);

      } catch (error) {

        showMessage(
          error.message ||
          "Unable to delete add-on.",
          "error"
        );

      }
    }


    // ==========================================
    // BUTTON EVENT LISTENERS
    // ==========================================

    addAddOnButton.addEventListener(
      "click",
      openAddModal
    );


    closeModalButton.addEventListener(
      "click",
      closeModal
    );


    cancelModalButton.addEventListener(
      "click",
      closeModal
    );


    form.addEventListener(
      "submit",
      saveAddOn
    );


    // EDIT BUTTONS
    document
      .querySelectorAll(".edit-add-on-btn")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {
            openEditModal(button);
          }
        );

      });


    // ACTIVATE / DEACTIVATE BUTTONS
    document
      .querySelectorAll(".toggle-add-on-btn")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            const id =
              button.dataset.id;

            const currentlyActive =
              button.dataset.active === "true";

            toggleAddOn(
              id,
              currentlyActive
            );

          }
        );

      });


    // DELETE BUTTONS
    document
      .querySelectorAll(".delete-add-on-btn")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            const id =
              button.dataset.id;

            const name =
              button.dataset.name ||
              "this add-on";

            deleteAddOn(
              id,
              name
            );

          }
        );

      });


    // ==========================================
    // CLOSE MODAL WHEN CLICKING OUTSIDE
    // ==========================================

    window.addEventListener(
      "click",
      event => {

        if (event.target === modal) {
          closeModal();
        }

      }
    );


    // ==========================================
    // CLOSE MODAL WITH ESCAPE
    // ==========================================

    window.addEventListener(
      "keydown",
      event => {

        if (event.key === "Escape") {
          closeModal();
        }

      }
    );
  </script>

</body>
</html>
