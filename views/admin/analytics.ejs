<%
/* ============================================================
   PUFFER ISLE RESORT | IsleRMS
   ADMIN ANALYTICS
   ------------------------------------------------------------
   Premium dark "Isle Command" visual system.
   Server-generated data remains separate from executable JS
   to avoid EJS parsing problems in VS Code.
============================================================ */

/* ============================================================
   SAFE HELPERS
============================================================ */

function safeNumber(value, fallback = 0) {
  const number = Number(value);

  return Number.isFinite(number)
    ? number
    : fallback;
}

function safeText(value, fallback = "") {
  if (
    value === undefined ||
    value === null
  ) {
    return fallback;
  }

  return String(value);
}

function validDate(value) {
  if (!value) {
    return null;
  }

  const date = new Date(value);

  return Number.isNaN(date.getTime())
    ? null
    : date;
}

function dateLabel(value) {
  const date = validDate(value);

  if (!date) {
    return "—";
  }

  return date.toLocaleDateString(
    "en-PH",
    {
      year: "numeric",
      month: "short",
      day: "numeric",
    }
  );
}

function timeLabel(value) {
  const date = validDate(value);

  if (!date) {
    return "—";
  }

  return date.toLocaleTimeString(
    "en-PH",
    {
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    }
  );
}

function money(value) {
  return safeNumber(
    value,
    0
  ).toLocaleString(
    "en-PH",
    {
      style: "currency",
      currency: "PHP",
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }
  );
}

function whole(value) {
  return safeNumber(
    value,
    0
  ).toLocaleString(
    "en-PH"
  );
}

function getUserName(activity) {
  if (!activity) {
    return "Guest";
  }

  const user =
    activity.userId;

  if (
    user &&
    typeof user === "object"
  ) {
    return (
      user.fullname ||
      user.name ||
      user.username ||
      "Guest"
    );
  }

  return (
    activity.fullname ||
    activity.name ||
    activity.username ||
    "Guest"
  );
}

function getRoomName(room) {
  if (!room) {
    return "Unassigned";
  }

  if (
    typeof room === "string"
  ) {
    return room;
  }

  return (
    room.name ||
    room.roomName ||
    room.roomType ||
    room.accommodation ||
    "Unassigned"
  );
}

function statusLabel(status) {
  const normalized =
    safeText(
      status,
      "pending"
    )
      .trim()
      .toLowerCase();

  const labels = {
    pending: "Pending",
    accepted: "Accepted",
    confirmed: "Confirmed",
    declined: "Declined",
    rejected: "Rejected",
    cancelled: "Cancelled",
    "checked-in": "Checked In",
    "checked-out": "Checked Out",
    completed: "Completed",
  };

  return (
    labels[normalized] ||
    normalized
      .replace(
        /-/g,
        " "
      )
      .replace(
        /\b\w/g,
        (letter) =>
          letter.toUpperCase()
      )
  );
}

/* ============================================================
   NORMALIZED SERVER DATA
============================================================ */

const analyticsTotalBookings =
  safeNumber(
    totalBookings
  );

const analyticsTotalUsers =
  safeNumber(
    totalUsers
  );

const analyticsPending =
  safeNumber(
    pending
  );

const analyticsAccepted =
  safeNumber(
    accepted
  );

const analyticsConfirmed =
  safeNumber(
    confirmed
  );

const analyticsDeclined =
  safeNumber(
    declined
  );

const analyticsCancelled =
  safeNumber(
    cancelled
  );

const analyticsCheckedIn =
  safeNumber(
    checkedIn
  );

const analyticsCheckedOut =
  safeNumber(
    checkedOut
  );

const analyticsCompleted =
  safeNumber(
    completed
  );

const analyticsRevenue =
  safeNumber(
    revenue
  );

/* ============================================================
   ROOM DATA
============================================================ */

const normalizedRoomBreakdown =
  Array.isArray(
    roomBreakdown
  )
    ? roomBreakdown.map(
        (item) => ({
          name:
            getRoomName(
              item?._id
            ),

          bookings:
            safeNumber(
              item?.bookings
            ),

          revenue:
            safeNumber(
              item?.revenue
            ),
        })
      )
    : [];

/* ============================================================
   RECENT ACTIVITY DATA
============================================================ */

const normalizedRecentActivity =
  Array.isArray(
    recentActivity
  )
    ? recentActivity.map(
        (item) => ({
          id:
            item?._id
              ? String(
                  item._id
                )
              : "",

          user:
            getUserName(
              item
            ),

          email:
            item?.userId &&
            typeof item.userId ===
              "object"
              ? safeText(
                  item.userId.email,
                  ""
                )
              : safeText(
                  item?.email,
                  ""
                ),

          room:
            getRoomName(
              item?.roomDisplayName ||
              item?.room
            ),

          status:
            safeText(
              item?.status,
              "pending"
            )
              .trim()
              .toLowerCase(),

          totalPrice:
            safeNumber(
              item?.totalPrice
            ),

          createdAt:
            item?.createdAt ||
            item?.updatedAt ||
            null,

          updatedAt:
            item?.updatedAt ||
            item?.createdAt ||
            null,
        })
      )
    : [];

/* ============================================================
   STATUS DATA
============================================================ */

const statusRows = [
  {
    key: "pending",
    label: "Pending",
    value: analyticsPending,
  },
  {
    key: "accepted",
    label: "Accepted",
    value: analyticsAccepted,
  },
  {
    key: "confirmed",
    label: "Confirmed",
    value: analyticsConfirmed,
  },
  {
    key: "checked-in",
    label: "Checked In",
    value: analyticsCheckedIn,
  },
  {
    key: "checked-out",
    label: "Checked Out",
    value: analyticsCheckedOut,
  },
  {
    key: "completed",
    label: "Completed",
    value: analyticsCompleted,
  },
  {
    key: "cancelled",
    label: "Cancelled",
    value: analyticsCancelled,
  },
  {
    key: "declined",
    label: "Declined",
    value: analyticsDeclined,
  },
];

const analyticsStatusData = {
  statusRows,
  total:
    analyticsTotalBookings,
};
%>

<!DOCTYPE html>
