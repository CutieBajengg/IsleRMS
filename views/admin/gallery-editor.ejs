    <div
      style="
        padding:24px;
        margin:24px;
        border:1px solid #333;
        border-radius:14px;
        color:#fff;
        background:#0b1113;
        font-family:Arial,sans-serif;
      "
    >

      JavaScript is required to use the immersive
      360° Tour Studio.

    </div>

  </noscript>


</body>
