<%
  /*
   * ============================================================
   * PUFFER ISLE RESORT | IsleRMS
   * views/admin/gallery-editor.ejs
   *
   * IMMERSIVE 360° / STREET VIEW-STYLE TOUR STUDIO
   *
   * This editor is designed around the spatial Gallery model.
   *
   * Supports:
   * - Add 360° panorama
   * - Replace panorama
   * - Rich scene metadata
   * - Camera heading / pitch / FOV
   * - Virtual 3D position
   * - Resort map position
   * - Navigation links
   * - Visual hotspot placement
   * - Information hotspots
   * - Navigation hotspots
   * - Hotspot editing / deletion
   * - Gallery-wide viewer settings
   * - Tour settings
   *
   * Expected server data:
   * - gallery
   * - galleryImages
   * - success
   * - error
   * - csrfToken
   * ============================================================
   */

  const galleryScenes =
    Array.isArray(galleryImages)
      ? galleryImages
      : [];

  const galleryRecord =
    gallery &&
    typeof gallery === "object"
      ? gallery
      : {};

  const gallerySettings =
    galleryRecord &&
    typeof galleryRecord === "object"
      ? galleryRecord
      : {};

  const successMessage =
    typeof success !== "undefined"
      ? String(success || "")
      : "";

  const errorMessage =
    typeof error !== "undefined"
      ? String(error || "")
      : "";

  const adminCsrfToken =
    typeof csrfToken !== "undefined"
      ? String(csrfToken || "")
      : "";

  function getSceneTitle(
    scene,
    index
  ) {
    if (
      scene &&
      scene.title &&
      String(scene.title).trim()
    ) {
      return String(scene.title).trim();
    }

    return (
      "Resort View " +
      (index + 1)
    );
  }

  function isSelected(
    value,
    targetIndex
  ) {
    if (
      value === null ||
      value === undefined ||
      value === ""
    ) {
      return false;
    }

    return Number(value) === targetIndex;
  }

  function isChecked(
    value,
    fallback = false
  ) {
    if (
      value === undefined ||
      value === null
    ) {
      return fallback;
    }

    return (
      value === true ||
      value === "true" ||
      value === 1 ||
      value === "1" ||
      value === "on"
    );
  }

  function safeString(
    value
  ) {
    return String(
      value ?? ""
    ).trim();
  }

  function hasSpatialPosition(
    scene
  ) {
    const position =
      scene?.position || {};

    return [
      position.x,
      position.y,
      position.z,
    ].every(
      (value) =>
        value !== null &&
        value !== undefined &&
        Number.isFinite(
          Number(value)
        )
    );
  }

  function hasMapPosition(
    scene
  ) {
    const mapPosition =
      scene?.mapPosition || {};

    return [
      mapPosition.x,
      mapPosition.y,
    ].every(
      (value) =>
        value !== null &&
        value !== undefined &&
        Number.isFinite(
          Number(value)
        )
    );
  }

  let navigationLinks =
    0;

  let connectedScenes =
    0;

  let hotspotCount =
    0;

  let spatialScenes =
    0;

  let mappedScenes =
    0;

  galleryScenes.forEach(
    function(scene) {

      let connected =
        false;

      [
        scene.left,
        scene.forward,
        scene.right,
        scene.backward,
      ].forEach(
        function(value) {

          if (
            value !== null &&
            value !== undefined &&
            value !== ""
          ) {

            const parsed =
              Number(value);

            if (
              Number.isInteger(
                parsed
              )
            ) {

              navigationLinks += 1;
              connected = true;
            }
          }
        }
      );

      if (
        connected
      ) {
        connectedScenes += 1;
      }

      if (
        Array.isArray(
          scene.hotspots
        )
      ) {

        hotspotCount +=
          scene.hotspots.length;
      }

      if (
        hasSpatialPosition(
          scene
        )
      ) {

        spatialScenes += 1;
      }

      if (
        hasMapPosition(
          scene
        )
      ) {

        mappedScenes += 1;
      }
    }
  );

  /*
   * Send clean scene data to the studio.
   */
  const galleryStudioData =
    galleryScenes.map(
      function(scene, index) {

        return {
          _id:
            scene?._id
              ? String(scene._id)
              : "",

          title:
            safeString(
              scene?.title ||
              ("Resort View " +
                (index + 1))
            ),

          image:
            safeString(
              scene?.image
            ),

          thumbnail:
            safeString(
              scene?.thumbnail ||
              scene?.image
            ),

          slug:
            safeString(
              scene?.slug
            ),

          description:
            safeString(
              scene?.description
            ),

          caption:
            safeString(
              scene?.caption
            ),

          alt:
            safeString(
              scene?.alt
            ),

          category:
            safeString(
              scene?.category ||
              "Resort"
            ),

          location:
            safeString(
              scene?.location
            ),

          tags:
            Array.isArray(
              scene?.tags
            )
              ? scene.tags
                  .map(
                    function(tag) {
                      return safeString(
                        tag
                      );
                    }
                  )
                  .filter(Boolean)
              : [],

          projection:
            safeString(
              scene?.projection ||
              "equirectangular"
            ),

          order:
            Number(
              scene?.order ||
              index + 1
            ),

          left:
            scene?.left ??
            null,

          right:
            scene?.right ??
            null,

          forward:
            scene?.forward ??
            null,

          backward:
            scene?.backward ??
            null,

          heading:
            Number.isFinite(
              Number(
                scene?.heading
              )
            )
              ? Number(
                  scene.heading
                )
              : 0,

          pitch:
            Number.isFinite(
              Number(
                scene?.pitch
              )
            )
              ? Number(
                  scene.pitch
                )
              : 0,

          fov:
            Number.isFinite(
              Number(
                scene?.fov
              )
            )
              ? Number(
                  scene.fov
                )
              : 75,

          northOffset:
            Number.isFinite(
              Number(
                scene?.northOffset
              )
            )
              ? Number(
                  scene.northOffset
                )
              : 0,

          position: {
            x:
              scene?.position?.x ??
              null,

            y:
              scene?.position?.y ??
              null,

            z:
              scene?.position?.z ??
              null,
          },

          mapPosition: {
            x:
              scene?.mapPosition?.x ??
              null,

            y:
              scene?.mapPosition?.y ??
              null,
          },

          active:
            scene?.active !== false,

          featured:
            scene?.featured === true,

          hotspots:
            Array.isArray(
              scene?.hotspots
            )
              ? scene.hotspots.map(
                  function(hotspot) {
                    return {
                      _id:
                        hotspot?._id
                          ? String(
                              hotspot._id
                            )
                          : "",

                      type:
                        safeString(
                          hotspot?.type ||
                          "info"
                        ).toLowerCase(),

                      yaw:
                        Number.isFinite(
                          Number(
                            hotspot?.yaw
                          )
                        )
                          ? Number(
                              hotspot.yaw
                            )
                          : 0,

                      pitch:
                        Number.isFinite(
                          Number(
                            hotspot?.pitch
                          )
                        )
                          ? Number(
                              hotspot.pitch
                            )
                          : 0,

                      title:
                        safeString(
                          hotspot?.title ||
                          "Explore this location"
                        ),

                      label:
                        safeString(
                          hotspot?.label ||
                          hotspot?.title ||
                          "Explore"
                        ),

                      description:
                        safeString(
                          hotspot?.description
                        ),

                      icon:
                        safeString(
                          hotspot?.icon ||
                          "info"
                        ),

                      target:
                        hotspot?.target ??
                        null,

                      targetSceneId:
                        hotspot?.targetSceneId
                          ? String(
                              hotspot.targetSceneId
                            )
                          : null,

                      targetIndex:
                        Number.isInteger(
                          Number(
                            hotspot?.targetIndex
                          )
                        )
                          ? Number(
                              hotspot.targetIndex
                            )
                          : null,

                      action:
                        safeString(
                          hotspot?.action ||
                          "info"
                        ).toLowerCase(),

                      url:
                        safeString(
                          hotspot?.url
                        ),

                      visible:
                        hotspot?.visible !== false,

                      interactive:
                        hotspot?.interactive !== false,

                      scale:
                        Number.isFinite(
                          Number(
                            hotspot?.scale
                          )
                        )
                          ? Number(
                              hotspot.scale
                            )
                          : 1,
                    };
                  }
                )
              : [],
        };
      }
    );

  const galleryStudioJson =
    JSON.stringify(
      galleryStudioData
    ).replace(
      /</g,
      "\\u003c"
    );
%>

<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="color-scheme"
    content="dark"
  >

  <meta
    name="theme-color"
    content="#060a0c"
  >

  <meta
    name="description"
    content="Puffer Isle Resort immersive 360° tour authoring studio."
  >

  <link
    rel="icon"
    type="image/png"
    href="/images/islelogo.png"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <script
    src="https://aframe.io/releases/1.8.0/aframe.min.js"
  ></script>

  <title>
    <%= title || "Street View Studio" %> | Isle RMS
  </title>


  <style>

    /* ============================================================
       ROOT
    ============================================================ */

    :root {

      --studio-bg:
        #06090b;

      --studio-bg-soft:
        #0b1113;

      --studio-panel:
        rgba(
          12,
          19,
          21,
          0.88
        );

      --studio-panel-strong:
        rgba(
          6,
          11,
          13,
          0.97
        );

      --studio-border:
        rgba(
          255,
          255,
          255,
          0.09
        );

      --studio-border-strong:
        rgba(
          255,
          255,
          255,
          0.16
        );

      --studio-text:
        #ffffff;

      --studio-soft:
        rgba(
          255,
          255,
          255,
          0.72
        );

      --studio-muted:
        rgba(
          255,
          255,
          255,
          0.46
        );

      --studio-faint:
        rgba(
          255,
          255,
          255,
          0.27
        );

      --studio-teal:
        #15c4bd;

      --studio-teal-deep:
        #057c7d;

      --studio-gold:
        #ffd700;

      --studio-green:
        #42d883;

      --studio-blue:
        #66aaff;

      --studio-red:
        #ef6666;

      --studio-orange:
        #f2a44d;

      --studio-radius-xl:
        28px;

      --studio-radius-lg:
        21px;

      --studio-radius-md:
        15px;

      --studio-radius-sm:
        11px;

      --studio-shadow:
        0 28px 90px
        rgba(
          0,
          0,
          0,
          0.43
        );

      --studio-shadow-soft:
        0 14px 40px
        rgba(
          0,
          0,
          0,
          0.27
        );

      --studio-transition:
        220ms
        cubic-bezier(
          0.2,
          0.7,
          0.2,
          1
        );
    }


    /* ============================================================
       RESET
    ============================================================ */

    *,
    *::before,
    *::after {
      box-sizing:
        border-box;
    }


    html {
      scroll-behavior:
        smooth;
    }


    body {

      margin:
        0;

      min-height:
        100vh;

      overflow-x:
        hidden;

      color:
        var(--studio-text);

      background:
        radial-gradient(
          circle at 10% 0%,
          rgba(
            21,
            196,
            189,
            0.11
          ),
          transparent 32%
        ),
        radial-gradient(
          circle at 90% 10%,
          rgba(
            255,
            215,
            0,
            0.08
          ),
          transparent 27%
        ),
        linear-gradient(
          180deg,
          #080c0e 0%,
          #050708 100%
        );

      font-family:
        "Poppins",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }


    body::before {

      content:
        "";

      position:
        fixed;

      inset:
        0;

      pointer-events:
        none;

      opacity:
        0.15;

      background-image:
        linear-gradient(
          rgba(
            255,
            255,
            255,
            0.03
          ) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(
            255,
            255,
            255,
            0.03
          ) 1px,
          transparent 1px
        );

      background-size:
        52px 52px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 90%
        );
    }


    h1,
    h2,
    h3,
    h4,
    p {
      margin:
        0;
    }


    button,
    input,
    select,
    textarea {
      font:
        inherit;
    }


    button,
    a,
    input,
    select,
    textarea {
      -webkit-tap-highlight-color:
        transparent;
    }


    ::selection {

      background:
        rgba(
          255,
          215,
          0,
          0.20
        );

      color:
        #fff;
    }


    :focus-visible {

      outline:
        2px solid
        var(--studio-gold);

      outline-offset:
        3px;
    }


    ::-webkit-scrollbar {
      width:
        10px;
    }


    ::-webkit-scrollbar-track {
      background:
        #050708;
    }


    ::-webkit-scrollbar-thumb {

      border-radius:
        999px;

      background:
        linear-gradient(
          180deg,
          var(--studio-teal),
          var(--studio-teal-deep)
        );
    }


    /* ============================================================
       MAIN
    ============================================================ */

    .studio-page {

      position:
        relative;

      width:
        min(
          1560px,
          calc(
            100% -
            34px
          )
        );

      margin:
        0 auto;

      padding:
        116px
        0
        60px;
    }


    /* ============================================================
       HEADER
    ============================================================ */

    .studio-header {

      display:
        flex;

      align-items:
        flex-end;

      justify-content:
        space-between;

      gap:
        24px;

      margin-bottom:
        19px;
    }


    .studio-header-copy {

      min-width:
        0;
    }


    .studio-eyebrow {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        9px;

      margin-bottom:
        9px;

      color:
        var(--studio-gold);

      font-size:
        0.68rem;

      font-weight:
        800;

      letter-spacing:
        0.17em;

      text-transform:
        uppercase;
    }


    .studio-eyebrow::before {

      content:
        "";

      width:
        25px;

      height:
        2px;

      border-radius:
        999px;

      background:
        linear-gradient(
          90deg,
          var(--studio-teal),
          var(--studio-gold)
        );
    }


    .studio-header h1 {

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(
          2.35rem,
          4vw,
          4rem
        );

      line-height:
        0.96;

      letter-spacing:
        -0.045em;
    }


    .studio-header h1 span {
      color:
        var(--studio-teal);
    }


    .studio-header p {

      max-width:
        880px;

      margin-top:
        12px;

      color:
        var(--studio-muted);

      font-size:
        0.83rem;

      line-height:
        1.8;
    }


    .studio-header-actions {

      display:
        flex;

      align-items:
        center;

      justify-content:
        flex-end;

      gap:
        9px;

      flex-wrap:
        wrap;
    }


    /* ============================================================
       BUTTONS
    ============================================================ */

    .btn {

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        8px;

      min-height:
        43px;

      padding:
        0 14px;

      border:
        1px solid
        transparent;

      border-radius:
        12px;

      cursor:
        pointer;

      color:
        #fff;

      text-decoration:
        none;

      white-space:
        nowrap;

      font-size:
        0.68rem;

      font-weight:
        800;

      transition:
        transform
        var(--studio-transition),

        border-color
        var(--studio-transition),

        background
        var(--studio-transition),

        box-shadow
        var(--studio-transition),

        opacity
        var(--studio-transition);
    }


    .btn:hover {
      transform:
        translateY(-1px);
    }


    .btn:active {
      transform:
        translateY(0)
        scale(
          0.985
        );
    }


    .btn:disabled {

      opacity:
        0.48;

      cursor:
        not-allowed;

      transform:
        none;
    }


    .btn-primary {

      color:
        #041112;

      background:
        linear-gradient(
          135deg,
          #30d9d3,
          var(--studio-teal)
        );

      box-shadow:
        0
        12px
        32px
        rgba(
          21,
          196,
          189,
          0.16
        );
    }


    .btn-gold {

      color:
        #0c0b02;

      background:
        linear-gradient(
          135deg,
          #ffe977,
          var(--studio-gold)
        );

      box-shadow:
        0
        12px
        32px
        rgba(
          255,
          215,
          0,
          0.13
        );
    }


    .btn-secondary {

      border-color:
        var(--studio-border-strong);

      background:
        rgba(
          255,
          255,
          255,
          0.035
        );
    }


    .btn-danger {

      background:
        linear-gradient(
          135deg,
          #c84d4d,
          #872b2b
        );

      box-shadow:
        0
        12px
        30px
        rgba(
          239,
          102,
          102,
          0.12
        );
    }


    .btn-small {

      min-height:
        37px;

      padding:
        0 11px;

      font-size:
        0.62rem;
    }


    .btn-ghost {

      border-color:
        rgba(
          255,
          255,
          255,
          0.08
        );

      background:
        rgba(
          255,
          255,
          255,
          0.018
        );

      color:
        var(--studio-soft);
    }


    .btn.is-active {

      border-color:
        rgba(
          255,
          215,
          0,
          0.35
        );

      background:
        rgba(
          255,
          215,
          0,
          0.10
        );

      color:
        var(--studio-gold);
    }


    /* ============================================================
       NOTICES
    ============================================================ */

    .notice {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        10px;

      margin-bottom:
        16px;

      padding:
        13px 15px;

      border:
        1px solid
        rgba(
          66,
          216,
          131,
          0.20
        );

      border-radius:
        14px;

      background:
        rgba(
          66,
          216,
          131,
          0.08
        );

      color:
        #96f1bb;

      font-size:
        0.70rem;

      font-weight:
        700;

      line-height:
        1.5;
    }


    .notice.error {

      border-color:
        rgba(
          239,
          102,
          102,
          0.20
        );

      background:
        rgba(
          239,
          102,
          102,
          0.08
        );

      color:
        #ffaaaa;
    }


    /* ============================================================
       METRICS
    ============================================================ */

    .metric-grid {

      display:
        grid;

      grid-template-columns:
        repeat(
          5,
          minmax(
            0,
            1fr
          )
        );

      gap:
        13px;

      margin-bottom:
        18px;
    }


    .metric-card {

      position:
        relative;

      overflow:
        hidden;

      min-height:
        122px;

      padding:
        17px;

      border:
        1px solid
        var(--studio-border);

      border-radius:
        18px;

      background:
        linear-gradient(
          145deg,
          rgba(
            18,
            27,
            29,
            0.92
          ),
          rgba(
            8,
            14,
            16,
            0.84
          )
        );

      box-shadow:
        var(--studio-shadow-soft);

      backdrop-filter:
        blur(
          18px
        );
    }


    .metric-card::after {

      content:
        "";

      position:
        absolute;

      right:
        -45px;

      bottom:
        -64px;

      width:
        120px;

      height:
        120px;

      border-radius:
        50%;

      background:
        rgba(
          21,
          196,
          189,
          0.10
        );

      filter:
        blur(
          7px
        );

      pointer-events:
        none;
    }


    .metric-top {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;
    }


    .metric-label {

      color:
        var(--studio-muted);

      font-size:
        0.60rem;

      font-weight:
        800;

      letter-spacing:
        0.10em;

      text-transform:
        uppercase;
    }


    .metric-icon {

      display:
        grid;

      place-items:
        center;

      width:
        36px;

      height:
        36px;

      border:
        1px solid
        rgba(
          21,
          196,
          189,
          0.23
        );

      border-radius:
        11px;

      background:
        rgba(
          21,
          196,
          189,
          0.10
        );

      color:
        var(--studio-teal);

      font-size:
        0.88rem;
    }


    .metric-value {

      display:
        block;

      margin-top:
        12px;

      font-size:
        1.70rem;

      font-weight:
        800;

      line-height:
        1;

      letter-spacing:
        -0.05em;
    }


    .metric-note {

      display:
        block;

      margin-top:
        5px;

      color:
        var(--studio-muted);

      font-size:
        0.58rem;
    }


    /* ============================================================
       WORKSPACE
    ============================================================ */

    .workspace {

      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1.55fr
        )
        minmax(
          340px,
          0.72fr
        );

      gap:
        16px;

      margin-bottom:
        18px;
    }


    .workspace-card {

      overflow:
        hidden;

      border:
        1px solid
        var(--studio-border);

      border-radius:
        24px;

      background:
        linear-gradient(
          145deg,
          rgba(
            15,
            23,
            25,
            0.93
          ),
          rgba(
            7,
            12,
            14,
            0.94
          )
        );

      box-shadow:
        var(--studio-shadow);

      backdrop-filter:
        blur(
          22px
        );
    }


    /* ============================================================
       WORKSPACE LEFT
    ============================================================ */

    .workspace-viewer {

      position:
        relative;

      min-height:
        620px;

      background:
        #000;

      isolation:
        isolate;
    }


    .workspace-bar {

      position:
        absolute;

      top:
        13px;

      right:
        13px;

      left:
        13px;

      z-index:
        40;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      pointer-events:
        none;
    }


    .workspace-title {

      min-width:
        0;

      max-width:
        55%;

      padding:
        9px 12px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.13
        );

      border-radius:
        999px;

      background:
        rgba(
          4,
          10,
          11,
          0.70
        );

      color:
        #fff;

      backdrop-filter:
        blur(
          18px
        );

      pointer-events:
        none;
    }


    .workspace-title strong {

      display:
        block;

      overflow:
        hidden;

      white-space:
        nowrap;

      text-overflow:
        ellipsis;

      font-size:
        0.72rem;
    }


    .workspace-title span {

      display:
        block;

      margin-top:
        1px;

      color:
        rgba(
          255,
          255,
          255,
          0.48
        );

      font-size:
        0.55rem;
    }


    .workspace-actions {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      pointer-events:
        auto;
    }


    .studio-icon {

      width:
        40px;

      height:
        40px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.16
        );

      border-radius:
        50%;

      background:
        rgba(
          4,
          10,
          11,
          0.70
        );

      color:
        #fff;

      cursor:
        pointer;

      backdrop-filter:
        blur(
          15px
        );

      transition:
        transform
        var(--studio-transition),

        border-color
        var(--studio-transition),

        background
        var(--studio-transition);
    }


    .studio-icon:hover {

      transform:
        translateY(
          -1px
        );

      border-color:
        rgba(
          255,
          215,
          0,
          0.35
        );

      background:
        rgba(
          0,
          0,
          0,
          0.82
        );
    }


    .workspace-viewer a-scene {

      position:
        absolute !important;

      inset:
        0 !important;

      z-index:
        1;

      width:
        100% !important;

      height:
        100% !important;

      display:
        block !important;

      background:
        #000;
    }


    .workspace-viewer canvas {

      display:
        block;

      width:
        100% !important;

      height:
        100% !important;

      cursor:
        grab;

      touch-action:
        none;
    }


    .workspace-viewer canvas:active {
      cursor:
        grabbing;
    }


    .workspace-viewer::after {

      content:
        "";

      position:
        absolute;

      inset:
        0;

      z-index:
        8;

      pointer-events:
        none;

      background:
        radial-gradient(
          circle at center,
          transparent 50%,
          rgba(
            0,
            0,
            0,
            0.16
          )
        );
    }


    .studio-hint {

      position:
        absolute;

      left:
        50%;

      bottom:
        66px;

      z-index:
        31;

      max-width:
        min(
          520px,
          calc(
            100% -
            34px
          )
        );

      transform:
        translateX(
          -50%
        );

      padding:
        9px 13px;

      border:
        1px solid
        rgba(
          255,
          215,
          0,
          0.20
        );

      border-radius:
        999px;

      background:
        rgba(
          7,
          12,
          13,
          0.72
        );

      color:
        rgba(
          255,
          255,
          255,
          0.78
        );

      font-size:
        0.60rem;

      font-weight:
        700;

      text-align:
        center;

      backdrop-filter:
        blur(
          14px
        );

      pointer-events:
        none;

      opacity:
        0;

      transition:
        opacity
        240ms
        ease;
    }


    .studio-hint.is-visible {
      opacity:
        1;
    }


    .placing-hotspot .studio-hint {

      opacity:
        1;

      border-color:
        rgba(
          21,
          196,
          189,
          0.35
        );

      color:
        #c9fffb;
    }


    .workspace-bottom {

      position:
        absolute;

      right:
        13px;

      bottom:
        13px;

      left:
        13px;

      z-index:
        32;

      display:
        flex;

      align-items:
        flex-end;

      justify-content:
        space-between;

      gap:
        10px;

      pointer-events:
        none;
    }


    .workspace-camera-status {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      padding:
        8px 10px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.10
        );

      border-radius:
        999px;

      background:
        rgba(
          5,
          10,
          11,
          0.63
        );

      color:
        rgba(
          255,
          255,
          255,
          0.70
        );

      font-size:
        0.57rem;

      backdrop-filter:
        blur(
          14px
        );
    }


    .workspace-camera-status strong {
      color:
        #fff;
    }


    .workspace-footer-actions {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      pointer-events:
        auto;
    }


    /* ============================================================
       WORKSPACE RIGHT
    ============================================================ */

    .workspace-panel {

      display:
        flex;

      flex-direction:
        column;

      min-height:
        620px;
    }


    .panel-head {

      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        14px;

      padding:
        19px;

      border-bottom:
        1px solid
        var(--studio-border);
    }


    .panel-kicker {

      color:
        var(--studio-teal);

      font-size:
        0.58rem;

      font-weight:
        800;

      letter-spacing:
        0.12em;

      text-transform:
        uppercase;
    }


    .panel-head h2 {

      margin-top:
        5px;

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        1.45rem;

      line-height:
        1.08;
    }


    .panel-head p {

      margin-top:
        6px;

      color:
        var(--studio-muted);

      font-size:
        0.63rem;

      line-height:
        1.6;
    }


    .panel-body {

      flex:
        1;

      overflow:
        auto;

      padding:
        17px;
    }


    /* ============================================================
       STUDIO SECTIONS
    ============================================================ */

    .studio-section {

      margin-bottom:
        16px;

      padding:
        14px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.075
        );

      border-radius:
        16px;

      background:
        rgba(
          255,
          255,
          255,
          0.018
        );
    }


    .studio-section:last-child {
      margin-bottom:
        0;
    }


    .section-heading {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      margin-bottom:
        11px;
    }


    .section-heading strong {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      color:
        #fff;

      font-size:
        0.67rem;

      font-weight:
        800;
    }


    .section-heading strong i {
      color:
        var(--studio-teal);
    }


    .section-heading span {

      color:
        var(--studio-muted);

      font-size:
        0.55rem;
    }


    /* ============================================================
       FORMS
    ============================================================ */

    .field-grid {

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        9px;
    }


    .field-grid.single {
      grid-template-columns:
        1fr;
    }


    .field {

      display:
        flex;

      flex-direction:
        column;

      gap:
        6px;

      min-width:
        0;
    }


    .field-label {

      color:
        var(--studio-soft);

      font-size:
        0.60rem;

      font-weight:
        800;
    }


    .field-note {

      color:
        var(--studio-muted);

      font-size:
        0.53rem;

      line-height:
        1.45;
    }


    .field input,
    .field select,
    .field textarea {

      width:
        100%;

      min-height:
        40px;

      padding:
        9px 10px;

      border:
        1px solid
        var(--studio-border);

      border-radius:
        10px;

      outline:
        none;

      background:
        rgba(
          255,
          255,
          255,
          0.03
        );

      color:
        #fff;

      transition:
        border-color
        var(--studio-transition),

        background
        var(--studio-transition),

        box-shadow
        var(--studio-transition);
    }


    .field textarea {

      min-height:
        76px;

      resize:
        vertical;

      line-height:
        1.55;
    }


    .field input::placeholder,
    .field textarea::placeholder {
      color:
        rgba(
          255,
          255,
          255,
          0.27
        );
    }


    .field input:focus,
    .field select:focus,
    .field textarea:focus {

      border-color:
        rgba(
          21,
          196,
          189,
          0.55
        );

      background:
        rgba(
          21,
          196,
          189,
          0.045
        );

      box-shadow:
        0
        0
        0
        4px
        rgba(
          21,
          196,
          189,
          0.08
        );
    }


    .field select option {

      background:
        #101618;

      color:
        #fff;
    }


    .field input[type="file"] {
      padding:
        6px;
    }


    .field input[type="file"]::file-selector-button {

      margin-right:
        7px;

      padding:
        6px 9px;

      border:
        0;

      border-radius:
        7px;

      background:
        rgba(
          255,
          255,
          255,
          0.08
        );

      color:
        #fff;

      cursor:
        pointer;
    }


    /* ============================================================
       RANGE
    ============================================================ */

    .range-row {

      display:
        grid;

      grid-template-columns:
        minmax(
          0,
          1fr
        )
        58px;

      gap:
        9px;

      align-items:
        center;
    }


    .range-value {

      min-height:
        38px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        var(--studio-border);

      border-radius:
        10px;

      background:
        rgba(
          255,
          255,
          255,
          0.025
        );

      color:
        var(--studio-gold);

      font-size:
        0.60rem;

      font-weight:
        800;
    }


    input[type="range"] {

      width:
        100%;

      min-height:
        auto;

      padding:
        0;

      border:
        0;

      outline:
        none;

      background:
        transparent;

      box-shadow:
        none;
    }


    input[type="range"]:focus {

      border:
        0;

      box-shadow:
        none;
    }


    input[type="range"]::-webkit-slider-runnable-track {

      height:
        4px;

      border-radius:
        999px;

      background:
        rgba(
          255,
          255,
          255,
          0.10
        );
    }


    input[type="range"]::-webkit-slider-thumb {

      appearance:
        none;

      width:
        15px;

      height:
        15px;

      margin-top:
        -5px;

      border:
        2px solid
        #071011;

      border-radius:
        50%;

      background:
        var(--studio-teal);

      cursor:
        pointer;

      box-shadow:
        0
        0
        0
        4px
        rgba(
          21,
          196,
          189,
          0.11
        );
    }


    input[type="range"]::-moz-range-track {

      height:
        4px;

      border-radius:
        999px;

      background:
        rgba(
          255,
          255,
          255,
          0.10
        );
    }


    input[type="range"]::-moz-range-thumb {

      width:
        15px;

      height:
        15px;

      border:
        2px solid
        #071011;

      border-radius:
        50%;

      background:
        var(--studio-teal);

      cursor:
        pointer;
    }


    /* ============================================================
       TOGGLE
    ============================================================ */

    .toggle-row {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        12px;

      padding:
        9px
        10px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.055
        );

      border-radius:
        11px;

      background:
        rgba(
          255,
          255,
          255,
          0.016
        );
    }


    .toggle-copy strong {

      display:
        block;

      color:
        #fff;

      font-size:
        0.60rem;
    }


    .toggle-copy span {

      display:
        block;

      margin-top:
        2px;

      color:
        var(--studio-muted);

      font-size:
        0.51rem;
    }


    .toggle {

      position:
        relative;

      width:
        42px;

      height:
        23px;

      flex:
        0 0 42px;
    }


    .toggle input {

      position:
        absolute;

      width:
        1px;

      height:
        1px;

      opacity:
        0;
    }


    .toggle-track {

      position:
        absolute;

      inset:
        0;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.14
        );

      border-radius:
        999px;

      background:
        rgba(
          255,
          255,
          255,
          0.07
        );

      cursor:
        pointer;

      transition:
        all
        180ms
        ease;
    }


    .toggle-track::after {

      content:
        "";

      position:
        absolute;

      top:
        3px;

      left:
        3px;

      width:
        15px;

      height:
        15px;

      border-radius:
        50%;

      background:
        rgba(
          255,
          255,
          255,
          0.73
        );

      transition:
        transform
        180ms
        ease,

        background
        180ms
        ease;
    }


    .toggle input:checked
    + .toggle-track {

      border-color:
        rgba(
          21,
          196,
          189,
          0.45
        );

      background:
        rgba(
          21,
          196,
          189,
          0.18
        );
    }


    .toggle input:checked
    + .toggle-track::after {

      transform:
        translateX(
          18px
        );

      background:
        var(--studio-teal);
    }


    /* ============================================================
       CAMERA ACTIONS
    ============================================================ */

    .camera-actions {

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        7px;

      margin-top:
        10px;
    }


    /* ============================================================
       HOTSPOT LIST
    ============================================================ */

    .hotspot-list {

      display:
        grid;

      gap:
        7px;
    }


    .hotspot-empty {

      padding:
        13px;

      border:
        1px dashed
        rgba(
          255,
          255,
          255,
          0.13
        );

      border-radius:
        12px;

      color:
        var(--studio-muted);

      font-size:
        0.55rem;

      line-height:
        1.5;

      text-align:
        center;
    }


    .hotspot-item {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

      padding:
        9px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.07
        );

      border-radius:
        11px;

      background:
        rgba(
          255,
          255,
          255,
          0.018
        );

      cursor:
        pointer;

      transition:
        all
        180ms
        ease;
    }


    .hotspot-item:hover {

      border-color:
        rgba(
          21,
          196,
          189,
          0.28
        );

      background:
        rgba(
          21,
          196,
          189,
          0.045
        );
    }


    .hotspot-item.is-selected {

      border-color:
        rgba(
          255,
          215,
          0,
          0.32
        );

      background:
        rgba(
          255,
          215,
          0,
          0.06
        );
    }


    .hotspot-dot {

      width:
        28px;

      height:
        28px;

      flex:
        0 0 28px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        50%;

      background:
        rgba(
          21,
          196,
          189,
          0.13
        );

      color:
        var(--studio-teal);

      font-size:
        0.60rem;
    }


    .hotspot-dot.navigation {

      background:
        rgba(
          255,
          215,
          0,
          0.11
        );

      color:
        var(--studio-gold);
    }


    .hotspot-copy {

      min-width:
        0;

      flex:
        1;
    }


    .hotspot-copy strong {

      display:
        block;

      overflow:
        hidden;

      white-space:
        nowrap;

      text-overflow:
        ellipsis;

      color:
        #fff;

      font-size:
        0.58rem;
    }


    .hotspot-copy span {

      display:
        block;

      margin-top:
        2px;

      color:
        var(--studio-muted);

      font-size:
        0.49rem;
    }


    .hotspot-delete {

      width:
        28px;

      height:
        28px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        rgba(
          239,
          102,
          102,
          0.18
        );

      border-radius:
        8px;

      background:
        rgba(
          239,
          102,
          102,
          0.06
        );

      color:
        #ff9a9a;

      cursor:
        pointer;
    }


    /* ============================================================
       MAP PAD
    ============================================================ */

    .map-editor {

      position:
        relative;

      width:
        100%;

      aspect-ratio:
        16 / 10;

      overflow:
        hidden;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.08
        );

      border-radius:
        14px;

      background:
        linear-gradient(
          180deg,
          rgba(
            21,
            196,
            189,
            0.05
          ),
          rgba(
            255,
            255,
            255,
            0.02
          )
        );

      cursor:
        crosshair;
    }


    .map-editor-grid {

      position:
        absolute;

      inset:
        0;

      background-image:
        linear-gradient(
          rgba(
            255,
            255,
            255,
            0.045
          ) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(
            255,
            255,
            255,
            0.045
          ) 1px,
          transparent 1px
        );

      background-size:
        25% 25%;
    }


    .map-axis-x {

      position:
        absolute;

      right:
        10px;

      bottom:
        7px;

      left:
        10px;

      height:
        1px;

      background:
        rgba(
          255,
          255,
          255,
          0.10
        );
    }


    .map-axis-y {

      position:
        absolute;

      top:
        7px;

      bottom:
        7px;

      left:
        50%;

      width:
        1px;

      background:
        rgba(
          255,
          255,
          255,
          0.10
        );
    }


    .map-center {

      position:
        absolute;

      left:
        50%;

      top:
        50%;

      width:
        7px;

      height:
        7px;

      transform:
        translate(
          -50%,
          -50%
        );

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.55
        );

      border-radius:
        50%;
    }


    .map-scene-pin {

      position:
        absolute;

      width:
        26px;

      height:
        26px;

      transform:
        translate(
