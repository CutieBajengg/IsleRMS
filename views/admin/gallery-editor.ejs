    function updateStudioMapPin() {

      const x =
        clamp(
          toNumber(
            studioMapX?.value,
            0.5
          ),
          0,
          1
        );

      const y =
        clamp(
          toNumber(
            studioMapY?.value,
            0.5
          ),
          0,
          1
        );


      if (
        studioMapPin
      ) {

        studioMapPin.style.left =
          `${x * 100}%`;

        studioMapPin.style.top =
          `${y * 100}%`;

        studioMapPin.textContent =
          validSceneIndex(
            studioSceneIndex
          )
            ? String(
                studioSceneIndex + 1
              )
            : "•";
      }
    }


    studioMapX?.addEventListener(
      "input",
      () => {

        updateStudioMapPin();

        markStudioDirty();
      }
    );


    studioMapY?.addEventListener(
      "input",
      () => {

        updateStudioMapPin();

        markStudioDirty();
      }
    );


    studioMapEditor?.addEventListener(
      "click",
      event => {

        const rect =
          studioMapEditor.getBoundingClientRect();


        if (
          !rect.width ||
          !rect.height
        ) {

          return;
        }


        const x =
          clamp(
            (
              event.clientX -
              rect.left
            ) /
            rect.width,
            0,
            1
          );


        const y =
          clamp(
            (
              event.clientY -
              rect.top
            ) /
            rect.height,
            0,
            1
          );


        studioMapX.value =
          x.toFixed(
            3
          );

        studioMapY.value =
          y.toFixed(
            3
          );


        updateStudioMapPin();

        markStudioDirty(
          "Map position updated."
        );
      }
    );


    /* ============================================================
       SAVE STUDIO INTO ORIGINAL FORM
    ============================================================ */

    function getStudioForm(
      index
    ) {

      return document.querySelector(
        `.scene-editor-form[data-scene-form="${index}"]`
      );
    }


    function setFieldValue(
      form,
      name,
      value
    ) {

      const field =
        form?.querySelector(
          `[name="${name}"]`
        );

      if (
        field
      ) {

        field.value =
          value ?? "";
      }
    }


    function prepareSceneForm(
      form
    ) {

      if (
        !form
      ) {

        return;
      }


      form.querySelectorAll(
        "[data-scene-bool]"
      ).forEach(
        checkbox => {

          const name =
            checkbox.dataset
              .sceneBool;

          const hidden =
            form.querySelector(
              `[data-bool-hidden="${name}"]`
            );

          if (
            hidden
          ) {

            hidden.value =
              checkbox.checked
                ? "true"
                : "false";
          }

        }
      );


      const position = {

        x:
          studioPositionX.value ===
            ""
            ? null
            : toNumber(
                studioPositionX.value,
                null
              ),

        y:
          studioPositionY.value ===
            ""
            ? null
            : toNumber(
                studioPositionY.value,
                null
              ),

        z:
          studioPositionZ.value ===
            ""
            ? null
            : toNumber(
                studioPositionZ.value,
                null
              ),

      };


      const mapPosition = {

        x:
          studioMapX.value ===
            ""
            ? null
            : clamp(
                toNumber(
                  studioMapX.value,
                  0
                ),
                0,
                1
              ),

        y:
          studioMapY.value ===
            ""
            ? null
            : clamp(
                toNumber(
                  studioMapY.value,
                  0
                ),
                0,
                1
              ),

      };


      setFieldValue(
        form,
        "title",
        studioTitle.value.trim()
      );


      setFieldValue(
        form,
        "slug",
        normalizeSlug(
          studioSlug.value,
          studioTitle.value
        )
      );


      setFieldValue(
        form,
        "description",
        studioDescription.value.trim()
      );


      setFieldValue(
        form,
        "category",
        studioCategory.value.trim() ||
          "Resort"
      );


      setFieldValue(
        form,
        "location",
        studioLocation.value.trim()
      );


      setFieldValue(
        form,
        "tags",
        studioTags.value.trim()
      );


      const currentPose = {

        heading:
          clamp(
            toNumber(
              getStudioYaw(),
              0
            ),
            -360,
            360
          ),

        pitch:
          clamp(
            toNumber(
              getStudioPitch(),
              0
            ),
            -89,
            89
          ),

        fov:
          clamp(
            toNumber(
              getStudioFov(),
              75
            ),
            30,
            110
          ),

      };


      setFieldValue(
        form,
        "heading",
        currentPose.heading
      );


      setFieldValue(
        form,
        "pitch",
        currentPose.pitch
      );


      setFieldValue(
        form,
        "fov",
        currentPose.fov
      );


      setFieldValue(
        form,
        "northOffset",
        clamp(
          toNumber(
            studioNorthOffset.value,
            0
          ),
          -360,
          360
        )
      );


      setFieldValue(
        form,
        "positionJson",
        JSON.stringify(
          position
        )
      );


      setFieldValue(
        form,
        "mapPositionJson",
        JSON.stringify(
          mapPosition
        )
      );


      const scene =
        scenes[
          studioSceneIndex
        ];


      setFieldValue(
        form,
        "hotspotsJson",
        JSON.stringify(
          Array.isArray(
            scene?.hotspots
          )
            ? scene.hotspots
            : []
        )
      );


      return {
        position,
        mapPosition,
        currentPose,
      };
    }


    function getStudioYaw() {

      return getCameraYaw(
        studioCamera
      );
    }


    function getStudioPitch() {

      return getCameraPitch(
        studioCamera
      );
    }


    function getStudioFov() {

      return getCameraFov(
        studioCamera
      );
    }


    saveStudioBtn?.addEventListener(
      "click",
      () => {

        if (
          !validSceneIndex(
            studioSceneIndex
          )
        ) {

          return;
        }


        const form =
          getStudioForm(
            studioSceneIndex
          );


        if (
          !form
        ) {

          window.alert(
            "The scene form could not be found."
          );

          return;
        }


        prepareSceneForm(
          form
        );


        clearStudioDirty();


        saveStudioBtn.disabled =
          true;

        saveStudioBtn.innerHTML =
          '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';


        form.submit();

      }
    );


    /* ============================================================
       FORM PREPARATION
    ============================================================ */

    document
      .querySelectorAll(
        ".scene-editor-form"
      )
      .forEach(
        form => {

          form.addEventListener(
            "submit",
            () => {

              if (
                validSceneIndex(
                  Number(
                    form.dataset.sceneForm
                  )
                )
              ) {

                const sceneIndex =
                  Number(
                    form.dataset.sceneForm
                  );


                const scene =
                  scenes[
                    sceneIndex
                  ];


                form.querySelectorAll(
                  "[data-scene-bool]"
                ).forEach(
                  checkbox => {

                    const name =
                      checkbox.dataset
                        .sceneBool;

                    const hidden =
                      form.querySelector(
                        `[data-bool-hidden="${name}"]`
                      );

                    if (
                      hidden
                    ) {

                      hidden.value =
                        checkbox.checked
                          ? "true"
                          : "false";
                    }

                  }
                );


                const positionInputs =
                  form.querySelectorAll(
                    "[data-position-input]"
                  );


                const position = {

                  x:
                    null,

                  y:
                    null,

                  z:
                    null,

                };


                positionInputs.forEach(
                  input => {

                    const axis =
                      input.dataset
                        .positionInput;

                    if (
                      axis &&
                      Object.prototype.hasOwnProperty.call(
                        position,
                        axis
                      )
                    ) {

                      position[
                        axis
                      ] =
                        input.value ===
                          ""
                          ? null
                          : toNumber(
                              input.value,
                              null
                            );
                    }

                  }
                );


                const posField =
                  form.querySelector(
                    '[name="positionJson"]'
                  );


                if (
                  posField
                ) {

                  posField.value =
                    JSON.stringify(
                      position
                    );
                }


                if (
                  scene &&
                  Array.isArray(
                    scene.hotspots
                  )
                ) {

                  const hotspotField =
                    form.querySelector(
                      '[name="hotspotsJson"]'
                    );

                  if (
                    hotspotField
                  ) {

                    hotspotField.value =
                      JSON.stringify(
                        scene.hotspots
                      );
                  }

                }

              }

            }
          );

        }
      );


    /* ============================================================
       PUBLIC PREVIEW
    ============================================================ */

    function openPublicScene(
      index
    ) {

      if (
        !validSceneIndex(
          index
        )
      ) {

        return;
      }


      window.open(
        `/gallery?scene=${index + 1}`,
        "_blank",
        "noopener,noreferrer"
      );
    }


    document
      .querySelectorAll(
        "[data-public-scene]"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              openPublicScene(
                Number(
                  button.dataset.publicScene
                )
              );

            }
          );

        }
      );


    quickPublicBtn?.addEventListener(
      "click",
      () => {

        openPublicScene(
          selectedSceneIndex
        );

      }
    );


    modalPublicPreviewBtn?.addEventListener(
      "click",
      () => {

        openPublicScene(
          studioSceneIndex
        );

      }
    );


    /* ============================================================
       SCENE SELECT
    ============================================================ */

    quickSceneSelect?.addEventListener(
      "change",
      () => {

        const index =
          Number(
            quickSceneSelect.value
          );


        if (
          !validSceneIndex(
            index
          )
        ) {

          return;
        }


        selectedSceneIndex =
          index;


        updateQuickInspector();

        loadWorkspaceScene(
          index
        );

      }
    );


    /* ============================================================
       SCENE NAVIGATION
    ============================================================ */

    function shiftScene(
      amount
    ) {

      if (
        !validSceneIndex(
          selectedSceneIndex
        )
      ) {

        return;
      }


      const nextIndex =
        clamp(
          selectedSceneIndex +
            amount,
          0,
          scenes.length -
            1
        );


      if (
        nextIndex ===
        selectedSceneIndex
      ) {

        return;
      }


      loadWorkspaceScene(
        nextIndex
      );
    }


    workspacePrevBtn?.addEventListener(
      "click",
      () => {

        shiftScene(
          -1
        );

      }
    );


    workspaceNextBtn?.addEventListener(
      "click",
      () => {

        shiftScene(
          1
        );

      }
    );


    openSelectedSceneBtn?.addEventListener(
      "click",
      () => {

        openStudio(
          selectedSceneIndex
        );

      }
    );


    workspaceStudioBtn?.addEventListener(
      "click",
      () => {

        openStudio(
          selectedSceneIndex
        );

      }
    );


    focusFirstSceneBtn?.addEventListener(
      "click",
      () => {

        if (
          scenes.length
        ) {

          selectedSceneIndex =
            0;

          quickSceneSelect.value =
            "0";

          updateQuickInspector();

          loadWorkspaceScene(
            0
          );

        }

      }
    );


    /* ============================================================
       OPEN STUDIO BUTTONS
    ============================================================ */

    document
      .querySelectorAll(
        ".open-studio-btn"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              openStudio(
                Number(
                  button.dataset.sceneIndex
                )
              );

            }
          );

        }
      );


    /* ============================================================
       MODAL CLOSE
    ============================================================ */

    modalCloseBtn?.addEventListener(
      "click",
      () => {

        closeStudio();

      }
    );


    studioModal?.addEventListener(
      "click",
      event => {

        if (
          event.target ===
          studioModal
        ) {

          closeStudio();
        }

      }
    );


    document.addEventListener(
      "keydown",
      event => {

        if (
          event.key ===
          "Escape" &&
          studioModal?.classList.contains(
            "is-open"
          )
        ) {

          closeStudio();

        }

      }
    );


    /* ============================================================
       SETTINGS CHECKBOXES
    ============================================================ */

    const experienceSettingsForm =
      document.getElementById(
        "experienceSettingsForm"
      );


    experienceSettingsForm?.addEventListener(
      "submit",
      () => {

        document
          .querySelectorAll(
            "[data-setting-checkbox]"
          )
          .forEach(
            checkbox => {

              const name =
                checkbox.dataset
                  .settingCheckbox;

              const hidden =
                experienceSettingsForm.querySelector(
                  `[data-setting-hidden="${name}"]`
                );

              if (
                hidden
              ) {

                hidden.value =
                  checkbox.checked
                    ? "true"
                    : "false";
              }

            }
          );

      }
    );


    /* ============================================================
       FILE VALIDATION
    ============================================================ */

    document
      .querySelectorAll(
        'input[type="file"][name="imageFile"]'
      )
      .forEach(
        input => {

          input.addEventListener(
            "change",
            () => {

              const file =
                input.files &&
                input.files[0];


              if (
                !file
              ) {

                return;
              }


              const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp",
              ];


              if (
                !allowedTypes.includes(
                  file.type
                )
              ) {

                window.alert(
                  "Please select a JPG, PNG, or WEBP panorama."
                );

                input.value =
                  "";

                return;
              }


              const maxBytes =
                25 *
                1024 *
                1024;


              if (
                file.size >
                maxBytes
              ) {

                window.alert(
                  "The selected panorama is larger than 25 MB."
                );

                input.value =
                  "";
              }

            }
          );

        }
      );


    /* ============================================================
       INITIAL LOAD
    ============================================================ */

    if (
      scenes.length
    ) {

      quickSceneSelect.value =
        "0";

      selectedSceneIndex =
        0;

      updateQuickInspector();

      loadWorkspaceScene(
        0
      );

    }


    /* ============================================================
       WINDOW EVENTS
    ============================================================ */

    window.addEventListener(
      "resize",
      () => {

        updateWorkspaceCameraHud();

      }
    );


    document.addEventListener(
      "fullscreenchange",
      () => {

        updateWorkspaceCameraHud();

      }
    );


    /* ============================================================
       STUDIO VISIBILITY
    ============================================================ */

    const observer =
      new MutationObserver(
        () => {

          if (
            studioModal?.classList.contains(
              "is-open"
            )
          ) {

            setTimeout(
              () => {

                bindStudioCanvasPointerEvents();

                renderStudioHotspots();

                updateStudioPoseUi();

              },
              80
            );

          }

        }
      );


    if (
      studioModal
    ) {

      observer.observe(
        studioModal,
        {
          attributes:
            true,

          attributeFilter:
            [
              "class",
            ],
        }
      );

    }


    /* ============================================================
       A-FRAME READINESS
    ============================================================ */

    const workspaceScene =
      workspaceCamera?.sceneEl;

    if (
      workspaceScene
    ) {

      if (
        workspaceScene.hasLoaded
      ) {

        loadWorkspaceScene(
          selectedSceneIndex
        );

      } else {

        workspaceScene.addEventListener(
          "loaded",
          () => {

            loadWorkspaceScene(
              selectedSceneIndex
            );

          },
          {
            once:
              true,
          }
        );

      }

    }


    const studioScene =
      studioCamera?.sceneEl;

    if (
      studioScene
    ) {

      if (
        studioScene.hasLoaded
      ) {

        bindStudioCanvasPointerEvents();

      } else {

        studioScene.addEventListener(
          "loaded",
          () => {

            bindStudioCanvasPointerEvents();

          },
          {
            once:
              true,
          }
        );

      }

    }


  </script>


