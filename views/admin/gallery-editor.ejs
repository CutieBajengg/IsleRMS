      padding:
        13px;
    }


    .modal-tabs {

      display:
        grid;

      grid-template-columns:
        repeat(
          3,
          1fr
        );

      gap:
        5px;

      margin-bottom:
        11px;
    }


    .modal-tab {

      min-height:
        35px;

      border:
        1px solid
        var(--studio-border);

      border-radius:
        9px;

      background:
        rgba(
          255,
          255,
          255,
          0.025
        );

      color:
        var(--studio-muted);

      cursor:
        pointer;

      font-size:
        0.54rem;

      font-weight:
        800;
    }


    .modal-tab.is-active {

      border-color:
        rgba(
          21,
          196,
          189,
          0.35
        );

      background:
        rgba(
          21,
          196,
          189,
          0.09
        );

      color:
        var(--studio-teal);
    }


    .modal-tab-panel {
      display:
        none;
    }


    .modal-tab-panel.is-active {
      display:
        block;
    }


    .modal-panel-footer {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        8px;

      padding:
        11px
        13px;

      border-top:
        1px solid
        var(--studio-border);
    }


    .modal-panel-footer span {

      color:
        var(--studio-muted);

      font-size:
        0.49rem;
    }


    /* ============================================================
       DROPZONE
    ============================================================ */

    .dropzone {

      position:
        relative;

      display:
        grid;

      place-items:
        center;

      min-height:
        85px;

      padding:
        12px;

      border:
        1px dashed
        rgba(
          21,
          196,
          189,
          0.25
        );

      border-radius:
        13px;

      background:
        rgba(
          21,
          196,
          189,
          0.035
        );

      text-align:
        center;

      transition:
        border-color
        180ms
        ease,

        background
        180ms
        ease;
    }


    .dropzone:hover {

      border-color:
        rgba(
          21,
          196,
          189,
          0.45
        );

      background:
        rgba(
          21,
          196,
          189,
          0.06
        );
    }


    .dropzone-icon {

      width:
        30px;

      height:
        30px;

      margin:
        0
        auto
        6px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        10px;

      background:
        rgba(
          255,
          255,
          255,
          0.06
        );

      color:
        var(--studio-teal);
    }


    .dropzone strong {

      display:
        block;

      color:
        #fff;

      font-size:
        0.59rem;
    }


    .dropzone span {

      display:
        block;

      margin-top:
        3px;

      color:
        var(--studio-muted);

      font-size:
        0.49rem;
    }


    .dropzone input {

      position:
        absolute;

      inset:
        0;

      width:
        100%;

      height:
        100%;

      opacity:
        0;

      cursor:
        pointer;
    }


    /* ============================================================
       HOTSPOT PLACEMENT STATE
    ============================================================ */

    .hotspot-draft {

      padding:
        10px;

      border:
        1px solid
        rgba(
          255,
          215,
          0,
          0.16
        );

      border-radius:
        12px;

      background:
        rgba(
          255,
          215,
          0,
          0.035
        );
    }


    .hotspot-draft-head {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      margin-bottom:
        8px;
    }


    .hotspot-draft-head strong {

      color:
        var(--studio-gold);

      font-size:
        0.58rem;
    }


    .hotspot-coordinates {

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        7px;

      margin-top:
        8px;
    }


    /* ============================================================
       FOOTER
    ============================================================ */

    .page-footer {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        12px;

      padding:
        13px 16px;

      border:
        1px solid
        var(--studio-border);

      border-radius:
        14px;

      background:
        rgba(
          255,
          255,
          255,
          0.018
        );

      color:
        var(--studio-muted);

      font-size:
        0.53rem;
    }


    .page-footer strong {
      color:
        #fff;
    }


    /* ============================================================
       MOBILE
    ============================================================ */

    @media (
      max-width:
      1250px
    ) {

      .metric-grid {
        grid-template-columns:
          repeat(
            3,
            minmax(
              0,
              1fr
            )
          );
      }

      .workspace {
        grid-template-columns:
          minmax(
            0,
            1.25fr
          )
          minmax(
            330px,
            0.75fr
          );
      }

      .settings-grid {
        grid-template-columns:
          repeat(
            2,
            minmax(
              0,
              1fr
            )
          );
      }

      .advanced-grid {
        grid-template-columns:
          1fr;
      }

      .add-form-grid {
        grid-template-columns:
          1fr
          1fr;
      }

    }


    @media (
      max-width:
      1050px
    ) {

      .workspace {
        grid-template-columns:
          1fr;
      }

      .workspace-viewer,
      .workspace-panel {
        min-height:
          560px;
      }

      .studio-modal-shell {
        grid-template-columns:
          1fr;
      }

      .studio-modal-panel {
        max-height:
          47%;
      }

    }


    @media (
      max-width:
      850px
    ) {

      .studio-page {

        width:
          calc(
            100% -
            20px
          );

        padding-top:
          101px;
      }

      .studio-header {

        align-items:
          flex-start;

        flex-direction:
          column;
      }

      .studio-header-actions {
        justify-content:
          flex-start;
      }

      .metric-grid {
        grid-template-columns:
          repeat(
            2,
            minmax(
              0,
              1fr
            )
          );
      }

      .scene-grid {
        grid-template-columns:
          1fr;
      }

      .settings-grid {
        grid-template-columns:
          1fr;
      }

      .modal-panel-head {
        padding:
          12px;
      }

    }


    @media (
      max-width:
      620px
    ) {

      .studio-page {

        width:
          calc(
            100% -
            14px
          );

        padding:
          93px
          0
          32px;
      }

      .studio-header h1 {
        font-size:
          2.15rem;
      }

      .metric-grid {
        grid-template-columns:
          1fr;
      }

      .add-form-grid {
        grid-template-columns:
          1fr;
      }

      .field-grid {
        grid-template-columns:
          1fr;
      }

      .scene-grid {
        grid-template-columns:
          1fr;
      }

      .workspace-viewer {
        min-height:
          480px;
      }

      .workspace-panel {
        min-height:
          auto;
      }

      .card-actions {
        grid-template-columns:
          1fr
          1fr;
      }

      .card-actions
      .delete-card-form {
        grid-column:
          1 / -1;
      }

      .page-footer {
        align-items:
          flex-start;

        flex-direction:
          column;
      }

      .modal-location {
        max-width:
          48%;
      }

      .studio-modal-shell {
        height:
          96vh;

        border-radius:
          18px;
      }

      .studio-modal-panel {
        max-height:
          49%;
      }

    }


    @media (
      max-width:
      430px
    ) {

      .workspace-viewer {
        min-height:
          400px;
      }

      .workspace-title {
        max-width:
          65%;
      }

      .workspace-actions
      .studio-icon:nth-child(
        n+3
      ) {
        display:
          none;
      }

      .workspace-bottom {
        flex-direction:
          column;

        align-items:
          stretch;
      }

      .workspace-footer-actions {
        justify-content:
          flex-end;
      }

      .studio-modal {
        padding:
          6px;
      }

      .studio-modal-shell {
        height:
          98vh;

        border-radius:
          15px;
      }

      .studio-modal-panel {
        max-height:
          52%;
      }

      .modal-top-actions
      .modal-icon:nth-child(
        n+3
      ) {
        display:
          none;
      }

    }


    @media (
      prefers-reduced-motion:
      reduce
    ) {

      *,
      *::before,
      *::after {

        animation-duration:
          0.01ms !important;

        animation-iteration-count:
          1 !important;

        scroll-behavior:
          auto !important;

        transition-duration:
          0.01ms !important;
      }

    }

  </style>

</head>


<body>


  <!-- ==========================================================
       ADMIN NAVIGATION
  =========================================================== -->

  <%- include("../partials/navadmin") %>


  <main class="studio-page">


    <!-- ========================================================
         HEADER
    ========================================================= -->

    <header class="studio-header">

      <div class="studio-header-copy">

        <div class="studio-eyebrow">
          Puffer Isle Resort · IsleRMS
        </div>

        <h1>
          360°
          <span>Tour Studio</span>
        </h1>

        <p>
          Build a navigable digital version of Puffer Isle.
          Position scenes, tune their starting viewpoints,
          create immersive hotspots, connect destinations,
          and publish the exact experience guests will explore.
        </p>

      </div>


      <div class="studio-header-actions">

        <a
          class="btn btn-secondary"
          href="/admin/gallery-editor"
        >
          <i class="fa-solid fa-rotate-right"></i>
          Refresh
        </a>

        <a
          class="btn btn-secondary"
          href="/gallery"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fa-solid fa-eye"></i>
          Guest View
        </a>

      </div>

    </header>


    <!-- ========================================================
         NOTICES
    ========================================================= -->

    <% if (successMessage) { %>

      <div class="notice">

        <i class="fa-solid fa-circle-check"></i>

        <span>
          <%= successMessage %>
        </span>

      </div>

    <% } %>


    <% if (errorMessage) { %>

      <div class="notice error">

        <i class="fa-solid fa-circle-exclamation"></i>

        <span>
          <%= errorMessage %>
        </span>

      </div>

    <% } %>


    <!-- ========================================================
         METRICS
    ========================================================= -->

    <section
      class="metric-grid"
      aria-label="Tour studio metrics"
    >


      <article class="metric-card">

        <div class="metric-top">

          <span class="metric-label">
            360° Scenes
          </span>

          <span class="metric-icon">
            <i class="fa-solid fa-panorama"></i>
          </span>

        </div>

        <strong class="metric-value">
          <%= galleryScenes.length %>
        </strong>

        <span class="metric-note">
          Published or draft panorama locations
        </span>

      </article>


      <article class="metric-card">

        <div class="metric-top">

          <span class="metric-label">
            Connections
          </span>

          <span class="metric-icon">
            <i class="fa-solid fa-route"></i>
          </span>

        </div>

        <strong class="metric-value">
          <%= navigationLinks %>
        </strong>

        <span class="metric-note">
          Directional scene links
        </span>

      </article>


      <article class="metric-card">

        <div class="metric-top">

          <span class="metric-label">
            Hotspots
          </span>

          <span class="metric-icon">
            <i class="fa-solid fa-location-dot"></i>
          </span>

        </div>

        <strong class="metric-value">
          <%= hotspotCount %>
        </strong>

        <span class="metric-note">
          Interactive points inside scenes
        </span>

      </article>


      <article class="metric-card">

        <div class="metric-top">

          <span class="metric-label">
            Spatial
          </span>

          <span class="metric-icon">
            <i class="fa-solid fa-cubes"></i>
          </span>

        </div>

        <strong class="metric-value">
          <%= spatialScenes %>
        </strong>

        <span class="metric-note">
          Scenes with virtual 3D positions
        </span>

      </article>


      <article class="metric-card">

        <div class="metric-top">

          <span class="metric-label">
            Resort Map
          </span>

          <span class="metric-icon">
            <i class="fa-solid fa-map-location-dot"></i>
          </span>

        </div>

        <strong class="metric-value">
          <%= mappedScenes %>
        </strong>

        <span class="metric-note">
          Scenes positioned on the map
        </span>

      </article>


    </section>


    <!-- ========================================================
         LIVE WORKSPACE
    ========================================================= -->

    <section class="workspace">


      <!-- ======================================================
           VIEWER
      ======================================================= -->

      <div class="workspace-card workspace-viewer">

        <div class="workspace-bar">

          <div class="workspace-title">

            <strong id="workspaceSceneTitle">
              Select a scene
            </strong>

            <span id="workspaceSceneMeta">
              Open a panorama in Studio to begin editing.
            </span>

          </div>


          <div class="workspace-actions">

            <button
              class="studio-icon"
              type="button"
              id="workspaceStudioBtn"
              aria-label="Open selected scene in studio"
              title="Open selected scene in studio"
            >
              <i class="fa-solid fa-crosshairs"></i>
            </button>

          </div>

        </div>


        <a-scene
          embedded
          vr-mode-ui="enabled: false"
          device-orientation-permission-ui="enabled: false"
          renderer="antialias: true; colorManagement: true"
        >

          <a-entity
            id="workspaceCameraRig"
          >

            <a-camera
              id="workspaceCamera"
              fov="75"
              look-controls="
                reverseMouseDrag: false;
                touchEnabled: true;
                mouseEnabled: true;
                magicWindowTrackingEnabled: true
              "
              wasd-controls="enabled: false"
            ></a-camera>

          </a-entity>


          <a-sky
            id="workspaceSky"
            rotation="0 -90 0"
            src=""
            material="
              shader: flat;
              side: back
            "
          ></a-sky>

        </a-scene>


        <div
          class="studio-hint"
          id="workspaceHint"
        >
          Use Studio to edit camera position and hotspots.
        </div>


        <div class="workspace-bottom">

          <div class="workspace-camera-status">

            <span>
              VIEW
            </span>

            <strong id="workspaceYaw">
              0°
            </strong>

            <span>
              ·
            </span>

            <strong id="workspacePitch">
              0°
            </strong>

          </div>


          <div class="workspace-footer-actions">

            <button
              class="btn btn-small btn-secondary"
              type="button"
              id="workspacePrevBtn"
            >
              <i class="fa-solid fa-chevron-left"></i>
              Previous
            </button>

            <button
              class="btn btn-small btn-secondary"
              type="button"
              id="workspaceNextBtn"
            >
              Next
              <i class="fa-solid fa-chevron-right"></i>
            </button>

          </div>

        </div>

      </div>


      <!-- ======================================================
           QUICK INSPECTOR
      ======================================================= -->

      <aside class="workspace-card workspace-panel">

        <div class="panel-head">

          <div>

            <div class="panel-kicker">
              Live Inspector
            </div>

            <h2>
              Scene Intelligence
            </h2>

            <p>
              Pick a scene below, open Studio,
              and turn its panorama into a true
              explorable location.
            </p>

          </div>

          <button
            class="btn btn-primary btn-small"
            type="button"
            id="openSelectedSceneBtn"
          >
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            Edit
          </button>

        </div>


        <div class="panel-body">


          <section class="studio-section">

            <div class="section-heading">

              <strong>
                <i class="fa-solid fa-location-crosshairs"></i>
                Active Scene
              </strong>

              <span id="quickSceneIndex">
                —
              </span>

            </div>


            <div class="field-grid single">

              <div class="field">

                <label
                  class="field-label"
                  for="quickSceneSelect"
                >
                  Choose Panorama
                </label>

                <select
                  id="quickSceneSelect"
                >

                  <option value="">
                    Select a scene
                  </option>

                  <% galleryScenes.forEach(
                    function(scene, index) {
                  %>

                    <option
                      value="<%= index %>"
                    >
                      Scene
                      <%= index + 1 %>
                      ·
                      <%= getSceneTitle(scene, index) %>
                    </option>

                  <% }); %>

                </select>

              </div>

            </div>

          </section>


          <section class="studio-section">

            <div class="section-heading">

              <strong>
                <i class="fa-solid fa-route"></i>
                Current Path
              </strong>

              <span>
                Connected
              </span>

            </div>


            <div
              class="hotspot-list"
              id="quickConnectionList"
            >

              <div class="hotspot-empty">
                Select a scene to inspect its connections.
              </div>

            </div>

          </section>


          <section class="studio-section">

            <div class="section-heading">

              <strong>
                <i class="fa-solid fa-signal"></i>
                Scene Health
              </strong>

            </div>


            <div
              class="settings-stack"
              id="quickHealthList"
            >

              <div class="toggle-row">

                <div class="toggle-copy">

                  <strong>
                    Spatial position
                  </strong>

                  <span>
                    3D virtual-world coordinates
                  </span>

                </div>

                <span
                  class="health-chip"
                  id="healthSpatial"
                >
                  NOT SET
                </span>

              </div>


              <div class="toggle-row">

                <div class="toggle-copy">

                  <strong>
                    Resort map position
                  </strong>

                  <span>
                    2D map coordinates
                  </span>

                </div>

                <span
                  class="health-chip"
                  id="healthMap"
                >
                  NOT SET
                </span>

              </div>


              <div class="toggle-row">

                <div class="toggle-copy">

                  <strong>
                    Hotspots
                  </strong>

                  <span>
                    Interactive points
                  </span>

                </div>

                <span
                  class="health-chip"
                  id="healthHotspots"
                >
                  0
                </span>

              </div>

            </div>

          </section>


          <button
            class="btn btn-gold"
            type="button"
            id="quickPublicBtn"
          >
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
            Open Scene in Guest Experience
          </button>

        </div>

      </aside>

    </section>


    <!-- ========================================================
         GALLERY EXPERIENCE SETTINGS
    ========================================================= -->

    <section class="settings-card">

      <div class="settings-head">

        <div>

          <h2>
            Experience Controls
          </h2>

          <p>
            These settings define the behavior of the public
            virtual tour. They are separate from individual
            panorama scene settings.
          </p>

        </div>

        <span class="format-badge">
          TOUR ENGINE
        </span>

      </div>


      <div class="settings-body">

        <form
          method="POST"
          action="/admin/gallery-editor"
          id="experienceSettingsForm"
        >

          <% if (adminCsrfToken) { %>

            <input
              type="hidden"
              name="_csrf"
              value="<%= adminCsrfToken %>"
            >

          <% } %>


          <input
            type="hidden"
            name="action"
            value="save-settings"
          >


          <input
            type="hidden"
            name="tourEnabled"
            value="<%= isChecked(gallerySettings?.tour?.enabled, true) ? 'true' : 'false' %>"
            data-setting-hidden="tourEnabled"
          >

          <input
            type="hidden"
            name="preloadNeighbors"
            value="<%= isChecked(gallerySettings?.tour?.preloadNeighbors, true) ? 'true' : 'false' %>"
            data-setting-hidden="preloadNeighbors"
          >

          <input
            type="hidden"
            name="allowSharing"
            value="<%= isChecked(gallerySettings?.tour?.allowSharing, true) ? 'true' : 'false' %>"
            data-setting-hidden="allowSharing"
          >

          <input
            type="hidden"
            name="showMap"
            value="<%= isChecked(gallerySettings?.tour?.showMap, true) ? 'true' : 'false' %>"
            data-setting-hidden="showMap"
          >

          <input
            type="hidden"
            name="showHotspots"
            value="<%= isChecked(gallerySettings?.tour?.showHotspots, true) ? 'true' : 'false' %>"
            data-setting-hidden="showHotspots"
          >

          <input
            type="hidden"
            name="motionEnabled"
            value="<%= isChecked(gallerySettings?.viewer?.motionEnabled, true) ? 'true' : 'false' %>"
            data-setting-hidden="motionEnabled"
          >

          <input
            type="hidden"
            name="touchEnabled"
            value="<%= isChecked(gallerySettings?.viewer?.touchEnabled, true) ? 'true' : 'false' %>"
            data-setting-hidden="touchEnabled"
          >

          <input
            type="hidden"
            name="mouseEnabled"
            value="<%= isChecked(gallerySettings?.viewer?.mouseEnabled, true) ? 'true' : 'false' %>"
            data-setting-hidden="mouseEnabled"
          >

          <input
            type="hidden"
            name="mapEnabled"
            value="<%= isChecked(gallerySettings?.map?.enabled, true) ? 'true' : 'false' %>"
            data-setting-hidden="mapEnabled"
          >


          <div class="settings-grid">


            <!-- TOUR -->

            <section class="settings-group">

              <h3>
                <i class="fa-solid fa-route"></i>
                Tour Engine
              </h3>


              <div class="settings-stack">

                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Public tour enabled
                    </strong>

                    <span>
                      Allow guests to enter the experience.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="tourEnabled"
                      <%= isChecked(gallerySettings?.tour?.enabled, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="field">

                  <label
                    class="field-label"
                    for="settingsStartScene"
                  >
                    Starting Scene
                  </label>

                  <select
                    id="settingsStartScene"
                    name="startScene"
                  >

                    <% galleryScenes.forEach(
                      function(scene, index) {
                    %>

                      <option
                        value="<%= index %>"
                        <%= Number(
                          gallerySettings?.tour?.startScene
                        ) === index
                          ? "selected"
                          : index === 0 &&
                            !gallerySettings?.tour?.startScene
                          ? "selected"
                          : "" %>
                      >
                        Scene
                        <%= index + 1 %>
                        ·
                        <%= getSceneTitle(scene, index) %>
                      </option>

                    <% }); %>

                  </select>

                </div>


                <div class="field">

                  <label
                    class="field-label"
                    for="settingsPreloadDepth"
                  >
                    Preload Depth
                  </label>

                  <input
                    id="settingsPreloadDepth"
                    type="number"
                    name="preloadDepth"
                    min="1"
                    max="4"
                    step="1"
                    value="<%= gallerySettings?.tour?.preloadDepth || 2 %>"
                  >

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Preload neighbors
                    </strong>

                    <span>
                      Warm likely next locations.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="preloadNeighbors"
                      <%= isChecked(gallerySettings?.tour?.preloadNeighbors, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Scene sharing
                    </strong>

                    <span>
                      Allow guest scene links.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="allowSharing"
                      <%= isChecked(gallerySettings?.tour?.allowSharing, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>

              </div>

            </section>


            <!-- VIEWER -->

            <section class="settings-group">

              <h3>
                <i class="fa-solid fa-sliders"></i>
                Viewer
              </h3>


              <div class="settings-stack">

                <div class="field">

                  <label
                    class="field-label"
                    for="settingsDefaultFov"
                  >
                    Default FOV
                  </label>

                  <input
                    id="settingsDefaultFov"
                    type="number"
                    name="defaultFov"
                    min="30"
                    max="110"
                    step="1"
                    value="<%= gallerySettings?.viewer?.defaultFov || 75 %>"
                  >

                </div>


                <div class="field">

                  <label
                    class="field-label"
                    for="settingsMinFov"
                  >
                    Minimum FOV
                  </label>

                  <input
                    id="settingsMinFov"
                    type="number"
                    name="minFov"
                    min="20"
                    max="90"
                    step="1"
                    value="<%= gallerySettings?.viewer?.minFov || 30 %>"
                  >

                </div>


                <div class="field">

                  <label
                    class="field-label"
                    for="settingsMaxFov"
                  >
                    Maximum FOV
                  </label>

                  <input
                    id="settingsMaxFov"
                    type="number"
                    name="maxFov"
                    min="60"
                    max="140"
                    step="1"
                    value="<%= gallerySettings?.viewer?.maxFov || 110 %>"
                  >

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Motion controls
                    </strong>

                    <span>
                      Phone tilt / device orientation.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="motionEnabled"
                      <%= isChecked(gallerySettings?.viewer?.motionEnabled, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Touch controls
                    </strong>

                    <span>
                      Swipe and pinch interactions.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="touchEnabled"
                      <%= isChecked(gallerySettings?.viewer?.touchEnabled, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Mouse controls
                    </strong>

                    <span>
                      Desktop drag and look interaction.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="mouseEnabled"
                      <%= isChecked(gallerySettings?.viewer?.mouseEnabled, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>

              </div>

            </section>


            <!-- MAP / DISCOVERY -->

            <section class="settings-group">

              <h3>
                <i class="fa-solid fa-map"></i>
                Discovery
              </h3>


              <div class="settings-stack">

                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Resort map
                    </strong>

                    <span>
                      Show map when spatial data exists.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="showMap"
                      <%= isChecked(gallerySettings?.tour?.showMap, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Interactive hotspots
                    </strong>

                    <span>
                      Show information and navigation points.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="showHotspots"
                      <%= isChecked(gallerySettings?.tour?.showHotspots, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="toggle-row">

                  <div class="toggle-copy">

                    <strong>
                      Map engine
                    </strong>

                    <span>
                      Enable the spatial map layer.
                    </span>

                  </div>

                  <label class="toggle">

                    <input
                      type="checkbox"
                      data-setting-checkbox="mapEnabled"
                      <%= isChecked(gallerySettings?.map?.enabled, true) ? "checked" : "" %>
                    >

                    <span class="toggle-track"></span>

                  </label>

                </div>


                <div class="field">

                  <label
                    class="field-label"
                    for="settingsMapImage"
                  >
                    Map Image
                  </label>

                  <input
                    id="settingsMapImage"
                    type="text"
                    name="mapImage"
                    value="<%= gallerySettings?.map?.image || '' %>"
                    placeholder="/images/resort-map.png"
                  >

                  <span class="field-note">
                    Use a bundled or managed gallery image path.
                  </span>

                </div>


                <div class="field">

                  <label
                    class="field-label"
                    for="settingsMapTitle"
                  >
                    Map Title
                  </label>

                  <input
                    id="settingsMapTitle"
                    type="text"
                    name="mapTitle"
                    maxlength="150"
                    value="<%= gallerySettings?.map?.title || 'Puffer Isle Resort' %>"
                  >

                </div>

              </div>

            </section>


          </div>


          <div class="settings-footer">

            <div class="settings-footer-copy">
              Save these controls once, then use the Studio
              on individual scenes to build the world itself.
            </div>

            <button
              class="btn btn-gold"
              type="submit"
            >
              <i class="fa-solid fa-sliders"></i>
              Save Experience Settings
            </button>

          </div>


        </form>

      </div>

    </section>


    <!-- ========================================================
         SCENE MANAGEMENT
    ========================================================= -->

    <section class="management-card">

      <div class="management-head">

        <div>

          <h2>
            Panorama Library
          </h2>

          <p>
            Every scene below can be edited as a standalone
            location. Use <strong>Open Studio</strong> for the
            immersive visual editor, or use the quick fields
            for direct database-style editing.
          </p>

        </div>


        <div class="management-tools">

          <button
            class="btn btn-secondary btn-small"
            type="button"
            id="focusFirstSceneBtn"
          >
            <i class="fa-solid fa-bullseye"></i>
            Open First Scene
          </button>

          <a
            class="btn btn-primary btn-small"
            href="/gallery"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fa-solid fa-globe"></i>
            Open Live Tour
          </a>

        </div>

      </div>


      <div class="management-body">


        <!-- ======================================================
             ADD NEW SCENE
        ======================================================= -->

        <section class="add-card">

          <div class="add-card-head">

            <div>

              <h3>
                Add New Panorama
              </h3>

              <p>
                Upload a new equirectangular panorama and the
                system will add it to the navigation graph.
                Its deeper spatial data can then be configured
                in Studio.
              </p>

            </div>


            <span class="format-badge">
              JPG · PNG · WEBP · 25 MB
            </span>

          </div>


          <form
            method="POST"
            action="/admin/gallery-editor"
            enctype="multipart/form-data"
            id="addSceneForm"
          >

            <% if (adminCsrfToken) { %>

              <input
                type="hidden"
                name="_csrf"
                value="<%= adminCsrfToken %>"
              >

            <% } %>


            <input
              type="hidden"
              name="action"
              value="add"
            >


            <input
              type="hidden"
              name="projection"
              value="equirectangular"
            >


            <div class="add-form-grid">


              <div class="field">

                <label
                  class="field-label"
                  for="newSceneTitle"
                >
                  Location Name
                </label>

                <input
                  id="newSceneTitle"
                  type="text"
                  name="title"
                  minlength="2"
                  maxlength="150"
                  required
                  placeholder="Example: Main Beach"
                >

              </div>


              <div class="field">

                <label
                  class="field-label"
                  for="newSceneImage"
                >
                  360° Panorama
                </label>

                <input
                  id="newSceneImage"
                  type="file"
                  name="imageFile"
                  accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                  required
                >

              </div>


              <div class="field">

                <label
                  class="field-label"
                  for="newSceneCategory"
                >
                  Category
                </label>

                <input
                  id="newSceneCategory"
                  type="text"
                  name="category"
                  maxlength="100"
                  value="Resort"
                  placeholder="Beach"
                >

              </div>


              <button
                class="btn btn-gold"
                type="submit"
              >
                <i class="fa-solid fa-plus"></i>
                Add Panorama
              </button>


            </div>

          </form>

        </section>


        <!-- ======================================================
             SCENE LIST
        ======================================================= -->

        <div class="scene-section-head">

          <h3>
            Resort Scenes
          </h3>

          <span class="scene-count">
            <%= galleryScenes.length %>
            <%= galleryScenes.length === 1
              ? "scene"
              : "scenes" %>
          </span>

        </div>


        <% if (galleryScenes.length > 0) { %>


          <div class="scene-grid">


            <% galleryScenes.forEach(
              function(item, index) {
            %>


              <article
                class="scene-card"
                data-scene-card="<%= index %>"
              >


                <!-- ==========================================
                     PREVIEW
                =========================================== -->

                <div class="scene-preview">

                  <img
                    src="<%= item.image %>"
                    alt="<%= getSceneTitle(item, index) %>"
                    loading="lazy"
                  >


                  <div class="scene-badge">

                    <i class="fa-solid fa-panorama"></i>

                    Scene
                    <%= index + 1 %>

                  </div>


                  <div class="scene-preview-copy">

                    <div>

                      <strong>
                        <%= getSceneTitle(item, index) %>
                      </strong>

                      <span>
                        <%= item.category || "Resort" %>
                        <% if (item.location) { %>
                          ·
                          <%= item.location %>
                        <% } %>
                      </span>

                    </div>


                    <div class="scene-health">


                      <% if (item.active !== false) { %>

                        <span class="health-chip good">
                          <i class="fa-solid fa-circle"></i>
                          Live
                        </span>

                      <% } else { %>

                        <span class="health-chip warn">
                          <i class="fa-solid fa-eye-slash"></i>
                          Hidden
                        </span>

                      <% } %>


                      <% if (Array.isArray(item.hotspots) && item.hotspots.length > 0) { %>

                        <span class="health-chip">
                          <i class="fa-solid fa-location-dot"></i>
                          <%= item.hotspots.length %>
                        </span>

                      <% } %>


                      <% if (hasSpatialPosition(item)) { %>

                        <span class="health-chip good">
                          <i class="fa-solid fa-cubes"></i>
                          Spatial
                        </span>

                      <% } %>


                    </div>

                  </div>

                </div>


                <!-- ==========================================
                     CARD BODY
                =========================================== -->

                <div class="scene-card-body">


                  <form
                    class="scene-card-form scene-editor-form"
                    method="POST"
                    action="/admin/gallery-editor"
                    enctype="multipart/form-data"
                    data-scene-form="<%= index %>"
                  >


                    <% if (adminCsrfToken) { %>

                      <input
                        type="hidden"
                        name="_csrf"
                        value="<%= adminCsrfToken %>"
                      >

                    <% } %>


                    <input
                      type="hidden"
                      name="action"
                      value="update"
                    >


                    <input
                      type="hidden"
                      name="imageIndex"
                      value="<%= index %>"
                    >


                    <input
                      type="hidden"
                      name="projection"
                      value="<%= item.projection || 'equirectangular' %>"
                    >


                    <input
                      type="hidden"
                      name="thumbnail"
                      value="<%= item.thumbnail || item.image || '' %>"
                      data-field="thumbnail"
                    >


                    <input
                      type="hidden"
                      name="hotspotsJson"
                      value="<%= JSON.stringify(
                        Array.isArray(item.hotspots)
                          ? item.hotspots
                          : []
                      ) %>"
                      data-field="hotspotsJson"
                    >


                    <input
                      type="hidden"
                      name="positionJson"
                      value="<%= JSON.stringify(
                        item.position || {
                          x: null,
                          y: null,
                          z: null
                        }
                      ) %>"
                      data-field="positionJson"
                    >


                    <input
                      type="hidden"
                      name="mapPositionJson"
                      value="<%= JSON.stringify(
                        item.mapPosition || {
                          x: null,
                          y: null
                        }
                      ) %>"
                      data-field="mapPositionJson"
                    >


                    <input
                      type="hidden"
                      name="active"
                      value="<%= item.active === false ? 'false' : 'true' %>"
                      data-bool-hidden="active"
                    >


                    <input
                      type="hidden"
                      name="featured"
                      value="<%= item.featured === true ? 'true' : 'false' %>"
                      data-bool-hidden="featured"
                    >


                    <!-- ======================================
                         CORE
                    ======================================= -->

                    <div class="field-grid">


                      <div class="field">

                        <label
                          class="field-label"
                          for="sceneTitle_<%= index %>"
                        >
                          Location Name
                        </label>

                        <input
                          id="sceneTitle_<%= index %>"
                          type="text"
                          name="title"
                          maxlength="150"
                          minlength="2"
                          required
                          value="<%= item.title || '' %>"
                          data-field="title"
                        >

                      </div>


                      <div class="field">

                        <label
                          class="field-label"
                          for="sceneSlug_<%= index %>"
                        >
                          Scene Slug
                        </label>

                        <input
                          id="sceneSlug_<%= index %>"
                          type="text"
                          name="slug"
                          maxlength="180"
                          value="<%= item.slug || '' %>"
                          placeholder="beach-horizon"
                          data-field="slug"
                        >

                      </div>


                    </div>


                    <!-- ======================================
                         DESCRIPTION
                    ======================================= -->

                    <div class="field">

                      <label
                        class="field-label"
                        for="sceneDescription_<%= index %>"
                      >
                        Scene Description
                      </label>

                      <textarea
                        id="sceneDescription_<%= index %>"
                        name="description"
                        maxlength="2000"
                        placeholder="Describe this location for the immersive experience..."
                        data-field="description"
                      ><%= item.description || '' %></textarea>

                    </div>


                    <!-- ======================================
                         ADVANCED
                    ======================================= -->

                    <div class="advanced-grid">


                      <!-- METADATA -->

                      <div class="advanced-section">

                        <div class="advanced-section-title">

                          <i class="fa-solid fa-tag"></i>

                          Metadata

                        </div>


                        <div class="settings-stack">


                          <div class="field">

                            <label
                              class="field-label"
                              for="category_<%= index %>"
                            >
                              Category
                            </label>

                            <input
                              id="category_<%= index %>"
                              type="text"
                              name="category"
                              maxlength="100"
                              value="<%= item.category || 'Resort' %>"
                              data-field="category"
                            >

                          </div>


                          <div class="field">

                            <label
                              class="field-label"
                              for="location_<%= index %>"
                            >
                              Location Label
                            </label>

                            <input
                              id="location_<%= index %>"
                              type="text"
                              name="location"
                              maxlength="300"
                              value="<%= item.location || '' %>"
                              placeholder="Main shoreline"
                              data-field="location"
                            >

                          </div>


                          <div class="field">

                            <label
                              class="field-label"
                              for="tags_<%= index %>"
                            >
                              Tags
                            </label>

                            <input
                              id="tags_<%= index %>"
                              type="text"
                              name="tags"
                              value="<%= Array.isArray(item.tags) ? item.tags.join(', ') : '' %>"
                              placeholder="beach, sunset, ocean"
                              data-field="tags"
                            >

                          </div>


                          <label class="toggle-row">

                            <span class="toggle-copy">

                              <strong>
                                Featured
                              </strong>

                              <span>
                                Highlight in future discovery UI.
                              </span>

                            </span>


                            <span class="toggle">

                              <input
                                type="checkbox"
                                data-scene-bool="featured"
                                <%= item.featured === true ? "checked" : "" %>
                              >

                              <span class="toggle-track"></span>

                            </span>

                          </label>


                          <label class="toggle-row">

                            <span class="toggle-copy">

                              <strong>
                                Published
                              </strong>

                              <span>
                                Make this scene available to guests.
                              </span>

                            </span>


                            <span class="toggle">

                              <input
                                type="checkbox"
                                data-scene-bool="active"
                                <%= item.active !== false ? "checked" : "" %>
                              >

                              <span class="toggle-track"></span>

                            </span>

                          </label>


                        </div>

                      </div>


                      <!-- CAMERA -->

                      <div class="advanced-section">

                        <div class="advanced-section-title">

                          <i class="fa-solid fa-camera"></i>

                          Camera

                        </div>


                        <div class="settings-stack">


                          <div class="field">

                            <label
                              class="field-label"
                              for="heading_<%= index %>"
                            >
                              Heading
                            </label>

                            <input
                              id="heading_<%= index %>"
                              type="number"
                              name="heading"
                              min="-360"
                              max="360"
                              step="1"
                              value="<%= Number.isFinite(Number(item.heading)) ? Number(item.heading) : 0 %>"
                              data-field="heading"
                            >

                          </div>


                          <div class="field">

                            <label
                              class="field-label"
                              for="pitch_<%= index %>"
                            >
                              Pitch
                            </label>

                            <input
                              id="pitch_<%= index %>"
                              type="number"
                              name="pitch"
                              min="-89"
                              max="89"
                              step="1"
                              value="<%= Number.isFinite(Number(item.pitch)) ? Number(item.pitch) : 0 %>"
                              data-field="pitch"
                            >

                          </div>


                          <div class="field">

                            <label
                              class="field-label"
                              for="fov_<%= index %>"
                            >
                              Starting FOV
                            </label>

                            <input
                              id="fov_<%= index %>"
                              type="number"
                              name="fov"
                              min="30"
                              max="110"
                              step="1"
                              value="<%= Number.isFinite(Number(item.fov)) ? Number(item.fov) : 75 %>"
                              data-field="fov"
                            >

                          </div>


                          <div class="field">

                            <label
                              class="field-label"
                              for="northOffset_<%= index %>"
                            >
                              North Offset
                            </label>

                            <input
                              id="northOffset_<%= index %>"
                              type="number"
                              name="northOffset"
                              min="-360"
                              max="360"
                              step="1"
                              value="<%= Number.isFinite(Number(item.northOffset)) ? Number(item.northOffset) : 0 %>"
                              data-field="northOffset"
                            >

                          </div>

                        </div>

                      </div>


                      <!-- SPATIAL -->

                      <div class="advanced-section">

                        <div class="advanced-section-title">

                          <i class="fa-solid fa-cubes"></i>

                          Spatial World

                        </div>


                        <div class="field-grid">


                          <div class="field">

                            <label class="field-label">
                              X
                            </label>

                            <input
                              type="number"
                              step="0.01"
                              value="<%= item.position?.x ?? '' %>"
                              data-position-input="x"
                            >

                          </div>


                          <div class="field">

                            <label class="field-label">
                              Y
                            </label>

                            <input
                              type="number"
                              step="0.01"
                              value="<%= item.position?.y ?? '' %>"
                              data-position-input="y"
                            >

                          </div>


                        </div>


                        <div class="field">

                          <label class="field-label">
                            Z
                          </label>

                          <input
                            type="number"
                            step="0.01"
                            value="<%= item.position?.z ?? '' %>"
                            data-position-input="z"
                          >

                        </div>


                        <span class="field-note">
                          These coordinates represent the scene's
                          virtual-world position.
                        </span>

                      </div>


                    </div>


                    <!-- ======================================
                         NAVIGATION
                    ======================================= -->

                    <div class="advanced-section">

                      <div class="advanced-section-title">

                        <i class="fa-solid fa-arrows-turn-to-dots"></i>

                        Navigation Graph

                      </div>


                      <div class="quick-navigation">


                        <div class="field">

                          <label
                            class="field-label"
                            for="left_<%= index %>"
                          >
                            Left
                          </label>

                          <select
                            id="left_<%= index %>"
                            name="left"
                          >

                            <option value="">
                              No destination
                            </option>

                            <% galleryScenes.forEach(
                              function(target, targetIndex) {
                            %>

                              <% if (
                                targetIndex !== index
                              ) { %>

                                <option
                                  value="<%= targetIndex %>"
                                  <%= isSelected(
                                    item.left,
                                    targetIndex
                                  )
                                    ? "selected"
                                    : "" %>
                                >
                                  Scene
                                  <%= targetIndex + 1 %>
                                  ·
                                  <%= getSceneTitle(
                                    target,
                                    targetIndex
                                  ) %>
                                </option>

                              <% } %>

                            <% }); %>

                          </select>

                        </div>


                        <div class="field">

                          <label
                            class="field-label"
                            for="right_<%= index %>"
                          >
                            Right
                          </label>

                          <select
                            id="right_<%= index %>"
                            name="right"
                          >

                            <option value="">
                              No destination
                            </option>

                            <% galleryScenes.forEach(
                              function(target, targetIndex) {
                            %>

                              <% if (
                                targetIndex !== index
                              ) { %>

                                <option
                                  value="<%= targetIndex %>"
                                  <%= isSelected(
                                    item.right,
                                    targetIndex
                                  )
                                    ? "selected"
                                    : "" %>
                                >
                                  Scene
                                  <%= targetIndex + 1 %>
                                  ·
                                  <%= getSceneTitle(
                                    target,
                                    targetIndex
                                  ) %>
                                </option>

                              <% } %>

                            <% }); %>

                          </select>

                        </div>


                        <div class="field">

                          <label
                            class="field-label"
                            for="forward_<%= index %>"
                          >
                            Forward
                          </label>

                          <select
                            id="forward_<%= index %>"
                            name="forward"
                          >

                            <option value="">
                              No destination
                            </option>

                            <% galleryScenes.forEach(
                              function(target, targetIndex) {
                            %>

                              <% if (
                                targetIndex !== index
                              ) { %>

                                <option
                                  value="<%= targetIndex %>"
                                  <%= isSelected(
                                    item.forward,
                                    targetIndex
                                  )
                                    ? "selected"
                                    : "" %>
                                >
                                  Scene
                                  <%= targetIndex + 1 %>
                                  ·
                                  <%= getSceneTitle(
                                    target,
                                    targetIndex
                                  ) %>
                                </option>

                              <% } %>

                            <% }); %>

                          </select>

                        </div>


                        <div class="field">

                          <label
                            class="field-label"
                            for="backward_<%= index %>"
                          >
                            Backward
                          </label>

                          <select
                            id="backward_<%= index %>"
                            name="backward"
                          >

                            <option value="">
                              No destination
                            </option>

                            <% galleryScenes.forEach(
                              function(target, targetIndex) {
                            %>

                              <% if (
                                targetIndex !== index
                              ) { %>

                                <option
                                  value="<%= targetIndex %>"
                                  <%= isSelected(
                                    item.backward,
                                    targetIndex
                                  )
                                    ? "selected"
                                    : "" %>
                                >
                                  Scene
                                  <%= targetIndex + 1 %>
                                  ·
                                  <%= getSceneTitle(
                                    target,
                                    targetIndex
                                  ) %>
                                </option>

                              <% } %>

                            <% }); %>

                          </select>

                        </div>


                      </div>

                    </div>


                    <!-- ======================================
                         ACTIONS
                    ======================================= -->

                    <div class="card-actions">


                      <button
                        class="btn btn-primary"
                        type="submit"
                      >
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Scene
                      </button>


                      <button
                        class="btn btn-gold open-studio-btn"
                        type="button"
                        data-scene-index="<%= index %>"
                      >
                        <i class="fa-solid fa-crosshairs"></i>
                        Open Studio
                      </button>


                      <button
                        class="btn btn-secondary"
                        type="button"
                        data-public-scene="<%= index %>"
                      >
                        <i class="fa-solid fa-eye"></i>
                      </button>


                    </div>


                  </form>


                  <!-- ==========================================
                       DELETE
                  =========================================== -->

