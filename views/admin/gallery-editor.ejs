                      type="submit"
                      style="width:100%;margin-top:7px;"
                    >

                      <i class="fa-solid fa-trash"></i>

                      Delete Scene

                    </button>

                  </form>


                </div>

              </article>


            <% }); %>


          </div>


        <% } else { %>


          <div class="empty-state">

            <div>

