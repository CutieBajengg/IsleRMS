    /* ============================================================
       SMALL HELPERS
    ============================================================ */

    function clamp(
      value,
      min,
      max
    ) {

      const parsed =
        Number(
          value
        );

      if (
        !Number.isFinite(
          parsed
        )
      ) {

        return min;
      }

      return Math.min(
        max,
        Math.max(
          min,
          parsed
        )
      );
    }


    function toNumber(
      value,
      fallback = 0
    ) {

      const parsed =
        Number(
          value
        );

      return Number.isFinite(
        parsed
      )
        ? parsed
        : fallback;
    }


    function normalizeYaw(
      value
    ) {

      let result =
        toNumber(
          value,
          0
        );

      while (
        result >
        180
      ) {
        result -=
          360;
      }

      while (
        result <
        -180
      ) {
        result +=
          360;
      }

      return result;
    }


    function normalizeSlug(
      value,
      fallback = ""
    ) {

      const source =
        String(
          value ||
          fallback ||
          ""
        )
          .trim()
          .toLowerCase();

      if (!source) {
        return "";
      }

      return source
        .replace(
          /[^a-z0-9]+/g,
          "-"
        )
        .replace(
          /^-+|-+$/g,
          ""
        )
        .slice(
          0,
          180
        );
    }


    function sceneTitle(
      scene,
      index
    ) {

      return (
        scene?.title ||
        `Scene ${index + 1}`
      );
    }


    function validSceneIndex(
      index
    ) {

      return (
        Number.isInteger(
          index
        ) &&
        index >= 0 &&
        index < scenes.length
      );
    }


    function hasSpatialPosition(
      scene
    ) {

      const p =
        scene?.position ||
        {};

      return [
        p.x,
        p.y,
        p.z,
      ].every(
        value =>
          value !== null &&
          value !== undefined &&
          value !== "" &&
          Number.isFinite(
            Number(value)
          )
      );
    }


    function hasMapPosition(
      scene
    ) {

      const p =
        scene?.mapPosition ||
        {};

      return (
        p.x !== null &&
        p.x !== undefined &&
        p.x !== "" &&
        p.y !== null &&
        p.y !== undefined &&
        p.y !== "" &&
        Number.isFinite(
          Number(p.x)
        ) &&
        Number.isFinite(
          Number(p.y)
        )
      );
    }


    function markStudioDirty(
      message =
        "Unsaved visual changes."
    ) {

      studioDirty =
        true;

      if (
        modalDirtyStatus
      ) {

        modalDirtyStatus.textContent =
          message;
      }
    }


    function clearStudioDirty() {

      studioDirty =
        false;

      if (
        modalDirtyStatus
      ) {

        modalDirtyStatus.textContent =
          "No unsaved visual changes.";
      }
    }


    /* ============================================================
       SCENE CONNECTIONS
    ============================================================ */

    function getConnections(
      index
    ) {

      if (
        !validSceneIndex(
          index
        )
      ) {

        return [];
      }

      const scene =
        scenes[
          index
        ];

      const directions = [
        "forward",
        "backward",
        "left",
        "right",
      ];

      return directions
        .map(
          direction => {

            const raw =
              scene?.[
                direction
              ];

            if (
              raw === null ||
              raw === undefined ||
              raw === ""
            ) {

              return null;
            }

            const target =
              Number(
                raw
              );

            if (
              !Number.isInteger(
                target
              ) ||
              !validSceneIndex(
                target
              ) ||
              target ===
                index
            ) {

              return null;
            }

            return {
              direction,
              target,
              scene:
                scenes[
                  target
                ],
            };
          }
        )
        .filter(Boolean);
    }


    function directionIcon(
      direction
    ) {

      const icons = {

        forward:
          "↑",

        backward:
          "↓",

        left:
          "←",

        right:
          "→",

      };

      return (
        icons[
          direction
        ] ||
        "•"
      );
    }


    /* ============================================================
       QUICK INSPECTOR
    ============================================================ */

    function updateQuickInspector() {

      if (
        !validSceneIndex(
          selectedSceneIndex
        )
      ) {

        if (
          quickSceneIndex
        ) {
          quickSceneIndex.textContent =
            "—";
        }

        if (
          quickConnectionList
        ) {
          quickConnectionList.innerHTML =
            '<div class="hotspot-empty">No scene selected.</div>';
        }

        return;
      }


      const scene =
        scenes[
          selectedSceneIndex
        ];


      if (
        quickSceneIndex
      ) {

        quickSceneIndex.textContent =
          `SCENE ${selectedSceneIndex + 1}`;
      }


      if (
        quickSceneSelect &&
        String(
          quickSceneSelect.value
        ) !==
          String(
            selectedSceneIndex
          )
      ) {

        quickSceneSelect.value =
          String(
            selectedSceneIndex
          );
      }


      if (
        workspaceSceneTitle
      ) {

        workspaceSceneTitle.textContent =
          sceneTitle(
            scene,
            selectedSceneIndex
          );
      }


      if (
        workspaceSceneMeta
      ) {

        workspaceSceneMeta.textContent =
          [
            scene?.category ||
              "Resort",

            scene?.location ||
              "Immersive panorama",

            `Scene ${
              selectedSceneIndex + 1
            }`,
          ].join(
            " · "
          );
      }


      if (
        quickConnectionList
      ) {

        quickConnectionList.innerHTML =
          "";

        const connections =
          getConnections(
            selectedSceneIndex
          );

        if (
          !connections.length
        ) {

          quickConnectionList.innerHTML =
            '<div class="hotspot-empty">No navigation links have been configured for this scene yet.</div>';

        } else {

          connections.forEach(
            connection => {

              const button =
                document.createElement(
                  "button"
                );

              button.type =
                "button";

              button.className =
                "hotspot-item";

              const icon =
                document.createElement(
                  "span"
                );

              icon.className =
                "hotspot-dot navigation";

              icon.textContent =
                directionIcon(
                  connection.direction
                );

              const copy =
                document.createElement(
                  "span"
                );

              copy.className =
                "hotspot-copy";

              const title =
                document.createElement(
                  "strong"
                );

              title.textContent =
                sceneTitle(
                  connection.scene,
                  connection.target
                );

              const meta =
                document.createElement(
                  "span"
                );

              meta.textContent =
                connection.direction
                  .charAt(0)
                  .toUpperCase() +
                connection.direction.slice(
                  1
                );

              copy.appendChild(
                title
              );

              copy.appendChild(
                meta
              );

              button.appendChild(
                icon
              );

              button.appendChild(
                copy
              );

              button.addEventListener(
                "click",
                () => {

                  selectedSceneIndex =
                    connection.target;

                  updateQuickInspector();
                  loadWorkspaceScene(
                    selectedSceneIndex
                  );
                }
              );

              quickConnectionList.appendChild(
                button
              );
            }
          );

        }
      }


      if (
        healthSpatial
      ) {

        healthSpatial.textContent =
          hasSpatialPosition(
            scene
          )
            ? "READY"
            : "NOT SET";

        healthSpatial.classList.toggle(
          "good",
          hasSpatialPosition(
            scene
          )
        );

        healthSpatial.classList.toggle(
          "warn",
          !hasSpatialPosition(
            scene
          )
        );
      }


      if (
        healthMap
      ) {

        healthMap.textContent =
          hasMapPosition(
            scene
          )
            ? "READY"
            : "NOT SET";

        healthMap.classList.toggle(
          "good",
          hasMapPosition(
            scene
          )
        );

        healthMap.classList.toggle(
          "warn",
          !hasMapPosition(
            scene
          )
        );
      }


      if (
        healthHotspots
      ) {

        const count =
          Array.isArray(
            scene?.hotspots
          )
            ? scene.hotspots.length
            : 0;

        healthHotspots.textContent =
          String(
            count
          );

        healthHotspots.classList.toggle(
          "good",
          count > 0
        );
      }


      if (
        quickPublicBtn
      ) {

        quickPublicBtn.disabled =
          !validSceneIndex(
            selectedSceneIndex
          );
      }
    }


    /* ============================================================
       WORKSPACE
    ============================================================ */

    function getLookControls(
      camera
    ) {

      return (
        camera?.components?.[
          "look-controls"
        ] ||
        null
      );
    }


    function getCameraYaw(
      camera
    ) {

      const controls =
        getLookControls(
          camera
        );

      if (
        controls?.yawObject
      ) {

        const degrees =
          -AFRAME.THREE.MathUtils.radToDeg(
            controls.yawObject.rotation.y
          );

        return normalizeYaw(
          degrees
        );
      }

      const rotation =
        camera?.getAttribute(
          "rotation"
        ) ||
        {};

      return normalizeYaw(
        -toNumber(
          rotation.y,
          0
        )
      );
    }


    function getCameraPitch(
      camera
    ) {

      const controls =
        getLookControls(
          camera
        );

      if (
        controls?.pitchObject
      ) {

        return clamp(
          AFRAME.THREE.MathUtils.radToDeg(
            controls.pitchObject.rotation.x
          ),
          -89,
          89
        );
      }

      const rotation =
        camera?.getAttribute(
          "rotation"
        ) ||
        {};

      return clamp(
        toNumber(
          rotation.x,
          0
        ),
        -89,
        89
      );
    }


    function getCameraFov(
      camera
    ) {

      return clamp(
        toNumber(
          camera?.getAttribute(
            "fov"
          ),
          75
        ),
        30,
        110
      );
    }


    function setCameraPose(
      camera,
      pose
    ) {

      if (
        !camera ||
        !pose
      ) {

        return;
      }

      const controls =
        getLookControls(
          camera
        );

      const yaw =
        normalizeYaw(
          pose.yaw
        );

      const pitch =
        clamp(
          pose.pitch,
          -89,
          89
        );

      const fov =
        clamp(
          pose.fov,
          30,
          110
        );


      if (
        controls?.yawObject &&
        controls?.pitchObject
      ) {

        controls.yawObject.rotation.y =
          AFRAME.THREE.MathUtils.degToRad(
            -yaw
          );

        controls.pitchObject.rotation.x =
          AFRAME.THREE.MathUtils.degToRad(
            pitch
          );

      } else {

        camera.setAttribute(
          "rotation",
          {
            x:
              pitch,

            y:
              -yaw,

            z:
              0,
          }
        );
      }


      camera.setAttribute(
        "fov",
        fov
      );
    }


    function getSceneStartPose(
      scene
    ) {

      return {

        yaw:
          Number.isFinite(
            Number(
              scene?.heading
            )
          )
            ? Number(
                scene.heading
              )
            : 0,

        pitch:
          Number.isFinite(
            Number(
              scene?.pitch
            )
          )
            ? Number(
                scene.pitch
              )
            : 0,

        fov:
          Number.isFinite(
            Number(
              scene?.fov
            )
          )
            ? Number(
                scene.fov
              )
            : 75,

      };
    }


    function updateWorkspaceCameraHud() {

      if (
        !workspaceCamera
      ) {

        return;
      }

      const yaw =
        Math.round(
          getCameraYaw(
            workspaceCamera
          )
        );

      const pitch =
        Math.round(
          getCameraPitch(
            workspaceCamera
          )
        );

      if (
        workspaceYaw
      ) {

        workspaceYaw.textContent =
          `${yaw}°`;
      }

      if (
        workspacePitch
      ) {

        workspacePitch.textContent =
          `${pitch}°`;
      }
    }


    function loadWorkspaceScene(
      index
    ) {

      if (
        !validSceneIndex(
          index
        )
      ) {

        return;
      }

      const scene =
        scenes[
          index
        ];

      selectedSceneIndex =
        index;


      updateQuickInspector();


      if (
        workspaceSky
      ) {

        workspaceSky.setAttribute(
          "src",
          scene.image || ""
        );
      }


      setCameraPose(
        workspaceCamera,
        getSceneStartPose(
          scene
        )
      );


      updateWorkspaceCameraHud();


      if (
        workspaceHint
      ) {

        workspaceHint.textContent =
          "Open Studio to place hotspots or tune the scene.";
      }
    }


    /* ============================================================
       STUDIO OPEN / CLOSE
    ============================================================ */

    function openStudio(
      index
    ) {

      if (
        !validSceneIndex(
          index
        )
      ) {

        return;
      }


      if (
        studioDirty
      ) {

        const confirmed =
          window.confirm(
            "You have unsaved Studio changes. Continue and discard them?"
          );

        if (
          !confirmed
        ) {

          return;
        }
      }


      studioSceneIndex =
        index;

      selectedHotspotIndex =
        -1;

      studioLoaded =
        true;


      const scene =
        scenes[
          index
        ];


      fillStudioFromScene(
        scene
      );


      studioModal?.classList.add(
        "is-open"
      );


      studioModal?.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.style.overflow =
        "hidden";


      requestAnimationFrame(
        () => {

          loadStudioPanorama(
            scene
          );

          renderStudioHotspots();

          updateStudioPoseUi();

          activateModalTab(
            "scene"
          );

          clearStudioDirty();

        }
      );
    }


    function closeStudio() {

      if (
        studioDirty
      ) {

        const confirmed =
          window.confirm(
            "You have unsaved Studio changes. Close without saving?"
          );

        if (
          !confirmed
        ) {

          return;
        }
      }


      studioModal?.classList.remove(
        "is-open"
      );


      studioModal?.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.style.overflow =
        "";


      studioSceneIndex =
        -1;

      selectedHotspotIndex =
        -1;

      isPlacingHotspot =
        false;

      studioLoaded =
        false;


      updatePlacementUi();

      clearHotspotEditor();
    }


    /* ============================================================
       STUDIO DATA
    ============================================================ */

    function fillStudioFromScene(
      scene
    ) {

      if (
        !scene
      ) {

        return;
      }


      studioTitle.value =
        scene.title || "";

      studioSlug.value =
        scene.slug || "";

      studioCategory.value =
        scene.category ||
        "Resort";

      studioLocation.value =
        scene.location ||
        "";

      studioDescription.value =
        scene.description ||
        "";

      studioTags.value =
        Array.isArray(
          scene.tags
        )
          ? scene.tags.join(
              ", "
            )
          : "";


      const pose =
        getSceneStartPose(
          scene
        );


      studioHeadingRange.value =
        String(
          clamp(
            pose.yaw,
            -180,
            180
          )
        );

      studioPitchRange.value =
        String(
          clamp(
            pose.pitch,
            -89,
            89
          )
        );

      studioFovRange.value =
        String(
          clamp(
            pose.fov,
            30,
            110
          )
        );


      studioMapX.value =
        scene?.mapPosition?.x ??
        "";

      studioMapY.value =
        scene?.mapPosition?.y ??
        "";


      studioPositionX.value =
        scene?.position?.x ??
        "";

      studioPositionY.value =
        scene?.position?.y ??
        "";

      studioPositionZ.value =
        scene?.position?.z ??
        "";


      studioNorthOffset.value =
        Number.isFinite(
          Number(
            scene?.northOffset
          )
        )
          ? Number(
              scene.northOffset
            )
          : 0;


      if (
        scene?.image
      ) {

        modalSceneTitle.textContent =
          scene.title ||
          "Scene Studio";

        modalSceneMeta.textContent =
          [
            scene.category ||
              "Resort",

            scene.location ||
              "360° panorama",

            `Scene ${
              studioSceneIndex + 1
            }`,
          ].join(
            " · "
          );
      }


      updateStudioMapPin();

      clearHotspotEditor();

      renderStudioHotspotList();

      updateStudioPoseUi();
    }


    function loadStudioPanorama(
      scene
    ) {

      if (
        !scene ||
        !studioSky
      ) {

        return;
      }


      studioSky.setAttribute(
        "src",
        scene.image || ""
      );


      setCameraPose(
        studioCamera,
        getSceneStartPose(
          scene
        )
      );


      updateStudioPoseUi();
    }


    /* ============================================================
       STUDIO CAMERA UI
    ============================================================ */

    function updateStudioPoseUi() {

      if (
        !studioCamera
      ) {

        return;
      }


      const yaw =
        getCameraYaw(
          studioCamera
        );

      const pitch =
        getCameraPitch(
          studioCamera
        );

      const fov =
        getCameraFov(
          studioCamera
        );


      studioHeadingRange.value =
        String(
          clamp(
            yaw,
            -180,
            180
          )
        );

      studioPitchRange.value =
        String(
          clamp(
            pitch,
            -89,
            89
          )
        );

      studioFovRange.value =
        String(
          clamp(
            fov,
            30,
            110
          )
        );


      studioHeadingValue.textContent =
        `${Math.round(
          yaw
        )}°`;

      studioPitchValue.textContent =
        `${Math.round(
          pitch
        )}°`;

      studioFovValue.textContent =
        `${Math.round(
          fov
        )}°`;


      studioPoseText.textContent =
        `${Math.round(
          yaw
        )}° · ${Math.round(
          pitch
        )}° · ${Math.round(
          fov
        )}°`;
    }


    function setStudioCameraFromRanges() {

      setCameraPose(
        studioCamera,
        {
          yaw:
            toNumber(
              studioHeadingRange.value,
              0
            ),

          pitch:
            toNumber(
              studioPitchRange.value,
              0
            ),

          fov:
            toNumber(
              studioFovRange.value,
              75
            ),
        }
      );


      updateStudioPoseUi();

      markStudioDirty();
    }


    studioHeadingRange?.addEventListener(
      "input",
      setStudioCameraFromRanges
    );


    studioPitchRange?.addEventListener(
      "input",
      setStudioCameraFromRanges
    );


    studioFovRange?.addEventListener(
      "input",
      setStudioCameraFromRanges
    );


    useCurrentViewBtn?.addEventListener(
      "click",
      () => {

        updateStudioPoseUi();

        markStudioDirty(
          "Current camera view is staged as the scene starting view."
        );
      }
    );


    resetViewBtn?.addEventListener(
      "click",
      () => {

        if (
          !validSceneIndex(
            studioSceneIndex
          )
        ) {

          return;
        }

        const scene =
          scenes[
            studioSceneIndex
          ];

        setCameraPose(
          studioCamera,
          getSceneStartPose(
            scene
          )
        );

        updateStudioPoseUi();

        markStudioDirty(
          "Camera reset to the saved scene view."
        );
      }
    );


    modalResetBtn?.addEventListener(
      "click",
      () => {

        resetViewBtn?.click();

      }
