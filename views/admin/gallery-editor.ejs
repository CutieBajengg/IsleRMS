    /* ============================================================
       HOTSPOT POSITION MATH
    ============================================================ */

    function hotspotToPosition(
      yaw,
      pitch,
      radius = 9
    ) {

      const yawRad =
        AFRAME.THREE.MathUtils.degToRad(
          Number(yaw) || 0
        );

      const pitchRad =
        AFRAME.THREE.MathUtils.degToRad(
          Number(pitch) || 0
        );


      const cosPitch =
        Math.cos(
          pitchRad
        );


      return {

        x:
          radius *
          Math.sin(
            yawRad
          ) *
          cosPitch,

        y:
          radius *
          Math.sin(
            pitchRad
          ),

        z:
          -radius *
          Math.cos(
            yawRad
          ) *
          cosPitch,

      };
    }


    function hotspotIcon(
      hotspot
    ) {

      if (
        hotspot?.type ===
        "navigation"
      ) {

        return "➜";
      }

      if (
        hotspot?.type ===
        "poi"
      ) {

        return "●";
      }

      if (
        hotspot?.type ===
        "link"
      ) {

        return "↗";
      }

      return "i";
    }


    function hotspotColor(
      hotspot
    ) {

      if (
        hotspot?.type ===
        "navigation"
      ) {

        return "#ffd700";
      }

      return "#15c4bd";
    }


    /* ============================================================
       RENDER 3D HOTSPOTS
    ============================================================ */

    function renderStudioHotspots() {

      if (
        !studioHotspots
      ) {

        return;
      }


      studioHotspots.innerHTML =
        "";


      if (
        !validSceneIndex(
          studioSceneIndex
        )
      ) {

        return;
      }


      const scene =
        scenes[
          studioSceneIndex
        ];


      const hotspots =
        Array.isArray(
          scene?.hotspots
        )
          ? scene.hotspots
          : [];


      hotspots.forEach(
        (
          hotspot,
          index
        ) => {

          if (
            hotspot?.visible ===
            false
          ) {

            return;
          }


          const position =
            hotspotToPosition(
              hotspot.yaw,
              hotspot.pitch,
              8.7
            );


          const entity =
            document.createElement(
              "a-entity"
            );


          entity.setAttribute(
            "position",
            `${position.x} ${position.y} ${position.z}`
          );

          entity.setAttribute(
            "class",
            "studio-hotspot"
          );


          const sphere =
            document.createElement(
              "a-sphere"
            );


          sphere.setAttribute(
            "radius",
            hotspot.scale
              ? Math.min(
                  0.40,
                  Math.max(
                    0.16,
                    0.18 *
                    Number(
                      hotspot.scale
                    )
                  )
                )
              : 0.18
          );


          sphere.setAttribute(
            "material",
            `
              color: ${
                hotspotColor(
                  hotspot
                )
              };
              shader: flat;
              opacity: 0.94;
            `
          );


          sphere.setAttribute(
            "class",
            "studio-hotspot"
          );


          sphere.dataset.hotspotIndex =
            String(index);


          const ring =
            document.createElement(
              "a-ring"
            );


          ring.setAttribute(
            "radius-inner",
            "0.25"
          );


          ring.setAttribute(
            "radius-outer",
            "0.38"
          );


          ring.setAttribute(
            "rotation",
            "0 0 0"
          );


          ring.setAttribute(
            "material",
            `
              color: ${
                hotspotColor(
                  hotspot
                )
              };
              shader: flat;
              side: double;
              opacity: 0.25;
            `
          );


          ring.setAttribute(
            "position",
            "0 0 -0.02"
          );


          sphere.addEventListener(
            "click",
            event => {

              event.stopPropagation();

              selectHotspotForEditing(
                index
              );
            }
          );


          entity.appendChild(
            ring
          );

          entity.appendChild(
            sphere
          );


          studioHotspots.appendChild(
            entity
          );

        }
      );

    }


    /* ============================================================
       RENDER HOTSPOT LIST
    ============================================================ */

    function renderStudioHotspotList() {

      if (
        !studioHotspotList
      ) {

        return;
      }


      studioHotspotList.innerHTML =
        "";


      if (
        !validSceneIndex(
          studioSceneIndex
        )
      ) {

        studioHotspotList.innerHTML =
          '<div class="hotspot-empty">Open a scene first.</div>';

        if (
          hotspotCountLabel
        ) {

          hotspotCountLabel.textContent =
            "0";
        }

        return;
      }


      const scene =
        scenes[
          studioSceneIndex
        ];


      const hotspots =
        Array.isArray(
          scene?.hotspots
        )
          ? scene.hotspots
          : [];


      if (
        hotspotCountLabel
      ) {

        hotspotCountLabel.textContent =
          String(
            hotspots.length
          );
      }


      if (
        !hotspots.length
      ) {

        studioHotspotList.innerHTML =
          '<div class="hotspot-empty">No hotspots yet. Activate <strong>Place</strong> and click somewhere inside the panorama.</div>';

        return;
      }


      hotspots.forEach(
        (
          hotspot,
          index
        ) => {

          const row =
            document.createElement(
              "div"
            );


          row.className =
            "hotspot-item";


          if (
            index ===
            selectedHotspotIndex
          ) {

            row.classList.add(
              "is-selected"
            );
          }


          row.addEventListener(
            "click",
            () => {

              selectHotspotForEditing(
                index
              );
            }
          );


          const icon =
            document.createElement(
              "span"
            );


          icon.className =
            "hotspot-dot";


          if (
            hotspot?.type ===
            "navigation"
          ) {

            icon.classList.add(
              "navigation"
            );
          }


          icon.textContent =
            hotspotIcon(
              hotspot
            );


          const copy =
            document.createElement(
              "span"
            );


          copy.className =
            "hotspot-copy";


          const title =
            document.createElement(
              "strong"
            );


          title.textContent =
            hotspot?.title ||
            "Untitled hotspot";


          const meta =
            document.createElement(
              "span"
            );


          meta.textContent =
            [
              String(
                hotspot?.type ||
                "info"
              ).toUpperCase(),

              `${Math.round(
                toNumber(
                  hotspot?.yaw,
                  0
                )
              )}°`,

              `${Math.round(
                toNumber(
                  hotspot?.pitch,
                  0
                )
              )}°`,
            ].join(
              " · "
            );


          copy.appendChild(
            title
          );

          copy.appendChild(
            meta
          );


          const deleteButton =
            document.createElement(
              "button"
            );


          deleteButton.type =
            "button";


          deleteButton.className =
            "hotspot-delete";


          deleteButton.innerHTML =
            '<i class="fa-solid fa-trash"></i>';


          deleteButton.addEventListener(
            "click",
            event => {

              event.stopPropagation();

              deleteHotspot(
                index
              );
            }
          );


          row.appendChild(
            icon
          );

          row.appendChild(
            copy
          );

          row.appendChild(
            deleteButton
          );


          studioHotspotList.appendChild(
            row
          );

        }
      );

    }


    /* ============================================================
       HOTSPOT EDITOR
    ============================================================ */

    function clearHotspotEditor() {

      selectedHotspotIndex =
        -1;


      hotspotType.value =
        "info";

      hotspotTitle.value =
        "";

      hotspotLabel.value =
        "";

      hotspotDescription.value =
        "";

      hotspotYaw.value =
        "0";

      hotspotPitch.value =
        "0";

      hotspotTarget.value =
        "";

      hotspotAction.value =
        "info";

      hotspotUrl.value =
        "";


      if (
        hotspotDraftStatus
      ) {

        hotspotDraftStatus.textContent =
          "READY";
      }


      if (
        addHotspotBtn
      ) {

        addHotspotBtn.innerHTML =
          '<i class="fa-solid fa-plus"></i> Add Hotspot';
      }


      renderStudioHotspotList();
    }


    function selectHotspotForEditing(
      index
    ) {

      if (
        !validSceneIndex(
          studioSceneIndex
        )
      ) {

        return;
      }


      const scene =
        scenes[
          studioSceneIndex
        ];


      const hotspots =
        Array.isArray(
          scene?.hotspots
        )
          ? scene.hotspots
          : [];


      if (
        !hotspots[index]
      ) {

        return;
      }


      selectedHotspotIndex =
        index;


      const hotspot =
        hotspots[
          index
        ];


      hotspotType.value =
        hotspot.type ||
        "info";

      hotspotTitle.value =
        hotspot.title ||
        "";

      hotspotLabel.value =
        hotspot.label ||
        "";

      hotspotDescription.value =
        hotspot.description ||
        "";

      hotspotYaw.value =
        String(
          toNumber(
            hotspot.yaw,
            0
          )
        );

      hotspotPitch.value =
        String(
          toNumber(
            hotspot.pitch,
            0
          )
        );

      hotspotTarget.value =
        Number.isInteger(
          Number(
            hotspot.targetIndex
          )
        )
          ? String(
              hotspot.targetIndex
            )
          : "";

      hotspotAction.value =
        hotspot.action ||
        "info";

      hotspotUrl.value =
        hotspot.url ||
        "";


      if (
        hotspotDraftStatus
      ) {

        hotspotDraftStatus.textContent =
          "EDITING";
      }


      if (
        addHotspotBtn
      ) {

        addHotspotBtn.innerHTML =
          '<i class="fa-solid fa-check"></i> Update Hotspot';
      }


      activateModalTab(
        "hotspots"
      );

      renderStudioHotspotList();
    }


    function deleteHotspot(
      index
    ) {

      if (
        !validSceneIndex(
          studioSceneIndex
        )
      ) {

        return;
      }


      const scene =
        scenes[
          studioSceneIndex
        ];


      const hotspots =
        Array.isArray(
          scene?.hotspots
        )
          ? scene.hotspots
          : [];


      if (
        !hotspots[index]
      ) {

        return;
      }


      const confirmed =
        window.confirm(
          `Delete hotspot "${hotspots[index].title || "this hotspot"}"?`
        );


      if (
        !confirmed
      ) {

        return;
      }


      hotspots.splice(
        index,
        1
      );


      selectedHotspotIndex =
        -1;


      clearHotspotEditor();

      renderStudioHotspots();

      renderStudioHotspotList();

      markStudioDirty(
        "Hotspot deleted. Save the scene to publish the change."
      );
    }


    function upsertHotspotFromEditor() {

      if (
        !validSceneIndex(
          studioSceneIndex
        )
      ) {

        return;
      }


      const scene =
        scenes[
          studioSceneIndex
        ];


      if (
        !Array.isArray(
          scene.hotspots
        )
      ) {

        scene.hotspots =
          [];
      }


      const targetValue =
        hotspotTarget.value;


      const parsedTarget =
        targetValue === ""
          ? null
          : Number(
              targetValue
            );


      const hotspot = {

        type:
          hotspotType.value ||
          "info",

        yaw:
          clamp(
            toNumber(
              hotspotYaw.value,
              0
            ),
            -360,
            360
          ),

        pitch:
          clamp(
            toNumber(
              hotspotPitch.value,
              0
            ),
            -89,
            89
          ),

        title:
          hotspotTitle.value.trim() ||
          "Explore this location",

        label:
          hotspotLabel.value.trim() ||
          hotspotTitle.value.trim() ||
          "Explore",

        description:
          hotspotDescription.value.trim(),

        icon:
          hotspotType.value ===
          "navigation"
            ? "arrow"
            : hotspotType.value ===
              "poi"
            ? "location-dot"
            : "info",

        target:
          Number.isInteger(
            parsedTarget
          )
            ? parsedTarget
            : null,

        targetSceneId:
          Number.isInteger(
            parsedTarget
          ) &&
          scenes[
            parsedTarget
          ]?._id
            ? String(
                scenes[
                  parsedTarget
                ]._id
              )
            : null,

        targetIndex:
          Number.isInteger(
            parsedTarget
          )
            ? parsedTarget
            : null,

        action:
          hotspotAction.value ||
          "info",

        url:
          hotspotUrl.value.trim(),

        visible:
          true,

        interactive:
          true,

        scale:
          1,

      };


      if (
        selectedHotspotIndex >=
          0 &&
        selectedHotspotIndex <
          scene.hotspots.length
      ) {

        scene.hotspots[
          selectedHotspotIndex
        ] =
          {
            ...scene.hotspots[
              selectedHotspotIndex
            ],
            ...hotspot,
          };

      } else {

        scene.hotspots.push(
          hotspot
        );

        selectedHotspotIndex =
          scene.hotspots.length -
          1;
      }


      renderStudioHotspots();

      renderStudioHotspotList();

      updateQuickInspector();

      markStudioDirty(
        "Hotspot staged. Save the scene to publish it."
      );
    }


    addHotspotBtn?.addEventListener(
      "click",
      () => {

        upsertHotspotFromEditor();

      }
    );


    clearHotspotEditorBtn?.addEventListener(
      "click",
      () => {

        clearHotspotEditor();

      }
    );


