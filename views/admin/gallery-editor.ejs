                    class="delete-card-form"
                    method="POST"
                    action="/admin/gallery-editor"
                    onsubmit="return confirm('Delete Scene <%= index + 1 %>? All navigation links targeting this scene will be repaired automatically.');"
                  >


                    <% if (adminCsrfToken) { %>

                      <input
                        type="hidden"
                        name="_csrf"
