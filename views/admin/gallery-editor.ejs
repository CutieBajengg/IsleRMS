      opacity:
        0;

      visibility:
        hidden;

      pointer-events:
        none;

      transition:
        opacity
        220ms
        ease,

        visibility
        220ms
        ease;
    }


    .studio-modal.is-open {

      opacity:
        1;

      visibility:
        visible;

      pointer-events:
        auto;
    }


