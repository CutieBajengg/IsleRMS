<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root { --bg: #071416; --panel: #102326; --line: rgba(255,255,255,.12); --text: #f7fbfb; --muted: #a9bcbd; --gold: #f6d365; --teal: #35d0c5; --danger: #ff7777; }
    * { box-sizing: border-box; }
    body { margin: 0; color: var(--text); background: radial-gradient(circle at top right, #1b4142, var(--bg) 54%); font: 15px/1.5 Arial, sans-serif; }
    .page { max-width: 1200px; margin: auto; padding: 36px 20px 70px; }
    .topbar, .actions { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    h1 { margin: 0 0 8px; font-size: clamp(1.8rem, 4vw, 2.8rem); }
    .intro, .muted { color: var(--muted); }
    .back { color: var(--gold); text-decoration: none; font-weight: 700; }
    .notice { margin: 22px 0; padding: 12px 16px; border-radius: 10px; background: rgba(53,208,197,.14); color: var(--teal); }
    .notice.error { background: rgba(255,119,119,.14); color: var(--danger); }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 20px; margin-top: 28px; }
    .card { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: rgba(16,35,38,.9); box-shadow: 0 18px 40px rgba(0,0,0,.2); }
    .preview { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: #020606; }
    .form { padding: 18px; }
    label { display: block; margin: 12px 0 6px; color: var(--muted); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
    input, select { width: 100%; padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px; background: #091719; color: var(--text); font: inherit; }
    input[type="file"] { padding: 8px; }
    .save { margin-top: 16px; padding: 11px 16px; border: 0; border-radius: 8px; background: var(--gold); color: #171717; font-weight: 700; cursor: pointer; }
    .save:hover { filter: brightness(1.08); }
    @media (max-width: 560px) { .page { padding: 24px 14px 50px; } }
  </style>
</head>
<body>
  <main class="page">
    <div class="topbar">
      <div>
        <h1>Street View Editor</h1>
        <div class="intro">Choose the image shown at each location, then connect its Left, Forward, and Right arrows.</div>
      </div>
      <a class="back" href="/admin/content">Back to content manager</a>
    </div>

    <% if (success) { %><div class="notice">Gallery location saved.</div><% } %>
    <% if (error) { %><div class="notice error">Could not save that gallery location.</div><% } %>

    <% if (galleryImages.length) { %>
      <div class="grid">
        <% galleryImages.forEach((item, index) => { %>
          <article class="card">
            <img class="preview" src="<%= item.image %>" alt="<%= item.title || 'Gallery image' %>" />
            <form class="form" method="POST" action="/admin/gallery-editor" enctype="multipart/form-data">
              <input type="hidden" name="imageIndex" value="<%= index %>" />
              <label for="title-<%= index %>">Location name</label>
              <input id="title-<%= index %>" name="title" value="<%= item.title || '' %>" required />
              <label for="image-<%= index %>">Replace image</label>
              <input id="image-<%= index %>" name="imageFile" type="file" accept="image/*" />

              <% [ ['left', 'Left arrow'], ['forward', 'Forward arrow'], ['right', 'Right arrow'], ['backward', 'Backward arrow'] ].forEach(([direction, labelText]) => { %>
                <label for="<%= direction %>-<%= index %>"><%= labelText %> destination</label>
                <select id="<%= direction %>-<%= index %>" name="<%= direction %>">
                  <option value="">No destination</option>
                  <% galleryImages.forEach((target, targetIndex) => { %>
                    <option value="<%= targetIndex %>" <%= item[direction] !== null && item[direction] !== undefined && Number(item[direction]) === targetIndex ? 'selected' : '' %>>
                      <%= targetIndex + 1 %>. <%= target.title || 'Resort Photo' %>
                    </option>
                  <% }); %>
                </select>
              <% }); %>

              <button class="save" type="submit">Save location</button>
            </form>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <p class="muted">No gallery images exist yet. Add one from the content manager first.</p>
    <% } %>
  </main>
</body>
</html>