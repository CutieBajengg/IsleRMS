    /* ============================================================
       PANORAMA CLICK -> YAW/PITCH
    ============================================================ */

    function handleStudioCanvasPointerDown(
      event
    ) {

      pointerDownX =
        event.clientX;

      pointerDownY =
        event.clientY;

      pointerMoved =
        false;
    }


    function handleStudioCanvasPointerMove(
      event
    ) {

      const dx =
        event.clientX -
        pointerDownX;

      const dy =
        event.clientY -
        pointerDownY;


      if (
        Math.sqrt(
          dx * dx +
          dy * dy
        ) > 8
      ) {

        pointerMoved =
          true;
      }
    }


    function getStudioCanvas() {

      return studioCamera
        ?.sceneEl
        ?.canvas;
    }


    function screenPointToWorldDirection(
      clientX,
      clientY
    ) {

      const canvas =
        getStudioCanvas();


      if (
        !canvas ||
        !studioCamera
      ) {

        return null;
      }


      const rect =
        canvas.getBoundingClientRect();


      if (
        !rect.width ||
        !rect.height
      ) {

        return null;
      }


      const x =
        (
          (
            clientX -
            rect.left
          ) /
          rect.width
        ) *
        2 -
        1;


      const y =
        -(
          (
            (
              clientY -
              rect.top
            ) /
            rect.height
          ) *
          2 -
          1
        );


      const raycaster =
        new AFRAME.THREE.Raycaster();


      const mouse =
        new AFRAME.THREE.Vector2(
          x,
          y
        );


      const cameraObject =
        studioCamera.object3D;


      cameraObject.updateMatrixWorld(
        true
      );


      raycaster.setFromCamera(
        mouse,
        cameraObject
      );


      const direction =
        raycaster.ray.direction
          .clone()
          .normalize();


      return direction;
    }


    function worldDirectionToYawPitch(
      direction
    ) {

      if (
        !direction
      ) {

        return {
          yaw:
            0,

          pitch:
            0,
        };
      }


      const safeY =
        clamp(
          direction.y,
          -1,
          1
        );


      const pitch =
        AFRAME.THREE.MathUtils.radToDeg(
          Math.asin(
            safeY
          )
        );


      const yaw =
        AFRAME.THREE.MathUtils.radToDeg(
          Math.atan2(
            direction.x,
            -direction.z
          )
        );


      return {
        yaw:
          normalizeYaw(
            yaw
          ),

        pitch:
          clamp(
            pitch,
            -89,
            89
          ),
      };
    }


    function handleStudioCanvasClick(
      event
    ) {

      if (
        !isPlacingHotspot
      ) {

        return;
      }


      if (
        pointerMoved
      ) {

        return;
      }


      const direction =
        screenPointToWorldDirection(
          event.clientX,
          event.clientY
        );


      const pose =
        worldDirectionToYawPitch(
          direction
        );


      hotspotYaw.value =
        String(
          Math.round(
            pose.yaw *
            10
          ) /
          10
        );

      hotspotPitch.value =
        String(
          Math.round(
            pose.pitch *
            10
          ) /
          10
        );


      selectedHotspotIndex =
        -1;


      if (
        hotspotDraftStatus
      ) {

        hotspotDraftStatus.textContent =
          "PLACED";
      }


      activateModalTab(
        "hotspots"
      );


      setPlacementMode(
        false
      );


      markStudioDirty(
        "Hotspot position captured. Configure its details and add it."
      );


      hotspotTitle?.focus();
    }


    function bindStudioCanvasPointerEvents() {

      const canvas =
        getStudioCanvas();


      if (
        !canvas ||
        canvas.dataset.studioBound ===
          "true"
      ) {

        return;
      }


      canvas.dataset.studioBound =
        "true";


      canvas.addEventListener(
        "pointerdown",
        handleStudioCanvasPointerDown
      );


      canvas.addEventListener(
        "pointermove",
        handleStudioCanvasPointerMove
      );


      canvas.addEventListener(
        "click",
        handleStudioCanvasClick
      );
    }


    /* ============================================================
       A-FRAME READY
    ============================================================ */

    function waitForSceneCanvas(
      sceneEl,
      callback
    ) {

      if (
        !sceneEl
      ) {

        return;
      }


      if (
        sceneEl.hasLoaded &&
        sceneEl.canvas
      ) {

        callback();

        return;
      }


      sceneEl.addEventListener(
        "loaded",
        () => {

          callback();

        },
        {
          once:
            true,
        }
      );
    }


    const studioSceneEl =
      studioCamera?.sceneEl;


    waitForSceneCanvas(
      studioSceneEl,
      () => {

        bindStudioCanvasPointerEvents();

      }
    );


    const workspaceSceneEl =
      workspaceCamera?.sceneEl;


    waitForSceneCanvas(
      workspaceSceneEl,
      () => {}
    );


    /* ============================================================
       MODAL TABS
    ============================================================ */

