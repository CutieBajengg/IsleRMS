  <!-- ==========================================================
       CLIENT JAVASCRIPT
  =========================================================== -->

  <script>

    "use strict";


    /* ============================================================
       DATA
    ============================================================ */

    const scenes =
      (() => {

        try {

          const element =
            document.getElementById(
              "galleryStudioData"
            );

          if (!element) {
            return [];
          }

          const parsed =
            JSON.parse(
              element.textContent ||
              "[]"
            );

          return Array.isArray(
            parsed
          )
            ? parsed
            : [];

        } catch (error) {

          console.error(
            "Unable to parse gallery studio data:",
            error
          );

          return [];
        }

      })();


    /* ============================================================
       GENERAL STATE
    ============================================================ */

    let selectedSceneIndex =
      scenes.length
        ? 0
        : -1;

    let studioSceneIndex =
      -1;

    let selectedHotspotIndex =
      -1;

    let isPlacingHotspot =
      false;

    let studioDirty =
      false;

    let studioLoaded =
      false;

    let pointerDownX =
      0;

    let pointerDownY =
      0;

    let pointerMoved =
      false;


    /* ============================================================
       DOM
    ============================================================ */

    const quickSceneSelect =
      document.getElementById(
        "quickSceneSelect"
      );

    const quickSceneIndex =
      document.getElementById(
        "quickSceneIndex"
      );

    const quickConnectionList =
      document.getElementById(
        "quickConnectionList"
      );

    const quickPublicBtn =
      document.getElementById(
        "quickPublicBtn"
      );

    const quickHealthList =
      document.getElementById(
        "quickHealthList"
      );

    const healthSpatial =
      document.getElementById(
        "healthSpatial"
      );

    const healthMap =
      document.getElementById(
        "healthMap"
      );

    const healthHotspots =
      document.getElementById(
        "healthHotspots"
      );

    const workspaceSceneTitle =
      document.getElementById(
        "workspaceSceneTitle"
      );

    const workspaceSceneMeta =
      document.getElementById(
        "workspaceSceneMeta"
      );

    const workspaceYaw =
      document.getElementById(
        "workspaceYaw"
      );

    const workspacePitch =
      document.getElementById(
        "workspacePitch"
      );

    const workspaceSky =
      document.getElementById(
        "workspaceSky"
      );

    const workspaceCamera =
      document.getElementById(
        "workspaceCamera"
      );

    const workspaceHint =
      document.getElementById(
        "workspaceHint"
      );

    const workspacePrevBtn =
      document.getElementById(
        "workspacePrevBtn"
      );

    const workspaceNextBtn =
      document.getElementById(
        "workspaceNextBtn"
      );

    const openSelectedSceneBtn =
      document.getElementById(
        "openSelectedSceneBtn"
      );

    const workspaceStudioBtn =
      document.getElementById(
        "workspaceStudioBtn"
      );

    const focusFirstSceneBtn =
      document.getElementById(
        "focusFirstSceneBtn"
      );

    const studioModal =
      document.getElementById(
        "studioModal"
      );

    const studioSky =
      document.getElementById(
        "studioSky"
      );

    const studioCamera =
      document.getElementById(
        "studioCamera"
      );

    const studioHotspots =
      document.getElementById(
        "studioHotspots"
      );

    const studioHeadingRange =
