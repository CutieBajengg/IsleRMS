<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Front Desk | Puffer Isle Admin</title>
    
    <link rel="icon" type="image/png" href="/images/islelogo.png">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/all.min.css">

    <style>
        :root {
            --brand-teal: #1abc9c;
            --success: #2ecc71;
            --error: #e74c3c;
            --pending: #f39c12;
            --card-bg: #161e2d;
            --card-border: rgba(255, 255, 255, 0.08);
            --text-muted: #94a3b8;
            --dark-bg: #0f172a;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--dark-bg);
            color: white;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center; 
            align-items: center;     
            padding: 20px;
        }

        .container { 
            width: 100%;
            max-width: 1200px;
        }

        .header-flex {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 30px;
            padding: 0 10px;
        }

        .header-flex h1 { font-size: 2rem; font-weight: 700; }
        .header-flex h1 span { color: var(--brand-teal); }

        .front-desk-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 30px; 
        }

        .status-card { 
            background: var(--card-bg); 
            border: 1px solid var(--card-border); 
            padding: 25px; 
            border-radius: 24px; 
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            min-height: 550px;
        }

        .status-card h3 {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1.1rem;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--card-border);
        }

        .guest-item {
            display: flex; 
            justify-content: space-between; 
            align-items: center;
            padding: 18px; 
            background: rgba(255,255,255,0.03);
            border-radius: 18px;
            margin-bottom: 15px;
            border: 1px solid transparent;
            transition: 0.3s;
        }
        .guest-item:hover { border-color: var(--brand-teal); background: rgba(26, 188, 156, 0.05); }

        .guest-info strong { display: block; font-size: 1.05rem; margin-bottom: 2px; }
        .guest-info small { color: var(--brand-teal); font-weight: 600; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.5px; }
        
        .guest-meta { font-size: 0.75rem; color: var(--text-muted); margin-top: 6px; }
        .guest-meta i { width: 18px; color: var(--brand-teal); opacity: 0.7; }

        /* Buttons */
        .btn-action {
            border: none; 
            color: white;
            padding: 10px 16px; 
            border-radius: 10px; 
            cursor: pointer; 
            font-weight: 600;
            font-size: 0.8rem;
            transition: 0.3s;
        }
        .btn-checkin { background: var(--brand-teal); }
        .btn-checkout { background: rgba(231, 76, 60, 0.2); color: var(--error); border: 1px solid var(--error); }
        .btn-checkout:hover { background: var(--error); color: white; }

        /* Status Badges */
        .badge { font-size: 0.6rem; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; font-weight: 700; margin-bottom: 5px; display: inline-block; }
        .badge-pending { border: 1px solid var(--pending); color: var(--pending); }
        .badge-active { border: 1px solid var(--success); color: var(--success); }

        .pulse-indicator {
            height: 10px; width: 10px; 
            background: var(--success); 
            border-radius: 50%;
            display: inline-block; 
            margin-right: 8px;
            box-shadow: 0 0 8px var(--success);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.9); opacity: 1; }
            70% { transform: scale(1.3); opacity: 0.5; }
            100% { transform: scale(0.9); opacity: 1; }
        }

        @media (max-width: 950px) {
            .front-desk-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header-flex">
        <div>
            <h1>Front Desk <span>Operations</span></h1>
            <p style="color: var(--text-muted); font-size: 0.85rem;">Live Island Management</p>
        </div>
        <a href="/admin/dashboard" style="text-decoration: none; color: var(--text-muted); font-size: 0.8rem;"><i class="fas fa-arrow-left"></i> Exit to Dashboard</a>
    </div>

    <div class="front-desk-grid">
        
        <div class="status-card">
            <h3><span><i class="fas fa-plane-arrival"></i> Expected Today</span></h3>
            
            <div class="guest-item">
                <div class="guest-info">
                    <span class="badge badge-pending">Pending Approval</span>
                    <strong>John Soledad</strong>
                    <small>Room: Fan Room</small>
                    <div class="guest-meta">
                        <div><i class="fas fa-phone"></i> 09090909009</div>
                        <div><i class="fas fa-umbrella-beach"></i> Cottage Add-on: Yes</div>
                    </div>
                </div>
                <button class="btn-action btn-checkin" onclick="alert('Checking in John Soledad...')">Check In</button>
            </div>

            <div class="guest-item" style="opacity: 0.7;">
                <div class="guest-info">
                    <span class="badge" style="border: 1px solid #7f8c8d; color: #7f8c8d;">Declined</span>
                    <strong>Nathaniel Palafox</strong>
                    <small>Room: Aircon Room</small>
                    <div class="guest-meta">
                        <div><i class="fas fa-phone"></i> 09682959607</div>
                    </div>
                </div>
                <button class="btn-action" style="background: #2d3748; cursor: not-allowed;">Locked</button>
            </div>
        </div>

        <div class="status-card" style="border-top: 4px solid var(--success);">
            <h3>
                <span><span class="pulse-indicator"></span> Currently In-House</span>
                <span style="font-size: 0.8rem; background: rgba(46, 204, 113, 0.1); color: var(--success); padding: 4px 10px; border-radius: 20px;">3 Active</span>
            </h3>
            
            <div class="guest-item">
                <div class="guest-info">
                    <span class="badge badge-active">Verified</span>
                    <strong>John Doe</strong>
                    <small>Room: Aircon Room</small>
                    <div class="guest-meta">
                        <div><i class="fas fa-clock"></i> In: 08:30 AM</div>
                        <div><i class="fas fa-users"></i> Guests: 6</div>
                    </div>
                </div>
                <button class="btn-action btn-checkout" onclick="alert('Processing Checkout for John Doe')">Check Out</button>
            </div>

            <div class="guest-item">
                <div class="guest-info">
                    <span class="badge badge-active">Verified</span>
                    <strong>Alice Wonderland</strong>
                    <small>Room: Fan Room</small>
                    <div class="guest-meta">
                        <div><i class="fas fa-clock"></i> In: 10:15 AM</div>
                        <div><i class="fas fa-key"></i> Key Issued</div>
                    </div>
                </div>
                <button class="btn-action btn-checkout" onclick="alert('Processing Checkout for Alice')">Check Out</button>
            </div>

            <div class="guest-item">
                <div class="guest-info">
                    <span class="badge badge-active">Verified</span>
                    <strong>Bob Marley</strong>
                    <small>Room: Aircon Room</small>
                    <div class="guest-meta">
                        <div><i class="fas fa-clock"></i> In: 11:00 AM</div>
                        <div><i class="fas fa-concierge-bell"></i> Special Request: Extra Pillow</div>
                    </div>
                </div>
                <button class="btn-action btn-checkout" onclick="alert('Processing Checkout for Bob')">Check Out</button>
            </div>

        </div>

    </div>
</div>

</body>
</html>