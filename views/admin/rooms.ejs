<%
  const roomsForClient = Array.isArray(rooms) ? rooms : [];
  const bookingsForClient = Array.isArray(bookings) ? bookings : [];
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#070a0c">

  <!-- Font Awesome is required by the admin navigation partial. -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  >

  <title><%= title || "Room Management" %> | Isle RMS</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --rm-bg: #070a0c;
      --rm-soft: #0c1113;
      --rm-panel: rgba(15, 22, 24, 0.84);
      --rm-panel-strong: rgba(10, 15, 17, 0.96);
      --rm-border: rgba(255, 255, 255, 0.085);
      --rm-border-strong: rgba(255, 255, 255, 0.14);
      --rm-text: #ffffff;
      --rm-soft-text: rgba(255, 255, 255, 0.76);
      --rm-muted: rgba(255, 255, 255, 0.48);
      --rm-faint: rgba(255, 255, 255, 0.28);
      --rm-teal: #00a6a6;
      --rm-teal-light: #1fc7c7;
      --rm-teal-deep: #006f70;
      --rm-gold: #ffd700;
      --rm-gold-soft: #f2cf36;
      --rm-success: #2ecc71;
      --rm-danger: #e85d5d;
      --rm-warning: #f2bd35;
      --rm-info: #4da3ff;
      --rm-xl: 28px;
      --rm-lg: 20px;
      --rm-md: 15px;
      --rm-sm: 10px;
      --rm-shadow: 0 24px 70px rgba(0, 0, 0, 0.38);
      --rm-shadow-soft: 0 12px 32px rgba(0, 0, 0, 0.24);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--rm-text);
      background:
        radial-gradient(circle at 14% 0%, rgba(0, 166, 166, 0.12), transparent 31%),
        radial-gradient(circle at 86% 12%, rgba(255, 215, 0, 0.07), transparent 25%),
        linear-gradient(180deg, #080b0d 0%, #060809 100%);
      font-family: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.22;
      background-image:
        linear-gradient(rgba(255,255,255,0.026) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.026) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: linear-gradient(to bottom, black, transparent 92%);
    }

    ::selection {
      background: rgba(255, 215, 0, 0.24);
      color: #fff;
    }

    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: var(--rm-bg); }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, var(--rm-teal), var(--rm-teal-deep));
      border-radius: 999px;
    }

    button, input, select, textarea { font: inherit; }
    button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }

    :focus-visible {
      outline: 2px solid var(--rm-gold);
      outline-offset: 3px;
    }

    .room-page {
      position: relative;
      width: min(1440px, calc(100% - 34px));
      margin: 0 auto;
      padding: 118px 0 56px;
    }

    .room-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 18px;
    }

    .room-heading { min-width: 0; }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 10px;
      color: var(--rm-muted);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 24px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--rm-teal), var(--rm-gold));
    }

    h1, h2, h3, p { margin: 0; }

    .room-heading h1 {
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(2.3rem, 4vw, 3.8rem);
      line-height: 1;
      letter-spacing: -0.035em;
    }

    .room-heading h1 span { color: var(--rm-teal-light); }

    .room-heading p {
      max-width: 820px;
      margin-top: 12px;
      color: var(--rm-muted);
      font-size: 0.93rem;
      line-height: 1.75;
    }

    .header-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 9px;
      flex-wrap: wrap;
    }

    .status-card {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 46px;
      padding: 0 14px;
      border: 1px solid var(--rm-border);
      border-radius: 14px;
      background: rgba(255,255,255,0.035);
      box-shadow: var(--rm-shadow-soft);
      backdrop-filter: blur(16px);
      color: var(--rm-soft-text);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .status-dot {
      width: 9px;
      height: 9px;
      flex: 0 0 9px;
      border-radius: 50%;
      background: var(--rm-success);
      box-shadow: 0 0 0 5px rgba(46, 204, 113, 0.09), 0 0 18px rgba(46, 204, 113, 0.48);
      animation: pulse 2.3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.1); opacity: 0.72; }
    }

    .live-strip {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      padding: 12px 16px;
      border: 1px solid var(--rm-border);
      border-radius: 14px;
      background: linear-gradient(90deg, rgba(0,166,166,0.08), rgba(255,255,255,0.018));
      color: var(--rm-soft-text);
      font-size: 0.74rem;
    }

    .live-strip strong { color: var(--rm-text); }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 18px;
    }

    .metric-card {
      position: relative;
      overflow: hidden;
      min-height: 124px;
      padding: 18px;
      border: 1px solid var(--rm-border);
      border-radius: var(--rm-lg);
      background: linear-gradient(150deg, rgba(17,25,27,0.92), rgba(10,15,17,0.78));
      box-shadow: var(--rm-shadow-soft);
      backdrop-filter: blur(18px);
    }

    .metric-card::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
    }

    .metric-card::after {
      content: "";
      position: absolute;
      width: 120px;
      height: 120px;
      right: -48px;
      bottom: -62px;
      border-radius: 50%;
      background: rgba(0,166,166,0.1);
      filter: blur(8px);
      pointer-events: none;
    }

    .metric-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .metric-label {
      color: var(--rm-muted);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .metric-icon {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border-radius: 12px;
      border: 1px solid rgba(0,166,166,0.24);
      background: rgba(0,166,166,0.12);
      color: var(--rm-teal-light);
      font-size: 0.96rem;
      font-weight: 800;
    }

    .metric-card:nth-child(2) .metric-icon {
      border-color: rgba(46,204,113,0.2);
      background: rgba(46,204,113,0.09);
      color: #77e8a3;
    }

    .metric-card:nth-child(3) .metric-icon {
      border-color: rgba(77,163,255,0.2);
      background: rgba(77,163,255,0.09);
      color: #76b7ff;
    }

    .metric-card:nth-child(4) .metric-icon {
      border-color: rgba(255,215,0,0.18);
      background: rgba(255,215,0,0.07);
      color: var(--rm-gold-soft);
    }

    .metric-value {
      display: block;
      margin-top: 14px;
      font-size: 1.82rem;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .metric-note {
      display: block;
      margin-top: 5px;
      color: var(--rm-muted);
      font-size: 0.66rem;
    }

    .operation-panel {
      overflow: hidden;
      border: 1px solid var(--rm-border);
      border-radius: var(--rm-xl);
      background: linear-gradient(150deg, rgba(15,22,24,0.9), rgba(8,12,14,0.83));
      box-shadow: var(--rm-shadow);
      backdrop-filter: blur(20px);
    }

    .panel-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 22px 22px 16px;
      border-bottom: 1px solid var(--rm-border);
    }

    .panel-title {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.58rem;
      line-height: 1.15;
    }

    .panel-subtitle {
      max-width: 780px;
      margin-top: 6px;
      color: var(--rm-muted);
      font-size: 0.76rem;
      line-height: 1.65;
    }

    .toolbar {
      display: grid;
      grid-template-columns: minmax(220px, 1.5fr) minmax(160px, 0.65fr) auto;
      gap: 10px;
      padding: 16px 22px;
      border-bottom: 1px solid var(--rm-border);
      background: rgba(255,255,255,0.012);
    }

    .control,
    .control-select {
      width: 100%;
      min-height: 44px;
      padding: 0 13px;
      border: 1px solid var(--rm-border);
      border-radius: 12px;
      outline: none;
      background: rgba(255,255,255,0.035);
      color: var(--rm-text);
      transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
    }

    .control::placeholder { color: rgba(255,255,255,0.31); }

    .control:focus,
    .control-select:focus {
      border-color: rgba(0,166,166,0.64);
      background: rgba(0,166,166,0.055);
      box-shadow: 0 0 0 4px rgba(0,166,166,0.09);
    }

    .control-select option,
    .field select option {
      background: #101517;
      color: #fff;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 15px;
      border: 1px solid transparent;
      border-radius: 12px;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      font-size: 0.74rem;
      font-weight: 800;
      transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease, opacity .18s ease;
    }

    .btn:hover:not(:disabled) { transform: translateY(-1px); }
    .btn:disabled { cursor: not-allowed; opacity: .5; }

    .btn-primary {
      color: #041011;
      background: linear-gradient(135deg, var(--rm-teal-light), var(--rm-teal));
      box-shadow: 0 10px 28px rgba(0,166,166,0.18);
    }

    .btn-secondary {
      color: var(--rm-text);
      border-color: var(--rm-border-strong);
      background: rgba(255,255,255,0.035);
    }

    .btn-danger {
      color: #fff;
      background: linear-gradient(135deg, #bc4747, #8f2e2e);
      box-shadow: 0 10px 24px rgba(232,93,93,0.14);
    }

    .btn-success {
      color: #04140a;
      background: linear-gradient(135deg, #5ae28f, #2ecc71);
      box-shadow: 0 10px 24px rgba(46,204,113,0.14);
    }

    .btn-gold {
      color: #0d0c02;
      background: linear-gradient(135deg, #ffe76c, var(--rm-gold));
      box-shadow: 0 10px 24px rgba(255,215,0,0.12);
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    .room-table {
      width: 100%;
      min-width: 1180px;
      border-collapse: collapse;
    }

    .room-table th {
      padding: 14px 18px;
      border-bottom: 1px solid var(--rm-border);
      color: var(--rm-muted);
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.09em;
      text-align: left;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .room-table td {
      padding: 16px 18px;
      border-bottom: 1px solid rgba(255,255,255,0.052);
      vertical-align: middle;
    }

    .room-table tbody tr { transition: background .18s ease; }
    .room-table tbody tr:hover { background: rgba(255,255,255,0.018); }
    .room-table tbody tr:last-child td { border-bottom: 0; }

    .room-info {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 320px;
    }

    .room-image,
    .room-placeholder {
      width: 72px;
      height: 58px;
      flex: 0 0 72px;
      border-radius: 12px;
    }

    .room-image {
      object-fit: cover;
      border: 1px solid var(--rm-border);
      background: rgba(255,255,255,0.03);
    }

    .room-placeholder {
      display: grid;
      place-items: center;
      border: 1px solid rgba(0,166,166,0.18);
      background: linear-gradient(135deg, rgba(0,166,166,0.12), rgba(255,215,0,0.04));
      color: var(--rm-teal-light);
      font-size: 1rem;
      font-weight: 800;
    }

    .room-name {
      font-size: 0.84rem;
      font-weight: 800;
    }

    .room-description {
      max-width: 430px;
      margin-top: 4px;
      color: var(--rm-muted);
      font-size: 0.67rem;
      line-height: 1.55;
    }

    .type-badge,
    .status-badge {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 0 10px;
      border-radius: 999px;
      font-size: 0.63rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: capitalize;
    }

    .type-badge {
      color: var(--rm-gold-soft);
      border: 1px solid rgba(255,215,0,0.16);
      background: rgba(255,215,0,0.06);
    }

    .status-active {
      color: #8af0b6;
      border: 1px solid rgba(46,204,113,0.18);
      background: rgba(46,204,113,0.08);
    }

    .status-inactive {
      color: #ff9b9b;
      border: 1px solid rgba(232,93,93,0.18);
      background: rgba(232,93,93,0.08);
    }

    .money {
      color: var(--rm-text);
      font-weight: 800;
      white-space: nowrap;
    }

    .muted-cell {
      color: var(--rm-muted);
      font-size: 0.7rem;
    }

    .room-order {
      color: var(--rm-faint);
      font-size: 0.63rem;
    }

    .row-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 7px;
      flex-wrap: wrap;
    }

    .row-actions .btn {
      min-height: 36px;
      padding: 0 10px;
      font-size: 0.63rem;
    }

    .empty-state {
      padding: 64px 24px;
      text-align: center;
    }

    .empty-icon {
      display: grid;
      place-items: center;
      width: 54px;
      height: 54px;
      margin: 0 auto 14px;
      border: 1px solid rgba(0,166,166,0.18);
      border-radius: 16px;
      background: rgba(0,166,166,0.08);
      color: var(--rm-teal-light);
      font-size: 1.2rem;
      font-weight: 800;
    }

    .empty-state h3 {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.35rem;
    }

    .empty-state p {
      max-width: 500px;
      margin: 7px auto 0;
      color: var(--rm-muted);
      font-size: 0.76rem;
      line-height: 1.7;
    }

    .panel-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 22px;
      border-top: 1px solid var(--rm-border);
      color: var(--rm-muted);
      font-size: 0.66rem;
    }

    .modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0,0,0,0.73);
      backdrop-filter: blur(14px);
    }

    .modal.open { display: flex; }

    .modal-card {
      width: min(760px, 100%);
      max-height: min(90vh, 900px);
      overflow-y: auto;
      padding: 24px;
      border: 1px solid var(--rm-border-strong);
      border-radius: 24px;
      background: linear-gradient(160deg, rgba(16,24,26,0.98), rgba(7,11,13,0.98));
      box-shadow: 0 34px 90px rgba(0,0,0,0.52);
    }

    .modal-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 18px;
    }

    .modal-title {
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.72rem;
    }

    .modal-subtitle {
      margin-top: 4px;
      color: var(--rm-muted);
      font-size: 0.72rem;
      line-height: 1.55;
    }

    .icon-btn {
      display: grid;
      place-items: center;
      width: 38px;
      height: 38px;
      border: 1px solid var(--rm-border);
      border-radius: 11px;
      background: rgba(255,255,255,0.035);
      color: var(--rm-text);
      cursor: pointer;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .field.full { grid-column: 1 / -1; }

    .field-label {
      color: var(--rm-soft-text);
      font-size: 0.7rem;
      font-weight: 800;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      min-height: 44px;
      padding: 11px 12px;
      border: 1px solid var(--rm-border);
      border-radius: 12px;
      outline: none;
      background: rgba(255,255,255,0.035);
      color: var(--rm-text);
      transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
    }

    .field textarea { min-height: 120px; resize: vertical; }
    .field input::placeholder,
    .field textarea::placeholder { color: rgba(255,255,255,0.28); }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: rgba(0,166,166,0.64);
      background: rgba(0,166,166,0.055);
      box-shadow: 0 0 0 4px rgba(0,166,166,0.09);
    }

    .field-help {
      color: var(--rm-muted);
      font-size: 0.62rem;
      line-height: 1.5;
    }

    .check-row {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 44px;
      padding: 0 12px;
      border: 1px solid var(--rm-border);
      border-radius: 12px;
      background: rgba(255,255,255,0.028);
    }

    .check-row input {
      width: 16px;
      height: 16px;
      min-height: 0;
      accent-color: var(--rm-teal);
    }

    .check-row label {
      color: var(--rm-soft-text);
      font-size: 0.69rem;
      font-weight: 700;
      cursor: pointer;
    }

    .image-workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .image-dropzone {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 150px;
      padding: 18px;
      border: 1px dashed rgba(0,166,166,0.35);
      border-radius: 16px;
      background: linear-gradient(145deg, rgba(0,166,166,0.07), rgba(255,255,255,0.015));
      text-align: center;
      cursor: pointer;
      transition: border-color .18s ease, background .18s ease, transform .18s ease;
    }

    .image-dropzone:hover,
    .image-dropzone.dragover {
      border-color: var(--rm-teal-light);
      background: rgba(0,166,166,0.10);
      transform: translateY(-1px);
    }

    .image-dropzone-icon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin: 0 auto 10px;
      border-radius: 12px;
      background: rgba(0,166,166,0.12);
      color: var(--rm-teal-light);
      font-size: 1rem;
      font-weight: 800;
    }

    .image-dropzone strong {
      display: block;
      font-size: 0.72rem;
    }

    .image-dropzone span {
      display: block;
      margin-top: 5px;
      color: var(--rm-muted);
      font-size: 0.61rem;
      line-height: 1.5;
    }

    .image-dropzone input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .preview-card {
      min-height: 150px;
      padding: 10px;
      border: 1px solid var(--rm-border);
      border-radius: 16px;
      background: rgba(255,255,255,0.022);
    }

    .preview-card img {
      display: block;
      width: 100%;
      height: 128px;
      object-fit: cover;
      border-radius: 11px;
      background: rgba(255,255,255,0.03);
    }

    .preview-empty {
      display: grid;
      place-items: center;
      width: 100%;
      height: 128px;
      border-radius: 11px;
      background: linear-gradient(135deg, rgba(0,166,166,0.08), rgba(255,215,0,0.03));
      color: var(--rm-muted);
      font-size: 0.66rem;
      text-align: center;
    }

    .image-file-meta {
      margin-top: 7px;
      color: var(--rm-muted);
      font-size: 0.6rem;
      line-height: 1.45;
      word-break: break-word;
    }

    .modal-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 9px;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--rm-border);
    }

    .toast-stack {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 1200;
      display: grid;
      gap: 10px;
      width: min(370px, calc(100% - 36px));
    }

    .toast {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr) auto;
      gap: 10px;
      align-items: start;
      padding: 12px;
      border: 1px solid var(--rm-border-strong);
      border-radius: 14px;
      background: rgba(12,17,19,0.97);
      box-shadow: 0 20px 50px rgba(0,0,0,0.38);
      backdrop-filter: blur(16px);
      animation: toastIn .22s ease;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .toast-icon {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(0,166,166,0.11);
      color: var(--rm-teal-light);
      font-size: 0.88rem;
      font-weight: 800;
    }

    .toast.success .toast-icon { background: rgba(46,204,113,0.1); color: #75e7a2; }
    .toast.error .toast-icon { background: rgba(232,93,93,0.1); color: #ff9090; }
    .toast.warning .toast-icon { background: rgba(242,189,53,0.1); color: var(--rm-warning); }

    .toast strong { display: block; font-size: 0.7rem; }
    .toast p { margin-top: 3px; color: var(--rm-muted); font-size: 0.63rem; line-height: 1.5; }

    .toast-close {
      border: 0;
      background: transparent;
      color: var(--rm-muted);
      cursor: pointer;
      font-size: 0.92rem;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .saving-note {
      margin-right: auto;
      color: var(--rm-muted);
      font-size: 0.63rem;
    }

    @media (max-width: 1160px) {
      .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .toolbar { grid-template-columns: 1fr 1fr; }
      .toolbar .btn { grid-column: 1 / -1; }
    }

    @media (max-width: 900px) {
      .room-page {
        width: min(100% - 22px, 1440px);
        padding-top: 102px;
      }

      .room-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .header-actions { justify-content: flex-start; }
      .image-workspace { grid-template-columns: 1fr; }
    }

    @media (max-width: 650px) {
      .room-page {
        width: min(100% - 16px, 1440px);
        padding-top: 94px;
        padding-bottom: 34px;
      }

      .metric-grid,
      .toolbar,
      .form-grid { grid-template-columns: 1fr; }

      .field.full { grid-column: auto; }

      .panel-head,
      .toolbar,
      .panel-footer,
      .modal-card { padding-left: 16px; padding-right: 16px; }

      .modal { padding: 12px; }
      .modal-card { border-radius: 18px; }
      .panel-footer { align-items: flex-start; flex-direction: column; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>
  <%- include('../partials/navadmin') %>

  <main class="room-page">
    <header class="room-header">
      <div class="room-heading">
        <div class="eyebrow">Puffer Isle Resort · Isle RMS</div>
        <h1>Room <span>Management</span></h1>
        <p>
          Maintain accommodation names, pricing, capacity, inventory, imagery, visibility,
          and booking pressure from one controlled resort operations workspace.
        </p>
      </div>

      <div class="header-actions">
        <div class="status-card">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Inventory services online</span>
        </div>
        <button class="btn btn-secondary" type="button" id="refreshBtn">↻ Refresh</button>
        <button class="btn btn-primary" type="button" id="addRoomBtn">＋ Add Accommodation</button>
      </div>
    </header>

    <div class="live-strip">
      <span class="status-dot" aria-hidden="true"></span>
      <span><strong>Live catalog:</strong> room changes affect the resort accommodation inventory surfaced to booking workflows.</span>
    </div>

    <section class="metric-grid" aria-label="Room metrics">
      <article class="metric-card">
        <div class="metric-top">
          <span class="metric-label">Room Types</span>
          <span class="metric-icon" aria-hidden="true">⌂</span>
        </div>
        <strong class="metric-value" id="metricTotal">0</strong>
        <span class="metric-note">Configured accommodation records</span>
      </article>

      <article class="metric-card">
        <div class="metric-top">
          <span class="metric-label">Active Types</span>
          <span class="metric-icon" aria-hidden="true">✓</span>
        </div>
        <strong class="metric-value" id="metricActive">0</strong>
        <span class="metric-note">Currently visible in active catalog</span>
      </article>

      <article class="metric-card">
        <div class="metric-top">
          <span class="metric-label">Inventory Units</span>
          <span class="metric-icon" aria-hidden="true">▦</span>
        </div>
        <strong class="metric-value" id="metricUnits">0</strong>
        <span class="metric-note">Configured inventory quantity</span>
      </article>

      <article class="metric-card">
        <div class="metric-top">
          <span class="metric-label">Blocking Reservations</span>
          <span class="metric-icon" aria-hidden="true">◷</span>
        </div>
        <strong class="metric-value" id="metricBookings">0</strong>
        <span class="metric-note">Pending through checked-in</span>
      </article>
    </section>

    <section class="operation-panel" aria-labelledby="catalogTitle">
      <div class="panel-head">
        <div>
          <h2 class="panel-title" id="catalogTitle">Accommodation Catalog</h2>
          <p class="panel-subtitle">
            Search, inspect, edit, update imagery, activate, or deactivate accommodations while keeping booking history intact.
          </p>
        </div>
      </div>

      <div class="toolbar">
        <label>
          <span class="sr-only">Search accommodations</span>
          <input class="control" id="searchInput" type="search" placeholder="Search by name, description, or type..." autocomplete="off">
        </label>

        <label>
          <span class="sr-only">Filter status</span>
          <select class="control-select" id="statusFilter">
            <option value="all">All statuses</option>
            <option value="active">Active only</option>
            <option value="inactive">Inactive only</option>
          </select>
        </label>

        <button class="btn btn-secondary" type="button" id="clearFiltersBtn">Clear Filters</button>
      </div>

      <div class="table-wrap">
        <table class="room-table">
          <thead>
            <tr>
              <th>Accommodation</th>
              <th>Type</th>
              <th>Nightly Rate</th>
              <th>Capacity</th>
              <th>Units</th>
              <th>Blocking</th>
              <th>Order</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="roomTableBody"></tbody>
        </table>
      </div>

      <div class="empty-state" id="emptyState" hidden>
        <div class="empty-icon">⌂</div>
        <h3>No accommodations match this view</h3>
        <p>
          Adjust your search or status filter, or create a new accommodation record for the resort catalog.
        </p>
      </div>

      <div class="panel-footer">
        <span id="catalogSummary">0 accommodations shown</span>
        <span>Blocking statuses: pending · accepted · confirmed · checked-in</span>
      </div>
    </section>
  </main>

  <div class="modal" id="roomModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h2 class="modal-title" id="modalTitle">Add Accommodation</h2>
          <p class="modal-subtitle" id="modalSubtitle">Create a new catalog record for the resort.</p>
        </div>
        <button class="icon-btn" type="button" id="closeModalBtn" aria-label="Close dialog">×</button>
      </div>

      <form id="roomForm" novalidate>
        <input type="hidden" id="roomId" value="">

        <div class="form-grid">
          <div class="field">
            <label class="field-label" for="roomName">Accommodation Name</label>
            <input id="roomName" type="text" maxlength="150" required placeholder="e.g. Aircon Room">
          </div>

          <div class="field">
            <label class="field-label" for="roomType">Type</label>
            <select id="roomType">
              <option value="room">Room</option>
              <option value="cottage">Cottage</option>
              <option value="suite">Suite</option>
              <option value="villa">Villa</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="field">
            <label class="field-label" for="roomPrice">Nightly Rate (₱)</label>
            <input id="roomPrice" type="number" min="0" step="0.01" required placeholder="3500">
          </div>

          <div class="field">
            <label class="field-label" for="roomCapacity">Maximum Guests</label>
            <input id="roomCapacity" type="number" min="1" step="1" required placeholder="8">
          </div>

          <div class="field">
            <label class="field-label" for="roomQuantity">Inventory Units</label>
            <input id="roomQuantity" type="number" min="1" step="1" required placeholder="1">
            <span class="field-help">How many units of this accommodation type are maintained in inventory.</span>
          </div>

          <div class="field">
            <label class="field-label" for="roomSortOrder">Display Order</label>
            <input id="roomSortOrder" type="number" min="0" step="1" placeholder="0">
            <span class="field-help">Lower values appear earlier in resort catalog ordering.</span>
          </div>

          <div class="field full">
            <label class="field-label" for="roomDescription">Description</label>
            <textarea id="roomDescription" maxlength="2000" placeholder="Describe the accommodation, atmosphere, amenities, or guest experience..."></textarea>
          </div>

          <div class="field full">
            <label class="field-label" for="roomImageUrl">Image URL</label>
            <input id="roomImageUrl" type="url" maxlength="500" placeholder="https://example.com/room.jpg or /images/room1.jpg">
            <span class="field-help">You can keep an existing image URL, paste a URL, or upload a JPG/PNG/WEBP file below. Uploaded files are stored by the admin room-image endpoint.</span>
          </div>

          <div class="field full">
            <div class="image-workspace">
              <label class="image-dropzone" id="imageDropzone" for="roomImageFile">
                <div>
                  <div class="image-dropzone-icon" aria-hidden="true">↑</div>
                  <strong>Upload Accommodation Image</strong>
                  <span>Click or drag a JPG, PNG, or WEBP file here. Maximum 8 MB.</span>
                </div>
                <input id="roomImageFile" type="file" accept="image/jpeg,image/png,image/webp">
              </label>

              <div class="preview-card">
                <img id="imagePreview" alt="Accommodation image preview" hidden>
                <div class="preview-empty" id="previewEmpty">No image selected</div>
                <div class="image-file-meta" id="imageFileMeta">Current image: none</div>
              </div>
            </div>
          </div>

          <div class="field full">
            <div class="check-row">
              <input id="roomActive" type="checkbox" checked>
              <label for="roomActive">Active and available in the accommodation catalog</label>
            </div>
          </div>
        </div>

        <div class="modal-actions">
          <span class="saving-note" id="savingNote"></span>
          <button class="btn btn-secondary" type="button" id="cancelModalBtn">Cancel</button>
          <button class="btn btn-primary" type="submit" id="saveRoomBtn">Save Accommodation</button>
        </div>
      </form>
    </div>
  </div>

  <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true"></div>

  <script type="application/json" id="roomData"><%- JSON.stringify(roomsForClient).replace(/</g, "\\u003c") %></script>
  <script type="application/json" id="bookingData"><%- JSON.stringify(bookingsForClient).replace(/</g, "\\u003c") %></script>

  <script>
    (() => {
      "use strict";

      const parseJsonScript = (id) => {
        const element = document.getElementById(id);
        if (!element) return [];

        try {
          const parsed = JSON.parse(element.textContent || "[]");
          return Array.isArray(parsed) ? parsed : [];
        } catch (error) {
          console.error(`Failed to parse ${id}:`, error);
          return [];
        }
      };

      const rooms = parseJsonScript("roomData");
      const bookings = parseJsonScript("bookingData");
      const blockingStatuses = new Set([
        "pending",
        "accepted",
        "confirmed",
        "checked-in"
      ]);

      const metricTotal = document.getElementById("metricTotal");
      const metricActive = document.getElementById("metricActive");
      const metricUnits = document.getElementById("metricUnits");
      const metricBookings = document.getElementById("metricBookings");
      const roomTableBody = document.getElementById("roomTableBody");
      const emptyState = document.getElementById("emptyState");
      const catalogSummary = document.getElementById("catalogSummary");
      const searchInput = document.getElementById("searchInput");
      const statusFilter = document.getElementById("statusFilter");
      const clearFiltersBtn = document.getElementById("clearFiltersBtn");
      const refreshBtn = document.getElementById("refreshBtn");
      const addRoomBtn = document.getElementById("addRoomBtn");

      const roomModal = document.getElementById("roomModal");
      const roomForm = document.getElementById("roomForm");
      const closeModalBtn = document.getElementById("closeModalBtn");
      const cancelModalBtn = document.getElementById("cancelModalBtn");
      const modalTitle = document.getElementById("modalTitle");
      const modalSubtitle = document.getElementById("modalSubtitle");
      const saveRoomBtn = document.getElementById("saveRoomBtn");
      const savingNote = document.getElementById("savingNote");

      const roomId = document.getElementById("roomId");
      const roomName = document.getElementById("roomName");
      const roomType = document.getElementById("roomType");
      const roomPrice = document.getElementById("roomPrice");
      const roomCapacity = document.getElementById("roomCapacity");
      const roomQuantity = document.getElementById("roomQuantity");
      const roomSortOrder = document.getElementById("roomSortOrder");
      const roomDescription = document.getElementById("roomDescription");
      const roomImageUrl = document.getElementById("roomImageUrl");
      const roomImageFile = document.getElementById("roomImageFile");
      const roomActive = document.getElementById("roomActive");
      const imageDropzone = document.getElementById("imageDropzone");
      const imagePreview = document.getElementById("imagePreview");
      const previewEmpty = document.getElementById("previewEmpty");
      const imageFileMeta = document.getElementById("imageFileMeta");
      const toastStack = document.getElementById("toastStack");

      const IMAGE_MAX_BYTES = 8 * 1024 * 1024;
      const ALLOWED_IMAGE_TYPES = new Set([
        "image/jpeg",
        "image/png",
        "image/webp"
      ]);

      function text(value) {
        return value === null || value === undefined ? "" : String(value);
      }

      function roomIdValue(room) {
        return text(room?._id || room?.id).trim();
      }

      function roomNameValue(room) {
        return text(room?.displayName || room?.name || room?.roomName || "Unnamed accommodation").trim();
      }

      function roomTypeValue(room) {
        return text(room?.type || "room").trim() || "room";
      }

      function roomPriceValue(room) {
        const value = Number(room?.price);
        return Number.isFinite(value) && value >= 0 ? value : 0;
      }

      function roomCapacityValue(room) {
        const value = Number(room?.maxGuests);
        return Number.isInteger(value) && value >= 1 ? value : 1;
      }

      function roomQuantityValue(room) {
        const value = Number(room?.quantity);
        return Number.isInteger(value) && value >= 1 ? value : 1;
      }

      function roomSortValue(room) {
        const value = Number(room?.sortOrder);
        return Number.isInteger(value) && value >= 0 ? value : 0;
      }

      function bookingRoomValue(booking) {
        return text(
          booking?.room ||
          booking?.roomName ||
          booking?.roomType ||
          booking?.accommodation
        ).trim().toLowerCase();
      }

      function blockingBookingCount(room) {
        const name = roomNameValue(room).toLowerCase();
        if (!name) return 0;

        return bookings.filter((booking) => {
          const status = text(booking?.status).trim().toLowerCase();
          if (!blockingStatuses.has(status)) return false;
          return bookingRoomValue(booking) === name;
        }).length;
      }

      function formatMoney(value) {
        const amount = Number(value);
        if (!Number.isFinite(amount)) return "₱0";
        return `₱${amount.toLocaleString("en-PH", { maximumFractionDigits: 2 })}`;
      }

      function escapeHtml(value) {
        return text(value)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      function normalizeRoomType(value) {
        const normalized = text(value).trim().toLowerCase();
        const allowed = new Set(["room", "cottage", "suite", "villa", "other"]);
        return allowed.has(normalized) ? normalized : "room";
      }

      function getCsrfToken() {
        const globalToken = window.IsleRMS && window.IsleRMS.csrfToken;
        if (globalToken) return text(globalToken).trim();

        const input = document.querySelector('input[name="_csrf"], input[name="csrfToken"]');
        return input ? text(input.value).trim() : "";
      }

      function jsonHeaders() {
        const headers = {
          "Accept": "application/json",
          "Content-Type": "application/json"
        };

        const token = getCsrfToken();
        if (token) headers["X-CSRF-Token"] = token;
        return headers;
      }

      function uploadHeaders() {
        const headers = {
          "Accept": "application/json"
        };

        const token = getCsrfToken();
        if (token) headers["X-CSRF-Token"] = token;
        return headers;
      }

      async function readResponse(response) {
        const raw = await response.text();
        let data = null;

        try {
          data = raw ? JSON.parse(raw) : null;
        } catch (_) {
          data = null;
        }

        if (!response.ok) {
          const message = data?.message || `Request failed with HTTP ${response.status}.`;
          const error = new Error(message);
          error.code = data?.code || "REQUEST_FAILED";
          error.status = response.status;
          error.requestId = data?.requestId || null;
          throw error;
        }

        return data || {};
      }

      function showToast(title, message, type = "info") {
        const toast = document.createElement("div");
        toast.className = `toast ${type}`;

        const icon = type === "success" ? "✓" : type === "error" ? "!" : type === "warning" ? "⚠" : "i";

        toast.innerHTML = `
          <div class="toast-icon">${icon}</div>
          <div>
            <strong>${escapeHtml(title)}</strong>
            <p>${escapeHtml(message)}</p>
          </div>
          <button class="toast-close" type="button" aria-label="Dismiss notification">×</button>
        `;

        toast.querySelector(".toast-close")?.addEventListener("click", () => toast.remove());
        toastStack.appendChild(toast);
        window.setTimeout(() => toast.remove(), 5200);
      }

      function updateMetrics() {
        const total = rooms.length;
        const active = rooms.filter((room) => room?.active !== false).length;
        const units = rooms.reduce((sum, room) => sum + roomQuantityValue(room), 0);
        const blocking = bookings.filter((booking) => blockingStatuses.has(text(booking?.status).trim().toLowerCase())).length;

        metricTotal.textContent = String(total);
        metricActive.textContent = String(active);
        metricUnits.textContent = String(units);
        metricBookings.textContent = String(blocking);
      }

      function filteredRooms() {
        const query = text(searchInput.value).trim().toLowerCase();
        const selectedStatus = text(statusFilter.value).trim().toLowerCase();

        return rooms.filter((room) => {
          const active = room?.active !== false;
          const haystack = [
            roomNameValue(room),
            roomTypeValue(room),
            text(room?.description)
          ].join(" ").toLowerCase();

          const searchMatch = !query || haystack.includes(query);
          const statusMatch =
            selectedStatus === "all" ||
            (selectedStatus === "active" && active) ||
            (selectedStatus === "inactive" && !active);

          return searchMatch && statusMatch;
        });
      }

      function renderRooms() {
        const list = filteredRooms();
        roomTableBody.innerHTML = "";

        list.forEach((room) => {
          const id = roomIdValue(room);
          const name = roomNameValue(room);
          const type = roomTypeValue(room);
          const description = text(room?.description).trim() || "No description provided.";
          const price = roomPriceValue(room);
          const capacity = roomCapacityValue(room);
          const quantity = roomQuantityValue(room);
          const sortOrder = roomSortValue(room);
          const active = room?.active !== false;
          const image = text(room?.image || room?.imageUrl || room?.photo || room?.photoUrl).trim();
          const blocking = blockingBookingCount(room);
          const firstLetter = name.charAt(0).toUpperCase() || "R";

          const row = document.createElement("tr");
          row.dataset.id = id;

          row.innerHTML = `
            <td>
              <div class="room-info">
                ${image
                  ? `<img class="room-image" src="${escapeHtml(image)}" alt="${escapeHtml(name)}" loading="lazy">`
                  : `<div class="room-placeholder" aria-hidden="true">${escapeHtml(firstLetter)}</div>`
                }
                <div>
                  <div class="room-name">${escapeHtml(name)}</div>
                  <div class="room-description">${escapeHtml(description)}</div>
                </div>
              </div>
            </td>
            <td><span class="type-badge">${escapeHtml(type)}</span></td>
            <td>
              <span class="money">${formatMoney(price)}</span>
              <div class="muted-cell">per night</div>
            </td>
            <td><span class="muted-cell">Up to ${capacity} guest${capacity === 1 ? "" : "s"}</span></td>
            <td><span class="muted-cell">${quantity}</span></td>
            <td><span class="muted-cell">${blocking}</span></td>
            <td><span class="room-order">${sortOrder}</span></td>
            <td><span class="status-badge ${active ? "status-active" : "status-inactive"}">${active ? "Active" : "Inactive"}</span></td>
            <td>
              <div class="row-actions">
                <button class="btn btn-secondary" type="button" data-action="edit" data-id="${escapeHtml(id)}">Edit</button>
                ${active
                  ? `<button class="btn btn-danger" type="button" data-action="deactivate" data-id="${escapeHtml(id)}">Deactivate</button>`
                  : `<button class="btn btn-success" type="button" data-action="activate" data-id="${escapeHtml(id)}">Activate</button>`
                }
              </div>
            </td>
          `;

          roomTableBody.appendChild(row);
        });

        const empty = list.length === 0;
        emptyState.hidden = !empty;
        catalogSummary.textContent = `${list.length} accommodation${list.length === 1 ? "" : "s"} shown`;
      }

      function clearImageSelection() {
        roomImageFile.value = "";
        imageDropzone.classList.remove("dragover");
      }

      function setPreview(url, metaText) {
        if (!url) {
          imagePreview.hidden = true;
          imagePreview.removeAttribute("src");
          previewEmpty.hidden = false;
          imageFileMeta.textContent = metaText || "Current image: none";
          return;
        }

        imagePreview.hidden = false;
        imagePreview.src = url;
        previewEmpty.hidden = true;
        imageFileMeta.textContent = metaText || `Current image: ${url}`;
      }

      function updateUrlPreview() {
        const url = roomImageUrl.value.trim();
        if (url) {
          setPreview(url, `Image URL: ${url}`);
        } else if (!roomImageFile.files.length) {
          setPreview("", "Current image: none");
        }
      }

      function updateFilePreview(file) {
        if (!file) {
          updateUrlPreview();
          return;
        }

        if (!ALLOWED_IMAGE_TYPES.has(file.type)) {
          clearImageSelection();
          showToast("Invalid image", "Please choose a JPG, PNG, or WEBP image.", "error");
          return;
        }

        if (file.size > IMAGE_MAX_BYTES) {
          clearImageSelection();
          showToast("Image too large", "The selected image exceeds the 8 MB upload limit.", "error");
          return;
        }

        const objectUrl = URL.createObjectURL(file);
        setPreview(objectUrl, `${file.name} · ${(file.size / 1024 / 1024).toFixed(2)} MB · ready to upload`);
      }

      function resetForm() {
        roomForm.reset();
        roomId.value = "";
        roomType.value = "room";
        roomPrice.value = "";
        roomCapacity.value = "1";
        roomQuantity.value = "1";
        roomSortOrder.value = "0";
        roomDescription.value = "";
        roomImageUrl.value = "";
        roomActive.checked = true;
        clearImageSelection();
        setPreview("", "Current image: none");
        savingNote.textContent = "";
      }

      function openModal(room = null) {
        resetForm();

        if (room) {
          modalTitle.textContent = "Edit Accommodation";
          modalSubtitle.textContent = "Update catalog details without changing booking history.";
          saveRoomBtn.textContent = "Save Changes";

          roomId.value = roomIdValue(room);
          roomName.value = roomNameValue(room);
          roomType.value = normalizeRoomType(roomTypeValue(room));
          roomPrice.value = String(roomPriceValue(room));
          roomCapacity.value = String(roomCapacityValue(room));
          roomQuantity.value = String(roomQuantityValue(room));
          roomSortOrder.value = String(roomSortValue(room));
          roomDescription.value = text(room?.description).trim();
          roomImageUrl.value = text(room?.image || room?.imageUrl || room?.photo || room?.photoUrl).trim();
          roomActive.checked = room?.active !== false;

          if (roomImageUrl.value) {
            setPreview(roomImageUrl.value, `Current image: ${roomImageUrl.value}`);
          }
        } else {
          modalTitle.textContent = "Add Accommodation";
          modalSubtitle.textContent = "Create a new catalog record for the resort.";
          saveRoomBtn.textContent = "Save Accommodation";
        }

        roomModal.classList.add("open");
        roomModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        window.setTimeout(() => roomName.focus(), 50);
      }

      function closeModal() {
        roomModal.classList.remove("open");
        roomModal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        clearImageSelection();
      }

      function buildPayload() {
        return {
          name: roomName.value.trim(),
          type: normalizeRoomType(roomType.value),
          price: Number(roomPrice.value),
          maxGuests: Number(roomCapacity.value),
          quantity: Number(roomQuantity.value),
          sortOrder: Number(roomSortOrder.value || 0),
          description: roomDescription.value.trim(),
          image: roomImageUrl.value.trim(),
          active: roomActive.checked
        };
      }

      function validatePayload(payload) {
        if (!payload.name) {
          return { ok: false, field: roomName, message: "Accommodation name is required." };
        }

        if (!Number.isFinite(payload.price) || payload.price < 0) {
          return { ok: false, field: roomPrice, message: "Nightly rate must be a valid non-negative amount." };
        }

        if (!Number.isInteger(payload.maxGuests) || payload.maxGuests < 1) {
          return { ok: false, field: roomCapacity, message: "Maximum guests must be at least 1." };
        }

        if (!Number.isInteger(payload.quantity) || payload.quantity < 1) {
          return { ok: false, field: roomQuantity, message: "Inventory units must be at least 1." };
        }

        if (!Number.isInteger(payload.sortOrder) || payload.sortOrder < 0) {
          return { ok: false, field: roomSortOrder, message: "Display order must be 0 or greater." };
        }

        if (payload.image && payload.image.length > 500) {
          return { ok: false, field: roomImageUrl, message: "The image URL is too long." };
        }

        return { ok: true };
      }

      async function createOrUpdateRoom(payload, id) {
        const endpoint = id
          ? `/admin/rooms/update/${encodeURIComponent(id)}`
          : "/admin/rooms/create";

        const response = await fetch(endpoint, {
          method: "POST",
          credentials: "same-origin",
          headers: jsonHeaders(),
          body: JSON.stringify(payload)
        });

        return readResponse(response);
      }

      async function uploadRoomImage(id, file) {
        if (!id || !file) return null;

        const response = await fetch(`/admin/rooms/${encodeURIComponent(id)}/image`, {
          method: "POST",
          credentials: "same-origin",
          headers: uploadHeaders(),
          body: file
        });

        return readResponse(response);
      }

      async function saveRoom(event) {
        event.preventDefault();

        const payload = buildPayload();
        const validation = validatePayload(payload);

        if (!validation.ok) {
          showToast("Validation", validation.message, "error");
          validation.field?.focus();
          return;
        }

        const file = roomImageFile.files[0] || null;
        const id = roomId.value.trim();
        const originalText = saveRoomBtn.textContent;

        saveRoomBtn.disabled = true;
        saveRoomBtn.textContent = id ? "Saving..." : "Creating...";
        savingNote.textContent = file ? "Saving catalog record and image..." : "Saving catalog record...";

        try {
          const result = await createOrUpdateRoom(payload, id);
          const savedRoom = result?.room || null;
          const savedId = id || roomIdValue(savedRoom);

          if (!savedId) {
            throw new Error("The server saved the room but did not return its ID.");
          }

          if (file) {
            savingNote.textContent = "Uploading accommodation image...";
            const imageResult = await uploadRoomImage(savedId, file);
            if (!imageResult?.success) {
              showToast(
                "Room saved with warning",
                imageResult?.message || "The accommodation was saved, but the image could not be uploaded.",
                "warning"
              );
            } else {
              showToast("Accommodation saved", "Room details and image were updated successfully.", "success");
            }
          } else {
            showToast("Accommodation saved", result.message || "Room details were updated successfully.", "success");
          }

          closeModal();
          window.setTimeout(() => window.location.reload(), 400);
        } catch (error) {
          console.error("Room save error:", error);
          const prefix = error?.requestId ? `${error.message} (Request ${error.requestId})` : error.message;
          showToast("Unable to save room", prefix || "The accommodation could not be saved.", "error");
        } finally {
          saveRoomBtn.disabled = false;
          saveRoomBtn.textContent = originalText;
          savingNote.textContent = "";
        }
      }

      async function changeRoomState(id, active) {
        const room = rooms.find((entry) => roomIdValue(entry) === id);
        if (!room) {
          showToast("Room not found", "The selected accommodation is no longer available in this view.", "error");
          return;
        }

        const name = roomNameValue(room);
        const message = active
          ? `Activate ${name} and return it to the active accommodation catalog?`
          : `Deactivate ${name}? Existing booking history will remain unchanged.`;

        if (!window.confirm(message)) return;

        try {
          const endpoint = active
            ? `/admin/rooms/update/${encodeURIComponent(id)}`
            : `/admin/rooms/delete/${encodeURIComponent(id)}`;

          const options = active
            ? {
                method: "POST",
                credentials: "same-origin",
                headers: jsonHeaders(),
                body: JSON.stringify({
                  name,
                  type: normalizeRoomType(roomTypeValue(room)),
                  price: roomPriceValue(room),
                  maxGuests: roomCapacityValue(room),
                  quantity: roomQuantityValue(room),
                  sortOrder: roomSortValue(room),
                  description: text(room?.description).trim(),
                  image: text(room?.image || room?.imageUrl || room?.photo || room?.photoUrl).trim(),
                  active: true
                })
              }
            : {
                method: "POST",
                credentials: "same-origin",
                headers: jsonHeaders()
              };

          const response = await fetch(endpoint, options);
          const data = await readResponse(response);

          showToast(
            active ? "Accommodation activated" : "Accommodation deactivated",
            data.message || (active ? "Accommodation activated successfully." : "Accommodation deactivated successfully."),
            "success"
          );

          window.setTimeout(() => window.location.reload(), 400);
        } catch (error) {
          console.error("Room state update error:", error);
          showToast("Unable to update room", error.message || "The accommodation state could not be changed.", "error");
        }
      }

      roomTableBody.addEventListener("click", (event) => {
        const button = event.target.closest("button[data-action]");
        if (!button) return;

        const action = text(button.dataset.action);
        const id = text(button.dataset.id);

        if (action === "edit") {
          const room = rooms.find((entry) => roomIdValue(entry) === id);
          if (room) openModal(room);
          return;
        }

        if (action === "activate") {
          changeRoomState(id, true);
          return;
        }

        if (action === "deactivate") {
          changeRoomState(id, false);
        }
      });

      addRoomBtn.addEventListener("click", () => openModal());
      closeModalBtn.addEventListener("click", closeModal);
      cancelModalBtn.addEventListener("click", closeModal);
      roomForm.addEventListener("submit", saveRoom);

      refreshBtn.addEventListener("click", () => {
        refreshBtn.disabled = true;
        refreshBtn.textContent = "↻ Refreshing...";
        window.location.reload();
      });

      clearFiltersBtn.addEventListener("click", () => {
        searchInput.value = "";
        statusFilter.value = "all";
        renderRooms();
      });

      searchInput.addEventListener("input", renderRooms);
      statusFilter.addEventListener("change", renderRooms);

      roomImageUrl.addEventListener("input", updateUrlPreview);
      roomImageFile.addEventListener("change", () => updateFilePreview(roomImageFile.files[0] || null));

      ["dragenter", "dragover"].forEach((eventName) => {
        imageDropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          event.stopPropagation();
          imageDropzone.classList.add("dragover");
        });
      });

      ["dragleave", "drop"].forEach((eventName) => {
        imageDropzone.addEventListener(eventName, (event) => {
          event.preventDefault();
          event.stopPropagation();
          imageDropzone.classList.remove("dragover");
        });
      });

      imageDropzone.addEventListener("drop", (event) => {
        const file = event.dataTransfer?.files?.[0] || null;
        if (!file) return;

        try {
          const transfer = new DataTransfer();
          transfer.items.add(file);
          roomImageFile.files = transfer.files;
        } catch (_) {
          /* Browser fallback: the visible file picker remains available. */
        }

        updateFilePreview(file);
      });

      roomModal.addEventListener("click", (event) => {
        if (event.target === roomModal) closeModal();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && roomModal.classList.contains("open")) {
          closeModal();
        }
      });

      window.addEventListener("beforeunload", () => {
        const currentSrc = imagePreview.getAttribute("src") || "";
        if (currentSrc.startsWith("blob:")) {
          URL.revokeObjectURL(currentSrc);
        }
      });

      updateMetrics();
      renderRooms();
    })();
  </script>
</body>
</html>
