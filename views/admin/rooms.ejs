<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Room Management | IsleRMS</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    .container {
      width: min(1200px, 92%);
      margin: 30px auto;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 25px;
    }

    .header h1 {
      margin: 0 0 6px;
      font-size: 30px;
    }

    .header p {
      margin: 0;
      color: #6b7280;
    }

    .btn {
      border: 0;
      border-radius: 8px;
      padding: 11px 16px;
      cursor: pointer;
      font-weight: 600;
      transition: opacity 0.2s ease;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .btn-primary {
      background: #2563eb;
      color: white;
    }

    .btn-secondary {
      background: #e5e7eb;
      color: #111827;
    }

    .btn-danger {
      background: #dc2626;
      color: white;
    }

    .btn-warning {
      background: #f59e0b;
      color: white;
    }

    .btn-success {
      background: #16a34a;
      color: white;
    }

    .card {
      background: white;
      border-radius: 14px;
      box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
      padding: 22px;
      margin-bottom: 24px;
    }

    .table-wrapper {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 14px 12px;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: middle;
    }

    th {
      font-size: 13px;
      text-transform: uppercase;
      color: #6b7280;
      letter-spacing: 0.04em;
    }

    td {
      font-size: 14px;
    }

    .room-image {
      width: 70px;
      height: 52px;
      object-fit: cover;
      border-radius: 8px;
      background: #e5e7eb;
    }

    .status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .status-active {
      background: #dcfce7;
      color: #166534;
    }

    .status-inactive {
      background: #fee2e2;
      color: #991b1b;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .actions .btn {
      padding: 7px 10px;
      font-size: 12px;
    }

    .empty {
      text-align: center;
      padding: 35px;
      color: #6b7280;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
    }

    .modal.show {
      display: flex;
    }

    .modal-content {
      width: min(600px, 100%);
      background: white;
      border-radius: 14px;
      padding: 25px;
      max-height: 90vh;
      overflow-y: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-header h2 {
      margin: 0;
    }

    .close {
      border: 0;
      background: transparent;
      font-size: 28px;
      cursor: pointer;
      color: #6b7280;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-weight: 600;
      font-size: 14px;
    }

    input,
    textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font: inherit;
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    input:focus,
    textarea:focus {
      outline: none;
      border-color: #2563eb;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .checkbox-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .checkbox-group input {
      width: auto;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 20px;
    }

    .message {
      display: none;
      margin-bottom: 20px;
      padding: 12px 15px;
      border-radius: 8px;
      font-size: 14px;
    }

    .message.show {
      display: block;
    }

    .message.success {
      background: #dcfce7;
      color: #166534;
    }

    .message.error {
      background: #fee2e2;
      color: #991b1b;
    }

    .price {
      font-weight: 700;
    }

    @media (max-width: 700px) {
      .header {
        flex-direction: column;
        align-items: flex-start;
      }

      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>

</head>

<body>

  <div class="container">

```
<div class="header">
  <div>
    <h1>Room Management</h1>
    <p>Manage your resort rooms, prices, capacity, and availability.</p>
  </div>

  <button
    type="button"
    class="btn btn-primary"
    id="addRoomButton"
  >
    + Add Room
  </button>
</div>

<div id="message" class="message"></div>

<div class="card">
  <div class="table-wrapper">

    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Room</th>
          <th>Price / Night</th>
          <th>Capacity</th>
          <th>Quantity</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody id="roomsTableBody">

        <% if (rooms && rooms.length) { %>

          <% rooms.forEach(room => { %>

            <tr>

              <td>
                <% if (room.image) { %>

                  <img
                    src="<%= room.image %>"
                    alt="<%= room.name %>"
                    class="room-image"
                  >

                <% } else { %>

                  <div class="room-image"></div>

                <% } %>
              </td>

              <td>
                <strong>
                  <%= room.name %>
                </strong>

                <% if (room.description) { %>
                  <div style="color:#6b7280;margin-top:4px;">
                    <%= room.description %>
                  </div>
                <% } %>
              </td>

              <td class="price">
                ₱<%= Number(room.price || 0).toLocaleString() %>
              </td>

              <td>
                <%= room.maxGuests || 0 %> guests
              </td>

              <td>
                <%= room.quantity || 0 %>
              </td>

              <td>

                <% if (room.active) { %>

                  <span class="status status-active">
                    Active
                  </span>

                <% } else { %>

                  <span class="status status-inactive">
                    Inactive
                  </span>

                <% } %>

              </td>

              <td>
                <div class="actions">

                  <button
                    type="button"
                    class="btn btn-primary edit-room-btn"
                    data-id="<%= room._id %>"
                    data-name="<%= room.name || '' %>"
                    data-price="<%= room.price ?? '' %>"
                    data-max-guests="<%= room.maxGuests ?? '' %>"
                    data-quantity="<%= room.quantity ?? 1 %>"
                    data-sort-order="<%= room.sortOrder ?? 0 %>"
                    data-image="<%= room.image || '' %>"
                    data-description="<%= room.description || '' %>"
                    data-active="<%= room.active !== false ? 'true' : 'false' %>"
                  >
                    Edit
                  </button>

                  <button
                    type="button"
                    class="btn <%= room.active ? 'btn-warning' : 'btn-success' %> toggle-room-btn"
                    data-id="<%= room._id %>"
                    data-active="<%= room.active ? 'true' : 'false' %>"
                  >
                    <%= room.active ? 'Deactivate' : 'Activate' %>
                  </button>

                  <button
                    type="button"
                    class="btn btn-danger delete-room-btn"
                    data-id="<%= room._id %>"
                    data-name="<%= room.name || '' %>"
                  >
                    Delete
                  </button>

                </div>
              </td>

            </tr>

          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="7" class="empty">
              No rooms have been added yet.
            </td>
          </tr>

        <% } %>

      </tbody>
    </table>

  </div>
</div>
```

  </div>

  <!-- ROOM MODAL -->

  <div id="roomModal" class="modal">

```
<div class="modal-content">

  <div class="modal-header">

    <h2 id="modalTitle">
      Add Room
    </h2>

    <button
      type="button"
      class="close"
      id="closeModalButton"
    >
      &times;
    </button>

  </div>


  <form id="roomForm">

    <input
      type="hidden"
      id="roomId"
    >


    <div class="form-group">

      <label for="name">
        Room Name
      </label>

      <input
        type="text"
        id="name"
        required
        maxlength="100"
        placeholder="e.g. Aircon Room"
      >

    </div>


    <div class="form-row">

      <div class="form-group">

        <label for="price">
          Price per Night
        </label>

        <input
          type="number"
          id="price"
          min="0"
          step="0.01"
          required
          placeholder="3500"
        >

      </div>


      <div class="form-group">

        <label for="maxGuests">
          Maximum Guests
        </label>

        <input
          type="number"
          id="maxGuests"
          min="1"
          step="1"
          required
          placeholder="8"
        >

      </div>

    </div>


    <div class="form-row">

      <div class="form-group">

        <label for="quantity">
          Number of Rooms
        </label>

        <input
          type="number"
          id="quantity"
          min="1"
          step="1"
          value="1"
          required
        >

      </div>


      <div class="form-group">

        <label for="sortOrder">
          Sort Order
        </label>

        <input
          type="number"
          id="sortOrder"
          min="0"
          step="1"
          value="0"
        >

      </div>

    </div>


    <div class="form-group">

      <label for="image">
        Image Path / URL
      </label>

      <input
        type="text"
        id="image"
        maxlength="500"
        placeholder="/images/room1.jpg"
      >

    </div>


    <div class="form-group">

      <label for="description">
        Description
      </label>

      <textarea
        id="description"
        maxlength="2000"
        placeholder="Describe the room..."
      ></textarea>

    </div>


    <div class="form-group checkbox-group">

      <input
        type="checkbox"
        id="active"
        checked
      >

      <label
        for="active"
        style="margin:0;"
      >
        Room is active and available for booking
      </label>

    </div>


    <div class="form-actions">

      <button
        type="button"
        class="btn btn-secondary"
        id="cancelModalButton"
      >
        Cancel
      </button>

      <button
        type="submit"
        class="btn btn-primary"
      >
        Save Room
      </button>

    </div>

  </form>

</div>
```

  </div>

  <script>
    const modal = document.getElementById("roomModal");
    const form = document.getElementById("roomForm");
    const message = document.getElementById("message");

    const addRoomButton = document.getElementById("addRoomButton");
    const closeModalButton = document.getElementById("closeModalButton");
    const cancelModalButton = document.getElementById("cancelModalButton");


    function showMessage(text, type = "success") {
      message.textContent = text;
      message.className = `message show ${type}`;

      setTimeout(() => {
        message.className = "message";
      }, 4000);
    }


    function openAddModal() {
      document.getElementById("modalTitle").textContent = "Add Room";

      form.reset();

      document.getElementById("roomId").value = "";
      document.getElementById("quantity").value = "1";
      document.getElementById("sortOrder").value = "0";
      document.getElementById("active").checked = true;

      modal.classList.add("show");
    }


    function closeModal() {
      modal.classList.remove("show");
    }


    function editRoomFromButton(button) {
      const id = button.dataset.id || "";
      const name = button.dataset.name || "";
      const price = button.dataset.price || "";
      const maxGuests = button.dataset.maxGuests || "";
      const quantity = button.dataset.quantity || "1";
      const sortOrder = button.dataset.sortOrder || "0";
      const image = button.dataset.image || "";
      const description = button.dataset.description || "";
      const active = button.dataset.active === "true";


      document.getElementById("modalTitle").textContent = "Edit Room";

      document.getElementById("roomId").value = id;
      document.getElementById("name").value = name;
      document.getElementById("price").value = price;
      document.getElementById("maxGuests").value = maxGuests;
      document.getElementById("quantity").value = quantity;
      document.getElementById("sortOrder").value = sortOrder;
      document.getElementById("image").value = image;
      document.getElementById("description").value = description;
      document.getElementById("active").checked = active;

      modal.classList.add("show");
    }


    async function saveRoom(event) {
      event.preventDefault();


      const id = document.getElementById("roomId").value.trim();


      const data = {
        name: document.getElementById("name").value.trim(),

        price: Number(
          document.getElementById("price").value
        ),

        maxGuests: Number(
          document.getElementById("maxGuests").value
        ),

        quantity: Number(
          document.getElementById("quantity").value
        ),

        sortOrder: Number(
          document.getElementById("sortOrder").value || 0
        ),

        image: document.getElementById("image").value.trim(),

        description: document
          .getElementById("description")
          .value
          .trim(),

        active: document.getElementById("active").checked
      };


      try {

        const response = await fetch(
          id
            ? `/admin/api/rooms/${id}`
            : "/admin/api/rooms",
          {
            method: id ? "PUT" : "POST",

            headers: {
              "Content-Type": "application/json"
            },

            body: JSON.stringify(data)
          }
        );


        let result = {};

        try {
          result = await response.json();
        } catch (jsonError) {
          result = {};
        }


        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            "Unable to save room."
          );
        }


        showMessage(
          id
            ? "Room updated successfully."
            : "Room added successfully."
        );


        closeModal();


        setTimeout(() => {
          window.location.reload();
        }, 700);

      } catch (error) {

        showMessage(
          error.message || "An unexpected error occurred.",
          "error"
        );

      }
    }


    async function toggleRoom(id, currentlyActive) {

      const action = currentlyActive
        ? "deactivate"
        : "activate";


      const confirmed = confirm(
        `Are you sure you want to ${action} this room?`
      );


      if (!confirmed) {
        return;
      }


      try {

        const response = await fetch(
          `/admin/api/rooms/${id}/status`,
          {
            method: "PATCH",

            headers: {
              "Content-Type": "application/json"
            },

            body: JSON.stringify({
              active: !currentlyActive
            })
          }
        );


        let result = {};

        try {
          result = await response.json();
        } catch (jsonError) {
          result = {};
        }


        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            "Unable to change room status."
          );
        }


        window.location.reload();

      } catch (error) {

        showMessage(
          error.message || "Unable to change room status.",
          "error"
        );

      }
    }


    async function deleteRoom(id, name) {

      const confirmed = confirm(
        `Delete "${name}"?\n\n` +
        `If this room has booking history, ` +
        `the system may require you to deactivate it instead.`
      );


      if (!confirmed) {
        return;
      }


      try {

        const response = await fetch(
          `/admin/api/rooms/${id}`,
          {
            method: "DELETE"
          }
        );


        let result = {};

        try {
          result = await response.json();
        } catch (jsonError) {
          result = {};
        }


        if (!response.ok) {
          throw new Error(
            result.error ||
            result.message ||
            "Unable to delete room."
          );
        }


        showMessage(
          "Room deleted successfully."
        );


        setTimeout(() => {
          window.location.reload();
        }, 700);

      } catch (error) {

        showMessage(
          error.message || "Unable to delete room.",
          "error"
        );

      }
    }


    /*
     * BUTTON EVENTS
     */

    addRoomButton.addEventListener(
      "click",
      openAddModal
    );


    closeModalButton.addEventListener(
      "click",
      closeModal
    );


    cancelModalButton.addEventListener(
      "click",
      closeModal
    );


    form.addEventListener(
      "submit",
      saveRoom
    );


    document.querySelectorAll(".edit-room-btn").forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {
            editRoomFromButton(button);
          }
        );

      }
    );


    document.querySelectorAll(".toggle-room-btn").forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const id = button.dataset.id;
            const currentlyActive =
              button.dataset.active === "true";

            toggleRoom(
              id,
              currentlyActive
            );

          }
        );

      }
    );


    document.querySelectorAll(".delete-room-btn").forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const id = button.dataset.id;
            const name = button.dataset.name || "this room";

            deleteRoom(
              id,
              name
            );

          }
        );

      }
    );


    window.addEventListener(
      "click",
      function (event) {

        if (event.target === modal) {
          closeModal();
        }

      }
    );


    window.addEventListener(
      "keydown",
      function (event) {

        if (event.key === "Escape") {
          closeModal();
        }

      }
    );
  </script>

</body>
</html>
