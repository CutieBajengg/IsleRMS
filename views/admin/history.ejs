              No special requests.
            </div>

          </div>

        </div>

      </div>


      <div class="modal-footer">

        <button
          type="button"
          class="modal-btn secondary"
          onclick="closeBookingModal()"
        >
          Close
        </button>

      </div>

    </div>

  </div>


  <!-- ========================================================
       TOAST
       ======================================================== -->

  <div
    class="toast-container"
    id="toastContainer"
  ></div>


  <!-- ========================================================
       JAVASCRIPT
       ======================================================== -->

  <!-- ========================================================
       BOOKING DATA FOR CLIENT-SIDE DETAILS MODAL
       ======================================================== -->

  <script
    type="application/json"
    id="bookingDataJson"
  ><%- JSON.stringify(Array.isArray(allBookings) ? allBookings : []).replace(/</g, "\\u003c") %></script>


  <script>

    "use strict";


    /* ========================================================
       ELEMENTS
       ======================================================== */

    const searchInput =
      document.getElementById(
        "searchInput"
      );

    const statusFilter =
      document.getElementById(
        "statusFilter"
      );

    const sortFilter =
      document.getElementById(
        "sortFilter"
      );

    const bookingBody =
      document.getElementById(
        "bookingBody"
      );

    const visibleCount =
      document.getElementById(
        "visibleCount"
      );

    const recordCount =
      document.getElementById(
        "recordCount"
      );

    const clearFiltersButton =
      document.getElementById(
        "clearFilters"
      );

    const noResults =
      document.getElementById(
        "noResults"
      );


    /* ========================================================
       BOOKING DATA
       ======================================================== */

    const bookingDataElement =
      document.getElementById("bookingDataJson");

    let bookingData = Object.create(null);

    if (bookingDataElement) {

      try {

        const rawBookingData =
          JSON.parse(
            bookingDataElement.textContent || "[]"
          );

        if (Array.isArray(rawBookingData)) {

          rawBookingData.forEach(
            booking => {

              const id =
                booking &&
                booking._id
                  ? String(booking._id)
                  : "";

              if (!id) {
                return;
              }

              bookingData[id] = booking;

            }
          );

        }

      } catch (error) {

        console.error(
          "Failed to parse booking data:",
          error
        );

      }

    }


    /* ========================================================
       FORMATTERS
       ======================================================== */

    function formatDate(value) {

      if (!value) {
        return "Not specified";
      }

      const date =
        new Date(value);

      if (
        Number.isNaN(
          date.getTime()
        )
      ) {
        return "Invalid date";
      }

      return date.toLocaleDateString(
        "en-US",
        {
          month: "long",
          day: "numeric",
          year: "numeric"
        }
      );

    }


    function formatDateTime(value) {

      if (!value) {
        return "Not recorded";
      }

      const date =
        new Date(value);

      if (
        Number.isNaN(
          date.getTime()
        )
      ) {
        return "Invalid date";
      }

      return date.toLocaleString(
        "en-US",
        {
          month: "short",
          day: "numeric",
          year: "numeric",
          hour: "numeric",
          minute: "2-digit"
        }
      );

    }


    function formatCurrency(value) {

      return "₱" +
        Number(
          value || 0
        ).toLocaleString(
          "en-PH",
          {
            minimumFractionDigits: 0,
            maximumFractionDigits: 2
          }
        );

    }


    function capitalize(value) {

      if (!value) {
        return "";
      }

      return (
        value.charAt(0).toUpperCase() +
        value.slice(1)
      );

    }


    /* ========================================================
       ROW HELPERS
       ======================================================== */

    function getRows() {

      return Array.from(
        document.querySelectorAll(
          ".booking-row"
        )
      );

    }


    /* ========================================================
       FILTERING
       ======================================================== */

    function filterTable() {

      const search =
        (
          searchInput?.value ||
          ""
        )
          .trim()
          .toLowerCase();

      const selectedStatus =
        statusFilter?.value ||
        "all";

      const rows =
        getRows();

      let visible = 0;


      rows.forEach(
        row => {

          const searchable =
            (
              row.dataset.search ||
              ""
            ).toLowerCase();

          const status =
            row.dataset.status ||
            "pending";


          const matchesSearch =
            !search ||
            searchable.includes(
              search
            );


          const matchesStatus =
            selectedStatus === "all" ||
            status === selectedStatus;


          const shouldShow =
            matchesSearch &&
            matchesStatus;


          row.style.display =
            shouldShow
              ? ""
              : "none";


          if (shouldShow) {
            visible++;
          }

        }
      );


      if (visibleCount) {
        visibleCount.textContent =
          visible;
      }


      if (recordCount) {
        recordCount.textContent =
          rows.length;
      }


      if (noResults) {

        noResults.style.display =
          rows.length > 0 &&
          visible === 0
            ? "table-row"
            : "none";

      }


      updateClearButton();

    }


    /* ========================================================
       SORTING
       ======================================================== */

    function sortTable() {

      const rows =
        getRows();

      const sort =
        sortFilter?.value ||
        "newest";


      rows.sort(
        (a, b) => {

          const aCreated =
            Number(
              a.dataset.created ||
              0
            );

          const bCreated =
            Number(
              b.dataset.created ||
              0
            );

          const aCheckin =
            Number(
              a.dataset.checkin ||
              0
            );

          const bCheckin =
            Number(
              b.dataset.checkin ||
              0
            );

          const aPrice =
            Number(
              a.dataset.price ||
              0
            );

          const bPrice =
            Number(
              b.dataset.price ||
              0
            );


          switch (sort) {

            case "oldest":
              return (
                aCreated -
                bCreated
              );


            case "checkin":

              if (
                aCheckin === 0
              ) {
                return 1;
              }

              if (
                bCheckin === 0
              ) {
                return -1;
              }

              return (
                aCheckin -
                bCheckin
              );


            case "price-high":

              return (
                bPrice -
                aPrice
              );


            case "price-low":

              return (
                aPrice -
                bPrice
              );


            case "newest":

            default:

              return (
                bCreated -
                aCreated
              );

          }

        }
      );


      rows.forEach(
        row => {

          bookingBody.appendChild(
            row
          );

        }
      );


      filterTable();

    }


    /* ========================================================
       RESET
       ======================================================== */

    function resetFilters() {

      if (searchInput) {
        searchInput.value = "";
      }

      if (statusFilter) {
        statusFilter.value =
          "all";
      }

      if (sortFilter) {
        sortFilter.value =
          "newest";
      }

      sortTable();

      filterTable();

    }


    function updateClearButton() {

      if (!clearFiltersButton) {
        return;
      }

      const hasFilters =
        (
          searchInput?.value ||
          ""
        ).trim() !== "" ||
        (
          statusFilter?.value ||
          "all"
        ) !== "all";


      clearFiltersButton.classList.toggle(
        "visible",
        hasFilters
      );

    }


    /* ========================================================
       STATISTICS
       ======================================================== */

    function calculateStatistics() {

      const rows =
        getRows();

      let pending = 0;

      let accepted = 0;

      let declined = 0;


      rows.forEach(
        row => {

          const status =
            row.dataset.status ||
            "pending";


          if (
            status === "pending"
          ) {
            pending++;
          }


          if (
            status === "accepted"
          ) {
            accepted++;
          }


          if (
            status === "declined"
          ) {
            declined++;
          }

        }
      );


      const pendingElement =
        document.getElementById(
          "pendingRecords"
        );

      const acceptedElement =
        document.getElementById(
          "acceptedRecords"
        );

      const declinedElement =
        document.getElementById(
          "declinedRecords"
        );


      if (pendingElement) {
        pendingElement.textContent =
          pending;
      }


      if (acceptedElement) {
        acceptedElement.textContent =
          accepted;
      }


      if (declinedElement) {
        declinedElement.textContent =
          declined;
      }

    }


    /* ========================================================
       BOOKING DETAILS
       ======================================================== */

    function openBooking(
      bookingId
    ) {

      const booking =
        bookingData[
          String(bookingId)
        ];


      if (!booking) {

        showToast(
          "error",
          "Booking unavailable",
          "The reservation details could not be loaded."
        );

        return;

      }


      const setText =
        (
          id,
          value
        ) => {

          const element =
            document.getElementById(
              id
            );

          if (element) {
            element.textContent =
              value;
          }

        };


      setText(
        "modalBookingId",
        "Reservation #" +
        booking.id
      );


      setText(
        "detailGuest",
        booking.guest
      );


      setText(
        "detailEmail",
        booking.email
      );


      setText(
        "detailContact",
        booking.contact
      );


      setText(
        "detailGuests",
        booking.guests +
        (
          booking.guests === 1
            ? " guest"
            : " guests"
        )
      );


      setText(
        "detailRoom",
        booking.room
      );


      setText(
        "detailAddon",
        booking.addon
          ? "Seaside Cottage included"
          : "No add-on"
      );


      setText(
        "detailCheckin",
        formatDate(
          booking.checkin
        )
      );


      setText(
        "detailCheckout",
        formatDate(
          booking.checkout
        )
      );


      setText(
        "detailStatus",
        capitalize(
          booking.status
        )
      );


      setText(
        "detailPrice",
        formatCurrency(
          booking.price
        )
      );


      setText(
        "detailRequests",
        booking.requests ||
        "No special requests."
      );


      setText(
        "detailCheckinStatus",
        booking.checkedIn
          ? (
              booking.checkInTime
                ? "Checked in — " +
                  formatDateTime(
                    booking.checkInTime
                  )
                : "Checked in"
            )
          : "Not checked in"
      );


      setText(
        "detailCreated",
        formatDateTime(
          booking.createdAt
        )
      );


      const modal =
        document.getElementById(
          "bookingModal"
        );


      if (modal) {

        modal.classList.add(
          "open"
        );

        document.body.style.overflow =
          "hidden";

      }

    }


    function closeBookingModal() {

      const modal =
        document.getElementById(
          "bookingModal"
        );


      if (modal) {

        modal.classList.remove(
          "open"
        );

      }


      document.body.style.overflow =
        "";

    }


    /* ========================================================
       STATUS UPDATE
       ======================================================== */

    async function updateStatus(
      bookingId,
      newStatus,
      button
    ) {

      const booking =
        bookingData[
          String(bookingId)
        ];


      if (!booking) {

        showToast(
          "error",
          "Booking unavailable",
          "The selected reservation could not be found."
        );

        return;

      }


      const actionLabel =
        newStatus === "accepted"
          ? "accept"
          : "decline";


      const confirmed =
        window.confirm(
          `Are you sure you want to ${actionLabel} this booking?`
        );


      if (!confirmed) {
        return;
      }


      const row =
        document.getElementById(
          `row-${bookingId}`
        );


      const actionButtons =
        row
          ? row.querySelectorAll(
              ".action-btn"
            )
          : [];


      actionButtons.forEach(
        btn => {
          btn.disabled = true;
        }
      );


      const originalHTML =
        button
          ? button.innerHTML
          : "";


      if (button) {

        button.innerHTML =
          '<i class="fa-solid fa-spinner fa-spin"></i>';

      }


      try {

        const response =
          await fetch(
            "/admin/booking/update-status",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",

                "Accept":
                  "application/json"
              },

              body:
                JSON.stringify({
                  bookingId:
                    bookingId,

                  status:
                    newStatus
                })
            }
          );


        let data;


        try {

          data =
            await response.json();

        } catch (jsonError) {

          throw new Error(
            "The server returned an invalid response."
          );

        }


        /* ====================================================
           ROOM CONFLICT
           ==================================================== */

        if (
          response.status === 409 &&
          data.code ===
            "ROOM_ALREADY_BOOKED"
        ) {

          showToast(
            "warning",
            "Room unavailable",
            data.message ||
              "This room is already booked for the selected dates."
          );


          actionButtons.forEach(
            btn => {
              btn.disabled = false;
            }
          );


          if (button) {
            button.innerHTML =
              originalHTML;
          }


          return;

        }


        /* ====================================================
           GENERAL ERROR
           ==================================================== */

        if (
          !response.ok ||
          !data.success
        ) {

          throw new Error(
            data.message ||
            "The booking status could not be updated."
          );

        }


        /* ====================================================
           UPDATE LOCAL DATA
           ==================================================== */

        booking.status =
          newStatus;


        /* ====================================================
           UPDATE ROW
           ==================================================== */

        if (row) {

          row.dataset.status =
            newStatus;


          const pill =
            document.getElementById(
              `pill-${bookingId}`
            );


          if (pill) {

            const icon =
              newStatus === "accepted"
                ? "fa-circle-check"
                : newStatus === "declined"
                ? "fa-circle-xmark"
                : "fa-clock";


            pill.className =
              `status status-${newStatus}`;


            pill.innerHTML = `
              <i class="fa-solid ${icon}"></i>
              <span>
                ${escapeHTML(
                  capitalize(
                    newStatus
                  )
                )}
              </span>
            `;

          }


          /* ================================================
             REMOVE DECISION BUTTONS
             ================================================ */

          actionButtons.forEach(
            btn => {

              if (
                !btn.classList.contains(
                  "action-view"
                )
              ) {

                btn.remove();

              }

            }
          );

        }


        showToast(
          "success",
          "Booking updated",
          `Reservation successfully marked as ${newStatus}.`
        );


        calculateStatistics();

        filterTable();


      } catch (error) {

        console.error(
          "Booking status update error:",
          error
        );


        showToast(
          "error",
          "Update failed",
          error.message ||
            "Unable to update the booking."
        );


        actionButtons.forEach(
          btn => {
            btn.disabled = false;
          }
        );


        if (button) {

          button.innerHTML =
            originalHTML;

        }

      }

    }


    /* ========================================================
       TOAST
       ======================================================== */

    function showToast(
      type,
      title,
      message
    ) {

      const container =
        document.getElementById(
          "toastContainer"
        );


      if (!container) {
        return;
      }


      const toast =
        document.createElement(
          "div"
        );


      const icon =
        type === "success"
          ? "fa-circle-check"
          : type === "warning"
          ? "fa-triangle-exclamation"
          : "fa-circle-xmark";


      toast.className =
        `toast ${type}`;


      const iconElement =
        document.createElement(
          "div"
        );

      iconElement.className =
        "toast-icon";

      iconElement.innerHTML =
        `<i class="fa-solid ${icon}"></i>`;


      const content =
        document.createElement(
          "div"
        );

      content.className =
        "toast-content";


      const titleElement =
        document.createElement(
          "strong"
        );

      titleElement.textContent =
        title;


      const messageElement =
        document.createElement(
          "span"
        );

      messageElement.textContent =
        message;


      content.appendChild(
        titleElement
      );

      content.appendChild(
        messageElement
      );


      toast.appendChild(
        iconElement
      );

      toast.appendChild(
        content
      );


      container.appendChild(
        toast
      );


      setTimeout(
        () => {

          toast.style.opacity =
            "0";

          toast.style.transform =
            "translateY(10px)";


          setTimeout(
            () => {

              toast.remove();

            },
            250
          );

        },
        4500
      );

    }


    /* ========================================================
       HTML ESCAPE
       ======================================================== */

    function escapeHTML(
      value
    ) {

      return String(
        value ?? ""
      )

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* ========================================================
       EVENTS
       ======================================================== */

    if (searchInput) {

      searchInput.addEventListener(
        "input",
        filterTable
      );

    }


    if (statusFilter) {

      statusFilter.addEventListener(
        "change",
        filterTable
      );

    }


    if (sortFilter) {

      sortFilter.addEventListener(
        "change",
        sortTable
      );

    }


    const bookingModal =
      document.getElementById(
        "bookingModal"
      );


    if (bookingModal) {

      bookingModal.addEventListener(
        "click",
        function(event) {

          if (
            event.target ===
            this
          ) {

            closeBookingModal();

          }

        }
      );

    }


    document.addEventListener(
      "keydown",
      function(event) {

        if (
          event.key === "Escape"
        ) {

          closeBookingModal();

        }

      }
    );


    /* ========================================================
       INITIALIZE
       ======================================================== */

    calculateStatistics();

    sortTable();

    filterTable();

  </script>

</body>
</html>