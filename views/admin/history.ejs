              —
            </div>

          </div>


          <div class="detail-card">

            <div class="detail-label">
              Check-out
            </div>

            <div
              class="detail-value"
              id="detailCheckout"
            >
              —
            </div>

          </div>


          <div class="detail-card">

            <div class="detail-label">
              Status
            </div>

            <div
              class="detail-value"
              id="detailStatus"
            >
              —
            </div>

          </div>


          <div class="detail-card">

            <div class="detail-label">
              Total Price
            </div>

            <div
              class="detail-value highlight"
              id="detailPrice"
            >
              —
            </div>

          </div>


          <div class="detail-card">

            <div class="detail-label">
              Check-in Status
            </div>

            <div
              class="detail-value"
              id="detailCheckinStatus"
            >
              —
            </div>

          </div>


          <div class="detail-card">

            <div class="detail-label">
              Booking Created
            </div>

            <div
              class="detail-value"
              id="detailCreated"
            >
              —
            </div>

          </div>


          <div class="detail-card full">

            <div class="detail-label">
              Special Requests
            </div>

            <div
              class="detail-value"
