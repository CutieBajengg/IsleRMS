<%
/* ============================================================
 * PUFFER ISLE RESORT | IsleRMS
 * views/admin/users.ejs
 *
 * Customer Intelligence / CRM-style admin page.
 * Designed to work with the existing adminRoutes /users route.
 *
 * Expected server-side variables (defensively optional):
 *   users, admin, csrfToken
 *
 * Important compatibility notes:
 * - EJS is intentionally kept OUT of the executable JavaScript block.
 * - Customer data is serialized through hidden <textarea> elements.
 * - The page uses booking VALUE terminology rather than claiming
 *   that reservations represent money actually paid.
 * ============================================================ */

const sourceUsers =
  typeof users !== "undefined" && Array.isArray(users) ? users : [];

const adminSource =
  typeof admin !== "undefined" && admin && typeof admin === "object"
    ? admin
    : {};

function clean(value, fallback = "—") {
  if (value === null || value === undefined) return fallback;
  const text = String(value).trim();
  return text ? text : fallback;
}

function firstValue(...values) {
  for (const value of values) {
    if (
      value !== undefined &&
      value !== null &&
      String(value).trim() !== ""
    ) {
      return value;
    }
  }
  return null;
}

function firstNumber(...values) {
  for (const value of values) {
    const num = Number(value);
    if (Number.isFinite(num)) return num;
  }
  return 0;
}

function asDate(value) {
  if (!value) return null;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? null : date;
}

function isoDate(value) {
  const date = asDate(value);
  return date ? date.toISOString() : "";
}

function normalizeStatus(value, fallback = "active") {
  return clean(value, fallback)
    .toLowerCase()
    .replace(/[_\s]+/g, "-");
}

function normalizeUser(user) {
  const source = user && typeof user === "object" ? user : {};
  const summary =
    source.bookingSummary ||
    source.summary ||
    source.bookingStats ||
    source.stats ||
    {};
  const bookingArray = Array.isArray(source.bookings) ? source.bookings : [];

  const firstName = clean(
    firstValue(source.firstName, source.givenName),
    ""
  );
  const lastName = clean(
    firstValue(source.lastName, source.familyName),
    ""
  );

  const constructedName = [
    firstName && firstName !== "—" ? firstName : "",
    lastName && lastName !== "—" ? lastName : ""
  ]
    .filter(Boolean)
    .join(" ")
    .trim();

  const fullname = clean(
    firstValue(
      source.fullname,
      source.fullName,
      source.name,
      constructedName,
      source.username,
      source.email
    ),
    "Guest"
  );

  const totalBookings = Math.max(
    0,
    Math.round(
      firstNumber(
        summary.totalBookings,
        summary.bookingCount,
        summary.count,
        source.totalBookings,
        source.bookingCount,
        source.bookingsCount,
        bookingArray.length
      )
    )
  );

  const totalSpent = Math.max(
    0,
    firstNumber(
      summary.totalSpent,
      summary.totalSpend,
      summary.totalBookingValue,
      summary.totalRevenue,
      summary.bookingValue,
      summary.spent,
      summary.amountSpent,
      source.totalSpent,
      source.totalSpend,
      source.bookingValue,
      source.totalBookingValue,
      source.totalRevenue
    )
  );

  const completedBookings = Math.max(
    0,
    Math.round(
      firstNumber(
        summary.completedBookings,
        summary.completed,
        source.completedBookings
      )
    )
  );

  const cancelledBookings = Math.max(
    0,
    Math.round(
      firstNumber(
        summary.cancelledBookings,
        summary.cancelled,
        source.cancelledBookings
      )
    )
  );

  const pendingBookings = Math.max(
    0,
    Math.round(
      firstNumber(
        summary.pendingBookings,
        summary.pending,
        source.pendingBookings
      )
    )
  );

  const activeBookings = Math.max(
    0,
    Math.round(
      firstNumber(
        summary.activeBookings,
        summary.active,
        source.activeBookings
      )
    )
  );

  const averageBookingValue =
    totalBookings > 0 ? totalSpent / totalBookings : 0;

  const lastBooking = firstValue(
    summary.lastBooking,
    summary.lastBookingAt,
    summary.lastActivity,
    source.lastBooking,
    source.lastBookingAt,
    source.lastActivity,
    source.updatedAt
  );

  const memberLevel = clean(
    firstValue(
      source.memberLevel,
      source.membershipLevel,
      source.tier,
      source.level
    ),
    "Guest"
  );

  const rawStatus = firstValue(source.status, source.accountStatus);
  const accountFallback =
    source.active === false || source.isActive === false ? "inactive" : "active";
  const status = normalizeStatus(rawStatus, accountFallback);

  const emailVerified = Boolean(
    source.emailVerified === true ||
    source.emailVerified === "true" ||
    source.verified === true ||
    source.isVerified === true
  );

  return {
    id: clean(firstValue(source._id, source.id, source.userId), ""),
    fullname,
    email: clean(source.email, "No email"),
    phone: clean(
      firstValue(source.phone, source.contact, source.mobile),
      "Not provided"
    ),
    username: clean(source.username, "Not set"),
    status,
    memberLevel,
    emailVerified,
    totalBookings,
    totalSpent,
    completedBookings,
    cancelledBookings,
    pendingBookings,
    activeBookings,
    averageBookingValue,
    lastBookingAt: isoDate(lastBooking),
    createdAt: isoDate(
      firstValue(source.createdAt, source.registeredAt, source.joinedAt)
    ),
    lastLoginAt: isoDate(firstValue(source.lastLoginAt, source.lastLogin)),
    failedLoginAttempts: Math.max(
      0,
      Math.round(firstNumber(source.failedLoginAttempts))
    ),
    lockedUntil: isoDate(source.lockedUntil),
    avatar: clean(
      firstValue(source.avatar, source.profileImage, source.photo),
      ""
    ),
    bookingCountLabel:
      totalBookings === 1 ? "1 booking" : `${totalBookings} bookings`
  };
}

const userRows = sourceUsers
  .map(normalizeUser)
  .filter((user) => user.id || user.email || user.fullname);

const overview = userRows.reduce(
  (acc, user) => {
    acc.customers += 1;
    if (user.status === "active") acc.active += 1;
    if (user.emailVerified) acc.verified += 1;
    acc.bookings += user.totalBookings;
    acc.spent += user.totalSpent;
    if (user.totalBookings >= 2) acc.returning += 1;
    return acc;
  },
  {
    customers: 0,
    active: 0,
    verified: 0,
    bookings: 0,
    spent: 0,
    returning: 0
  }
);

const avgPerCustomer =
  overview.customers > 0 ? overview.spent / overview.customers : 0;
const avgBookingValue =
  overview.bookings > 0 ? overview.spent / overview.bookings : 0;

const currentAdminName = clean(
  firstValue(adminSource.username, adminSource.name, adminSource.email),
  "Administrator"
);

const initialCsrfToken = clean(
  typeof csrfToken !== "undefined" ? csrfToken : "",
  ""
);

function php(value) {
  const amount = Number(value) || 0;
  return `₱${amount.toLocaleString("en-PH", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  })}`;
}
