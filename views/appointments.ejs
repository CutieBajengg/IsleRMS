<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    <%= title || "Book Your Stay | Puffer Isle Resort" %>
  </title>

  <meta
    name="description"
    content="Book your stay at Puffer Isle Resort."
  >

  <style>
    :root {
      --primary: #0f766e;
      --primary-dark: #115e59;
      --primary-soft: #ccfbf1;

      --background: #f6f8f7;
      --surface: #ffffff;
      --surface-soft: #f8faf9;

      --text: #17221f;
      --muted: #66736f;

      --border: #dce5e1;

      --success: #15803d;
      --success-soft: #dcfce7;

      --warning: #b45309;
      --warning-soft: #fef3c7;

      --danger: #b91c1c;
      --danger-soft: #fee2e2;

      --shadow-sm:
        0 2px 10px rgba(15, 23, 42, 0.05);

      --shadow-md:
        0 12px 35px rgba(15, 23, 42, 0.08);

      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 22px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background: var(--background);
      color: var(--text);
      line-height: 1.5;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .page-shell {
      width: min(
        1240px,
        calc(100% - 32px)
      );

      margin: 0 auto;
      padding: 42px 0 80px;
    }

    .page-header {
      margin-bottom: 30px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      margin-bottom: 10px;
      padding: 7px 12px;

      border-radius: 999px;
      background: var(--primary-soft);

      color: var(--primary-dark);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .page-header h1 {
      margin: 0 0 8px;
      font-size: clamp(
        2rem,
        4vw,
        3rem
      );

      line-height: 1.05;
    }

    .page-header p {
      margin: 0;
      max-width: 750px;
      color: var(--muted);
      font-size: 1rem;
    }

    .alert {
      margin-bottom: 22px;
      padding: 15px 17px;

      border: 1px solid transparent;
      border-radius: var(--radius-sm);

      font-size: 0.95rem;
      font-weight: 600;
    }

    .alert-error {
      background: var(--danger-soft);
      border-color: #fecaca;
      color: var(--danger);
    }

    .alert-success {
      background: var(--success-soft);
      border-color: #bbf7d0;
      color: var(--success);
    }

    .booking-layout {
      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        360px;

      gap: 24px;
      align-items: start;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm);
    }

    .booking-card {
      padding: 28px;
    }

    .section {
      padding-bottom: 28px;
      margin-bottom: 28px;

      border-bottom: 1px solid var(--border);
    }

    .section:last-child {
      padding-bottom: 0;
      margin-bottom: 0;
      border-bottom: 0;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;

      margin-bottom: 18px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: 1.12rem;
    }

    .section-heading p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.88rem;
    }

    .required {
      color: var(--danger);
    }

    .form-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 16px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      font-size: 0.88rem;
      font-weight: 700;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      padding: 12px 13px;

      border: 1px solid var(--border);
      border-radius: 11px;

      background: #fff;
      color: var(--text);

      outline: none;

      transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease;
    }

    .field textarea {
      min-height: 115px;
      resize: vertical;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: var(--primary);

      box-shadow:
        0 0 0 4px
          rgba(15, 118, 110, 0.1);
    }

    .field small {
      color: var(--muted);
      font-size: 0.78rem;
    }

    .catalog-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 14px;
    }

    .room-option {
      position: relative;
    }

    .room-option input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .room-card {
      height: 100%;

      border: 1px solid var(--border);
      border-radius: 16px;

      overflow: hidden;
      background: var(--surface-soft);

      cursor: pointer;

      transition:
        border-color 0.18s ease,
        transform 0.18s ease,
        box-shadow 0.18s ease;
    }

    .room-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    .room-option input:checked + .room-card {
      border-color: var(--primary);

      box-shadow:
        0 0 0 3px
          rgba(15, 118, 110, 0.12);
    }

    .catalog-image {
      width: 100%;
      height: 170px;
      object-fit: cover;
      background: #e9efec;
    }

    .catalog-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;

      width: 100%;
      height: 170px;

      background:
        linear-gradient(
          135deg,
          #dceee9,
          #edf4f1
        );

      color: var(--primary-dark);
      font-size: 2rem;
      font-weight: 800;
    }

    .room-content {
      padding: 17px;
    }

    .room-topline {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
    }

    .room-name {
      margin: 0;
      font-size: 1rem;
      font-weight: 800;
    }

    .room-price {
      white-space: nowrap;
      color: var(--primary-dark);
      font-size: 0.98rem;
      font-weight: 900;
    }

    .room-description {
      margin: 7px 0 10px;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .room-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .meta-pill {
      display: inline-flex;
      align-items: center;

      padding: 5px 8px;

      border-radius: 999px;
      background: #eef5f2;

      color: #44534e;
      font-size: 0.74rem;
      font-weight: 700;
    }

    .addon-list {
      display: grid;
      gap: 10px;
    }

    .addon-option {
      display: flex;
      align-items: flex-start;
      gap: 12px;

      padding: 14px;

      border: 1px solid var(--border);
      border-radius: 14px;

      background: var(--surface-soft);

      cursor: pointer;
    }

    .addon-option:hover {
      border-color: #b7cbc5;
    }

    .addon-option input {
      margin-top: 3px;
      accent-color: var(--primary);
    }

    .addon-info {
      flex: 1;
      min-width: 0;
    }

    .addon-title-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }

    .addon-name {
      font-weight: 800;
    }

    .addon-price {
      white-space: nowrap;
      color: var(--primary-dark);
      font-weight: 900;
    }

    .addon-description {
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .addon-note {
      margin-top: 4px;
      color: #73807c;
      font-size: 0.73rem;
    }

    .empty-catalog {
      padding: 22px;
      border: 1px dashed var(--border);
      border-radius: 14px;

      background: var(--surface-soft);
      color: var(--muted);

      text-align: center;
      font-size: 0.9rem;
    }

    .summary-card {
      position: sticky;
      top: 20px;

      padding: 24px;
    }

    .summary-card h2 {
      margin: 0;
      font-size: 1.12rem;
    }

    .summary-subtitle {
      margin: 5px 0 20px;
      color: var(--muted);
      font-size: 0.83rem;
    }

    .summary-room {
      padding: 14px;

      border-radius: 14px;
      background: var(--surface-soft);

      margin-bottom: 16px;
    }

    .summary-room-name {
      font-weight: 800;
    }

    .summary-room-meta {
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .price-lines {
      display: grid;
      gap: 10px;
    }

    .price-line {
      display: flex;
      justify-content: space-between;
      gap: 18px;

      color: #485550;
      font-size: 0.88rem;
    }

    .price-line strong {
      color: var(--text);
    }

    .price-divider {
      height: 1px;
      margin: 6px 0;

      background: var(--border);
    }

    .total-line {
      display: flex;
      justify-content: space-between;
      gap: 18px;

      margin-top: 6px;

      font-size: 1.13rem;
      font-weight: 900;
    }

    .total-line strong {
      color: var(--primary-dark);
    }

    .submit-button {
      width: 100%;
      margin-top: 20px;
      padding: 14px 17px;

      border: 0;
      border-radius: 12px;

      background: var(--primary);
      color: #fff;

      font-weight: 800;
      cursor: pointer;

      transition:
        background 0.18s ease,
        transform 0.18s ease;
    }

    .submit-button:hover {
      background: var(--primary-dark);
    }

    .submit-button:active {
      transform: translateY(1px);
    }

    .submit-button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .security-note {
      margin-top: 13px;
      color: var(--muted);
      font-size: 0.74rem;
      line-height: 1.5;
      text-align: center;
    }

    .validation-message {
      display: none;

      margin-top: 10px;
      padding: 11px 12px;

      border-radius: 10px;

      background: var(--danger-soft);
      color: var(--danger);

      font-size: 0.82rem;
      font-weight: 700;
    }

    .booking-history {
      margin-top: 32px;
      padding: 24px;
    }

    .booking-history h2 {
      margin: 0 0 4px;
      font-size: 1.12rem;
    }

    .booking-history > p {
      margin: 0 0 18px;
      color: var(--muted);
      font-size: 0.84rem;
    }

    .history-list {
      display: grid;
      gap: 12px;
    }

    .history-item {
      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        auto;

      gap: 16px;

      padding: 15px;

      border: 1px solid var(--border);
      border-radius: 14px;

      background: var(--surface-soft);
    }

    .history-name {
      margin: 0;
      font-weight: 800;
    }

    .history-meta {
      margin-top: 5px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .history-price {
      white-space: nowrap;
      font-weight: 900;
      color: var(--primary-dark);
    }

    .status {
      display: inline-flex;
      align-items: center;

      margin-top: 8px;
      padding: 4px 8px;

      border-radius: 999px;

      font-size: 0.7rem;
      font-weight: 800;
      text-transform: capitalize;
    }

    .status-pending {
      background: var(--warning-soft);
      color: var(--warning);
    }

    .status-accepted,
    .status-confirmed {
      background: var(--success-soft);
      color: var(--success);
    }

    .status-cancelled,
    .status-declined,
    .status-rejected {
      background: var(--danger-soft);
      color: var(--danger);
    }

    .status-checked-in,
    .status-checked-out,
    .status-completed {
      background: var(--primary-soft);
      color: var(--primary-dark);
    }

    .empty-history {
      padding: 24px;

      border: 1px dashed var(--border);
      border-radius: 14px;

      color: var(--muted);
      text-align: center;
      font-size: 0.88rem;
    }

    @media (max-width: 980px) {
      .booking-layout {
        grid-template-columns: 1fr;
      }

      .summary-card {
        position: static;
      }
    }

    @media (max-width: 700px) {
      .page-shell {
        width: min(
          100% - 20px,
          1240px
        );

        padding-top: 28px;
      }

      .booking-card,
      .summary-card,
      .booking-history {
        padding: 18px;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }

      .catalog-grid {
        grid-template-columns: 1fr;
      }

      .history-item {
        grid-template-columns: 1fr;
      }

      .history-price {
        white-space: normal;
      }
    }
  </style>
</head>

<body>

  <%- include("partials/navbar") %>

  <main class="page-shell">

    <header class="page-header">
      <div class="eyebrow">
        Puffer Isle Resort
      </div>

      <h1>
        Book Your Stay
      </h1>

      <p>
        Choose your accommodation, dates, guests,
        and any available add-ons. Your final price
        is calculated securely by the resort system.
      </p>
    </header>


    <% if (error) { %>
      <div class="alert alert-error">
        <%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success">
        <%= success %>
      </div>
    <% } %>


    <form
      id="bookingForm"
      action="/appointment/submit"
      method="POST"
      novalidate
    >

      <div class="booking-layout">

        <!-- =====================================================
             LEFT / MAIN FORM
        ====================================================== -->

        <section class="card booking-card">

          <!-- ===================================================
               ACCOMMODATION
          ==================================================== -->

          <div class="section">

            <div class="section-heading">
              <div>
                <h2>
                  1. Choose your accommodation
                  <span class="required">*</span>
                </h2>

                <p>
                  Current room information is managed by the resort.
                </p>
              </div>
            </div>


            <div class="catalog-grid">

              <% if (rooms && rooms.length > 0) { %>

                <% rooms.forEach((room) => { %>

                  <label class="room-option">

                    <input
                      type="radio"
                      name="room"
                      value="<%= room._id %>"
                      data-room-name="<%= room.name %>"
                      data-room-price="<%= Number(room.price || 0) %>"
                      data-room-capacity="<%= Number(room.maxGuests || 1) %>"
                      required
                    >

                    <div class="room-card">

                      <% if (room.image) { %>

                        <img
                          class="catalog-image"
                          src="<%= room.image %>"
                          alt="<%= room.name %>"
                          loading="lazy"
                        >

                      <% } else { %>

                        <div class="catalog-placeholder">
                          <%= room.name
                            ? room.name.charAt(0).toUpperCase()
                            : "R" %>
                        </div>

                      <% } %>


                      <div class="room-content">

                        <div class="room-topline">

                          <h3 class="room-name">
                            <%= room.name %>
                          </h3>

                          <div class="room-price">
                            ₱<%= Number(room.price || 0).toLocaleString("en-PH") %>
                            <small>/night</small>
                          </div>

                        </div>


                        <% if (room.description) { %>

                          <p class="room-description">
                            <%= room.description %>
                          </p>

                        <% } %>


                        <div class="room-meta">

                          <span class="meta-pill">
                            Up to
                            <%= Number(room.maxGuests || 1) %>
                            guest<%= Number(room.maxGuests || 1) === 1 ? "" : "s" %>
                          </span>

                          <% if (Number(room.quantity || 1) > 1) { %>

                            <span class="meta-pill">
                              <%= Number(room.quantity) %>
                              units
                            </span>

                          <% } %>

                        </div>

                      </div>

                    </div>

                  </label>

                <% }) %>

              <% } else { %>

                <div class="empty-catalog">
                  No accommodations are currently available.
                  Please contact the resort.
                </div>

              <% } %>

            </div>

          </div>


          <!-- ===================================================
               DATES + GUESTS
          ==================================================== -->

          <div class="section">

            <div class="section-heading">
              <div>
                <h2>
                  2. Stay details
                </h2>

                <p>
                  Select your dates and number of guests.
                </p>
              </div>
            </div>


            <div class="form-grid">

              <div class="field">

                <label for="checkin">
                  Check-in
                  <span class="required">*</span>
                </label>

                <input
                  type="date"
                  id="checkin"
                  name="checkin"
                  required
                >

                <small>
                  Check-in cannot be in the past.
                </small>

              </div>


              <div class="field">

                <label for="checkout">
                  Check-out
                  <span class="required">*</span>
                </label>

                <input
                  type="date"
                  id="checkout"
                  name="checkout"
                  required
                >

                <small>
                  Must be after check-in.
                </small>

              </div>


              <div class="field">

                <label for="guests">
                  Number of guests
                  <span class="required">*</span>
                </label>

                <input
                  type="number"
                  id="guests"
                  name="guests"
                  value="1"
                  min="1"
                  step="1"
                  required
                >

                <small id="capacityHelp">
                  Select a room to see its maximum capacity.
                </small>

              </div>


              <div class="field">

                <label for="contact">
                  Contact number
                  <span class="required">*</span>
                </label>

                <input
                  type="tel"
                  id="contact"
                  name="contact"
                  value="<%= user && user.phone ? user.phone : "" %>"
                  autocomplete="tel"
                  required
                >

                <small>
                  We'll use this for reservation communication.
                </small>

              </div>

            </div>

          </div>


          <!-- ===================================================
               ADD-ONS
          ==================================================== -->

          <div class="section">

            <div class="section-heading">
              <div>
                <h2>
                  3. Optional add-ons
                </h2>

                <p>
                  Available extras are managed by the resort.
                </p>
              </div>
            </div>


            <% if (addOns && addOns.length > 0) { %>

              <div class="addon-list">

                <% addOns.forEach((addOn) => { %>

                  <label class="addon-option">

                    <input
                      type="checkbox"
                      name="addOns[]"
                      value="<%= addOn._id %>"
                      data-addon-name="<%= addOn.name %>"
                      data-addon-price="<%= Number(addOn.price || 0) %>"
                      data-addon-pricing-type="<%= addOn.pricingType || "once" %>"
                    >

                    <div class="addon-info">

                      <div class="addon-title-row">

                        <span class="addon-name">
                          <%= addOn.name %>
                        </span>

                        <span class="addon-price">

                          ₱<%= Number(addOn.price || 0).toLocaleString("en-PH") %>

                        </span>

                      </div>


                      <% if (addOn.description) { %>

                        <div class="addon-description">
                          <%= addOn.description %>
                        </div>

                      <% } %>


                      <div class="addon-note">

                        <% if (addOn.pricingType === "perNight") { %>

                          Charged per night

                        <% } else { %>

                          Charged once per stay

                        <% } %>

                      </div>

                    </div>

                  </label>

                <% }) %>

              </div>

            <% } else { %>

              <div class="empty-catalog">
                No add-ons are currently available.
              </div>

            <% } %>

          </div>


          <!-- ===================================================
               SPECIAL REQUESTS
          ==================================================== -->

          <div class="section">

            <div class="section-heading">
              <div>
                <h2>
                  4. Special requests
                </h2>

                <p>
                  Optional notes for the resort team.
                </p>
              </div>
            </div>


            <div class="field">

              <label for="specialRequests">
                Special requests
              </label>

              <textarea
                id="specialRequests"
                name="specialRequests"
                maxlength="3000"
                placeholder="Tell us about any special requests or preferences..."
              ></textarea>

              <small>
                Please note that special requests are subject to availability.
              </small>

            </div>

          </div>

        </section>


        <!-- =====================================================
             RIGHT / SUMMARY
        ====================================================== -->

        <aside class="card summary-card">

          <h2>
            Booking summary
          </h2>

          <p class="summary-subtitle">
            Your displayed total is an estimate.
            The server performs the final calculation.
          </p>


          <div
            id="summaryRoom"
            class="summary-room"
          >

            <div
              id="summaryRoomName"
              class="summary-room-name"
            >
              No room selected
            </div>

            <div
              id="summaryRoomMeta"
              class="summary-room-meta"
            >
              Choose an accommodation to continue.
            </div>

          </div>


          <div class="price-lines">

            <div class="price-line">

              <span>
                Room
              </span>

              <strong id="roomSubtotal">
                ₱0
              </strong>

            </div>


            <div class="price-line">

              <span>
                Add-ons
              </span>

              <strong id="addOnSubtotal">
                ₱0
              </strong>

            </div>


            <div class="price-line">

              <span>
                Nights
              </span>

              <strong id="nightCount">
                0
              </strong>

            </div>


            <div class="price-divider"></div>


            <div class="total-line">

              <span>
                Estimated total
              </span>

              <strong id="estimatedTotal">
                ₱0
              </strong>

            </div>

          </div>


          <div
            id="validationMessage"
            class="validation-message"
          ></div>


          <button
            type="submit"
            id="submitButton"
            class="submit-button"
          >
            Submit Booking Request
          </button>


          <div class="security-note">

            Your submitted total is not trusted by the server.
            The booking system recalculates the price from the
            current resort catalog before saving the reservation.

          </div>

        </aside>

      </div>

    </form>


    <!-- =========================================================
         BOOKING HISTORY
    ========================================================== -->

    <section class="card booking-history">

      <h2>
        Your reservations
      </h2>

      <p>
        Review your recent booking requests and their current status.
      </p>


      <% if (appointments && appointments.length > 0) { %>

        <div class="history-list">

          <% appointments.forEach((appointment) => { %>

            <article class="history-item">

              <div>

                <h3 class="history-name">
                  <%= appointment.room || "Accommodation" %>
                </h3>


                <div class="history-meta">

                  <% if (appointment.checkin) { %>

                    <%= new Date(appointment.checkin).toLocaleDateString("en-PH", {
                      year: "numeric",
                      month: "short",
                      day: "numeric"
                    }) %>

                  <% } %>


                  <% if (appointment.checkout) { %>

                    —
                    <%= new Date(appointment.checkout).toLocaleDateString("en-PH", {
                      year: "numeric",
                      month: "short",
                      day: "numeric"
                    }) %>

                  <% } %>


                  ·

                  <%= Number(appointment.guests || 0) %>
                  guest<%= Number(appointment.guests || 0) === 1 ? "" : "s" %>

                </div>


                <span
                  class="status status-<%= String(appointment.status || "pending").toLowerCase().replace(/\s+/g, "-") %>"
                >
                  <%= appointment.status || "pending" %>
                </span>

              </div>


              <div class="history-price">

                ₱<%= Number(appointment.totalPrice || 0).toLocaleString("en-PH") %>

              </div>

            </article>

          <% }) %>

        </div>

      <% } else { %>

        <div class="empty-history">
          You have no reservations yet.
        </div>

      <% } %>

    </section>

  </main>


  <script>
    (() => {
      "use strict";

      const form =
        document.getElementById(
          "bookingForm"
        );

      const roomInputs =
        document.querySelectorAll(
          'input[name="room"]'
        );

      const addOnInputs =
        document.querySelectorAll(
          'input[name="addOns[]"]'
        );

      const checkInInput =
        document.getElementById(
          "checkin"
        );

      const checkOutInput =
        document.getElementById(
          "checkout"
        );

      const guestsInput =
        document.getElementById(
          "guests"
        );

      const capacityHelp =
        document.getElementById(
          "capacityHelp"
        );

      const summaryRoomName =
        document.getElementById(
          "summaryRoomName"
        );

      const summaryRoomMeta =
        document.getElementById(
          "summaryRoomMeta"
        );

      const roomSubtotalElement =
        document.getElementById(
          "roomSubtotal"
        );

      const addOnSubtotalElement =
        document.getElementById(
          "addOnSubtotal"
        );

      const nightCountElement =
        document.getElementById(
          "nightCount"
        );

      const estimatedTotalElement =
        document.getElementById(
          "estimatedTotal"
        );

      const validationMessage =
        document.getElementById(
          "validationMessage"
        );

      const submitButton =
        document.getElementById(
          "submitButton"
        );


      /*
       * ----------------------------------------------------------
       * MONEY
       * ----------------------------------------------------------
       */

      function formatMoney(
        value
      ) {
        const amount =
          Number(value) || 0;

        return (
          "₱" +
          amount.toLocaleString(
            "en-PH",
            {
              maximumFractionDigits: 2,
            }
          )
        );
      }


      /*
       * ----------------------------------------------------------
       * DATE
       * ----------------------------------------------------------
       */

      function parseDate(
        value
      ) {
        if (!value) {
          return null;
        }

        const date =
          new Date(
            value + "T00:00:00"
          );

        if (
          Number.isNaN(
            date.getTime()
          )
        ) {
          return null;
        }

        return date;
      }


      function getNights() {
        const checkIn =
          parseDate(
            checkInInput.value
          );

        const checkOut =
          parseDate(
            checkOutInput.value
          );

        if (
          !checkIn ||
          !checkOut ||
          checkOut <= checkIn
        ) {
          return 0;
        }

        const milliseconds =
          checkOut.getTime() -
          checkIn.getTime();

        return Math.ceil(
          milliseconds /
            (1000 * 60 * 60 * 24)
        );
      }


      /*
       * ----------------------------------------------------------
       * TODAY
       * ----------------------------------------------------------
       */

      function getTodayInputValue() {
        const now =
          new Date();

        const year =
          now.getFullYear();

        const month =
          String(
            now.getMonth() + 1
          ).padStart(
            2,
            "0"
          );

        const day =
          String(
            now.getDate()
          ).padStart(
            2,
            "0"
          );

        return `${year}-${month}-${day}`;
      }


      checkInInput.min =
        getTodayInputValue();

      checkOutInput.min =
        getTodayInputValue();


      /*
       * ----------------------------------------------------------
       * SELECTED ROOM
       * ----------------------------------------------------------
       */

      function getSelectedRoom() {
        return Array.from(
          roomInputs
        ).find(
          (input) =>
            input.checked
        );
      }


      /*
       * ----------------------------------------------------------
       * SELECTED ADD-ONS
       * ----------------------------------------------------------
       */

      function getSelectedAddOns() {
        return Array.from(
          addOnInputs
        ).filter(
          (input) =>
            input.checked
        );
      }


      /*
       * ----------------------------------------------------------
       * CAPACITY
       * ----------------------------------------------------------
       */

      function updateGuestCapacity() {
        const selectedRoom =
          getSelectedRoom();

        if (!selectedRoom) {
          guestsInput.removeAttribute(
            "max"
          );

          capacityHelp.textContent =
            "Select a room to see its maximum capacity.";

          return;
        }

        const capacity =
          Number(
            selectedRoom.dataset.roomCapacity ||
              1
          );

        guestsInput.max =
          String(capacity);

        capacityHelp.textContent =
          `Maximum capacity: ${capacity} guest${
            capacity === 1
              ? ""
              : "s"
          }.`;

        const currentGuests =
          Number(
            guestsInput.value
          );

        if (
          currentGuests > capacity
        ) {
          guestsInput.value =
            String(
              capacity
            );
        }
      }


      /*
       * ----------------------------------------------------------
       * SUMMARY
       * ----------------------------------------------------------
       */

      function updateSummary() {
        const selectedRoom =
          getSelectedRoom();

        const nights =
          getNights();

        let roomPrice =
          0;

        let roomName =
          "No room selected";

        let roomCapacity =
          0;

        if (selectedRoom) {
          roomPrice =
            Number(
              selectedRoom.dataset.roomPrice ||
                0
            );

          roomName =
            selectedRoom.dataset.roomName ||
            "Selected room";

          roomCapacity =
            Number(
              selectedRoom.dataset.roomCapacity ||
                0
            );
        }


        let addOnSubtotal =
          0;

        getSelectedAddOns().forEach(
          (input) => {
            const price =
              Number(
                input.dataset.addonPrice ||
                  0
              );

            const pricingType =
              input.dataset.addonPricingType ||
              "once";

            if (
              pricingType ===
              "perNight"
            ) {
              addOnSubtotal +=
                price *
                nights;
            } else {
              addOnSubtotal +=
                price;
            }
          }
        );


        const roomSubtotal =
          roomPrice *
          nights;

        const estimatedTotal =
          roomSubtotal +
          addOnSubtotal;


        summaryRoomName.textContent =
          roomName;

        if (selectedRoom) {

          summaryRoomMeta.textContent =
            `₱${roomPrice.toLocaleString(
              "en-PH"
            )} per night · Up to ${roomCapacity} guest${
              roomCapacity === 1
                ? ""
                : "s"
            }`;

        } else {

          summaryRoomMeta.textContent =
            "Choose an accommodation to continue.";

        }


        roomSubtotalElement.textContent =
          formatMoney(
            roomSubtotal
          );

        addOnSubtotalElement.textContent =
          formatMoney(
            addOnSubtotal
          );

        nightCountElement.textContent =
          String(
            nights
          );

        estimatedTotalElement.textContent =
          formatMoney(
            estimatedTotal
          );
      }


      /*
       * ----------------------------------------------------------
       * VALIDATION MESSAGE
       * ----------------------------------------------------------
       */

      function showValidation(
        message
      ) {
        validationMessage.textContent =
          message;

        validationMessage.style.display =
          "block";
      }


      function clearValidation() {
        validationMessage.textContent =
          "";

        validationMessage.style.display =
          "none";
      }


      /*
       * ----------------------------------------------------------
       * FORM VALIDATION
       * ----------------------------------------------------------
       */

      function validateForm() {
        clearValidation();

        const selectedRoom =
          getSelectedRoom();

        if (!selectedRoom) {
          showValidation(
            "Please select an accommodation."
          );

          return false;
        }


        const checkIn =
          parseDate(
            checkInInput.value
          );

        const checkOut =
          parseDate(
            checkOutInput.value
          );

        if (!checkIn) {
          showValidation(
            "Please select a valid check-in date."
          );

          return false;
        }


        if (!checkOut) {
          showValidation(
            "Please select a valid check-out date."
          );

          return false;
        }


        const today =
          parseDate(
            getTodayInputValue()
          );

        if (
          today &&
          checkIn < today
        ) {
          showValidation(
            "Check-in cannot be in the past."
          );

          return false;
        }


        if (
          checkOut <= checkIn
        ) {
          showValidation(
            "Check-out must be after check-in."
          );

          return false;
        }


        const nights =
          getNights();

        if (
          nights < 1
        ) {
          showValidation(
            "Your stay must be at least one night."
          );

          return false;
        }


        const guests =
          Number(
            guestsInput.value
          );

        const capacity =
          Number(
            selectedRoom.dataset.roomCapacity ||
              0
          );

        if (
          !Number.isInteger(
            guests
          ) ||
          guests < 1
        ) {
          showValidation(
            "Please enter a valid number of guests."
          );

          return false;
        }


        if (
          capacity > 0 &&
          guests > capacity
        ) {
          showValidation(
            `This accommodation allows a maximum of ${capacity} guest${
              capacity === 1
                ? ""
                : "s"
            }.`
          );

          return false;
        }


        const contact =
          document
            .getElementById(
              "contact"
            )
            .value
            .trim();

        if (
          contact.length < 3
        ) {
          showValidation(
            "Please provide a valid contact number."
          );

          return false;
        }


        return true;
      }


      /*
       * ----------------------------------------------------------
       * ROOM CHANGE
       * ----------------------------------------------------------
       */

      roomInputs.forEach(
        (input) => {
          input.addEventListener(
            "change",
            () => {
              updateGuestCapacity();
              updateSummary();
              clearValidation();
            }
          );
        }
      );


      /*
       * ----------------------------------------------------------
       * ADD-ON CHANGE
       * ----------------------------------------------------------
       */

      addOnInputs.forEach(
        (input) => {
          input.addEventListener(
            "change",
            () => {
              updateSummary();
              clearValidation();
            }
          );
        }
      );


      /*
       * ----------------------------------------------------------
       * DATE CHANGE
       * ----------------------------------------------------------
       */

      checkInInput.addEventListener(
        "change",
        () => {
          const checkIn =
            parseDate(
              checkInInput.value
            );

          if (checkIn) {
            checkOutInput.min =
              checkInInput.value;
          } else {
            checkOutInput.min =
              getTodayInputValue();
          }

          updateSummary();
        }
      );


      checkOutInput.addEventListener(
        "change",
        updateSummary
      );


      /*
       * ----------------------------------------------------------
       * GUEST CHANGE
       * ----------------------------------------------------------
       */

      guestsInput.addEventListener(
        "input",
        () => {
          updateSummary();
          clearValidation();
        }
      );


      /*
       * ----------------------------------------------------------
       * SUBMIT
       * ----------------------------------------------------------
       */

      form.addEventListener(
        "submit",
        (event) => {
          if (
            !validateForm()
          ) {
            event.preventDefault();

            window.scrollTo({
              top:
                validationMessage
                  .getBoundingClientRect()
                  .top +
                window.scrollY -
                120,

              behavior:
                "smooth",
            });

            return;
          }

          submitButton.disabled =
            true;

          submitButton.textContent =
            "Submitting booking...";

          /*
           * IMPORTANT:
           * We intentionally do NOT create or submit
           * totalPrice as a trusted form value.
           *
           * The server calculates the final amount.
           */
        }
      );


      /*
       * ----------------------------------------------------------
       * INITIAL STATE
       * ----------------------------------------------------------
       */

      updateGuestCapacity();
      updateSummary();

    })();
  </script>

</body>
</html>