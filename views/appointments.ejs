              ></div>

            </div>

            <div class="summary-total">

              <span>
                Estimated total
              </span>

              <strong id="estimatedTotal">
                ₱0
              </strong>

            </div>

            <button
              type="submit"
              id="submitButton"
              class="submit-button"
            >

              <span
                class="button-loader"
                aria-hidden="true"
              ></span>

              <i
                class="fa-solid fa-calendar-check"
                id="submitButtonIcon"
              ></i>

              <span id="submitButtonText">
                Submit booking request
              </span>

            </button>

            <div class="security-line">

              <i
                class="fa-solid fa-shield-halved"
              ></i>

              <span>
                Availability, prices, add-ons, and booking rules
                are verified again on the server.
              </span>

            </div>

          </div>

          <div class="summary-footer">

            <strong>
              Reservation notice:
            </strong>

            submitting this form creates a booking request.
            The resort controls the final reservation status
            through its admin workflow.

          </div>

        </aside>

      </div>

    </form>

    <!-- ========================================================
         HISTORY
    ========================================================= -->

    <section
      class="history-panel"
      aria-labelledby="historyHeading"
    >

      <div class="history-head">

        <div>

          <h2 id="historyHeading">
            Your reservations
          </h2>

          <p>
            Keep track of recent requests, stay dates,
            reservation values, and their current status.
          </p>

        </div>

        <span class="history-count">

          <i
            class="fa-regular fa-calendar-check"
          ></i>

          <%= safeAppointments.length %>

          reservation<%= safeAppointments.length === 1 ? "" : "s" %>

        </span>

      </div>

      <% if (safeAppointments.length > 0) { %>

        <div class="history-list">

          <% safeAppointments.forEach((appointment) => { %>

            <%
              const statusText =
                String(
                  appointment.status ||
                  "pending"
                ).trim();

              const statusKey =
                normalizeStatus(
                  statusText
                );

              const roomName =
                appointmentRoomName(
                  appointment
                );

              const guestCount =
                Math.max(
                  0,
                  Number(
                    appointment.guests ||
                    0
                  )
                );

              const nights =
                Math.max(
                  0,
                  Number(
                    appointment.numberOfNights ||
                    0
                  )
                );

              const addonCount =
                Array.isArray(
                  appointment.addOns
                )
                  ? appointment.addOns.length
                  : 0;

              const totalValue =
                Number(
                  appointment.totalPrice ||
                  0
                ) || 0;
            %>

            <article class="history-item">

              <div>

                <div class="history-title-row">

                  <h3>
                    <%= roomName %>
                  </h3>

                  <span
                    class="
                      status
                      status-<%= statusKey %>
                    "
                  >

                    <i
                      class="fa-solid fa-circle"
                      style="font-size:.34rem"
                    ></i>

                    <%= statusText %>

                  </span>

                </div>

                <div class="history-meta">

                  <%= dateLabel(
                    appointment.checkin
                  ) %>

                  <span aria-hidden="true">
                    →
                  </span>

                  <%= dateLabel(
                    appointment.checkout
                  ) %>

                  ·

                  <%= guestCount %>

                  guest<%= guestCount === 1 ? "" : "s" %>

                  <% if (nights > 0) { %>

                    ·

                    <%= nights %>

                    night<%= nights === 1 ? "" : "s" %>

                  <% } %>

                </div>

                <div class="history-created">

                  Requested

                  <%= dateLabel(
                    appointment.createdAt
                  ) %>

                  <% if (addonCount > 0) { %>

                    ·

                    <%= addonCount %>

                    add-on<%= addonCount === 1 ? "" : "s" %>

                  <% } %>

                </div>

              </div>

              <div>

                <div class="history-price">

                  ₱<%= money(
                    totalValue
                  ) %>

                </div>

                <div class="history-small">
                  Booking value
                </div>

              </div>

            </article>

          <% }) %>

        </div>

      <% } else { %>

        <div class="empty-state">

          <i
            class="fa-regular fa-calendar"
          ></i>

          You have no reservations yet.
          Your first island stay can start above.

        </div>

      <% } %>

    </section>

  </main>

  <!-- ==========================================================
       TOAST STACK
  =========================================================== -->

  <div
    class="toast-stack"
    id="toastStack"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <!-- ==========================================================
       SAFE DATA
  =========================================================== -->

  <script
    type="application/json"
    id="bookingAppointmentsData"
  ><%- JSON.stringify(
    safeAppointments.map(
      (appointment) => ({
        id:
          appointment._id ||
          appointment.id ||
          "",

        roomId:
          appointment.roomId &&
          appointment.roomId._id
            ? appointment.roomId._id
            : (
              appointment.roomId ||
              ""
            ),

        room:
          appointment.room ||
          appointment.roomName ||
          appointment.roomType ||
          appointment.accommodation ||
          (
            appointment.roomId &&
            appointment.roomId.name
          ) ||
          "",

        checkin:
          appointment.checkin ||
          appointment.checkIn ||
          "",

        checkout:
          appointment.checkout ||
          appointment.checkOut ||
          "",

        status:
          appointment.status ||
          "pending"
      })
    )
  )
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026") %></script>

  <!-- ==========================================================
       JAVASCRIPT
  =========================================================== -->

  <script>

    (() => {

      "use strict";

      const form =
        document.getElementById(
          "bookingForm"
        );

      const roomInputs =
        Array.from(
          document.querySelectorAll(
            'input[name="room"]'
          )
        );

      const addOnInputs =
        Array.from(
          document.querySelectorAll(
            'input[name="addOns[]"]'
          )
        );

      const checkInInput =
        document.getElementById(
          "checkin"
        );

      const checkOutInput =
        document.getElementById(
          "checkout"
        );

      const guestsInput =
        document.getElementById(
          "guests"
        );

      const contactInput =
        document.getElementById(
          "contact"
        );

      const specialRequestsInput =
        document.getElementById(
          "specialRequests"
        );

      const stayDuration =
        document.getElementById(
          "stayDuration"
        );

      const capacityHelp =
        document.getElementById(
          "capacityHelp"
        );

      const capacityLabel =
        document.getElementById(
          "capacityLabel"
        );

      const decreaseGuests =
        document.getElementById(
          "decreaseGuests"
        );

      const increaseGuests =
        document.getElementById(
          "increaseGuests"
        );

      const summaryRoomName =
        document.getElementById(
          "summaryRoomName"
        );

      const summaryRoomMeta =
        document.getElementById(
          "summaryRoomMeta"
        );

      const summaryCheckin =
        document.getElementById(
          "summaryCheckin"
        );

      const summaryCheckout =
        document.getElementById(
          "summaryCheckout"
        );

      const summaryGuests =
        document.getElementById(
          "summaryGuests"
        );

      const summaryNights =
        document.getElementById(
          "summaryNights"
        );

      const roomSubtotal =
        document.getElementById(
          "roomSubtotal"
        );

      const addOnSubtotal =
        document.getElementById(
          "addOnSubtotal"
        );

      const estimatedTotal =
        document.getElementById(
          "estimatedTotal"
        );

      const summaryAddonList =
        document.getElementById(
          "summaryAddonList"
        );

      const submitButton =
        document.getElementById(
          "submitButton"
        );

      const submitButtonText =
        document.getElementById(
          "submitButtonText"
        );

      const submitButtonIcon =
        document.getElementById(
          "submitButtonIcon"
        );

      const validationPanel =
        document.getElementById(
          "validationPanel"
        );

      const validationText =
        document.getElementById(
          "validationText"
        );

      const availabilityPanel =
        document.getElementById(
          "availabilityPanel"
        );

      const availabilityText =
        document.getElementById(
          "availabilityText"
        );

      const roomStatus =
        document.getElementById(
          "roomStatus"
        );

      const stayStatus =
        document.getElementById(
          "stayStatus"
        );

      const addonStatus =
        document.getElementById(
          "addonStatus"
        );

      const requestStatus =
        document.getElementById(
          "requestStatus"
        );

      const roomSelectionNote =
        document.getElementById(
          "roomSelectionNote"
        );

      const roomSelectionText =
        document.getElementById(
          "roomSelectionText"
        );

      const charCounter =
        document.getElementById(
          "charCounter"
        );

      const toastStack =
        document.getElementById(
          "toastStack"
        );

      const summaryProgressBar =
        document.getElementById(
          "summaryProgressBar"
        );

      const progressSteps =
        Array.from(
          document.querySelectorAll(
            "[data-progress]"
          )
        );

      if (
        !form ||
        !checkInInput ||
        !checkOutInput ||
        !guestsInput ||
        !submitButton
      ) {
        return;
      }

      const DAY_MS =
        86400000;

      const MAX_SPECIAL_REQUESTS =
        3000;

      let submitting =
        false;

      /* ========================================================
         HELPERS
      ======================================================== */

      function readJson(
        id,
        fallback
      ) {

        try {

          const element =
            document.getElementById(
              id
            );

          return JSON.parse(
            element?.textContent ||
            JSON.stringify(
              fallback
            )
          );

        } catch (error) {

          console.error(
            `IsleRMS: failed to read ${id}`,
            error
          );

          return fallback;
        }
      }

      const customerAppointments =
        readJson(
          "bookingAppointmentsData",
          []
        );

      function safeNumber(
        value
      ) {

        const number =
          Number(value);

        return Number.isFinite(
          number
        )
          ? number
          : 0;
      }

      function money(
        value
      ) {

        return (
          "₱" +
          Math.max(
            0,
            safeNumber(value)
          ).toLocaleString(
            "en-PH",
            {
              minimumFractionDigits: 0,
              maximumFractionDigits: 2
            }
          )
        );
      }

      function escapeHtml(
        value
      ) {

        return String(
          value ?? ""
        )
          .replaceAll(
            "&",
            "&amp;"
          )
          .replaceAll(
            "<",
            "&lt;"
          )
          .replaceAll(
            ">",
            "&gt;"
          )
          .replaceAll(
            '"',
            "&quot;"
          )
          .replaceAll(
            "'",
            "&#039;"
          );
      }

      function parseDateInput(
        value
      ) {

        if (!value) {
          return null;
        }

        const match =
          /^(\d{4})-(\d{2})-(\d{2})$/.exec(
            value
          );

        if (!match) {
          return null;
        }

        const year =
          Number(match[1]);

        const month =
          Number(match[2]);

        const day =
          Number(match[3]);

        const date =
          new Date(
            year,
            month - 1,
            day
          );

        if (
          date.getFullYear() !== year ||
          date.getMonth() !==
            month - 1 ||
          date.getDate() !== day
        ) {
          return null;
        }

        date.setHours(
          0,
          0,
          0,
          0
        );

        return date;
      }

      function toDateOnly(
        value
      ) {

        if (!value) {
          return null;
        }

        const date =
          new Date(value);

        if (
          Number.isNaN(
            date.getTime()
          )
        ) {
          return null;
        }

        date.setHours(
          0,
          0,
          0,
          0
        );

        return date;
      }

      function inputDateValue(
        date
      ) {

        const safe =
          new Date(date);

        return [
          safe.getFullYear(),
          String(
            safe.getMonth() + 1
          ).padStart(
            2,
            "0"
          ),
          String(
            safe.getDate()
          ).padStart(
            2,
            "0"
          )
        ].join("-");
      }

      function todayValue() {

        return inputDateValue(
          new Date()
        );
      }

      function displayDate(
        value
      ) {

        const date =
          parseDateInput(
            value
          );

        if (!date) {
          return "—";
        }

        return date.toLocaleDateString(
          "en-PH",
          {
            weekday: "short",
            month: "short",
            day: "numeric",
            year: "numeric"
          }
        );
      }

      function nightsBetween(
        checkInValue,
        checkOutValue
      ) {

        const checkIn =
          parseDateInput(
            checkInValue
          );

        const checkOut =
          parseDateInput(
            checkOutValue
          );

        if (
          !checkIn ||
          !checkOut ||
          checkOut <= checkIn
        ) {
          return 0;
        }

        return Math.round(
          (
            checkOut -
            checkIn
          ) / DAY_MS
        );
      }

      function normalizeStatus(
        status
      ) {

        return String(
          status ||
          "pending"
        )
          .toLowerCase()
          .trim()
          .replace(
            /[^a-z0-9]+/g,
            "-"
          );
      }

      function isBlockingStatus(
        status
      ) {

        return [
          "pending",
          "accepted",
          "confirmed",
          "checked-in"
        ].includes(
          normalizeStatus(
            status
          )
        );
      }

      function setInvalid(
        element,
        invalid
      ) {

        if (!element) {
          return;
        }

        if (invalid) {

          element.setAttribute(
            "aria-invalid",
            "true"
          );

        } else {

          element.removeAttribute(
            "aria-invalid"
          );

        }
      }

      function showValidation(
        message
      ) {

        validationText.textContent =
          message;

        validationPanel.classList.add(
          "is-visible"
        );
      }

      function clearValidation() {

        validationPanel.classList.remove(
          "is-visible"
        );

        validationText.textContent =
          "";
      }

      function setAvailability(
        kind,
        message
      ) {

        availabilityPanel.classList.remove(
          "ok",
          "warn",
          "error",
          "info"
        );

        availabilityPanel.classList.add(
          kind,
          "is-visible"
        );

        availabilityText.textContent =
          message;
      }

      function clearAvailability() {

        availabilityPanel.classList.remove(
          "is-visible",
          "ok",
          "warn",
          "error",
          "info"
        );

        availabilityText.textContent =
          "";
      }

      function toast(
        title,
        message = "",
        type = "success"
      ) {

        if (!toastStack) {
          return;
        }

        const node =
          document.createElement(
            "div"
          );

        node.className =
          `toast ${type}`;

        const icon =
          type === "success"
            ? "fa-circle-check"
            : type === "warning"
              ? "fa-triangle-exclamation"
              : "fa-circle-exclamation";

        node.innerHTML = `
          <div class="toast-icon">
            <i class="fa-solid ${icon}"></i>
          </div>

          <div>
            <strong>
              ${escapeHtml(title)}
            </strong>

            <span>
              ${escapeHtml(message)}
            </span>
          </div>
        `;

        toastStack.appendChild(
          node
        );

        window.setTimeout(
          () => node.remove(),
          4200
        );
      }

      /* ========================================================
         ROOM
      ======================================================== */

      function selectedRoom() {

        return (
          roomInputs.find(
            (input) =>
              input.checked
          ) || null
        );
      }

      function selectedAddOns() {

        return addOnInputs.filter(
          (input) =>
            input.checked
        );
      }

      function clampGuests(
        value
      ) {

        const room =
          selectedRoom();

        const max =
          room
            ? Math.max(
                1,
                Math.floor(
                  safeNumber(
                    room.dataset.roomCapacity
                  )
                )
              )
            : 100;

        const numeric =
          Math.floor(
            safeNumber(value)
          );

        return Math.min(
          max,
          Math.max(
            1,
            numeric || 1
          )
        );
      }

      function setStatus(
        node,
        text,
        ready
      ) {

        if (!node) {
          return;
        }

        node.classList.toggle(
          "is-ready",
          Boolean(ready)
        );

        node.innerHTML =
          ready
            ? `
              <i class="fa-solid fa-circle-check"></i>
              ${escapeHtml(text)}
            `
            : `
              <i class="fa-regular fa-circle"></i>
              ${escapeHtml(text)}
            `;
      }

      function updateCapacity() {

        const room =
          selectedRoom();

        if (!room) {

          guestsInput.max =
            "100";

          capacityLabel.textContent =
            "Select a room";

          capacityHelp.textContent =
            "Select an accommodation to see its maximum capacity.";

          decreaseGuests.disabled =
            true;

          increaseGuests.disabled =
            false;

          guestsInput.value =
            "1";

          return;
        }

        const capacity =
          Math.max(
            1,
            Math.floor(
              safeNumber(
                room.dataset.roomCapacity
              )
            )
          );

        guestsInput.max =
          String(capacity);

        capacityLabel.textContent =
          `Up to ${capacity}`;

        capacityHelp.textContent =
          `Maximum capacity: ${capacity} guest${capacity === 1 ? "" : "s"}.`;

        guestsInput.value =
          String(
            clampGuests(
              guestsInput.value
            )
          );

        decreaseGuests.disabled =
          safeNumber(
            guestsInput.value
          ) <= 1;

        increaseGuests.disabled =
          safeNumber(
            guestsInput.value
          ) >= capacity;
      }

      /* ========================================================
         ADDONS
      ======================================================== */

      function addonEstimates(
        nights
      ) {

        let total =
          0;

        const rows =
          [];

        selectedAddOns()
          .forEach(
            (input) => {

              const unitPrice =
                Math.max(
                  0,
                  safeNumber(
                    input.dataset.addonPrice
                  )
                );

              const pricingType =
                input.dataset.addonPricingType ===
                "perNight"
                  ? "perNight"
                  : "once";

              const subtotal =
                pricingType ===
                "perNight"
                  ? unitPrice * nights
                  : unitPrice;

              total +=
                subtotal;

              rows.push({
                name:
                  input.dataset.addonName ||
                  "Add-on",

                subtotal,

                pricingType
              });

            }
          );

        return {
          total,
          rows
        };
      }

      function estimate() {

        const room =
          selectedRoom();

        const nights =
          nightsBetween(
            checkInInput.value,
            checkOutInput.value
          );

        const roomPrice =
          room
            ? Math.max(
                0,
                safeNumber(
                  room.dataset.roomPrice
                )
              )
            : 0;

        const roomSubtotal =
          roomPrice * nights;

        const addon =
          addonEstimates(
            nights
          );

        return {
          room,
          nights,
          roomPrice,
          roomSubtotal,
          addOnSubtotal:
            addon.total,
          addOnRows:
            addon.rows,
          total:
            roomSubtotal +
            addon.total
        };
      }

      function renderAddonSummary(
        rows
      ) {

        summaryAddonList.innerHTML =
          "";

        rows.forEach(
          (row) => {

            const wrapper =
              document.createElement(
                "div"
              );

            wrapper.className =
              "summary-addon-row";

            const name =
              document.createElement(
                "span"
              );

            name.textContent =
              row.name;

            const amount =
              document.createElement(
                "strong"
              );

            amount.textContent =
              money(
                row.subtotal
              );

            wrapper.append(
              name,
              amount
            );

            summaryAddonList.appendChild(
              wrapper
            );

          }
        );
      }

      /* ========================================================
         PROGRESS
      ======================================================== */

      function progressState() {

        const roomReady =
          Boolean(
            selectedRoom()
          );

        const datesReady =
          Boolean(
            parseDateInput(
              checkInInput.value
            ) &&
            parseDateInput(
              checkOutInput.value
            ) &&
            nightsBetween(
              checkInInput.value,
              checkOutInput.value
            ) > 0
          );

        const addonReady =
          selectedAddOns()
            .length > 0;

        const requestReady =
          Boolean(
            specialRequestsInput &&
            specialRequestsInput.value.trim()
          );

        return {
          roomReady,
          datesReady,
          addonReady,
          requestReady
        };
      }

      function updateProgress() {

        const progress =
          progressState();

        const completed =
          [
            progress.roomReady,
            progress.datesReady,
            progress.addonReady,
            progress.requestReady
          ]
            .filter(Boolean)
            .length;

        const percent =
          Math.round(
            (completed / 4) *
            100
          );

        summaryProgressBar.style.width =
          `${percent}%`;

        const order =
          [
            "room",
            "dates",
            "addons",
            "request"
          ];

        let activeFound =
          false;

        progressSteps.forEach(
          (step) => {

            const key =
              step.dataset.progress;

            const index =
              order.indexOf(
                key
              );

            const done =
              [
                progress.roomReady,
                progress.datesReady,
                progress.addonReady,
                progress.requestReady
              ][index];

            step.classList.toggle(
              "is-complete",
              done
            );

            if (
              !done &&
              !activeFound
            ) {

              step.classList.add(
                "is-active"
              );

              activeFound =
                true;

            } else {

              step.classList.toggle(
                "is-active",
                false
              );

            }

          }
        );

      }

      /* ========================================================
         CONFLICT CHECK
      ======================================================== */

      function rangesOverlap(
        startA,
        endA,
        startB,
        endB
      ) {

        return (
          startA < endB &&
          startB < endA
        );
      }

      function appointmentRoomMatches(
        appointment,
        room
      ) {

        if (
          !appointment ||
          !room
        ) {
          return false;
        }

        const selectedId =
          String(
            room.dataset.roomId ||
            room.value ||
            ""
          ).trim();

        const appointmentId =
          String(
            appointment.roomId?._id ||
            appointment.roomId ||
            ""
          ).trim();

        if (
          selectedId &&
          appointmentId &&
          selectedId ===
            appointmentId
        ) {
          return true;
        }

        const selectedName =
          String(
            room.dataset.roomName ||
            ""
          )
            .trim()
            .toLowerCase();

        const appointmentName =
          String(
            appointment.room ||
            ""
          )
            .trim()
            .toLowerCase();

        return Boolean(
          selectedName &&
          appointmentName &&
          selectedName ===
            appointmentName
        );
      }

      function updatePersonalScheduleConflict() {

        const room =
          selectedRoom();

        const checkIn =
          parseDateInput(
            checkInInput.value
          );

        const checkOut =
          parseDateInput(
            checkOutInput.value
          );

        if (
          !room ||
          !checkIn ||
          !checkOut ||
          checkOut <= checkIn
        ) {

          clearAvailability();

          return;
        }

        const roomQuantity =
          Math.max(
            1,
            Math.floor(
              safeNumber(
                room.dataset.roomQuantity ||
                1
              )
            )
          );

        const overlapping =
          customerAppointments.filter(
            (appointment) => {

              if (
                !isBlockingStatus(
                  appointment.status
                )
              ) {
                return false;
              }

              if (
                !appointmentRoomMatches(
                  appointment,
                  room
                )
              ) {
                return false;
              }

              const start =
                toDateOnly(
                  appointment.checkin
                );

              const end =
                toDateOnly(
                  appointment.checkout
                );

              return (
                start &&
                end &&
                rangesOverlap(
                  checkIn,
                  checkOut,
                  start,
                  end
                )
              );
            }
          );

        if (
          overlapping.length >=
          roomQuantity
        ) {

          setAvailability(
            "warn",

            `You already have ${overlapping.length} active reservation${
              overlapping.length === 1
                ? ""
                : "s"
            } overlapping these dates for this accommodation. The server will make the final availability decision.`
          );

          return;
        }

        if (
          overlapping.length > 0
        ) {

          setAvailability(
            "info",

            `You have ${overlapping.length} overlapping reservation${
              overlapping.length === 1
                ? ""
                : "s"
            } in this accommodation. ${
              roomQuantity === 1
                ? "One unit is"
                : `${roomQuantity} units are`
            } currently configured; the server will verify inventory before saving.`
          );

          return;
        }

        setAvailability(
          "ok",

          "No conflicting reservation was found in your own booking history. Final resort-wide availability is verified by the server when you submit."
        );
      }

      /* ========================================================
         SUMMARY
      ======================================================== */

      function updateSummary() {

        const data =
          estimate();

        const guests =
          clampGuests(
            guestsInput.value
          );

        guestsInput.value =
          String(
            guests
          );

        if (data.room) {

          const capacity =
            Math.max(
              1,
              Math.floor(
                safeNumber(
                  data.room.dataset.roomCapacity
                )
              )
            );

          const quantity =
            Math.max(
              1,
              Math.floor(
                safeNumber(
                  data.room.dataset.roomQuantity ||
                  1
                )
              )
            );

          summaryRoomName.textContent =
            data.room.dataset.roomName ||
            "Selected accommodation";

          summaryRoomMeta.textContent =
            `${money(
              data.roomPrice
            )} / night · Up to ${capacity} guests${
              quantity > 1
                ? ` · ${quantity} units`
                : ""
            }`;

          roomSelectionNote.hidden =
            false;

          roomSelectionText.textContent =
            `${
              data.room.dataset.roomName ||
              "Accommodation"
            } selected. Current estimate updates from this choice.`;

        } else {

          summaryRoomName.textContent =
            "No accommodation selected";

          summaryRoomMeta.textContent =
            "Choose a room to begin your booking request.";

          roomSelectionNote.hidden =
            true;

        }

        summaryCheckin.textContent =
          displayDate(
            checkInInput.value
          );

        summaryCheckout.textContent =
          displayDate(
            checkOutInput.value
          );

        summaryGuests.textContent =
          `${guests} guest${
            guests === 1
              ? ""
              : "s"
          }`;

        summaryNights.textContent =
          `${data.nights} night${
            data.nights === 1
              ? ""
              : "s"
          }`;

        stayDuration.value =
          `${data.nights} night${
            data.nights === 1
              ? ""
              : "s"
          }`;

        roomSubtotal.textContent =
          money(
            data.roomSubtotal
          );

        addOnSubtotal.textContent =
          money(
            data.addOnSubtotal
          );

        estimatedTotal.textContent =
          money(
            data.total
          );

        renderAddonSummary(
          data.addOnRows
        );

        setStatus(
          roomStatus,
          data.room
            ? "Selected"
            : "Not selected",
          Boolean(data.room)
        );

        setStatus(
          stayStatus,
          data.nights > 0
            ? `${data.nights} night${
                data.nights === 1
                  ? ""
                  : "s"
              }`
            : "Dates pending",
          data.nights > 0
        );

        setStatus(
          addonStatus,
          selectedAddOns().length > 0
            ? `${selectedAddOns().length} selected`
            : "Optional",
          selectedAddOns().length > 0
        );

        setStatus(
          requestStatus,
          specialRequestsInput &&
          specialRequestsInput.value.trim()
            ? "Added"
            : "Optional",
          Boolean(
            specialRequestsInput &&
            specialRequestsInput.value.trim()
          )
        );

        updateCapacity();
        updateProgress();
        updatePersonalScheduleConflict();
      }

      /* ========================================================
         VALIDATION
      ======================================================== */

      function validateContactCompatibility() {

        if (
          contactInput &&
          String(
            contactInput.value ||
            ""
          ).trim()
        ) {
          return true;
        }

        return false;
      }

      function validateForm() {

        clearValidation();

        [
          checkInInput,
          checkOutInput,
          guestsInput,
          specialRequestsInput
        ].forEach(
          (element) => {

            setInvalid(
              element,
              false
            );

          }
        );

        const room =
          selectedRoom();

        if (!room) {

          showValidation(
            "Please select an accommodation before submitting your booking request."
          );

          roomInputs[0]?.focus();

          return false;
        }

        const checkIn =
          parseDateInput(
            checkInInput.value
          );

        const checkOut =
          parseDateInput(
            checkOutInput.value
          );

        const today =
          parseDateInput(
            todayValue()
          );

        if (!checkIn) {

          setInvalid(
            checkInInput,
            true
          );

          showValidation(
            "Please select a valid check-in date."
          );

          checkInInput.focus();

          return false;
        }

        if (!checkOut) {

          setInvalid(
            checkOutInput,
            true
          );

          showValidation(
            "Please select a valid check-out date."
          );

          checkOutInput.focus();

          return false;
        }

        if (
          today &&
          checkIn < today
        ) {

          setInvalid(
            checkInInput,
            true
          );

          showValidation(
            "Check-in cannot be in the past."
          );

          checkInInput.focus();

          return false;
        }

        if (
          checkOut <= checkIn
        ) {

          setInvalid(
            checkOutInput,
            true
          );

          showValidation(
            "Check-out must be after check-in."
          );

          checkOutInput.focus();

          return false;
        }

        const nights =
          nightsBetween(
            checkInInput.value,
            checkOutInput.value
          );

        if (nights < 1) {

          setInvalid(
            checkOutInput,
            true
          );

          showValidation(
            "Your stay must be at least one night."
          );

          checkOutInput.focus();

          return false;
        }

        if (nights > 365) {

          setInvalid(
            checkOutInput,
            true
          );

          showValidation(
            "Please keep a single reservation request within 365 nights."
          );

          checkOutInput.focus();

          return false;
        }

        const guests =
          Number(
            guestsInput.value
          );

        const capacity =
          Math.max(
            1,
            Math.floor(
              safeNumber(
                room.dataset.roomCapacity
              )
            )
          );

        if (
          !Number.isInteger(
            guests
          ) ||
          guests < 1
        ) {

          setInvalid(
            guestsInput,
            true
          );

          showValidation(
            "Please enter a valid number of guests."
          );

          guestsInput.focus();

          return false;
        }

        if (
          guests >
          capacity
        ) {

          setInvalid(
            guestsInput,
            true
          );

          showValidation(
            `This accommodation allows a maximum of ${capacity} guest${
              capacity === 1
                ? ""
                : "s"
            }.`
          );

          guestsInput.focus();

          return false;
        }

        if (
          !validateContactCompatibility()
        ) {

          showValidation(
            "Your account does not have a saved contact number. Please add a contact number to your profile before making a reservation."
          );

          toast(
            "Profile information needed",
            "Your existing account contact number is required by the current booking workflow.",
            "warning"
          );

          return false;
        }

        if (
          specialRequestsInput &&
          specialRequestsInput.value.length >
            MAX_SPECIAL_REQUESTS
        ) {

          setInvalid(
            specialRequestsInput,
            true
          );

          showValidation(
            `Special requests cannot exceed ${
              MAX_SPECIAL_REQUESTS.toLocaleString(
                "en-PH"
              )
            } characters.`
          );

          specialRequestsInput.focus();

          return false;
        }

        const estimateData =
          estimate();

        if (
          !estimateData.room ||
          estimateData.nights < 1
        ) {

          showValidation(
            "Please complete the room and stay details before submitting."
          );

          return false;
        }

        const conflictingMine =
          customerAppointments.filter(
            (appointment) => {

              if (
                !isBlockingStatus(
                  appointment.status
                )
              ) {
                return false;
              }

              if (
                !appointmentRoomMatches(
                  appointment,
                  room
                )
              ) {
                return false;
              }

              const start =
                toDateOnly(
                  appointment.checkin
                );

              const end =
                toDateOnly(
                  appointment.checkout
                );

              return (
                start &&
                end &&
                rangesOverlap(
                  checkIn,
                  checkOut,
                  start,
                  end
                )
              );
            }
          );

        const roomQuantity =
          Math.max(
            1,
            Math.floor(
              safeNumber(
                room.dataset.roomQuantity ||
                1
              )
            )
          );

        if (
          conflictingMine.length >=
          roomQuantity
        ) {

          showValidation(
            "Your selected accommodation appears to overlap your existing active reservation history. Please choose different dates or an available accommodation."
          );

          setAvailability(
            "warn",
            "This request conflicts with your own active reservation history. The server will also validate availability."
          );

          return false;
        }

        return true;
      }

      /* ========================================================
         SUBMIT STATE
      ======================================================== */

      function setSubmittingState(
        active
      ) {

        submitting =
          active;

        document.body.classList.toggle(
          "is-busy",
          active
        );

        submitButton.disabled =
          active;

        submitButton.classList.toggle(
          "is-loading",
          active
        );

        if (active) {

          submitButtonIcon.style.display =
            "none";

          submitButtonText.textContent =
            "Submitting booking request…";

        } else {

          submitButtonIcon.style.display =
            "inline-block";

          submitButtonText.textContent =
            "Submit booking request";

        }
      }

      /* ========================================================
         DATES
      ======================================================== */

      function initializeDates() {

        const today =
          todayValue();

        checkInInput.min =
          today;

        checkOutInput.min =
          today;
      }

      function syncCheckoutMinimum() {

        const checkIn =
          parseDateInput(
            checkInInput.value
          );

        if (!checkIn) {

          checkOutInput.min =
            todayValue();

          return;
        }

        const nextDay =
          new Date(
            checkIn
          );

        nextDay.setDate(
          nextDay.getDate() + 1
        );

        checkOutInput.min =
          inputDateValue(
            nextDay
          );

        if (
          checkOutInput.value &&
          checkOutInput.value <
            checkOutInput.min
        ) {

          checkOutInput.value =
            "";

        }
      }

      /* ========================================================
         CHARACTER COUNTER
      ======================================================== */

      function updateCharacterCounter() {

        if (
          !specialRequestsInput ||
          !charCounter
        ) {
          return;
        }

        const length =
          specialRequestsInput.value.length;

        charCounter.textContent =
          `${length.toLocaleString(
            "en-PH"
          )} / ${MAX_SPECIAL_REQUESTS.toLocaleString(
            "en-PH"
          )}`;

        charCounter.classList.toggle(
          "is-near",
          length >= 2700 &&
          length < MAX_SPECIAL_REQUESTS
        );

        charCounter.classList.toggle(
          "is-full",
          length >=
            MAX_SPECIAL_REQUESTS
        );
      }

      /* ========================================================
         EVENT HANDLERS
      ======================================================== */

      roomInputs.forEach(
        (input) => {

          input.addEventListener(
            "change",
            () => {

              updateCapacity();
              updateSummary();
              clearValidation();

              toast(
                "Accommodation updated",
                `${
                  input.dataset.roomName ||
                  "Room"
                } is now selected.`,
                "success"
              );

            }
          );

        }
      );

      addOnInputs.forEach(
        (input) => {

          input.addEventListener(
            "change",
            () => {

              updateSummary();
              clearValidation();

            }
          );

        }
      );

      checkInInput.addEventListener(
        "change",
        () => {

          syncCheckoutMinimum();

          setInvalid(
            checkInInput,
            false
          );

          updateSummary();

          clearValidation();

        }
      );

      checkOutInput.addEventListener(
        "change",
        () => {

          setInvalid(
            checkOutInput,
            false
          );

          updateSummary();

          clearValidation();

        }
      );

      guestsInput.addEventListener(
        "input",
        () => {

          guestsInput.value =
            String(
              clampGuests(
                guestsInput.value
              )
            );

          setInvalid(
            guestsInput,
            false
          );

          updateSummary();

          clearValidation();

        }
      );

      decreaseGuests.addEventListener(
        "click",
        () => {

          guestsInput.value =
            String(
              Math.max(
                1,
                Math.floor(
                  safeNumber(
                    guestsInput.value
                  )
                ) - 1
              )
            );

          updateCapacity();
          updateSummary();

        }
      );

      increaseGuests.addEventListener(
        "click",
        () => {

          const room =
            selectedRoom();

          const max =
            room
              ? Math.max(
                  1,
                  Math.floor(
                    safeNumber(
                      room.dataset.roomCapacity
                    )
                  )
                )
              : 100;

          guestsInput.value =
            String(
              Math.min(
                max,
                Math.floor(
                  safeNumber(
                    guestsInput.value
                  )
                ) + 1
              )
            );

          updateCapacity();
          updateSummary();

        }
      );

      if (
        specialRequestsInput
      ) {

        specialRequestsInput.addEventListener(
          "input",
          () => {

            updateCharacterCounter();

            setInvalid(
              specialRequestsInput,
              specialRequestsInput.value.length >
                MAX_SPECIAL_REQUESTS
            );

            updateSummary();

          }
        );

      }

      /* ========================================================
         FORM SUBMIT
      ======================================================== */

      form.addEventListener(
        "submit",
        (event) => {

          if (submitting) {

            event.preventDefault();

            return;

          }

          if (
            !validateForm()
          ) {

            event.preventDefault();

            validationPanel.scrollIntoView(
              {
                behavior:
                  window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                  ).matches
                    ? "auto"
                    : "smooth",

                block:
                  "center"
              }
            );

            return;

          }

          setSubmittingState(
            true
          );

          clearValidation();

          setAvailability(
            "info",
            "Submitting your request. The server is rechecking room availability and pricing now…"
          );

          /*
           * IMPORTANT:
           *
           * We intentionally do NOT send a totalPrice field.
           *
           * The server remains authoritative for:
           *
           * - room pricing
           * - add-on pricing
           * - room availability
           * - date validity
           * - booking conflicts
           */

        }
      );

      /* ========================================================
         SERVER MESSAGE FOCUS
      ======================================================== */

      const serverError =
        document.getElementById(
          "serverError"
        );

      const serverSuccess =
        document.getElementById(
          "serverSuccess"
        );

      if (
        serverError ||
        serverSuccess
      ) {

        const target =
          serverError ||
          serverSuccess;

        window.setTimeout(
          () => {

            target.scrollIntoView(
              {
                behavior:
                  window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                  ).matches
                    ? "auto"
                    : "smooth",

                block:
                  "center"
              }
            );

          },
          100
        );

        if (serverError) {

          toast(
            "Booking could not be completed",
            serverError.textContent.trim(),
            "error"
          );

        } else if (
          serverSuccess
        ) {

          toast(
            "Reservation request received",
            serverSuccess.textContent.trim(),
            "success"
          );

        }
      }

      /* ========================================================
         INITIALIZE
      ======================================================== */

      initializeDates();
      syncCheckoutMinimum();
      updateCapacity();
      updateCharacterCounter();
      updateSummary();

    })();

  </script>

</body>
</html>