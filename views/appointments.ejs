<%
  /* ============================================================
   * PUFFER ISLE RESORT | IsleRMS
   * views/appointments.ejs
   *
   * Premium customer booking experience.
   *
   * Expected variables:
   *   rooms, addOns, appointments, user, csrfToken, error, success, title
   *
   * IMPORTANT:
   * - POST route remains /appointment/submit
   * - room values remain room._id
   * - addOns[] values remain add-on _id values
   * - server remains authoritative for pricing and availability
   * - contact is no longer visible to the customer
   * - existing saved user phone is retained invisibly for the
   *   current backend booking contract
   * ============================================================ */

  const safeRooms =
    Array.isArray(typeof rooms !== "undefined" ? rooms : [])
      ? rooms
      : [];

  const safeAddOns =
    Array.isArray(typeof addOns !== "undefined" ? addOns : [])
      ? addOns
      : [];

  const safeAppointments =
    Array.isArray(
      typeof appointments !== "undefined"
        ? appointments
        : []
    )
      ? appointments
      : [];

  const safeUser =
    typeof user !== "undefined" &&
    user &&
    typeof user === "object"
      ? user
      : {};

  const safeTitle =
    typeof title !== "undefined" && title
      ? title
      : "Book Your Stay | Puffer Isle Resort";

  const safeCsrfToken =
    typeof csrfToken !== "undefined" && csrfToken
      ? csrfToken
      : "";

  const safeError =
    typeof error !== "undefined" && error
      ? error
      : "";

  const safeSuccess =
    typeof success !== "undefined" && success
      ? success
      : "";

  function money(value) {
    const amount = Number(value) || 0;

    return amount.toLocaleString(
      "en-PH",
      {
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      }
    );
  }

  function dateLabel(value) {
    if (!value) {
      return "—";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "—";
    }

    return date.toLocaleDateString(
      "en-PH",
      {
        year: "numeric",
        month: "short",
        day: "numeric",
      }
    );
  }

  function normalizeStatus(value) {
    return String(value || "pending")
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-");
  }

  function appointmentRoomName(appointment) {
    if (!appointment) {
      return "Accommodation";
    }

    return (
      appointment.room ||
      appointment.roomName ||
      appointment.roomType ||
      appointment.accommodation ||
      (
        appointment.roomId &&
        appointment.roomId.name
      ) ||
      "Accommodation"
    );
  }
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="theme-color"
    content="#062528"
  >

  <meta
    name="description"
    content="Reserve your stay at Puffer Isle Resort with a secure and premium booking experience."
  >

  <meta
    name="color-scheme"
    content="light"
  >

  <meta
    name="csrf-token"
    content="<%= safeCsrfToken %>"
  >

  <link
    rel="icon"
    type="image/png"
    href="/images/islelogo.png"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <title>
    <%= safeTitle %>
  </title>

  <style>

    :root {
      --deep: #062528;
      --deep-2: #08373a;
      --deep-3: #0b4446;

      --teal: #0b8582;
      --teal-bright: #20b7af;
      --teal-soft: #eaf8f7;

      --gold: #e4b73f;
      --gold-bright: #f7d66e;
      --gold-soft: #fff8dd;

      --ink: #142124;
      --ink-soft: #405052;

      --muted: #788788;
      --muted-2: #9ba9a9;

      --surface: #f4f7f7;
      --surface-2: #eef2f2;

      --white: #ffffff;

      --line: #dde6e6;
      --line-strong: #c8d5d5;

      --success: #217a4b;
      --success-bg: #eef9f2;

      --warning: #946700;
      --warning-bg: #fff8e0;

      --danger: #b52c31;
      --danger-bg: #fff1f2;

      --info: #276a91;
      --info-bg: #edf7fc;

      --shadow-sm:
        0 8px 24px rgba(6, 37, 40, 0.06);

      --shadow-md:
        0 18px 48px rgba(6, 37, 40, 0.10);

      --shadow-lg:
        0 32px 90px rgba(6, 37, 40, 0.15);

      --radius-sm: 12px;
      --radius-md: 16px;
      --radius-lg: 22px;
      --radius-xl: 30px;
      --radius-pill: 999px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      font-family:
        "DM Sans",
        sans-serif;

      background:
        radial-gradient(
          circle at 8% 0%,
          rgba(228, 183, 63, 0.13),
          transparent 25%
        ),
        radial-gradient(
          circle at 92% 8%,
          rgba(11, 133, 130, 0.09),
          transparent 28%
        ),
        linear-gradient(
          180deg,
          #fbfdfd 0%,
          #f3f7f7 56%,
          #edf2f2 100%
        );

      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;

      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.42),
          transparent 28%
        );

      z-index: -1;
    }

    body.is-busy {
      cursor: progress;
    }

    body.modal-open {
      overflow: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button,
    label {
      -webkit-tap-highlight-color: transparent;
    }

    button:disabled {
      cursor: not-allowed;
    }

    .page-shell {
      width:
        min(
          1240px,
          calc(100% - 32px)
        );

      margin: 0 auto;
      padding: 118px 0 74px;
    }

    /* ============================================================
       HERO
    ============================================================ */

    .hero {
      position: relative;

      display: grid;

      grid-template-columns:
        minmax(0, 1.25fr)
        minmax(270px, 0.75fr);

      gap: 26px;
      align-items: end;

      margin-bottom: 24px;
      padding: 26px 28px;

      border:
        1px solid
        rgba(6, 37, 40, 0.08);

      border-radius: var(--radius-xl);

      background:
        radial-gradient(
          circle at 100% 0%,
          rgba(228, 183, 63, 0.10),
          transparent 25%
        ),
        linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.92),
          rgba(248, 251, 251, 0.96)
        );

      box-shadow: var(--shadow-md);

      overflow: hidden;
    }

    .hero::after {
      content: "";

      position: absolute;

      width: 220px;
      height: 220px;

      right: -80px;
      bottom: -105px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(11, 133, 130, 0.09),
          transparent 68%
        );

      pointer-events: none;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;

      margin-bottom: 10px;

      color: var(--teal);

      font-size: 0.68rem;
      font-weight: 800;

      letter-spacing: 0.17em;

      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";

      width: 28px;
      height: 2px;

      border-radius: 999px;

      background:
        var(--gold);
    }

    .hero h1 {
      margin: 0;

      font-family:
        "Playfair Display",
        serif;

      font-size:
        clamp(
          2.15rem,
          4.4vw,
          4rem
        );

      line-height: 1.02;

      letter-spacing: -0.035em;
    }

    .hero p {
      max-width: 760px;

      margin:
        13px 0 0;

      color: var(--muted);

      font-size: 0.9rem;

      line-height: 1.72;
    }

    .hero-badges {
      display: flex;

      justify-content: flex-end;

      flex-wrap: wrap;

      gap: 8px;
    }

    .hero-badge {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      min-height: 36px;

      padding: 0 12px;

      color: var(--ink-soft);

      border:
        1px solid
        var(--line);

      background:
        rgba(255, 255, 255, 0.76);

      border-radius:
        var(--radius-pill);

      box-shadow:
        0 5px 16px rgba(6, 37, 40, 0.035);

      font-size: 0.63rem;
      font-weight: 700;
    }

    .hero-badge i {
      color: var(--teal);
    }

    .hero-badge.gold i {
      color: var(--gold);
    }

    /* ============================================================
       SERVER NOTE
    ============================================================ */

    .server-note {
      display: flex;

      align-items: flex-start;

      gap: 11px;

      margin:
        0 0 20px;

      padding:
        13px 15px;

      color:
        var(--info);

      background:
        var(--info-bg);

      border:
        1px solid
        #d5ebf7;

      border-radius:
        var(--radius-md);

      font-size: 0.72rem;

      line-height: 1.55;
    }

    .server-note i {
      margin-top: 2px;
    }

    /* ============================================================
       FLASH MESSAGES
    ============================================================ */

    .flash-stack {
      display: grid;
      gap: 10px;

      margin-bottom: 20px;
    }

    .flash {
      display: flex;

      align-items: flex-start;

      gap: 12px;

      padding:
        14px 16px;

      border-radius:
        var(--radius-md);

      font-size:
        0.76rem;

      font-weight: 600;

      line-height: 1.55;

      box-shadow:
        var(--shadow-sm);
    }

    .flash i {
      width: 30px;
      height: 30px;

      flex:
        0 0 auto;

      display: grid;
      place-items: center;

      border-radius: 50%;
    }

    .flash.error {
      color: var(--danger);

      background:
        var(--danger-bg);

      border:
        1px solid
        #f3ced0;
    }

    .flash.error i {
      background:
        rgba(181, 44, 49, 0.08);
    }

    .flash.success {
      color: var(--success);

      background:
        var(--success-bg);

      border:
        1px solid
        #cfe8d9;
    }

    .flash.success i {
      background:
        rgba(33, 122, 75, 0.08);
    }

    /* ============================================================
       MAIN LAYOUT
    ============================================================ */

    .booking-layout {
      display: grid;

      grid-template-columns:
        minmax(0, 1.48fr)
        minmax(340px, 0.52fr);

      align-items: start;

      gap: 18px;
    }

    .booking-main,
    .summary-panel,
    .history-panel {
      border:
        1px solid
        rgba(6, 37, 40, 0.08);

      border-radius:
        var(--radius-xl);

      box-shadow:
        var(--shadow-lg);
    }

    .booking-main {
      min-width: 0;

      padding: 30px;

      background:
        rgba(255,255,255,0.97);
    }

    /* ============================================================
       PROGRESS
    ============================================================ */

    .progress-strip {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0,1fr));

      gap: 8px;

      margin-bottom: 27px;

      padding: 8px;

      background:
        var(--surface);

      border:
        1px solid
        var(--line);

      border-radius:
        16px;
    }

    .progress-step {
      position: relative;

      display: flex;

      align-items: center;

      gap: 8px;

      min-width: 0;

      min-height: 38px;

      padding:
        0 10px;

      border-radius:
        11px;

      color:
        var(--muted);

      transition:
        180ms ease;
    }

    .progress-step-number {
      width: 25px;
      height: 25px;

      display: grid;
      place-items: center;

      flex:
        0 0 auto;

      border-radius:
        50%;

      background:
        #dce6e6;

      color:
        #607070;

      font-size:
        0.62rem;

      font-weight:
        800;
    }

    .progress-step span:last-child {
      min-width: 0;

      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

      font-size:
        0.59rem;

      font-weight:
        800;

      text-transform:
        uppercase;

      letter-spacing:
        0.05em;
    }

    .progress-step.is-active {
      color:
        var(--deep);

      background:
        #fffdf4;

      box-shadow:
        0 6px 18px
        rgba(228,183,63,0.09);
    }

    .progress-step.is-active
    .progress-step-number {
      color:
        var(--ink);

      background:
        var(--gold);

      box-shadow:
        0 5px 12px
        rgba(228,183,63,0.22);
    }

    .progress-step.is-complete
    .progress-step-number {
      color:
        #fff;

      background:
        var(--teal);
    }

    /* ============================================================
       SECTIONS
    ============================================================ */

    .section {
      padding:
        0 0 30px;

      margin:
        0 0 30px;

      border-bottom:
        1px solid
        var(--line);
    }

    .section:last-child {
      padding-bottom: 0;
      margin-bottom: 0;

      border-bottom:
        0;
    }

    .section-head {
      display: flex;

      align-items: flex-start;

      justify-content:
        space-between;

      gap:
        16px;

      margin-bottom:
        17px;
    }

    .section-title-wrap {
      min-width: 0;
    }

    .section-title {
      display: flex;

      align-items: center;

      gap: 10px;
    }

    .section-number {
      width: 30px;
      height: 30px;

      flex:
        0 0 auto;

      display: grid;
      place-items: center;

      border-radius:
        10px;

      color:
        var(--ink);

      background:
        var(--gold);

      box-shadow:
        0 7px 17px
        rgba(228,183,63,0.18);

      font-size:
        0.68rem;

      font-weight:
        800;
    }

    .section-title h2 {
      margin: 0;

      color:
        var(--ink);

      font-size:
        0.98rem;

      font-weight:
        800;

      letter-spacing:
        -0.01em;
    }

    .section-title-wrap > p {
      margin:
        7px 0 0 40px;

      color:
        var(--muted);

      font-size:
        0.69rem;

      line-height:
        1.6;
    }

    .section-status {
      display: inline-flex;

      align-items: center;

      gap:
        7px;

      min-height:
        29px;

      padding:
        0 9px;

      color:
        var(--muted);

      background:
        var(--surface);

      border:
        1px solid
        var(--line);

      border-radius:
        var(--radius-pill);

      white-space:
        nowrap;

      font-size:
        0.58rem;

      font-weight:
        700;
    }

    .section-status.is-ready {
      color:
        var(--success);

      background:
        var(--success-bg);

      border-color:
        #d3eadb;
    }

    .required {
      color:
        var(--danger);
    }

    /* ============================================================
       ROOMS
    ============================================================ */

    .room-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        11px;
    }

    .room-option {
      position:
        relative;

      min-width:
        0;
    }

    .room-option > input {
      position:
        absolute;

      opacity:
        0;

      width:
        1px;

      height:
        1px;

      pointer-events:
        none;
    }

    .room-card {
      display: grid;

      grid-template-columns:
        128px
        minmax(0,1fr);

      min-height:
        124px;

      overflow:
        hidden;

      border:
        1.5px solid
        var(--line);

      border-radius:
        17px;

      background:
        #fff;

      cursor:
        pointer;

      transition:
        180ms ease;
    }

    .room-card:hover {
      transform:
        translateY(-2px);

      border-color:
        #c5d4d4;

      box-shadow:
        var(--shadow-sm);
    }

    .room-option >
    input:focus-visible +
    .room-card {
      outline:
        3px solid
        rgba(11,133,130,.18);

      outline-offset:
        2px;
    }

    .room-option >
    input:checked +
    .room-card {
      border-color:
        var(--teal);

      background:
        #fbfffe;

      box-shadow:
        0 12px 30px
          rgba(11,133,130,.10),
        0 0 0 2px
          rgba(228,183,63,.16);
    }

    .room-visual {
      position:
        relative;

      min-height:
        124px;

      overflow:
        hidden;

      background:
        linear-gradient(
          135deg,
          #eaf4f4,
          #f9f9f4
        );
    }

    .room-visual img {
      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

      transition:
        transform
        0.42s ease;
    }

    .room-card:hover
    .room-visual img {
      transform:
        scale(1.04);
    }

    .room-placeholder {
      width:
        100%;

      height:
        100%;

      display:
        grid;

      place-items:
        center;

      color:
        var(--teal);

      font-size:
        1.8rem;

      font-weight:
        800;
    }

    .room-selected {
      position:
        absolute;

      top:
        8px;

      left:
        8px;

      display:
        none;

      align-items:
        center;

      gap:
        5px;

      min-height:
        24px;

      padding:
        0 8px;

      color:
        #15231f;

      background:
        var(--gold);

      border-radius:
        var(--radius-pill);

      font-size:
        0.55rem;

      font-weight:
        800;

      box-shadow:
        0 4px 12px
        rgba(0,0,0,.12);
    }

    .room-option >
    input:checked +
    .room-card
    .room-selected {
      display:
        inline-flex;
    }

    .room-copy {
      min-width:
        0;

      padding:
        12px 13px;

      display:
        flex;

      flex-direction:
        column;
    }

    .room-top {
      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        9px;
    }

    .room-name {
      min-width:
        0;

      color:
        var(--ink);

      font-size:
        0.77rem;

      font-weight:
        800;

      line-height:
        1.35;
    }

    .room-price {
      flex:
        0 0 auto;

      color:
        var(--teal);

      font-size:
        0.75rem;

      font-weight:
        800;

      white-space:
        nowrap;
    }

    .room-price small {
      color:
        var(--muted);

      font-size:
        0.54rem;

      font-weight:
        600;
    }

    .room-description {
      display:
        -webkit-box;

      margin-top:
        5px;

      overflow:
        hidden;

      color:
        var(--muted);

      font-size:
        0.6rem;

      line-height:
        1.55;

      -webkit-box-orient:
        vertical;

      -webkit-line-clamp:
        2;
    }

    .room-meta {
      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        5px;

      margin-top:
        auto;

      padding-top:
        9px;
    }

    .room-pill {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        5px;

      min-height:
        22px;

      padding:
        0 7px;

      color:
        #536363;

      background:
        var(--surface);

      border-radius:
        var(--radius-pill);

      font-size:
        0.53rem;

      font-weight:
        700;
    }

    .room-pill i {
      color:
        var(--teal);

      font-size:
        0.5rem;
    }

    .room-selection-note {
      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      margin-top:
        10px;

      padding:
        10px 12px;

      color:
        var(--teal);

      background:
        var(--teal-soft);

      border:
        1px solid
        #d4efed;

      border-radius:
        12px;

      font-size:
        0.61rem;

      font-weight:
        700;
    }

    .empty-state {
      padding:
        28px 22px;

      color:
        var(--muted);

      background:
        var(--surface);

      border:
        1px dashed
        var(--line-strong);

      border-radius:
        16px;

      text-align:
        center;

      font-size:
        0.71rem;

      line-height:
        1.6;
    }

    .empty-state i {
      display:
        block;

      margin-bottom:
        8px;

      color:
        var(--teal);

      font-size:
        1.15rem;
    }

    /* ============================================================
       FORM
    ============================================================ */

    .form-grid {
      display:
        grid;

      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        15px;
    }

    .field {
      min-width:
        0;
    }

    .field label {
      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      margin-bottom:
        7px;

      color:
        var(--ink-soft);

      font-size:
        0.69rem;

      font-weight:
        800;
    }

    .label-note {
      color:
        var(--muted-2);

      font-size:
        0.55rem;

      font-weight:
        600;
    }

    .input-shell {
      position:
        relative;
    }

    .input-shell > i {
      position:
        absolute;

      left:
        13px;

      top:
        50%;

      transform:
        translateY(-50%);

      color:
        var(--muted-2);

      pointer-events:
        none;

      font-size:
        0.73rem;
    }

    .control,
    .field textarea {
      width:
        100%;

      border:
        1.5px solid
        var(--line);

      border-radius:
        13px;

      outline:
        none;

      background:
        #fbfcfc;

      color:
        var(--ink);

      padding:
        12px 13px;

      transition:
        160ms ease;
    }

    .input-shell .control {
      padding-left:
        38px;
    }

    .control:hover,
    .field textarea:hover {
      border-color:
        var(--line-strong);
    }

    .control:focus,
    .field textarea:focus {
      border-color:
        var(--teal);

      background:
        #fff;

      box-shadow:
        0 0 0 4px
        rgba(11,133,130,.08);
    }

    .control[aria-invalid="true"],
    .field textarea[aria-invalid="true"] {
      border-color:
        var(--danger);

      box-shadow:
        0 0 0 4px
        rgba(181,44,49,.07);
    }

    input[type="date"]::-webkit-calendar-picker-indicator {
      opacity:
        .65;

      cursor:
        pointer;
    }

    .field small {
      display:
        block;

      margin-top:
        6px;

      color:
        var(--muted);

      font-size:
        0.57rem;

      line-height:
        1.55;
    }

    /* Guest stepper */

    .guest-control {
      display:
        grid;

      grid-template-columns:
        42px
        minmax(0,1fr)
        42px;

      align-items:
        center;

      overflow:
        hidden;

      border:
        1.5px solid
        var(--line);

      border-radius:
        13px;

      background:
        #fbfcfc;

      transition:
        160ms ease;
    }

    .guest-control:focus-within {
      border-color:
        var(--teal);

      box-shadow:
        0 0 0 4px
        rgba(11,133,130,.08);

      background:
        #fff;
    }

    .guest-stepper {
      width:
        42px;

      height:
        47px;

      display:
        grid;

      place-items:
        center;

      border:
        0;

      background:
        transparent;

      color:
        var(--teal);

      cursor:
        pointer;

      transition:
        160ms ease;
    }

    .guest-stepper:hover:not(:disabled) {
      background:
        var(--teal-soft);
    }

    .guest-stepper:disabled {
      opacity:
        .35;
    }

    .guest-input {
      width:
        100%;

      height:
        47px;

      border:
        0;

      outline:
        0;

      background:
        transparent;

      color:
        var(--ink);

      text-align:
        center;

      font-weight:
        800;
    }

    .form-hint {
      display:
        flex;

      align-items:
        flex-start;

      gap:
        8px;

      margin-top:
        10px;

      padding:
        10px 12px;

      color:
        var(--muted);

      background:
        #f7f9f9;

      border:
        1px solid
        var(--line);

      border-radius:
        11px;

      font-size:
        0.59rem;

      line-height:
        1.55;
    }

    .form-hint i {
      color:
        var(--teal);

      margin-top:
        2px;
    }

    .textarea-wrap {
      position:
        relative;
    }

    .field textarea {
      min-height:
        132px;

      resize:
        vertical;

      line-height:
        1.65;
    }

    .char-counter {
      position:
        absolute;

      right:
        10px;

      bottom:
        10px;

      min-height:
        24px;

      padding:
        0 8px;

      display:
        inline-flex;

      align-items:
        center;

      color:
        var(--muted);

      background:
        rgba(255,255,255,.88);

      border:
        1px solid
        var(--line);

      border-radius:
        var(--radius-pill);

      font-size:
        0.54rem;

      font-weight:
        700;

      pointer-events:
        none;
    }

    .char-counter.is-near {
      color:
        var(--warning);

      border-color:
        #eadda5;

      background:
        var(--warning-bg);
    }

    .char-counter.is-full {
      color:
        var(--danger);

      border-color:
        #efc3c5;

      background:
        var(--danger-bg);
    }

    /* ============================================================
       ADDONS
    ============================================================ */

    .addon-grid {
      display:
        grid;

      grid-template-columns:
        repeat(2, minmax(0,1fr));

      gap:
        10px;
    }

    .addon-option {
      position:
        relative;

      min-width:
        0;
    }

    .addon-option > input {
      position:
        absolute;

      opacity:
        0;

      width:
        1px;

      height:
        1px;

      pointer-events:
        none;
    }

    .addon-card {
      min-height:
        92px;

      padding:
        12px;

      display:
        grid;

      grid-template-columns:
        28px
        minmax(0,1fr);

      gap:
        9px;

      border:
        1.5px solid
        var(--line);

      border-radius:
        15px;

      background:
        #fbfcfc;

      cursor:
        pointer;

      transition:
        180ms ease;
    }

    .addon-option:hover
    .addon-card {
      transform:
        translateY(-1px);

      border-color:
        var(--line-strong);

      box-shadow:
        var(--shadow-sm);
    }

    .addon-option >
    input:focus-visible +
    .addon-card {
      outline:
        3px solid
        rgba(11,133,130,.15);

      outline-offset:
        2px;
    }

    .addon-option >
    input:checked +
    .addon-card {
      border-color:
        #b98b15;

      background:
        #fffdf4;

      box-shadow:
        0 10px 24px
        rgba(228,183,63,.10);
    }

    .addon-check {
      width:
        28px;

      height:
        28px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        var(--line-strong);

      border-radius:
        9px;

      background:
        #fff;

      color:
        transparent;

      transition:
        160ms ease;
    }

    .addon-option >
    input:checked +
    .addon-card
    .addon-check {
      color:
        var(--ink);

      background:
        var(--gold);

      border-color:
        var(--gold);
    }

    .addon-copy {
      min-width:
        0;
    }

    .addon-top {
      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        10px;
    }

    .addon-name {
      min-width:
        0;

      color:
        var(--ink);

      font-size:
        0.67rem;

      font-weight:
        800;

      line-height:
        1.4;
    }

    .addon-price {
      flex:
        0 0 auto;

      color:
        var(--teal);

      font-size:
        0.64rem;

      font-weight:
        800;

      white-space:
        nowrap;
    }

    .addon-description {
      display:
        -webkit-box;

      margin-top:
        3px;

      overflow:
        hidden;

      color:
        var(--muted);

      font-size:
        0.56rem;

      line-height:
        1.52;

      -webkit-box-orient:
        vertical;

      -webkit-line-clamp:
        2;
    }

    .addon-note {
      display:
        inline-flex;

      margin-top:
        6px;

      padding:
        3px 6px;

      color:
        #5f6d6d;

      background:
        #eef3f3;

      border-radius:
        var(--radius-pill);

      font-size:
        0.47rem;

      font-weight:
        700;
    }

    /* ============================================================
       VALIDATION
    ============================================================ */

    .validation-panel {
      display:
        none;

      margin-top:
        12px;

      padding:
        12px 13px;

      border-radius:
        13px;

      color:
        var(--danger);

      background:
        var(--danger-bg);

      border:
        1px solid
        #efcdd0;

      font-size:
        0.64rem;

      font-weight:
        700;

      line-height:
        1.55;
    }

    .validation-panel.is-visible {
      display:
        flex;

      gap:
        9px;
    }

    .availability-panel {
      display:
        none;

      margin-top:
        10px;

      padding:
        11px 12px;

      border-radius:
        12px;

      font-size:
        0.61rem;

      font-weight:
        700;

      line-height:
        1.52;
    }

    .availability-panel.is-visible {
      display:
        flex;

      align-items:
        flex-start;

      gap:
        8px;
    }

    .availability-panel.ok {
      color:
        var(--success);

      background:
        var(--success-bg);

      border:
        1px solid
        #d1e9db;
    }

    .availability-panel.warn {
      color:
        var(--warning);

      background:
        var(--warning-bg);

      border:
        1px solid
        #ecdfaa;
    }

    .availability-panel.error {
      color:
        var(--danger);

      background:
        var(--danger-bg);

      border:
        1px solid
        #efcdd0;
    }

    .availability-panel.info {
      color:
        var(--info);

      background:
        var(--info-bg);

      border:
        1px solid
        #d6eaf5;
    }

    /* ============================================================
       SUMMARY
    ============================================================ */

    .summary-panel {
      position:
        sticky;

      top:
        92px;

      min-width:
        0;

      overflow:
        hidden;

      color:
        #fff;

      background:
        radial-gradient(
          circle at 88% 0%,
          rgba(228,183,63,.19),
          transparent 27%
        ),
        radial-gradient(
          circle at 0% 100%,
          rgba(32,183,175,.16),
          transparent 33%
        ),
        linear-gradient(
          150deg,
          #092c30 0%,
          #071c1f 100%
        );
    }

    .summary-inner {
      padding:
        27px;
    }

    .summary-kicker {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      min-height:
        29px;

      padding:
        0 9px;

      color:
        rgba(255,255,255,.72);

      background:
        rgba(255,255,255,.055);

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius:
        var(--radius-pill);

      font-size:
        0.54rem;

      font-weight:
        800;

      letter-spacing:
        0.05em;

      text-transform:
        uppercase;
    }

    .summary-kicker i {
      color:
        var(--gold-bright);
    }

    .summary-panel h2 {
      margin:
        13px 0 0;

      font-family:
        "Playfair Display",
        serif;

      font-size:
        1.62rem;

      line-height:
        1.1;

      letter-spacing:
        -0.02em;
    }

    .summary-subtitle {
      margin:
        7px 0 19px;

      color:
        rgba(255,255,255,.53);

      font-size:
        0.61rem;

      line-height:
        1.6;
    }

    .summary-progress {
      height:
        5px;

      margin-bottom:
        18px;

      overflow:
        hidden;

      border-radius:
        999px;

      background:
        rgba(255,255,255,.08);
    }

    .summary-progress-bar {
      width:
        0%;

      height:
        100%;

      border-radius:
        inherit;

      background:
        linear-gradient(
          90deg,
          var(--teal-bright),
          var(--gold)
        );

      transition:
        width
        .25s ease;
    }

    .summary-card {
      margin-bottom:
        12px;

      padding:
        13px;

      border:
        1px solid
        rgba(255,255,255,.08);

      border-radius:
        15px;

      background:
        rgba(255,255,255,.045);
    }

    .summary-room-name {
      color:
        #fff;

      font-size:
        0.79rem;

      font-weight:
        800;

      line-height:
        1.4;
    }

    .summary-room-meta {
      margin-top:
        4px;

      color:
        rgba(255,255,255,.51);

      font-size:
        0.57rem;

      line-height:
        1.55;
    }

    .summary-details {
      display:
        grid;

      grid-template-columns:
        repeat(2,minmax(0,1fr));

      gap:
        7px;

      margin-bottom:
        14px;
    }

    .summary-detail {
      min-width:
        0;

      padding:
        10px 11px;

      border:
        1px solid
        rgba(255,255,255,.07);

      border-radius:
        13px;

      background:
        rgba(255,255,255,.035);
    }

    .summary-detail-label {
      color:
        rgba(255,255,255,.38);

      font-size:
        0.48rem;

      font-weight:
        800;

      letter-spacing:
        0.08em;

      text-transform:
        uppercase;
    }

    .summary-detail-value {
      min-width:
        0;

      margin-top:
        3px;

      overflow:
        hidden;

      color:
        rgba(255,255,255,.9);

      font-size:
        0.61rem;

      font-weight:
        700;

      line-height:
        1.45;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;
    }

    .price-block {
      border-top:
        1px solid
        rgba(255,255,255,.08);

      padding-top:
        4px;
    }

    .price-row {
      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        14px;

      padding:
        9px 0;

      border-bottom:
        1px solid
        rgba(255,255,255,.065);

      color:
        rgba(255,255,255,.51);

      font-size:
        0.61rem;
    }

    .price-row:last-child {
      border-bottom:
        0;
    }

    .price-row strong {
      color:
        #fff;

      font-size:
        0.64rem;

      font-weight:
        700;

      text-align:
        right;

      white-space:
        nowrap;
    }

    .summary-addon-list {
      display:
        grid;

      gap:
        6px;

      max-height:
        112px;

      margin-top:
        3px;

      overflow:
        auto;

      scrollbar-width:
        thin;
    }

    .summary-addon-row {
      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      color:
        rgba(255,255,255,.42);

      font-size:
        0.52rem;
    }

    .summary-addon-row strong {
      color:
        rgba(255,255,255,.74);

      font-weight:
        700;

      white-space:
        nowrap;
    }

    .summary-total {
      display:
        flex;

      align-items:
        flex-end;

      justify-content:
        space-between;

      gap:
        14px;

      margin-top:
        16px;

      padding:
        14px;

      border:
        1px dashed
        rgba(228,183,63,.55);

      border-radius:
        16px;

      background:
        rgba(228,183,63,.08);
    }

    .summary-total span {
      color:
        var(--gold-bright);

      font-size:
        0.57rem;

      font-weight:
        800;

      letter-spacing:
        0.07em;

      text-transform:
        uppercase;
    }

    .summary-total strong {
      color:
        #fff;

      font-size:
        clamp(
          1.65rem,
          3vw,
          2.15rem
        );

      font-weight:
        800;

      line-height:
        1;

      letter-spacing:
        -0.04em;

      text-align:
        right;
    }

    /* ============================================================
       SUBMIT BUTTON
    ============================================================ */

    .submit-button {
      position:
        relative;

      width:
        100%;

      min-height:
        56px;

      margin-top:
        12px;

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        9px;

      border:
        0;

      border-radius:
        15px;

      color:
        #172017;

      background:
        linear-gradient(
          135deg,
          #e4b73f,
          #f7d66e
        );

      box-shadow:
        0 13px 30px
        rgba(228,183,63,.16);

      cursor:
        pointer;

      font-size:
        0.74rem;

      font-weight:
        900;

      transition:
        180ms ease;
    }

    .submit-button:hover:not(:disabled) {
      transform:
        translateY(-2px);

      box-shadow:
        0 18px 38px
        rgba(228,183,63,.23);
    }

    .submit-button:active:not(:disabled) {
      transform:
        translateY(0);
    }

    .submit-button:disabled {
      opacity:
        .56;

      box-shadow:
        none;
    }

    .button-loader {
      display:
        none;

      width:
        16px;

      height:
        16px;

      border:
        2px solid
        rgba(23,32,23,.24);

      border-top-color:
        #172017;

      border-radius:
        50%;

      animation:
        spin
        .7s
        linear
        infinite;
    }

    .submit-button.is-loading
    .button-loader {
      display:
        inline-block;
    }

    .submit-button.is-loading
    #submitButtonText {
      opacity:
        .78;
    }

    .security-line {
      display:
        flex;

      align-items:
        flex-start;

      gap:
        8px;

      margin-top:
        10px;

      color:
        rgba(255,255,255,.38);

      font-size:
        0.52rem;

      line-height:
        1.55;

      text-align:
        center;
    }

    .security-line i {
      color:
        rgba(255,255,255,.48);

      margin-top:
        2px;
    }

    .summary-footer {
      padding:
        13px 27px 17px;

      border-top:
        1px solid
        rgba(255,255,255,.07);

      background:
        rgba(0,0,0,.08);

      color:
        rgba(255,255,255,.39);

      font-size:
        0.51rem;

      line-height:
        1.58;
    }

    .summary-footer strong {
      color:
        rgba(255,255,255,.68);
    }

    /* ============================================================
       HISTORY
    ============================================================ */

    .history-panel {
      margin-top:
        18px;

      padding:
        26px;

      background:
        rgba(255,255,255,.97);
    }

    .history-head {
      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        15px;

      margin-bottom:
        17px;
    }

    .history-head h2 {
      margin:
        0;

      font-family:
        "Playfair Display",
        serif;

      font-size:
        1.35rem;
    }

    .history-head p {
      max-width:
        700px;

      margin:
        5px 0 0;

      color:
        var(--muted);

      font-size:
        0.67rem;

      line-height:
        1.6;
    }

    .history-count {
      flex:
        0 0 auto;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      min-height:
        31px;

      padding:
        0 10px;

      color:
        var(--teal);

      background:
        var(--teal-soft);

      border-radius:
        var(--radius-pill);

      font-size:
        0.57rem;

      font-weight:
        800;

      white-space:
        nowrap;
    }

    .history-list {
      display:
        grid;

      gap:
        9px;
    }

    .history-item {
      display:
        grid;

      grid-template-columns:
        minmax(0,1fr)
        auto;

      gap:
        17px;

      padding:
        14px;

      border:
        1px solid
        var(--line);

      border-radius:
        15px;

      background:
        #fbfcfc;

      transition:
        180ms ease;
    }

    .history-item:hover {
      transform:
        translateY(-1px);

      border-color:
        var(--line-strong);

      box-shadow:
        var(--shadow-sm);
    }

    .history-title-row {
      display:
        flex;

      align-items:
        center;

      flex-wrap:
        wrap;

      gap:
        8px;
    }

    .history-item h3 {
      margin:
        0;

      color:
        var(--ink);

      font-size:
        0.73rem;

      font-weight:
        800;
    }

    .status {
      display:
        inline-flex;

      align-items:
        center;

      gap:
        5px;

      min-height:
        24px;

      padding:
        0 8px;

      border-radius:
        var(--radius-pill);

      font-size:
        0.5rem;

      font-weight:
        800;

      text-transform:
        capitalize;
    }

    .status-pending {
      color:
        var(--warning);

      background:
        var(--warning-bg);
    }

    .status-accepted,
    .status-confirmed {
      color:
        var(--success);

      background:
        var(--success-bg);
    }

    .status-cancelled,
    .status-declined,
    .status-rejected {
      color:
        var(--danger);

      background:
        var(--danger-bg);
    }

    .status-checked-in,
    .status-checked-out,
    .status-completed {
      color:
        var(--teal);

      background:
        var(--teal-soft);
    }

    .history-meta {
      margin-top:
        5px;

      color:
        var(--muted);

      font-size:
        0.59rem;

      line-height:
        1.6;
    }

    .history-created {
      margin-top:
        4px;

      color:
        var(--muted-2);

      font-size:
        0.52rem;
    }

    .history-price {
      color:
        var(--teal);

      font-size:
        0.8rem;

      font-weight:
        900;

      text-align:
        right;

      white-space:
        nowrap;
    }

    .history-small {
      margin-top:
        4px;

      color:
        var(--muted-2);

      font-size:
        0.51rem;

      text-align:
        right;
    }

    /* ============================================================
       TOAST
    ============================================================ */

    .toast-stack {
      position:
        fixed;

      right:
        18px;

      bottom:
        18px;

      z-index:
        5000;

      width:
        min(
          370px,
          calc(100vw - 36px)
        );

      display:
        grid;

      gap:
        8px;

      pointer-events:
        none;
    }

    .toast {
      display:
        flex;

      align-items:
        flex-start;

      gap:
        10px;

      padding:
        12px 13px;

      border:
        1px solid
        var(--line);

      border-radius:
        13px;

      background:
        rgba(255,255,255,.96);

      box-shadow:
        var(--shadow-lg);

      transform:
        translateY(12px);

      opacity:
        0;

      animation:
        toastIn
        .18s
        ease
        forwards;
    }

    .toast-icon {
      width:
        28px;

      height:
        28px;

      flex:
        0 0 auto;

      display:
        grid;

      place-items:
        center;

      border-radius:
        9px;

      background:
        var(--teal-soft);

      color:
        var(--teal);

      font-size:
        .7rem;
    }

    .toast.warning .toast-icon {
      color:
        var(--warning);

      background:
        var(--warning-bg);
    }

    .toast.error .toast-icon {
      color:
        var(--danger);

      background:
        var(--danger-bg);
    }

    .toast.success .toast-icon {
      color:
        var(--success);

      background:
        var(--success-bg);
    }

    .toast strong {
      display:
        block;

      font-size:
        .64rem;
    }

    .toast span {
      display:
        block;

      margin-top:
        2px;

      color:
        var(--muted);

      font-size:
        .57rem;

      line-height:
        1.5;
    }

    @keyframes toastIn {
      to {
        opacity:
          1;

        transform:
          translateY(0);
      }
    }

    @keyframes spin {
      to {
        transform:
          rotate(360deg);
      }
    }

    /* ============================================================
       ACCESSIBILITY
    ============================================================ */

    .sr-only {
      position:
        absolute !important;

      width:
        1px !important;

      height:
        1px !important;

      padding:
        0 !important;

      margin:
        -1px !important;

      overflow:
        hidden !important;

      clip:
        rect(0,0,0,0) !important;

      white-space:
        nowrap !important;

      border:
        0 !important;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @media (max-width: 1060px) {

      .booking-layout {
        grid-template-columns:
          1fr;
      }

      .summary-panel {
        position:
          static;
      }

      .summary-inner {
        padding:
          24px;
      }

      .summary-footer {
        padding-left:
          24px;

        padding-right:
          24px;
      }

      .hero {
        grid-template-columns:
          1fr;
      }

      .hero-badges {
        justify-content:
          flex-start;
      }
    }

    @media (max-width: 800px) {

      .page-shell {
        width:
          min(
            100% - 20px,
            1240px
          );

        padding-top:
          96px;
      }

      .hero {
        padding:
          21px 19px;

        border-radius:
          23px;
      }

      .booking-main {
        padding:
          21px;
      }

      .room-grid {
        grid-template-columns:
          1fr;
      }

      .progress-strip {
        grid-template-columns:
          repeat(
            2,
            minmax(0,1fr)
          );
      }

      .addon-grid {
        grid-template-columns:
          1fr;
      }

      .history-panel {
        padding:
          21px;
      }
    }

    @media (max-width: 580px) {

      .page-shell {
        width:
          min(
            100% - 14px,
            1240px
          );

        padding-top:
          88px;

        padding-bottom:
          45px;
      }

      .hero {
        gap:
          17px;
      }

      .hero h1 {
        font-size:
          2.2rem;
      }

      .hero-badge {
        flex:
          1 1 auto;

        justify-content:
          center;
      }

      .booking-main {
        padding:
          16px;

        border-radius:
          22px;
      }

      .section {
        padding-bottom:
          24px;

        margin-bottom:
          24px;
      }

      .progress-strip {
        gap:
          5px;

        padding:
          6px;
      }

      .progress-step {
        min-height:
          35px;

        padding:
          0 7px;
      }

      .progress-step-number {
        width:
          22px;

        height:
          22px;

        font-size:
          .56rem;
      }

      .progress-step
      span:last-child {
        font-size:
          .52rem;
      }

      .form-grid {
        grid-template-columns:
          1fr;

        gap:
          13px;
      }

      .summary-inner {
        padding:
          18px;
      }

      .summary-footer {
        padding-left:
          18px;

        padding-right:
          18px;
      }

      .summary-total {
        align-items:
          center;
      }

      .history-head {
        flex-direction:
          column;
      }

      .history-item {
        grid-template-columns:
          1fr;
      }

      .history-price {
        text-align:
          left;
      }

      .history-small {
        text-align:
          left;
      }
    }

    @media (max-width: 430px) {

      .room-card {
        grid-template-columns:
          108px
          minmax(0,1fr);

        min-height:
          111px;
      }

      .room-visual {
        min-height:
          111px;
      }

      .room-copy {
        padding:
          10px 11px;
      }

      .room-description {
        -webkit-line-clamp:
          2;
      }

      .summary-details {
        grid-template-columns:
          1fr 1fr;
      }

      .summary-total strong {
        font-size:
          1.72rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {

        scroll-behavior:
          auto !important;

        animation-duration:
          .01ms !important;

        animation-iteration-count:
          1 !important;

        transition-duration:
          .01ms !important;
      }
    }

  </style>
</head>

<body>

  <%- include("partials/navbar") %>

  <main class="page-shell">

    <!-- ========================================================
         HERO
    ========================================================= -->

    <section
      class="hero"
      aria-labelledby="pageTitle"
    >

      <div>

        <div class="eyebrow">
          Puffer Isle Resort
        </div>

        <h1 id="pageTitle">
          Reserve your island escape.
        </h1>

        <p>
          Choose your accommodation, set your stay dates,
          personalize your experience, and review an instant
          estimate before sending your reservation request.
          Pricing and availability are always revalidated
          by the server before a booking is saved.
        </p>

      </div>

      <div
        class="hero-badges"
        aria-label="Booking benefits"
      >

        <span class="hero-badge">
          <i class="fa-solid fa-shield-halved"></i>
          Secure request
        </span>

        <span class="hero-badge gold">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          Live estimate
        </span>

        <span class="hero-badge">
          <i class="fa-solid fa-clock"></i>
          Fast confirmation workflow
        </span>

      </div>

    </section>

    <!-- ========================================================
         SERVER NOTE
    ========================================================= -->

    <div
      class="server-note"
      role="note"
    >

      <i
        class="fa-solid fa-circle-info"
        aria-hidden="true"
      ></i>

      <div>

        <strong>
          Good to know:
        </strong>

        the totals shown on this page are only a convenience
        estimate. IsleRMS independently validates room
        availability, room pricing, add-ons, dates, and
        booking rules on the server when you submit.

      </div>

    </div>

    <!-- ========================================================
         FLASH MESSAGES
    ========================================================= -->

    <% if (safeError || safeSuccess) { %>

      <div
        class="flash-stack"
        id="flashStack"
      >

        <% if (safeError) { %>

          <div
            class="flash error"
            id="serverError"
            role="alert"
            aria-live="assertive"
          >

            <i
              class="fa-solid fa-circle-exclamation"
              aria-hidden="true"
            ></i>

            <span>
              <%= safeError %>
            </span>

          </div>

        <% } %>

        <% if (safeSuccess) { %>

          <div
            class="flash success"
            id="serverSuccess"
            role="status"
            aria-live="polite"
          >

            <i
              class="fa-solid fa-circle-check"
              aria-hidden="true"
            ></i>

            <span>
              <%= safeSuccess %>
            </span>

          </div>

        <% } %>

      </div>

    <% } %>

    <!-- ========================================================
         BOOKING FORM
    ========================================================= -->

    <form
      id="bookingForm"
      action="/appointment/submit"
      method="POST"
      novalidate
      autocomplete="on"
    >

      <input
        type="hidden"
        name="_csrf"
        value="<%= safeCsrfToken %>"
      >

      <!--
        Contact input is intentionally hidden.

        The user no longer enters or edits a contact number here.
        The current booking backend still expects "contact", so
        the customer's existing saved profile phone is supplied
        invisibly for compatibility.
      -->

      <input
        type="hidden"
        id="contact"
        name="contact"
        value="<%= safeUser.phone || "" %>"
      >

      <div class="booking-layout">

        <!-- ====================================================
             MAIN
        ===================================================== -->

        <section
          class="booking-main"
          aria-label="Booking form"
        >

          <!-- ==================================================
               PROGRESS
          =================================================== -->

          <nav
            class="progress-strip"
            aria-label="Booking progress"
            id="progressStrip"
          >

            <div
              class="progress-step is-active"
              data-progress="room"
            >

              <span class="progress-step-number">
                1
              </span>

              <span>
                Accommodation
              </span>

            </div>

            <div
              class="progress-step"
              data-progress="dates"
            >

              <span class="progress-step-number">
                2
              </span>

              <span>
                Stay details
              </span>

            </div>

            <div
              class="progress-step"
              data-progress="addons"
            >

              <span class="progress-step-number">
                3
              </span>

              <span>
                Extras
              </span>

            </div>

            <div
              class="progress-step"
              data-progress="request"
            >

              <span class="progress-step-number">
                4
              </span>

              <span>
                Review
              </span>

            </div>

          </nav>

          <!-- ==================================================
               ACCOMMODATION
          =================================================== -->

          <section
            class="section"
            data-step="room"
            aria-labelledby="accommodationHeading"
          >

            <div class="section-head">

              <div class="section-title-wrap">

                <div class="section-title">

                  <span class="section-number">
                    1
                  </span>

                  <h2 id="accommodationHeading">
                    Choose your accommodation
                  </h2>

                </div>

                <p>
                  Compare the resort-managed rooms and select
                  the space that fits your stay.
                </p>

              </div>

              <span
                class="section-status"
                id="roomStatus"
              >

                <i class="fa-regular fa-circle"></i>

                Not selected

              </span>

            </div>

            <fieldset
              style="
                border:0;
                padding:0;
                margin:0;
              "
            >

              <legend class="sr-only">
                Available accommodations
              </legend>

              <div
                class="room-grid"
                id="roomGrid"
              >

                <% if (safeRooms.length > 0) { %>

                  <% safeRooms.forEach((room) => { %>

                    <label class="room-option">

                      <input
                        type="radio"
                        name="room"
                        value="<%= room._id %>"
                        data-room-id="<%= room._id %>"
                        data-room-name="<%= room.name || "Accommodation" %>"
                        data-room-price="<%= Number(room.price || 0) %>"
                        data-room-capacity="<%= Math.max(1, Number(room.maxGuests || 1)) %>"
                        data-room-quantity="<%= Math.max(1, Number(room.quantity || 1)) %>"
                        required
                      >

                      <span class="room-card">

                        <span class="room-visual">

                          <% if (room.image) { %>

                            <img
                              src="<%= room.image %>"
                              alt="<%= room.name || "Accommodation" %>"
                              loading="lazy"
                              decoding="async"
                            >

                          <% } else { %>

                            <span
                              class="room-placeholder"
                              aria-hidden="true"
                            >
                              <%= room.name
                                ? String(room.name).charAt(0).toUpperCase()
                                : "R" %>
                            </span>

                          <% } %>

                          <span class="room-selected">

                            <i class="fa-solid fa-check"></i>

                            Selected

                          </span>

                        </span>

                        <span class="room-copy">

                          <span class="room-top">

                            <span class="room-name">
                              <%= room.name || "Accommodation" %>
                            </span>

                            <span class="room-price">

                              ₱<%= money(room.price) %>

                              <small>
                                / night
                              </small>

                            </span>

                          </span>

                          <span class="room-description">

                            <%= room.description ||
                              "Comfortable resort accommodation prepared for your island stay." %>

                          </span>

                          <span class="room-meta">

                            <span class="room-pill">

                              <i
                                class="fa-solid fa-user-group"
                              ></i>

                              Up to
                              <%= Math.max(1, Number(room.maxGuests || 1)) %>

                            </span>

                            <% if (Number(room.quantity || 1) > 1) { %>

                              <span class="room-pill">

                                <i
                                  class="fa-solid fa-layer-group"
                                ></i>

                                <%= Number(room.quantity) %>
                                units

                              </span>

                            <% } %>

                          </span>

                        </span>

                      </span>

                    </label>

                  <% }) %>

                <% } else { %>

                  <div class="empty-state">

                    <i class="fa-solid fa-bed"></i>

                    No accommodations are currently
                    available. Please contact the resort team.

                  </div>

                <% } %>

              </div>

              <div
                class="room-selection-note"
                id="roomSelectionNote"
                hidden
              >

                <i
                  class="fa-solid fa-circle-check"
                ></i>

                <span
                  id="roomSelectionText"
                >
                  Accommodation selected.
                </span>

              </div>

            </fieldset>

          </section>

          <!-- ==================================================
               STAY DETAILS
          =================================================== -->

          <section
            class="section"
            data-step="dates"
            aria-labelledby="stayDetailsHeading"
          >

            <div class="section-head">

              <div class="section-title-wrap">

                <div class="section-title">

                  <span class="section-number">
                    2
                  </span>

                  <h2 id="stayDetailsHeading">
                    Plan your stay
                  </h2>

                </div>

                <p>
                  Your stay must begin today or later and end
                  after the selected check-in date.
                </p>

              </div>

              <span
                class="section-status"
                id="stayStatus"
              >

                <i class="fa-regular fa-circle"></i>

                Dates pending

              </span>

            </div>

            <div class="form-grid">

              <div class="field">

                <label for="checkin">

                  <span>
                    Check-in
                    <span class="required">*</span>
                  </span>

                  <span class="label-note">
                    Arrival
                  </span>

                </label>

                <div class="input-shell">

                  <i
                    class="fa-regular fa-calendar"
                  ></i>

                  <input
                    class="control"
                    type="date"
                    id="checkin"
                    name="checkin"
                    autocomplete="off"
                    required
                    aria-describedby="checkinHelp"
                  >

                </div>

                <small id="checkinHelp">
                  Choose the day you arrive at the resort.
                </small>

              </div>

              <div class="field">

                <label for="checkout">

                  <span>
                    Check-out
                    <span class="required">*</span>
                  </span>

                  <span class="label-note">
                    Departure
                  </span>

                </label>

                <div class="input-shell">

                  <i
                    class="fa-regular fa-calendar-check"
                  ></i>

                  <input
                    class="control"
                    type="date"
                    id="checkout"
                    name="checkout"
                    autocomplete="off"
                    required
                    aria-describedby="checkoutHelp"
                  >

                </div>

                <small id="checkoutHelp">
                  Check-out must be at least one night after arrival.
                </small>

              </div>

              <div class="field">

                <label for="guests">

                  <span>
                    Guests
                    <span class="required">*</span>
                  </span>

                  <span
                    class="label-note"
                    id="capacityLabel"
                  >
                    Select a room
                  </span>

                </label>

                <div class="guest-control">

                  <button
                    type="button"
                    class="guest-stepper"
                    id="decreaseGuests"
                    aria-label="Decrease guest count"
                  >

                    <i class="fa-solid fa-minus"></i>

                  </button>

                  <input
                    class="guest-input"
                    type="number"
                    id="guests"
                    name="guests"
                    value="1"
                    min="1"
                    max="100"
                    step="1"
                    inputmode="numeric"
                    required
                    aria-describedby="capacityHelp"
                  >

                  <button
                    type="button"
                    class="guest-stepper"
                    id="increaseGuests"
                    aria-label="Increase guest count"
                  >

                    <i class="fa-solid fa-plus"></i>

                  </button>

                </div>

                <small id="capacityHelp">
                  Select an accommodation to see its maximum capacity.
                </small>

              </div>

              <div class="field">

                <label for="stayDuration">

                  <span>
                    Stay duration
                  </span>

                  <span class="label-note">
                    Calculated
                  </span>

                </label>

                <div class="input-shell">

                  <i
                    class="fa-regular fa-moon"
                  ></i>

                  <input
                    class="control"
                    id="stayDuration"
                    type="text"
                    value="0 nights"
                    readonly
                    aria-readonly="true"
                  >

                </div>

                <small>
                  The booking estimate updates automatically
                  when dates change.
                </small>

              </div>

            </div>

            <div
              class="availability-panel info"
              id="availabilityPanel"
              role="status"
              aria-live="polite"
            >

              <i
                class="fa-solid fa-circle-info"
              ></i>

              <span id="availabilityText">
                Select an accommodation and valid dates
                to review booking availability.
              </span>

            </div>

          </section>

          <!-- ==================================================
               ADDONS
          =================================================== -->

          <section
            class="section"
            data-step="addons"
            aria-labelledby="addonsHeading"
          >

            <div class="section-head">

              <div class="section-title-wrap">

                <div class="section-title">

                  <span class="section-number">
                    3
                  </span>

                  <h2 id="addonsHeading">
                    Personalize your stay
                  </h2>

                </div>

                <p>
                  Choose optional resort extras. Their pricing
                  is calculated from the current catalog.
                </p>

              </div>

              <span
                class="section-status"
                id="addonStatus"
              >

                <i class="fa-regular fa-circle"></i>

                Optional

              </span>

            </div>

            <% if (safeAddOns.length > 0) { %>

              <fieldset
                style="
                  border:0;
                  padding:0;
                  margin:0;
                "
              >

                <legend class="sr-only">
                  Available add-ons
                </legend>

                <div
                  class="addon-grid"
                  id="addonGrid"
                >

                  <% safeAddOns.forEach((addOn) => { %>

                    <label class="addon-option">

                      <input
                        type="checkbox"
                        name="addOns[]"
                        value="<%= addOn._id %>"
                        data-addon-name="<%= addOn.name || "Add-on" %>"
                        data-addon-price="<%= Number(addOn.price || 0) %>"
                        data-addon-pricing-type="<%= addOn.pricingType === "perNight" ? "perNight" : "once" %>"
                      >

                      <span class="addon-card">

                        <span
                          class="addon-check"
                          aria-hidden="true"
                        >

                          <i
                            class="fa-solid fa-check"
                          ></i>

                        </span>

                        <span class="addon-copy">

                          <span class="addon-top">

                            <span class="addon-name">
                              <%= addOn.name || "Add-on" %>
                            </span>

                            <span class="addon-price">
                              ₱<%= money(addOn.price) %>
                            </span>

                          </span>

                          <span class="addon-description">

                            <%= addOn.description ||
                              "Optional resort extra for your stay." %>

                          </span>

                          <span class="addon-note">

                            <%= addOn.pricingType === "perNight"
                              ? "Charged per night"
                              : "Charged once" %>

                          </span>

                        </span>

                      </span>

                    </label>

                  <% }) %>

                </div>

              </fieldset>

            <% } else { %>

              <div class="empty-state">

                <i
                  class="fa-solid fa-gift"
                ></i>

                No optional add-ons are currently available.
                You can continue without extras.

              </div>

            <% } %>

          </section>

          <!-- ==================================================
               SPECIAL REQUEST
          =================================================== -->

          <section
            class="section"
            data-step="request"
            aria-labelledby="requestHeading"
          >

            <div class="section-head">

              <div class="section-title-wrap">

                <div class="section-title">

                  <span class="section-number">
                    4
                  </span>

                  <h2 id="requestHeading">
                    Add a special request
                  </h2>

                </div>

                <p>
                  Optional notes for the resort team.
                  Requests remain subject to availability.
                </p>

              </div>

              <span
                class="section-status"
                id="requestStatus"
              >

                <i class="fa-regular fa-circle"></i>

                Optional

              </span>

            </div>

            <div class="field">

              <label
                for="specialRequests"
              >

                <span>
                  Special requests
                </span>

                <span class="label-note">
                  Optional
                </span>

              </label>

              <div class="textarea-wrap">

                <textarea
                  id="specialRequests"
                  name="specialRequests"
                  maxlength="3000"
                  spellcheck="true"
                  placeholder="Anything the resort team should know before your arrival?"
                  aria-describedby="specialRequestsHelp"
                ></textarea>

                <span
                  class="char-counter"
                  id="charCounter"
                >
                  0 / 3000
                </span>

              </div>

              <small
                id="specialRequestsHelp"
              >
                Please do not include passwords, card details,
                or other sensitive information.
              </small>

            </div>

            <div class="form-hint">

              <i
                class="fa-solid fa-lightbulb"
              ></i>

              <span>
                Before submitting, quickly review the room,
                dates, guest count, and estimate in the panel
                beside this form.
              </span>

            </div>

            <div
              class="validation-panel"
              id="validationPanel"
              role="alert"
              aria-live="assertive"
            >

              <i
                class="fa-solid fa-circle-exclamation"
              ></i>

              <span
                id="validationText"
              ></span>

            </div>

          </section>

        </section>

        <!-- ====================================================
             SUMMARY
        ===================================================== -->

        <aside
          class="summary-panel"
          aria-labelledby="summaryHeading"
        >

          <div class="summary-inner">

            <span class="summary-kicker">

              <i
                class="fa-solid fa-sparkles"
              ></i>

              Live booking estimate

            </span>

            <h2 id="summaryHeading">
              Your stay at a glance.
            </h2>

            <p class="summary-subtitle">

              Your selections update this preview instantly.
              The server performs the final calculation
              when you submit.

            </p>

            <div
              class="summary-progress"
              aria-hidden="true"
            >

              <div
                class="summary-progress-bar"
                id="summaryProgressBar"
              ></div>

            </div>

            <div class="summary-card">

              <div
                class="summary-room-name"
                id="summaryRoomName"
              >
                No accommodation selected
              </div>

              <div
                class="summary-room-meta"
                id="summaryRoomMeta"
              >
                Choose a room to begin your booking request.
              </div>

            </div>

            <div class="summary-details">

              <div class="summary-detail">

                <div class="summary-detail-label">
                  Check-in
                </div>

                <div
                  class="summary-detail-value"
                  id="summaryCheckin"
                >
                  —
                </div>

              </div>

              <div class="summary-detail">

                <div class="summary-detail-label">
                  Check-out
                </div>

                <div
                  class="summary-detail-value"
                  id="summaryCheckout"
                >
                  —
                </div>

              </div>

              <div class="summary-detail">

                <div class="summary-detail-label">
                  Guests
                </div>

                <div
                  class="summary-detail-value"
                  id="summaryGuests"
                >
                  1 guest
                </div>

              </div>

              <div class="summary-detail">

                <div class="summary-detail-label">
                  Nights
                </div>

                <div
                  class="summary-detail-value"
                  id="summaryNights"
                >
                  0 nights
                </div>

              </div>

            </div>

            <div class="price-block">

              <div class="price-row">

                <span>
                  Accommodation
                </span>

                <strong id="roomSubtotal">
                  ₱0
                </strong>

              </div>

              <div class="price-row">

                <span>
                  Add-ons
                </span>

                <strong id="addOnSubtotal">
                  ₱0
