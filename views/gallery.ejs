<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>360 Virtual Tour – Puffer Isle Resort</title>

  <link rel="icon" type="image/png" href="/images/islelogo.png" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>

  <style>
    :root {
      --brand-color: #FFD700; /* New Brand Yellow */
      --brand-hover: #e6c200;
      --accent-teal: #008080;
      --dark: #1a1a1a;
      --light-bg: #ffffff;
      --text-muted: #555;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--light-bg);
      color: var(--dark);
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* PAGE WRAPPER */
    .tour-container {
      padding-top: 120px; /* Space for Navbar */
      padding-bottom: 80px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      max-width: 1400px;
      margin: 0 auto;
    }

    .tour-header {
      margin-bottom: 40px;
      text-align: center;
    }

    .tour-header h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      color: var(--dark);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .tour-header span {
      color: var(--brand-color);
      border-bottom: 6px solid var(--brand-color);
    }

    .tour-header p {
      color: var(--text-muted);
      margin-top: 10px;
      font-weight: 300;
    }

    /* THE VIEWER */
    .viewer-wrapper {
      width: 95%;
      height: 70vh;
      min-height: 500px;
      border-radius: 40px; /* More rounded like the About section */
      overflow: hidden;
      box-shadow: 0 30px 60px rgba(0,0,0,0.15);
      border: 12px solid white; /* Thick premium border */
      position: relative;
      background: #000;
      cursor: default;
      touch-action: none;
      user-select: none;
    }

    a-scene {
      height: 100%;
      width: 100%;
      touch-action: none;
    }

    /* CONTROLS AREA */
    .controls-container {
      display: none;
    }

    .btn-group {
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .btn {
      padding: 16px 45px;
      border-radius: 50px;
      background: var(--dark);
      color: var(--brand-color); /* Yellow on Dark */
      border: none;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn:hover:not(:disabled) {
      background: var(--brand-color);
      color: var(--dark);
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(255, 215, 0, 0.3);
    }

    .btn:disabled {
      background: #eee;
      color: #aaa;
      cursor: not-allowed;
      box-shadow: none;
    }

    /* NAVIGATION DOTS & PREVIEWS */
    .nav-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    .dots { display: flex; gap: 15px; }

    .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #ddd;
      transition: 0.4s;
      border: 2px solid transparent;
    }

    .dot.active {
      background: var(--brand-color);
      transform: scale(1.8);
      border-color: var(--dark);
    }

    .hint-box {
      margin-top: 20px;
      padding: 10px 30px;
      background: rgba(255, 215, 0, 0.1);
      border-radius: 50px;
      font-size: 0.85rem;
      color: var(--dark);
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .compass-hud {
      position: absolute;
      z-index: 6;
      inset: 0;
      pointer-events: none;
    }

    .compass-rose {
      position: absolute;
      inset: 0;
    }

    .compass-rose::before { display: none; }

    .street-control {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-width: 82px;
      max-width: min(190px, 42vw);
      height: 42px;
      padding: 0 12px;
      border: 1px solid rgba(255,255,255,.82);
      border-radius: 22px;
      background: rgba(0,0,0,.88);
      color: white;
      font: inherit;
      font-weight: 700;
      font-size: .78rem;
      cursor: pointer;
      pointer-events: auto;
      box-shadow: 0 3px 12px rgba(0,0,0,.45);
      transform: translate(-50%, -50%);
      transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
    }

    .street-control-arrow { flex: 0 0 auto; font-size: 1.2rem; line-height: 1; }
    .street-control-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .street-control:hover:not(:disabled) {
      background: var(--accent-teal);
      color: #071416;
      box-shadow: 0 5px 16px rgba(0,0,0,.55);
      transform: translate(-50%, -50%) scale(1.08);
    }
    .street-control:disabled { display: none; }

    .a-enter-vr-button,
    .a-fullscreen-button {
      display: none !important;
    }

    #leftBtn { left: 18px; top: 50%; }
    #rightBtn { right: 18px; top: 50%; }
    #forwardBtn { left: 50%; top: 18px; transform: translateX(-50%); }
    #backwardBtn { left: 50%; bottom: 18px; transform: translateX(-50%); }
    #forwardBtn:hover:not(:disabled) {
      transform: translateX(-50%) scale(1.08);
    }

    #backwardBtn:hover:not(:disabled) {
      transform: translateX(-50%) scale(1.08);
    }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .viewer-wrapper { height: 50vh; border-width: 6px; }
      .btn { padding: 12px 25px; font-size: 0.8rem; }
      .tour-header h1 { font-size: 1.8rem; }
      .street-control { min-width: 74px; height: 38px; padding: 0 9px; font-size: .7rem; }
      .street-control-arrow { font-size: 1.05rem; }
    }
  </style>
</head>

<body>

<%- include('partials/navbar') %>

<div class="tour-container">
  <div class="tour-header">
    <h1>Experience <span>The Isle</span></h1>
    <p>Step inside our paradise through an immersive 360° perspective.</p>
  </div>

  <div
    class="viewer-wrapper"
    data-scenes='<%- JSON.stringify(galleryImages && galleryImages.length ? galleryImages.map((item) => item.image) : ["/images/pano.jpg", "/images/pano2.jpg", "/images/pano3.jpg", "/images/pano4.jpg"]) %>'
    data-navigation='<%- JSON.stringify(galleryImages && galleryImages.length ? galleryImages.map((item) => ({ left: item.left ?? null, right: item.right ?? null, forward: item.forward ?? null, backward: item.backward ?? null })) : []) %>'
    data-headings='<%- JSON.stringify(galleryImages && galleryImages.length ? galleryImages.map((item) => Number.isFinite(Number(item.heading)) ? Number(item.heading) : 0) : [0, 0, 0, 0]) %>'
    data-pitches='<%- JSON.stringify(galleryImages && galleryImages.length ? galleryImages.map((item) => Number.isFinite(Number(item.pitch)) ? Number(item.pitch) : 0) : [0, 0, 0, 0]) %>'
    data-titles="<%= JSON.stringify(galleryImages && galleryImages.length ? galleryImages.map((item) => item.title || 'Resort Photo') : []) %>"
    data-button-positions='<%- JSON.stringify(galleryImages && galleryImages.length ? galleryImages.map((item) => item.buttonPositions || {}) : []) %>'
  >
    <a-scene embedded vr-mode-ui="enabled: false">
      <a-assets>
        <img id="pano1" src="<%= galleryImages && galleryImages.length ? galleryImages[0].image : '/images/pano.jpg' %>">
      </a-assets>

      <a-entity position="0 0 0">
        <a-camera id="camera" fov="80" look-controls="reverseMouseDrag: false" wasd-controls="enabled: false"></a-camera>
      </a-entity>

      <a-sky id="sky" src="#pano1" rotation="0 -90 0" transparent="true" opacity="1"></a-sky>
    </a-scene>

    <div class="compass-hud" role="group" aria-label="Directional gallery navigation">
      <div class="compass-rose" id="compassRose">
        <button class="street-control" id="leftBtn" type="button" disabled><span class="street-control-arrow" aria-hidden="true">←</span><span class="street-control-label">Left</span></button>
        <button class="street-control" id="forwardBtn" type="button" disabled><span class="street-control-arrow" aria-hidden="true">↑</span><span class="street-control-label">Forward</span></button>
        <button class="street-control" id="rightBtn" type="button" disabled><span class="street-control-arrow" aria-hidden="true">→</span><span class="street-control-label">Right</span></button>
        <button class="street-control" id="backwardBtn" type="button" disabled><span class="street-control-arrow" aria-hidden="true">↓</span><span class="street-control-label">Back</span></button>
    </div>
  </div>

  <div class="controls-container">
    <div class="btn-group">
      <button class="btn" id="prevBtn">Previous</button>
      
      <div class="nav-wrapper">
        <div class="dots">
          <div class="dot active"></div>
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      </div>

      <button class="btn" id="nextBtn">Next View</button>
    </div>

    <div class="hint-box">
      ✨ <strong>INTERACTIVE:</strong> DRAG TO ROTATE • SCROLL TO ZOOM
    </div>
  </div>
</div>

<script>
  const sky = document.querySelector('#sky');
  const camera = document.querySelector('#camera');
  const dots = document.querySelectorAll('.dot');
  const nextBtn = document.getElementById('nextBtn');
  const prevBtn = document.getElementById('prevBtn');
  const leftBtn = document.getElementById('leftBtn');
  const forwardBtn = document.getElementById('forwardBtn');
  const rightBtn = document.getElementById('rightBtn');
  const backwardBtn = document.getElementById('backwardBtn');

  const viewer = document.querySelector('.viewer-wrapper');
  const compassRose = document.getElementById('compassRose');
  const scenes = JSON.parse(viewer.dataset.scenes || '[]');
  const navigation = JSON.parse(viewer.dataset.navigation || '[]');
  const forwardHeadings = JSON.parse(viewer.dataset.headings || '[]');
  const forwardPitches = JSON.parse(viewer.dataset.pitches || '[]');
  const sceneTitles = JSON.parse(viewer.dataset.titles || '[]');
  const sceneButtonPositions = JSON.parse(viewer.dataset.buttonPositions || '[]');
  const normalizeHeading = (heading) => ((heading % 360) + 360) % 360;
  const compassDirections = [
    { button: leftBtn, key: 'left', label: 'Left' },
    { button: forwardBtn, key: 'forward', label: 'Forward' },
    { button: rightBtn, key: 'right', label: 'Right' },
    { button: backwardBtn, key: 'backward', label: 'Back' }
  ];
  const defaultButtonHeadingOffsets = {
    left: 90,
    forward: 0,
    right: 270,
    backward: 180
  };

  let currentIndex = 0;

  function updateUI() {
    dots.forEach((dot, index) => {
      dot.classList.toggle("active", index === currentIndex);
    });
    prevBtn.disabled = (currentIndex === 0);
    nextBtn.disabled = (currentIndex === scenes.length - 1);
    const currentNavigation = navigation[currentIndex] || {};
    compassDirections.forEach(({ button, key, label }) => {
      const targetIndex = currentNavigation[key];
      const isConnected = Number.isInteger(targetIndex) && targetIndex >= 0 && targetIndex < scenes.length;
      const targetTitle = isConnected ? sceneTitles[targetIndex] : '';
      button.disabled = !isConnected;
      button.querySelector('.street-control-label').textContent = targetTitle
        ? `Go to ${targetTitle}`
        : label;
      button.setAttribute('aria-label', isConnected
        ? `Go ${label.toLowerCase()} to ${targetTitle || `location ${targetIndex + 1}`}`
        : `${label} destination is not connected`);
      button.title = isConnected
        ? `Go ${label.toLowerCase()} to ${targetTitle || `location ${targetIndex + 1}`}`
        : `${label} destination is not connected`;
    });
    updateCompass();
  }

  function updateCompass() {
    const cameraWorldRotation = camera.object3D.getWorldQuaternion(new AFRAME.THREE.Quaternion());
    const width = viewer.clientWidth;
    const height = viewer.clientHeight;
    if (!cameraWorldRotation || !width || !height) {
      return;
    }

    const cameraForward = new AFRAME.THREE.Vector3(0, 0, -1)
      .applyQuaternion(cameraWorldRotation)
      .normalize();
    const inverseCameraRotation = cameraWorldRotation.clone().invert();
    const fov = AFRAME.THREE.MathUtils.degToRad(Number(camera.getAttribute('fov')));
    const focalLength = (height / 2) / Math.tan(fov / 2);
    const currentButtonPositions = sceneButtonPositions[currentIndex] || {};
    let closestButton = null;
    let closestAlignment = -Infinity;

    compassDirections.forEach(({ button, key }) => {
      if (button.disabled) {
        button.style.visibility = 'hidden';
        return;
      }

      const savedPin = currentButtonPositions[key];
      const pinHeading = Number.isFinite(savedPin && savedPin.heading)
        ? savedPin.heading
        : normalizeHeading((forwardHeadings[currentIndex] || 0) + defaultButtonHeadingOffsets[key]);
      const pinPitch = Number.isFinite(savedPin && savedPin.pitch)
        ? Math.min(89, Math.max(-89, savedPin.pitch))
        : Math.min(89, Math.max(0, forwardPitches[currentIndex] || 0));
      const headingRadians = AFRAME.THREE.MathUtils.degToRad(pinHeading);
      const pitchRadians = AFRAME.THREE.MathUtils.degToRad(pinPitch);
      const worldDirection = new AFRAME.THREE.Vector3(
        -Math.sin(headingRadians) * Math.cos(pitchRadians),
        Math.sin(pitchRadians),
        -Math.cos(headingRadians) * Math.cos(pitchRadians)
      ).normalize();
      const localDirection = worldDirection.clone().applyQuaternion(inverseCameraRotation);
      if (localDirection.z >= 0) {
        button.style.visibility = 'hidden';
        return;
      }

      const screenX = width / 2 + (localDirection.x / -localDirection.z) * focalLength;
      const screenY = height / 2 - (localDirection.y / -localDirection.z) * focalLength;
      if (screenX < 0 || screenX > width || screenY < 0 || screenY > height) {
        button.style.visibility = 'hidden';
        return;
      }

      button.style.left = `${(screenX / width) * 100}%`;
      button.style.top = `${(screenY / height) * 100}%`;
      const alignment = cameraForward.dot(worldDirection);
      if (alignment > closestAlignment) {
        closestAlignment = alignment;
        closestButton = button;
      }
    });

    const directionViewThreshold = Math.cos(AFRAME.THREE.MathUtils.degToRad(32));
    if (closestAlignment < directionViewThreshold) {
      closestButton = null;
    }

    compassDirections.forEach(({ button }) => {
      button.style.visibility = button === closestButton ? 'visible' : 'hidden';
    });
  }

  function applySceneHeading(index) {
    const lookControls = camera.components['look-controls'];
    const yawObject = lookControls && lookControls.yawObject;
    const pitchObject = lookControls && lookControls.pitchObject;

    if (!yawObject || !pitchObject) {
      return false;
    }

    const heading = Number.isFinite(forwardHeadings[index])
      ? normalizeHeading(forwardHeadings[index])
      : 0;
    yawObject.rotation.y = AFRAME.THREE.MathUtils.degToRad(heading);
    const pitch = Number.isFinite(forwardPitches[index])
      ? Math.min(89, Math.max(0, forwardPitches[index]))
      : 0;
    pitchObject.rotation.x = AFRAME.THREE.MathUtils.degToRad(pitch);
    lookControls.updateOrientation();
    camera.object3D.updateMatrixWorld(true);
    return true;
  }

  function applySceneHeadingWhenReady(index, attempts = 0) {
    if (index !== currentIndex) {
      return;
    }

    if (applySceneHeading(index) || attempts >= 10) {
      return;
    }

    requestAnimationFrame(() => applySceneHeadingWhenReady(index, attempts + 1));
  }

  function goTo(index) {
    if (Number.isInteger(index) && index >= 0 && index < scenes.length) {
      currentIndex = index;
      fadeTo(scenes[currentIndex], currentIndex);
      updateUI();
    }
  }

  function fadeTo(image, headingIndex) {
    // Smooth Fade Sequence
    sky.setAttribute('animation', {
      property: 'components.material.material.opacity',
      to: 0,
      dur: 400,
      easing: 'easeInOutCubic'
    });
    
    setTimeout(() => {
      if (headingIndex !== currentIndex) {
        return;
      }

      sky.setAttribute('src', image);
      applySceneHeadingWhenReady(headingIndex);
      requestAnimationFrame(() => applySceneHeadingWhenReady(headingIndex));
      sky.setAttribute('animation', {
        property: 'components.material.material.opacity',
        to: 1,
        dur: 400,
        easing: 'easeInOutCubic'
      });
    }, 405);
  }

  nextBtn.onclick = () => {
    if (currentIndex < scenes.length - 1) {
      goTo(currentIndex + 1);
    }
  };

  prevBtn.onclick = () => {
    if (currentIndex > 0) {
      goTo(currentIndex - 1);
    }
  };

  compassDirections.forEach(({ button, key }) => {
    button.onclick = () => goTo(navigation[currentIndex]?.[key]);
  });

  function clampLookingDown() {
    const lookControls = camera.components['look-controls'];
    const pitchObject = lookControls && lookControls.pitchObject;

    if (pitchObject && pitchObject.rotation.x < 0) {
      pitchObject.rotation.x = 0;
    }

    updateCompass();
    requestAnimationFrame(clampLookingDown);
  }

  clampLookingDown();

  // ZOOM CLAMPING - No more black screens
  document.querySelector('.viewer-wrapper').addEventListener('wheel', (e) => {
    e.preventDefault();
    let fov = parseFloat(camera.getAttribute('fov'));
    fov += (e.deltaY > 0) ? 3 : -3;
    fov = Math.min(Math.max(fov, 30), 95); 
    camera.setAttribute('fov', fov);
  }, { passive: false });

  function toggleViewerFullscreen() {
    const activeFullscreen = document.fullscreenElement || document.webkitFullscreenElement;

    if (activeFullscreen) {
      if (document.exitFullscreen) {
        document.exitFullscreen();
      } else if (document.webkitExitFullscreen) {
        document.webkitExitFullscreen();
      }
      return;
    }

    if (viewer.requestFullscreen) {
      viewer.requestFullscreen();
    } else if (viewer.webkitRequestFullscreen) {
      viewer.webkitRequestFullscreen();
    }
  }

  viewer.addEventListener('dblclick', toggleViewerFullscreen);

  let galleryControlsInitialized = false;

  function initializeGalleryControls(attempt = 0) {
    if (galleryControlsInitialized) {
      return;
    }

    const lookControls = camera.components['look-controls'];
    if (camera.hasLoaded && lookControls && lookControls.yawObject && lookControls.pitchObject) {
      galleryControlsInitialized = true;
      applySceneHeadingWhenReady(currentIndex);
      updateUI();
      return;
    }

    if (attempt < 120) {
      requestAnimationFrame(() => initializeGalleryControls(attempt + 1));
      return;
    }

    console.error('Gallery controls could not initialize; directional navigation remains disabled.');
  }

  initializeGalleryControls();
  camera.addEventListener('loaded', () => initializeGalleryControls());
  document.querySelector('a-scene').addEventListener('loaded', () => initializeGalleryControls());
  window.addEventListener('load', () => initializeGalleryControls(), { once: true });
  window.setTimeout(() => initializeGalleryControls(), 250);

  let lastTapAt = 0;
  viewer.addEventListener('touchend', (event) => {
    const now = Date.now();
    if (now - lastTapAt < 350) {
      event.preventDefault();
      toggleViewerFullscreen();
      lastTapAt = 0;
    } else {
      lastTapAt = now;
    }
  }, { passive: false });

</script>

</body>
</html>