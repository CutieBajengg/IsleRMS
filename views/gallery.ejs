<%
  /*
   * ============================================================
   * PUFFER ISLE RESORT | IsleRMS
   * views/gallery.ejs
   *
   * PUFFER ISLE 360° — IMMERSIVE VIRTUAL RESORT
   *
   * Design goals:
   * - Google Street View-inspired exploration
   * - Panorama-first / extremely low UI clutter
   * - In-world navigation markers
   * - Click / double-click / double-tap travel
   * - Smooth cinematic scene transitions
   * - Spatial scene positioning when available
   * - Legacy left/right/forward/backward compatibility
   * - Information / POI hotspots
   * - Resort scene drawer
   * - Interactive tour map
   * - Compass
   * - Device orientation
   * - Fullscreen
   * - Shareable scene URLs
   * - Neighbor panorama preloading
   * - Browser history navigation
   * - Keyboard navigation
   * - Responsive mobile experience
   *
   * IMPORTANT:
   * The public route currently guarantees:
   *
   *   galleryImages
   *   title
   *   currentPath
   *
   * gallery/settings are therefore OPTIONAL.
   *
   * This template works with the existing route and can
   * automatically consume richer Gallery data if the route
   * later passes the complete gallery document.
   * ============================================================
   */

  const galleryScenes =
    Array.isArray(galleryImages)
      ? galleryImages
      : [];

  const galleryRecord =
    typeof gallery !== "undefined" &&
    gallery &&
    typeof gallery === "object"
      ? gallery
      : {};

  function plainScene(scene) {
    if (!scene) {
      return {};
    }

    if (
      typeof scene.toObject === "function"
    ) {
      return scene.toObject();
    }

    return {
      ...scene
    };
  }

  function sceneTitle(
    scene,
    index
  ) {
    if (
      scene &&
      scene.title &&
      String(scene.title).trim()
    ) {
      return String(
        scene.title
      ).trim();
    }

    return (
      "Resort View " +
      (index + 1)
    );
  }

  function normalizeString(
    value,
    fallback = ""
  ) {
    if (
      value === undefined ||
      value === null
    ) {
      return fallback;
    }

    const result =
      String(value).trim();

    return result || fallback;
  }

  function boolValue(
    value,
    fallback
  ) {
    if (
      value === undefined ||
      value === null
    ) {
      return fallback;
    }

    if (
      value === true ||
      value === "true" ||
      value === 1 ||
      value === "1" ||
      value === "on"
    ) {
      return true;
    }

    if (
      value === false ||
      value === "false" ||
      value === 0 ||
      value === "0" ||
      value === "off"
    ) {
      return false;
    }

    return fallback;
  }

  const tourSettings = {
    enabled:
      boolValue(
        galleryRecord?.tour?.enabled,
        true
      ),

    startScene:
      Number.isInteger(
        Number(
          galleryRecord?.tour?.startScene
        )
      )
        ? Number(
            galleryRecord.tour.startScene
          )
        : 0,

    preloadNeighbors:
      boolValue(
        galleryRecord?.tour?.preloadNeighbors,
        true
      ),

    preloadDepth:
      Number(
        galleryRecord?.tour?.preloadDepth
      ) || 2,

    allowSharing:
      boolValue(
        galleryRecord?.tour?.allowSharing,
        true
      ),

    showMap:
      boolValue(
        galleryRecord?.tour?.showMap,
        true
      ),

    showHotspots:
      boolValue(
        galleryRecord?.tour?.showHotspots,
        true
      )
  };

  const viewerSettings = {
    defaultFov:
      Number(
        galleryRecord?.viewer?.defaultFov
      ) || 75,

    minFov:
      Number(
        galleryRecord?.viewer?.minFov
      ) || 30,

    maxFov:
      Number(
        galleryRecord?.viewer?.maxFov
      ) || 110,

    motionEnabled:
      boolValue(
        galleryRecord?.viewer?.motionEnabled,
        true
      ),

    touchEnabled:
      boolValue(
        galleryRecord?.viewer?.touchEnabled,
        true
      ),

    mouseEnabled:
      boolValue(
        galleryRecord?.viewer?.mouseEnabled,
        true
      )
  };

  const mapSettings = {
    enabled:
      boolValue(
        galleryRecord?.map?.enabled,
        true
      ),

    image:
      normalizeString(
        galleryRecord?.map?.image,
        ""
      ),

    title:
      normalizeString(
        galleryRecord?.map?.title,
        "Puffer Isle Resort"
      ),

    width:
      Number(
        galleryRecord?.map?.width
      ) || 1000,

    height:
      Number(
        galleryRecord?.map?.height
      ) || 700
  };

  const publicScenes =
    galleryScenes.map(
      (scene, index) => {
        const source =
          plainScene(scene);

        return {
          _id:
            source?._id
              ? String(
                  source._id
                )
              : "",

          title:
            sceneTitle(
              source,
              index
            ),

          image:
            normalizeString(
              source?.image
            ),

          thumbnail:
            normalizeString(
              source?.thumbnail ||
                source?.image
            ),

          slug:
            normalizeString(
              source?.slug
            ),

          description:
            normalizeString(
              source?.description
            ),

          caption:
            normalizeString(
              source?.caption
            ),

          alt:
            normalizeString(
              source?.alt ||
                source?.title ||
                `Puffer Isle Resort scene ${index + 1}`
            ),

          category:
            normalizeString(
              source?.category,
              "Resort"
            ),

          location:
            normalizeString(
              source?.location
            ),

          order:
            Number(
              source?.order
            ) || (
              index + 1
            ),

          left:
            source?.left ??
            null,

          right:
            source?.right ??
            null,

          forward:
            source?.forward ??
            null,

          backward:
            source?.backward ??
            null,

          heading:
            Number.isFinite(
              Number(
                source?.heading
              )
            )
              ? Number(
                  source.heading
                )
              : 0,

          pitch:
            Number.isFinite(
              Number(
                source?.pitch
              )
            )
              ? Number(
                  source.pitch
                )
              : 0,

          fov:
            Number.isFinite(
              Number(
                source?.fov
              )
            )
              ? Number(
                  source.fov
                )
              : viewerSettings.defaultFov,

          northOffset:
            Number.isFinite(
              Number(
                source?.northOffset
              )
            )
              ? Number(
                  source.northOffset
                )
              : 0,

          position: {
            x:
              source?.position?.x ??
              null,

            y:
              source?.position?.y ??
              null,

            z:
              source?.position?.z ??
              null
          },

          mapPosition: {
            x:
              source?.mapPosition?.x ??
              null,

            y:
              source?.mapPosition?.y ??
              null
          },

          active:
            source?.active !== false,

          featured:
            source?.featured === true,

          hotspots:
            Array.isArray(
              source?.hotspots
            )
              ? source.hotspots.map(
                  hotspot => ({
                    _id:
                      hotspot?._id
                        ? String(
                            hotspot._id
                          )
                        : "",

                    type:
                      normalizeString(
                        hotspot?.type,
                        "info"
                      ).toLowerCase(),

                    yaw:
                      Number.isFinite(
                        Number(
                          hotspot?.yaw
                        )
                      )
                        ? Number(
                            hotspot.yaw
                          )
                        : 0,

                    pitch:
                      Number.isFinite(
                        Number(
                          hotspot?.pitch
                        )
                      )
                        ? Number(
                            hotspot.pitch
                          )
                        : 0,

                    title:
                      normalizeString(
                        hotspot?.title,
                        "Explore this location"
                      ),

                    label:
                      normalizeString(
                        hotspot?.label ||
                          hotspot?.title,
                        "Explore"
                      ),

                    description:
                      normalizeString(
                        hotspot?.description
                      ),

                    icon:
                      normalizeString(
                        hotspot?.icon,
                        "info"
                      ),

                    target:
                      hotspot?.target ??
                      null,

                    targetSceneId:
                      hotspot?.targetSceneId
                        ? String(
                            hotspot.targetSceneId
                          )
                        : null,

                    targetIndex:
                      Number.isInteger(
                        Number(
                          hotspot?.targetIndex
                        )
                      )
                        ? Number(
                            hotspot.targetIndex
                          )
                        : null,

                    action:
                      normalizeString(
                        hotspot?.action,
                        "info"
                      ).toLowerCase(),

                    url:
                      normalizeString(
                        hotspot?.url
                      ),

                    visible:
                      hotspot?.visible !==
                      false,

                    interactive:
                      hotspot?.interactive !==
                      false,

                    scale:
                      Number.isFinite(
                        Number(
                          hotspot?.scale
                        )
                      )
                        ? Number(
                            hotspot.scale
                          )
                        : 1
                  })
                )
              : []
        };
      }
    );

  /*
   * JSON is embedded in the page rather than rendered as
   * individual EJS attributes everywhere.
   *
   * Escape < to prevent accidental script termination.
   */
  const publicGalleryPayload = {
    scenes:
      publicScenes,

    tour:
      tourSettings,

    viewer:
      viewerSettings,

    map:
      mapSettings
  };

  const publicGalleryJson =
    JSON.stringify(
      publicGalleryPayload
    )
      .replace(
        /</g,
        "\\u003c"
      )
      .replace(
        /\u2028/g,
        "\\u2028"
      )
      .replace(
        /\u2029/g,
        "\\u2029"
      );
%>


<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  >

  <meta
    name="theme-color"
    content="#050809"
  >

  <meta
    name="color-scheme"
    content="dark"
  >

  <meta
    name="description"
    content="Explore Puffer Isle Resort through an immersive 360° virtual experience."
  >

  <link
    rel="icon"
    type="image/png"
    href="/images/islelogo.png"
  >

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  >

  <!--
    A-Frame is used as the 360° rendering layer.
    The interface remains entirely custom to Puffer Isle.
  -->
  <script
    src="https://aframe.io/releases/1.8.0/aframe.min.js"
  ></script>

  <title>
    <%= title || "Explore Puffer Isle | 360° Experience" %>
  </title>


  <style>

    /* ============================================================
       DESIGN TOKENS
    ============================================================ */

    :root {

      --pi-black:
        #030506;

      --pi-deep:
        #050809;

      --pi-glass:
        rgba(
          7,
          12,
          13,
          0.68
        );

      --pi-glass-strong:
        rgba(
          5,
          9,
          10,
          0.88
        );

      --pi-line:
        rgba(
          255,
          255,
          255,
          0.11
        );

      --pi-line-soft:
        rgba(
          255,
          255,
          255,
          0.065
        );

      --pi-white:
        #ffffff;

      --pi-soft:
        rgba(
          255,
          255,
          255,
          0.78
        );

      --pi-muted:
        rgba(
          255,
          255,
          255,
          0.50
        );

      --pi-faint:
        rgba(
          255,
          255,
          255,
          0.28
        );

      --pi-teal:
        #1bd1c5;

      --pi-teal-soft:
        #6df1e6;

      --pi-gold:
        #ffd84a;

      --pi-red:
        #ff7676;

      --pi-blue:
        #75aaff;

      --pi-radius:
        18px;

      --pi-radius-lg:
        24px;

      --pi-ease:
        cubic-bezier(
          0.22,
          0.75,
          0.18,
          1
        );

      --pi-nav-height:
        72px;
    }


    /* ============================================================
       RESET
    ============================================================ */

    *,
    *::before,
    *::after {
      box-sizing:
        border-box;
    }


    html,
    body {
      margin:
        0;

      width:
        100%;

      min-height:
        100%;

      background:
        var(--pi-black);

      color:
        var(--pi-white);

      font-family:
        "DM Sans",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }


    body {
      overflow:
        hidden;
    }


    button,
    input,
    select {
      font:
        inherit;
    }


    button,
    a {
      -webkit-tap-highlight-color:
        transparent;
    }


    button {
      border:
        0;
    }


    :focus-visible {
      outline:
        2px solid
        var(--pi-gold);

      outline-offset:
        3px;
    }


    ::selection {
      background:
        rgba(
          255,
          216,
          74,
          0.24
        );

      color:
        #fff;
    }


    /* ============================================================
       SHELL
    ============================================================ */

    .pi-tour-shell {

      position:
        relative;

      width:
        100%;

      height:
        calc(
          100dvh -
          var(--pi-nav-height)
        );

      min-height:
        540px;

      background:
        #000;

      overflow:
        hidden;

      isolation:
        isolate;
    }


    .pi-viewer {

      position:
        absolute;

      inset:
        0;

      overflow:
        hidden;

      background:
        #000;

      cursor:
        grab;
    }


    .pi-viewer.is-dragging {
      cursor:
        grabbing;
    }


    .pi-viewer::before {

      content:
        "";

      position:
        absolute;

      inset:
        0;

      z-index:
        10;

      pointer-events:
        none;

      background:
        radial-gradient(
          circle at center,
          transparent 44%,
          rgba(
            0,
            0,
            0,
            0.23
          )
        );
    }


    .pi-viewer::after {

      content:
        "";

      position:
        absolute;

      inset:
        0;

      z-index:
        11;

      pointer-events:
        none;

      opacity:
        0.12;

      background:
        linear-gradient(
          rgba(
            255,
            255,
            255,
            0.018
          ) 1px,
          transparent 1px
        );

      background-size:
        100% 4px;

      mix-blend-mode:
        overlay;
    }


    /* ============================================================
       A-FRAME
    ============================================================ */

    .pi-viewer a-scene {

      position:
        absolute !important;

      inset:
        0 !important;

      width:
        100% !important;

      height:
        100% !important;

      display:
        block !important;

      background:
        #000;
    }


    .pi-viewer canvas {

      display:
        block;

      width:
        100% !important;

      height:
        100% !important;

      touch-action:
        none;

      outline:
        none;
    }


    /* ============================================================
       TOP IDENTITY
    ============================================================ */

    .pi-top {

      position:
        absolute;

      top:
        14px;

      left:
        14px;

      right:
        14px;

      z-index:
        50;

      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        12px;

      pointer-events:
        none;
    }


    .pi-brand {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        10px;

      max-width:
        min(
          400px,
          72vw
        );

      padding:
        8px
        12px
        8px
        8px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        999px;

      background:
        var(--pi-glass);

      backdrop-filter:
        blur(
          18px
        );

      box-shadow:
        0
        12px
        35px
        rgba(
          0,
          0,
          0,
          0.22
        );
    }


    .pi-brand-logo {

      width:
        34px;

      height:
        34px;

      object-fit:
        contain;

      border-radius:
        50%;

      background:
        rgba(
          255,
          255,
          255,
          0.04
        );
    }


    .pi-brand-copy {

      min-width:
        0;
    }


    .pi-brand-copy strong {

      display:
        block;

      overflow:
        hidden;

      color:
        #fff;

      font-size:
        0.68rem;

      font-weight:
        700;

      letter-spacing:
        0.04em;

      white-space:
        nowrap;

      text-overflow:
        ellipsis;
    }


    .pi-brand-copy span {

      display:
        block;

      margin-top:
        1px;

      color:
        var(--pi-muted);

      font-size:
        0.50rem;

      font-weight:
        600;

      letter-spacing:
        0.11em;

      text-transform:
        uppercase;
    }


    /* ============================================================
       TOP ACTIONS
    ============================================================ */

    .pi-top-actions {

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      pointer-events:
        auto;
    }


    .pi-icon-btn {

      display:
        grid;

      place-items:
        center;

      width:
        40px;

      height:
        40px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        50%;

      background:
        var(--pi-glass);

      color:
        var(--pi-white);

      cursor:
        pointer;

      backdrop-filter:
        blur(
          18px
        );

      box-shadow:
        0
        10px
        30px
        rgba(
          0,
          0,
          0,
          0.18
        );

      transition:
        transform
        180ms
        ease,

        border-color
        180ms
        ease,

        background
        180ms
        ease,

        color
        180ms
        ease;
    }


    .pi-icon-btn:hover {

      transform:
        translateY(
          -1px
        );

      border-color:
        rgba(
          255,
          255,
          255,
          0.22
        );

      background:
        rgba(
          8,
          15,
          16,
          0.84
        );
    }


    .pi-icon-btn.is-active {

      border-color:
        rgba(
          27,
          209,
          197,
          0.42
        );

      background:
        rgba(
          27,
          209,
          197,
          0.10
        );

      color:
        var(--pi-teal-soft);
    }


    /* ============================================================
       COMPASS
    ============================================================ */

    .pi-compass {

      position:
        absolute;

      top:
        16px;

      left:
        50%;

      z-index:
        49;

      width:
        54px;

      height:
        54px;

      transform:
        translateX(
          -50%
        );

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        50%;

      background:
        rgba(
          4,
          9,
          10,
          0.42
        );

      backdrop-filter:
        blur(
          16px
        );

      opacity:
        0.72;

      transition:
        opacity
        200ms
        ease;
    }


    .pi-compass:hover {
      opacity:
        1;
    }


    .pi-compass-ring {

      position:
        absolute;

      inset:
        5px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.075
        );

      border-radius:
        50%;
    }


    .pi-compass-n {

      position:
        absolute;

      top:
        6px;

      color:
        var(--pi-gold);

      font-size:
        0.48rem;

      font-weight:
        800;
    }


    .pi-compass-needle {

      position:
        absolute;

      width:
        2px;

      height:
        19px;

      border-radius:
        999px;

      background:
        linear-gradient(
          180deg,
          var(--pi-gold),
          rgba(
            255,
            216,
            74,
            0
          )
        );

      transform-origin:
        center
        72%;
    }


    .pi-compass-dot {

      width:
        4px;

      height:
        4px;

      border-radius:
        50%;

      background:
        #fff;

      box-shadow:
        0
        0
        10px
        rgba(
          255,
          255,
          255,
          0.45
        );
    }


    /* ============================================================
       SCENE INFORMATION
    ============================================================ */

    .pi-scene-info {

      position:
        absolute;

      left:
        15px;

      bottom:
        15px;

      z-index:
        50;

      max-width:
        min(
          470px,
          calc(
            100vw -
            30px
          )
        );

      padding:
        12px
        15px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        16px;

      background:
        linear-gradient(
          135deg,
          rgba(
            5,
            10,
            11,
            0.76
          ),
          rgba(
            5,
            9,
            10,
            0.50
          )
        );

      backdrop-filter:
        blur(
          19px
        );

      box-shadow:
        0
        18px
        55px
        rgba(
          0,
          0,
          0,
          0.22
        );

      pointer-events:
        none;

      transition:
        opacity
        250ms
        ease,

        transform
        250ms
        var(--pi-ease);
    }


    .pi-scene-info.is-hidden {
      opacity:
        0;

      transform:
        translateY(
          8px
        );
    }


    .pi-scene-eyebrow {

      display:
        flex;

      align-items:
        center;

      gap:
        7px;

      color:
        var(--pi-teal-soft);

      font-size:
        0.47rem;

      font-weight:
        800;

      letter-spacing:
        0.13em;

      text-transform:
        uppercase;
    }


    .pi-scene-eyebrow::before {

      content:
        "";

      width:
        18px;

      height:
        1px;

      background:
        linear-gradient(
          90deg,
          var(--pi-teal),
          transparent
        );
    }


    .pi-scene-name {

      margin-top:
        4px;

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(
          1.00rem,
          2.2vw,
          1.55rem
        );

      line-height:
        1.08;

      letter-spacing:
        -0.02em;
    }


    .pi-scene-description {

      max-width:
        420px;

      margin-top:
        5px;

      color:
        var(--pi-muted);

      font-size:
        0.56rem;

      line-height:
        1.55;
    }


    .pi-scene-meta {

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      margin-top:
        7px;

      color:
        rgba(
          255,
          255,
          255,
          0.55
        );

      font-size:
        0.49rem;

      font-weight:
        600;
    }


    .pi-scene-count {

      color:
        var(--pi-gold);

      font-weight:
        800;
    }


    /* ============================================================
       FLOATING CONTROL DOCK
    ============================================================ */

    .pi-dock {

      position:
        absolute;

      left:
        50%;

      bottom:
        15px;

      z-index:
        60;

      display:
        flex;

      align-items:
        center;

      gap:
        6px;

      transform:
        translateX(
          -50%
        );

      padding:
        6px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        999px;

      background:
        rgba(
          5,
          10,
          11,
          0.64
        );

      backdrop-filter:
        blur(
          20px
        );

      box-shadow:
        0
        18px
        50px
        rgba(
          0,
          0,
          0,
          0.22
        );

      transition:
        opacity
        300ms
        ease,

        transform
        300ms
        var(--pi-ease);
    }


    .pi-viewer.is-idle .pi-dock {

      opacity:
        0.20;

      transform:
        translateX(
          -50%
        )
        translateY(
          4px
        );
    }


    .pi-dock-btn {

      position:
        relative;

      width:
        39px;

      height:
        39px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        transparent;

      border-radius:
        50%;

      background:
        transparent;

      color:
        rgba(
          255,
          255,
          255,
          0.78
        );

      cursor:
        pointer;

      transition:
        background
        180ms
        ease,

        color
        180ms
        ease,

        transform
        180ms
        ease;
    }


    .pi-dock-btn:hover {

      background:
        rgba(
          255,
          255,
          255,
          0.07
        );

      color:
        #fff;

      transform:
        translateY(
          -1px
        );
    }


    .pi-dock-btn.is-active {

      color:
        var(--pi-teal-soft);

      background:
        rgba(
          27,
          209,
          197,
          0.10
        );
    }


    .pi-dock-divider {

      width:
        1px;

      height:
        20px;

      background:
        rgba(
          255,
          255,
          255,
          0.10
        );
    }


    /* ============================================================
       ZOOM
    ============================================================ */

    .pi-zoom {

      position:
        absolute;

      right:
        15px;

      bottom:
        15px;

      z-index:
        60;

      display:
        flex;

      flex-direction:
        column;

      gap:
        5px;

      padding:
        5px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        999px;

      background:
        rgba(
          5,
          10,
          11,
          0.56
        );

      backdrop-filter:
        blur(
          17px
        );

      transition:
        opacity
        300ms
        ease;
    }


    .pi-viewer.is-idle .pi-zoom {
      opacity:
        0.18;
    }


    .pi-zoom-btn {

      width:
        34px;

      height:
        34px;

      display:
        grid;

      place-items:
        center;

      border:
        0;

      border-radius:
        50%;

      background:
        transparent;

      color:
        rgba(
          255,
          255,
          255,
          0.76
        );

      cursor:
        pointer;
    }


    .pi-zoom-btn:hover {

      background:
        rgba(
          255,
          255,
          255,
          0.07
        );

      color:
        #fff;
    }


    .pi-fov-readout {

      position:
        absolute;

      right:
        100%;

      top:
        50%;

      margin-right:
        10px;

      transform:
        translateY(
          -50%
        );

      min-width:
        42px;

      padding:
        5px
        7px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        999px;

      background:
        rgba(
          5,
          10,
          11,
          0.66
        );

      color:
        var(--pi-muted);

      font-size:
        0.45rem;

      text-align:
        center;

      pointer-events:
        none;
    }


    /* ============================================================
       CENTER MOVEMENT HINT
    ============================================================ */

    .pi-travel-hint {

      position:
        absolute;

      left:
        50%;

      bottom:
        82px;

      z-index:
        45;

      max-width:
        min(
          360px,
          calc(
            100vw -
            36px
          )
        );

      padding:
        8px
        12px;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.10
        );

      border-radius:
        999px;

      background:
        rgba(
          5,
          10,
          11,
          0.62
        );

      color:
        rgba(
          255,
          255,
          255,
          0.72
        );

      font-size:
        0.52rem;

      font-weight:
        600;

      text-align:
        center;

      backdrop-filter:
        blur(
          16px
        );

      transform:
        translate(
          -50%,
          8px
        );

      opacity:
        0;

      pointer-events:
        none;

      transition:
        opacity
        220ms
        ease,

        transform
        220ms
        var(--pi-ease);
    }


    .pi-travel-hint.is-visible {

      opacity:
        1;

      transform:
        translate(
          -50%,
          0
        );
    }


    .pi-travel-hint strong {
      color:
        #fff;
    }


    /* ============================================================
       LOADING
    ============================================================ */

    .pi-loader {

      position:
        absolute;

      inset:
        0;

      z-index:
        200;

      display:
        grid;

      place-items:
        center;

      background:
        #000;

      transition:
        opacity
        400ms
        var(--pi-ease),

        visibility
        400ms
        ease;
    }


    .pi-loader.is-hidden {

      opacity:
        0;

      visibility:
        hidden;

      pointer-events:
        none;
    }


    .pi-loader-inner {

      width:
        min(
          320px,
          calc(
            100% -
            40px
          )
        );

      text-align:
        center;
    }


    .pi-loader-mark {

      width:
        48px;

      height:
        48px;

      margin:
        0
        auto
        17px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        rgba(
          255,
          255,
          255,
          0.12
        );

      border-radius:
        50%;

      background:
        radial-gradient(
          circle,
          rgba(
            27,
            209,
            197,
            0.13
          ),
          transparent 70%
        );

      color:
        var(--pi-teal);

      animation:
        piLoaderPulse
        1.7s
        ease-in-out
        infinite;
    }


    @keyframes piLoaderPulse {

      0%,
      100% {
        transform:
          scale(
            0.95
          );

        box-shadow:
          0
          0
          0
          0
          rgba(
            27,
            209,
            197,
            0
          );
      }

      50% {
        transform:
          scale(
            1.05
          );

        box-shadow:
          0
          0
          0
          12px
          rgba(
            27,
            209,
            197,
            0.06
          );
      }
    }


    .pi-loader-title {

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        1.25rem;
    }


    .pi-loader-message {

      margin-top:
        6px;

      color:
        var(--pi-muted);

      font-size:
        0.57rem;
    }


    .pi-progress {

      position:
        relative;

      width:
        100%;

      height:
        2px;

      margin-top:
        16px;

      overflow:
        hidden;

      border-radius:
        999px;

      background:
        rgba(
          255,
          255,
          255,
          0.08
        );
    }


    .pi-progress::after {

      content:
        "";

      position:
        absolute;

      top:
        0;

      bottom:
        0;

      width:
        38%;

      border-radius:
        inherit;

      background:
        linear-gradient(
          90deg,
          transparent,
          var(--pi-teal),
          transparent
        );

      animation:
        piProgress
        1.25s
        ease-in-out
        infinite;
    }


    @keyframes piProgress {

      from {
        left:
          -40%;
      }

      to {
        left:
          110%;
      }
    }


    /* ============================================================
       TRANSITION VEIL
    ============================================================ */

    .pi-transition-veil {

      position:
        absolute;

      inset:
        0;

      z-index:
        140;

      background:
        radial-gradient(
          circle at center,
          rgba(
            0,
            0,
            0,
            0.18
          ),
          rgba(
            0,
            0,
            0,
            0.86
          )
        );

      opacity:
        0;

      pointer-events:
        none;
    }


    /* ============================================================
       SIDE DRAWER
    ============================================================ */

    .pi-drawer-backdrop {

      position:
        absolute;

      inset:
        0;

      z-index:
        100;

      background:
        rgba(
          0,
          0,
          0,
          0.34
        );

      backdrop-filter:
        blur(
          3px
        );

      opacity:
        0;

      visibility:
        hidden;

      pointer-events:
        none;

      transition:
        opacity
        250ms
        ease,

        visibility
        250ms
        ease;
    }


    .pi-drawer-backdrop.is-open {

      opacity:
        1;

      visibility:
        visible;

      pointer-events:
        auto;
    }


    .pi-drawer {

      position:
        absolute;

      top:
        0;

      right:
        0;

      bottom:
        0;

      z-index:
        110;

      width:
        min(
          410px,
          92vw
        );

      display:
        flex;

      flex-direction:
        column;

      border-left:
        1px solid
        var(--pi-line);

      background:
        linear-gradient(
          180deg,
          rgba(
            7,
            12,
            13,
            0.97
          ),
          rgba(
            4,
            8,
            9,
            0.98
          )
        );

      box-shadow:
        -25px
        0
        80px
        rgba(
          0,
          0,
          0,
          0.40
        );

      transform:
        translateX(
          102%
        );

      transition:
        transform
        420ms
        var(--pi-ease);
    }


    .pi-drawer.is-open {
      transform:
        translateX(
          0
        );
    }


    .pi-drawer-head {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        12px;

      padding:
        17px;

      border-bottom:
        1px solid
        var(--pi-line);
    }


    .pi-drawer-head-copy {

      min-width:
        0;
    }


    .pi-drawer-kicker {

      color:
        var(--pi-teal);

      font-size:
        0.47rem;

      font-weight:
        800;

      letter-spacing:
        0.14em;

      text-transform:
        uppercase;
    }


    .pi-drawer-title {

      margin-top:
        3px;

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        1.22rem;
    }


    .pi-drawer-close {

      width:
        37px;

      height:
        37px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        50%;

      background:
        rgba(
          255,
          255,
          255,
          0.03
        );

      color:
        #fff;

      cursor:
        pointer;
    }


    .pi-drawer-tabs {

      display:
        grid;

      grid-template-columns:
        1fr
        1fr;

      gap:
        5px;

      padding:
        10px
        12px
        0;
    }


    .pi-drawer-tab {

      min-height:
        36px;

      border:
        1px solid
        var(--pi-line-soft);

      border-radius:
        10px;

      background:
        rgba(
          255,
          255,
          255,
          0.02
        );

      color:
        var(--pi-muted);

      cursor:
        pointer;

      font-size:
        0.54rem;

      font-weight:
        800;
    }


    .pi-drawer-tab.is-active {

      border-color:
        rgba(
          27,
          209,
          197,
          0.30
        );

      background:
        rgba(
          27,
          209,
          197,
          0.08
        );

      color:
        var(--pi-teal-soft);
    }


    .pi-drawer-content {

      flex:
        1;

      overflow:
        auto;

      padding:
        12px;
    }


    .pi-search {

      position:
        relative;

      margin-bottom:
        11px;
    }


    .pi-search i {

      position:
        absolute;

      left:
        12px;

      top:
        50%;

      transform:
        translateY(
          -50%
        );

      color:
        var(--pi-faint);

      font-size:
        0.60rem;

      pointer-events:
        none;
    }


    .pi-search input {

      width:
        100%;

      min-height:
        41px;

      padding:
        0
        13px
        0
        34px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        12px;

      outline:
        none;

      background:
        rgba(
          255,
          255,
          255,
          0.025
        );

      color:
        #fff;

      font-size:
        0.58rem;
    }


    .pi-search input:focus {

      border-color:
        rgba(
          27,
          209,
          197,
          0.38
        );

      box-shadow:
        0
        0
        0
        4px
        rgba(
          27,
          209,
          197,
          0.06
        );
    }


    .pi-location-list {

      display:
        grid;

      gap:
        7px;
    }


    .pi-location-card {

      display:
        grid;

      grid-template-columns:
        72px
        minmax(
          0,
          1fr
        )
        auto;

      gap:
        9px;

      align-items:
        center;

      width:
        100%;

      padding:
        7px;

      border:
        1px solid
        transparent;

      border-radius:
        13px;

      background:
        rgba(
          255,
          255,
          255,
          0.025
        );

      color:
        #fff;

      text-align:
        left;

      cursor:
        pointer;

      transition:
        border-color
        180ms
        ease,

        background
        180ms
        ease,

        transform
        180ms
        ease;
    }


    .pi-location-card:hover {

      border-color:
        rgba(
          255,
          255,
          255,
          0.11
        );

      background:
        rgba(
          255,
          255,
          255,
          0.045
        );

      transform:
        translateX(
          -1px
        );
    }


    .pi-location-card.is-current {

      border-color:
        rgba(
          27,
          209,
          197,
          0.26
        );

      background:
        rgba(
          27,
          209,
          197,
          0.06
        );
    }


    .pi-location-thumb {

      width:
        72px;

      height:
        50px;

      overflow:
        hidden;

      border-radius:
        9px;

      background:
        #020303;
    }


    .pi-location-thumb img {

      width:
        100%;

      height:
        100%;

      display:
        block;

      object-fit:
        cover;
    }


    .pi-location-copy {

      min-width:
        0;
    }


    .pi-location-copy strong {

      display:
        block;

      overflow:
        hidden;

      color:
        #fff;

      font-size:
        0.58rem;

      white-space:
        nowrap;

      text-overflow:
        ellipsis;
    }


    .pi-location-copy span {

      display:
        block;

      margin-top:
        3px;

      overflow:
        hidden;

      color:
        var(--pi-muted);

      font-size:
        0.48rem;

      white-space:
        nowrap;

      text-overflow:
        ellipsis;
    }


    .pi-location-arrow {

      width:
        28px;

      height:
        28px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        50%;

      color:
        var(--pi-faint);

      font-size:
        0.55rem;
    }


    .pi-location-card.is-current
    .pi-location-arrow {
      color:
        var(--pi-teal);
    }


    /* ============================================================
       MAP
    ============================================================ */

    .pi-map-wrap {

      position:
        relative;

      min-height:
        380px;

      overflow:
        hidden;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        16px;

      background:
        radial-gradient(
          circle at center,
          rgba(
            27,
            209,
            197,
            0.05
          ),
          transparent 60%
        ),
        #080d0f;
    }


    .pi-map-background {

      position:
        absolute;

      inset:
        0;

      background:
        center /
        cover
        no-repeat;

      opacity:
        0.30;

      filter:
        saturate(
          0.75
        );
    }


    .pi-map-grid {

      position:
        absolute;

      inset:
        0;

      background-image:
        linear-gradient(
          rgba(
            255,
            255,
            255,
            0.045
          ) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(
            255,
            255,
            255,
            0.045
          ) 1px,
          transparent 1px
        );

      background-size:
        25% 25%;
    }


    .pi-map-svg {

      position:
        absolute;

      inset:
        0;

      width:
        100%;

      height:
        100%;
    }


    .pi-map-node {

      cursor:
        pointer;
    }


    .pi-map-node-circle {

      stroke:
        rgba(
          4,
          10,
          11,
          0.90
        );

      stroke-width:
        2;
    }


    .pi-map-node-circle.current {

      stroke:
        var(--pi-gold);

      stroke-width:
        2.5;
    }


    .pi-map-node-text {

      fill:
        #fff;

      font-family:
        "DM Sans",
        sans-serif;

      font-size:
        9px;

      font-weight:
        700;

      paint-order:
        stroke;

      stroke:
        rgba(
          0,
          0,
          0,
          0.85
        );

      stroke-width:
        3px;

      stroke-linejoin:
        round;

      pointer-events:
        none;
    }


    .pi-map-legend {

      position:
        absolute;

      left:
        10px;

      bottom:
        9px;

      padding:
        6px
        8px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        999px;

      background:
        rgba(
          3,
          7,
          8,
          0.68
        );

      color:
        var(--pi-muted);

      font-size:
        0.46rem;

      backdrop-filter:
        blur(
          10px
        );
    }


    /* ============================================================
       INFO MODAL
    ============================================================ */

    .pi-info-layer {

      position:
        absolute;

      inset:
        0;

      z-index:
        150;

      display:
        grid;

      place-items:
        center;

      padding:
        18px;

      background:
        rgba(
          0,
          0,
          0,
          0.46
        );

      backdrop-filter:
        blur(
          8px
        );

      opacity:
        0;

      visibility:
        hidden;

      pointer-events:
        none;

      transition:
        opacity
        230ms
        ease,

        visibility
        230ms
        ease;
    }


    .pi-info-layer.is-open {

      opacity:
        1;

      visibility:
        visible;

      pointer-events:
        auto;
    }


    .pi-info-card {

      width:
        min(
          520px,
          100%
        );

      overflow:
        hidden;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        22px;

      background:
        linear-gradient(
          150deg,
          rgba(
            10,
            17,
            18,
            0.98
          ),
          rgba(
            5,
            10,
            11,
            0.98
          )
        );

      box-shadow:
        0
        35px
        100px
        rgba(
          0,
          0,
          0,
          0.50
        );

      transform:
        translateY(
          10px
        )
        scale(
          0.98
        );

      transition:
        transform
        270ms
        var(--pi-ease);
    }


    .pi-info-layer.is-open
    .pi-info-card {

      transform:
        translateY(
          0
        )
        scale(
          1
        );
    }


    .pi-info-top {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        12px;

      padding:
        15px 16px;

      border-bottom:
        1px solid
        var(--pi-line);
    }


    .pi-info-kicker {

      color:
        var(--pi-teal);

      font-size:
        0.48rem;

      font-weight:
        800;

      letter-spacing:
        0.14em;

      text-transform:
        uppercase;
    }


    .pi-info-close {

      width:
        34px;

      height:
        34px;

      display:
        grid;

      place-items:
        center;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        50%;

      background:
        rgba(
          255,
          255,
          255,
          0.03
        );

      color:
        #fff;

      cursor:
        pointer;
    }


    .pi-info-body {

      padding:
        18px;
    }


    .pi-info-title {

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        1.62rem;

      line-height:
        1.08;
    }


    .pi-info-description {

      margin-top:
        8px;

      color:
        var(--pi-muted);

      font-size:
        0.64rem;

      line-height:
        1.7;
    }


    .pi-info-actions {

      display:
        flex;

      gap:
        8px;

      margin-top:
        16px;
    }


    .pi-info-btn {

      min-height:
        40px;

      padding:
        0
        13px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        11px;

      background:
        rgba(
          255,
          255,
          255,
          0.03
        );

      color:
        #fff;

      cursor:
        pointer;

      font-size:
        0.58rem;

      font-weight:
        800;
    }


    .pi-info-btn.primary {

      border-color:
        transparent;

      background:
        linear-gradient(
          135deg,
          var(--pi-teal-soft),
          var(--pi-teal)
        );

      color:
        #031111;
    }


    /* ============================================================
       TOAST
    ============================================================ */

    .pi-toast {

      position:
        absolute;

      left:
        50%;

      top:
        82px;

      z-index:
        180;

      max-width:
        min(
          420px,
          calc(
            100vw -
            30px
          )
        );

      padding:
        8px
        12px;

      border:
        1px solid
        var(--pi-line);

      border-radius:
        999px;

      background:
        rgba(
          5,
          10,
          11,
          0.80
        );

      color:
        var(--pi-soft);

      font-size:
        0.53rem;

      font-weight:
        700;

      text-align:
        center;

      backdrop-filter:
        blur(
          17px
        );

      transform:
        translate(
          -50%,
          -8px
        );

      opacity:
        0;

      pointer-events:
        none;

      transition:
        opacity
        220ms
        ease,

        transform
        220ms
        var(--pi-ease);
    }


    .pi-toast.is-visible {

      opacity:
        1;

      transform:
        translate(
          -50%,
          0
        );
    }


    /* ============================================================
       ERROR
    ============================================================ */

    .pi-error {

      position:
        absolute;

      inset:
        0;

      z-index:
        190;

      display:
        none;

      place-items:
        center;

      padding:
        24px;

      background:
        rgba(
          0,
          0,
          0,
          0.86
        );
    }


    .pi-error.is-visible {
      display:
        grid;
    }


    .pi-error-card {

      width:
        min(
          460px,
          100%
        );

      padding:
        24px;

      border:
        1px solid
        rgba(
          255,
          118,
          118,
          0.22
        );

      border-radius:
        20px;

      background:
        rgba(
          10,
          14,
          15,
          0.97
        );

      text-align:
        center;
    }


    .pi-error-icon {

      width:
        46px;

      height:
        46px;

      margin:
        0
        auto
        13px;

      display:
        grid;

      place-items:
        center;

      border-radius:
        50%;

      background:
        rgba(
          255,
          118,
          118,
          0.08
        );

      color:
        var(--pi-red);
    }


    .pi-error-card h2 {

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        1.35rem;
    }


    .pi-error-card p {

      margin-top:
        7px;

      color:
        var(--pi-muted);

      font-size:
        0.61rem;

      line-height:
        1.6;
    }


    .pi-error-card button {

      min-height:
        40px;

      margin-top:
        15px;

      padding:
        0
        14px;

      border-radius:
        10px;

      background:
        var(--pi-teal);

      color:
        #031111;

      cursor:
        pointer;

      font-size:
        0.58rem;

      font-weight:
        800;
    }


    /* ============================================================
       EMPTY STATE
    ============================================================ */

    .pi-empty {

      position:
        absolute;

      inset:
        0;

      z-index:
        190;

      display:
        none;

      place-items:
        center;

      background:
        #050809;

      text-align:
        center;
    }


    .pi-empty.is-visible {
      display:
        grid;
    }


    .pi-empty-inner {
      width:
        min(
          420px,
          calc(
            100% -
            32px
          )
        );
    }


    .pi-empty-inner i {

      font-size:
        2rem;

      color:
        var(--pi-teal);

      margin-bottom:
        13px;
    }


    .pi-empty-inner h2 {

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        1.50rem;
    }


    .pi-empty-inner p {

      margin-top:
        7px;

      color:
        var(--pi-muted);

      font-size:
        0.61rem;

      line-height:
        1.6;
    }


    /* ============================================================
       MOBILE
    ============================================================ */

    @media (
      max-width:
      760px
    ) {

      :root {
        --pi-nav-height:
          64px;
      }


      .pi-tour-shell {

        min-height:
          480px;
      }


      .pi-top {

        top:
          9px;

        left:
          9px;

        right:
          9px;
      }


      .pi-brand {

        max-width:
          58vw;

        padding:
          6px
          9px
          6px
          6px;
      }


      .pi-brand-logo {

        width:
          29px;

        height:
          29px;
      }


      .pi-brand-copy strong {
        font-size:
          0.56rem;
      }


      .pi-brand-copy span {
        font-size:
          0.42rem;
      }


      .pi-top-actions {
        gap:
          4px;
      }


      .pi-icon-btn {

        width:
          35px;

        height:
          35px;

        font-size:
          0.70rem;
      }


      .pi-top-actions
      .pi-icon-btn:nth-child(
        4
      ) {

        display:
          none;
      }


      .pi-compass {

        top:
          10px;

        width:
          46px;

        height:
          46px;
      }


      .pi-scene-info {

        left:
          9px;

        right:
          9px;

        bottom:
          8px;

        max-width:
          none;

        padding:
          10px
          12px;

        border-radius:
          14px;
      }


      .pi-scene-description {
        display:
          none;
      }


      .pi-dock {

        bottom:
          76px;
      }


      .pi-viewer.is-idle .pi-dock {

        transform:
          translateX(
            -50%
          )
          translateY(
            4px
          );
      }


      .pi-zoom {

        right:
          9px;

        bottom:
          9px;
      }


      .pi-travel-hint {

        bottom:
          133px;
      }


      .pi-drawer {

        top:
          auto;

        width:
          100%;

        height:
          min(
            74vh,
            620px
          );

        border:
          0;

        border-top:
          1px solid
          var(--pi-line);

        border-radius:
          20px
          20px
          0
          0;

        transform:
          translateY(
            104%
          );
      }


      .pi-drawer.is-open {

        transform:
          translateY(
            0
          );
      }


      .pi-location-card {

        grid-template-columns:
          68px
          minmax(
            0,
            1fr
          )
          auto;
      }


      .pi-location-thumb {
        width:
          68px;

        height:
          48px;
      }


      .pi-info-card {
        max-height:
          calc(
            100dvh -
            40px
          );

        overflow:
          auto;
      }


      .pi-toast {

        top:
          64px;
      }

    }


    @media (
      max-width:
      430px
    ) {

      .pi-dock-btn {

        width:
          36px;

        height:
          36px;
      }


      .pi-dock-divider {
        height:
          17px;
      }


      .pi-fov-readout {
        display:
          none;
      }


      .pi-scene-name {
        font-size:
          0.98rem;
      }

    }


    /* ============================================================
       REDUCED MOTION
    ============================================================ */

    @media (
      prefers-reduced-motion:
      reduce
    ) {

      *,
      *::before,
      *::after {

        animation-duration:
          0.01ms !important;

        animation-iteration-count:
          1 !important;

        scroll-behavior:
          auto !important;

        transition-duration:
          0.01ms !important;
      }

    }

  </style>

</head>


<body>


  <!-- ==========================================================
       EXISTING PUBLIC NAVBAR
  =========================================================== -->

  <%- include("partials/navbar") %>


  <!-- ==========================================================
       IMMERSIVE TOUR
  =========================================================== -->

  <main
    class="pi-tour-shell"
    id="piTourShell"
  >


    <!-- ========================================================
         VIEWER
    ========================================================= -->

    <section
      class="pi-viewer"
      id="piViewer"
      aria-label="Puffer Isle Resort 360 degree virtual experience"
    >


      <!-- ======================================================
           A-FRAME WORLD
      ======================================================= -->

      <a-scene
        id="piScene"
        embedded
        vr-mode-ui="enabled: false"
        device-orientation-permission-ui="enabled: false"
        renderer="
          antialias: true;
          colorManagement: true;
          sortObjects: true
        "
      >


        <!-- CAMERA -->

        <a-entity id="piCameraRig">

          <a-camera
            id="piCamera"
            fov="75"
            wasd-controls="enabled: false"
            look-controls="
              reverseMouseDrag: false;
              touchEnabled: true;
              mouseEnabled: true;
              magicWindowTrackingEnabled: true
            "
          >

            <!--
              Desktop mouse ray.
              The DOM layer handles double-click travel,
              while this ray handles in-world hotspot clicks.
            -->

            <a-entity
              cursor="
                fuse: false;
                rayOrigin: mouse
              "
              raycaster="
                objects: .pi-hotspot-hit;
                far: 40;
                interval: 80
              "
            ></a-entity>

          </a-camera>

        </a-entity>


        <!-- ACTIVE / INCOMING PANORAMAS -->

        <a-sky
          id="piSkyA"
          rotation="0 -90 0"
          material="
            shader: flat;
            side: back;
            opacity: 1
          "
        ></a-sky>


        <a-sky
          id="piSkyB"
          rotation="0 -90 0"
          material="
            shader: flat;
            side: back;
            opacity: 0
          "
        ></a-sky>


        <!-- WORLD HOTSPOTS -->

        <a-entity
          id="piWorldHotspots"
        ></a-entity>


      </a-scene>


      <!-- ======================================================
           TOP
      ======================================================= -->

      <div class="pi-top">


        <div class="pi-brand">

          <img
            class="pi-brand-logo"
            src="/images/islelogo.png"
            alt="Puffer Isle Resort"
          >

          <div class="pi-brand-copy">

            <strong>
              PUFFER ISLE
            </strong>

            <span>
              360° Explore
            </span>

          </div>

        </div>


        <div class="pi-top-actions">


          <button
            class="pi-icon-btn"
            id="locationsBtn"
            type="button"
            aria-label="Open resort locations"
            title="Locations"
          >
            <i class="fa-solid fa-location-dot"></i>
          </button>


          <button
            class="pi-icon-btn"
            id="mapBtn"
            type="button"
            aria-label="Open resort map"
            title="Resort map"
          >
            <i class="fa-solid fa-map"></i>
          </button>


          <button
            class="pi-icon-btn"
            id="motionBtn"
            type="button"
            aria-label="Enable phone motion"
            title="Move phone to look around"
          >
            <i class="fa-solid fa-mobile-screen-button"></i>
          </button>


          <button
            class="pi-icon-btn"
            id="shareBtn"
            type="button"
            aria-label="Share this scene"
            title="Share"
          >
            <i class="fa-solid fa-share-nodes"></i>
          </button>


          <button
            class="pi-icon-btn"
            id="fullscreenBtn"
            type="button"
            aria-label="Enter fullscreen"
            title="Fullscreen"
          >
            <i class="fa-solid fa-expand"></i>
          </button>


        </div>

      </div>


      <!-- ======================================================
           COMPASS
      ======================================================= -->

      <div
        class="pi-compass"
        id="piCompass"
        aria-label="Compass"
      >

        <div
          class="pi-compass-ring"
        ></div>

        <span class="pi-compass-n">
          N
        </span>

        <span
          class="pi-compass-needle"
          id="piCompassNeedle"
        ></span>

        <span class="pi-compass-dot"></span>

      </div>


      <!-- ======================================================
           SCENE IDENTITY
      ======================================================= -->

      <div
        class="pi-scene-info"
        id="piSceneInfo"
      >

        <div class="pi-scene-eyebrow">
          Puffer Isle · Explore
        </div>

        <h1
          class="pi-scene-name"
          id="piSceneName"
        >
          Loading...
        </h1>

        <p
          class="pi-scene-description"
          id="piSceneDescription"
        ></p>

        <div class="pi-scene-meta">

          <span>
            <span
              class="pi-scene-count"
              id="piSceneCount"
            >
              1 / 1
            </span>
          </span>

          <span>
            ·
          </span>

          <span id="piSceneLocation">
            Immersive panorama
          </span>

        </div>

      </div>


      <!-- ======================================================
           TRAVEL HINT
      ======================================================= -->

      <div
        class="pi-travel-hint"
        id="piTravelHint"
      >
        <strong id="piTravelHintTitle">
          Walk here
        </strong>
        <span id="piTravelHintText">
          Click to continue exploring
        </span>
      </div>


      <!-- ======================================================
           CONTROL DOCK
      ======================================================= -->

      <div class="pi-dock">


        <button
          class="pi-dock-btn"
          id="resetViewBtn"
          type="button"
          aria-label="Reset view"
          title="Reset view"
        >
          <i class="fa-solid fa-compass"></i>
        </button>


        <button
          class="pi-dock-btn"
          id="previousBtn"
          type="button"
          aria-label="Previous scene"
          title="Previous scene"
        >
          <i class="fa-solid fa-arrow-left"></i>
        </button>


        <button
          class="pi-dock-btn"
          id="nextBtn"
          type="button"
          aria-label="Next scene"
          title="Next scene"
        >
          <i class="fa-solid fa-arrow-right"></i>
        </button>


        <div
          class="pi-dock-divider"
          aria-hidden="true"
        ></div>


        <button
          class="pi-dock-btn"
          id="infoBtn"
          type="button"
          aria-label="Scene information"
          title="Scene information"
        >
          <i class="fa-solid fa-circle-info"></i>
        </button>

      </div>


      <!-- ======================================================
           ZOOM
      ======================================================= -->

      <div class="pi-zoom">

        <button
          class="pi-zoom-btn"
          id="zoomInBtn"
          type="button"
          aria-label="Zoom in"
        >
          <i class="fa-solid fa-plus"></i>
        </button>


        <button
          class="pi-zoom-btn"
          id="zoomOutBtn"
          type="button"
          aria-label="Zoom out"
        >
          <i class="fa-solid fa-minus"></i>
        </button>


        <span
          class="pi-fov-readout"
          id="piFovReadout"
        >
          75°
        </span>

      </div>


      <!-- ======================================================
           TRANSITION
      ======================================================= -->

      <div
        class="pi-transition-veil"
        id="piTransitionVeil"
      ></div>


      <!-- ======================================================
           LOADER
      ======================================================= -->

      <div
        class="pi-loader"
        id="piLoader"
      >

        <div class="pi-loader-inner">

          <div class="pi-loader-mark">
            <i class="fa-solid fa-compass"></i>
          </div>

          <div
            class="pi-loader-title"
            id="piLoaderTitle"
          >
            Preparing Puffer Isle
          </div>

          <div
            class="pi-loader-message"
            id="piLoaderMessage"
          >
            Loading your immersive resort view...
          </div>

          <div
            class="pi-progress"
          ></div>

        </div>

      </div>


      <!-- ======================================================
           DRAWER BACKDROP
      ======================================================= -->

      <div
        class="pi-drawer-backdrop"
        id="piDrawerBackdrop"
      ></div>


      <!-- ======================================================
           DRAWER
      ======================================================= -->

      <aside
        class="pi-drawer"
        id="piDrawer"
        aria-hidden="true"
      >


        <div class="pi-drawer-head">

          <div class="pi-drawer-head-copy">

            <div class="pi-drawer-kicker">
              Puffer Isle
            </div>

            <h2 class="pi-drawer-title">
              Explore
            </h2>

          </div>


          <button
            class="pi-drawer-close"
            id="piDrawerClose"
            type="button"
            aria-label="Close explorer"
          >
            <i class="fa-solid fa-xmark"></i>
          </button>

        </div>


        <div class="pi-drawer-tabs">

          <button
            class="pi-drawer-tab is-active"
            type="button"
            data-drawer-tab="locations"
          >
            Locations
          </button>

          <button
            class="pi-drawer-tab"
            type="button"
            data-drawer-tab="map"
          >
            Resort Map
          </button>

        </div>


        <div class="pi-drawer-content">


          <!-- LOCATIONS -->

          <section
            data-drawer-panel="locations"
          >

            <div class="pi-search">

              <i
                class="fa-solid fa-magnifying-glass"
              ></i>

              <input
                id="piLocationSearch"
                type="search"
                autocomplete="off"
                placeholder="Search the resort..."
                aria-label="Search resort locations"
              >

            </div>


            <div
              class="pi-location-list"
              id="piLocationList"
            ></div>

          </section>


          <!-- MAP -->

          <section
            data-drawer-panel="map"
            style="display:none;"
          >

            <div class="pi-map-wrap">

              <div
                class="pi-map-background"
                id="piMapBackground"
              ></div>

              <div
                class="pi-map-grid"
              ></div>

              <svg
                class="pi-map-svg"
                id="piMapSvg"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                aria-label="Interactive resort scene map"
              ></svg>

              <div class="pi-map-legend">
                Current location · Click another node to travel
              </div>

            </div>

          </section>


        </div>

      </aside>


      <!-- ======================================================
           INFO
      ======================================================= -->

      <section
        class="pi-info-layer"
        id="piInfoLayer"
        aria-hidden="true"
      >

        <article class="pi-info-card">

          <div class="pi-info-top">

            <div class="pi-info-kicker">
              Scene information
            </div>

            <button
              class="pi-info-close"
              id="piInfoClose"
              type="button"
              aria-label="Close information"
            >
              <i class="fa-solid fa-xmark"></i>
            </button>

          </div>


          <div class="pi-info-body">

            <h2
              class="pi-info-title"
              id="piInfoTitle"
            >
              Explore Puffer Isle
            </h2>

            <p
              class="pi-info-description"
              id="piInfoDescription"
            >
              Discover the resort in immersive 360°.
            </p>

            <div
              class="pi-info-actions"
              id="piInfoActions"
            ></div>

          </div>

        </article>

      </section>


      <!-- ======================================================
           TOAST
      ======================================================= -->

      <div
        class="pi-toast"
        id="piToast"
        role="status"
        aria-live="polite"
      ></div>


      <!-- ======================================================
           ERROR
      ======================================================= -->

      <div
        class="pi-error"
        id="piError"
      >

        <div class="pi-error-card">

          <div class="pi-error-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>

          <h2>
            The panorama couldn't load
          </h2>

          <p id="piErrorMessage">
            Please try loading this location again.
          </p>

          <button
            type="button"
            id="piRetryBtn"
          >
            Try Again
          </button>

        </div>

      </div>


      <!-- ======================================================
           EMPTY
      ======================================================= -->

      <div
        class="pi-empty <%= galleryScenes.length === 0 ? 'is-visible' : '' %>"
        id="piEmpty"
      >

        <div class="pi-empty-inner">

          <i class="fa-solid fa-panorama"></i>

          <h2>
            Puffer Isle is preparing its tour
          </h2>

          <p>
            The immersive gallery doesn't have any panorama
            locations available yet.
          </p>

        </div>

      </div>


    </section>

  </main>


  <!-- ==========================================================
       DATA
  =========================================================== -->

  <script
    id="piGalleryData"
    type="application/json"
  ><%- publicGalleryJson %></script>


  <!-- ==========================================================
       APPLICATION
  =========================================================== -->

  <script>

    "use strict";


    /* ============================================================
       DATA
    ============================================================ */

    const PI_DATA =
      (() => {

        try {

          const element =
            document.getElementById(
              "piGalleryData"
            );

          if (
            !element
          ) {
            return {
              scenes: [],
              tour: {},
              viewer: {},
              map: {}
            };
          }

          const parsed =
            JSON.parse(
              element.textContent ||
              "{}"
            );

          return (
            parsed &&
            typeof parsed ===
              "object"
              ? parsed
              : {
                  scenes: [],
                  tour: {},
                  viewer: {},
                  map: {}
                }
          );

        } catch (
          error
        ) {

          console.error(
            "Puffer Isle gallery data error:",
            error
          );

          return {
            scenes: [],
            tour: {},
            viewer: {},
            map: {}
          };

        }

      })();


    const scenes =
      Array.isArray(
        PI_DATA.scenes
      )
        ? PI_DATA.scenes
        : [];


    const tourSettings = {
      enabled:
        PI_DATA.tour?.enabled !==
        false,

      startScene:
        Number.isInteger(
          Number(
            PI_DATA.tour?.startScene
          )
        )
          ? Number(
              PI_DATA.tour.startScene
            )
          : 0,

      preloadNeighbors:
        PI_DATA.tour?.preloadNeighbors !==
        false,

      preloadDepth:
        Math.max(
          1,
          Math.min(
            4,
            Number(
              PI_DATA.tour?.preloadDepth
            ) || 2
          )
        ),

      allowSharing:
        PI_DATA.tour?.allowSharing !==
