    /* ============================================================
       TRAVEL HINT
    ============================================================ */

    function showTravelHint(
      data
    ) {

      if (
        !travelHint
      ) {
        return;
      }


      travelHintTitle.textContent =
        data.title ||
        "Continue exploring";


      travelHintText.textContent =
        data.kind ===
        "navigation"
          ? "Click to move here"
          : "Click to explore";


      travelHint.classList.add(
        "is-visible"
      );

    }


    function hideTravelHint() {

      travelHint?.classList.remove(
        "is-visible"
      );

    }


    /* ============================================================
       RENDER WORLD HOTSPOTS
    ============================================================ */

    function renderWorldHotspots() {

      if (
        !worldHotspots
      ) {
        return;
      }


      worldHotspots.innerHTML =
        "";


      if (
        !tourSettings.showHotspots
      ) {

        return;
      }


      const source =
        scenes[
          currentIndex
        ];


      if (
        !source
      ) {
        return;
      }


      const customNavigationTargets =
        new Set();


      const customHotspots =
        Array.isArray(
          source.hotspots
        )
          ? source.hotspots
          : [];


      /*
       * First render author-defined hotspots.
       *
       * These are the highest precision markers because the
       * admin editor placed their exact yaw/pitch.
       */
      customHotspots.forEach(
        hotspot => {

          if (
            hotspot?.visible ===
            false ||
            hotspot?.interactive ===
            false
          ) {

            return;
          }


          const rawTarget =
            hotspot?.targetIndex ??
            hotspot?.target;


          const numericTarget =
            Number(
              rawTarget
            );


          if (
            hotspot?.type ===
            "navigation" &&
            Number.isInteger(
              numericTarget
            ) &&
            numericTarget >=
            0 &&
            numericTarget <
            scenes.length &&
            numericTarget !==
            currentIndex
          ) {

            customNavigationTargets.add(
              numericTarget
            );


            const marker =
              makeTravelMarker(
                {
                  title:
                    hotspot.title ||
                    scenes[
                      numericTarget
                    ]?.title ||
                    "Continue",

                  target:
                    numericTarget,

                  yaw:
                    Number(
                      hotspot.yaw
                    ) || 0,

                  pitch:
                    Number(
                      hotspot.pitch
                    ) ||
                    -12
                }
              );


            worldHotspots.appendChild(
              marker
            );


            return;
          }


          /*
           * Information, POI and link hotspots.
           */
          const marker =
            makeInfoMarker(
              {
                ...hotspot,

                yaw:
                  Number(
                    hotspot.yaw
                  ) || 0,

                pitch:
                  Number(
                    hotspot.pitch
                  ) || 0
              }
            );


          worldHotspots.appendChild(
            marker
          );

        }
      );


      /*
       * Legacy direction navigation remains visible for every
       * connection that does not already have a custom navigation
       * hotspot targeting the same scene.
       */
      getSceneConnections(
        currentIndex
      ).forEach(
        connection => {

          if (
            customNavigationTargets.has(
              connection.target
            )
          ) {

            return;
          }


          const yaw =
            connectionYaw(
              currentIndex,
              connection.target,
              connection.direction
            );


          const marker =
            makeTravelMarker(
              {
                title:
                  scenes[
                    connection.target
                  ]?.title ||
                  "Continue",

                target:
                  connection.target,

                yaw,

                pitch:
                  -14

              }
            );


          worldHotspots.appendChild(
            marker
          );

        }
      );

    }


    /* ============================================================
       SCENE TRANSITION
    ============================================================ */

    async function travelToScene(
      targetIndex,
      options = {}
    ) {

      if (
        !Number.isInteger(
          Number(
            targetIndex
          )
        )
      ) {

        return;
      }


      targetIndex =
        Number(
          targetIndex
        );


      if (
        targetIndex <
          0 ||
        targetIndex >=
          scenes.length
      ) {

        return;
      }


      if (
        targetIndex ===
          currentIndex
      ) {

        return;
      }


      if (
        isTransitioning ||
        sceneLoading
      ) {

        return;
      }


      const fromIndex =
        currentIndex;


      const destination =
        scenes[
          targetIndex
        ];


      const source =
        scenes[
          fromIndex
        ];


      if (
        !destination?.image
      ) {

        showError(
          "This scene does not contain a panorama image."
        );

        return;
      }


      const directionYaw =
        Number.isFinite(
          Number(
            options.yaw
          )
        )
          ? Number(
              options.yaw
            )
          : getCameraYaw();


      const targetPose = {

        yaw:
          arrivalYaw(
            fromIndex,
            targetIndex,
            directionYaw
          ),

        pitch:
          Number(
            destination.pitch
          ) || 0,

        fov:
          clamp(
            Number(
              destination.fov
            ) ||
            viewerSettings.defaultFov,
            viewerSettings.minFov,
            viewerSettings.maxFov
          )

      };


      isTransitioning =
        true;


      sceneLoading =
        true;


      hideTravelHint();


      setUiIdle(
        false
      );


      showLoader(
        destination.title ||
          "Moving through Puffer Isle",

        "Opening the next resort location..."
      );


      try {

        const incomingSky =
          activeSky ===
          "A"
            ? skyB
            : skyA;


        const outgoingSky =
          activeSky ===
          "A"
            ? skyA
            : skyB;


        transitionVeil.style.transition =
          "opacity 220ms ease";


        transitionVeil.style.opacity =
          "0";


        /*
         * Prepare the destination before visually transitioning.
         */
        await prepareIncomingSky(
          incomingSky,
          destination.image
        );


        /*
         * Travel compression:
         * slightly narrow FOV before the panorama swap.
         */
        const preTravelFov =
          clamp(
            getCameraFov() -
              9,
            viewerSettings.minFov,
            viewerSettings.maxFov
          );


        const fovStart =
          getCameraFov();


        const fovDistance =
          preTravelFov -
          fovStart;


        const travelStart =
          performance.now();


        await new Promise(
          resolve => {

            const frame =
              now => {

                const progress =
                  clamp(
                    (
                      now -
                      travelStart
                    ) /
                    240,
                    0,
                    1
                  );


                const eased =
                  1 -
                  Math.pow(
                    1 -
                      progress,
                    3
                  );


                camera.setAttribute(
                  "fov",
                  fovStart +
                  fovDistance *
                  eased
                );


                if (
                  progress <
                  1
                ) {

                  requestAnimationFrame(
                    frame
                  );

                } else {

                  resolve();

                }

              };


            requestAnimationFrame(
              frame
            );

          }
        );


        /*
         * Cinematic dark veil at the exact scene handoff.
         */
        transitionVeil.style.opacity =
          "0.72";


        await new Promise(
          resolve =>
            setTimeout(
              resolve,
              100
            )
        );


        /*
         * Rotate camera before the destination appears.
         */
        setCameraPose(
          targetPose.yaw,
          targetPose.pitch,
          preTravelFov
        );


        /*
         * Crossfade the panorama itself.
         */
        await animateSkyCrossfade(
          incomingSky,
          outgoingSky,
          470
        );


        /*
         * The incoming sky becomes the active sky.
         */
        activeSky =
          activeSky ===
          "A"
            ? "B"
            : "A";


        currentIndex =
          targetIndex;


        /*
         * Reset the viewer to the destination's configured view.
         */
        setCameraPose(
          targetPose.yaw,
          targetPose.pitch,
          targetPose.fov
        );


        /*
         * Update everything controlled by the scene state.
         */
        updateSceneUi();

        renderWorldHotspots();

        renderLocations();

        renderMap();

        preloadConnectedScenes(
          currentIndex
        );


        /*
         * URL navigation.
         */
        if (
          options.fromHistory !==
          true
        ) {

          updateSceneUrl(
            currentIndex,
            false
          );

        }


        /*
         * Fade back into the full panorama.
         */
        transitionVeil.style.opacity =
          "0";


        await new Promise(
          resolve =>
            setTimeout(
              resolve,
              180
            )
        );


        hideLoader();


        showToast(
          destination.title ||
          "Arrived"
        );


        /*
         * Silence linter-style unused source warnings while keeping
         * the source scene available for future analytics.
         */
        void source;

      } catch (
        error
      ) {

        console.error(
          "Puffer Isle scene transition failed:",
          error
        );


        showError(
          "We couldn't move to that panorama. Please try again."
        );


        transitionVeil.style.opacity =
          "0";


      } finally {

        sceneLoading =
          false;


        isTransitioning =
          false;


        hideLoader();


        setUiIdle(
          false
        );

      }

    }


    /* ============================================================
       DIRECT SCENE LOAD
    ============================================================ */

    async function loadInitialScene() {

      if (
        !scenes.length
      ) {

        emptyLayer.classList.add(
          "is-visible"
        );

        hideLoader();

        return;
      }


      const safeIndex =
        clamp(
          currentIndex,
          0,
          scenes.length -
            1
        );


      currentIndex =
        safeIndex;


      const scene =
        scenes[
          currentIndex
        ];


      if (
        !scene?.image
      ) {

        showError(
          "The selected scene does not contain a panorama image."
        );

        return;
      }


      showLoader(
        scene.title ||
          "Preparing Puffer Isle",

        "Loading the immersive resort view..."
      );


      try {

        await preloadImage(
          scene.image
        );


        skyA.setAttribute(
          "src",
          scene.image
        );


        await waitForSkyReady(
          skyA
        );


        setSkyOpacity(
          skyA,
          1
        );


        setSkyOpacity(
          skyB,
          0
        );


        activeSky =
          "A";


        const pose =
          sceneStartPose(
            scene
          );


        setCameraPose(
          pose.yaw,
          pose.pitch,
          pose.fov
        );


        updateSceneUrl(
          currentIndex,
          true
        );


        updateSceneUi();

        renderWorldHotspots();

        renderLocations();

        renderMap();

        preloadConnectedScenes(
          currentIndex
        );


        hideLoader();


        viewer.classList.remove(
          "is-idle"
        );


        startUiIdleTimer();


      } catch (
        error
      ) {

        console.error(
          "Initial panorama load failed:",
          error
        );


        showError(
          "The initial panorama could not be loaded."
        );

      }

    }


    /* ============================================================
       SCENE UI
    ============================================================ */

    function updateSceneUi() {

      const scene =
        scenes[
          currentIndex
        ];


      if (
        !scene
      ) {

        return;
      }


      sceneName.textContent =
        scene.title ||
        `Scene ${
          currentIndex + 1
        }`;


      sceneDescription.textContent =
        scene.description ||
        scene.caption ||
        "";


      sceneLocation.textContent =
        [
          scene.category ||
            "Resort",

          scene.location ||
            "Immersive panorama"

        ]
          .filter(Boolean)
          .join(
            " · "
          );


      sceneCount.textContent =
        `${currentIndex + 1} / ${
          scenes.length
        }`;


      updateCameraReadout();


      updateCompass();


      const connections =
        getSceneConnections(
          currentIndex
        );


      previousBtn.disabled =
        scenes.length <=
        1;


      nextBtn.disabled =
        scenes.length <=
        1;


      const infoCount =
        Array.isArray(
          scene.hotspots
        )
          ? scene.hotspots.length
          : 0;


      infoBtn.classList.toggle(
        "is-active",
        infoCount >
        0
      );


      locationsBtn.classList.remove(
        "is-active"
      );


      mapBtn.classList.toggle(
        "is-active",
        drawerOpen &&
        document
          .querySelector(
            '[data-drawer-tab="map"].is-active'
          )
      );


      /*
       * If there are no legacy next/previous scenes, we still keep
       * the dock buttons useful by moving through scene order.
       */
      previousBtn.title =
        connections.some(
          item =>
            item.direction ===
            "backward"
        )
          ? "Move backward"
          : "Previous scene";


      nextBtn.title =
        connections.some(
          item =>
            item.direction ===
            "forward"
        )
          ? "Move forward"
          : "Next scene";

    }


    /* ============================================================
       ORDER NAVIGATION FALLBACK
    ============================================================ */

    function adjacentScene(
      amount
    ) {

      if (
        !scenes.length
      ) {

        return -1;
      }


      let next =
        currentIndex +
        amount;


      if (
        next <
        0
      ) {

        next =
          scenes.length -
          1;

      } else if (
        next >=
        scenes.length
      ) {

        next =
          0;
      }


      return next;

    }


    function navigateDirection(
      direction
    ) {

      const connections =
        getSceneConnections(
          currentIndex
        );


      const direct =
        connections.find(
          connection =>
            connection.direction ===
            direction
        );


      if (
        direct
      ) {

        travelToScene(
          direct.target,
          {
            source:
              currentIndex,

            yaw:
              connectionYaw(
                currentIndex,
                direct.target,
                direction
              ),

            reason:
              "direction"
          }
        );


        return;
      }


      /*
       * If the directional graph has no explicit link,
       * retain a useful scene-order fallback.
       */
      const fallback =
        direction ===
          "forward" ||
        direction ===
          "right"
          ? 1
          : -1;


      const target =
        adjacentScene(
          fallback
        );


      if (
        target >=
        0
      ) {

        travelToScene(
          target,
          {
            source:
              currentIndex,

            yaw:
              directionFallbackYaw(
                direction
              ),

            reason:
              "adjacent"
          }
        );

      }

    }


    /* ============================================================
       LOCATIONS DRAWER
    ============================================================ */

    function renderLocations(
      filter = ""
    ) {

      if (
        !locationList
      ) {
        return;
      }


      const query =
        String(
          filter ||
          ""
        )
          .trim()
          .toLowerCase();


      const entries =
        scenes
          .map(
            (
              scene,
              index
            ) => ({
              scene,
              index
            })
          )
          .filter(
            entry => {

              if (
                !query
              ) {

                return true;
              }


              const haystack =
                [
                  entry.scene?.title,
                  entry.scene?.category,
                  entry.scene?.location,
                  entry.scene?.description,
                  ...(Array.isArray(
                    entry.scene?.tags
                  )
                    ? entry.scene.tags
                    : [])
                ]
                  .filter(Boolean)
                  .join(
                    " "
                  )
                  .toLowerCase();


              return haystack.includes(
                query
              );

            }
          );


      if (
        !entries.length
      ) {

        locationList.innerHTML =
          `
            <div
              style="
                padding:18px;
                border:1px dashed rgba(255,255,255,.11);
                border-radius:13px;
                color:rgba(255,255,255,.45);
                font-size:.56rem;
                text-align:center;
              "
            >
              No resort locations match your search.
            </div>
          `;

        return;
      }


      locationList.innerHTML =
        "";


      entries.forEach(
        entry => {

          const card =
            document.createElement(
              "button"
            );


          card.type =
            "button";


          card.className =
            "pi-location-card";


          if (
            entry.index ===
            currentIndex
          ) {

            card.classList.add(
              "is-current"
            );
          }


          const thumb =
            document.createElement(
              "span"
            );


          thumb.className =
            "pi-location-thumb";


          const image =
            document.createElement(
              "img"
            );


          image.src =
            entry.scene?.thumbnail ||
            entry.scene?.image ||
            "";


          image.alt =
            entry.scene?.title ||
            `Scene ${
              entry.index + 1
            }`;


          image.loading =
            "lazy";


          thumb.appendChild(
            image
          );


          const copy =
            document.createElement(
              "span"
            );


          copy.className =
            "pi-location-copy";


          const title =
            document.createElement(
              "strong"
            );


          title.textContent =
            entry.scene?.title ||
            `Scene ${
              entry.index + 1
            }`;


          const meta =
            document.createElement(
              "span"
            );


          meta.textContent =
            [
              entry.scene?.category ||
                "Resort",

              entry.scene?.location ||
                "360° view"

            ]
              .filter(Boolean)
              .join(
                " · "
              );


          copy.appendChild(
            title
          );


          copy.appendChild(
            meta
          );


          const arrow =
            document.createElement(
              "span"
            );


          arrow.className =
            "pi-location-arrow";


          arrow.innerHTML =
            entry.index ===
            currentIndex
              ? '<i class="fa-solid fa-location-crosshairs"></i>'
              : '<i class="fa-solid fa-arrow-right"></i>';


          card.appendChild(
            thumb
          );


          card.appendChild(
            copy
          );


          card.appendChild(
            arrow
          );


          card.addEventListener(
            "click",
            () => {

              if (
                entry.index !==
                currentIndex
              ) {

                travelToScene(
                  entry.index,
                  {
                    source:
                      currentIndex,

                    yaw:
                      getCameraYaw(),

                    reason:
                      "location"
                  }
                );

              }


              closeDrawer();

            }
          );


          locationList.appendChild(
            card
          );

        }
      );

    }


    /* ============================================================
       MAP POSITION
    ============================================================ */

    function autoMapPosition(
      index
    ) {

      const count =
        Math.max(
          scenes.length,
          1
        );


      if (
        count ===
        1
      ) {

        return {
          x:
            0.5,

          y:
            0.5

        };
      }


      const angle =
        (
          Math.PI *
          2 *
          index
        ) /
        count;


      const radius =
        0.33;


      return {

        x:
          0.5 +
          Math.cos(
            angle
          ) *
          radius,

        y:
          0.5 +
          Math.sin(
            angle
          ) *
          radius

      };

    }


    function getMapPosition(
      index
    ) {

      const scene =
        scenes[
          index
        ];


      if (
        hasMapPosition(
          scene
        )
      ) {

        return {

          x:
            clamp(
              Number(
                scene.mapPosition.x
              ),
              0,
              1
            ),

          y:
            clamp(
              Number(
                scene.mapPosition.y
              ),
              0,
              1
            )

        };

      }


      return autoMapPosition(
        index
      );

    }


    function uniqueMapEdges() {

      const seen =
        new Set();


      const edges =
        [];


      scenes.forEach(
        (
          scene,
          index
        ) => {

          [
            "left",
            "right",
            "forward",
            "backward"
          ]
            .forEach(
              direction => {

                const target =
                  Number(
                    scene?.[
                      direction
                    ]
                  );


                if (
                  !Number.isInteger(
                    target
                  ) ||
                  target <
                    0 ||
                  target >=
                    scenes.length ||
                  target ===
                    index
                ) {

                  return;
                }


                const a =
                  Math.min(
                    index,
                    target
                  );


                const b =
                  Math.max(
                    index,
                    target
                  );


                const key =
                  `${a}-${b}`;


                if (
                  seen.has(
                    key
                  )
                ) {

                  return;
                }


                seen.add(
                  key
                );


                edges.push({
                  a,
                  b
                });

              }
            );

        }
      );


      return edges;

    }


    function renderMap() {

      if (
        !mapSvg
      ) {
        return;
      }


      mapSvg.innerHTML =
        "";


      if (
        mapBackground
      ) {

        if (
          mapSettings.image
        ) {

          mapBackground.style.backgroundImage =
            `url("${
              mapSettings.image
            }")`;

        } else {

          mapBackground.style.backgroundImage =
            "";

        }

      }


      if (
        !mapSettings.enabled
      ) {

        return;
      }


      /*
       * Edges first.
       */
      uniqueMapEdges().forEach(
        edge => {

          const a =
            getMapPosition(
              edge.a
            );


          const b =
            getMapPosition(
              edge.b
            );


          const line =
            document.createElementNS(
              "http://www.w3.org/2000/svg",
              "line"
            );


          line.setAttribute(
            "x1",
            String(
              a.x *
              100
            )
          );


          line.setAttribute(
            "y1",
            String(
              a.y *
              100
            )
          );


          line.setAttribute(
            "x2",
            String(
              b.x *
              100
            )
          );


          line.setAttribute(
            "y2",
            String(
              b.y *
              100
            )
          );


          line.setAttribute(
            "stroke",
            "rgba(255,255,255,.18)"
          );


          line.setAttribute(
            "stroke-width",
            "0.45"
          );


          line.setAttribute(
            "stroke-linecap",
            "round"
          );


          line.setAttribute(
            "stroke-dasharray",
            "1.1 1.0"
          );


          mapSvg.appendChild(
            line
          );

        }
      );


      /*
       * Nodes.
       */
      scenes.forEach(
        (
          scene,
          index
        ) => {

          const position =
            getMapPosition(
              index
            );


          const group =
            document.createElementNS(
              "http://www.w3.org/2000/svg",
              "g"
            );


          group.classList.add(
            "pi-map-node"
          );


          group.setAttribute(
            "transform",
            `translate(${
              position.x *
              100
            } ${
              position.y *
              100
            })`
          );


          group.addEventListener(
            "click",
            () => {

              if (
                index !==
                currentIndex
              ) {

                travelToScene(
                  index,
                  {
                    source:
                      currentIndex,

                    yaw:
                      getCameraYaw(),

                    reason:
                      "map"
                  }
                );

              }


              closeDrawer();

            }
          );


          const pulse =
            document.createElementNS(
              "http://www.w3.org/2000/svg",
              "circle"
            );


          pulse.setAttribute(
            "cx",
            "0"
          );


          pulse.setAttribute(
            "cy",
            "0"
          );


          pulse.setAttribute(
            "r",
            index ===
            currentIndex
              ? "3.2"
              : "2.4"
          );


          pulse.setAttribute(
            "fill",
            index ===
            currentIndex
              ? "rgba(255,216,74,.18)"
              : "rgba(27,209,197,.10)"
          );


          group.appendChild(
            pulse
          );


          const circle =
            document.createElementNS(
              "http://www.w3.org/2000/svg",
              "circle"
            );


          circle.classList.add(
            "pi-map-node-circle"
          );


          if (
            index ===
            currentIndex
          ) {

            circle.classList.add(
              "current"
            );

          }


          circle.setAttribute(
            "cx",
            "0"
          );


          circle.setAttribute(
            "cy",
            "0"
          );


          circle.setAttribute(
            "r",
            index ===
            currentIndex
              ? "2.1"
              : "1.65"
          );


          circle.setAttribute(
            "fill",
            index ===
            currentIndex
              ? "#ffd84a"
              : "#1bd1c5"
          );


          group.appendChild(
            circle
          );


          const text =
            document.createElementNS(
              "http://www.w3.org/2000/svg",
              "text"
            );


          text.classList.add(
            "pi-map-node-text"
          );


          text.setAttribute(
            "x",
            "4.1"
          );


          text.setAttribute(
            "y",
            "1.2"
          );


          text.textContent =
            scene?.title ||
            `Scene ${
              index + 1
            }`;


          group.appendChild(
            text
          );


          mapSvg.appendChild(
            group
          );

        }
      );

    }


    /* ============================================================
       DRAWER
    ============================================================ */

    function openDrawer(
      tab = "locations"
    ) {

      drawerOpen =
        true;


      drawer.classList.add(
        "is-open"
      );


      drawerBackdrop.classList.add(
        "is-open"
      );


      drawer.setAttribute(
        "aria-hidden",
        "false"
      );


      activateDrawerTab(
        tab
      );


      renderLocations(
        locationSearch?.value ||
        ""
      );


      renderMap();


      locationsBtn.classList.toggle(
        "is-active",
        tab ===
        "locations"
      );


      mapBtn.classList.toggle(
        "is-active",
        tab ===
        "map"
      );

    }


    function closeDrawer() {

      drawerOpen =
        false;


      drawer.classList.remove(
        "is-open"
      );


      drawerBackdrop.classList.remove(
        "is-open"
      );


      drawer.setAttribute(
        "aria-hidden",
        "true"
      );


      locationsBtn.classList.remove(
        "is-active"
      );


      mapBtn.classList.remove(
        "is-active"
      );

    }


    function activateDrawerTab(
      tab
    ) {

      document
        .querySelectorAll(
          "[data-drawer-tab]"
        )
        .forEach(
          button => {

            button.classList.toggle(
              "is-active",
              button.dataset.drawerTab ===
                tab
            );

          }
        );


      document
        .querySelectorAll(
          "[data-drawer-panel]"
        )
        .forEach(
          panel => {

            panel.style.display =
              panel.dataset.drawerPanel ===
              tab
                ? ""
                : "none";

          }
        );

    }


    /* ============================================================
       INFO HOTSPOTS
    ============================================================ */

    function showHotspotInfo(
      hotspot
    ) {

      infoHotspot =
        hotspot;


      infoTitle.textContent =
        hotspot?.title ||
        "Explore this location";


      infoDescription.textContent =
        hotspot?.description ||
        "Discover more about this part of Puffer Isle.";


      infoActions.innerHTML =
        "";


      const target =
        Number(
          hotspot?.targetIndex ??
          hotspot?.target
        );


      if (
        Number.isInteger(
          target
        ) &&
        target >=
        0 &&
        target <
        scenes.length &&
        target !==
        currentIndex
      ) {

        const travelButton =
          document.createElement(
            "button"
          );


        travelButton.type =
          "button";


        travelButton.className =
          "pi-info-btn primary";


        travelButton.innerHTML =
          '<i class="fa-solid fa-arrow-right"></i> Continue to destination';


        travelButton.addEventListener(
          "click",
          () => {

            closeInfo();


            travelToScene(
              target,
              {
                source:
                  currentIndex,

                yaw:
                  Number(
                    hotspot.yaw
                  ) || getCameraYaw(),

                reason:
                  "info-hotspot"
              }
            );

          }
        );


        infoActions.appendChild(
          travelButton
        );

      }


      if (
        String(
          hotspot?.action ||
          ""
        ).toLowerCase() ===
        "open-url" &&
        hotspot?.url
      ) {

        const externalButton =
          document.createElement(
            "button"
          );


        externalButton.type =
          "button";


        externalButton.className =
          "pi-info-btn";


        externalButton.innerHTML =
          '<i class="fa-solid fa-arrow-up-right-from-square"></i> Open';


        externalButton.addEventListener(
          "click",
          () => {

            openExternalUrl(
              hotspot.url
            );

          }
        );


        infoActions.appendChild(
          externalButton
        );

      }


      infoLayer.classList.add(
        "is-open"
      );


      infoLayer.setAttribute(
        "aria-hidden",
        "false"
      );


      setUiIdle(
        false
      );

    }


    function closeInfo() {

      infoLayer.classList.remove(
        "is-open"
      );


      infoLayer.setAttribute(
        "aria-hidden",
        "true"
      );


      infoHotspot =
        null;

    }


    function showCurrentSceneInfo() {

      const scene =
        scenes[
          currentIndex
        ];


      if (
        !scene
      ) {
        return;
      }


      showHotspotInfo(
        {
          title:
            scene.title,

          description:
            scene.description ||
            scene.caption ||
            `Explore ${
              scene.title ||
              "Puffer Isle Resort"
            } in immersive 360°.`,

          targetIndex:
            null,

          action:
            "info"
        }
      );

    }


    function openExternalUrl(
      rawUrl
    ) {

      const input =
        String(
          rawUrl ||
          ""
        ).trim();


      if (
        !input
      ) {

        return;
      }


      try {

        const url =
          new URL(
            input,
            window.location.href
          );


        if (
          url.protocol !==
            "http:" &&
          url.protocol !==
            "https:"
        ) {

          showToast(
            "That link is not available."
          );

          return;
        }


        window.open(
          url.href,
          "_blank",
          "noopener,noreferrer"
        );

      } catch (
        error
      ) {

        console.warn(
          "External URL blocked:",
          error
        );


        showToast(
          "That link could not be opened."
        );

      }

    }


    /* ============================================================
       LOADER
    ============================================================ */

    function showLoader(
      title,
      message
    ) {

      loaderTitle.textContent =
        title ||
        "Preparing your view";


      loaderMessage.textContent =
        message ||
        "Loading the immersive panorama...";


      loader.classList.remove(
        "is-hidden"
      );

    }


    function hideLoader() {

      loader.classList.add(
        "is-hidden"
      );

    }


    /* ============================================================
       ERROR
    ============================================================ */

    function showError(
      message
    ) {

      errorMessage.textContent =
        message ||
        "Please try the scene again.";


      errorLayer.classList.add(
        "is-visible"
      );

    }


    function hideError() {

      errorLayer.classList.remove(
        "is-visible"
      );

    }


    /* ============================================================
       TOAST
    ============================================================ */

    function showToast(
      message
    ) {

      if (
        !toast
      ) {
        return;
      }


      window.clearTimeout(
        toastTimer
      );


      toast.textContent =
        message ||
        "";


      toast.classList.add(
        "is-visible"
      );


      toastTimer =
        window.setTimeout(
          () => {

            toast.classList.remove(
              "is-visible"
            );

          },
          1900
        );

    }


    /* ============================================================
       IDLE UI
    ============================================================ */

    function setUiIdle(
      idle
    ) {

      viewer.classList.toggle(
        "is-idle",
        Boolean(
          idle
        )
      );

    }


    function startUiIdleTimer() {

      window.clearTimeout(
        uiIdleTimer
      );


      setUiIdle(
        false
      );


      uiIdleTimer =
        window.setTimeout(
          () => {

            if (
              !drawerOpen &&
              !infoLayer.classList.contains(
                "is-open"
              ) &&
              !isTransitioning
            ) {

              setUiIdle(
                true
              );

            }

          },
          4200
        );

    }


    function scheduleUiIdle() {

      startUiIdleTimer();

    }


    /* ============================================================
       SHARE
    ============================================================ */

    async function shareScene() {

      if (
        !tourSettings.allowSharing
      ) {

        showToast(
          "Scene sharing is disabled."
        );

        return;
      }


      updateSceneUrl(
        currentIndex,
        true
      );


      const url =
        window.location.href;


      const scene =
        scenes[
          currentIndex
        ];


      const shareData = {

        title:
          `${
            scene?.title ||
            "Puffer Isle"
          } · Puffer Isle Resort`,

        text:
          `Explore ${
            scene?.title ||
            "Puffer Isle Resort"
          } in immersive 360°.`,

        url

      };


      try {

        if (
          navigator.share
        ) {

          await navigator.share(
            shareData
          );

          return;
        }


        if (
          navigator.clipboard
        ) {

          await navigator.clipboard.writeText(
            url
          );


          showToast(
            "Scene link copied"
          );


          return;
        }


        showToast(
          "Copy the scene URL from your browser."
        );

      } catch (
        error
      ) {

        if (
          error?.name !==
          "AbortError"
        ) {

          console.warn(
            "Share failed:",
            error
          );

          showToast(
            "Scene link ready to share."
          );

        }

      }

    }


    /* ============================================================
       FULLSCREEN
    ============================================================ */

    async function toggleFullscreen() {

      try {

        if (
          !document.fullscreenElement
        ) {

          if (
            viewer.requestFullscreen
          ) {

            await viewer.requestFullscreen();

          } else if (
            tourShell.requestFullscreen
          ) {

            await tourShell.requestFullscreen();

          }

        } else {

          await document.exitFullscreen();

        }

      } catch (
        error
      ) {

        console.warn(
          "Fullscreen unavailable:",
          error
        );

      }

    }


    function updateFullscreenIcon() {

      const icon =
        fullscreenBtn?.querySelector(
          "i"
        );


      if (
        !icon
      ) {
        return;
      }


      icon.className =
        document.fullscreenElement
          ? "fa-solid fa-compress"
          : "fa-solid fa-expand";

    }


    /* ============================================================
       DEVICE MOTION
    ============================================================ */

    async function enableMotion() {

      if (
        !viewerSettings.motionEnabled
      ) {

        showToast(
          "Motion controls are disabled."
        );

        return;
      }


      try {

        /*
         * iOS-style permission.
         */
        if (
          typeof DeviceOrientationEvent !==
            "undefined" &&
          typeof DeviceOrientationEvent.requestPermission ===
            "function"
        ) {

          const permission =
            await DeviceOrientationEvent.requestPermission();


          if (
            permission !==
            "granted"
          ) {

            showToast(
              "Motion permission was not granted."
            );

            return;
          }

        }


        /*
         * A-Frame look-controls can begin using the browser's
         * device orientation after the permission is granted.
         */
        studioMotionEnabled =
          true;


        motionBtn.classList.add(
          "is-active"
        );


        showToast(
          "Move your device to look around"
        );

      } catch (
        error
      ) {

        console.warn(
          "Device motion permission failed:",
          error
        );


        showToast(
          "Motion controls are unavailable on this device."
        );

      }

    }


    /* ============================================================
       TOUCH / DOUBLE-TAP / DOUBLE-CLICK TRAVEL
    ============================================================ */

    function directionFromScreenPoint(
      clientX,
      clientY
    ) {

      const canvas =
        sceneEl?.canvas;


      if (
        !canvas
      ) {

        return null;
      }


      const rect =
        canvas.getBoundingClientRect();


      if (
        !rect.width ||
        !rect.height
      ) {

        return null;
      }


      const nx =
        (
          clientX -
          rect.left
        ) /
        rect.width;


      const ny =
        (
          clientY -
          rect.top
        ) /
        rect.height;


      /*
       * Very simple Street View-like interaction:
       *
       * top center    = forward
       * bottom center = backward
       * left side     = left
       * right side    = right
       */
      if (
        nx <
        0.34
      ) {

        return "left";
      }


      if (
        nx >
        0.66
      ) {

        return "right";
      }


      if (
        ny <
        0.48
      ) {

        return "forward";
      }


      return "backward";

    }


    function handleDoubleTap(
      event
    ) {

      if (
        !viewerSettings.touchEnabled &&
        event.pointerType ===
          "touch"
      ) {

        return;
      }


      if (
        isTransitioning
      ) {

        return;
      }


      /*
       * Do not treat an actual hotspot click as a blank-panorama
       * double click.
       */
      if (
        event.target &&
        event.target.closest &&
        event.target.closest(
          ".pi-hotspot-hit"
        )
      ) {

        return;
      }


      const now =
        performance.now();


      const x =
        event.clientX;


      const y =
        event.clientY;


      const timeDelta =
        now -
        lastPointerUpAt;


      const distance =
        Math.hypot(
          x -
            lastPointerUpX,
          y -
            lastPointerUpY
        );


      if (
        timeDelta <
          340 &&
        distance <
          42
      ) {

        const direction =
          directionFromScreenPoint(
            x,
            y
          );


        if (
          direction
        ) {

          navigateDirection(
            direction
          );

        }


        lastPointerUpAt =
          0;


        return;

      }


      lastPointerUpAt =
        now;


      lastPointerUpX =
        x;


      lastPointerUpY =
        y;

    }


    viewer.addEventListener(
      "pointerdown",
      event => {

        pointerDown =
          true;


        pointerMoved =
          false;


        pointerStartX =
          event.clientX;


        pointerStartY =
          event.clientY;


        viewer.classList.add(
          "is-dragging"
        );


        scheduleUiIdle();

      },
      {
        passive:
          true
      }
    );


    viewer.addEventListener(
      "pointermove",
      event => {

        if (
          !pointerDown
        ) {
          return;
        }


        const distance =
          Math.hypot(
            event.clientX -
              pointerStartX,

            event.clientY -
              pointerStartY
          );


        if (
          distance >
          7
        ) {

          pointerMoved =
            true;

        }

        scheduleUiIdle();

      },
      {
        passive:
          true
      }
    );


    viewer.addEventListener(
      "pointerup",
      event => {

        pointerDown =
          false;


        viewer.classList.remove(
          "is-dragging"
        );


        if (
          !pointerMoved
        ) {

          handleDoubleTap(
            event
          );

        }


        scheduleUiIdle();

      },
      {
        passive:
          true
      }
    );


    viewer.addEventListener(
      "pointercancel",
      () => {

        pointerDown =
          false;


        pointerMoved =
          true;


        viewer.classList.remove(
          "is-dragging"
        );

      },
      {
        passive:
          true
      }
    );


    viewer.addEventListener(
      "dblclick",
      event => {

        if (
          event.target &&
          event.target.closest &&
          event.target.closest(
            ".pi-hotspot-hit"
          )
        ) {

          return;
        }


        const direction =
          directionFromScreenPoint(
            event.clientX,
            event.clientY
          );


        if (
          direction
        ) {

          navigateDirection(
            direction
          );

        }

      }
    );


    /* ============================================================
       MOUSE WHEEL
    ============================================================ */

    viewer.addEventListener(
      "wheel",
      event => {

        if (
          !viewerSettings.mouseEnabled
        ) {

          return;
        }


        event.preventDefault();


        if (
          event.deltaY <
          0
        ) {

          zoomIn();

        } else {

          zoomOut();

        }

      },
      {
        passive:
          false
      }
    );


    /* ============================================================
       KEYBOARD
    ============================================================ */

    document.addEventListener(
      "keydown",
      event => {

        if (
          drawerOpen ||
          infoLayer.classList.contains(
            "is-open"
          )
        ) {

          if (
            event.key ===
            "Escape"
          ) {

            closeDrawer();

            closeInfo();

          }

          return;

        }


        switch (
          event.key
        ) {

          case "ArrowUp":
          case "w":
          case "W":
            event.preventDefault();

            navigateDirection(
              "forward"
            );

            break;


          case "ArrowDown":
          case "s":
          case "S":
            event.preventDefault();

            navigateDirection(
              "backward"
            );

            break;


          case "ArrowLeft":
          case "a":
          case "A":
            event.preventDefault();

            navigateDirection(
              "left"
            );

            break;


          case "ArrowRight":
          case "d":
          case "D":
            event.preventDefault();

            navigateDirection(
              "right"
            );

            break;


          case "+":
          case "=":
            event.preventDefault();

            zoomIn();

            break;


          case "-":
          case "_":
            event.preventDefault();

            zoomOut();

            break;


          case "r":
          case "R":
            event.preventDefault();

            resetCameraView();

            break;


          case "m":
          case "M":
            event.preventDefault();

            openDrawer(
              "locations"
            );

            break;


          case "f":
          case "F":
            event.preventDefault();

            toggleFullscreen();

            break;


          case "Escape":
            closeDrawer();

            closeInfo();

            break;

        }

      }
    );


    /* ============================================================
       BUTTON EVENTS
    ============================================================ */

    locationsBtn?.addEventListener(
      "click",
      () => {

        if (
          drawerOpen
        ) {

          closeDrawer();

          return;
        }


        openDrawer(
          "locations"
        );

      }
    );


    mapBtn?.addEventListener(
      "click",
      () => {

        if (
          drawerOpen
        ) {

          const activeTab =
            document.querySelector(
              '[data-drawer-tab].is-active'
            )?.dataset?.drawerTab;


          if (
            activeTab ===
            "map"
          ) {

            closeDrawer();

            return;

          }

        }


        openDrawer(
          "map"
        );

      }
    );


    drawerClose?.addEventListener(
      "click",
      closeDrawer
    );


    drawerBackdrop?.addEventListener(
      "click",
      closeDrawer
    );


    document
      .querySelectorAll(
        "[data-drawer-tab]"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            () => {

              activateDrawerTab(
                button.dataset.drawerTab
              );


              if (
                button.dataset.drawerTab ===
                "locations"
              ) {

                locationsBtn.classList.add(
                  "is-active"
                );

                mapBtn.classList.remove(
                  "is-active"
                );

              } else {

                locationsBtn.classList.remove(
                  "is-active"
                );

                mapBtn.classList.add(
                  "is-active"
                );

              }

            }
          );

        }
      );


    locationSearch?.addEventListener(
      "input",
      () => {

        renderLocations(
          locationSearch.value
        );

      }
    );


    motionBtn?.addEventListener(
      "click",
      enableMotion
    );


    shareBtn?.addEventListener(
      "click",
      shareScene
    );


    fullscreenBtn?.addEventListener(
      "click",
      toggleFullscreen
    );


    resetViewBtn?.addEventListener(
      "click",
      resetCameraView
    );


    zoomInBtn?.addEventListener(
      "click",
      zoomIn
    );


    zoomOutBtn?.addEventListener(
      "click",
      zoomOut
    );


    previousBtn?.addEventListener(
      "click",
      () => {

        const backward =
          getSceneConnections(
            currentIndex
          ).find(
            item =>
              item.direction ===
              "backward"
          );


        if (
          backward
        ) {

          travelToScene(
            backward.target,
            {
              source:
                currentIndex,

              yaw:
                connectionYaw(
                  currentIndex,
                  backward.target,
                  "backward"
                ),

              reason:
                "dock"
            }
          );

        } else {

          travelToScene(
            adjacentScene(
              -1
            ),
            {
              source:
                currentIndex,

              yaw:
                -180,

              reason:
                "dock"
            }
          );

        }

      }
    );


    nextBtn?.addEventListener(
      "click",
      () => {

        const forward =
          getSceneConnections(
            currentIndex
          ).find(
            item =>
              item.direction ===
              "forward"
          );


        if (
          forward
        ) {

          travelToScene(
            forward.target,
            {
              source:
                currentIndex,

              yaw:
                connectionYaw(
                  currentIndex,
                  forward.target,
                  "forward"
                ),

              reason:
                "dock"
            }
          );

        } else {

          travelToScene(
            adjacentScene(
              1
            ),
            {
              source:
                currentIndex,

              yaw:
                0,

              reason:
                "dock"
            }
          );

        }

      }
    );


    infoBtn?.addEventListener(
      "click",
      showCurrentSceneInfo
    );


    infoClose?.addEventListener(
      "click",
      closeInfo
    );


    infoLayer?.addEventListener(
      "click",
      event => {

        if (
          event.target ===
          infoLayer
        ) {

          closeInfo();

        }

      }
    );


    retryBtn?.addEventListener(
      "click",
      () => {

        hideError();


        if (
          currentIndex >=
          0
        ) {

          loadSceneAfterError(
            currentIndex
          );

        }

      }
    );


    fullscreenChangeHandler:
    document.addEventListener(
      "fullscreenchange",
      updateFullscreenIcon
    );


    /* ============================================================
       ERROR RETRY
    ============================================================ */

    async function loadSceneAfterError(
      index
    ) {

      const scene =
        scenes[
          index
        ];


      if (
        !scene?.image
      ) {

        showError(
          "That scene has no valid panorama image."
        );

        return;
      }


      showLoader(
        scene.title ||
          "Reloading scene",

        "Reconnecting to the panorama..."
      );


      try {

        await preloadImage(
          `${scene.image}${
            scene.image.includes(
              "?"
            )
              ? "&"
              : "?"
          }retry=${
            Date.now()
          }`
        ).catch(
          async () => {

            await preloadImage(
              scene.image
            );

          }
        );


        const currentSky =
          activeSky ===
          "A"
            ? skyA
            : skyB;


        currentSky.setAttribute(
          "src",
          scene.image
        );


        await waitForSkyReady(
          currentSky
        );


        setSkyOpacity(
          currentSky,
          1
        );


        const pose =
          sceneStartPose(
            scene
          );


        setCameraPose(
          pose.yaw,
          pose.pitch,
          pose.fov
        );


        updateSceneUi();

        renderWorldHotspots();

        preloadConnectedScenes(
          index
        );


        hideLoader();


      } catch (
        error
      ) {

        console.error(
          "Retry failed:",
          error
        );


        hideLoader();


        showError(
          "The panorama is still unavailable."
        );

      }

    }


    /* ============================================================
       HISTORY
    ============================================================ */

    window.addEventListener(
      "popstate",
      async () => {

        if (
          isTransitioning
        ) {

          return;
        }


        const target =
          resolveInitialScene();


        if (
          target ===
          currentIndex
        ) {

          return;
        }


        await travelToScene(
          target,
          {
            source:
              currentIndex,

            yaw:
              getCameraYaw(),

            reason:
              "history",

            fromHistory:
              true
          }
        );

      }
    );


    /* ============================================================
       CAMERA HUD LOOP
    ============================================================ */

    function cameraHudLoop() {

      if (
        !isTransitioning
      ) {

        updateCameraReadout();

      }


      requestAnimationFrame(
        cameraHudLoop
      );

    }


    cameraHudLoop();


    /* ============================================================
       MOUSE INTERACTION
    ============================================================ */

    viewer.addEventListener(
      "mousemove",
      scheduleUiIdle,
      {
        passive:
          true
      }
    );


    viewer.addEventListener(
      "mouseenter",
      scheduleUiIdle,
      {
        passive:
          true
      }
    );


    /* ============================================================
       A-FRAME CLICK BRIDGE
    ============================================================ */

    /*
     * Prevent a clicked 3D hotspot from behaving like a blank
     * canvas click. A-Frame's event system handles the hotspot,
     * while the DOM layer handles general movement.
     */
    if (
      worldHotspots
    ) {

      worldHotspots.addEventListener(
        "click",
        event => {

          event.stopPropagation();

        }
      );

    }


    /* ============================================================
       SCENE LOADED
    ============================================================ */

    sceneEl?.addEventListener(
      "loaded",
      () => {

        setTimeout(
          () => {

            bindCanvasIfNeeded();

          },
          80
        );

      },
      {
        once:
          true
      }
    );


    function bindCanvasIfNeeded() {

      const canvas =
        sceneEl?.canvas;


      if (
        !canvas
      ) {

        return;
      }


      if (
        canvas.dataset.piReady ===
        "true"
      ) {

        return;
      }


      canvas.dataset.piReady =
        "true";

    }


    /* ============================================================
       RESIZE
    ============================================================ */

    window.addEventListener(
      "resize",
      () => {

        updateCameraReadout();

        renderMap();

      },
      {
        passive:
          true
      }
    );


    /* ============================================================
       CLICK OUTSIDE INFO
    ============================================================ */

    document.addEventListener(
      "click",
      event => {

        if (
          infoLayer.classList.contains(
            "is-open"
          ) &&
          event.target ===
          infoLayer
        ) {

          closeInfo();

        }

      }
    );


    /* ============================================================
       FULLSCREEN
    ============================================================ */

    updateFullscreenIcon();


    /* ============================================================
       INITIAL STATE
    ============================================================ */

    if (
      !scenes.length
    ) {

      emptyLayer.classList.add(
        "is-visible"
      );

      hideLoader();

    } else {

      loadInitialScene();

    }


  </script>


</body>

</html>