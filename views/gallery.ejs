    /* ============================================================
       MATH
    ============================================================ */

    function clamp(
      value,
      min,
      max
    ) {

      const parsed =
        Number(
          value
        );

      if (
        !Number.isFinite(
          parsed
        )
      ) {

        return min;
      }

      return Math.min(
        max,
        Math.max(
          min,
          parsed
        )
      );
    }


    function normalizeYaw(
      value
    ) {

      let yaw =
        Number(
          value
        );


      if (
        !Number.isFinite(
          yaw
        )
      ) {

        yaw = 0;
      }


      while (
        yaw >
        180
      ) {

        yaw -=
          360;
      }


      while (
        yaw <
        -180
      ) {

        yaw +=
          360;
      }


      return yaw;
    }


    function degreesToRadians(
      degrees
    ) {

      return (
        Number(
          degrees
        ) ||
        0
      ) *
      Math.PI /
      180;
    }


    function radiansToDegrees(
      radians
    ) {

      return (
        Number(
          radians
        ) ||
        0
      ) *
      180 /
      Math.PI;
    }


    function hasFinite(
      value
    ) {

      return (
        value !==
          null &&
        value !==
          undefined &&
        value !==
          "" &&
        Number.isFinite(
          Number(
            value
          )
        )
      );
    }


    function has3DPosition(
      scene
    ) {

      return Boolean(
        scene &&
        hasFinite(
          scene.position?.x
        ) &&
        hasFinite(
          scene.position?.y
        ) &&
        hasFinite(
          scene.position?.z
        )
      );
    }


    function hasMapPosition(
      scene
    ) {

      return Boolean(
        scene &&
        hasFinite(
          scene.mapPosition?.x
        ) &&
        hasFinite(
          scene.mapPosition?.y
        )
      );
    }


    /* ============================================================
       INITIAL SCENE
    ============================================================ */

    function resolveInitialScene() {

      if (
        !scenes.length
      ) {

        return 0;
      }


      try {

        const url =
          new URL(
            window.location.href
          );


        const param =
          url.searchParams.get(
            "scene"
          );


        if (
          param
        ) {

          const numeric =
            Number(
              param
            );


          if (
            Number.isInteger(
              numeric
            ) &&
            numeric >= 1 &&
            numeric <=
              scenes.length
          ) {

            return (
              numeric -
              1
            );
          }


          const normalized =
            String(
              param
            )
              .trim()
              .toLowerCase();


          const slugIndex =
            scenes.findIndex(
              scene =>
                String(
                  scene?.slug ||
                  ""
                )
                  .trim()
                  .toLowerCase() ===
                normalized
            );


          if (
            slugIndex >=
            0
          ) {

            return slugIndex;
          }


          const idIndex =
            scenes.findIndex(
              scene =>
                String(
                  scene?._id ||
                  ""
                ) ===
                String(
                  param
                )
            );


          if (
            idIndex >=
            0
          ) {

            return idIndex;
          }

        }


        const hash =
          String(
            window.location.hash ||
            ""
          );


        const match =
          hash.match(
            /scene[-_ ]?(\d+)/i
          );


        if (
          match
        ) {

          const numeric =
            Number(
              match[1]
            );


          if (
            Number.isInteger(
              numeric
            ) &&
            numeric >= 1 &&
            numeric <=
              scenes.length
          ) {

            return (
              numeric -
              1
            );
          }

        }

      } catch (
        error
      ) {

        console.warn(
          "Scene URL could not be read:",
          error
        );

      }


      const configuredStart =
        Number(
          tourSettings.startScene
        );


      if (
        Number.isInteger(
          configuredStart
        ) &&
        configuredStart >=
          0 &&
        configuredStart <
          scenes.length
      ) {

        return configuredStart;
      }


      return 0;
    }


    /* ============================================================
       URL STATE
    ============================================================ */

    function getSceneUrlValue(
      index
    ) {

      const scene =
        scenes[
          index
        ];


      if (
        scene?.slug
      ) {

        return String(
          scene.slug
        );
      }


      return String(
        index + 1
      );
    }


    function updateSceneUrl(
      index,
      replace = false
    ) {

      try {

        const url =
          new URL(
            window.location.href
          );


        url.searchParams.set(
          "scene",
          getSceneUrlValue(
            index
          )
        );


        url.hash =
          "";


        const method =
          replace
            ? "replaceState"
            : "pushState";


        window.history[
          method
        ](
          {
            scene:
              index
          },
          "",
          url.toString()
        );

      } catch (
        error
      ) {

        console.warn(
          "Scene URL update failed:",
          error
        );

      }
    }


    /* ============================================================
       CAMERA
    ============================================================ */

    function getLookControls() {

      return (
        camera?.components?.[
          "look-controls"
        ] ||
        null
      );
    }


    function getCameraYaw() {

      const controls =
        getLookControls();


      if (
        controls?.yawObject
      ) {

        return normalizeYaw(
          -radiansToDegrees(
            controls.yawObject.rotation.y
          )
        );
      }


      const rotation =
        camera?.getAttribute(
          "rotation"
        ) ||
        {};


      return normalizeYaw(
        -Number(
          rotation.y
        )
      );
    }


    function getCameraPitch() {

      const controls =
        getLookControls();


      if (
        controls?.pitchObject
      ) {

        return clamp(
          radiansToDegrees(
            controls.pitchObject.rotation.x
          ),
          -89,
          89
        );
      }


      const rotation =
        camera?.getAttribute(
          "rotation"
        ) ||
        {};


      return clamp(
        Number(
          rotation.x
        ),
        -89,
        89
      );
    }


    function getCameraFov() {

      return clamp(
        Number(
          camera?.getAttribute(
            "fov"
          )
        ) || 75,
        viewerSettings.minFov,
        viewerSettings.maxFov
      );
    }


    function setCameraPose(
      yaw,
      pitch,
      fov
    ) {

      if (
        !camera
      ) {
        return;
      }


      const controls =
        getLookControls();


      const safeYaw =
        normalizeYaw(
          yaw
        );


      const safePitch =
        clamp(
          pitch,
          -89,
          89
        );


      const safeFov =
        clamp(
          fov,
          viewerSettings.minFov,
          viewerSettings.maxFov
        );


      if (
        controls?.yawObject &&
        controls?.pitchObject
      ) {

        controls.yawObject.rotation.y =
          degreesToRadians(
            -safeYaw
          );


        controls.pitchObject.rotation.x =
          degreesToRadians(
            safePitch
          );

      } else {

        camera.setAttribute(
          "rotation",
          {
            x:
              safePitch,

            y:
              -safeYaw,

            z:
              0
          }
        );

      }


      camera.setAttribute(
        "fov",
        safeFov
      );


      currentFov =
        safeFov;


      targetFov =
        safeFov;


      updateCameraReadout();

    }


    function sceneStartPose(
      scene
    ) {

      return {

        yaw:
          normalizeYaw(
            Number(
              scene?.heading
            ) || 0
          ),

        pitch:
          clamp(
            Number(
              scene?.pitch
            ) || 0,
            -89,
            89
          ),

        fov:
          clamp(
            Number(
              scene?.fov
            ) ||
              viewerSettings.defaultFov,
            viewerSettings.minFov,
            viewerSettings.maxFov
          )

      };
    }


    function resetCameraView() {

      const scene =
        scenes[
          currentIndex
        ];


      if (
        !scene
      ) {
        return;
      }


      const pose =
        sceneStartPose(
          scene
        );


      setCameraPose(
        pose.yaw,
        pose.pitch,
        pose.fov
      );


      showToast(
        "View reset"
      );
    }


    function updateCameraReadout() {

      if (
        fovReadout
      ) {

        fovReadout.textContent =
          `${Math.round(
            getCameraFov()
          )}°`;
      }


      updateCompass();

    }


    /* ============================================================
       ZOOM
    ============================================================ */

    let zoomFrame =
      null;


    function animateFov() {

      if (
        zoomFrame
      ) {
        return;
      }


      const step =
        () => {

          const current =
            getCameraFov();


          const delta =
            targetFov -
            current;


          if (
            Math.abs(
              delta
            ) <
            0.03
          ) {

            camera.setAttribute(
              "fov",
              targetFov
            );


            currentFov =
              targetFov;


            zoomFrame =
              null;


            updateCameraReadout();

            return;
          }


          const next =
            current +
            delta *
            0.20;


          camera.setAttribute(
            "fov",
            next
          );


          currentFov =
            next;


          updateCameraReadout();


          zoomFrame =
            window.requestAnimationFrame(
              step
            );

        };


      zoomFrame =
        window.requestAnimationFrame(
          step
        );
    }


    function setZoom(
      fov
    ) {

      targetFov =
        clamp(
          fov,
          viewerSettings.minFov,
          viewerSettings.maxFov
        );


      animateFov();


      scheduleUiIdle();

    }


    function zoomIn() {

      setZoom(
        getCameraFov() -
        7
      );
    }


    function zoomOut() {

      setZoom(
        getCameraFov() +
        7
      );
    }


    /* ============================================================
       COMPASS
    ============================================================ */

    function updateCompass() {

      if (
        !compassNeedle
      ) {
        return;
      }


      const scene =
        scenes[
          currentIndex
        ];


      const offset =
        Number(
          scene?.northOffset
        ) || 0;


      const yaw =
        getCameraYaw();


      const rotation =
        normalizeYaw(
          yaw +
          offset
        );


      compassNeedle.style.transform =
        `translateY(-1px) rotate(${
          rotation
        }deg)`;

    }


    /* ============================================================
       PRELOAD
    ============================================================ */

    function preloadImage(
      url
    ) {

      const normalized =
        String(
          url ||
          ""
        ).trim();


      if (
        !normalized
      ) {

        return Promise.reject(
          new Error(
            "Missing panorama image."
          )
        );
      }


      if (
        preloadCache.has(
          normalized
        )
      ) {

        return preloadCache.get(
          normalized
        );
      }


      const promise =
        new Promise(
          (
            resolve,
            reject
          ) => {

            const image =
              new Image();


            image.decoding =
              "async";


            image.loading =
              "eager";


            image.onload =
              () => {

                resolve(
                  image
                );

              };


            image.onerror =
              () => {

                reject(
                  new Error(
                    "Panorama image failed to load."
                  )
                );

              };


            image.src =
              normalized;

          }
        );


      preloadCache.set(
        normalized,
        promise
      );


      return promise;
    }


    function getSceneConnections(
      index
    ) {

      if (
        !Number.isInteger(
          index
        ) ||
        index <
          0 ||
        index >=
          scenes.length
      ) {

        return [];
      }


      const scene =
        scenes[
          index
        ];


      return [
        "forward",
        "backward",
        "left",
        "right"
      ]
        .map(
          direction => {

            const raw =
              scene?.[
                direction
              ];


            if (
              raw ===
                null ||
              raw ===
                undefined ||
              raw ===
                ""
            ) {

              return null;
            }


            const target =
              Number(
                raw
              );


            if (
              !Number.isInteger(
                target
              ) ||
              target <
                0 ||
              target >=
                scenes.length ||
              target ===
                index
            ) {

              return null;
            }


            return {

              direction,

              target,

              scene:
                scenes[
                  target
                ]

            };

          }
        )
        .filter(Boolean);

    }


    function preloadConnectedScenes(
      index
    ) {

      if (
        !tourSettings.preloadNeighbors
      ) {

        return;
      }


      const queue =
        [];


      const visited =
        new Set([
          index
        ]);


      const first =
        getSceneConnections(
          index
        );


      first.forEach(
        connection => {

          if (
            !visited.has(
              connection.target
            )
          ) {

            visited.add(
              connection.target
            );

            queue.push({
              index:
                connection.target,

              depth:
                1
            });
          }

        }
      );


      if (
        tourSettings.preloadDepth >
        1
      ) {

        let cursor =
          0;


        while (
          cursor <
          queue.length
        ) {

          const item =
            queue[
              cursor++
            ];


          if (
            item.depth >=
            tourSettings.preloadDepth
          ) {

            continue;
          }


          getSceneConnections(
            item.index
          ).forEach(
            connection => {

              if (
                visited.has(
                  connection.target
                )
              ) {

                return;
              }


              visited.add(
                connection.target
              );


              queue.push({
                index:
                  connection.target,

                depth:
                  item.depth +
                  1
              });

            }
          );

        }

      }


      queue
        .slice(
          0,
          8
        )
        .forEach(
          item => {

            const image =
              scenes[
                item.index
              ]?.image;


            preloadImage(
              image
            ).catch(
              () => {}
            );

          }
        );

    }


    /* ============================================================
       SKY MATERIAL
    ============================================================ */

    function skyMaterial(
      sky
    ) {

      const mesh =
        sky?.getObject3D?.(
          "mesh"
        );


      if (
        !mesh
      ) {

        return null;
      }


      if (
        Array.isArray(
          mesh.material
        )
      ) {

        return (
          mesh.material[
            0
          ] ||
          null
        );
      }


      return (
        mesh.material ||
        null
      );
    }


    function setSkyOpacity(
      sky,
      opacity
    ) {

      const material =
        skyMaterial(
          sky
        );


      if (
        material
      ) {

        material.transparent =
          true;


        material.opacity =
          clamp(
            opacity,
            0,
            1
          );


        material.needsUpdate =
          true;

      }

    }


    function waitForSkyReady(
      sky
    ) {

      return new Promise(
        resolve => {

          let done =
            false;


          let timeout =
            null;


          const finish =
            () => {

              if (
                done
              ) {
                return;
              }


              done =
                true;


              if (
                timeout
              ) {

                clearTimeout(
                  timeout
                );
              }


              sky.removeEventListener(
                "materialtextureloaded",
                finish
              );


              resolve();

            };


          sky.addEventListener(
            "materialtextureloaded",
            finish,
            {
              once:
                true
            }
          );


          timeout =
            window.setTimeout(
              finish,
              2200
            );

        }
      );

    }


    async function prepareIncomingSky(
      sky,
      url
    ) {

      await preloadImage(
        url
      );


      setSkyOpacity(
        sky,
        0
      );


      sky.setAttribute(
        "src",
        url
      );


      await waitForSkyReady(
        sky
      );

    }


    function animateSkyCrossfade(
      incomingSky,
      outgoingSky,
      duration = 520
    ) {

      return new Promise(
        resolve => {

          const start =
            performance.now();


          const frame =
            now => {

              const progress =
                clamp(
                  (
                    now -
                    start
                  ) /
                  duration,
                  0,
                  1
                );


              const eased =
                1 -
                Math.pow(
                  1 -
                  progress,
                  3
                );


              setSkyOpacity(
                incomingSky,
                eased
              );


              setSkyOpacity(
                outgoingSky,
                1 -
                eased
              );


              if (
                progress <
                1
              ) {

                window.requestAnimationFrame(
                  frame
                );

              } else {

                resolve();

              }

            };


          window.requestAnimationFrame(
            frame
          );

        }
      );

    }


    /* ============================================================
       SPATIAL NAVIGATION MATH
    ============================================================ */

    function directionFallbackYaw(
      direction
    ) {

      const values = {

        forward:
          0,

        backward:
          180,

        left:
          -90,

        right:
          90

      };


      return (
        values[
          direction
        ] ??
        0
      );

    }


    function spatialYawBetween(
      source,
      target
    ) {

      if (
        !has3DPosition(
          source
        ) ||
        !has3DPosition(
          target
        )
      ) {

        return null;
      }


      const dx =
        Number(
          target.position.x
        ) -
        Number(
          source.position.x
        );


      const dz =
        Number(
          target.position.z
        ) -
        Number(
          source.position.z
        );


      if (
        Math.abs(
          dx
        ) <
        0.0001 &&
        Math.abs(
          dz
        ) <
        0.0001
      ) {

        return null;
      }


      const worldYaw =
        radiansToDegrees(
          Math.atan2(
            dx,
            -dz
          )
        );


      const northOffset =
        Number(
          source.northOffset
        ) || 0;


      return normalizeYaw(
        worldYaw -
        northOffset
      );

    }


    function connectionYaw(
      sourceIndex,
      targetIndex,
      direction
    ) {

      const source =
        scenes[
          sourceIndex
        ];


      const target =
        scenes[
          targetIndex
        ];


      const spatial =
        spatialYawBetween(
          source,
          target
        );


      if (
        spatial !==
        null
      ) {

        return spatial;
      }


      return directionFallbackYaw(
        direction
      );

    }


    function arrivalYaw(
      sourceIndex,
      targetIndex,
      travelYaw
    ) {

      const source =
        scenes[
          sourceIndex
        ];


      const target =
        scenes[
          targetIndex
        ];


      if (
        has3DPosition(
          source
        ) &&
        has3DPosition(
          target
        )
      ) {

        const backYaw =
          spatialYawBetween(
            target,
            source
          );


        if (
          backYaw !==
          null
        ) {

          /*
           * Enter the destination while still facing toward
           * the direction we came from. This makes the arrival
           * feel spatial rather than arbitrary.
           */
          return normalizeYaw(
            backYaw +
            180
          );

        }

      }


      const targetHeading =
        Number(
          target?.heading
        );


      if (
        Number.isFinite(
          targetHeading
        ) &&
        Math.abs(
          targetHeading
        ) >
        0.5
      ) {

        return normalizeYaw(
          targetHeading
        );
      }


      return normalizeYaw(
        travelYaw
      );

    }


    /* ============================================================
       HOTSPOT POSITION
    ============================================================ */

    function yawPitchToPosition(
      yaw,
      pitch,
      radius = 9.5
    ) {

      const yawRad =
        degreesToRadians(
          yaw
        );


      const pitchRad =
        degreesToRadians(
          pitch
        );


      const cosPitch =
        Math.cos(
          pitchRad
        );


      return {

        x:
          radius *
          Math.sin(
            yawRad
          ) *
          cosPitch,

        y:
          radius *
          Math.sin(
            pitchRad
          ),

        z:
          -radius *
          Math.cos(
            yawRad
          ) *
          cosPitch

      };

    }


    /* ============================================================
       A-FRAME COMPONENTS
    ============================================================ */

    if (
      window.AFRAME
    ) {

      if (
        !AFRAME.components[
          "pi-billboard"
        ]
      ) {

        AFRAME.registerComponent(
          "pi-billboard",
          {

            tick:
              function() {

                const cameraObject =
                  this.el?.sceneEl?.camera
                    ?.object3D ||
                  null;


                if (
                  !cameraObject ||
                  !this.el?.object3D
                ) {

                  return;
                }


                const target =
                  new AFRAME.THREE.Vector3();


                cameraObject.getWorldPosition(
                  target
                );


                this.el.object3D.lookAt(
                  target
                );

              }

          }
        );

      }


      if (
        !AFRAME.components[
          "pi-hover-scale"
        ]
      ) {

        AFRAME.registerComponent(
          "pi-hover-scale",
          {

            init:
              function() {

                this.base =
                  this.el.object3D.scale.clone();


                this.el.addEventListener(
                  "mouseenter",
                  () => {

                    this.el.object3D.scale.set(
                      this.base.x *
                        1.16,

                      this.base.y *
                        1.16,

                      this.base.z *
                        1.16
                    );

                  }
                );


                this.el.addEventListener(
                  "mouseleave",
                  () => {

                    this.el.object3D.scale.copy(
                      this.base
                    );

                  }
                );

              }

          }
        );

      }

    }


    /* ============================================================
       HOTSPOT VISUAL FACTORY
    ============================================================ */

    function makeRing(
      color,
      radiusInner,
      radiusOuter,
      rotation
    ) {

      const ring =
        document.createElement(
          "a-ring"
        );


      ring.setAttribute(
        "radius-inner",
        String(
          radiusInner
        )
      );


      ring.setAttribute(
        "radius-outer",
        String(
          radiusOuter
        )
      );


      ring.setAttribute(
        "rotation",
        rotation
      );


      ring.setAttribute(
        "material",
        `
          shader: flat;
          color: ${color};
          side: double;
          opacity: 0.62;
        `
      );


      return ring;
    }


    function makeHotspotLabel(
      text,
      color
    ) {

      const label =
        document.createElement(
          "a-text"
        );


      label.setAttribute(
        "value",
        text
      );


      label.setAttribute(
        "align",
        "center"
      );


      label.setAttribute(
        "anchor",
        "center"
      );


      label.setAttribute(
        "baseline",
        "center"
      );


      label.setAttribute(
        "width",
        "2.9"
      );


      label.setAttribute(
        "color",
        color
      );


      label.setAttribute(
        "opacity",
        "0"
      );


      label.setAttribute(
        "position",
        "0 0.48 0"
      );


      label.setAttribute(
        "pi-billboard",
        ""
      );


      return label;
    }


    function attachHotspotInteractions(
      root,
      label,
      data
    ) {

      root.addEventListener(
        "mouseenter",
        () => {

          if (
            label
          ) {

            label.setAttribute(
              "opacity",
              "1"
            );

          }


          showTravelHint(
            data
          );

        }
      );


      root.addEventListener(
        "mouseleave",
        () => {

          if (
            label
          ) {

            label.setAttribute(
              "opacity",
              "0"
            );

          }


          hideTravelHint();

        }
      );


      root.addEventListener(
        "click",
        event => {

          event.stopPropagation();


          if (
            data.kind ===
            "navigation"
          ) {

            travelToScene(
              data.target,
              {
                source:
                  currentIndex,

                yaw:
                  Number(
                    data.yaw
                  ) || 0,

                reason:
                  "hotspot"
              }
            );


            return;
          }


          if (
            data.kind ===
            "link"
          ) {

            openExternalUrl(
              data.url
            );


            return;
          }


          showHotspotInfo(
            data
          );

        }
      );

    }


