  <!-- ======================================
       JAVASCRIPT
  ======================================= -->

  <script>

    document.addEventListener(
      "DOMContentLoaded",
      () => {



        /* =================================
           HERO BOOKING BUTTON
        ================================= */

        const heroBookingBtn =
          document.getElementById(
            "heroBookingBtn"
          );



        const authModal =
          document.getElementById(
            "authModal"
          );



        heroBookingBtn?.addEventListener(
          "click",
          (event) => {

            event.preventDefault();



            if (authModal) {

              authModal.style.display =
                "flex";

            }

          }
        );



        /* =================================
           FACEBOOK BUTTON
        ================================= */

        const facebookBtn =
          document.getElementById(
            "facebookBtn"
          );



        facebookBtn?.addEventListener(
          "click",
          (event) => {

            if (
              facebookBtn.getAttribute(
                "href"
              ) === "#"
            ) {

              event.preventDefault();

              alert(
                "Our Facebook page link will be available soon."
              );

            }

          }
        );



        /* =================================
           HERO VIDEO
        ================================= */

        const heroVideo =
          document.getElementById(
            "heroResortVideo"
          );



        const heroMuteBtn =
          document.getElementById(
            "heroMuteBtn"
          );



        const heroImmersiveBtn =
          document.getElementById(
            "heroImmersiveBtn"
          );



        /* =================================
           SHARED VIEWER
        ================================= */

        const viewerOverlay =
          document.getElementById(
            "viewerOverlay"
          );



        const viewerShell =
          document.getElementById(
            "viewerShell"
          );



        const viewerClose =
          document.getElementById(
            "viewerClose"
          );



        const shared360Video =
          document.getElementById(
            "shared360Video"
          );



        const shared360Scene =
          document.getElementById(
            "shared360Scene"
          );



        const shared360Sphere =
          document.getElementById(
            "shared360Sphere"
          );



        const viewerTitle =
          document.getElementById(
            "viewerTitle"
          );



        const viewerSubtitle =
          document.getElementById(
            "viewerSubtitle"
          );



        const viewerBadgeText =
          document.getElementById(
            "viewerBadgeText"
          );



        const viewerHelp =
          document.getElementById(
            "viewerHelp"
          );



        const viewerPlayPause =
          document.getElementById(
            "viewerPlayPause"
          );



        const viewerMute =
          document.getElementById(
            "viewerMute"
          );



        const viewerFullscreen =
          document.getElementById(
            "viewerFullscreen"
          );



        const openAbout360 =
          document.getElementById(
            "openAbout360"
          );



        let currentViewerSource =
          "";



        let currentViewerType =
          "";



        let viewerHelpTimer =
          null;



        /* =================================
           VIEWER CONFIG
        ================================= */

        const viewerConfigurations = {

          hero: {

            source:
              "/videos/forindexnavideo.mp4",

            title:
              "Puffer Isle Cinematic Explorer",

            subtitle:
              "Immersive cinematic resort experience",

            badge:
              "Puffer Isle Cinematic",

          },



          about: {

            source:
              "/videos/arvideoofresort.mp4",

            title:
              "Puffer Isle Explorer",

            subtitle:
              "Interactive resort experience",

            badge:
              "Puffer Isle",

          },

        };



        /* =================================
           UPDATE PLAY BUTTON
        ================================= */

        function updateViewerPlayButton() {

          if (
            !viewerPlayPause ||
            !shared360Video
          ) {

            return;

          }



          if (
            shared360Video.paused
          ) {

            viewerPlayPause.textContent =
              "▶";



            viewerPlayPause.setAttribute(
              "aria-label",
              "Play video"
            );

          } else {

            viewerPlayPause.textContent =
              "❚❚";



            viewerPlayPause.setAttribute(
              "aria-label",
              "Pause video"
            );

          }

        }



        /* =================================
           UPDATE MUTE BUTTON
        ================================= */

        function updateViewerMuteButton() {

          if (
            !viewerMute ||
            !shared360Video
          ) {

            return;

          }



          viewerMute.textContent =
            shared360Video.muted
              ? "🔇"
              : "🔊";



          viewerMute.setAttribute(
            "aria-label",
            shared360Video.muted
              ? "Unmute video"
              : "Mute video"
          );

        }



        /* =================================
           SHOW HELP
        ================================= */

        function showViewerHelp() {

          viewerHelp?.classList.remove(
            "hidden"
          );



          clearTimeout(
            viewerHelpTimer
          );



          viewerHelpTimer =
            setTimeout(
              () => {

                viewerHelp?.classList.add(
                  "hidden"
                );

              },
              4500
            );

        }



        /* =================================
           HIDE HELP
        ================================= */

        function hideViewerHelp() {

          viewerHelp?.classList.add(
            "hidden"
          );



          clearTimeout(
            viewerHelpTimer
          );

        }



        /* =================================
           PREPARE 360 SOURCE
        ================================= */

        function changeViewerSource(
          configuration,
          startTime = 0
        ) {

          if (
            !shared360Video ||
            !configuration
          ) {

            return;

          }



          const nextSource =
            configuration.source;



          currentViewerSource =
            nextSource;



          shared360Video.pause();



          shared360Video.removeAttribute(
            "src"
          );



          shared360Video.src =
            nextSource;



          shared360Video.load();



          /*
           * Force the sphere to keep using
           * the shared video element.
           */

          shared360Sphere?.setAttribute(
            "src",
            "#shared360Video"
          );



          /*
           * Reset camera position whenever
           * a new experience is opened.
           */

          const camera =
            document.getElementById(
              "shared360Camera"
            );



          if (camera) {

            camera.setAttribute(
              "rotation",
              "0 0 0"
            );

          }



          /*
           * Apply the requested starting
           * timestamp once metadata exists.
           */

          const safeStartTime =
            Number.isFinite(
              Number(startTime)
            )
              ? Math.max(
                  0,
                  Number(startTime)
                )
              : 0;



          const setStartTime =
            () => {

              if (
                !Number.isFinite(
                  shared360Video.duration
                )
              ) {

                return;

              }



              if (
                safeStartTime >
                0
              ) {

                shared360Video.currentTime =
                  Math.min(
                    safeStartTime,
                    Math.max(
                      0,
                      shared360Video.duration -
                      0.25
                    )
                  );

              }

            };



          if (
            shared360Video.readyState >= 1
          ) {

            setStartTime();

          } else {

            shared360Video.addEventListener(
              "loadedmetadata",
              setStartTime,
              {
                once:
                  true
              }
            );

          }

        }



        /* =================================
           OPEN VIEWER
        ================================= */

        async function openViewer(
          viewerType,
          startTime = 0
        ) {

          const configuration =
            viewerConfigurations[
              viewerType
            ];



          if (
            !configuration ||
            !viewerOverlay ||
            !shared360Video
          ) {

            return;

          }



          currentViewerType =
            viewerType;



          viewerTitle.textContent =
            configuration.title;



          viewerSubtitle.textContent =
            configuration.subtitle;



          viewerBadgeText.textContent =
            configuration.badge;



          changeViewerSource(
            configuration,
            startTime
          );



          viewerOverlay.classList.add(
            "active"
          );



          viewerOverlay.setAttribute(
            "aria-hidden",
            "false"
          );



          document.body.classList.add(
            "viewer-open"
          );



          /*
           * Let A-Frame measure the visible
           * viewport before rendering.
           */

          setTimeout(
            () => {

              if (
                shared360Scene &&
                typeof shared360Scene.resize ===
                  "function"
              ) {

                shared360Scene.resize();

              }

            },
            100
          );



          /*
           * Start muted for reliable
           * browser playback.
           */

          shared360Video.muted =
            true;



          try {

            await shared360Video.play();

          } catch (error) {

            console.warn(
              "360 video playback was blocked:",
              error
            );

          }



          updateViewerPlayButton();

          updateViewerMuteButton();

          showViewerHelp();

        }



        /* =================================
           CLOSE VIEWER
        ================================= */

        async function closeViewer() {

          viewerOverlay?.classList.remove(
            "active"
          );



          viewerOverlay?.setAttribute(
            "aria-hidden",
            "true"
          );



          document.body.classList.remove(
            "viewer-open"
          );



          clearTimeout(
            viewerHelpTimer
          );



          if (shared360Video) {

            shared360Video.pause();

            shared360Video.currentTime =
              0;

          }



          if (
            document.fullscreenElement
          ) {

            try {

              await document.exitFullscreen();

            } catch (error) {

              console.warn(
                "Could not exit fullscreen:",
                error
              );

            }

          }

        }



        /* =================================
           HERO IMMERSIVE OPEN
        ================================= */

        heroImmersiveBtn?.addEventListener(
          "click",
          (event) => {

            event.stopPropagation();



            openViewer(
              "hero",
              heroVideo
                ? heroVideo.currentTime
                : 0
            );

          }
        );



        /* =================================
           HERO VIDEO CLICK
        ================================= */

        heroVideo?.addEventListener(
          "click",
          (event) => {

            event.preventDefault();



            openViewer(
              "hero",
              heroVideo.currentTime
            );

          }
        );



        /* =================================
           HERO MUTE
        ================================= */

        heroMuteBtn?.addEventListener(
          "click",
          (event) => {

            event.stopPropagation();



            if (!heroVideo) {

              return;

            }



            heroVideo.muted =
              !heroVideo.muted;



            heroMuteBtn.textContent =
              heroVideo.muted
                ? "🔇"
                : "🔊";



            heroMuteBtn.setAttribute(
              "aria-label",
              heroVideo.muted
                ? "Turn sound on"
                : "Mute video"
            );

          }
        );



        /* =================================
           ABOUT 360 OPEN
        ================================= */

        openAbout360?.addEventListener(
          "click",
          () => {

            openViewer(
              "about",
              0
            );

          }
        );



        /* =================================
           ABOUT KEYBOARD
        ================================= */

        openAbout360?.addEventListener(
          "keydown",
          (event) => {

            if (
              event.key === "Enter" ||
              event.key === " "
            ) {

              event.preventDefault();



              openViewer(
                "about",
                0
              );

            }

          }
        );



        /* =================================
           CLOSE BUTTON
        ================================= */

        viewerClose?.addEventListener(
          "click",
          (event) => {

            event.stopPropagation();

            closeViewer();

          }
        );



        /* =================================
           PLAY / PAUSE
        ================================= */

        viewerPlayPause?.addEventListener(
          "click",
          async (event) => {

            event.stopPropagation();



            if (!shared360Video) {

              return;

            }



            try {

              if (
                shared360Video.paused
              ) {

                await shared360Video.play();

              } else {

                shared360Video.pause();

              }

            } catch (error) {

              console.error(
                "360 playback error:",
                error
              );

            }



            updateViewerPlayButton();

          }
        );



        /* =================================
           VIDEO EVENTS
        ================================= */

        shared360Video?.addEventListener(
          "play",
          updateViewerPlayButton
        );



        shared360Video?.addEventListener(
          "pause",
          updateViewerPlayButton
        );



        /* =================================
           MUTE / UNMUTE
        ================================= */

        viewerMute?.addEventListener(
          "click",
          (event) => {

            event.stopPropagation();



            if (!shared360Video) {

              return;

            }



            shared360Video.muted =
              !shared360Video.muted;



            updateViewerMuteButton();

          }
        );



        /* =================================
           FULLSCREEN
        ================================= */

        async function toggleViewerFullscreen() {

          if (!viewerShell) {

            return;

          }



          try {

            if (
              document.fullscreenElement
            ) {

              await document.exitFullscreen();

              return;

            }



            if (
              viewerShell.requestFullscreen
            ) {

              await viewerShell.requestFullscreen();

              return;

            }



            if (
              viewerShell.webkitRequestFullscreen
            ) {

              await viewerShell.webkitRequestFullscreen();

            }

          } catch (error) {

            console.error(
              "Viewer fullscreen error:",
              error
            );

          }

        }



        viewerFullscreen?.addEventListener(
          "click",
          (event) => {

            event.stopPropagation();

            toggleViewerFullscreen();

          }
        );



        /* =================================
           HIDE HELP AFTER MOVEMENT
        ================================= */

        viewerShell?.addEventListener(
          "pointerdown",
          () => {

            hideViewerHelp();

          },
          {
            passive:
              true
          }
        );



        viewerShell?.addEventListener(
          "touchstart",
          () => {

            hideViewerHelp();

          },
          {
            passive:
              true
          }
        );



        /* =================================
           ESC KEY
        ================================= */

        document.addEventListener(
          "keydown",
          (event) => {

            if (
              event.key === "Escape" &&
              viewerOverlay?.classList.contains(
                "active"
              )
            ) {

              closeViewer();

            }

          }
        );



        /* =================================
           RESIZE A-FRAME
        ================================= */

        window.addEventListener(
          "resize",
          () => {

            if (
              viewerOverlay?.classList.contains(
                "active"
              ) &&
              shared360Scene &&
              typeof shared360Scene.resize ===
                "function"
            ) {

              shared360Scene.resize();

            }

          }
        );



        /* =================================
           FULLSCREEN CHANGE
        ================================= */

        document.addEventListener(
          "fullscreenchange",
          () => {

            if (!viewerFullscreen) {

              return;

            }



            viewerFullscreen.textContent =
              document.fullscreenElement
                ? "⛶"
                : "⛶";



            viewerFullscreen.setAttribute(
              "aria-label",
              document.fullscreenElement
                ? "Exit fullscreen"
                : "Enter fullscreen"
            );

          }
        );



        /* =================================
           STARTING HERO STATE
        ================================= */

        heroMuteBtn.textContent =
          heroVideo?.muted
            ? "🔇"
            : "🔊";

      }
    );

  </script>



