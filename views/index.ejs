<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Puffer Isle Resort | Tropical Escape
  </title>


  <!-- =========================================
       FAVICON
  ========================================== -->

  <link
    rel="icon"
    type="image/png"
    href="/images/islelogo.png"
  >


  <!-- =========================================
       FONT
  ========================================== -->

  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >


  <!-- =========================================
       A-FRAME
  ========================================== -->

  <script
    src="https://aframe.io/releases/1.5.0/aframe.min.js"
  ></script>



  <style>

    :root {

      --brand-color:
        #FFD700;

      --brand-hover:
        #e6c200;

      --accent-teal:
        #008080;

      --dark:
        #1a1a1a;

      --dark-soft:
        #242424;

      --light-bg:
        #ffffff;

      --section-bg:
        #f7f8f7;

      --text:
        #222;

      --text-muted:
        #666;

      --border:
        #e8e8e8;

      --shadow:
        0 20px 50px
        rgba(0,0,0,0.08);

      --shadow-heavy:
        0 25px 70px
        rgba(0,0,0,0.14);

    }



    /* ========================================
       RESET
    ======================================== */

    * {

      margin:
        0;

      padding:
        0;

      box-sizing:
        border-box;

    }



    html {

      scroll-behavior:
        smooth;

    }



    body {

      font-family:
        'Poppins',
        sans-serif;

      color:
        var(--text);

      background:
        var(--light-bg);

      line-height:
        1.7;

      overflow-x:
        hidden;

    }



    body.viewer-open {

      overflow:
        hidden;

    }



    button {

      font-family:
        inherit;

    }



    a {

      text-decoration:
        none;

    }



    /* ========================================
       HERO
    ======================================== */

    .hero {

      position:
        relative;

      height:
        100vh;

      min-height:
        700px;

      overflow:
        hidden;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      isolation:
        isolate;

      background:
        #080b0b;

    }



    .hero video {

      position:
        absolute;

      inset:
        0;

      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

      filter:
        brightness(45%)
        saturate(90%);

      transform:
        scale(1.02);

      cursor:
        pointer;

      transition:
        transform 1.2s ease,
        filter 0.45s ease;

    }



    .hero:hover video {

      transform:
        scale(1.035);

    }



    /* ========================================
       CINEMATIC OVERLAY
    ======================================== */

    .hero::after {

      content:
        "";

      position:
        absolute;

      inset:
        0;

      z-index:
        1;

      pointer-events:
        none;

      background:

        linear-gradient(
          to bottom,
          rgba(0,0,0,0.10),
          rgba(0,0,0,0.58)
        );

    }



    .hero-video-overlay {

      position:
        absolute;

      inset:
        0;

      z-index:
        1;

      pointer-events:
        none;

      background:

        linear-gradient(
          90deg,
          rgba(0,0,0,0.45),
          transparent 45%,
          rgba(0,0,0,0.16)
        ),

        linear-gradient(
          to top,
          rgba(0,0,0,0.60),
          transparent 42%
        );

    }



    /* ========================================
       HERO LABEL
    ======================================== */

    .hero-video-label {

      position:
        absolute;

      top:
        105px;

      left:
        28px;

      z-index:
        5;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        9px;

      padding:
        9px 14px;

      border:
        1px solid
        rgba(255,255,255,0.16);

      border-radius:
        999px;

      color:
        rgba(255,255,255,0.88);

      background:
        rgba(0,0,0,0.40);

      backdrop-filter:
        blur(12px);

      -webkit-backdrop-filter:
        blur(12px);

      font-size:
        0.68rem;

      font-weight:
        600;

      letter-spacing:
        1.2px;

      text-transform:
        uppercase;

      pointer-events:
        none;

    }



    .hero-video-dot {

      width:
        7px;

      height:
        7px;

      border-radius:
        50%;

      background:
        var(--brand-color);

      box-shadow:
        0 0 12px
        rgba(255,215,0,0.85);

      animation:
        heroPulse 1.8s ease-in-out infinite;

    }



    @keyframes heroPulse {

      0%,
      100% {

        opacity:
          1;

        transform:
          scale(1);

      }

      50% {

        opacity:
          0.55;

        transform:
          scale(0.72);

      }

    }



    /* ========================================
       HERO TOOLS
    ======================================== */

    .hero-video-tools {

      position:
        absolute;

      top:
        105px;

      right:
        28px;

      z-index:
        7;

      display:
        flex;

      gap:
        8px;

    }



    .hero-video-tool {

      position:
        relative;

      width:
        44px;

      height:
        44px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        rgba(255,255,255,0.16);

      border-radius:
        50%;

      background:
        rgba(0,0,0,0.42);

      color:
        white;

      font-size:
        0.92rem;

      cursor:
        pointer;

      backdrop-filter:
        blur(12px);

      -webkit-backdrop-filter:
        blur(12px);

      transition:
        all 0.25s ease;

    }



    .hero-video-tool:hover {

      background:
        var(--brand-color);

      color:
        var(--dark);

      border-color:
        var(--brand-color);

      transform:
        translateY(-2px)
        scale(1.04);

    }



    .hero-360-bubble {

      position:
        absolute;

      top:
        -4px;

      right:
        -4px;

      min-width:
        15px;

      height:
        15px;

      padding:
        0 3px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        999px;

      background:
        var(--brand-color);

      color:
        var(--dark);

      font-size:
        0.46rem;

      font-weight:
        900;

      line-height:
        1;

    }



    /* ========================================
       HERO TEXT
    ======================================== */

    .hero-text {

      position:
        relative;

      z-index:
        4;

      width:
        min(850px, calc(100% - 30px));

      padding:
        50px 55px;

      color:
        white;

      text-align:
        center;

      border:
        1px solid
        rgba(255,255,255,0.14);

      border-radius:
        28px;

      background:
        rgba(0,0,0,0.34);

      backdrop-filter:
        blur(12px);

      -webkit-backdrop-filter:
        blur(12px);

      box-shadow:
        0 25px 80px
        rgba(0,0,0,0.25);

      animation:
        fadeInUp
        1.1s
        cubic-bezier(0.23,1,0.32,1)
        forwards;

    }



    @keyframes fadeInUp {

      0% {

        opacity:
          0;

        transform:
          translateY(35px);

      }

      100% {

        opacity:
          1;

        transform:
          translateY(0);

      }

    }



    .hero-logo {

      width:
        165px;

      margin-bottom:
        25px;

      filter:
        drop-shadow(
          0 0 15px
          rgba(255,215,0,0.45)
        );

    }



    .hero-kicker {

      margin-bottom:
        13px;

      color:
        rgba(255,255,255,0.58);

      font-size:
        0.70rem;

      font-weight:
        700;

      letter-spacing:
        3px;

      text-transform:
        uppercase;

    }



    .hero-text h2 {

      font-size:
        clamp(2.2rem, 5vw, 4rem);

      line-height:
        1.15;

      margin-bottom:
        20px;

      font-weight:
        700;

      letter-spacing:
        -1px;

    }



    .hero-text h2 span {

      color:
        var(--brand-color);

    }



    .hero-text p {

      max-width:
        650px;

      margin:
        0 auto 30px;

      color:
        rgba(255,255,255,0.88);

      font-size:
        1.12rem;

      font-weight:
        300;

      letter-spacing:
        0.5px;

    }



    .hero-btn {

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        10px;

      padding:
        16px 38px;

      border-radius:
        50px;

      background:
        var(--brand-color);

      color:
        var(--dark);

      font-size:
        1rem;

      font-weight:
        700;

      transition:
        all 0.3s ease;

      box-shadow:
        0 10px 30px
        rgba(255,215,0,0.25);

    }



    .hero-btn:hover {

      background:
        white;

      transform:
        translateY(-4px);

      box-shadow:
        0 15px 35px
        rgba(255,255,255,0.18);

    }



    .hero-btn-arrow {

      transition:
        transform 0.25s ease;

    }



    .hero-btn:hover
    .hero-btn-arrow {

      transform:
        translateX(5px);

    }



    /* ========================================
       HERO HINT
    ======================================== */

    .video-fullscreen-hint {

      position:
        absolute;

      right:
        22px;

      bottom:
        22px;

      z-index:
        5;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      padding:
        9px 14px;

      border:
        1px solid
        rgba(255,255,255,0.18);

      border-radius:
        999px;

      background:
        rgba(0,0,0,0.55);

      color:
        rgba(255,255,255,0.94);

      font-size:
        0.72rem;

      font-weight:
        500;

      letter-spacing:
        0.3px;

      pointer-events:
        none;

      backdrop-filter:
        blur(8px);

      -webkit-backdrop-filter:
        blur(8px);

      opacity:
        0.85;

      transition:
        all 0.3s ease;

    }



    .hero:hover
    .video-fullscreen-hint {

      opacity:
        1;

      transform:
        translateY(-2px);

    }



    .video-fullscreen-icon {

      font-size:
        0.95rem;

    }



    /* ========================================
       HERO BOTTOM META
    ======================================== */

    .hero-bottom-meta {

      position:
        absolute;

      left:
        28px;

      right:
        28px;

      bottom:
        24px;

      z-index:
        5;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      pointer-events:
        none;

    }



    .hero-scroll-text {

      color:
        rgba(255,255,255,0.55);

      font-size:
        0.63rem;

      font-weight:
        600;

      letter-spacing:
        2px;

    }



    .hero-scroll-line {

      width:
        140px;

      height:
        2px;

      overflow:
        hidden;

      border-radius:
        999px;

      background:
        rgba(255,255,255,0.18);

    }



    .hero-scroll-line span {

      display:
        block;

      width:
        35%;

      height:
        100%;

      border-radius:
        inherit;

      background:
        var(--brand-color);

      animation:
        heroScan 2.5s ease-in-out infinite;

    }



    @keyframes heroScan {

      0% {

        transform:
          translateX(-120%);

      }

      50% {

        transform:
          translateX(180%);

      }

      100% {

        transform:
          translateX(300%);

      }

    }



    /* ========================================
       SECTION HEADINGS
    ======================================== */

    .section-heading {

      max-width:
        720px;

      margin:
        0 auto 55px;

      text-align:
        center;

    }



    .section-label {

      display:
        inline-block;

      margin-bottom:
        10px;

      color:
        var(--accent-teal);

      font-size:
        0.75rem;

      font-weight:
        700;

      letter-spacing:
        2.5px;

      text-transform:
        uppercase;

    }



    .section-heading h2 {

      margin-bottom:
        15px;

      color:
        var(--dark);

      font-size:
        clamp(2rem,4vw,3rem);

      line-height:
        1.2;

    }



    .section-heading p {

      color:
        var(--text-muted);

      font-size:
        1rem;

    }



    /* ========================================
       ABOUT
    ======================================== */

    #about {

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

      gap:
        75px;

      align-items:
        center;

      padding:
        110px 8%;

      background:
        var(--light-bg);

    }



    .about-image-stack {

      position:
        relative;

      padding:
        0 18px 18px 0;

    }



    .about-image-stack::after {

      content:
        "";

      position:
        absolute;

      right:
        0;

      bottom:
        0;

      width:
        85%;

      height:
        85%;

      border:
        3px solid
        var(--brand-color);

      border-radius:
        24px;

      z-index:
        0;

      pointer-events:
        none;

    }



    /* ========================================
       360 EXPERIENCE CARD
    ======================================== */

    .experience-card {

      position:
        relative;

      z-index:
        1;

      min-height:
        430px;

      width:
        100%;

      overflow:
        hidden;

      cursor:
        pointer;

      border:
        1px solid
        rgba(0,128,128,0.20);

      border-radius:
        24px;

      background:
        linear-gradient(
          145deg,
          #073d3d,
          #061b1b
        );

      box-shadow:
        var(--shadow-heavy);

      outline:
        none;

      transition:
        transform 0.4s ease,
        box-shadow 0.4s ease;

    }



    .experience-card:hover {

      transform:
        translateY(-7px);

      box-shadow:
        0 32px 85px
        rgba(0,0,0,0.22);

    }



    .experience-card:focus-visible {

      box-shadow:
        0 0 0 3px
        rgba(255,215,0,0.40),
        var(--shadow-heavy);

    }



    .experience-card-bg {

      position:
        absolute;

      inset:
        0;

      background:

        linear-gradient(
          145deg,
          rgba(0,0,0,0.16),
          rgba(0,0,0,0.78)
        ),

        url("/images/resort1.jpg")
        center / cover no-repeat;

      transform:
        scale(1.03);

      transition:
        transform 0.7s ease;

    }



    .experience-card:hover
    .experience-card-bg {

      transform:
        scale(1.08);

    }



    .experience-card-glow {

      position:
        absolute;

      width:
        260px;

      height:
        260px;

      top:
        -140px;

      right:
        -110px;

      border-radius:
        50%;

      background:
        rgba(255,215,0,0.13);

      filter:
        blur(4px);

      animation:
        floatGlow 6s ease-in-out
        infinite;

    }



    @keyframes floatGlow {

      0%,
      100% {

        transform:
          translate(0,0);

        opacity:
          0.65;

      }

      50% {

        transform:
          translate(-20px,20px);

        opacity:
          1;

      }

    }



    .experience-card-content {

      position:
        relative;

      z-index:
        2;

      min-height:
        430px;

      display:
        flex;

      flex-direction:
        column;

      justify-content:
        space-between;

      padding:
        30px;

    }



    .experience-top {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

    }



    .experience-badge {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        9px 14px;

      border:
        1px solid
        rgba(255,255,255,0.18);

      border-radius:
        999px;

      background:
        rgba(0,0,0,0.40);

      color:
        white;

      font-size:
        0.72rem;

      font-weight:
        700;

      letter-spacing:
        1px;

      text-transform:
        uppercase;

      backdrop-filter:
        blur(10px);

      -webkit-backdrop-filter:
        blur(10px);

    }



    .experience-badge-dot {

      width:
        7px;

      height:
        7px;

      border-radius:
        50%;

      background:
        var(--brand-color);

      box-shadow:
        0 0 12px
        rgba(255,215,0,0.75);

    }



    .experience-rotate {

      width:
        42px;

      height:
        42px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        rgba(255,255,255,0.18);

      border-radius:
        50%;

      background:
        rgba(0,0,0,0.40);

      color:
        white;

      font-size:
        1.1rem;

      backdrop-filter:
        blur(10px);

      -webkit-backdrop-filter:
        blur(10px);

      animation:
        spinSlow 9s linear infinite;

    }



    @keyframes spinSlow {

      from {

        transform:
          rotate(0deg);

      }

      to {

        transform:
          rotate(360deg);

      }

    }



    .experience-center {

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      justify-content:
        center;

      padding:
        20px;

      text-align:
        center;

    }



    .experience-play {

      width:
        88px;

      height:
        88px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      padding-left:
        4px;

      border-radius:
        50%;

      background:
        rgba(255,215,0,0.96);

      color:
        var(--dark);

      font-size:
        1.6rem;

      box-shadow:
        0 15px 45px
        rgba(0,0,0,0.28),
        0 0 0 10px
        rgba(255,215,0,0.10);

      animation:
        pulsePlay 2.3s ease-in-out
        infinite;

      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;

    }



    .experience-card:hover
    .experience-play {

      transform:
        scale(1.10);

    }



    @keyframes pulsePlay {

      0%,
      100% {

        box-shadow:
          0 15px 45px
          rgba(0,0,0,0.28),
          0 0 0 10px
          rgba(255,215,0,0.10);

      }

      50% {

        box-shadow:
          0 15px 45px
          rgba(0,0,0,0.28),
          0 0 0 17px
          rgba(255,215,0,0.035);

      }

    }



    .experience-center h3 {

      margin-top:
        22px;

      color:
        white;

      font-size:
        clamp(1.5rem,3vw,2.1rem);

      line-height:
        1.2;

    }



    .experience-center p {

      max-width:
        390px;

      margin-top:
        10px;

      color:
        rgba(255,255,255,0.78);

      font-size:
        0.90rem;

    }



    .experience-bottom {

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      padding-top:
        20px;

      border-top:
        1px solid
        rgba(255,255,255,0.12);

    }



    .experience-instruction {

      color:
        rgba(255,255,255,0.72);

      font-size:
        0.75rem;

    }



    .experience-open {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

      padding:
        10px 15px;

      border:
        1px solid
        rgba(255,255,255,0.18);

      border-radius:
        999px;

      background:
        rgba(255,255,255,0.10);

      color:
        white;

      font-size:
        0.74rem;

      font-weight:
        600;

      white-space:
        nowrap;

      transition:
        all 0.25s ease;

    }



    .experience-card:hover
    .experience-open {

      background:
        var(--brand-color);

      color:
        var(--dark);

      border-color:
        var(--brand-color);

    }



    /* ========================================
       ABOUT CONTENT
    ======================================== */

    .about-content {

      position:
        relative;

    }



    .about-content .section-label {

      text-align:
        left;

    }



    .about-content h2 {

      margin-bottom:
        22px;

      color:
        var(--dark);

      font-size:
        clamp(2rem,4vw,2.8rem);

      line-height:
        1.2;

    }



    .about-content h2::after {

      content:
        "";

      display:
        block;

      width:
        65px;

      height:
        5px;

      margin-top:
        15px;

      border-radius:
        20px;

      background:
        var(--brand-color);

    }



    .about-content p {

      margin-bottom:
        20px;

      color:
        var(--text-muted);

      font-size:
        1.02rem;

    }



    .about-content strong {

      color:
        var(--dark);

    }



    /* ========================================
       SHARED 360 VIEWER
    ======================================== */

    .viewer-overlay {

      position:
        fixed;

      inset:
        0;

      z-index:
        99999;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      background:
        #020606;

      opacity:
        0;

      visibility:
        hidden;

      pointer-events:
        none;

      transition:
        opacity 0.35s ease,
        visibility 0.35s ease;

    }



    .viewer-overlay.active {

      opacity:
        1;

      visibility:
        visible;

      pointer-events:
        auto;

    }



    .viewer-shell {

      position:
        relative;

      width:
        100%;

      height:
        100%;

      overflow:
        hidden;

      background:
        #020606;

    }



    .viewer-scene {

      position:
        absolute;

      inset:
        0;

      width:
        100%;

      height:
        100%;

      touch-action:
        none;

    }



    .viewer-scene a-scene {

      width:
        100% !important;

      height:
        100% !important;

    }



    /* ========================================
       VIEWER HEADER
    ======================================== */

    .viewer-topbar {

      position:
        absolute;

      top:
        18px;

      left:
        18px;

      right:
        18px;

      z-index:
        40;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        15px;

      pointer-events:
        none;

    }



    .viewer-title {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      padding:
        11px 15px;

      border:
        1px solid
        rgba(255,255,255,0.14);

      border-radius:
        15px;

      background:
        rgba(0,0,0,0.48);

      color:
        white;

      backdrop-filter:
        blur(14px);

      -webkit-backdrop-filter:
        blur(14px);

      pointer-events:
        auto;

    }



    .viewer-title-icon {

      width:
        36px;

      height:
        36px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border-radius:
        10px;

      background:
        var(--brand-color);

      color:
        var(--dark);

      font-size:
        0.66rem;

      font-weight:
        900;

    }



    .viewer-title-text strong {

      display:
        block;

      font-size:
        0.83rem;

      line-height:
        1.2;

    }



    .viewer-title-text span {

      display:
        block;

      margin-top:
        3px;

      color:
        rgba(255,255,255,0.58);

      font-size:
        0.65rem;

    }



    .viewer-close {

      width:
        46px;

      height:
        46px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        rgba(255,255,255,0.17);

      border-radius:
        50%;

      background:
        rgba(0,0,0,0.48);

      color:
        white;

      font-size:
        1.25rem;

      cursor:
        pointer;

      backdrop-filter:
        blur(14px);

      -webkit-backdrop-filter:
        blur(14px);

      transition:
        all 0.25s ease;

      pointer-events:
        auto;

    }



    .viewer-close:hover {

      background:
        var(--brand-color);

      color:
        var(--dark);

      border-color:
        var(--brand-color);

      transform:
        rotate(90deg);

    }



    /* ========================================
       VIEWER HELP
    ======================================== */

    .viewer-help {

      position:
        absolute;

      top:
        50%;

      left:
        50%;

      z-index:
        35;

      width:
        max-content;

      max-width:
        calc(100% - 40px);

      padding:
        18px 23px;

      transform:
        translate(-50%, -50%);

      border:
        1px solid
        rgba(255,255,255,0.12);

      border-radius:
        17px;

      background:
        rgba(0,0,0,0.42);

      color:
        white;

      text-align:
        center;

      backdrop-filter:
        blur(14px);

      -webkit-backdrop-filter:
        blur(14px);

      pointer-events:
        none;

      transition:
        opacity 0.7s ease,
        transform 0.7s ease;

    }



    .viewer-help.hidden {

      opacity:
        0;

      transform:
        translate(-50%, -50%)
        scale(0.95);

    }



    .viewer-help-icon {

      margin-bottom:
        5px;

      font-size:
        2.1rem;

    }



    .viewer-help strong {

      display:
        block;

      font-size:
        0.9rem;

    }



    .viewer-help span {

      display:
        block;

      margin-top:
        4px;

      color:
        rgba(255,255,255,0.66);

      font-size:
        0.72rem;

    }



    /* ========================================
       VIEWER BADGE
    ======================================== */

    .viewer-badge {

      position:
        absolute;

      left:
        20px;

      bottom:
        24px;

      z-index:
        35;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        8px 13px;

      border:
        1px solid
        rgba(255,255,255,0.12);

      border-radius:
        999px;

      background:
        rgba(0,0,0,0.44);

      color:
        white;

      font-size:
        0.68rem;

      font-weight:
        600;

      backdrop-filter:
        blur(12px);

      -webkit-backdrop-filter:
        blur(12px);

    }



    .viewer-badge strong {

      color:
        var(--brand-color);

    }



    /* ========================================
       VIEWER CONTROLS
    ======================================== */

    .viewer-controls {

      position:
        absolute;

      left:
        50%;

      bottom:
        21px;

      z-index:
        40;

      display:
        flex;

      align-items:
        center;

      gap:
        8px;

      padding:
        9px;

      transform:
        translateX(-50%);

      border:
        1px solid
        rgba(255,255,255,0.14);

      border-radius:
        18px;

      background:
        rgba(0,0,0,0.55);

      backdrop-filter:
        blur(16px);

      -webkit-backdrop-filter:
        blur(16px);

      box-shadow:
        0 18px 50px
        rgba(0,0,0,0.30);

    }



    .viewer-control {

      min-width:
        44px;

      height:
        44px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        rgba(255,255,255,0.12);

      border-radius:
        13px;

      background:
        rgba(255,255,255,0.07);

      color:
        white;

      cursor:
        pointer;

      font-size:
        1rem;

      transition:
        all 0.22s ease;

    }



    .viewer-control:hover {

      background:
        var(--brand-color);

      color:
        var(--dark);

      border-color:
        var(--brand-color);

      transform:
        translateY(-2px);

    }



    .viewer-control.primary {

      background:
        var(--brand-color);

      color:
        var(--dark);

      border-color:
        var(--brand-color);

    }



    .viewer-control-label {

      display:
        inline-block;

      margin-left:
        4px;

      color:
        rgba(255,255,255,0.56);

      font-size:
        0.61rem;

      font-weight:
        600;

      letter-spacing:
        0.7px;

      text-transform:
        uppercase;

      pointer-events:
        none;

    }



    /* ========================================
       CONTACT
    ======================================== */

    #contact {

      position:
        relative;

      padding:
        110px 6%;

      background:
        var(--section-bg);

    }



    .contact-wrapper {

      display:
        grid;

      grid-template-columns:
        1.15fr 0.85fr;

      gap:
        30px;

      max-width:
        1250px;

      margin:
        0 auto;

      align-items:
        stretch;

    }



    /* ========================================
       MAP
    ======================================== */

    .map-card {

      position:
        relative;

      min-height:
        560px;

      overflow:
        hidden;

      border:
        1px solid
        rgba(0,0,0,0.04);

      border-radius:
        28px;

      background:
        white;

      box-shadow:
        var(--shadow);

    }



    .map {

      width:
        100%;

      height:
        100%;

      min-height:
        560px;

    }



    .map iframe {

      width:
        100%;

      height:
        100%;

      display:
        block;

      border:
        0;

    }



    .map-label {

      position:
        absolute;

      top:
        20px;

      left:
        20px;

      z-index:
        2;

      padding:
        10px 16px;

      border-radius:
        12px;

      background:
        rgba(255,255,255,0.95);

      color:
        var(--dark);

      font-size:
        0.8rem;

      font-weight:
        600;

      box-shadow:
        0 8px 25px
        rgba(0,0,0,0.12);

      backdrop-filter:
        blur(8px);

    }



    /* ========================================
       CONTACT CARD
    ======================================== */

    .contact-card {

      position:
        relative;

      display:
        flex;

      flex-direction:
        column;

      justify-content:
        center;

      overflow:
        hidden;

      padding:
        45px;

      border-radius:
        28px;

      background:
        var(--dark);

      color:
        white;

      box-shadow:
        var(--shadow-heavy);

    }



    .contact-card::before {

      content:
        "";

      position:
        absolute;

      width:
        260px;

      height:
        260px;

      top:
        -120px;

      right:
        -100px;

      border-radius:
        50%;

      background:
        rgba(255,215,0,0.06);

    }



    .contact-card::after {

      content:
        "";

      position:
        absolute;

      width:
        180px;

      height:
        180px;

      bottom:
        -90px;

      left:
        -80px;

      border:
        1px solid
        rgba(255,215,0,0.12);

      border-radius:
        50%;

    }



    .contact-card-content {

      position:
        relative;

      z-index:
        2;

    }



    .contact-eyebrow {

      margin-bottom:
        12px;

      color:
        var(--brand-color);

      font-size:
        0.75rem;

      font-weight:
        700;

      letter-spacing:
        2px;

      text-transform:
        uppercase;

    }



    .contact-card h3 {

      margin-bottom:
        15px;

      font-size:
        clamp(1.8rem,3vw,2.35rem);

      line-height:
        1.2;

    }



    .contact-intro {

      margin-bottom:
        35px;

      color:
        rgba(255,255,255,0.70);

      font-size:
        0.95rem;

    }



    .contact-details {

      display:
        flex;

      flex-direction:
        column;

      gap:
        22px;

    }



    .contact-item {

      display:
        flex;

      align-items:
        flex-start;

      gap:
        15px;

    }



    .contact-icon {

      flex:
        0 0 45px;

      width:
        45px;

      height:
        45px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      border:
        1px solid
        rgba(255,215,0,0.18);

      border-radius:
        13px;

      background:
        rgba(255,215,0,0.10);

      color:
        var(--brand-color);

      font-size:
        1.15rem;

    }



    .contact-item-text {

      min-width:
        0;

    }



    .contact-item-label {

      display:
        block;

      margin-bottom:
        2px;

      color:
        rgba(255,255,255,0.45);

      font-size:
        0.68rem;

      letter-spacing:
        1.5px;

      text-transform:
        uppercase;

    }



    .contact-item a,
    .contact-item span.value {

      color:
        white;

      font-size:
        0.92rem;

      word-break:
        break-word;

    }



    .contact-item a {

      transition:
        color 0.25s ease;

    }



    .contact-item a:hover {

      color:
        var(--brand-color);

    }



    .business-hours {

      margin-top:
        32px;

      padding-top:
        25px;

      border-top:
        1px solid
        rgba(255,255,255,0.10);

    }



    .business-hours-title {

      margin-bottom:
        10px;

      color:
        white;

      font-size:
        0.85rem;

      font-weight:
        600;

    }



    .business-hours p {

      color:
        rgba(255,255,255,0.60);

      font-size:
        0.82rem;

    }



    .contact-btn {

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      gap:
        10px;

      margin-top:
        30px;

      padding:
        15px 22px;

      border-radius:
        14px;

      background:
        var(--brand-color);

      color:
        var(--dark);

      font-size:
        0.9rem;

      font-weight:
        700;

      box-shadow:
        0 8px 20px
        rgba(255,215,0,0.15);

      transition:
        all 0.3s ease;

    }



    .contact-btn:hover {

      background:
        white;

      transform:
        translateY(-3px);

      box-shadow:
        0 12px 25px
        rgba(255,255,255,0.10);

    }



    /* ========================================
       FOOTER
    ======================================== */

    footer {

      padding:
        35px 20px;

      background:
        #111;

      color:
        rgba(255,255,255,0.60);

      text-align:
        center;

      font-size:
        0.82rem;

    }



    footer strong {

      color:
        var(--brand-color);

    }



    /* ========================================
       TABLET
    ======================================== */

    @media (max-width: 992px) {

      #about {

        grid-template-columns:
          1fr;

        gap:
          50px;

        padding:
          85px 7%;

      }



      .about-content {

        text-align:
          center;

      }



      .about-content .section-label {

        text-align:
          center;

      }



      .about-content h2::after {

        margin-left:
          auto;

        margin-right:
          auto;

      }



      .contact-wrapper {

        grid-template-columns:
          1fr;

      }



      .map-card,
      .map {

        min-height:
          400px;

      }



      .experience-card,
      .experience-card-content {

        min-height:
          460px;

      }

    }



    /* ========================================
       MOBILE
    ======================================== */

    @media (max-width: 600px) {

      .hero {

        min-height:
          620px;

      }



      .hero-text {

        width:
          calc(100% - 30px);

        padding:
          40px 25px;

        border-radius:
          22px;

      }



      .hero-logo {

        width:
          130px;

      }



      .hero-kicker {

        font-size:
          0.58rem;

        letter-spacing:
          2px;

      }



      .hero-text p {

        font-size:
          0.95rem;

      }



      .hero-btn {

        padding:
          14px 28px;

        font-size:
          0.90rem;

      }



      .hero-video-label {

        top:
          86px;

        left:
          15px;

        padding:
          8px 11px;

        font-size:
          0.58rem;

      }



      .hero-video-tools {

        top:
          85px;

        right:
          15px;

      }



      .hero-video-tool {

        width:
          40px;

        height:
          40px;

        font-size:
          0.82rem;

      }



      .video-fullscreen-hint {

        right:
          15px;

        bottom:
          15px;

        padding:
          8px 11px;

        font-size:
          0.65rem;

      }



      .hero-bottom-meta {

        left:
          15px;

        right:
          15px;

        bottom:
          15px;

      }



      .hero-scroll-text {

        font-size:
          0.52rem;

      }



      .hero-scroll-line {

        width:
          90px;

      }



      #about {

        padding:
          70px 20px;

      }



      .about-image-stack {

        padding:
          0 10px 10px 0;

      }



      .experience-card {

        min-height:
          390px;

        border-radius:
          22px;

      }



      .experience-card-content {

        min-height:
          390px;

        padding:
          24px;

      }



      .experience-center {

        padding:
          10px;

      }



      .experience-play {

        width:
          75px;

        height:
          75px;

        font-size:
          1.35rem;

      }



      .experience-center h3 {

        font-size:
          1.5rem;

      }



      .experience-center p {

        font-size:
          0.82rem;

      }



      .experience-bottom {

        flex-direction:
          column;

        align-items:
          flex-start;

      }



      .experience-open {

        align-self:
          flex-start;

      }



      .viewer-topbar {

        top:
          10px;

        left:
          10px;

        right:
          10px;

      }



      .viewer-title {

        padding:
          9px 11px;

      }



      .viewer-title-icon {

        width:
          30px;

        height:
          30px;

      }



      .viewer-title-text strong {

        font-size:
          0.74rem;

      }



      .viewer-title-text span {

        font-size:
          0.59rem;

      }



      .viewer-close {

        width:
          42px;

        height:
          42px;

      }



      .viewer-help {

        width:
          calc(100% - 40px);

      }



      .viewer-controls {

        bottom:
          15px;

        gap:
          5px;

        padding:
          7px;

        border-radius:
          15px;

      }



      .viewer-control {

        min-width:
          40px;

        height:
          40px;

        border-radius:
          11px;

      }



      .viewer-control-label {

        display:
          none;

      }



      .viewer-badge {

        left:
          12px;

        bottom:
          18px;

      }



      #contact {

        padding:
          70px 15px;

      }



      .contact-card {

        padding:
          32px 25px;

        border-radius:
          22px;

      }



      .map-card {

        border-radius:
          22px;

      }



      .map,
      .map-card {

        min-height:
          330px;

      }



      .contact-icon {

        flex-basis:
          40px;

        width:
          40px;

        height:
          40px;

      }

    }

  </style>

</head>



<body>



  <!-- ======================================
       NAVBAR
  ======================================= -->

  <%- include('partials/navbar') %>



  <!-- ======================================
       HERO
  ======================================= -->

  <section
    class="hero"
    id="home"
  >



    <!-- ====================================
         CINEMATIC HERO VIDEO
    ===================================== -->

    <video
      id="heroResortVideo"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/resort1.jpg"
      aria-label="Puffer Isle Resort cinematic video"
    >

      <source
        src="/videos/forindexnavideo.mp4"
        type="video/mp4"
      >

      Your browser does not support HTML5 video.

    </video>



    <div class="hero-video-overlay"></div>



    <!-- ====================================
         HERO LABEL
    ===================================== -->

    <div class="hero-video-label">

      <span class="hero-video-dot"></span>

      <span>
        Puffer Isle Cinematic
      </span>

    </div>



    <!-- ====================================
         HERO CONTROLS
    ===================================== -->

    <div class="hero-video-tools">



      <button
        type="button"
        id="heroMuteBtn"
        class="hero-video-tool"
        aria-label="Turn sound on"
        title="Sound"
      >

        🔇

      </button>



      <button
        type="button"
        id="heroImmersiveBtn"
        class="hero-video-tool"
        aria-label="Open immersive 360 experience"
        title="Immersive 360"
      >

        ◉

        <span class="hero-360-bubble">
          360
        </span>

      </button>

    </div>



    <!-- ====================================
         HERO HINT
    ===================================== -->

    <div class="video-fullscreen-hint">

      <span class="video-fullscreen-icon">
        ⛶
      </span>

      Explore immersive view

    </div>



    <!-- ====================================
         HERO CONTENT
    ===================================== -->

    <div class="hero-text">

      <img
        src="/images/islelogo.png"
        alt="Puffer Isle Resort Logo"
        class="hero-logo"
      >



      <div class="hero-kicker">

        ESCAPE. EXPLORE. EXPERIENCE.

      </div>



      <h2>

        Experience

        <span>
          Puffer Isle
        </span>

      </h2>



      <p>

        A sanctuary where the sky kisses the sea

        and luxury meets the wild.

      </p>



      <% if (user) { %>

        <a
          href="/booking"
          class="hero-btn"
        >

          Start Your Journey

          <span class="hero-btn-arrow">
            →
          </span>

        </a>

      <% } else { %>

        <a
          href="#"
          id="heroBookingBtn"
          class="hero-btn"
        >

          Start Your Journey

          <span class="hero-btn-arrow">
            →
          </span>

        </a>

      <% } %>

    </div>



    <!-- ====================================
         HERO BOTTOM META
    ===================================== -->

    <div class="hero-bottom-meta">

      <div class="hero-scroll-text">

        SCROLL TO DISCOVER

      </div>



      <div class="hero-scroll-line">

        <span></span>

      </div>

    </div>

  </section>



  <!-- ======================================
       SHARED IMMERSIVE 360 VIEWER
  ======================================= -->

  <div
    class="viewer-overlay"
    id="viewerOverlay"
    aria-hidden="true"
  >

    <div
      class="viewer-shell"
      id="viewerShell"
    >



      <!-- ====================================
           A-FRAME SCENE
      ===================================== -->

      <div class="viewer-scene">

        <a-scene
          embedded
          id="shared360Scene"
          vr-mode-ui="enabled: false"
          device-orientation-permission-ui="enabled: true"
          renderer="antialias: true; colorManagement: true"
          loading-screen="enabled: false"
        >



          <a-assets>

            <!--
              One shared video element.
              JavaScript switches this source between:
              1. /videos/forindexnavideo.mp4
              2. /videos/arvideoofresort.mp4
            -->

            <video
              id="shared360Video"
              preload="auto"
              loop
              muted
              playsinline
              webkit-playsinline
              crossorigin="anonymous"
            ></video>

          </a-assets>



          <!-- ==================================
               360 SPHERE
          =================================== -->

          <a-videosphere
            id="shared360Sphere"
            src="#shared360Video"
            rotation="0 180 0"
          ></a-videosphere>



          <!-- ==================================
               CAMERA
          =================================== -->

          <a-entity
            id="shared360Camera"
            camera
            position="0 0 0"
            look-controls="
              enabled: true;
              magicWindowTrackingEnabled: true;
              touchEnabled: true
            "
            wasd-controls="
              enabled: false
            "
          ></a-entity>



        </a-scene>

      </div>



      <!-- ====================================
           VIEWER TOP BAR
      ===================================== -->

      <div class="viewer-topbar">



        <div class="viewer-title">

          <div class="viewer-title-icon">

            360°

          </div>



          <div class="viewer-title-text">

            <strong
              id="viewerTitle"
            >

