<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#171717">
  <meta
    name="description"
    content="Guest dashboard for Puffer Isle Resort — manage stays, reservations, notifications, and account security."
  >

  <title>
    <%= title || "Guest Dashboard | Puffer Isle Resort" %>
  </title>

  <link rel="icon" type="image/png" href="/images/islelogo.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <% if (typeof csrfToken !== "undefined" && csrfToken) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>

  <style>
    /* ============================================================
       PUFFER ISLE RESORT | ISLERMS
       GUEST DASHBOARD — PREMIUM UI SYSTEM
       ============================================================ */

    :root {
      /* Brand */
      --gold: #ffd700;
      --gold-bright: #ffe34d;
      --gold-dark: #d9b800;
      --gold-soft: #fffbea;
      --gold-wash: rgba(255, 215, 0, 0.08);

      --teal: #008080;
      --teal-dark: #006666;
      --teal-light: #0b9a96;
      --teal-soft: #eaf8f7;

      /* Neutrals */
      --ink: #171717;
      --ink-soft: #222222;
      --charcoal: #2a2a2a;
      --muted: #707070;
      --muted-light: #949494;

      --page-bg: #eef2f3;
      --surface: #ffffff;
      --surface-soft: #fafbfb;
      --surface-alt: #f5f7f8;

      --border: #e7e9eb;
      --border-strong: #d9dddf;

      /* Semantic */
      --success: #16803c;
      --success-bg: #edf9f1;
      --success-border: #cdebd7;

      --warning: #996b00;
      --warning-bg: #fff8df;
      --warning-border: #f0df9d;

      --danger: #c62828;
      --danger-bg: #fff1f1;
      --danger-border: #f1d0d0;

      --info: #1971c2;
      --info-bg: #edf6ff;
      --info-border: #cfe5fa;

      --purple: #6741d9;
      --purple-bg: #f3f0ff;

      /* Shadows */
      --shadow-xs:
        0 2px 8px rgba(0, 0, 0, 0.035);

      --shadow-sm:
        0 8px 25px rgba(0, 0, 0, 0.06);

      --shadow-md:
        0 16px 45px rgba(0, 0, 0, 0.08);

      --shadow-lg:
        0 30px 80px rgba(0, 0, 0, 0.14);

      --shadow-gold:
        0 14px 35px rgba(255, 215, 0, 0.15);

      /* Radius */
      --radius-xs: 8px;
      --radius-sm: 12px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --radius-xl: 34px;
      --pill: 999px;

      /* Layout */
      --content-width: 1240px;
    }


    /* ============================================================
       RESET
       ============================================================ */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      margin: 0;

      font-family: "Poppins", sans-serif;
      color: var(--ink);
      line-height: 1.6;

      background:
        radial-gradient(
          circle at 5% 0%,
          rgba(255, 215, 0, 0.11),
          transparent 26%
        ),
        radial-gradient(
          circle at 96% 8%,
          rgba(0, 128, 128, 0.09),
          transparent 23%
        ),
        linear-gradient(
          145deg,
          #f8fafb 0%,
          #eef2f3 52%,
          #e9eff0 100%
        );
    }

    body.modal-open {
      overflow: hidden;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button,
    a,
    input,
    select,
    textarea {
      -webkit-tap-highlight-color: transparent;
    }

    button {
      border: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      max-width: 100%;
    }

    ::selection {
      background: rgba(255, 215, 0, 0.35);
      color: var(--ink);
    }


    /* ============================================================
       ACCESSIBILITY
       ============================================================ */

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    :focus-visible {
      outline: 3px solid rgba(0, 128, 128, 0.25);
      outline-offset: 3px;
    }


    /* ============================================================
       MAIN SHELL
       ============================================================ */

    .profile-container {
      position: relative;

      width: min(
        var(--content-width),
        calc(100% - 32px)
      );

      margin: 112px auto 60px;

      overflow: hidden;

      background: var(--surface);

      border:
        1px solid
        rgba(255, 255, 255, 0.85);

      border-radius: var(--radius-xl);

      box-shadow: var(--shadow-lg);

      animation:
        dashboardEnter
        0.75s
        cubic-bezier(0.22, 1, 0.36, 1)
        both;
    }

    @keyframes dashboardEnter {
      from {
        opacity: 0;
        transform: translateY(28px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }


    /* ============================================================
       HERO
       ============================================================ */

    .profile-header {
      position: relative;
      overflow: hidden;

      padding: 48px 48px 44px;

      color: #fff;

      background:
        radial-gradient(
          circle at 85% 5%,
          rgba(255, 215, 0, 0.16),
          transparent 31%
        ),
        radial-gradient(
          circle at 5% 95%,
          rgba(0, 128, 128, 0.17),
          transparent 30%
        ),
        linear-gradient(
          140deg,
          #151515 0%,
          #1b1b1b 50%,
          #252525 100%
        );

      border-bottom:
        1px solid
        rgba(255, 255, 255, 0.06);
    }

    .profile-header::before {
      content: "";

      position: absolute;
      top: -120px;
      right: -100px;

      width: 330px;
      height: 330px;

      border:
        1px solid
        rgba(255, 215, 0, 0.12);

      border-radius: 50%;

      box-shadow:
        0 0 0 38px rgba(255, 215, 0, 0.025),
        0 0 0 76px rgba(255, 215, 0, 0.018);
    }

    .profile-header::after {
      content: "";

      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;

      height: 3px;

      background:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(255, 215, 0, 0.35) 15%,
          var(--gold) 50%,
          rgba(255, 215, 0, 0.35) 85%,
          transparent 100%
        );
    }

    .hero-grid {
      position: relative;
      z-index: 1;

      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        auto;

      align-items: center;

      gap: 35px;
    }

    .hero-identity {
      min-width: 0;

      display: flex;
      align-items: center;

      gap: 22px;
    }

    .hero-avatar-wrap {
      position: relative;
      flex: 0 0 auto;
    }

    .hero-avatar {
      width: 104px;
      height: 104px;

      object-fit: cover;

      background:
        linear-gradient(
          135deg,
          #111,
          #252525
        );

      border:
        4px solid
        var(--gold);

      border-radius: 50%;

      box-shadow:
        0 14px 35px rgba(0, 0, 0, 0.35),
        0 0 0 8px rgba(255, 215, 0, 0.05);
    }

    .hero-avatar-status {
      position: absolute;

      right: 2px;
      bottom: 8px;

      width: 18px;
      height: 18px;

      background: #51cf66;

      border:
        4px solid
        #1a1a1a;

      border-radius: 50%;
    }

    .hero-copy {
      min-width: 0;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 9px;

      margin-bottom: 7px;

      color: var(--gold);

      font-size: 0.67rem;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .hero-kicker::before {
      content: "";

      width: 24px;
      height: 2px;

      background: var(--gold);
      border-radius: var(--pill);
    }

    .profile-header h1 {
      margin: 0;

      color: #fff;

      font-size: clamp(
        1.9rem,
        4vw,
        2.8rem
      );

      line-height: 1.08;

      font-weight: 800;

      letter-spacing: -1px;

      word-break: break-word;
    }

    .profile-handle {
      margin-top: 7px;

      color:
        rgba(255, 255, 255, 0.66);

      font-size: 0.79rem;
    }

    .member-since {
      margin-top: 6px;

      color:
        rgba(255, 255, 255, 0.42);

      font-size: 0.61rem;
      font-weight: 600;

      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;

      gap: 8px;

      margin-top: 16px;
    }

    .hero-meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      padding: 7px 10px;

      color:
        rgba(255, 255, 255, 0.72);

      background:
        rgba(255, 255, 255, 0.055);

      border:
        1px solid
        rgba(255, 255, 255, 0.09);

      border-radius: var(--pill);

      font-size: 0.62rem;
      font-weight: 600;
    }

    .hero-meta-chip strong {
      color: #fff;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;

      gap: 9px;
    }

    .header-btn {
      appearance: none;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;

      min-height: 44px;

      padding: 11px 17px;

      color: #fff;
      background:
        rgba(255, 255, 255, 0.06);

      border:
        1px solid
        rgba(255, 255, 255, 0.13);

      border-radius: var(--pill);

      cursor: pointer;

      font-size: 0.72rem;
      font-weight: 700;

      transition:
        transform 0.22s ease,
        background 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .header-btn:hover {
      transform: translateY(-2px);

      background:
        rgba(255, 255, 255, 0.1);

      border-color:
        rgba(255, 255, 255, 0.18);

      box-shadow:
        0 10px 24px
        rgba(0, 0, 0, 0.18);
    }

    .header-btn.primary {
      color: var(--ink);
      background: var(--gold);
      border-color: var(--gold);

      box-shadow:
        0 10px 28px
        rgba(255, 215, 0, 0.15);
    }

    .header-btn.primary:hover {
      background: var(--gold-bright);
      border-color: var(--gold-bright);
      box-shadow: var(--shadow-gold);
    }

    .account-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;

      margin-top: 14px;

      padding: 7px 11px;

      color:
        rgba(255, 255, 255, 0.73);

      background:
        rgba(255, 255, 255, 0.045);

      border:
        1px solid
        rgba(255, 255, 255, 0.08);

      border-radius: var(--pill);

      font-size: 0.61rem;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.9px;
    }

    .status-dot {
      position: relative;

      width: 7px;
      height: 7px;

      flex: 0 0 auto;

      background: #51cf66;

      border-radius: 50%;

      box-shadow:
        0 0 0 4px
        rgba(81, 207, 102, 0.08);
    }


    /* ============================================================
       KPI STRIP
       ============================================================ */

    .user-stats {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      background:
        linear-gradient(
          135deg,
          #1a1a1a,
          #222222
        );

      border-top:
        1px solid
        rgba(255, 255, 255, 0.05);

      border-bottom:
        1px solid
        rgba(255, 255, 255, 0.05);
    }

    .stat-item {
      position: relative;

      min-width: 0;

      padding: 23px 22px;

      border-right:
        1px solid
        rgba(255, 255, 255, 0.07);
    }

    .stat-item:last-child {
      border-right: none;
    }

    .stat-item::before {
      content: "";

      position: absolute;

      top: 0;
      left: 22px;

      width: 28px;
      height: 2px;

      background: var(--gold);

      opacity: 0.45;

      border-radius: var(--pill);
    }

    .stat-label {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 10px;

      margin-bottom: 7px;

      color:
        rgba(255, 255, 255, 0.43);

      font-size: 0.59rem;
      font-weight: 600;

      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .stat-value {
      min-height: 30px;

      color: var(--gold);

      font-size: 1.55rem;
      line-height: 1.15;

      font-weight: 800;

      letter-spacing: -0.4px;
    }

    .stat-subvalue {
      margin-top: 5px;

      color:
        rgba(255, 255, 255, 0.3);

      font-size: 0.59rem;

      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .stat-badge {
      display: inline-flex;
      align-items: center;

      padding: 3px 7px;

      color:
        rgba(255, 215, 0, 0.86);

      background:
        rgba(255, 215, 0, 0.07);

      border:
        1px solid
        rgba(255, 215, 0, 0.11);

      border-radius: var(--pill);

      font-size: 0.48rem;
      font-weight: 700;

      letter-spacing: 0.6px;
    }


    /* ============================================================
       FLASH MESSAGES
       ============================================================ */

    .flash-stack {
      padding: 20px 46px 0;
    }

    .flash {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 14px;

      padding: 13px 15px;

      border:
        1px solid
        var(--border);

      border-radius: var(--radius-sm);

      background:
        linear-gradient(
          135deg,
          #fbfbfb,
          #f7f7f7
        );

      font-size: 0.73rem;
      font-weight: 600;

      animation:
        flashIn
        0.3s ease-out;
    }

    @keyframes flashIn {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .flash.success {
      color: var(--success);

      background:
        linear-gradient(
          135deg,
          #f3fbf5,
          #eef9f1
        );

      border-color:
        var(--success-border);
    }

    .flash.error {
      color: var(--danger);

      background:
        linear-gradient(
          135deg,
          #fff7f7,
          #fff1f1
        );

      border-color:
        var(--danger-border);
    }

    .flash-close {
      width: 28px;
      height: 28px;

      display: grid;
      place-items: center;

      flex: 0 0 auto;

      color: currentColor;
      background: transparent;

      border-radius: 50%;

      cursor: pointer;

      font-size: 1rem;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .flash-close:hover {
      background:
        rgba(0, 0, 0, 0.05);

      transform: rotate(4deg);
    }


    /* ============================================================
       SECTIONS
       ============================================================ */

    .section {
      padding: 40px 46px;

      border-bottom:
        1px solid
        #f0f1f2;
    }

    .section:last-of-type {
      border-bottom: none;
    }

    .section-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 20px;

      margin-bottom: 23px;
    }

    .section-title-wrap {
      min-width: 0;
    }

    .section h2 {
      display: flex;
      align-items: center;

      gap: 12px;

      margin: 0;

      color: var(--ink);

      font-size: 1.17rem;

      line-height: 1.25;

      font-weight: 800;

      letter-spacing: -0.2px;
    }

    .section h2::before {
      content: "";

      width: 5px;
      height: 27px;

      flex: 0 0 auto;

      background:
        linear-gradient(
          180deg,
          var(--gold),
          var(--gold-dark)
        );

      border-radius: var(--pill);

      box-shadow:
        0 5px 15px
        rgba(255, 215, 0, 0.18);
    }

    .section-subtitle {
      margin: 6px 0 0;

      color: var(--muted);

      font-size: 0.72rem;
      line-height: 1.6;
    }

    .refresh-status {
      min-height: 20px;

      color: var(--teal);

      font-size: 0.6rem;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 0.9px;

      white-space: nowrap;
    }

    .inline-actions {
      display: flex;
      align-items: center;

      gap: 8px;

      flex-wrap: wrap;

      justify-content: flex-end;
    }


    /* ============================================================
       BUTTON SYSTEM
       ============================================================ */

    .tiny-btn,
    .filter-button,
    .table-action,
    .secondary-btn,
    .danger-btn {
      appearance: none;

      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 36px;

      color: #636363;
      background: #fff;

      border:
        1px solid
        var(--border);

      border-radius: var(--pill);

      cursor: pointer;

      font-size: 0.63rem;
      font-weight: 700;

      transition:
        transform 0.2s ease,
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .tiny-btn,
    .filter-button {
      padding: 8px 13px;
    }

    .tiny-btn:hover,
    .filter-button:hover {
      transform: translateY(-1px);

      border-color: var(--border-strong);

      background: #fafafa;

      box-shadow:
        0 7px 18px
        rgba(0, 0, 0, 0.045);
    }

    .tiny-btn.dark {
      color: var(--gold);
      background: var(--ink);
      border-color: var(--ink);
    }

    .tiny-btn.dark:hover {
      color: var(--gold-bright);
      background: #262626;
      border-color: #262626;
    }

    .filter-button.active {
      color: var(--gold);
      background: var(--ink);
      border-color: var(--ink);

      box-shadow:
        0 8px 18px
        rgba(0, 0, 0, 0.09);
    }

    .tiny-btn:disabled,
    .filter-button:disabled,
    .table-action:disabled,
    .secondary-btn:disabled,
    .danger-btn:disabled {
      opacity: 0.48;

      cursor: not-allowed;

      transform: none !important;

      box-shadow: none !important;
    }


    /* ============================================================
       NEXT STAY
       ============================================================ */

    .stay-card {
      position: relative;
      overflow: hidden;

      padding: 24px;

      background:
        radial-gradient(
          circle at 100% 0%,
          rgba(255, 215, 0, 0.1),
          transparent 28%
        ),
        linear-gradient(
          135deg,
          #fffef8,
          #ffffff
        );

      border:
        1px solid
        #ececec;

      border-radius: 22px;

      box-shadow:
        0 10px 35px
        rgba(0, 0, 0, 0.035);
    }

    .stay-card::before {
      content: "";

      position: absolute;

      left: 0;
      top: 0;
      bottom: 0;

      width: 4px;

      background:
        linear-gradient(
          180deg,
          var(--gold),
          var(--gold-dark)
        );
    }

    .stay-card.empty {
      background:
        linear-gradient(
          135deg,
          #fbfbfb,
          #f7f8f8
        );
    }

    .stay-card.empty::before {
      background: var(--border);
    }

    .stay-topline {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 16px;

      margin-bottom: 17px;
    }

    .stay-kicker {
      margin-bottom: 4px;

      color: var(--teal);

      font-size: 0.59rem;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .stay-title {
      color: var(--ink);

      font-size: 1.16rem;
      line-height: 1.25;

      font-weight: 800;
    }

    .stay-ref {
      margin-top: 4px;

      color: var(--muted-light);

      font-size: 0.62rem;
    }

    .countdown-pill {
      display: inline-flex;
      align-items: center;

      padding: 7px 11px;

      color: var(--gold);

      background: var(--ink);

      border-radius: var(--pill);

      font-size: 0.59rem;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 0.6px;

      white-space: nowrap;

      box-shadow:
        0 7px 20px
        rgba(0, 0, 0, 0.1);
    }

    .stay-grid {
      display: grid;

      grid-template-columns:
        repeat(4, minmax(0, 1fr));

      gap: 10px;
    }

    .stay-detail {
      min-width: 0;

      padding: 13px 14px;

      background:
        rgba(255, 255, 255, 0.84);

      border:
        1px solid
        #ededed;

      border-radius: 15px;
    }

    .stay-detail small {
      display: block;

      margin-bottom: 4px;

      color: #999;

      font-size: 0.56rem;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.75px;
    }

    .stay-detail strong {
      display: block;

      color: var(--ink);

      font-size: 0.74rem;

      word-break: break-word;
    }

    .stay-actions {
      display: flex;
      align-items: center;

      gap: 8px;

      margin-top: 18px;

      flex-wrap: wrap;
    }


    /* ============================================================
       TOOLBAR
       ============================================================ */

    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      margin-bottom: 15px;

      flex-wrap: wrap;
    }

    .toolbar-left,
    .toolbar-right {
      display: flex;
      align-items: center;

      gap: 7px;

      flex-wrap: wrap;
    }

    .search-box {
      width: min(300px, 100%);

      min-height: 38px;

      padding: 9px 15px;

      color: var(--ink);
      background: #fff;

      border:
        1px solid
        var(--border);

      border-radius: var(--pill);

      outline: none;

      font-size: 0.66rem;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
    }

    .search-box::placeholder {
      color: #aaa;
    }

    .search-box:hover {
      border-color: var(--border-strong);
    }

    .search-box:focus {
      background: #fff;

      border-color: var(--teal);

      box-shadow:
        0 0 0 4px
        rgba(0, 128, 128, 0.08);
    }


    /* ============================================================
       BOOKINGS
       ============================================================ */

    .table-wrapper {
      overflow-x: auto;

      background: #fff;

      border:
        1px solid
        var(--border);

      border-radius: 20px;

      scrollbar-width: thin;
    }

    .table-wrapper::-webkit-scrollbar {
      height: 7px;
    }

    .table-wrapper::-webkit-scrollbar-track {
      background: #f5f5f5;
      border-radius: var(--pill);
    }

    .table-wrapper::-webkit-scrollbar-thumb {
      background: #d5d5d5;
      border-radius: var(--pill);
    }

    table {
      width: 100%;
      min-width: 880px;

      border-collapse: collapse;
    }

    th {
      padding: 14px 17px;

      color: #9b9b9b;

      background:
        linear-gradient(
          180deg,
          #fcfcfc,
          #fafafa
        );

      border-bottom:
        1px solid
        #ededed;

      text-align: left;

      font-size: 0.57rem;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 1px;

      white-space: nowrap;
    }

    td {
      padding: 15px 17px;

      border-top:
        1px solid
        #f2f2f2;

      color: #555;

      font-size: 0.72rem;

      vertical-align: middle;
    }

    tbody tr {
      transition:
        background 0.2s ease;
    }

    tbody tr:hover {
      background:
        rgba(255, 215, 0, 0.025);
    }

    .booking-room {
      display: block;

      color: var(--ink);

      font-size: 0.75rem;
      font-weight: 800;

      line-height: 1.35;
    }

    .booking-id {
      display: block;

      margin-top: 4px;

      color: #aaa;

      font-size: 0.57rem;
    }

    .booking-total {
      color: var(--ink);

      font-size: 0.73rem;

      font-weight: 800;

      white-space: nowrap;
    }

    .table-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;

      gap: 6px;
    }

    .table-action {
      min-height: 32px;

      padding: 7px 10px;

      font-size: 0.58rem;

      white-space: nowrap;
    }

    .table-action.primary {
      color: var(--teal-dark);

      background: var(--teal-soft);

      border-color:
        rgba(0, 128, 128, 0.1);
    }

    .table-action.primary:hover {
      background: #def2f0;

      border-color:
        rgba(0, 128, 128, 0.18);
    }

    .table-action.danger {
      color: var(--danger);

      background: var(--danger-bg);

      border-color:
        var(--danger-border);
    }

    .table-action.danger:hover {
      background: #ffe7e7;
    }


    /* ============================================================
       STATUS BADGES
       ============================================================ */

    .status {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 26px;

      padding: 5px 10px;

      border-radius: var(--pill);

      font-size: 0.56rem;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 0.45px;

      white-space: nowrap;
    }

    .status.pending {
      color: var(--warning);
      background: var(--warning-bg);
    }

    .status.accepted,
    .status.confirmed {
      color: var(--success);
      background: var(--success-bg);
    }

    .status.declined,
    .status.rejected {
      color: var(--danger);
      background: var(--danger-bg);
    }

    .status.cancelled {
      color: #777;
      background: #f1f3f5;
    }

    .status.checked-in {
      color: var(--info);
      background: var(--info-bg);
    }

    .status.checked-out,
    .status.completed {
      color: var(--purple);
      background: var(--purple-bg);
    }


    /* ============================================================
       EMPTY / LOADING STATES
       ============================================================ */

    .empty-state {
      padding: 42px 25px;

      text-align: center;

      color: #888;
    }

    .empty-state-icon {
      width: 52px;
      height: 52px;

      display: grid;
      place-items: center;

      margin:
        0 auto 12px;

      background:
        linear-gradient(
          135deg,
          #fffdf1,
          #f4f7f7
        );

      border:
        1px solid
        #f0ebc7;

      border-radius: 50%;

      font-size: 1.25rem;

      box-shadow:
        0 8px 22px
        rgba(0, 0, 0, 0.04);
    }

    .empty-state-title {
      margin-bottom: 4px;

      color: #444;

      font-size: 0.78rem;
      font-weight: 800;
    }

    .empty-state-text {
      font-size: 0.68rem;
      line-height: 1.6;
    }

    .loading-row td {
      padding: 40px;

      color: #999;

      text-align: center;

      font-size: 0.68rem;
    }


    /* ============================================================
       NOTIFICATIONS
       ============================================================ */

    .notification-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 12px;

      margin-bottom: 18px;

      flex-wrap: wrap;
    }

    .notification-filters,
    .notification-actions {
      display: flex;
      align-items: center;

      gap: 7px;

      flex-wrap: wrap;
    }

    .notification-list {
      display: grid;
      gap: 11px;
    }

    .notification {
      position: relative;

      display: flex;
      align-items: flex-start;

      gap: 13px;

      padding: 16px;

      background: #fff;

      border:
        1px solid
        var(--border);

      border-radius: 18px;

      box-shadow:
        0 2px 8px
        rgba(0, 0, 0, 0.018);

      transition:
        transform 0.22s ease,
        box-shadow 0.22s ease,
        border-color 0.22s ease,
        background 0.22s ease;
    }

    .notification:hover {
      transform: translateY(-2px);

      box-shadow:
        var(--shadow-sm);

      border-color:
        #dedfe1;
    }

    .notification.unread {
      background:
        linear-gradient(
          135deg,
          #fffef5,
          #fffdfa
        );
    }

    .notification.archived {
      opacity: 0.72;
    }

    .notification.pending {
      border-left:
        4px solid
        var(--warning);
    }

    .notification.accepted,
    .notification.confirmed {
      border-left:
        4px solid
        var(--success);
    }

    .notification.declined,
    .notification.rejected {
      border-left:
        4px solid
        var(--danger);
    }

    .notification.cancelled {
      border-left:
        4px solid
        #868e96;
    }

    .notification.checked-in {
      border-left:
        4px solid
        var(--info);
    }

    .notification.checked-out,
    .notification.completed {
      border-left:
        4px solid
        var(--purple);
    }

    .notification-icon {
      width: 44px;
      height: 44px;

      flex: 0 0 44px;

      display: grid;
      place-items: center;

      background:
        linear-gradient(
          135deg,
          #f7f7f7,
          #f1f3f3
        );

      border:
        1px solid
        #ececec;

      border-radius: 14px;

      font-size: 1rem;
    }

    .notification-content {
      min-width: 0;
      flex: 1;
    }

    .notification-title {
      margin: 0 0 4px;

      padding-right: 18px;

      color: var(--ink);

      font-size: 0.79rem;
      font-weight: 800;

      line-height: 1.4;
    }

    .notification-message {
      margin: 0;

      color: #666;

      font-size: 0.68rem;
      line-height: 1.65;

      word-break: break-word;
    }

    .notification-meta {
      display: flex;
      align-items: center;

      gap: 6px;

      margin-top: 8px;

      flex-wrap: wrap;

      color: #999;

      font-size: 0.56rem;
    }

    .notification-actions {
      margin-left: auto;

      align-self: flex-start;

      justify-content: flex-end;
    }

    .notification-actions .tiny-btn {
      min-height: 30px;

      padding: 6px 9px;

      font-size: 0.55rem;
    }

    .unread-dot {
      position: absolute;

      top: 13px;
      right: 13px;

      width: 7px;
      height: 7px;

      background: var(--gold);

      border-radius: 50%;

      box-shadow:
        0 0 0 4px
        rgba(255, 215, 0, 0.08);
    }

    .notification-badge {
      display: inline-flex;
      align-items: center;

      padding: 3px 7px;

      color: #777;
      background: #f3f4f4;

      border-radius: var(--pill);

      font-size: 0.48rem;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.45px;
    }


    /* ============================================================
       ACCOUNT OVERVIEW
       ============================================================ */

    .account-overview {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 12px;

      margin-bottom: 0;
    }

    .overview-card {
      position: relative;

      padding: 17px 18px 16px;

      background:
        linear-gradient(
          135deg,
          #fcfcfc,
          #f8f9f9
        );

      border:
        1px solid
        var(--border);

      border-radius: 16px;

      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
    }

    .overview-card:hover {
      transform: translateY(-1px);

      border-color:
        #dedfe1;

      box-shadow:
        var(--shadow-xs);
    }

    .overview-card::after {
      content: "";

      position: absolute;

      top: 16px;
      right: 16px;

      width: 6px;
      height: 6px;

      background: var(--gold);

      border-radius: 50%;

      opacity: 0.8;
    }

    .overview-card small {
      display: block;

      margin-bottom: 5px;

      color: #9b9b9b;

      font-size: 0.56rem;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.85px;
    }

    .overview-card strong {
      color: var(--ink);

      font-size: 0.74rem;

      word-break: break-word;
    }

    .verification {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      color: var(--success);

      font-size: 0.7rem;
      font-weight: 700;
    }

    .verification-dot {
      width: 8px;
      height: 8px;

      background: var(--success);

      border-radius: 50%;

      box-shadow:
        0 0 0 4px
        rgba(22, 128, 60, 0.07);
    }

    .verification.pending {
      color: var(--warning);
    }

    .verification.pending .verification-dot {
      background: var(--warning);

      box-shadow:
        0 0 0 4px
        rgba(153, 107, 0, 0.07);
    }


    /* ============================================================
       ACCOUNT SECURITY
       ============================================================ */

    .security-note {
      position: relative;

      margin-bottom: 19px;

      padding: 14px 15px 14px 16px;

      color: #6f6f6f;

      background:
        linear-gradient(
          135deg,
          #fafbfb,
          #f7f8f8
        );

      border:
        1px solid
        var(--border);

      border-radius: 14px;

      font-size: 0.68rem;
      line-height: 1.7;
    }

    .security-note::before {
      content: "";

      position: absolute;

      left: 0;
      top: 0;
      bottom: 0;

      width: 3px;

      background: var(--teal);

      border-radius:
        14px 0 0 14px;
    }

    .security-form {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 16px;

      max-width: 800px;
    }

    .field-group {
      display: flex;
      flex-direction: column;

      gap: 7px;
    }

    .field-group.full {
      grid-column: 1 / -1;
    }

    .field-group label {
      color: #737373;

      font-size: 0.64rem;
      font-weight: 700;
    }

    .input-shell {
      position: relative;
    }

    input,
    select {
      width: 100%;

      min-height: 45px;

      padding: 11px 14px;

      color: var(--ink);

      background: #fbfcfc;

      border:
        1.5px solid
        var(--border);

      border-radius: 13px;

      outline: none;

      font-size: 0.72rem;

      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease,
        transform 0.2s ease;
    }

    input:hover,
    select:hover {
      border-color:
        var(--border-strong);

      background: #fff;
    }

    input:focus,
    select:focus {
      background: #fff;

      border-color: var(--teal);

      box-shadow:
        0 0 0 4px
        rgba(0, 128, 128, 0.08);
    }

    .input-shell input {
      padding-right: 76px;
    }

    .password-toggle {
      position: absolute;

      top: 50%;
      right: 7px;

      min-height: 31px;

      transform:
        translateY(-50%);

      padding: 6px 9px;

      color: #7e7e7e;

      background: #f5f6f6;

      border:
        1px solid
        #ececec;

      border-radius: 9px;

      cursor: pointer;

      font-size: 0.57rem;
      font-weight: 700;

      transition:
        color 0.2s ease,
        background 0.2s ease;
    }

    .password-toggle:hover {
      color: var(--ink);
      background: #ededed;
    }

    .password-strength {
      height: 5px;

      overflow: hidden;

      background: #ececec;

      border-radius: var(--pill);
    }

    .password-strength-bar {
      width: 0;
      height: 100%;

      background: var(--danger);

      border-radius: inherit;

      transition:
        width 0.28s ease,
        background 0.28s ease;
    }

    .password-hint {
      color: #999;

      font-size: 0.59rem;
    }

    .password-match {
      min-height: 18px;

      color: #999;

      font-size: 0.6rem;
      font-weight: 600;
    }

    .password-match.good {
      color: var(--success);
    }

    .password-match.bad {
      color: var(--danger);
    }

    .form-feedback {
      min-height: 18px;

      color: var(--teal);

      font-size: 0.66rem;
      font-weight: 700;
    }

    .form-feedback.error {
      color: var(--danger);
    }

    .btn-update {
      grid-column: 1 / -1;

      min-height: 48px;

      color: var(--ink);

      background:
        linear-gradient(
          135deg,
          var(--gold),
          #f3ca00
        );

      border-radius: 14px;

      box-shadow:
        0 10px 25px
        rgba(255, 215, 0, 0.12);

      cursor: pointer;

      font-size: 0.72rem;
      font-weight: 800;

      transition:
        transform 0.22s ease,
        background 0.22s ease,
        box-shadow 0.22s ease,
        opacity 0.2s ease;
    }

    .btn-update:hover {
      transform: translateY(-2px);

      background:
        linear-gradient(
          135deg,
          var(--gold-bright),
          var(--gold)
        );

      box-shadow:
        0 14px 30px
        rgba(255, 215, 0, 0.17);
    }

    .btn-update:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }


    /* ============================================================
       LOGOUT
       ============================================================ */

    .logout-area {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      padding: 0 46px 40px;

      flex-wrap: wrap;
    }

    .logout-copy {
      color: #999;

      font-size: 0.63rem;
      line-height: 1.6;
    }

    .logout-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      min-height: 42px;

      padding: 10px 19px;

      color: var(--danger);

      background:
        rgba(198, 40, 40, 0.035);

      border:
        1px solid
        rgba(198, 40, 40, 0.17);

      border-radius: var(--pill);

      cursor: pointer;

      font-size: 0.67rem;
      font-weight: 800;

      transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
    }

    .logout-btn:hover {
      transform: translateY(-1px);

      color: #fff;

      background: var(--danger);

      border-color: var(--danger);
    }


    /* ============================================================
       MODALS
       ============================================================ */

    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 900;

      display: none;
      align-items: center;
      justify-content: center;

      padding: 18px;

      background:
        rgba(12, 12, 12, 0.68);

      backdrop-filter:
        blur(7px);
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal {
      width: min(720px, 100%);

      max-height:
        min(88vh, 820px);

      overflow: hidden;

      display: flex;
      flex-direction: column;

      background: #fff;

      border:
        1px solid
        rgba(255, 255, 255, 0.8);

      border-radius: 26px;

      box-shadow:
        0 35px 100px
        rgba(0, 0, 0, 0.3);

      animation:
        modalIn
        0.24s
        cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform:
          translateY(12px)
          scale(0.985);
      }

      to {
        opacity: 1;
        transform:
          translateY(0)
          scale(1);
      }
    }

    .modal-header {
      position: relative;
      overflow: hidden;

      display: flex;
      align-items: flex-start;
      justify-content: space-between;

      gap: 16px;

      padding: 23px 24px;

      color: #fff;

      background:
        radial-gradient(
          circle at 90% 0%,
          rgba(255, 215, 0, 0.15),
          transparent 30%
        ),
        linear-gradient(
          140deg,
          #171717,
          #242424
        );
    }

    .modal-header::after {
      content: "";

      position: absolute;

      left: 0;
      right: 0;
      bottom: 0;

      height: 2px;

      background:
        linear-gradient(
          90deg,
          transparent,
          var(--gold),
          transparent
        );
    }

    .modal-kicker {
      color: var(--gold);

      font-size: 0.58rem;
      font-weight: 800;

      text-transform: uppercase;
      letter-spacing: 1.2px;
    }

    .modal-title {
      margin-top: 4px;

      color: #fff;

      font-size: 1.05rem;
      font-weight: 800;
    }

    .modal-close {
      width: 34px;
      height: 34px;

      display: grid;
      place-items: center;

      flex: 0 0 auto;

      color: #fff;

      background:
        rgba(255, 255, 255, 0.06);

      border:
        1px solid
        rgba(255, 255, 255, 0.12);

      border-radius: 50%;

      cursor: pointer;

      font-size: 1rem;

      transition:
        background 0.2s ease,
        transform 0.2s ease;
    }

    .modal-close:hover {
      background:
        rgba(255, 255, 255, 0.12);

      transform: rotate(4deg);
    }

    .modal-body {
      padding: 23px;

      overflow-y: auto;
    }

    .modal-body::-webkit-scrollbar {
      width: 7px;
    }

    .modal-body::-webkit-scrollbar-track {
      background: #f7f7f7;
    }

    .modal-body::-webkit-scrollbar-thumb {
      background: #d8d8d8;
      border-radius: var(--pill);
    }

    .detail-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 11px;
    }

    .detail-card {
      min-width: 0;

      padding: 14px;

      background:
        linear-gradient(
          135deg,
          #fbfbfb,
          #f7f8f8
        );

      border:
        1px solid
        #ebebeb;

      border-radius: 15px;
    }

    .detail-card.full {
      grid-column: 1 / -1;
    }

    .detail-card small {
      display: block;

      margin-bottom: 5px;

      color: #999;

      font-size: 0.55rem;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .detail-card strong,
    .detail-card span {
      color: var(--ink);

      font-size: 0.73rem;

      word-break: break-word;
    }

    .price-summary {
      margin-top: 15px;

      overflow: hidden;

      border:
        1px solid
        var(--border);

      border-radius: 18px;
    }

    .price-summary .price-line {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 15px;

      padding: 11px 14px;

      border-top:
        1px solid
        #f0f0f0;

      color: #666;

      font-size: 0.69rem;
    }

    .price-summary .price-line:first-child {
      border-top: none;
    }

    .price-summary .price-line strong {
      color: var(--ink);
      font-weight: 800;
    }

    .price-summary .price-line.total {
      color: #fff;

      background:
        linear-gradient(
          135deg,
          #171717,
          #242424
        );

      font-weight: 800;
    }

    .price-summary .price-line.total strong {
      color: var(--gold);

      font-size: 0.85rem;
    }

    .addons-list {
      display: grid;
      gap: 7px;
    }

    .addon-line {
      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 12px;

      padding: 9px 11px;

      color: #666;

      background: #f5f6f6;

      border-radius: 11px;

      font-size: 0.66rem;
    }

    .addon-line strong {
      color: var(--ink);
    }

    .modal-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;

      gap: 8px;

      padding: 14px 23px;

      border-top:
        1px solid
        #ededed;

      flex-wrap: wrap;
    }

    .secondary-btn,
    .danger-btn {
      padding: 9px 14px;
    }

    .secondary-btn:hover {
      color: var(--ink);
      background: #f8f8f8;
    }

    .danger-btn {
      color: var(--danger);

      background:
        var(--danger-bg);

      border-color:
        var(--danger-border);
    }

    .danger-btn:hover {
      color: #a51e1e;

      background: #ffe8e8;

      border-color: #edc4c4;
    }


    /* ============================================================
       LIVE FEEDBACK
       ============================================================ */

    .sr-feedback {
      position: fixed;

      left: 20px;
      bottom: 20px;

      z-index: 1000;

      width:
        min(
          430px,
          calc(100% - 40px)
        );

      padding: 13px 16px;

      color: #fff;

      background:
        linear-gradient(
          135deg,
          #171717,
          #262626
        );

      border:
        1px solid
        rgba(255, 255, 255, 0.08);

      border-radius: 14px;

      box-shadow:
        0 20px 45px
        rgba(0, 0, 0, 0.2);

      font-size: 0.67rem;
      font-weight: 600;

      opacity: 0;

      transform:
        translateY(12px);

      pointer-events: none;

      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }

    .sr-feedback.show {
      opacity: 1;

      transform:
        translateY(0);
    }


    /* ============================================================
       RESPONSIVE — 1100
       ============================================================ */

    @media (max-width: 1100px) {
      .profile-header {
        padding: 42px 38px 40px;
      }

      .section {
        padding: 36px 38px;
      }

      .flash-stack {
        padding-left: 38px;
        padding-right: 38px;
      }

      .logout-area {
        padding-left: 38px;
        padding-right: 38px;
      }
    }


    /* ============================================================
       RESPONSIVE — 980
       ============================================================ */

    @media (max-width: 980px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }

      .hero-actions {
        justify-content: flex-start;
      }

      .user-stats {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .stat-item:nth-child(2) {
        border-right: none;
      }

      .stat-item:nth-child(-n + 2) {
        border-bottom:
          1px solid
          rgba(255, 255, 255, 0.07);
      }

      .stay-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .security-form {
        max-width: none;
      }
    }


    /* ============================================================
       RESPONSIVE — 760
       ============================================================ */

    @media (max-width: 760px) {
      .profile-container {
        width:
          min(
            100% - 20px,
            var(--content-width)
          );

        margin:
          92px auto 25px;

        border-radius: 22px;
      }

      .profile-header {
        padding: 34px 22px 31px;
      }

      .hero-identity {
        align-items: flex-start;
      }

      .hero-avatar {
        width: 84px;
        height: 84px;
      }

      .hero-actions {
        width: 100%;
      }

      .header-btn {
        flex: 1;
      }

      .section {
        padding: 31px 22px;
      }

      .flash-stack {
        padding:
          15px
          22px
          0;
      }

      .section-header {
        flex-direction: column;
      }

      .inline-actions {
        width: 100%;

        justify-content: flex-start;
      }

      .toolbar {
        align-items: stretch;
        flex-direction: column;
      }

      .toolbar-left,
      .toolbar-right {
        width: 100%;
      }

      .toolbar-left {
        overflow-x: auto;
        flex-wrap: nowrap;

        padding-bottom: 2px;

        scrollbar-width: none;
      }

      .toolbar-left::-webkit-scrollbar {
        display: none;
      }

      .search-box {
        width: 100%;
      }

      .notification-toolbar {
        align-items: stretch;
        flex-direction: column;
      }

      .notification-filters,
      .notification-actions {
        width: 100%;
      }

      .notification-filters {
        overflow-x: auto;
        flex-wrap: nowrap;

        scrollbar-width: none;
      }

      .notification-filters::-webkit-scrollbar {
        display: none;
      }

      .notification {
        flex-wrap: wrap;
      }

      .notification-actions {
        width: 100%;
        margin-left: 0;

        justify-content: flex-start;
      }

      .account-overview {
        grid-template-columns: 1fr;
      }

      .security-form {
        grid-template-columns: 1fr;
      }

      .field-group.full {
        grid-column: 1;
      }

      .btn-update {
        grid-column: 1;
      }

      .logout-area {
        padding:
          0
          22px
          29px;

        align-items: flex-start;
        flex-direction: column;
      }

      .logout-btn {
        width: 100%;
      }

      .modal-backdrop {
        padding: 10px;
      }

      .modal {
        max-height: 92vh;
        border-radius: 20px;
      }

      .modal-header,
      .modal-body,
      .modal-footer {
        padding-left: 18px;
        padding-right: 18px;
      }

      .detail-grid {
        grid-template-columns: 1fr;
      }

      .detail-card.full {
        grid-column: 1;
      }

      .hero-meta-chip {
        font-size: 0.58rem;
      }
    }


    /* ============================================================
       RESPONSIVE — 560
       ============================================================ */

    @media (max-width: 560px) {
      .profile-header {
        padding:
          30px 18px
          28px;
      }

      .hero-identity {
        flex-direction: column;
        gap: 15px;
      }

      .hero-copy {
        width: 100%;
      }

      .profile-header h1 {
        font-size: 1.9rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .header-btn {
        width: 100%;
        flex: none;
      }

      .user-stats {
        grid-template-columns: 1fr;
      }

      .stat-item,
      .stat-item:nth-child(2) {
        border-right: none;

        border-bottom:
          1px solid
          rgba(255, 255, 255, 0.07);
      }

      .stat-item:last-child {
        border-bottom: none;
      }

      .stat-subvalue {
        white-space: normal;
      }

      .section {
        padding:
          28px 18px;
      }

      .flash-stack {
        padding:
          14px 18px
          0;
      }

      .logout-area {
        padding:
          0 18px
          26px;
      }

      .stay-grid {
        grid-template-columns: 1fr;
      }

      .stay-card {
        padding: 20px;
      }

      .stay-topline {
        flex-direction: column;
      }

      .countdown-pill {
        align-self: flex-start;
      }

      .notification {
        padding: 14px;
      }

      .notification-icon {
        width: 40px;
        height: 40px;
        flex-basis: 40px;
      }
    }


    /* ============================================================
       RESPONSIVE — 420
       ============================================================ */

    @media (max-width: 420px) {
      .profile-container {
        width:
          calc(100% - 12px);

        margin-top: 86px;

        border-radius: 18px;
      }

      .profile-header {
        padding:
          26px 16px
          25px;
      }

      .section {
        padding:
          25px 16px;
      }

      .flash-stack {
        padding:
          12px 16px
          0;
      }

      .logout-area {
        padding:
          0 16px
          24px;
      }

      .section h2 {
        font-size: 1.06rem;
      }

      .section-subtitle {
        font-size: 0.68rem;
      }

      .account-status {
        font-size: 0.56rem;
      }

      .hero-meta {
        display: grid;
        grid-template-columns: 1fr;
      }

      .hero-meta-chip {
        justify-content: space-between;
      }

      .notification-actions {
        display: grid;
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .notification-actions .tiny-btn {
        width: 100%;
      }

      .stay-actions {
        display: grid;
        grid-template-columns: 1fr;
      }

      .stay-actions .tiny-btn {
        width: 100%;
      }

      .inline-actions .tiny-btn {
        width: 100%;
      }
    }


    /* ============================================================
       REDUCED MOTION
       ============================================================ */

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration:
          0.01ms !important;

        animation-iteration-count:
          1 !important;

        transition-duration:
          0.01ms !important;
      }
    }


    /* ============================================================
       PRINT
       ============================================================ */

    @media print {
      body {
        background: #fff;
      }

      .profile-container {
        width: 100%;
        margin: 0;

        border-radius: 0;

        border: 0;

        box-shadow: none;
      }

      .hero-actions,
      .toolbar,
      .notification-toolbar,
      .notification-actions,
      .logout-area,
      .modal-backdrop,
      .sr-feedback,
      .table-actions,
      .flash-stack,
      .password-toggle {
        display: none !important;
      }

      .section {
        padding:
          24px 30px;

        page-break-inside: avoid;
      }

      .user-stats {
        break-inside: avoid;
      }
    }
  </style>
</head>


<body>

  <%- include("partials/navbar") %>


  <main
    id="profilePage"
    class="profile-container"
    data-user-id="<%= user && user._id ? String(user._id) : '' %>"
  >

    <!-- ========================================================
         HERO
         ======================================================== -->

    <section class="profile-header">

      <div class="hero-grid">

        <div class="hero-identity">

          <div class="hero-avatar-wrap">
            <img
              class="hero-avatar"
              src="/images/profile-icon.png"
              alt="Profile picture"
              loading="lazy"
              onerror="this.src='/images/islelogo.png';"
            >

            <span
              class="hero-avatar-status"
              aria-hidden="true"
            ></span>
          </div>


          <div class="hero-copy">

            <div class="hero-kicker">
              Puffer Isle Resort
            </div>

            <h1 id="profileName">
              <%= user.fullname || "Island Guest" %>
            </h1>

            <div
              class="profile-handle"
              id="profileHandle"
            >
              @<%= user.username || (user.email ? user.email.split("@")[0] : "guest") %>
            </div>

            <div class="member-since">
              Resort Member Since
              <%= user.createdAt
                ? new Date(user.createdAt).toLocaleDateString(
                    "en-US",
                    {
                      month: "long",
                      year: "numeric"
                    }
                  )
                : "2026" %>
            </div>


            <div class="hero-meta">

              <div class="hero-meta-chip">
                <span>Membership</span>
                <strong>
                  <%= user.memberLevel || "Resort Member" %>
                </strong>
              </div>

              <div class="hero-meta-chip">
                <span>Email</span>
                <strong>
                  <%= user.emailVerified ? "Verified" : "Pending" %>
                </strong>
              </div>

            </div>


            <div class="account-status">

              <span
                class="status-dot"
                aria-hidden="true"
              ></span>

              <span id="accountStatusLabel">
                <%= String(user.status || "active").toLowerCase() === "active"
                  ? "Account Active"
                  : "Account Restricted" %>
              </span>

            </div>

          </div>

        </div>


        <div class="hero-actions">

          <a
            class="header-btn primary"
            href="/booking"
            aria-label="Book a new stay"
          >
            + Book a Stay
          </a>

          <a
            class="header-btn"
            href="#bookingsSection"
          >
            My Reservations
          </a>

          <button
            type="button"
            class="header-btn"
            id="refreshButton"
          >
            ↻ Refresh
          </button>

        </div>

      </div>

    </section>


    <!-- ========================================================
         KPI STRIP
         ======================================================== -->

    <section
      class="user-stats"
      aria-label="Account summary"
    >

      <div class="stat-item">

        <div class="stat-label">
          <span>Total Bookings</span>

          <span class="stat-badge">
            Lifetime
          </span>
        </div>

        <div
          class="stat-value"
          id="stat-bookings"
        >
          <%= appointments ? appointments.length : 0 %>
        </div>

        <div class="stat-subvalue">
          Your reservation history
        </div>

      </div>


      <div class="stat-item">

        <div class="stat-label">
          <span>Upcoming</span>

          <span class="stat-badge">
            Next Stay
          </span>
        </div>

        <div
          class="stat-value"
          id="stat-upcoming"
        >
          0
        </div>

        <div class="stat-subvalue">
          Future confirmed or pending stays
        </div>

      </div>


      <div class="stat-item">

        <div class="stat-label">
          <span>Unread</span>

          <span class="stat-badge">
            Alerts
          </span>
        </div>

        <div
          class="stat-value"
          id="stat-notifs"
        >
          <%= notifications
            ? notifications.filter(
                function(note) {
                  return !note.read && !note.archived;
                }
              ).length
            : 0 %>
        </div>

        <div class="stat-subvalue">
          Updates that need your attention
        </div>

      </div>


      <div class="stat-item">

        <div class="stat-label">
          <span>Room Nights</span>

          <span class="stat-badge">
            Stay Time
          </span>
        </div>

        <div
          class="stat-value"
          id="stat-nights"
        >
          0
        </div>

        <div class="stat-subvalue">
          Calculated from your reservations
        </div>

      </div>

    </section>


    <!-- ========================================================
         FLASH MESSAGE
         ======================================================== -->

    <div
      class="flash-stack"
      id="flashStack"
      aria-live="polite"
    >

      <% if (typeof success !== "undefined" && success) { %>

        <div class="flash success">

          <span>
            <%= success %>
          </span>

          <button
            type="button"
            class="flash-close"
            aria-label="Dismiss message"
          >
            ×
          </button>

        </div>

      <% } %>


      <% if (typeof error !== "undefined" && error) { %>

        <div class="flash error">

          <span>
            <%= error %>
          </span>

          <button
            type="button"
            class="flash-close"
            aria-label="Dismiss message"
          >
            ×
          </button>

        </div>

      <% } %>

    </div>


    <!-- ========================================================
         NEXT STAY
         ======================================================== -->

    <section class="section">

      <div class="section-header">

        <div class="section-title-wrap">

          <h2>
            Next Stay
          </h2>

          <p class="section-subtitle">
            Your most immediate reservation at Puffer Isle Resort.
          </p>

        </div>

        <div
          class="refresh-status"
          id="refreshStatus"
          aria-live="polite"
        ></div>

      </div>


      <div id="nextStayContainer">

        <div class="stay-card empty">

          <div
            class="empty-state"
            style="padding: 28px 15px;"
          >

            <div
              class="empty-state-icon"
              aria-hidden="true"
            >
              🏝️
            </div>

            <div class="empty-state-title">
              Checking your next stay…
            </div>

            <div class="empty-state-text">
              Your latest reservation information will appear here.
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================
         BOOKINGS
         ======================================================== -->

    <section
      class="section"
      id="bookingsSection"
    >

      <div class="section-header">

        <div class="section-title-wrap">

          <h2>
            My Reservations
          </h2>

          <p class="section-subtitle">
            Manage current stays and keep a clear record of past bookings.
          </p>

        </div>


        <div class="inline-actions">

          <a
            href="/booking"
            class="tiny-btn dark"
          >
            Create Reservation
          </a>

        </div>

      </div>


      <div class="toolbar">

        <div
          class="toolbar-left"
          role="group"
          aria-label="Reservation filters"
        >

          <button
            type="button"
            class="filter-button active"
            data-booking-filter="all"
          >
            All
          </button>

          <button
            type="button"
            class="filter-button"
            data-booking-filter="upcoming"
          >
            Upcoming
          </button>

          <button
            type="button"
            class="filter-button"
            data-booking-filter="active"
          >
            Active
          </button>

          <button
            type="button"
            class="filter-button"
            data-booking-filter="past"
          >
            Past
          </button>

        </div>


        <div class="toolbar-right">

          <label
            class="sr-only"
            for="bookingSearch"
          >
            Search reservations
          </label>

          <input
            id="bookingSearch"
            class="search-box"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Search room or booking reference…"
          >

        </div>

      </div>


      <div
        class="table-wrapper"
        id="appointmentsContainer"
      >

        <table
          aria-describedby="bookingTableDescription"
        >

          <caption
            id="bookingTableDescription"
            class="sr-only"
          >
            Your Puffer Isle Resort reservations
          </caption>

          <thead>

            <tr>

              <th scope="col">
                Accommodation
              </th>

              <th scope="col">
                Check-In
              </th>

              <th scope="col">
                Check-Out
              </th>

              <th scope="col">
                Guests
              </th>

              <th scope="col">
                Total
              </th>

              <th scope="col">
                Status
              </th>

              <th scope="col">
                <span class="sr-only">
                  Actions
                </span>
              </th>

            </tr>

          </thead>

          <tbody>

            <tr class="loading-row">

              <td colspan="7">
                Loading your reservations…
              </td>

            </tr>

          </tbody>

        </table>

      </div>

    </section>


    <!-- ========================================================
         NOTIFICATIONS
         ======================================================== -->

    <section
      class="section"
      id="notificationsSection"
    >

      <div class="section-header">

        <div class="section-title-wrap">

          <h2>
            Notifications
          </h2>

          <p class="section-subtitle">
            Booking changes, resort updates, and account activity in one place.
          </p>

        </div>

      </div>


      <div class="notification-toolbar">

        <div
          class="notification-filters"
          role="group"
          aria-label="Notification filters"
        >

          <button
            type="button"
            class="filter-button active"
            data-notification-filter="all"
          >
            All
          </button>

          <button
            type="button"
            class="filter-button"
            data-notification-filter="unread"
          >
            Unread
          </button>

          <button
            type="button"
            class="filter-button"
            data-notification-filter="archived"
          >
            Archived
          </button>

        </div>


        <div class="notification-actions">

          <button
            type="button"
            class="tiny-btn dark"
            id="markAllReadButton"
          >
            Mark all as read
          </button>

        </div>

      </div>


      <div
        id="notificationsContainer"
        class="notification-list"
      >

        <div class="empty-state">

          <div
            class="empty-state-icon"
            aria-hidden="true"
          >
            🔔
          </div>

          <div class="empty-state-title">
            Loading notifications…
          </div>

          <div class="empty-state-text">
            Your latest resort updates will appear here.
          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================
         ACCOUNT OVERVIEW
         ======================================================== -->

    <section class="section">

      <div class="section-header">

        <div class="section-title-wrap">

          <h2>
            Account Overview
          </h2>

          <p class="section-subtitle">
            Your registered information and account status.
          </p>

        </div>

      </div>


      <div class="account-overview">

        <div class="overview-card">

          <small>
            Full Name
          </small>

          <strong id="accountFullName">
            <%= user.fullname || "Not provided" %>
          </strong>

        </div>


        <div class="overview-card">

          <small>
            Email Address
          </small>

          <strong id="accountEmail">
            <%= user.email || "Not provided" %>
          </strong>

        </div>


        <div class="overview-card">

          <small>
            Contact Number
          </small>

          <strong id="accountPhone">
            <%= user.phone || "Not provided" %>
          </strong>

        </div>


        <div class="overview-card">

          <small>
            Email Verification
          </small>

          <% if (user.emailVerified) { %>

            <span
              class="verification"
              id="verificationStatus"
            >

              <span
                class="verification-dot"
                aria-hidden="true"
              ></span>

              Verified

            </span>

          <% } else { %>

            <span
              class="verification pending"
              id="verificationStatus"
            >

              <span
                class="verification-dot"
                aria-hidden="true"
              ></span>

              Pending Verification

            </span>

          <% } %>

        </div>

      </div>

    </section>


    <!-- ========================================================
         ACCOUNT SECURITY
         ======================================================== -->

    <section class="section">

      <div class="section-header">

        <div class="section-title-wrap">

          <h2>
            Account Security
          </h2>

          <p class="section-subtitle">
            Protect your resort account with a strong, unique password.
          </p>

        </div>

      </div>


      <div class="security-note">

        Use at least 10 characters. For better security, combine uppercase and lowercase letters, numbers, and symbols. Your current password is required before any change is saved.

      </div>


      <form
        method="POST"
        action="/profile/update-password"
        class="security-form"
        id="passwordForm"
        novalidate
      >

        <% if (typeof csrfToken !== "undefined" && csrfToken) { %>

          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

        <% } %>


        <div class="field-group">

          <label for="currentPassword">
            Current Password
          </label>

          <div class="input-shell">

            <input
              id="currentPassword"
              type="password"
              name="currentPassword"
              placeholder="Enter current password"
              autocomplete="current-password"
              required
              maxlength="128"
            >

            <button
              type="button"
              class="password-toggle"
              data-toggle-password="currentPassword"
            >
              Show
            </button>

          </div>

        </div>


        <div class="field-group">

          <label for="newPassword">
            New Password
          </label>

          <div class="input-shell">

            <input
              id="newPassword"
              type="password"
              name="newPassword"
              placeholder="Enter new password"
              autocomplete="new-password"
              minlength="10"
              maxlength="128"
              required
            >

            <button
              type="button"
              class="password-toggle"
              data-toggle-password="newPassword"
            >
              Show
            </button>

          </div>

        </div>


        <div class="field-group full">

          <label for="confirmPassword">
            Confirm New Password
          </label>

          <div class="input-shell">

            <input
              id="confirmPassword"
              type="password"
              name="confirmPassword"
              placeholder="Re-enter your new password"
              autocomplete="new-password"
              minlength="10"
              maxlength="128"
              required
            >

            <button
              type="button"
              class="password-toggle"
              data-toggle-password="confirmPassword"
            >
              Show
            </button>

          </div>

        </div>


        <div class="field-group full">

          <div
            class="password-strength"
            aria-hidden="true"
          >
            <div
              id="passwordStrengthBar"
              class="password-strength-bar"
            ></div>
          </div>

          <div
            id="passwordHint"
            class="password-hint"
          >
            Use 10 or more characters.
          </div>

          <div
            id="passwordMatch"
            class="password-match"
            aria-live="polite"
          ></div>

        </div>


        <div
          id="passwordFeedback"
          class="form-feedback full"
          role="status"
          aria-live="polite"
        ></div>


        <button
          type="submit"
          class="btn-update"
          id="passwordSubmitButton"
        >
          Update Password
        </button>

      </form>

    </section>


    <!-- ========================================================
         LOGOUT
         ======================================================== -->

    <div class="logout-area">

      <div class="logout-copy">

        Signed in to Puffer Isle Resort. You can safely sign out from this device at any time.

      </div>


      <form
        method="POST"
        action="/logout"
      >

        <% if (typeof csrfToken !== "undefined" && csrfToken) { %>

          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >

        <% } %>

        <button
          type="submit"
          class="logout-btn"
        >
          Sign Out
        </button>

      </form>

    </div>

  </main>


  <!-- ========================================================
       BOOKING DETAILS MODAL
       ======================================================== -->

  <div
    class="modal-backdrop"
    id="bookingModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="bookingModalTitle"
  >

    <div
      class="modal"
      role="document"
    >

      <div class="modal-header">

        <div>

          <div class="modal-kicker">
            Reservation Details
          </div>

          <div
            class="modal-title"
            id="bookingModalTitle"
          >
            Booking
          </div>

        </div>


        <button
          type="button"
          class="modal-close"
          data-close-modal="bookingModal"
          aria-label="Close booking details"
        >
          ×
        </button>

      </div>


      <div
        class="modal-body"
        id="bookingModalBody"
      ></div>


      <div
        class="modal-footer"
        id="bookingModalFooter"
      ></div>

    </div>

  </div>


  <!-- ========================================================
       CANCEL CONFIRMATION MODAL
       ======================================================== -->

  <div
    class="modal-backdrop"
    id="cancelModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cancelModalTitle"
  >

    <div
      class="modal"
      role="document"
      style="width:min(480px,100%);"
    >

      <div class="modal-header">

        <div>

          <div class="modal-kicker">
            Reservation Action
          </div>

          <div
            class="modal-title"
            id="cancelModalTitle"
          >
            Cancel this reservation?
          </div>

        </div>


        <button
          type="button"
          class="modal-close"
          data-close-modal="cancelModal"
          aria-label="Close cancellation dialog"
        >
          ×
        </button>

      </div>


      <div class="modal-body">

        <p
          id="cancelModalMessage"
          style="
            margin:0;
            color:#666;
            font-size:.75rem;
            line-height:1.7;
          "
        ></p>

      </div>


      <div class="modal-footer">

        <button
          type="button"
          class="secondary-btn"
          data-close-modal="cancelModal"
        >
          Keep Reservation
        </button>

        <button
          type="button"
          class="danger-btn"
          id="confirmCancelButton"
        >
          Cancel Reservation
        </button>

      </div>

    </div>

  </div>


  <div
    class="sr-feedback"
    id="srFeedback"
    role="status"
    aria-live="polite"
  ></div>


  <script>
    "use strict";

    /* ============================================================
       PROFILE CLIENT
       Uses the existing customer APIs exposed by userRoutes.js.
       ============================================================ */

    const profilePage = document.getElementById("profilePage");
    const userId = profilePage?.dataset?.userId || "";

    const state = {
      bookings: [],
      notifications: [],
      bookingFilter: "all",
      notificationFilter: "all",
      bookingSearch: "",
      loading: false,
      notificationActionBusy: false,
      cancelBookingId: null,
      lastActiveModal: null,
      refreshTimer: null,
      feedbackTimer: null,
    };

    const elements = {
      refreshButton: document.getElementById("refreshButton"),
      refreshStatus: document.getElementById("refreshStatus"),
      appointmentsContainer: document.getElementById("appointmentsContainer"),
      notificationsContainer: document.getElementById("notificationsContainer"),
      bookingsCounter: document.getElementById("stat-bookings"),
      upcomingCounter: document.getElementById("stat-upcoming"),
      notificationsCounter: document.getElementById("stat-notifs"),
      nightsCounter: document.getElementById("stat-nights"),
      bookingSearch: document.getElementById("bookingSearch"),
      nextStayContainer: document.getElementById("nextStayContainer"),
      markAllReadButton: document.getElementById("markAllReadButton"),
      passwordForm: document.getElementById("passwordForm"),
      passwordSubmitButton: document.getElementById("passwordSubmitButton"),
      passwordFeedback: document.getElementById("passwordFeedback"),
      passwordStrengthBar: document.getElementById("passwordStrengthBar"),
      passwordHint: document.getElementById("passwordHint"),
      passwordMatch: document.getElementById("passwordMatch"),
      newPasswordInput: document.getElementById("newPassword"),
      confirmPasswordInput: document.getElementById("confirmPassword"),
      bookingModal: document.getElementById("bookingModal"),
      bookingModalBody: document.getElementById("bookingModalBody"),
      bookingModalTitle: document.getElementById("bookingModalTitle"),
      bookingModalFooter: document.getElementById("bookingModalFooter"),
      cancelModal: document.getElementById("cancelModal"),
      cancelModalMessage: document.getElementById("cancelModalMessage"),
      confirmCancelButton: document.getElementById("confirmCancelButton"),
      srFeedback: document.getElementById("srFeedback"),
    };

    const cancellableStatuses = new Set([
      "pending",
      "accepted",
      "confirmed",
    ]);

    const activeStatuses = new Set([
      "pending",
      "accepted",
      "confirmed",
      "checked-in",
    ]);

    const terminalStatuses = new Set([
      "declined",
      "rejected",
      "cancelled",
      "checked-out",
      "completed",
    ]);

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function escapeAttr(value) {
      return escapeHtml(value);
    }

    function safeClass(value) {
      return String(value || "pending")
        .toLowerCase()
        .replace(/[^a-z0-9_-]/g, "");
    }

    function formatDate(value) {
      if (!value) return "—";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "—";
      return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      });
    }

    function formatDateTime(value) {
      if (!value) return "";
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "";
      return date.toLocaleString("en-US", {
        dateStyle: "medium",
        timeStyle: "short",
      });
    }

    function formatCurrency(value) {
      const amount = Number(value);
      if (!Number.isFinite(amount)) return "—";
      return new Intl.NumberFormat("en-PH", {
        style: "currency",
        currency: "PHP",
        maximumFractionDigits: 2,
      }).format(amount);
    }

    function bookingRef(booking) {
      const raw = booking?._id || booking?.id || "";
      return raw ? String(raw).slice(-8).toUpperCase() : "—";
    }

    function statusLabel(status) {
      return String(status || "pending")
        .trim()
        .replace(/-/g, " ")
        .replace(/\b\w/g, (char) => char.toUpperCase());
    }

    function statusClass(status) {
      return safeClass(status || "pending");
    }

    function roomName(booking) {
      return (
        booking?.roomDisplayName ||
        booking?.roomName ||
        booking?.room ||
        booking?.roomType ||
        booking?.accommodation ||
        "Accommodation"
      );
    }

    function getNights(booking) {
      const stored = Number(booking?.numberOfNights);
      if (Number.isFinite(stored) && stored > 0) return Math.round(stored);

      const start = new Date(booking?.checkin);
      const end = new Date(booking?.checkout);
      if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || end <= start) {
        return 0;
      }

      const startDate = Date.UTC(start.getFullYear(), start.getMonth(), start.getDate());
      const endDate = Date.UTC(end.getFullYear(), end.getMonth(), end.getDate());
      return Math.max(0, Math.round((endDate - startDate) / 86400000));
    }

    function daysUntil(dateValue) {
      const target = new Date(dateValue);
      if (Number.isNaN(target.getTime())) return null;

      const today = new Date();
      const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const targetStart = new Date(target.getFullYear(), target.getMonth(), target.getDate());
      return Math.round((targetStart - todayStart) / 86400000);
    }

    function isUpcomingBooking(booking) {
      const status = String(booking?.status || "pending").toLowerCase();
      const checkin = new Date(booking?.checkin);
      if (Number.isNaN(checkin.getTime())) return false;
      return !terminalStatuses.has(status) && checkin >= new Date();
    }

    function isPastBooking(booking) {
      const status = String(booking?.status || "pending").toLowerCase();
      if (terminalStatuses.has(status)) return true;

      const checkout = new Date(booking?.checkout);
      return !Number.isNaN(checkout.getTime()) && checkout < new Date();
    }

    function isActiveBooking(booking) {
      return activeStatuses.has(String(booking?.status || "").toLowerCase());
    }

    function getFilteredBookings() {
      const query = state.bookingSearch.trim().toLowerCase();

      return state.bookings.filter((booking) => {
        let filterMatch = true;

        if (state.bookingFilter === "upcoming") {
          filterMatch = isUpcomingBooking(booking);
        } else if (state.bookingFilter === "active") {
          filterMatch = isActiveBooking(booking);
        } else if (state.bookingFilter === "past") {
          filterMatch = isPastBooking(booking);
        }

        if (!filterMatch) return false;
        if (!query) return true;

        const haystack = [
          roomName(booking),
          bookingRef(booking),
          booking?.status,
          booking?.roomType,
        ]
          .join(" ")
          .toLowerCase();

        return haystack.includes(query);
      });
    }

    function getSortedBookings(bookings) {
      return [...bookings].sort((a, b) => {
        const aDate = new Date(a?.checkin).getTime();
        const bDate = new Date(b?.checkin).getTime();

        if (state.bookingFilter === "upcoming" || state.bookingFilter === "active") {
          return (aDate || 0) - (bDate || 0);
        }

        return (new Date(b?.createdAt).getTime() || 0) - (new Date(a?.createdAt).getTime() || 0);
      });
    }

    function updateStats() {
      const upcoming = state.bookings.filter(isUpcomingBooking).length;
      const nights = state.bookings.reduce((sum, booking) => sum + getNights(booking), 0);
      const unread = state.notifications.filter((note) => !note.read && !note.archived).length;

      if (elements.bookingsCounter) elements.bookingsCounter.textContent = String(state.bookings.length);
      if (elements.upcomingCounter) elements.upcomingCounter.textContent = String(upcoming);
      if (elements.notificationsCounter) elements.notificationsCounter.textContent = String(unread);
      if (elements.nightsCounter) elements.nightsCounter.textContent = String(nights);
    }

    function showFeedback(message) {
      if (!elements.srFeedback) return;
      elements.srFeedback.textContent = message;
      elements.srFeedback.classList.add("show");

      window.clearTimeout(state.feedbackTimer);
      state.feedbackTimer = window.setTimeout(() => {
        elements.srFeedback?.classList.remove("show");
      }, 2600);
    }

    function setRefreshStatus(message) {
      if (!elements.refreshStatus) return;
      elements.refreshStatus.textContent = message || "";
    }

    function getCsrfToken() {
      return document.querySelector('meta[name="csrf-token"]')?.getAttribute("content") ||
        document.querySelector('input[name="_csrf"]')?.value ||
        "";
    }

    function buildRequestOptions(options = {}) {
      const method = String(options.method || "GET").toUpperCase();
      const headers = {
        Accept: "application/json",
        ...(options.headers || {}),
      };

      const csrfToken = getCsrfToken();
      if (csrfToken && method !== "GET" && method !== "HEAD") {
        headers["X-CSRF-Token"] = csrfToken;
      }

      return {
        ...options,
        method,
        headers,
        credentials: "same-origin",
        cache: "no-store",
      };
    }

    async function fetchJson(url, options = {}, timeoutMs = 10000) {
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), timeoutMs);

      try {
        const response = await fetch(url, buildRequestOptions({
          ...options,
          signal: controller.signal,
        }));

        let data = null;
        try {
          data = await response.json();
        } catch (_) {
          data = null;
        }

        if (response.status === 401) {
          window.location.href = "/?auth=login&error=" + encodeURIComponent("Your session has expired. Please log in again.");
          throw new Error("AUTHENTICATION_REQUIRED");
        }

        if (!response.ok) {
          throw new Error(data?.message || `Request failed with HTTP ${response.status}.`);
        }

        return data || {};
      } finally {
        window.clearTimeout(timeout);
      }
    }

    function renderNextStay() {
      if (!elements.nextStayContainer) return;

      const upcoming = state.bookings
        .filter(isUpcomingBooking)
        .sort((a, b) => new Date(a?.checkin).getTime() - new Date(b?.checkin).getTime());

      const stay = upcoming[0];

      if (!stay) {
        elements.nextStayContainer.innerHTML = `
          <div class="stay-card empty">
            <div class="empty-state" style="padding:28px 15px;">
              <div class="empty-state-icon">🌴</div>
              <div class="empty-state-title">No upcoming stay</div>
              <div class="empty-state-text">Ready for your next island escape?</div>
              <div class="stay-actions" style="justify-content:center;">
                <a href="/booking" class="tiny-btn dark">Book Your Next Stay</a>
              </div>
            </div>
          </div>
        `;
        return;
      }

      const days = daysUntil(stay.checkin);
      const countdown = days === null
        ? "Upcoming"
        : days === 0
          ? "Today"
          : days === 1
            ? "Tomorrow"
            : `${days} days`;

      const status = String(stay.status || "pending").toLowerCase();

      elements.nextStayContainer.innerHTML = `
        <div class="stay-card">
          <div class="stay-topline">
            <div>
              <div class="stay-kicker">Your next reservation</div>
              <div class="stay-title">${escapeHtml(roomName(stay))}</div>
              <div class="stay-ref">Reference ${escapeHtml(bookingRef(stay))}</div>
            </div>

            <div class="countdown-pill">
              ${escapeHtml(countdown)}
            </div>
          </div>

          <div class="stay-grid">
            <div class="stay-detail">
              <small>Check-In</small>
              <strong>${escapeHtml(formatDate(stay.checkin))}</strong>
            </div>

            <div class="stay-detail">
              <small>Check-Out</small>
              <strong>${escapeHtml(formatDate(stay.checkout))}</strong>
            </div>

            <div class="stay-detail">
              <small>Guests</small>
              <strong>${escapeHtml(stay.guests || 1)}</strong>
            </div>

            <div class="stay-detail">
              <small>Status</small>
              <span class="status ${safeClass(status)}">
                ${escapeHtml(statusLabel(status))}
              </span>
            </div>
          </div>

          <div class="stay-actions">
            <button
              type="button"
              class="tiny-btn dark"
              data-view-booking="${escapeAttr(stay._id || stay.id || "")}"
            >
              View Details
            </button>

            ${cancellableStatuses.has(status)
              ? `
                <button
                  type="button"
                  class="tiny-btn"
                  data-cancel-booking="${escapeAttr(stay._id || stay.id || "")}"
                >
                  Cancel Reservation
                </button>
              `
              : ""}
          </div>
        </div>
      `;
    }

    function renderBookings() {
      if (!elements.appointmentsContainer) return;

      const filtered = getSortedBookings(getFilteredBookings());

      if (!filtered.length) {
        const message = state.bookingSearch
          ? "No reservations match your search."
          : state.bookingFilter === "upcoming"
            ? "You do not have any upcoming reservations."
            : state.bookingFilter === "active"
              ? "You do not have any active reservations."
              : state.bookingFilter === "past"
                ? "You do not have any past reservations yet."
                : "You haven't booked a getaway yet.";

        elements.appointmentsContainer.innerHTML = `
          <div class="empty-state">
            <div class="empty-state-icon">🏝️</div>
            <div class="empty-state-title">
              ${escapeHtml(state.bookingSearch ? "No matches found" : "No reservations yet")}
            </div>
            <div class="empty-state-text">
              ${escapeHtml(message)}
            </div>
            <div style="margin-top:14px;">
              <a href="/booking" class="tiny-btn dark">
                Create Reservation
              </a>
            </div>
          </div>
        `;

        return;
      }

      const rows = filtered.map((booking) => {
        const id = booking?._id || booking?.id || "";
        const status = String(booking?.status || "pending").toLowerCase();
        const room = roomName(booking);
        const nights = getNights(booking);
        const cancellable = cancellableStatuses.has(status);
        const total = formatCurrency(booking?.totalPrice);

        return `
          <tr>

            <td>
              <strong class="booking-room">
                ${escapeHtml(room)}
              </strong>

              <span class="booking-id">
                Ref: ${escapeHtml(bookingRef(booking))}
                ${nights
                  ? ` · ${escapeHtml(nights)} night${nights === 1 ? "" : "s"}`
                  : ""}
              </span>
            </td>

            <td>
              ${escapeHtml(formatDate(booking?.checkin))}
            </td>

            <td>
              ${escapeHtml(formatDate(booking?.checkout))}
            </td>

            <td>
              ${escapeHtml(booking?.guests || 1)}
            </td>

            <td class="booking-total">
              ${escapeHtml(total)}
            </td>

            <td>
              <span class="status ${safeClass(status)}">
                ${escapeHtml(statusLabel(status))}
              </span>
            </td>

            <td>
              <div class="table-actions">

                <button
                  type="button"
                  class="table-action primary"
                  data-view-booking="${escapeAttr(id)}"
                >
                  Details
                </button>

                ${cancellable
                  ? `
                    <button
                      type="button"
                      class="table-action danger"
                      data-cancel-booking="${escapeAttr(id)}"
                    >
                      Cancel
                    </button>
                  `
                  : ""}

              </div>
            </td>

          </tr>
        `;
      }).join("");

      elements.appointmentsContainer.innerHTML = `
        <table aria-describedby="bookingTableDescription">

          <caption
            id="bookingTableDescription"
            class="sr-only"
          >
            Your Puffer Isle Resort reservations
          </caption>

          <thead>
            <tr>
              <th scope="col">Accommodation</th>
              <th scope="col">Check-In</th>
              <th scope="col">Check-Out</th>
              <th scope="col">Guests</th>
              <th scope="col">Total</th>
              <th scope="col">Status</th>
              <th scope="col">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>

          <tbody>
            ${rows}
          </tbody>

        </table>
      `;
    }

    function addOnName(addOn) {
      return addOn?.name || addOn?.title || "Resort add-on";
    }

    function addOnSubtotal(addOn) {
      const quantity = Number(addOn?.quantity || 1);
      const explicit = Number(addOn?.subtotal);
      if (Number.isFinite(explicit)) return explicit;

      const price = Number(addOn?.price);
      if (!Number.isFinite(price)) return 0;

      return price * Math.max(1, quantity);
    }

    function renderBookingDetails(booking) {
      if (!elements.bookingModalBody || !elements.bookingModalTitle || !elements.bookingModalFooter) return;

      const status = String(booking?.status || "pending").toLowerCase();
      const id = booking?._id || booking?.id || "";
      const addOns = Array.isArray(booking?.addOns) ? booking.addOns : [];
      const roomSubtotal = Number(booking?.roomSubtotal);
      const addOnSubtotalTotal = Number(booking?.addOnSubtotal);
      const totalPrice = Number(booking?.totalPrice);

      elements.bookingModalTitle.textContent = roomName(booking);

      const addOnMarkup = addOns.length
        ? `
          <div class="detail-card full">
            <small>Selected Add-Ons</small>

            <div class="addons-list">
              ${addOns.map((addOn) => `
                <div class="addon-line">
                  <span>
                    ${escapeHtml(addOnName(addOn))}
                    ${Number(addOn?.quantity) > 1
                      ? ` × ${escapeHtml(addOn.quantity)}`
                      : ""}
                  </span>

                  <strong>
                    ${escapeHtml(
                      formatCurrency(
                        addOnSubtotal(addOn)
                      )
                    )}
                  </strong>
                </div>
              `).join("")}
            </div>
          </div>
        `
        : "";

      const specialRequests = booking?.specialRequests
        ? `
          <div class="detail-card full">
            <small>Special Requests</small>
            <span>
              ${escapeHtml(booking.specialRequests)}
            </span>
          </div>
        `
        : "";

      elements.bookingModalBody.innerHTML = `
        <div class="detail-grid">

          <div class="detail-card">
            <small>Booking Reference</small>
            <strong>
              ${escapeHtml(bookingRef(booking))}
            </strong>
          </div>

          <div class="detail-card">
            <small>Status</small>

            <span class="status ${safeClass(status)}">
              ${escapeHtml(statusLabel(status))}
            </span>
          </div>

          <div class="detail-card">
            <small>Check-In</small>
            <strong>
              ${escapeHtml(
                formatDateTime(booking?.checkin) ||
                formatDate(booking?.checkin)
              )}
            </strong>
          </div>

          <div class="detail-card">
            <small>Check-Out</small>
            <strong>
              ${escapeHtml(
                formatDateTime(booking?.checkout) ||
                formatDate(booking?.checkout)
              )}
            </strong>
          </div>

          <div class="detail-card">
            <small>Guests</small>
            <strong>
              ${escapeHtml(booking?.guests || 1)}
            </strong>
          </div>

          <div class="detail-card">
            <small>Number of Nights</small>
            <strong>
              ${escapeHtml(getNights(booking) || 0)}
            </strong>
          </div>

          ${specialRequests}

          ${addOnMarkup}

        </div>


        <div class="price-summary">

          <div class="price-line">

            <span>
              Room
            </span>

            <strong>
              ${escapeHtml(
                Number.isFinite(roomSubtotal)
                  ? formatCurrency(roomSubtotal)
                  : formatCurrency(Number(booking?.roomPrice))
              )}
            </strong>

          </div>


          <div class="price-line">

            <span>
              Add-Ons
            </span>

            <strong>
              ${escapeHtml(
                Number.isFinite(addOnSubtotalTotal)
                  ? formatCurrency(addOnSubtotalTotal)
                  : formatCurrency(
                      addOns.reduce(
                        (sum, addOn) =>
                          sum +
                          addOnSubtotal(addOn),
                        0
                      )
                    )
              )}
            </strong>

          </div>


          <div class="price-line total">

            <span>
              Total Reservation Value
            </span>

            <strong>
              ${escapeHtml(
                Number.isFinite(totalPrice)
                  ? formatCurrency(totalPrice)
                  : "Not available"
              )}
            </strong>

          </div>

        </div>
      `;

      elements.bookingModalFooter.innerHTML = `
        <button
          type="button"
          class="secondary-btn"
          data-close-modal="bookingModal"
        >
          Close
        </button>

        ${cancellableStatuses.has(status)
          ? `
            <button
              type="button"
              class="danger-btn"
              data-cancel-booking="${escapeAttr(id)}"
            >
              Cancel Reservation
            </button>
          `
          : ""}
      `;
    }

    function openModal(modal, opener = null) {
      if (!modal) return;

      state.lastActiveModal =
        opener ||
        document.activeElement;

      modal.classList.add("open");

      document.body.classList.add(
        "modal-open"
      );

      const focusTarget =
        modal.querySelector(
          "button, [href], input, select, textarea"
        );

      window.setTimeout(
        () => focusTarget?.focus(),
        0
      );
    }

    function closeModal(modal) {
      if (
        !modal ||
        !modal.classList.contains("open")
      ) {
        return;
      }

      modal.classList.remove("open");

      document.body.classList.remove(
        "modal-open"
      );

      if (
        state.lastActiveModal &&
        typeof state.lastActiveModal.focus ===
          "function"
      ) {
        state.lastActiveModal.focus();
      }

      state.lastActiveModal = null;
    }

    function findBookingById(id) {
      return state.bookings.find(
        (booking) =>
          String(
            booking?._id ||
            booking?.id ||
            ""
          ) ===
          String(id)
      );
    }

    function openBookingDetails(
      id,
      opener = null
    ) {
      const booking =
        findBookingById(id);

      if (!booking) {
        showFeedback(
          "That reservation is no longer available in the current dashboard data."
        );

        return;
      }

      renderBookingDetails(
        booking
      );

      openModal(
        elements.bookingModal,
        opener
      );
    }

    function openCancelDialog(
      id,
      opener = null
    ) {
      const booking =
        findBookingById(id);

      if (!booking) return;

      state.cancelBookingId =
        String(id);

      if (
        elements.cancelModalMessage
      ) {
        elements.cancelModalMessage.innerHTML =
          `You are about to cancel your reservation for <strong>${escapeHtml(
            roomName(booking)
          )}</strong> from <strong>${escapeHtml(
            formatDate(booking.checkin)
          )}</strong> to <strong>${escapeHtml(
            formatDate(booking.checkout)
          )}</strong>. The reservation will remain in your history with a cancelled status.`;
      }

      openModal(
        elements.cancelModal,
        opener
      );
    }

    async function cancelBooking() {
      const id =
        state.cancelBookingId;

      const booking =
        findBookingById(id);

      if (
        !id ||
        !booking ||
        !elements.confirmCancelButton
      ) {
        return;
      }

      const status =
        String(
          booking?.status ||
          "pending"
        ).toLowerCase();

      if (
        !cancellableStatuses.has(
          status
        )
      ) {
        closeModal(
          elements.cancelModal
        );

        showFeedback(
          "This reservation can no longer be cancelled."
        );

        return;
      }

      elements.confirmCancelButton.disabled =
        true;

      elements.confirmCancelButton.textContent =
        "Cancelling…";

      try {
        const data =
          await fetchJson(
            `/appointment/cancel/${encodeURIComponent(id)}`,
            {
              method: "POST",
            }
          );

        if (!data?.success) {
          throw new Error(
            data?.message ||
            "Unable to cancel this reservation."
          );
        }

        closeModal(
          elements.cancelModal
        );

        showFeedback(
          data.message ||
          "Reservation cancelled successfully."
        );

        await refreshDashboard({
          silent: true,
        });
      } catch (error) {
        console.error(
          "Cancel booking error:",
          error
        );

        showFeedback(
          error.message ||
          "Unable to cancel this reservation right now."
        );
      } finally {
        elements.confirmCancelButton.disabled =
          false;

        elements.confirmCancelButton.textContent =
          "Cancel Reservation";

        state.cancelBookingId =
          null;
      }
    }

    function renderNotifications() {
      if (!elements.notificationsContainer) return;

      let filtered =
        [...state.notifications];

      if (
        state.notificationFilter ===
        "unread"
      ) {
        filtered =
          filtered.filter(
            (note) =>
              !note.read &&
              !note.archived
          );
      } else if (
        state.notificationFilter ===
        "archived"
      ) {
        filtered =
          filtered.filter(
            (note) =>
              note.archived
          );
      }

      filtered.sort(
        (a, b) => {
          return (
            new Date(
              b?.createdAt
            ).getTime() || 0
          ) -
          (
            new Date(
              a?.createdAt
            ).getTime() || 0
          );
        }
      );

      if (!filtered.length) {
        const text =
          state.notificationFilter ===
          "unread"
            ? "You have no unread notifications."
            : state.notificationFilter ===
              "archived"
              ? "No archived notifications are available."
              : "No notifications are available yet.";

        elements.notificationsContainer.innerHTML = `
          <div class="empty-state">

            <div class="empty-state-icon">
              🔔
            </div>

            <div class="empty-state-title">
              You're all caught up
            </div>

            <div class="empty-state-text">
              ${escapeHtml(text)}
            </div>

          </div>
        `;

        return;
      }

      elements.notificationsContainer.innerHTML =
        filtered
          .map((note) => {
            const type =
              String(
                note?.type ||
                "system"
              ).toLowerCase();

            const event =
              String(
                note?.event ||
                ""
              ).toLowerCase();

            const unread =
              !note?.read;

            const archived =
              Boolean(
                note?.archived
              );

            const id =
              note?._id ||
              note?.id ||
              "";

            const title =
              note?.title ||
              "Island Update";

            const message =
              note?.message ||
              "You have a new resort update.";

            const icon =
              note?.icon ||
              (
                event ===
                "cancelled"
                  ? "✖️"
                  : event ===
                    "created"
                    ? "🧾"
                    : "🏝️"
              );

            const detailLabel =
              event
                ? statusLabel(
                    event
                  )
                : type;

            return `
              <article
                class="notification ${safeClass(event || type)} ${
                  unread && !archived
                    ? "unread"
                    : ""
                } ${
                  archived
                    ? "archived"
                    : ""
                }"
                data-notification-id="${escapeAttr(id)}"
              >

                ${
                  unread && !archived
                    ? '<span class="unread-dot" aria-label="Unread notification"></span>'
                    : ""
                }

                <div
                  class="notification-icon"
                  aria-hidden="true"
                >
                  ${escapeHtml(icon)}
                </div>


                <div class="notification-content">

                  <p class="notification-title">
                    ${escapeHtml(title)}
                  </p>

                  <p class="notification-message">
                    ${escapeHtml(message)}
                  </p>


                  <div class="notification-meta">

                    <span class="notification-badge">
                      ${escapeHtml(detailLabel)}
                    </span>

                    <span>
                      ${escapeHtml(
                        formatDateTime(
                          note?.createdAt
                        ) ||
                        "Recent update"
                      )}
                    </span>

                    ${
                      archived
                        ? `
                          <span class="notification-badge">
                            Archived
                          </span>
                        `
                        : ""
                    }

                  </div>

                </div>


                <div class="notification-actions">

                  ${
                    !archived
                      ? `
                        <button
                          type="button"
                          class="tiny-btn"
                          data-notification-action="${
                            unread
                              ? "read"
                              : "unread"
                          }"
                          data-notification-id="${escapeAttr(id)}"
                        >
                          ${
                            unread
                              ? "Mark read"
                              : "Unread"
                          }
                        </button>
                      `
                      : `
                        <button
                          type="button"
                          class="tiny-btn"
                          data-notification-action="unarchive"
                          data-notification-id="${escapeAttr(id)}"
                        >
                          Restore
                        </button>
                      `
                  }


                  ${
                    !archived
                      ? `
                        <button
                          type="button"
                          class="tiny-btn"
                          data-notification-action="archive"
                          data-notification-id="${escapeAttr(id)}"
                        >
                          Archive
                        </button>
                      `
                      : ""
                  }

                </div>

              </article>
            `;
          })
          .join("");
    }

    async function loadDashboardStats() {
      try {
        const data =
          await fetchJson(
            "/api/me/dashboard"
          );

        if (!data?.success) return;

        if (
          data.user?.fullname
        ) {
          const nameElement =
            document.getElementById(
              "profileName"
            );

          if (nameElement) {
            nameElement.textContent =
              data.user.fullname;
          }

          const fullNameElement =
            document.getElementById(
              "accountFullName"
            );

          if (fullNameElement) {
            fullNameElement.textContent =
              data.user.fullname;
          }
        }

        if (data.user?.email) {
          const emailElement =
            document.getElementById(
              "accountEmail"
            );

          if (emailElement) {
            emailElement.textContent =
              data.user.email;
          }
        }

        if (
          data.user?.phone !==
          undefined
        ) {
          const phoneElement =
            document.getElementById(
              "accountPhone"
            );

          if (phoneElement) {
            phoneElement.textContent =
              data.user.phone ||
              "Not provided";
          }
        }

        const accountStatus =
          String(
            data.user?.status ||
            "active"
          ).toLowerCase();

        const statusLabelElement =
          document.getElementById(
            "accountStatusLabel"
          );

        if (
          statusLabelElement
        ) {
          statusLabelElement.textContent =
            accountStatus ===
            "active"
              ? "Account Active"
              : "Account Restricted";
        }
      } catch (error) {
        console.debug(
          "Dashboard stats request skipped:",
          error.message
        );
      }
    }

    async function loadBookings() {
      const data =
        await fetchJson(
          "/api/me/bookings?limit=100"
        );

      if (!data?.success) {
        throw new Error(
          data?.message ||
          "Unable to load reservations."
        );
      }

      state.bookings =
        Array.isArray(
          data.bookings
        )
          ? data.bookings
          : [];
    }

    async function loadNotifications() {
      const data =
        await fetchJson(
          "/api/me/notifications?limit=100&includeArchived=true"
        );

      if (!data?.success) {
        throw new Error(
          data?.message ||
          "Unable to load notifications."
        );
      }

      state.notifications =
        Array.isArray(
          data.notifications
        )
          ? data.notifications
          : [];
    }

    async function refreshDashboard({
      silent = false
    } = {}) {
      if (state.loading) return;

      state.loading = true;

      if (!silent) {
        setRefreshStatus(
          "Syncing…"
        );
      }

      if (
        elements.refreshButton
      ) {
        elements.refreshButton.disabled =
          true;
      }

      try {
        await Promise.all([
          loadBookings(),
          loadNotifications(),
          loadDashboardStats(),
        ]);

        updateStats();
        renderNextStay();
        renderBookings();
        renderNotifications();

        setRefreshStatus(
          "✓ Updated"
        );

        window.clearTimeout(
          refreshDashboard.statusTimer
        );

        refreshDashboard.statusTimer =
          window.setTimeout(
            () =>
              setRefreshStatus(""),
            1400
          );
      } catch (error) {
        console.error(
          "Profile refresh error:",
          error
        );

        setRefreshStatus(
          "⚠ Sync failed"
        );

        showFeedback(
          error.message ||
          "Some dashboard information could not be loaded."
        );
      } finally {
        state.loading =
          false;

        if (
          elements.refreshButton
        ) {
          elements.refreshButton.disabled =
            false;
        }
      }
    }

    async function updateNotificationState(
      id,
      action
    ) {
      if (
        state.notificationActionBusy
      ) {
        return;
      }

      if (!id) return;

      state.notificationActionBusy =
        true;

      try {
        const endpointMap = {
          read: {
            url: `/api/me/notifications/${encodeURIComponent(id)}/read`,
            method: "POST",
          },
          unread: {
            url: `/api/me/notifications/${encodeURIComponent(id)}/unread`,
            method: "POST",
          },
          archive: {
            url: `/api/me/notifications/${encodeURIComponent(id)}/archive`,
            method: "POST",
          },
          unarchive: {
            url: `/api/me/notifications/${encodeURIComponent(id)}/unarchive`,
            method: "POST",
          },
        };

        const request =
          endpointMap[action];

        if (!request) return;

        const data =
          await fetchJson(
            request.url,
            {
              method:
                request.method,
            }
          );

        if (!data?.success) {
          throw new Error(
            data?.message ||
            "Unable to update notification."
          );
        }

        const returned =
          data.notification;

        state.notifications =
          state.notifications.map(
            (note) => {
              const noteId =
                String(
                  note?._id ||
                  note?.id ||
                  ""
                );

              return noteId ===
                String(id) &&
                returned
                ? returned
                : note;
            }
          );

        updateStats();
        renderNotifications();

        showFeedback(
          action === "read"
            ? "Notification marked as read."
            : action === "archive"
              ? "Notification archived."
              : action ===
                "unarchive"
                ? "Notification restored."
                : "Notification marked as unread."
        );
      } catch (error) {
        console.error(
          "Notification action error:",
          error
        );

        showFeedback(
          error.message ||
          "Unable to update that notification."
        );
      } finally {
        state.notificationActionBusy =
          false;
      }
    }

    async function markAllNotificationsRead() {
      if (
        !elements.markAllReadButton ||
        state.notificationActionBusy
      ) {
        return;
      }

      const unreadExists =
        state.notifications.some(
          (note) =>
            !note.read &&
            !note.archived
        );

      if (!unreadExists) {
        showFeedback(
          "There are no unread notifications."
        );

        return;
      }

      state.notificationActionBusy =
        true;

      elements.markAllReadButton.disabled =
        true;

      elements.markAllReadButton.textContent =
        "Updating…";

      try {
        const data =
          await fetchJson(
            "/api/me/notifications/read-all",
            {
              method: "POST",
            }
          );

        if (!data?.success) {
          throw new Error(
            data?.message ||
            "Unable to update notifications."
          );
        }

        state.notifications =
          state.notifications.map(
            (note) =>
              note.archived
                ? note
                : {
                    ...note,
                    read: true,
                    readAt:
                      new Date().toISOString(),
                  }
          );

        updateStats();
        renderNotifications();

        showFeedback(
          data.message ||
          "All notifications have been marked as read."
        );
      } catch (error) {
        console.error(
          "Mark all notifications error:",
          error
        );

        showFeedback(
          error.message ||
          "Unable to mark all notifications as read."
        );
      } finally {
        state.notificationActionBusy =
          false;

        elements.markAllReadButton.disabled =
          false;

        elements.markAllReadButton.textContent =
          "Mark all as read";
      }
    }

    function updatePasswordStrength() {
      const input =
        elements.newPasswordInput;

      const bar =
        elements.passwordStrengthBar;

      const hint =
        elements.passwordHint;

      if (!input || !bar || !hint) {
        return;
      }

      const value =
        input.value;

      let score = 0;

      if (value.length >= 10) {
        score++;
      }

      if (/[a-z]/.test(value)) {
        score++;
      }

      if (/[A-Z]/.test(value)) {
        score++;
      }

      if (/\d/.test(value)) {
        score++;
      }

      if (/[^A-Za-z0-9]/.test(value)) {
        score++;
      }

      const widths = [
        "0%",
        "20%",
        "40%",
        "60%",
        "80%",
        "100%",
      ];

      bar.style.width =
        widths[score];

      if (value.length === 0) {
        hint.textContent =
          "Use 10 or more characters.";

        bar.style.background =
          "var(--danger)";
      } else if (
        value.length < 10
      ) {
        hint.textContent =
          "Password is too short.";

        bar.style.background =
          "var(--danger)";
      } else if (
        score <= 2
      ) {
        hint.textContent =
          "Password strength: Basic.";

        bar.style.background =
          "var(--warning)";
      } else if (
        score === 3
      ) {
        hint.textContent =
          "Password strength: Good.";

        bar.style.background =
          "var(--info)";
      } else {
        hint.textContent =
          "Password strength: Strong.";

        bar.style.background =
          "var(--success)";
      }
    }

    function updatePasswordMatch() {
      const password =
        elements.newPasswordInput?.value ||
        "";

      const confirm =
        elements.confirmPasswordInput?.value ||
        "";

      if (!elements.passwordMatch) {
        return;
      }

      if (!confirm) {
        elements.passwordMatch.textContent =
          "";

        elements.passwordMatch.className =
          "password-match";

        return;
      }

      if (password === confirm) {
        elements.passwordMatch.textContent =
          "✓ Passwords match.";

        elements.passwordMatch.className =
          "password-match good";
      } else {
        elements.passwordMatch.textContent =
          "Passwords do not match.";

        elements.passwordMatch.className =
          "password-match bad";
      }
    }

    async function submitPasswordChange(
      event
    ) {
      event.preventDefault();

      if (
        !elements.passwordForm ||
        !elements.passwordSubmitButton
      ) {
        return;
      }

      const currentPassword =
        document.getElementById(
          "currentPassword"
        )?.value ||
        "";

      const newPassword =
        elements.newPasswordInput?.value ||
        "";

      const confirmPassword =
        elements.confirmPasswordInput?.value ||
        "";

      if (
        !currentPassword ||
        !newPassword ||
        !confirmPassword
      ) {
        elements.passwordFeedback.textContent =
          "Please complete all password fields.";

        elements.passwordFeedback.className =
          "form-feedback error full";

        return;
      }

      if (
        newPassword.length <
        10
      ) {
        elements.passwordFeedback.textContent =
          "New password must contain at least 10 characters.";

        elements.passwordFeedback.className =
          "form-feedback error full";

        return;
      }

      if (
        newPassword.length >
        128
      ) {
        elements.passwordFeedback.textContent =
          "New password cannot exceed 128 characters.";

        elements.passwordFeedback.className =
          "form-feedback error full";

        return;
      }

      if (
        newPassword !==
        confirmPassword
      ) {
        elements.passwordFeedback.textContent =
          "New passwords do not match.";

        elements.passwordFeedback.className =
          "form-feedback error full";

        return;
      }

      elements.passwordSubmitButton.disabled =
        true;

      elements.passwordSubmitButton.textContent =
        "Updating…";

      elements.passwordFeedback.textContent =
        "";

      elements.passwordFeedback.className =
        "form-feedback full";

      try {
        const body =
          new URLSearchParams(
            new FormData(
              elements.passwordForm
            )
          );

        const data =
          await fetchJson(
            "/profile/update-password",
            {
              method: "POST",

              body,

              headers: {
                "Content-Type":
                  "application/x-www-form-urlencoded;charset=UTF-8",
              },
            }
          );

        if (!data?.success) {
          throw new Error(
            data?.message ||
            "Unable to update your password."
          );
        }

        elements.passwordFeedback.textContent =
          data.message ||
          "Password updated successfully.";

        elements.passwordFeedback.className =
          "form-feedback full";

        elements.passwordForm.reset();

        updatePasswordStrength();
        updatePasswordMatch();

        showFeedback(
          "Your password has been updated."
        );
      } catch (error) {
        console.error(
          "Password update error:",
          error
        );

        elements.passwordFeedback.textContent =
          error.message ||
          "Unable to update your password.";

        elements.passwordFeedback.className =
          "form-feedback error full";
      } finally {
        elements.passwordSubmitButton.disabled =
          false;

        elements.passwordSubmitButton.textContent =
          "Update Password";
      }
    }

    function initFlashDismissal() {
      document
        .querySelectorAll(
          ".flash-close"
        )
        .forEach(
          (button) => {
            button.addEventListener(
              "click",
              () => {
                button
                  .closest(".flash")
                  ?.remove();
              }
            );
          }
        );
    }

    function initFilters() {
      document
        .querySelectorAll(
          "[data-booking-filter]"
        )
        .forEach(
          (button) => {
            button.addEventListener(
              "click",
              () => {
                document
                  .querySelectorAll(
                    "[data-booking-filter]"
                  )
                  .forEach(
                    (item) =>
                      item.classList.remove(
                        "active"
                      )
                  );

                button.classList.add(
                  "active"
                );

                state.bookingFilter =
                  button.dataset
                    .bookingFilter ||
                  "all";

                renderBookings();
              }
            );
          }
        );

      document
        .querySelectorAll(
          "[data-notification-filter]"
        )
        .forEach(
          (button) => {
            button.addEventListener(
              "click",
              () => {
                document
                  .querySelectorAll(
                    "[data-notification-filter]"
                  )
                  .forEach(
                    (item) =>
                      item.classList.remove(
                        "active"
                      )
                  );

                button.classList.add(
                  "active"
                );

                state.notificationFilter =
                  button.dataset
                    .notificationFilter ||
                  "all";

                renderNotifications();
              }
            );
          }
        );
    }

    function initPasswordToggles() {
      document
        .querySelectorAll(
          "[data-toggle-password]"
        )
        .forEach(
          (button) => {
            button.addEventListener(
              "click",
              () => {
                const input =
                  document.getElementById(
                    button
                      .dataset
                      .togglePassword
                  );

                if (!input) {
                  return;
                }

                const showing =
                  input.type ===
                  "text";

                input.type =
                  showing
                    ? "password"
                    : "text";

                button.textContent =
                  showing
                    ? "Show"
                    : "Hide";
              }
            );
          }
        );
    }

    function closeAllModals() {
      closeModal(
        elements.bookingModal
      );

      closeModal(
        elements.cancelModal
      );
    }

    function initModalInteractions() {
      document.addEventListener(
        "click",
        (event) => {
          const target =
            event.target;

          if (
            !(target instanceof Element)
          ) {
            return;
          }

          const viewButton =
            target.closest(
              "[data-view-booking]"
            );

          if (viewButton) {
            openBookingDetails(
              viewButton.dataset
                .viewBooking ||
                "",
              viewButton
            );

            return;
          }

          const cancelButton =
            target.closest(
              "[data-cancel-booking]"
            );

          if (cancelButton) {
            openCancelDialog(
              cancelButton.dataset
                .cancelBooking ||
                "",
              cancelButton
            );

            return;
          }

          const notificationButton =
            target.closest(
              "[data-notification-action]"
            );

          if (notificationButton) {
            updateNotificationState(
              notificationButton
                .dataset
                .notificationId ||
                "",
              notificationButton
                .dataset
                .notificationAction ||
                ""
            );

            return;
          }

          const closeButton =
            target.closest(
              "[data-close-modal]"
            );

          if (closeButton) {
            const modalId =
              closeButton.dataset
                .closeModal;

            closeModal(
              document.getElementById(
                modalId
              )
            );

            return;
          }

          if (
            target.classList.contains(
              "modal-backdrop"
            )
          ) {
            closeModal(
              target
            );
          }
        }
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            event.key ===
            "Escape"
          ) {
            closeAllModals();
          }

          const openModalElement =
            document.querySelector(
              ".modal-backdrop.open"
            );

          if (
            event.key ===
              "Tab" &&
            openModalElement
          ) {
            const focusables =
              openModalElement.querySelectorAll(
                "button, [href], input, select, textarea, [tabindex]:not([tabindex='-1'])"
              );

            if (!focusables.length) {
              return;
            }

            const first =
              focusables[0];

            const last =
              focusables[
                focusables.length - 1
              ];

            if (
              event.shiftKey &&
              document.activeElement ===
                first
            ) {
              event.preventDefault();

              last.focus();
            } else if (
              !event.shiftKey &&
              document.activeElement ===
                last
            ) {
              event.preventDefault();

              first.focus();
            }
          }
        }
      );
    }

    function initEventListeners() {
      initFlashDismissal();
      initFilters();
      initPasswordToggles();
      initModalInteractions();

      elements.refreshButton?.addEventListener(
        "click",
        () => {
          refreshDashboard();
        }
      );

      elements.bookingSearch?.addEventListener(
        "input",
        (event) => {
          state.bookingSearch =
            event.target.value ||
            "";

          renderBookings();
        }
      );

      elements.markAllReadButton?.addEventListener(
        "click",
        markAllNotificationsRead
      );

      elements.confirmCancelButton?.addEventListener(
        "click",
        cancelBooking
      );

      elements.newPasswordInput?.addEventListener(
        "input",
        () => {
          updatePasswordStrength();
          updatePasswordMatch();
        }
      );

      elements.confirmPasswordInput?.addEventListener(
        "input",
        updatePasswordMatch
      );

      elements.passwordForm?.addEventListener(
        "submit",
        submitPasswordChange
      );
    }

    function startPolling() {
      window.clearInterval(
        state.refreshTimer
      );

      state.refreshTimer =
        window.setInterval(
          () => {
            if (
              document.hidden ||
              state.loading
            ) {
              return;
            }

            refreshDashboard({
              silent: true,
            });
          },
          30000
        );
    }

    document.addEventListener(
      "visibilitychange",
      () => {
        if (!document.hidden) {
          refreshDashboard({
            silent: true,
          });
        }
      }
    );

    window.addEventListener(
      "beforeunload",
      () => {
        window.clearInterval(
          state.refreshTimer
        );
      }
    );


    /* ============================================================
       INITIALIZE
       ============================================================ */

    initEventListeners();

    updatePasswordStrength();
    updatePasswordMatch();

    updateStats();
    renderBookings();
    renderNotifications();
    renderNextStay();

    refreshDashboard();

    startPolling();
  </script>

</body>
</html>